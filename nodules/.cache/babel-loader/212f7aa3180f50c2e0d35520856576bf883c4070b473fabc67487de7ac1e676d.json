{"ast":null,"code":"import { defineComponent, toRefs } from 'vue';\nimport Styled from 'vue3-styled-components';\nconst CardWrapper = Styled.figure`\n  display: flex;\n  margin: 0;\n  position: relative;\n  h2,\n  p {\n    margin: 0;\n  }\n  figcaption {\n    .more {\n      position: absolute;\n      top: 0px;\n      ${({\n  theme\n}) => theme.rtl ? 'left' : 'right'}: 0;\n      a {\n        color: ${({\n  theme\n}) => theme['extra-light-color']};\n      }\n    }\n    h2 {\n      font-size: 20px;\n      font-weight: 600;\n    }\n    p {\n      font-size: 14px;\n      color: ${({\n  theme\n}) => theme['light-color']};\n    }\n  }\n`;\nconst Icon = Styled.div`\n  width: 60px;\n  height: 60px;\n  border-radius: 12px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  background: ${({\n  theme,\n  className\n}) => theme[`${className}-color`]};\n  ${({\n  theme\n}) => theme.rtl ? 'margin-left' : 'margin-right'}: 20px;\n`;\nimport VueTypes from 'vue-types';\nexport default defineComponent({\n  name: 'SampleCardSix',\n  components: {\n    CardWrapper,\n    Icon\n  },\n  props: {\n    item: VueTypes.object.def({\n      id: 1,\n      title: '47',\n      content: 'Total tasks',\n      img: 'static/img/icon/1.svg',\n      className: 'primary'\n    })\n  },\n  setup(props) {\n    const {\n      item\n    } = toRefs(props);\n    const {\n      id,\n      title,\n      content,\n      img,\n      className\n    } = item.value;\n    return {\n      id,\n      title,\n      content,\n      img,\n      className\n    };\n  }\n});","map":{"version":3,"names":["defineComponent","toRefs","Styled","CardWrapper","figure","theme","rtl","Icon","div","className","VueTypes","name","components","props","item","object","def","id","title","content","img","setup","value"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/components/cards/sampleCard/SampleCardSix.vue"],"sourcesContent":["<template>\r\n  <sdCards headless>\r\n    <CardWrapper>\r\n      <Icon :className=\"className\">\r\n        <img :src=\"require(`../../../${img}`)\" alt=\"\" />\r\n      </Icon>\r\n      <figcaption>\r\n        <div class=\"more\">\r\n          <sdDropdown :action=\"['click']\" class=\"wide-dropdwon\">\r\n            <template #overlay>\r\n              <router-link to=\"#\">Edit</router-link>\r\n              <router-link to=\"#\">Delete</router-link>\r\n              <router-link to=\"#\">View</router-link>\r\n            </template>\r\n            <router-link to=\"#\">\r\n              <sdFeatherIcons type=\"more-horizontal\" size=\"18\" />\r\n            </router-link>\r\n          </sdDropdown>\r\n        </div>\r\n        <h2>{{ title }}</h2>\r\n        <p>{{ content }}</p>\r\n      </figcaption>\r\n    </CardWrapper>\r\n  </sdCards>\r\n</template>\r\n\r\n<script>\r\nimport { defineComponent, toRefs } from 'vue';\r\nimport Styled from 'vue3-styled-components';\r\nconst CardWrapper = Styled.figure`\r\n  display: flex;\r\n  margin: 0;\r\n  position: relative;\r\n  h2,\r\n  p {\r\n    margin: 0;\r\n  }\r\n  figcaption {\r\n    .more {\r\n      position: absolute;\r\n      top: 0px;\r\n      ${({ theme }) => (theme.rtl ? 'left' : 'right')}: 0;\r\n      a {\r\n        color: ${({ theme }) => theme['extra-light-color']};\r\n      }\r\n    }\r\n    h2 {\r\n      font-size: 20px;\r\n      font-weight: 600;\r\n    }\r\n    p {\r\n      font-size: 14px;\r\n      color: ${({ theme }) => theme['light-color']};\r\n    }\r\n  }\r\n`;\r\nconst Icon = Styled.div`\r\n  width: 60px;\r\n  height: 60px;\r\n  border-radius: 12px;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  background: ${({ theme, className }) => theme[`${className}-color`]};\r\n  ${({ theme }) => (theme.rtl ? 'margin-left' : 'margin-right')}: 20px;\r\n`;\r\nimport VueTypes from 'vue-types';\r\nexport default defineComponent({\r\n  name: 'SampleCardSix',\r\n  components: { CardWrapper, Icon },\r\n  props: {\r\n    item: VueTypes.object.def({\r\n      id: 1,\r\n      title: '47',\r\n      content: 'Total tasks',\r\n      img: 'static/img/icon/1.svg',\r\n      className: 'primary',\r\n    }),\r\n  },\r\n  setup(props) {\r\n    const { item } = toRefs(props);\r\n    const { id, title, content, img, className } = item.value;\r\n    return { id, title, content, img, className };\r\n  },\r\n});\r\n</script>\r\n"],"mappings":"AA2BA,SAASA,eAAe,EAAEC,MAAK,QAAS,KAAK;AAC7C,OAAOC,MAAK,MAAO,wBAAwB;AAC3C,MAAMC,WAAU,GAAID,MAAM,CAACE,MAAM;;;;;;;;;;;;QAYzB,CAAC;EAAEC;AAAM,CAAC,KAAMA,KAAK,CAACC,GAAE,GAAI,MAAK,GAAI,OAAS;;iBAErC,CAAC;EAAED;AAAM,CAAC,KAAKA,KAAK,CAAC,mBAAmB,CAAE;;;;;;;;;eAS5C,CAAC;EAAEA;AAAM,CAAC,KAAKA,KAAK,CAAC,aAAa,CAAE;;;AAGnD,CAAC;AACD,MAAME,IAAG,GAAIL,MAAM,CAACM,GAAG;;;;;;;gBAOP,CAAC;EAAEH,KAAK;EAAEI;AAAU,CAAC,KAAKJ,KAAK,CAAE,GAAEI,SAAU,QAAO,CAAE;IAClE,CAAC;EAAEJ;AAAM,CAAC,KAAMA,KAAK,CAACC,GAAE,GAAI,aAAY,GAAI,cAAgB;AAChE,CAAC;AACD,OAAOI,QAAO,MAAO,WAAW;AAChC,eAAeV,eAAe,CAAC;EAC7BW,IAAI,EAAE,eAAe;EACrBC,UAAU,EAAE;IAAET,WAAW;IAAEI;EAAK,CAAC;EACjCM,KAAK,EAAE;IACLC,IAAI,EAAEJ,QAAQ,CAACK,MAAM,CAACC,GAAG,CAAC;MACxBC,EAAE,EAAE,CAAC;MACLC,KAAK,EAAE,IAAI;MACXC,OAAO,EAAE,aAAa;MACtBC,GAAG,EAAE,uBAAuB;MAC5BX,SAAS,EAAE;IACb,CAAC;EACH,CAAC;EACDY,KAAKA,CAACR,KAAK,EAAE;IACX,MAAM;MAAEC;IAAK,IAAIb,MAAM,CAACY,KAAK,CAAC;IAC9B,MAAM;MAAEI,EAAE;MAAEC,KAAK;MAAEC,OAAO;MAAEC,GAAG;MAAEX;IAAU,IAAIK,IAAI,CAACQ,KAAK;IACzD,OAAO;MAAEL,EAAE;MAAEC,KAAK;MAAEC,OAAO;MAAEC,GAAG;MAAEX;IAAU,CAAC;EAC/C;AACF,CAAC,CAAC"},"metadata":{},"sourceType":"module","externalDependencies":[]}