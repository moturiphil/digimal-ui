{"ast":null,"code":"import { getCurrentInstance, reactive, defineComponent } from 'vue';\nconst CoverSection = defineComponent({\n  name: 'CoverSection',\n  setup() {\n    const {\n      $message\n    } = getCurrentInstance().appContext.config.globalProperties;\n    const props = reactive({\n      name: 'file',\n      action: 'https://www.mocky.io/v2/5cc8019d300000980a055e76',\n      headers: {\n        authorization: 'authorization-text'\n      },\n      onChange(info) {\n        if (info.file.status !== 'uploading') {\n          console.log(info.file, info.fileList);\n        }\n        if (info.file.status === 'done') {\n          $message.success(`${info.file.name} file uploaded successfully`);\n        } else if (info.file.status === 'error') {\n          $message.error(`${info.file.name} file upload failed.`);\n        }\n      }\n    });\n    return {\n      props\n    };\n  }\n});\nexport default CoverSection;","map":{"version":3,"names":["getCurrentInstance","reactive","defineComponent","CoverSection","name","setup","$message","appContext","config","globalProperties","props","action","headers","authorization","onChange","info","file","status","console","log","fileList","success","error"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/apps/myProfile/overview/CoverSection.vue"],"sourcesContent":["<template>\r\n  <div class=\"cover-image\">\r\n    <img style=\"width: 100%\" :src=\"require('@/static/img/profile/cover-img.png')\" alt=\"banner\" />\r\n    <a-upload v-bind=\"props\">\r\n      <a to=\"#\"> <sdFeatherIcons type=\"camera\" size=\"16\" /> Change Cover </a>\r\n    </a-upload>\r\n  </div>\r\n</template>\r\n<script>\r\nimport { getCurrentInstance, reactive, defineComponent } from 'vue';\r\n\r\nconst CoverSection = defineComponent({\r\n  name: 'CoverSection',\r\n  setup() {\r\n    const { $message } = getCurrentInstance().appContext.config.globalProperties;\r\n    const props = reactive({\r\n      name: 'file',\r\n      action: 'https://www.mocky.io/v2/5cc8019d300000980a055e76',\r\n      headers: {\r\n        authorization: 'authorization-text',\r\n      },\r\n      onChange(info) {\r\n        if (info.file.status !== 'uploading') {\r\n          console.log(info.file, info.fileList);\r\n        }\r\n        if (info.file.status === 'done') {\r\n          $message.success(`${info.file.name} file uploaded successfully`);\r\n        } else if (info.file.status === 'error') {\r\n          $message.error(`${info.file.name} file upload failed.`);\r\n        }\r\n      },\r\n    });\r\n    return {\r\n      props,\r\n    };\r\n  },\r\n});\r\n\r\nexport default CoverSection;\r\n</script>\r\n"],"mappings":"AASA,SAASA,kBAAkB,EAAEC,QAAQ,EAAEC,eAAc,QAAS,KAAK;AAEnE,MAAMC,YAAW,GAAID,eAAe,CAAC;EACnCE,IAAI,EAAE,cAAc;EACpBC,KAAKA,CAAA,EAAG;IACN,MAAM;MAAEC;IAAS,IAAIN,kBAAkB,EAAE,CAACO,UAAU,CAACC,MAAM,CAACC,gBAAgB;IAC5E,MAAMC,KAAI,GAAIT,QAAQ,CAAC;MACrBG,IAAI,EAAE,MAAM;MACZO,MAAM,EAAE,kDAAkD;MAC1DC,OAAO,EAAE;QACPC,aAAa,EAAE;MACjB,CAAC;MACDC,QAAQA,CAACC,IAAI,EAAE;QACb,IAAIA,IAAI,CAACC,IAAI,CAACC,MAAK,KAAM,WAAW,EAAE;UACpCC,OAAO,CAACC,GAAG,CAACJ,IAAI,CAACC,IAAI,EAAED,IAAI,CAACK,QAAQ,CAAC;QACvC;QACA,IAAIL,IAAI,CAACC,IAAI,CAACC,MAAK,KAAM,MAAM,EAAE;UAC/BX,QAAQ,CAACe,OAAO,CAAE,GAAEN,IAAI,CAACC,IAAI,CAACZ,IAAI,6BAA6B,CAAC;QAClE,OAAO,IAAIW,IAAI,CAACC,IAAI,CAACC,MAAK,KAAM,OAAO,EAAE;UACvCX,QAAQ,CAACgB,KAAK,CAAE,GAAEP,IAAI,CAACC,IAAI,CAACZ,IAAI,sBAAsB,CAAC;QACzD;MACF;IACF,CAAC,CAAC;IACF,OAAO;MACLM;IACF,CAAC;EACH;AACF,CAAC,CAAC;AAEF,eAAeP,YAAY"},"metadata":{},"sourceType":"module","externalDependencies":[]}