{"ast":null,"code":"import { computed, onMounted, reactive, ref, toRefs, defineComponent } from \"vue\";\nimport { useStore } from \"vuex\";\nimport authHeader from \"../../../services/auth-header\";\nimport axios from \"axios\";\nconst PaySummary = defineComponent({\n  name: \"PaySummary\",\n  props: [\"subtotal\"],\n  data() {\n    return {\n      cardData: [{\n        activity: \"Activity 1\",\n        perdiem: \"$50\"\n      }, {\n        activity: \"Activity 2\",\n        perdiem: \"$75\"\n      }, {\n        activity: \"Activity 3\",\n        perdiem: \"$100\"\n      }],\n      promoCode: \"\"\n    };\n  },\n  setup() {\n    const {\n      state\n    } = useStore();\n    const rtl = computed(() => state.themeLayout.rtlData);\n    const dataSource = ref([]);\n    const coupon = ref(0);\n    const promo = ref(0);\n    const current = ref(0);\n    const submitPromo = values => {\n      promo.value = values;\n    };\n    const API_URL = `${process.env.VUE_APP_BASE_URL}/payroll_detail?payroll_list_id=1`;\n    const formState = reactive({\n      couponType: \"\",\n      promoCode: \"\",\n      layout: \"horizontal\"\n    });\n    const onSubmit = () => {\n      document.querySelectorAll(\"button span\").forEach(item => {\n        if (item.innerHTML === \"Done\") {\n          item.click();\n        }\n      });\n    };\n    onMounted(() => {\n      axios.get(API_URL, {\n        headers: authHeader()\n      }).then(response => {\n        dataSource.value = response.data.data;\n        // households.value = response.data.data;\n        console.log(dataSource.value);\n      }).catch(error => {\n        console.error(error);\n      });\n    });\n    return {\n      onSubmit,\n      submitPromo,\n      current,\n      coupon,\n      rtl,\n      formState,\n      ...toRefs(formState)\n    };\n  }\n});\nexport default PaySummary;","map":{"version":3,"names":["computed","onMounted","reactive","ref","toRefs","defineComponent","useStore","authHeader","axios","PaySummary","name","props","data","cardData","activity","perdiem","promoCode","setup","state","rtl","themeLayout","rtlData","dataSource","coupon","promo","current","submitPromo","values","value","API_URL","process","env","VUE_APP_BASE_URL","formState","couponType","layout","onSubmit","document","querySelectorAll","forEach","item","innerHTML","click","get","headers","then","response","console","log","catch","error"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/pages/payroll/PaySummary.vue"],"sourcesContent":["<template>\n  <sdCards\n    :bodyStyle=\"{\n      backgroundColor: '#F8F9FB',\n      borderRadius: '20px',\n    }\"\n    headless\n  >\n    <div class=\"card-container\">\n      <sdCards\n        v-for=\"(card, index) in cardData\"\n        :key=\"index\"\n        :bodyStyle=\"{\n          backgroundColor: '#ffffff',\n          borderRadius: '20px',\n        }\"\n        headless\n      >\n        <div class=\"order-summary-inner\">\n          <br />\n          <sdHeading class=\"summary-total\" as=\"h4\">\n            <span class=\"summary-total-label\">Activity : </span>\n            <span class=\"summary-total-amount\">{{ card.activity }}</span>\n          </sdHeading>\n          <br />\n          <sdHeading class=\"summary-total\" as=\"h4\">\n            <span class=\"summary-total-label\">Perdiem : </span>\n            <span class=\"summary-total-amount\">{{ card.perdiem }}</span>\n          </sdHeading>\n          <br />\n          <br />\n          <a-form\n            :layout=\"formState.layout\"\n            :model=\"formState\"\n            :onFinish=\"submitPromo\"\n          >\n            <div class=\"promo-apply-form\">\n              <a-form-item name=\"promoCode\" label=\"Comments\">\n                <a-input v-model:value=\"promoCode\" placeholder=\"Comment\" />\n              </a-form-item>\n              <a-form-item>\n                <sdButton\n                  htmlType=\"submit\"\n                  size=\"default\"\n                  type=\"success\"\n                  outlined\n                >\n                  Approve\n                </sdButton>\n                &nbsp;&nbsp;\n                <sdButton\n                  htmlType=\"submit\"\n                  size=\"default\"\n                  type=\"danger\"\n                  outlined\n                >\n                  Decline\n                </sdButton>\n              </a-form-item>\n            </div>\n          </a-form>\n          <sdButton\n            v-if=\"current === 3\"\n            @click=\"onSubmit\"\n            class=\"btn-proceed\"\n            type=\"secondary\"\n            size=\"large\"\n          >\n            <a to=\"#\">Place Order</a>\n          </sdButton>\n        </div>\n      </sdCards>\n    </div>\n  </sdCards>\n</template>\n<script>\nimport {\n  computed,\n  onMounted,\n  reactive,\n  ref,\n  toRefs,\n  defineComponent,\n} from \"vue\";\nimport { useStore } from \"vuex\";\nimport authHeader from \"../../../services/auth-header\";\nimport axios from \"axios\";\n\nconst PaySummary = defineComponent({\n  name: \"PaySummary\",\n  props: [\"subtotal\"],\n  data() {\n    return {\n      cardData: [\n        { activity: \"Activity 1\", perdiem: \"$50\" },\n        { activity: \"Activity 2\", perdiem: \"$75\" },\n        { activity: \"Activity 3\", perdiem: \"$100\" },\n      ],\n      promoCode: \"\",\n    };\n  },\n  setup() {\n    const { state } = useStore();\n    const rtl = computed(() => state.themeLayout.rtlData);\n    const dataSource = ref([]);\n    const coupon = ref(0);\n    const promo = ref(0);\n    const current = ref(0);\n    const submitPromo = (values) => {\n      promo.value = values;\n    };\n    const API_URL = `${process.env.VUE_APP_BASE_URL}/payroll_detail?payroll_list_id=1`;\n\n    const formState = reactive({\n      couponType: \"\",\n      promoCode: \"\",\n      layout: \"horizontal\",\n    });\n\n    const onSubmit = () => {\n      document.querySelectorAll(\"button span\").forEach((item) => {\n        if (item.innerHTML === \"Done\") {\n          item.click();\n        }\n      });\n    };\n    onMounted(() => {\n      axios\n        .get(API_URL, {\n          headers: authHeader(),\n        })\n        .then((response) => {\n          dataSource.value = response.data.data;\n          // households.value = response.data.data;\n          console.log(dataSource.value);\n        })\n        .catch((error) => {\n          console.error(error);\n        });\n    });\n    return {\n      onSubmit,\n      submitPromo,\n      current,\n      coupon,\n      rtl,\n      formState,\n      ...toRefs(formState),\n    };\n  },\n});\n\nexport default PaySummary;\n</script>\n<style>\n.card-container {\n  display: block;\n}\n\n</style>\n"],"mappings":"AA4EA,SACEA,QAAQ,EACRC,SAAS,EACTC,QAAQ,EACRC,GAAG,EACHC,MAAM,EACNC,eAAe,QACV,KAAK;AACZ,SAASC,QAAO,QAAS,MAAM;AAC/B,OAAOC,UAAS,MAAO,+BAA+B;AACtD,OAAOC,KAAI,MAAO,OAAO;AAEzB,MAAMC,UAAS,GAAIJ,eAAe,CAAC;EACjCK,IAAI,EAAE,YAAY;EAClBC,KAAK,EAAE,CAAC,UAAU,CAAC;EACnBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,QAAQ,EAAE,CACR;QAAEC,QAAQ,EAAE,YAAY;QAAEC,OAAO,EAAE;MAAM,CAAC,EAC1C;QAAED,QAAQ,EAAE,YAAY;QAAEC,OAAO,EAAE;MAAM,CAAC,EAC1C;QAAED,QAAQ,EAAE,YAAY;QAAEC,OAAO,EAAE;MAAO,CAAC,CAC5C;MACDC,SAAS,EAAE;IACb,CAAC;EACH,CAAC;EACDC,KAAKA,CAAA,EAAG;IACN,MAAM;MAAEC;IAAM,IAAIZ,QAAQ,EAAE;IAC5B,MAAMa,GAAE,GAAInB,QAAQ,CAAC,MAAMkB,KAAK,CAACE,WAAW,CAACC,OAAO,CAAC;IACrD,MAAMC,UAAS,GAAInB,GAAG,CAAC,EAAE,CAAC;IAC1B,MAAMoB,MAAK,GAAIpB,GAAG,CAAC,CAAC,CAAC;IACrB,MAAMqB,KAAI,GAAIrB,GAAG,CAAC,CAAC,CAAC;IACpB,MAAMsB,OAAM,GAAItB,GAAG,CAAC,CAAC,CAAC;IACtB,MAAMuB,WAAU,GAAKC,MAAM,IAAK;MAC9BH,KAAK,CAACI,KAAI,GAAID,MAAM;IACtB,CAAC;IACD,MAAME,OAAM,GAAK,GAAEC,OAAO,CAACC,GAAG,CAACC,gBAAiB,mCAAkC;IAElF,MAAMC,SAAQ,GAAI/B,QAAQ,CAAC;MACzBgC,UAAU,EAAE,EAAE;MACdlB,SAAS,EAAE,EAAE;MACbmB,MAAM,EAAE;IACV,CAAC,CAAC;IAEF,MAAMC,QAAO,GAAIA,CAAA,KAAM;MACrBC,QAAQ,CAACC,gBAAgB,CAAC,aAAa,CAAC,CAACC,OAAO,CAAEC,IAAI,IAAK;QACzD,IAAIA,IAAI,CAACC,SAAQ,KAAM,MAAM,EAAE;UAC7BD,IAAI,CAACE,KAAK,EAAE;QACd;