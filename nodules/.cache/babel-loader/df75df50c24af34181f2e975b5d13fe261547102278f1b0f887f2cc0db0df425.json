{"ast":null,"code":"import \"ant-design-vue/es/notification/style\";\nimport _notification from \"ant-design-vue/es/notification\";\nimport { Main } from \"../styled\";\nimport { SearchResultWrapper } from \"./style\";\nimport { computed, onMounted, ref, reactive, defineComponent } from \"vue\";\nimport authHeader from \"../../../src/services/auth-header\";\nimport axios from \"axios\";\nimport { useStore } from \"vuex\";\n// const households = ref([]);\n\nconst columns = [{\n  title: \"First name\",\n  dataIndex: \"first_name\",\n  key: \"id_no\"\n}, {\n  title: \"Last name\",\n  dataIndex: \"last_name\",\n  key: \"id_no\"\n}, {\n  title: \"Phone number\",\n  dataIndex: \"phone_no\",\n  key: \"id_no\"\n}, {\n  title: \"Household size\",\n  dataIndex: \"hh_size\",\n  key: \"id_no\"\n}, {\n  title: \"Village\",\n  dataIndex: \"location_id\",\n  key: \"id_no\"\n}, {\n  title: \"CHV\",\n  dataIndex: \"chw_id\",\n  key: \"id_no\"\n}, {\n  title: \"Timestamp\",\n  dataIndex: \"created_at\",\n  key: \"id_no\"\n}, {\n  title: \"\",\n  dataIndex: \"\",\n  key: \"households\",\n  slots: {\n    customRender: \"households\"\n  }\n}];\nexport default defineComponent({\n  name: \"HouseHold Validation\",\n  components: {\n    Main,\n    SearchResultWrapper\n  },\n  data() {\n    return {\n      notData: this.searchData,\n      current: 0,\n      pageSize: 0,\n      visible: false,\n      confirmLoading: false,\n      modalType: \"primary\",\n      colorVisible: false,\n      households: []\n    };\n  },\n  methods: {\n    handleSearch(searchText) {\n      const data = this.searchData.filter(item => item.title.toUpperCase().startsWith(searchText.toUpperCase()));\n      this.notData = data;\n    },\n    // handleChange(value) {\n    //   this.activeClass = value;\n    // },\n    onShowSizeChange(current, pageSize) {\n      this.current = current;\n      this.pageSize = pageSize;\n    },\n    searchData() {\n      return this.$store.state.headerSearch.data;\n    }\n  },\n  setup() {\n    const {\n      state\n    } = useStore();\n    const crud = computed(() => state.crud.data);\n    const isLoading = computed(() => state.crud.loading);\n    const selectedRowKeys = ref([]);\n    const dataSource = ref([]);\n    const activeClass = ref(\"all\");\n    const API_URL = `${process.env.VUE_APP_BASE_URL}/households`;\n    const households_url = `${process.env.VUE_APP_BASE_URL}/generateHHCSV`;\n    const exportHouseHoldData = async () => {\n      try {\n        const response = await fetch(households_url, {\n          method: \"GET\",\n          headers: {\n            \"Content-Type\": \"application/json\",\n            ...authHeader()\n          }\n        });\n        if (!response.ok) {\n          throw new Error(\"Failed to fetch export data\");\n        }\n        const fileBlob = await response.blob();\n        const fileName = \"households.csv\";\n        const link = document.createElement(\"a\");\n        link.href = window.URL.createObjectURL(new Blob([fileBlob]));\n        link.setAttribute(\"download\", fileName);\n        document.body.appendChild(link);\n        link.click();\n        link.parentNode.removeChild(link);\n      } catch (error) {\n        console.error(error);\n      }\n    };\n    const filteredData = computed(() => {\n      if (activeClass.value === \"approved\") {\n        console.log(dataSource.value);\n        return dataSource.value.filter(item => item.isVerified === 1);\n      } else if (activeClass.value === \"outliers\") {\n        return dataSource.value.filter(item => item.isVerified === 0);\n      } else {\n        return dataSource.value;\n      }\n    });\n    const handleChange = tab => {\n      activeClass.value = tab;\n    };\n    onMounted(() => {\n      axios.get(API_URL, {\n        headers: authHeader()\n      }).then(response => {\n        dataSource.value = response.data.data;\n        // households.value = response.data.data;\n        console.log(dataSource.value);\n      }).catch(error => {\n        console.error(error);\n      });\n    });\n    const handleVerify = record => {\n      console.log(record);\n      axios.get(`${process.env.VUE_APP_BASE_URL}/verify_house_hold/${record}`, {\n        headers: authHeader()\n      }).then(({\n        status\n      }) => {\n        console.log(status);\n        if (status == 200) {\n          location.reload();\n          _notification[\"success\"]({\n            message: \"HouseHold Verified\",\n            description: `HouseHold has been verified successfully`,\n            duration: 5.5\n          });\n        }\n      }).catch(error => {\n        // handle error\n        console.log(error);\n      });\n    };\n\n    // handleChange(tab) {\n    //   if (tab === 'all') {\n    //     filteredData.value = dataSource.value;\n    //   } else if (tab === 'approved') {\n    //     filteredData.value = dataSource.value.filter(item => item.isVerified === 1);\n    //   } else if (tab === 'outliers') {\n    //     filteredData.value = dataSource.value.filter(item => item.hh_size > 5);\n    //   }\n    // }\n\n    const formState = reactive({\n      searchItem: \"\"\n    });\n    return {\n      crud,\n      isLoading,\n      selectedRowKeys,\n      dataSource,\n      columns,\n      formState,\n      exportHouseHoldData,\n      filteredData,\n      handleChange,\n      activeClass,\n      handleVerify\n    };\n  }\n  // computed: {\n  // },\n});","map":{"version":3,"names":["Main","SearchResultWrapper","computed","onMounted","ref","reactive","defineComponent","authHeader","axios","useStore","columns","title","dataIndex","key","slots","customRender","name","components","data","notData","searchData","current","pageSize","visible","confirmLoading","modalType","colorVisible","households","methods","handleSearch","searchText","filter","item","toUpperCase","startsWith","onShowSizeChange","$store","state","headerSearch","setup","crud","isLoading","loading","selectedRowKeys","dataSource","activeClass","API_URL","process","env","VUE_A