ers')\"\r\n                    href=\"#\"\r\n                  >\r\n                    Outliers\r\n                  </a>\r\n                </li>\r\n              </ul>\r\n            </div>\r\n          </a-col>\r\n          <a-col :xs=\"24\">\r\n            <sdCards headless>\r\n              <div class=\"result-list-content\">\r\n                <a-row :gutter=\"15\">\r\n                  <a-col class=\"w-100\" :md=\"24\">\r\n                    <sdCards headless>\r\n                      <div v-if=\"isLoading\" class=\"spin\">\r\n                        <a-spin />\r\n                      </div>\r\n\r\n                      <div v-else>\r\n                        <TableWrapper\r\n                          class=\"table-data-view table-responsive\"\r\n                          v-show=\"activeClass === 'all'\"\r\n                        >\r\n                          <a-table\r\n                            :pagination=\"{\r\n                              pageSize: 50,\r\n                              showSizeChanger: true,\r\n                            }\"\r\n                            :dataSource=\"filteredData\"\r\n                            :columns=\"columns\"\r\n                          >\r\n                          </a-table>\r\n                        </TableWrapper>\r\n\r\n                        <TableWrapper\r\n                          class=\"table-data-view table-responsive\"\r\n                          v-show=\"activeClass === 'approved'\"\r\n                        >\r\n                          <a-table\r\n                            :pagination=\"{\r\n                              pageSize: 40,\r\n                              showSizeChanger: true,\r\n                            }\"\r\n                            :dataSource=\"filteredData\"\r\n                            :columns=\"columns\"\r\n                          >\r\n                          </a-table>\r\n                        </TableWrapper>\r\n\r\n                        <TableWrapper\r\n                          class=\"table-data-view table-responsive\"\r\n                          v-show=\"activeClass === 'outliers'\"\r\n                        >\r\n                          <a-table\r\n                            :pagination=\"{\r\n                              pageSize: 40,\r\n                              showSizeChanger: true,\r\n                            }\"\r\n                            :dataSource=\"filteredData\"\r\n                            :columns=\"columns\"\r\n                          >\r\n                            <template #households=\"{ record }\">\r\n                              <td :style=\"{ 'margin-left': '3px' }\">\r\n                                <div class=\"table-actions\">\r\n                                  <sdButton type=\"check\" size=\"16\" @click=\"handleVerify(record.id)\">\r\n                                      &nbsp;&nbsp;\r\n                                      <span class=\"badge badge-green\"\r\n                                        >&nbsp;&nbsp; Verify</span\r\n                                      >\r\n                                  </sdButton>\r\n                                </div>\r\n                              </td>\r\n                            </template>\r\n                          </a-table>\r\n                        </TableWrapper>\r\n                      </div>\r\n                    </sdCards>\r\n                  </a-col>\r\n                </a-row>\r\n              </div>\r\n              <!-- <a-pagination\r\n                show-size-changer\r\n                :default-current=\"3\"\r\n                :total=\"40\"\r\n                @showSizeChange=\"onShowSizeChange\"\r\n              /> -->\r\n            </sdCards>\r\n          </a-col>\r\n        </a-row>\r\n      </SearchResultWrapper>\r\n    </Main>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { Main } from \"../styled\";\r\nimport { SearchResultWrapper } from \"./style\";\r\nimport { computed, onMounted, ref, reactive, defineComponent } from \"vue\";\r\nimport authHeader from \"../../../src/services/auth-header\";\r\nimport axios from \"axios\";\r\nimport { useStore } from \"vuex\";\r\nimport { notification } from \"ant-design-vue\";\r\n\r\n// const households = ref([]);\r\n\r\nconst columns = [\r\n  {\r\n    title: \"First name\",\r\n    dataIndex: \"first_name\",\r\n    key: \"id_no\",\r\n  },\r\n  {\r\n    title: \"Last name\",\r\n    dataIndex: \"last_name\",\r\n    key: \"id_no\",\r\n  },\r\n  {\r\n    title: \"Phone number\",\r\n    dataIndex: \"phone_no\",\r\n    key: \"id_no\",\r\n  },\r\n  {\r\n    title: \"Household size\",\r\n    dataIndex: \"hh_size\",\r\n    key: \"id_no\",\r\n  },\r\n  {\r\n    title: \"Village\",\r\n    dataIndex: \"location_id\",\r\n    key: \"id_no\",\r\n  },\r\n  {\r\n    title: \"CHV\",\r\n    dataIndex: \"chw_id\",\r\n    key: \"id_no\",\r\n  },\r\n  {\r\n    title: \"Timestamp\",\r\n    dataIndex: \"created_at\",\r\n    key: \"id_no\",\r\n  },\r\n  {\r\n    title: \"\",\r\n    dataIndex: \"\",\r\n    key: \"households\",\r\n    slots: { customRender: \"households\" },\r\n  },\r\n];\r\nexport default defineComponent({\r\n  name: \"HouseHold Validation\",\r\n  components: {\r\n    Main,\r\n    SearchResultWrapper,\r\n  },\r\n  data() {\r\n    return {\r\n      notData: this.searchData,\r\n      current: 0,\r\n      pageSize: 0,\r\n      visible: false,\r\n      confirmLoading: false,\r\n      modalType: \"primary\",\r\n      colorVisible: false,\r\n      households: [],\r\n    };\r\n  },\r\n  methods: {\r\n    handleSearch(searchText) {\r\n      const data = this.searchData.filter((item) =>\r\n        item.title.toUpperCase().startsWith(searchText.toUpperCase())\r\n      );\r\n      this.notData = data;\r\n    },\r\n    // handleChange(value) {\r\n    //   this.activeClass = value;\r\n    // },\r\n    onShowSizeChange(current, pageSize) {\r\n      this.current = current;\r\n      this.pageSize = pageSize;\r\n    },\r\n    searchData() {\r\n      return this.$store.state.headerSearch.data;\r\n    },\r\n  },\r\n  setup() {\r\n    const { state } = useStore();\r\n    const crud = computed(() => state.crud.data);\r\n    const isLoading = computed(() => state.crud.loading);\r\n    const selectedRowKeys = ref([]);\r\n    const dataSource = ref([]);\r\n    const activeClass = ref(\"all\");\r\n\r\n    const API_URL = `${process.env.VUE_APP_BASE_URL}/households`;\r\n\r\n    const households_url = `${process.env.VUE_APP_BASE_URL}/generateHHCSV`;\r\n\r\n    const exportHouseHoldData = async () => {\r\n      try {\r\n        const response = await fetch(households_url, {\r\n          method: \"GET\",\r\n          headers: {\r\n            \"Content-Type\": \"application/json\",\r\n            ...authHeader(),\r\n          },\r\n        });\r\n\r\n        if (!response.ok) {\r\n          throw new Error(\"Failed to fetch export data\");\r\n        }\r\n\r\n        const fileBlob = await response.blob();\r\n        const fileName = \"households.csv\";\r\n        const link = document.createElement(\"a\");\r\n        link.href = window.URL.createObjectURL(new Blob([fileBlob]));\r\n        link.setAttribute(\"download\", fileName);\r\n        document.body.appendChild(link);\r\n        link.click();\r\n        link.parentNode.removeChild(link);\r\n      } catch (error) {\r\n        console.error(error);\r\n      }\r\n    };\r\n\r\n    const filteredData = computed(() => {\r\n      if (activeClass.value === \"approved\") {\r\n        console.log(dataSource.value);\r\n        return dataSource.value.filter((item) => item.isVerified === 1);\r\n      } else if (activeClass.value === \"outliers\") {\r\n        return dataSource.value.filter((item) => item.isVerified === 0);\r\n      } else {\r\n        return dataSource.value;\r\n      }\r\n    });\r\n\r\n    const handleChange = (tab) => {\r\n      activeClass.value = tab;\r\n    };\r\n\r\n    onMounted(() => {\r\n      axios\r\n        .get(