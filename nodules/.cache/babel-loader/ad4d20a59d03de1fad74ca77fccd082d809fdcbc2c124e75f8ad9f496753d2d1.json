{"ast":null,"code":"import { ref, defineComponent } from 'vue';\nimport VueTypes from 'vue-types';\nimport { StepsStyle, ActionWrapper } from './style';\nexport default defineComponent({\n  name: 'BasicSteps',\n  components: {\n    StepsStyle,\n    ActionWrapper\n  },\n  props: {\n    step: VueTypes.oneOf(['basic', 'withIcon', 'switch', 'direction']).def('basic'),\n    size: VueTypes.oneOf(['small', 'bar', 'default']).def('small'),\n    direction: VueTypes.oneOf(['bar', 'horizontal', 'vertical']),\n    status: VueTypes.oneOf(['wait', 'process', 'finish', 'error']),\n    current: VueTypes.number.def(1),\n    title: VueTypes.arrayOf(VueTypes.string),\n    data: VueTypes.arrayOf(VueTypes.object)\n  },\n  setup() {\n    const current1 = ref(0);\n    const next = () => {\n      current1.value++;\n    };\n    const prev = () => {\n      current1.value--;\n    };\n    return {\n      current1,\n      next,\n      prev\n    };\n  }\n});","map":{"version":3,"names":["ref","defineComponent","VueTypes","StepsStyle","ActionWrapper","name","components","props","step","oneOf","def","size","direction","status","current","number","title","arrayOf","string","data","object","setup","current1","next","value","prev"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/components/steps/Basic.vue"],"sourcesContent":["<template>\r\n  <StepsStyle :current=\"current\" :size=\"size\" v-if=\"step == 'basic'\" :status=\"status\">\r\n    <a-step v-for=\"title in title\" :title=\"title\" :key=\"title\" />\r\n  </StepsStyle>\r\n  <StepsStyle :status=\"status\" :direction=\"direction\" :current=\"current\" :size=\"size\" v-if=\"step == 'direction'\">\r\n    <a-step v-for=\"item in data\" :title=\"item.title\" :description=\"item.description\" :key=\"item.id\" />\r\n  </StepsStyle>\r\n  <StepsStyle :size=\"size\" v-if=\"step == 'withIcon'\">\r\n    <a-step v-for=\"item in data\" :title=\"item.title\" :key=\"item.id\" status=\"item.status\">\r\n      <template #icon>\r\n        <sdFeatherIcons :type=\"item.icon\" size=\"24\" />\r\n      </template>\r\n    </a-step>\r\n  </StepsStyle>\r\n  <ActionWrapper v-if=\"step == 'switch'\">\r\n    <a-row>\r\n      <a-col :xs=\"24\">\r\n        <a-steps :current=\"current1\">\r\n          <a-step v-for=\"item in data\" :key=\"item.title\" :title=\"item.title\" />\r\n        </a-steps>\r\n        <div class=\"steps-content\">\r\n          {{ data[current1].content }}\r\n        </div>\r\n        <div class=\"steps-action\">\r\n          <a-button v-if=\"current1 < data.length - 1\" class=\"btn-next\" type=\"primary\" @click=\"next\">\r\n            Save & Next <sdFeatherIcons type=\"arrow-right\" size=\"14\" />\r\n          </a-button>\r\n          <a-button v-if=\"current1 == data.length - 1\" type=\"primary\" @click=\"$message.success('Processing complete!')\">\r\n            Done\r\n          </a-button>\r\n          <a-button class=\"btn-prev\" v-if=\"current1 > 0\" @click=\"prev\">\r\n            <sdFeatherIcons type=\"arrow-left\" size=\"14\" />\r\n            Previous\r\n          </a-button>\r\n        </div>\r\n      </a-col>\r\n    </a-row>\r\n  </ActionWrapper>\r\n</template>\r\n\r\n<script>\r\nimport { ref, defineComponent } from 'vue';\r\nimport VueTypes from 'vue-types';\r\nimport { StepsStyle, ActionWrapper } from './style';\r\nexport default defineComponent({\r\n  name: 'BasicSteps',\r\n  components: { StepsStyle, ActionWrapper },\r\n  props: {\r\n    step: VueTypes.oneOf(['basic', 'withIcon', 'switch', 'direction']).def('basic'),\r\n    size: VueTypes.oneOf(['small', 'bar', 'default']).def('small'),\r\n    direction: VueTypes.oneOf(['bar', 'horizontal', 'vertical']),\r\n    status: VueTypes.oneOf(['wait', 'process', 'finish', 'error']),\r\n    current: VueTypes.number.def(1),\r\n    title: VueTypes.arrayOf(VueTypes.string),\r\n    data: VueTypes.arrayOf(VueTypes.object),\r\n  },\r\n  setup() {\r\n    const current1 = ref(0);\r\n    const next = () => {\r\n      current1.value++;\r\n    };\r\n    const prev = () => {\r\n      current1.value--;\r\n    };\r\n    return {\r\n      current1,\r\n      next,\r\n      prev,\r\n    };\r\n  },\r\n});\r\n</script>\r\n\r\n<style scoped>\r\n.steps-content {\r\n  margin-top: 16px;\r\n  border: 1px dashed #e9e9e9;\r\n  border-radius: 6px;\r\n  background-color: #fafafa;\r\n  min-height: 200px;\r\n  text-align: center;\r\n  padding-top: 80px;\r\n}\r\n.steps-action {\r\n  margin-top: 24px;\r\n}\r\n</style>\r\n"],"mappings":"AAyCA,SAASA,GAAG,EAAEC,eAAc,QAAS,KAAK;AAC1C,OAAOC,QAAO,MAAO,WAAW;AAChC,SAASC,UAAU,EAAEC,aAAY,QAAS,SAAS;AACnD,eAAeH,eAAe,CAAC;EAC7BI,IAAI,EAAE,YAAY;EAClBC,UAAU,EAAE;IAAEH,UAAU;IAAEC;EAAc,CAAC;EACzCG,KAAK,EAAE;IACLC,IAAI,EAAEN,QAAQ,CAACO,KAAK,CAAC,CAAC,OAAO,EAAE,UAAU,EAAE,QAAQ,EAAE,WAAW,CAAC,CAAC,CAACC,GAAG,CAAC,OAAO,CAAC;IAC/EC,IAAI,EAAET,QAAQ,CAACO,KAAK,CAAC,CAAC,OAAO,EAAE,KAAK,EAAE,SAAS,CAAC,CAAC,CAACC,GAAG,CAAC,OAAO,CAAC;IAC9DE,SAAS,EAAEV,QAAQ,CAACO,KAAK,CAAC,CAAC,KAAK,EAAE,YAAY,EAAE,UAAU,CAAC,CAAC;IAC5DI,MAAM,EAAEX,QAAQ,CAACO,KAAK,CAAC,CAAC,MAAM,EAAE,SAAS,EAAE,QAAQ,EAAE,OAAO,CAAC,CAAC;IAC9DK,OAAO,EAAEZ,QAAQ,CAACa,MAAM,CAACL,GAAG,CAAC,CAAC,CAAC;IAC/BM,KAAK,EAAEd,QAAQ,CAACe,OAAO,CAACf,QAAQ,CAACgB,MAAM,CAAC;IACxCC,IAAI,EAAEjB,QAAQ,CAACe,OAAO,CAACf,QAAQ,CAACkB,MAAM;EACxC,CAAC;EACDC,KAAKA,CAAA,EAAG;IACN,MAAMC,QAAO,GAAItB,GAAG,CAAC,CAAC,CAAC;IACvB,MAAMuB,IAAG,GAAIA,CAAA,KAAM;MACjBD,QAAQ,CAACE,KAAK,EAAE;IAClB,CAAC;IACD,MAAMC,IAAG,GAAIA,CAAA,KAAM;MACjBH,QAAQ,CAACE,KAAK,EAAE;IAClB,CAAC;IACD,OAAO;MACLF,QAAQ;MACRC,IAAI;MACJE;IACF,CAAC;EACH;AACF,CAAC,CAAC"},"metadata":{},"sourceType":"module","externalDependencies":[]}