{"ast":null,"code":"import { RecordViewWrapper } from \"../style\";\nimport { Main, TableWrapper } from \"../../styled\";\nimport { useStore } from \"vuex\";\nimport { computed, onMounted, ref, reactive, defineComponent } from \"vue\";\n// import axios from \"axios\";\nimport authHeader from \"../../../services/auth-header\";\n//   import UserService from \"../../../services/user.service\";\n// import { useRouter } from \"vue-router\";\n// import DragAndDropTable from '../../../view/table/DragTable.vue';\n\n// console.log(userService.getAll());\n\nconst columns = [{\n  title: \"Product Name\",\n  dataIndex: \"product_name\",\n  key: \"id\"\n}, {\n  title: \"Batch No\",\n  dataIndex: \"batch_no\",\n  key: \"id\"\n}, {\n  title: \"Warehouse Name\",\n  dataIndex: \"warehouse_name\",\n  key: \"id\"\n}, {\n  title: \"Quantity Available\",\n  dataIndex: \"quantity_available\",\n  key: \"id\"\n}, {\n  title: \"Product Source\",\n  dataIndex: \"product_source\",\n  key: \"id\"\n}];\nconst DragAndDropTable = defineComponent({\n  name: \"ViewPage\",\n  components: {\n    RecordViewWrapper,\n    Main,\n    TableWrapper\n  },\n  setup() {\n    const {\n      state,\n      dispatch\n    } = useStore();\n    const crud = computed(() => state.crud.data);\n    const isLoading = computed(() => state.crud.loading);\n    const selectedRowKeys = ref([]);\n    const dataSource = ref([]);\n    // const { state, dispatch } = useStore();\n    // const router = useRouter();\n\n    // if (!state.auth.isAuthenticated) {\n    //   router.push({ name: \"login\" });\n    // }\n\n    console.log(authHeader());\n\n    //   const api_url = UserService;\n    //   console.log(api_url);\n\n    onMounted(async () => {\n      try {\n        const response = await fetch(`${process.env.VUE_APP_BASE_URL}/stock_status`, {\n          method: \"GET\",\n          headers: authHeader()\n        });\n        console.log(response);\n        const data = await response.json();\n        dataSource.value = data.data;\n        console.log(data.data);\n      } catch (error) {\n        console.error(error);\n      }\n    });\n    const handleDelete = id => {\n      const confirm = window.confirm(\"Are you sure delete this?\");\n      if (confirm) {\n        dispatch(\"axiosDataDelete\", {\n          id,\n          getData: () => {\n            dispatch(\"axiosCrudGetData\");\n          }\n        });\n      }\n      return false;\n    };\n    const formState = reactive({\n      searchItem: \"\"\n    });\n    const onSelectChange = selectedRowKey => {\n      selectedRowKeys.value = selectedRowKey;\n    };\n    const rowSelection = {\n      selectedRowKeys,\n      onChange: onSelectChange\n    };\n    return {\n      crud,\n      isLoading,\n      selectedRowKeys,\n      handleDelete,\n      rowSelection,\n      onSelectChange,\n      dataSource,\n      columns,\n      formState\n    };\n  }\n});\nexport default DragAndDropTable;","map":{"version":3,"names":["RecordViewWrapper","Main","TableWrapper","useStore","computed","onMounted","ref","reactive","defineComponent","authHeader","columns","title","dataIndex","key","DragAndDropTable","name","components","setup","state","dispatch","crud","data","isLoading","loading","selectedRowKeys","dataSource","console","log","response","fetch","process","env","VUE_APP_BASE_URL","method","headers","json","value","error","handleDelete","id","confirm","window","getData","formState","searchItem","onSelectChange","selectedRowKey","rowSelection","onChange"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/pages/users/stockStatus.vue"],"sourcesContent":["<template>\n    <RecordViewWrapper>\n      <sdPageHeader title=\"Stock Status\">\n        <template #subTitle>\n          <sdButton class=\"btn-add_new\" size=\"default\" type=\"success\">\n            <!-- <router-link to=\"/campaigns/create-campaign\">\n              <sdFeatherIcons type=\"plus\" size=\"14\" /> Start New\n              Campaign</router-link\n            > -->\n          </sdButton>\n        </template>\n        <!-- <template #buttons>\n          <div class=\"search-box\">\n            <span class=\"search-icon\">\n              <sdFeatherIcons type=\"search\" size=\"14\" />\n            </span></div\n        ></template> -->\n      </sdPageHeader>\n      <Main>\n        <a-row :gutter=\"15\">\n          <a-col class=\"w-100\" :md=\"24\">\n            <sdCards headless>\n              <div v-if=\"isLoading\" class=\"spin\">\n                <a-spin />\n              </div>\n  \n              <div v-else>\n                <TableWrapper class=\"table-data-view table-responsive\">\n                  <a-table\n                    :rowSelection=\"rowSelection\"\n                    :pagination=\"{ pageSize: 10, showSizeChanger: true }\"\n                    :dataSource=\"dataSource\"\n                    :columns=\"columns\"\n                  />\n                </TableWrapper>\n              </div>\n            </sdCards>\n          </a-col>\n        </a-row>\n        <a-col :xs=\"24\">\n          <DragAndDropTable />\n        </a-col>\n      </Main>\n    </RecordViewWrapper>\n  </template>\n  <script>\n  import { RecordViewWrapper } from \"../style\";\n  import { Main, TableWrapper } from \"../../styled\";\n  import { useStore } from \"vuex\";\n  import { computed, onMounted, ref, reactive, defineComponent } from \"vue\";\n  // import axios from \"axios\";\n  import authHeader from \"../../../services/auth-header\";\n//   import UserService from \"../../../services/user.service\";\n  // import { useRouter } from \"vue-router\";\n  // import DragAndDropTable from '../../../view/table/DragTable.vue';\n  \n  // console.log(userService.getAll());\n  \n  const columns = [\n    {\n      title: \"Product Name\",\n      dataIndex: \"product_name\",\n      key: \"id\",\n    },\n    {\n      title: \"Batch No\",\n      dataIndex: \"batch_no\",\n      key: \"id\",\n    },\n    {\n      title: \"Warehouse Name\",\n      dataIndex: \"warehouse_name\",\n      key: \"id\",\n    },\n    {\n      title: \"Quantity Available\",\n      dataIndex: \"quantity_available\",\n      key: \"id\",\n    },\n    {\n      title: \"Product Source\",\n      dataIndex: \"product_source\",\n      key: \"id\",\n    },\n  ];\n  \n  const DragAndDropTable = defineComponent({\n    name: \"ViewPage\",\n    components: { RecordViewWrapper, Main, TableWrapper },\n  \n    setup() {\n      const { state, dispatch } = useStore();\n      const crud = computed(() => state.crud.data);\n      const isLoading = computed(() => state.crud.loading);\n      const selectedRowKeys = ref([]);\n      const dataSource = ref([]);\n      // const { state, dispatch } = useStore();\n      // const router = useRouter();\n  \n      // if (!state.auth.isAuthenticated) {\n      //   router.push({ name: \"login\" });\n      // }\n  \n      console.log(authHeader());\n  \n    //   const api_url = UserService;\n    //   console.log(api_url);\n  \n      onMounted(async () => {\n        try {\n          const response = await fetch(`${process.env.VUE_APP_BASE_URL}/stock_status`, {\n            method: \"GET\",\n            headers: authHeader(),\n          });\n          console.log(response);\n          const data = await response.json();\n          dataSource.value = data.data;\n          console.log(data.data);\n        } catch (error) {\n          console.error(error);\n        }\n      });\n  \n      const handleDelete = (id) => {\n        const confirm = window.confirm(\"Are you sure delete this?\");\n        if (confirm) {\n          dispatch(\"axiosDataDelete\", {\n            id,\n            getData: () => {\n              dispatch(\"axiosCrudGetData\");\n            },\n          });\n        }\n        return false;\n      };\n  \n      const formState = reactive({\n        searchItem: \"\",\n      });\n  \n      const onSelectChange = (selectedRowKey) => {\n        selectedRowKeys.value = selectedRowKey;\n      };\n  \n      const rowSelection = {\n        selectedRowKeys,\n        onChange: onSelectChange,\n      };\n  \n      return {\n        crud,\n        isLoading,\n        selectedRowKeys,\n        handleDelete,\n        rowSelection,\n        onSelectChange,\n        dataSource,\n        columns,\n        formState,\n      };\n    },\n  });\n  \n  export default DragAndDropTable;\n  \n  </script>\n    "],"mappings":"AA8CE,SAASA,iBAAgB,QAAS,UAAU;AAC5C,SAASC,IAAI,EAAEC,YAAW,QAAS,cAAc;AACjD,SAASC,QAAO,QAAS,MAAM;AAC/B,SAASC,QAAQ,EAAEC,SAAS,EAAEC,GAAG,EAAEC,QAAQ,EAAEC,eAAc,QAAS,KAAK;AACzE;AACA,OAAOC,UAAS,MAAO,+BAA+B;AACxD;AACE;AACA;;AAEA;;AAEA,MAAMC,OAAM,GAAI,CACd;EACEC,KAAK,EAAE,cAAc;EACrBC,SAAS,EAAE,cAAc;EACzBC,GAAG,EAAE;AACP,CAAC,EACD;EACEF,KAAK,EAAE,UAAU;EACjBC,SAAS,EAAE,UAAU;EACrBC,GAAG,EAAE;AACP,CAAC,EACD;EACEF,KAAK,EAAE,gBAAgB;EACvBC,SAAS,EAAE,gBAAgB;EAC3BC,GAAG,EAAE;AACP,CAAC,EACD;EACEF,KAAK,EAAE,oBAAoB;EAC3BC,SAAS,EAAE,oBAAoB;EAC/BC,GAAG,EAAE;AACP,CAAC,EACD;EACEF,KAAK,EAAE,gBAAgB;EACvBC,SAAS,EAAE,gBAAgB;EAC3BC,GAAG,EAAE;AACP,CAAC,CACF;AAED,MAAMC,gBAAe,GAAIN,eAAe,CAAC;EACvCO,IAAI,EAAE,UAAU;EAChBC,UAAU,EAAE;IAAEhB,iBAAiB;IAAEC,IAAI;IAAEC;EAAa,CAAC;EAErDe,KAAKA,CAAA,EAAG;IACN,MAAM;MAAEC,KAAK;MAAEC;IAAS,IAAIhB,QAAQ,EAAE;IACtC,MAAMiB,IAAG,GAAIhB,QAAQ,CAAC,MAAMc,KAAK,CAACE,IAAI,CAACC,IAAI,CAAC;IAC5C,MAAMC,SAAQ,GAAIlB,QAAQ,CAAC,MAAMc,KAAK,CAACE,IAAI,CAACG,OAAO,CAAC;IACpD,MAAMC,eAAc,GAAIlB,GAAG,CAAC,EAAE,CAAC;IAC/B,MAAMmB,UAAS,GAAInB,GAAG,CAAC,EAAE,CAAC;IAC1B;IACA;;IAEA;IACA;IACA;;IAEAoB,OAAO,CAACC,GAAG,CAAClB,UAAU,EAAE,CAAC;;IAE3B;IACA;;IAEEJ,SAAS,CAAC,YAAY;MACpB,IAAI;QACF,MAAMuB,QAAO,GAAI,MAAMC,KAAK,CAAE,GAAEC,OAAO,CAACC,GAAG,CAACC,gBAAiB,eAAc,EAAE;UAC3EC,MAAM,EAAE,KAAK;UACbC,OAAO,EAAEzB,UAAU;QACrB,CAAC,CAAC;QACFiB,OAAO,CAACC,GAAG,CAACC,QAAQ,CAAC;QACrB,MAAMP,IAAG,GAAI,MAAMO,QAAQ,CAACO,IAAI,EAAE;QAClCV,UAAU,CAACW,KAAI,GAAIf,IAAI,CAACA,IAAI;QAC5BK,OAAO,CAACC,GAAG,CAACN,IAAI,CAACA,IAAI,CAAC;MACxB,EAAE,OAAOgB,KAAK,EAAE;QACdX,OAAO,CAACW,KAAK,CAACA,KAAK,CAAC;MACtB;IACF,CAAC,CAAC;IAEF,MAAMC,YAAW,GAAKC,EAAE,IAAK;M