{"ast":null,"code":"import { computed, defineComponent } from 'vue';\nimport { useStore } from 'vuex';\nimport { RightAsideWrapper } from './style';\nimport GlightBox from '@/components/utilities/GlightBox.vue';\nconst RightAside = defineComponent({\n  name: 'RightAside',\n  components: {\n    RightAsideWrapper,\n    GlightBox\n  },\n  setup() {\n    const {\n      state,\n      dispatch\n    } = useStore();\n    const friends = computed(() => state.profile.friends);\n    const isLoading = computed(() => state.profile.isLoading);\n    const gallery = computed(() => state.gallery.data);\n    return {\n      friends,\n      gallery,\n      dispatch,\n      isLoading\n    };\n  }\n});\nexport default RightAside;","map":{"version":3,"names":["computed","defineComponent","useStore","RightAsideWrapper","GlightBox","RightAside","name","components","setup","state","dispatch","friends","profile","isLoading","gallery","data"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/apps/myProfile/overview/RightAside.vue"],"sourcesContent":["span\r\n<template>\r\n  <RightAsideWrapper>\r\n    <sdCards title=\"Friends\">\r\n      <ul class=\"ff-widget\">\r\n        <template v-if=\"!isLoading\">\r\n          <li v-for=\"{ name, key, designation, status, img } in friends\" :key=\"key\">\r\n            <div class=\"ff-info\">\r\n              <img :src=\"require(`@/${img}`)\" alt=\"\" />\r\n              <p>\r\n                {{ name }} <span>{{ designation }}</span>\r\n              </p>\r\n            </div>\r\n            <sdButton\r\n              :class=\"status ? 'btn-ff btn-following' : 'btn-ff'\"\r\n              @click=\"() => dispatch('profileFriendsChangeStatus', key)\"\r\n              :outlined=\"!status\"\r\n              :type=\"status ? 'primary' : 'white'\"\r\n            >\r\n              <template v-if=\"!status\">Follow</template>\r\n\r\n              <template v-else>\r\n                <sdFeatherIcons type=\"check\" />\r\n                Following\r\n              </template>\r\n            </sdButton>\r\n          </li>\r\n        </template>\r\n        <p v-else>loading</p>\r\n        <a to=\"#\" class=\"btn-loadMore\"> Load more friends </a>\r\n      </ul>\r\n    </sdCards>\r\n    <sdCards title=\"Photos\">\r\n      <template #button>\r\n        <router-link class=\"btn-seeAll\" to=\"/page/gallery\"> See All </router-link>\r\n      </template>\r\n      <div class=\"widget-photo-list\">\r\n        <a-row :gutter=\"10\">\r\n          <a-col v-for=\"({ img, id }, imageIndex) in gallery\" :key=\"imageIndex\" :xxl=\"8\" :md=\"24\" :sm=\"6\" :xs=\"8\">\r\n            <GlightBox v-if=\"id <= 6\" type=\"image\" :src=\"require(`../../../../${img}`)\">\r\n              <img style=\"width: 100%\" :src=\"require(`../../../../${img}`)\" alt=\"\" />\r\n            </GlightBox>\r\n          </a-col>\r\n        </a-row>\r\n      </div>\r\n    </sdCards>\r\n    <sdCards title=\"Videos\">\r\n      <template #button>\r\n        <a class=\"btn-seeAll\" to=\"#\"> See All </a>\r\n      </template>\r\n      <div class=\"widget-video-list\">\r\n        <a-row :gutter=\"10\">\r\n          <a-col v-for=\"{ img, id } in gallery\" :key=\"id\" :xxl=\"8\" :md=\"24\" :sm=\"6\" :xs=\"8\">\r\n            <GlightBox type=\"video\" src=\"https://vimeo.com/115041822\" v-if=\"id <= 6\" class=\"video\">\r\n              <img style=\"width: 100%\" :src=\"require(`@/${img}`)\" alt=\"\" />\r\n              <span>\r\n                <sdFeatherIcons type=\"play\" />\r\n              </span>\r\n            </GlightBox>\r\n          </a-col>\r\n        </a-row>\r\n      </div>\r\n    </sdCards>\r\n  </RightAsideWrapper>\r\n</template>\r\n<script>\r\nimport { computed, defineComponent } from 'vue';\r\nimport { useStore } from 'vuex';\r\nimport { RightAsideWrapper } from './style';\r\nimport GlightBox from '@/components/utilities/GlightBox.vue';\r\n\r\nconst RightAside = defineComponent({\r\n  name: 'RightAside',\r\n  components: { RightAsideWrapper, GlightBox },\r\n  setup() {\r\n    const { state, dispatch } = useStore();\r\n    const friends = computed(() => state.profile.friends);\r\n    const isLoading = computed(() => state.profile.isLoading);\r\n    const gallery = computed(() => state.gallery.data);\r\n\r\n    return {\r\n      friends,\r\n      gallery,\r\n      dispatch,\r\n      isLoading,\r\n    };\r\n  },\r\n});\r\n\r\nexport default RightAside;\r\n</script>\r\n"],"mappings":"AAkEA,SAASA,QAAQ,EAAEC,eAAc,QAAS,KAAK;AAC/C,SAASC,QAAO,QAAS,MAAM;AAC/B,SAASC,iBAAgB,QAAS,SAAS;AAC3C,OAAOC,SAAQ,MAAO,sCAAsC;AAE5D,MAAMC,UAAS,GAAIJ,eAAe,CAAC;EACjCK,IAAI,EAAE,YAAY;EAClBC,UAAU,EAAE;IAAEJ,iBAAiB;IAAEC;EAAU,CAAC;EAC5CI,KAAKA,CAAA,EAAG;IACN,MAAM;MAAEC,KAAK;MAAEC;IAAS,IAAIR,QAAQ,EAAE;IACtC,MAAMS,OAAM,GAAIX,QAAQ,CAAC,MAAMS,KAAK,CAACG,OAAO,CAACD,OAAO,CAAC;IACrD,MAAME,SAAQ,GAAIb,QAAQ,CAAC,MAAMS,KAAK,CAACG,OAAO,CAACC,SAAS,CAAC;IACzD,MAAMC,OAAM,GAAId,QAAQ,CAAC,MAAMS,KAAK,CAACK,OAAO,CAACC,IAAI,CAAC;IAElD,OAAO;MACLJ,OAAO;MACPG,OAAO;MACPJ,QAAQ;MACRG;IACF,CAAC;EACH;AACF,CAAC,CAAC;AAEF,eAAeR,UAAU"},"metadata":{},"sourceType":"module","externalDependencies":[]}