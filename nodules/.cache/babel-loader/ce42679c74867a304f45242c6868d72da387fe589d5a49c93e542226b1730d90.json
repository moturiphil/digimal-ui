{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { RecordFormWrapper } from \"./style\";\nimport { Main, BasicFormWrapper } from \"../../styled\";\nimport { useStore } from \"vuex\";\nimport { reactive, ref, defineComponent, computed, onMounted } from \"vue\";\n// import { notification } from \"ant-design-vue\";\nimport { useRouter } from \"vue-router\";\nimport axios from \"axios\";\nimport authHeader from \"../../../services/auth-header\";\n// import { Modal } from \"ant-design-vue\";\n\nconst dateFormat = \"YYYY-MM-DD\";\nconst AddNew = defineComponent({\n  name: \"AddNew\",\n  components: {\n    RecordFormWrapper,\n    Main,\n    BasicFormWrapper\n  },\n  computed: {\n    isOfficerSelectionDisabled() {\n      return this.formState.activity_facilitator.length >= this.formState.number_of_officers;\n    }\n  },\n  data() {\n    const {\n      state\n    } = useStore();\n    const isLoading = computed(() => state.crud.loading);\n    const apiUrl = computed(() => state.crud.url);\n    const isFileLoading = computed(() => state.crud.fileLoading);\n    const router = useRouter();\n    const join = ref(\"\");\n    const users = ref([]);\n    const {\n      counties,\n      campaigns,\n      sub_counties\n    } = reactive({\n      counties: [],\n      campaigns: [],\n      sub_counties: []\n    });\n\n    // const API_URL = `${process.env.VUE_APP_BASE_URL}/createActivity`;\n\n    const formState = reactive({\n      name: \"\",\n      county_id: \"\",\n      campaign_id: \"\",\n      start_date: \"\",\n      end_date: \"\",\n      payable_travel_days: \"\",\n      number_of_officers: \"\",\n      activity_facilitator: []\n    });\n\n    //counties\n    const getCounties = async () => {\n      const response = await fetch(`${process.env.VUE_APP_BASE_URL}/counties`, {\n        method: \"GET\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          ...authHeader()\n        }\n      });\n      const data = await response.json();\n      console.log(data);\n      this.counties = data;\n    };\n    const getSubCounties = async () => {\n      const response = await fetch(`${process.env.VUE_APP_BASE_URL}/sub_counties_list`, {\n        method: \"GET\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          ...authHeader()\n        }\n      });\n      const data = await response.json();\n      // console.log('check this out' + data);\n      console.log(data.data);\n      this.sub_counties = data.data;\n      this.loading = false;\n    };\n\n    //campaigns\n    const getCampaigns = async () => {\n      const response = await fetch(`${process.env.VUE_APP_BASE_URL}/campaign_all`, {\n        method: \"GET\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          ...authHeader()\n        }\n      });\n      const data = await response.json();\n      this.campaigns = data.data;\n    };\n\n    // const handleSelect = (values)\n    const handleSubmit = values => {\n      const data = {\n        name: values.name,\n        county_id: values.county_id,\n        campaign_id: values.campaign_id,\n        start_date: new Date(values.start_date.$d).toISOString().substr(0, 10),\n        number_of_officers: values.number_of_officers,\n        activity_facilitator: values.activity_facilitator\n      };\n      console.log({\n        data\n      });\n      const encodedData = encodeURIComponent(JSON.stringify(data));\n\n      // router.push({\n      //   path: `/activities/activity-confirm/${encodedData}`\n      // });\n\n      this.$router.push({\n        name: \"activity-confirm\",\n        //use name for router push\n        params: {\n          encodedData\n        }\n      });\n\n      // values = {\n      //   name: values.name,\n      //   county_id: values.county_id,\n      //   campaign_id: values.campaign_id,\n      //   start_date: new Date(values.start_date.$d).toISOString().substr(0, 10),\n      //   number_of_officers: values.number_of_officers,\n      //   activity_facilitator: values.activity_facilitator,\n      // };\n\n      // localStorage.setItem(\"activity\", JSON.stringify(values));\n\n      // console.log(localStorage.getItem(\"activity\"));\n\n      router.push(\"activity-confirm\");\n\n      // fetch(API_URL, {\n      //   method: \"POST\",\n      //   headers: {\n      //     \"Content-Type\": \"application/json\",\n      //     ...authHeader(),\n      //   },\n      //   body: JSON.stringify(values),\n      // })\n      //   .then((response) => response.json())\n      //   .then(({ success, data }) => {\n      //     if (success) {\n      //       router.push(\"activity-view\");\n      //       notification[\"success\"]({\n      //         message: \"Activity Created\",\n      //         description: `Activity Created successfully. Your activity code is ${data.activity_code}`,\n      //         duration: 5.5,\n      //       });\n      //     }\n      //   })\n      //   .catch((error) => {\n      //     console.error(\"Error:\", error);\n      //   });\n    };\n\n    onMounted(() => {\n      axios.get(`${process.env.VUE_APP_BASE_URL}/users`, {\n        headers: authHeader()\n      }).then(function ({\n        data\n      }) {\n        console.log({\n          data: data.data\n        });\n        users.value = data.data;\n      }).catch(function (error) {\n        console.log(error);\n      });\n      getCounties();\n      getSubCounties();\n      getCampaigns();\n    });\n    return {\n      isLoading,\n      apiUrl,\n      users,\n      isFileLoading,\n      counties,\n      sub_counties,\n      campaigns,\n      handleSubmit,\n      dateFormat,\n      formState,\n      join,\n      participants: []\n    };\n  },\n  beforeRouteEnter(to, from, next) {\n    if (!localStorage.getItem(\"user\")) {\n      next(\"/auth/login\");\n    } else {\n      next();\n    }\n  }\n});\nexport default AddNew;","map":{"version":3,"names":["RecordFormWrapper","Main","BasicFormWrapper","useStore","reactive","r