{"ast":null,"code":"import users from '@/demoData/usersGroupData.json';\nimport { defineComponent } from 'vue';\nconst UserCardGroup = defineComponent({\n  name: 'UserCardGroup',\n  setup() {\n    return {\n      users\n    };\n  }\n});\nexport default UserCardGroup;","map":{"version":3,"names":["users","defineComponent","UserCardGroup","name","setup"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/apps/users/overview/UserCardGroup.vue"],"sourcesContent":["<template>\r\n  <a-col v-for=\"{ title, company, img, icon, content, id } in users\" :key=\"id\" :xxl=\"8\" :xl=\"8\" :sm=\"12\" :xs=\"24\">\r\n    <sdUserCard>\r\n      <div class=\"card user-card theme-grid-3\">\r\n        <sdCards headless>\r\n          <div class=\"card__top\">\r\n            <div class=\"user-card__img\">\r\n              <img :src=\"require(`@/${icon}`)\" alt=\"\" />\r\n            </div>\r\n            <div class=\"user-card__info\">\r\n              <sdHeading class=\"card__name\" as=\"h6\">\r\n                <a class=\"name-text\" to=\"#\">\r\n                  {{ title }}\r\n                </a>\r\n                <p class=\"card__designation\">{{ company }}</p>\r\n              </sdHeading>\r\n              <sdDropdown>\r\n                <template #overlay>\r\n                  <a to=\"#\">View</a>\r\n                  <a to=\"#\">Edit</a>\r\n                  <a to=\"#\">Leave</a>\r\n                  <a to=\"#\">Delete</a>\r\n                </template>\r\n                <a class=\"action-more\" to=\"#\">\r\n                  <sdFeatherIcons type=\"more-horizontal\" />\r\n                </a>\r\n              </sdDropdown>\r\n            </div>\r\n          </div>\r\n          <div class=\"card__content\">\r\n            <p>{{ content }}</p>\r\n            <div class=\"image-group\">\r\n              <img v-for=\"(item, key) in img\" :key=\"key + 1\" :src=\"require(`@/${item}`)\" alt=\"\" />\r\n            </div>\r\n          </div>\r\n          <div class=\"card__info\">\r\n            <p class=\"info-line\">\r\n              <span>Current project</span>\r\n              <span>Project Completed</span>\r\n            </p>\r\n            <h2 class=\"info-line\">\r\n              <span>Plugin Development</span>\r\n              <span class=\"success\" :style=\"{ background: 'none !important' }\"> 45 </span>\r\n            </h2>\r\n            <div class=\"project-progress\">\r\n              <a-progress :percent=\"70\" :stroke-width=\"5\" status=\"active\" class=\"progress-dt progress-primary\" />\r\n              <div class=\"progress-percentage\">\r\n                <span>70%</span>\r\n              </div>\r\n            </div>\r\n            <p class=\"completed-count\">12 / 15 tasks completed</p>\r\n          </div>\r\n        </sdCards>\r\n      </div>\r\n    </sdUserCard>\r\n  </a-col>\r\n</template>\r\n<script>\r\nimport users from '@/demoData/usersGroupData.json';\r\nimport { defineComponent } from 'vue';\r\nconst UserCardGroup = defineComponent({\r\n  name: 'UserCardGroup',\r\n  setup() {\r\n    return {\r\n      users,\r\n    };\r\n  },\r\n});\r\n\r\nexport default UserCardGroup;\r\n</script>\r\n"],"mappings":"AA0DA,OAAOA,KAAI,MAAO,gCAAgC;AAClD,SAASC,eAAc,QAAS,KAAK;AACrC,MAAMC,aAAY,GAAID,eAAe,CAAC;EACpCE,IAAI,EAAE,eAAe;EACrBC,KAAKA,CAAA,EAAG;IACN,OAAO;MACLJ;IACF,CAAC;EACH;AACF,CAAC,CAAC;AAEF,eAAeE,aAAa"},"metadata":{},"sourceType":"module","externalDependencies":[]}