rch\" size=\"14\" />\n          </span>\n          <a-input\n            @change=\"onHandleSearch\"\n            v-model:value.trim=\"formState.searchItem\"\n            type=\"text\"\n            name=\"dataSource\"\n            placeholder=\"Search Here\"\n          />\n        </div>\n      </template>\n    </sdPageHeader>\n    <Main>\n      <a-row :gutter=\"15\">\n        <a-col class=\"w-100\" :md=\"24\">\n          <sdCards headless>\n            <div v-if=\"isLoading\" class=\"spin\">\n              <a-spin />\n            </div>\n\n            <div v-else>\n              <TableWrapper class=\"table-data-view table-responsive\">\n                <a-table\n                  :pagination=\"{ pageSize: 50, showSizeChanger: true }\"\n                  :dataSource=\"dataSource\"\n                  :columns=\"columns\"\n                >\n                  <template #events=\"{ record }\">\n                    <td>\n                      <div class=\"table-actions\">\n                        <sdButton\n                          size=\"small\"\n                          type=\"success\"\n                          :disabled=\"isStarting\"\n                          @click=\"startEvent(record.id)\"\n                          v-if=\"!record.status\"\n                        >\n                          <span >\n                            <sdFeatherIcons type=\"clock\" size=\"16\" />\n                            &nbsp;&nbsp; Start Event\n                          </span>\n                        </sdButton>\n                        <sdButton\n                          size=\"small\"\n                          type=\"success\"\n                          :disabled=\"isStarting\"\n                          v-else\n                        >\n                          <span v-if=\"!record.status\">\n                            <sdFeatherIcons type=\"clock\" size=\"16\" />\n                            &nbsp;&nbsp; Start Event\n                          </span>\n                          <span  class=\"badge badge-green\">\n                            &nbsp;&nbsp; Started\n                          </span>\n                        </sdButton>\n                        <sdButton\n                          @click=\"showSuccessModal(record.event_code)\"\n                          size=\"small\"\n                          type=\"success\"\n                        >\n                          <sdFeatherIcons type=\"user-plus\" size=\"17\" />\n                          &nbsp;&nbsp; Register\n                        </sdButton>\n                        <!-- <sdButton\n                          @click=\"startEvent(record.id)\"\n                          size=\"small\"\n                          type=\"success\"\n                        >\n                          <sdFeatherIcons type=\"clock\" size=\"17\" />\n                          &nbsp;&nbsp; Start Event\n                        </sdButton> -->\n                        <sdButton>\n                          <router-link\n                            :to=\"{\n                              path: `/event/view/${record.id}`,\n                              query: { id: record.event_code },\n                            }\"\n                            class=\"btn-icon\"\n                            type=\"info\"\n                            shape=\"circle\"\n                          >\n                            <sdFeatherIcons type=\"eye\" size=\"16\" />\n                            &nbsp;&nbsp; Confirmed Participants\n                          </router-link>\n                        </sdButton>\n                        <sdButton>\n                          <router-link\n                            :to=\"{\n                              path: `/event/pending-confirmation/${record.id}`,\n                              query: { id: record.event_code },\n                            }\"\n                            class=\"btn-icon\"\n                            type=\"info\"\n                            shape=\"circle\"\n                          >\n                            <sdFeatherIcons type=\"pause\" size=\"16\" />\n                            &nbsp;&nbsp; Pending Confirmation\n                          </router-link>\n                        </sdButton>\n\n                        <!-- <sdButton>\n                          <router-link\n                            :to=\"{\n                              path: `/event/view/${record.id}`,\n                              query: { id: record.event_code },\n                            }\"\n                            class=\"btn-icon\"\n                            type=\"info\"\n                            shape=\"circle\"\n                          >\n                            <sdFeatherIcons type=\"eye\" size=\"16\" />\n                            &nbsp;&nbsp; Pending Confirmation\n                          </router-link>\n                        </sdButton> -->\n                      </div>\n                    </td>\n                  </template>\n                </a-table>\n              </TableWrapper>\n            </div>\n          </sdCards>\n        </a-col>\n      </a-row>\n    </Main>\n  </RecordViewWrapper>\n</template>\n<script>\nimport axios from \"axios\";\nimport authHeader from \"../../../services/auth-header\";\nimport { RecordViewWrapper } from \"./style\";\nimport { Main, TableWrapper } from \"../../styled\";\nimport { useStore } from \"vuex\";\nimport { computed, onMounted, ref, reactive, defineComponent } from \"vue\";\nimport { useRouter } from \"vue-router\";\nimport { Modal } from \"ant-design-vue\";\n// import axios from \"axios\";\n\nconst router = useRouter();\n\nconst columns = [\n  {\n    title: \"Event Name\",\n    dataIndex: \"name\",\n    key: \"id\",\n  },\n  {\n    title: \"Event Code\",\n    dataIndex: \"event_code\",\n    key: \"id\",\n  },\n  {\n    title: \"User\",\n    dataIndex: \"user_id\",\n    key: \"id\",\n  },\n  {\n    title: \"Campaign\",\n    dataIndex: \"campaign_id\",\n    key: \"id\",\n  },\n  {\n    title: \"Venue\",\n    dataIndex: \"venue\",\n    key: \"id\",\n  },\n  {\n    title: \"\",\n    dataIndex: \"\",\n    key: \"events\",\n    slots: { customRender: \"events\" },\n  },\n];\n\nconst ViewPage = defineComponent({\n  name: \"ViewPage\",\n  components: { RecordViewWrapper, Main, TableWrapper },\n  props: {\n    event: {\n      type: Object,\n      required: true,\n    },\n  },\n  data() {\n    return {\n      visible: false,\n      confirmLoading: false,\n      modalType: \"success\",\n      colorVisible: false,\n      eventCode: \"\",\n      isStarting: false,\n      isStarted: false,\n      events: [], // an array of events fetched from the server\n      eventStatus: {}, // an object to keep track of the status of each event\n    };\n  },\n  methods: {\n    async created() {\n      // fetch events from the server and initialize eventStatus object\n      const response = await fetch(\n        `${process.env.VUE_APP_BASE_URL}/events/all`,\n        {\n          method: \"GET\",\n          headers: authHeader(),\n        }\n      );\n      const data = await response.json();\n      console.log(data);\n      this.events = data;\n      this.eventStatus = {};\n      for (const event of this.events) {\n        this.eventStatus[event.id] = event.status;\n      }\n    },\n    async startEvent(id) {\n      try {\n        this.isStarting = true;\n        const response = await fetch(\n          `${process.env.VUE_APP_BASE_URL}/event_start_trigger/${id}`,\n          {\n            method: \"GET\",\n            headers: authHeader(),\n          }\n        );\n        const data = await response.json();\n        console.log(data);\n        if (data.status === true) {\n          // this.$set(this.eventStatus, id, true); // update the eventStatus object for this event\n          // Vue.set(this.eventStatus, id, true); // update the eventStatus object for this event\n          this.eventStatus[id] = true;\n          // this.$router.go();\n          // console.log(this.eventStatus[1])\n          localStorage.setItem(\"eventStatus\", JSON.stringify(this.eventStatus));\n          // console.log(localStorage.getItem(\"eventStatus\"));\n        }\n        location.reload();\n      } catch (error) {\n        console.error(error);\n      } finally {\n        this.isStarting = false;\n      }\n    },\n    showModal() {\n      this.visible = true;\n    },\n    showSuccessModal(record) {\n      console.log(record);\n      Modal.success({\n        title: \"Event Registration\",\n        content: (\n          <div>\n            <p>Enter Registration Code to Register</p>\n            <Input\n              id=\"regCode\"\n              v-model={this.eventCode}\n              placeholder=\"Enter Registration code\"\n            />\n          </div>\n        ),\n        okText: \"Register\",\n        onOk: async () => {\n          try {\n            const userRegCode = document.getElementById(\"regCode\").value;\n            console.log(userRegCode);\n\n            const response = await axios.get(\n              `${process.env.VUE_APP_BASE_URL}/event/${record}/participant/${userRegCode}/assign`,\n              { headers: authHeader() }\n            );\n            // console.log(record);\n            // localStorage.setItem(\"eventCode\", record);\n            if (response.status !== 200) {\n              throw new Error(\"Failed to Register Participant to event\");\n            } else {\n              console.log(\"Participant Registered\");\n            }\n\n            // Show success message\n            Modal.success({\n              title: \"Success\",\n              content: \"You have been registered for the event\",\n            });\n          } catch (error) {\n            Modal.error({\n              title: \"Error\",\n              content: error.message,\n            });\n          }\n        },\n        style: {\n          float: \"center\",\n          display: \"grid\",\n          placeContent: \"center\",\n        },\n      });\n    },\n\n    handleOk() {\n      this.confirmLoading = true;\n      setTimeout(() => {\n        this.visible = false;\n        this.colorVisible = false;\n        this.confirmLoading = false;\n      }, 2000);\n    },\n    handleCancel() {\n      this.visible = false;\n      this.colorVisible = false;\n    },\n    changeType(type) {\n      this.modalType = type;\n    },\n    success() {\n      Modal.success({\n        title: \"This is a success message\",\n        // JSX support\n        content: (\n          <div>\n            <p>some messages...some messages...</p>\n          </div>\n        ),\n      });\n    },\n\n    error() {\n      Modal.error({\n        title: \"This is an error message\",\n        content: \"some messages...some messages...\",\n      });\n    },\n\n    warning() {\n      Modal.warning({\n        title: \"This is a warning message\",\n        content: \"some messages...some messages...\",\n      });\n    },\n  },\n  setup() {\n    const { state, dispatch } = useStore();\n    const crud = computed(() => state.crud.data);\n    const isLoading = computed(() => state.crud.loading);\n    const selectedRowKeys = ref([]);\n    const dataSource = ref([]);\n    const eventCode = ref(\"\");\n\n    const API_URL = `${process.env.VUE_APP_BASE_URL}/events/all`;\n\n    console.log(API_URL);\n\n    onMounted(() => {\n      axios\n        .get(API_URL, {\n          headers: authHeader(),\n        })\n        .then((response) => {\n          console.log(response.data.data);\n          dataSource.value = response.data.data;\n        })\n        .catch((error) => {\n          console.error(error);\n        });\n    });\n\n    async () => {\n      try {\n        // Validate the event code\n        const { data } = await axios.get(\n          `${API_URL}?event_code=${ eventCode.value }`\n        );\n        if (!data || data.length === 0) {\n          throw new Error(\"Invalid event code\");\n        }\n\n        // Navigate to the event registration page\n        const eventId = data[0].id;\n        router.push(`/event/register/${eventId}`);\n      } catch (error) {\n        console.error(error);\n        // Modal.error({\n        //   title: \"Registration failed\",\n        //   content: \"Invalid event code\",\n        // });\n      }\n    };\n\n    const handleDelete = (id) => {\n      const confirm = window.confirm(\"Are you sure delete this?\");\n      if (confirm) {\n        dispatch(\"axiosDataDelete\", {\n          id,\n          getData: () => {\n            dispatch(\"axiosCrudGetData\");\n          },\n        });\n      }\n      return false;\n    };\n\n    const formState = reactive({\n      searchItem: \"\",\n    });\n\n    const onSelectChange = (selectedRowKey) => {\n      selectedRowKeys.value = selectedRowKey;\n    };\n\n    const rowSelection = {\n      selectedRowKeys,\n      onChange: onSelectChange,\n    };\n\n    return {\n      crud,\n      isLoading,\n      selectedRowKeys,\n      handleDelete,\n      rowSelection,\n      onSelectChange,\n      dataSource,\n      columns,\n      formState,\n    };\n  },\n});\n\nexport default ViewPage;\n</script>\n\n<style>\n.badge-green {\n  background-color: #1EC997;\n  color: white;\n  padding: 4px;\n  border-radius: 3px;\n}\n</style>"],"mappings":";;;;AA8IA,OAAOA,KAAI,MAAO,OAAO;AACzB,OAAOC,UAAS,MAAO,+BAA+B;AACtD,SAASC,iBAAgB,QAAS,SAAS;AAC3C,SAASC,IAAI,EAAEC,YAAW,QAAS,cAAc;AACjD,SAASC,QAAO,QAAS,MAAM;AAC/B,SAASC,QAAQ,EAAEC,SAAS,EAAEC,GAAG,EAAEC,QAAQ,EAAEC,eAAc,QAAS,KAAK;AACzE,SAASC,SAAQ,QAAS,YAAY;AAEtC;;AAEA,MAAMC,MAAK,GAAID,SAAS,EAAE;AAE1B,MAAME,OAAM,GAAI,CACd;EACEC,KAAK,EAAE,YAAY;EACnBC,SAAS,EAAE,MAAM;EACjBC,GAAG,EAAE;AACP,CAAC,EACD;EACEF,KAAK,EAAE,YAAY;EACnBC,SAAS,EAAE,YAAY;EACvBC,GAAG,EAAE;AACP,CAAC,EACD;EACEF,KAAK,EAAE,MAAM;EACbC,SAAS,EAAE,SAAS;EACpBC,GAAG,EAAE;AACP,CAAC,EACD;EACEF,KAAK,EAAE,UAAU;EACjBC,SAAS,EAAE,aAAa;EACxBC,GAAG,EAAE;AACP,CAAC,EACD;EACEF,KAAK,EAAE,OAAO;EACdC,SAAS,EAAE,OAAO;EAClBC,GAAG,EAAE;AACP,