{"ast":null,"code":"import { FacebookOutlined, TwitterOutlined } from \"@ant-design/icons-vue\";\nimport { AuthWrapper } from \"./style\";\nimport { reactive, ref, defineComponent, computed } from \"vue\";\nimport { useStore } from \"vuex\";\nconst SignUp = defineComponent({\n  name: \"SignUp\",\n  components: {\n    FacebookOutlined,\n    TwitterOutlined,\n    AuthWrapper\n  },\n  setup() {\n    const values = ref(null);\n    const checked = ref(null);\n    const {\n      state\n    } = useStore();\n    const isLoading = computed(() => state.auth.loading);\n    const handleSubmit = value => {\n      values.value = value;\n    };\n    const onChange = check => {\n      checked.value = check;\n    };\n    const formState = reactive({\n      name: \"\",\n      username: \"\",\n      email: \"\",\n      password: \"\"\n    });\n    return {\n      onChange,\n      handleSubmit,\n      formState,\n      isLoading\n    };\n  }\n});\nexport default SignUp;","map":{"version":3,"names":["FacebookOutlined","TwitterOutlined","AuthWrapper","reactive","ref","defineComponent","computed","useStore","SignUp","name","components","setup","values","checked","state","isLoading","auth","loading","handleSubmit","value","onChange","check","formState","username","email","password"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/authentication/Signup.vue"],"sourcesContent":["<template>\r\n  <AuthWrapper>\r\n    <p class=\"auth-notice\">\r\n      Already have an account?\r\n      <router-link to=\"/auth/login\">Sign In</router-link>\r\n    </p>\r\n    <div class=\"auth-contents\">\r\n      <a-form\r\n        name=\"register\"\r\n        :model=\"formState\"\r\n        @finish=\"handleSubmit\"\r\n        layout=\"vertical\"\r\n      >\r\n        <sdHeading as=\"h3\">\r\n          Sign Up to <span class=\"color-secondary\">Admin</span>\r\n        </sdHeading>\r\n        <a-form-item label=\"Name\" name=\"name\">\r\n          <a-input v-model:value=\"formState.name\" placeholder=\"Full name\" />\r\n        </a-form-item>\r\n        <a-form-item name=\"username\" label=\"Username\">\r\n          <a-input v-model:value=\"formState.username\" placeholder=\"Username\" />\r\n        </a-form-item>\r\n        <a-form-item name=\"email\" label=\"Email Address\">\r\n          <a-input\r\n            type=\"email\"\r\n            v-model:value=\"formState.email\"\r\n            placeholder=\"name@example.com\"\r\n          />\r\n        </a-form-item>\r\n        <a-form-item label=\"Password\" name=\"password\">\r\n          <a-input\r\n            type=\"password\"\r\n            v-model:value=\"formState.password\"\r\n            placeholder=\"Password\"\r\n          />\r\n        </a-form-item>\r\n        <div class=\"auth-form-action\">\r\n          <a-checkbox @change=\"onChange\">\r\n            Creating an account means you’re okay with our Terms of Service and\r\n            Privacy Policy\r\n          </a-checkbox>\r\n        </div>\r\n        <a-form-item>\r\n          <sdButton\r\n            class=\"btn-create\"\r\n            htmlType=\"submit\"\r\n            type=\"primary\"\r\n            size=\"large\"\r\n          >\r\n            {{ isLoading ? \"Loading...\" : \"Create Account\" }}\r\n          </sdButton>\r\n        </a-form-item>\r\n        <p class=\"form-divider\">\r\n          <span>Or</span>\r\n        </p>\r\n        <ul class=\"social-login signin-social\">\r\n          <li>\r\n            <a class=\"google-signup\" href=\"#\">\r\n              <img :src=\"require('@/static/img/google.png')\" alt=\"\" />\r\n              <span>Sign up with Google</span>\r\n            </a>\r\n          </li>\r\n          <li>\r\n            <a class=\"facebook-sign\" href=\"#\">\r\n              <FacebookOutlined />\r\n            </a>\r\n          </li>\r\n          <li>\r\n            <a class=\"twitter-sign\" href=\"#\">\r\n              <TwitterOutlined />\r\n            </a>\r\n          </li>\r\n        </ul>\r\n      </a-form>\r\n    </div>\r\n  </AuthWrapper>\r\n</template>\r\n<script>\r\nimport { FacebookOutlined, TwitterOutlined } from \"@ant-design/icons-vue\";\r\nimport { AuthWrapper } from \"./style\";\r\nimport { reactive, ref, defineComponent, computed } from \"vue\";\r\nimport { useStore } from \"vuex\";\r\n\r\nconst SignUp = defineComponent({\r\n  name: \"SignUp\",\r\n  components: { FacebookOutlined, TwitterOutlined, AuthWrapper },\r\n  setup() {\r\n    const values = ref(null);\r\n    const checked = ref(null);\r\n    const { state } = useStore();\r\n    const isLoading = computed(() => state.auth.loading);\r\n    const handleSubmit = (value) => {\r\n      values.value = value;\r\n    };\r\n    const onChange = (check) => {\r\n      checked.value = check;\r\n    };\r\n    const formState = reactive({\r\n      name: \"\",\r\n      username: \"\",\r\n      email: \"\",\r\n      password: \"\",\r\n    });\r\n    return {\r\n      onChange,\r\n      handleSubmit,\r\n      formState,\r\n      isLoading,\r\n    };\r\n  },\r\n});\r\n\r\nexport default SignUp;\r\n</script>\r\n"],"mappings":"AA8EA,SAASA,gBAAgB,EAAEC,eAAc,QAAS,uBAAuB;AACzE,SAASC,WAAU,QAAS,SAAS;AACrC,SAASC,QAAQ,EAAEC,GAAG,EAAEC,eAAe,EAAEC,QAAO,QAAS,KAAK;AAC9D,SAASC,QAAO,QAAS,MAAM;AAE/B,MAAMC,MAAK,GAAIH,eAAe,CAAC;EAC7BI,IAAI,EAAE,QAAQ;EACdC,UAAU,EAAE;IAAEV,gBAAgB;IAAEC,eAAe;IAAEC;EAAY,CAAC;EAC9DS,KAAKA,CAAA,EAAG;IACN,MAAMC,MAAK,GAAIR,GAAG,CAAC,IAAI,CAAC;IACxB,MAAMS,OAAM,GAAIT,GAAG,CAAC,IAAI,CAAC;IACzB,MAAM;MAAEU;IAAM,IAAIP,QAAQ,EAAE;IAC5B,MAAMQ,SAAQ,GAAIT,QAAQ,CAAC,MAAMQ,KAAK,CAACE,IAAI,CAACC,OAAO,CAAC;IACpD,MAAMC,YAAW,GAAKC,KAAK,IAAK;MAC9BP,MAAM,CAACO,KAAI,GAAIA,KAAK;IACtB,CAAC;IACD,MAAMC,QAAO,GAAKC,KAAK,IAAK;MAC1BR,OAAO,CAACM,KAAI,GAAIE,KAAK;IACvB,CAAC;IACD,MAAMC,SAAQ,GAAInB,QAAQ,CAAC;MACzBM,IAAI,EAAE,EAAE;MACRc,QAAQ,EAAE,EAAE;MACZC,KAAK,EAAE,EAAE;MACTC,QAAQ,EAAE;IACZ,CAAC,CAAC;IACF,OAAO;MACLL,QAAQ;MACRF,YAAY;MACZI,SAAS;MACTP;IACF,CAAC;EACH;AACF,CAAC,CAAC;AAEF,eAAeP,MAAM"},"metadata":{},"sourceType":"module","externalDepen