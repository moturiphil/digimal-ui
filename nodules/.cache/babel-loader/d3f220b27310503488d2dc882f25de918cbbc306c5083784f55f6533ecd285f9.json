{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { FacebookOutlined, TwitterOutlined } from '@ant-design/icons-vue';\nimport { computed, reactive, ref, watchEffect } from 'vue';\nimport { useStore } from 'vuex';\nimport { AuthWrapper } from './style';\nimport { useRouter } from 'vue-router';\nconst SignIn = {\n  name: 'SignIn',\n  components: {\n    FacebookOutlined,\n    TwitterOutlined,\n    AuthWrapper\n  },\n  setup() {\n    const {\n      state,\n      dispatch\n    } = useStore();\n    const isLoading = computed(() => state.firebase.loading);\n    const uid = computed(() => state.firebase.uid);\n    const checked = ref(null);\n    const router = useRouter();\n    const handleSubmit = value => {\n      dispatch('firebaseAuthLogin', {\n        data: value\n      });\n    };\n    const handleFbLogin = () => {\n      router.push('/');\n      dispatch('login');\n    };\n    watchEffect(() => {\n      if (uid.value) {\n        handleFbLogin();\n      }\n    });\n    const onChange = checked => {\n      checked.value = checked;\n    };\n    const formState = reactive({\n      username: '',\n      password: ''\n    });\n    return {\n      isLoading,\n      checked,\n      handleSubmit,\n      onChange,\n      formState,\n      dispatch\n    };\n  }\n};\nexport default SignIn;","map":{"version":3,"names":["FacebookOutlined","TwitterOutlined","computed","reactive","ref","watchEffect","useStore","AuthWrapper","useRouter","SignIn","name","components","setup","state","dispatch","isLoading","firebase","loading","uid","checked","router","handleSubmit","value","data","handleFbLogin","push","onChange","formState","username","password"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/authentication/FbSignIn.vue"],"sourcesContent":["<template>\r\n  <AuthWrapper>\r\n    <p class=\"auth-notice\">\r\n      Don&rsquo;t have an account? <router-link to=\"/auth/fb-register\">Sign up now</router-link>\r\n    </p>\r\n    <div class=\"auth-contents\">\r\n      <a-form @finish=\"handleSubmit\" :model=\"formState\" layout=\"vertical\">\r\n        <sdHeading as=\"h3\"> Sign in to <span class=\"color-secondary\">Admin</span> </sdHeading>\r\n        <a-form-item name=\"username\" label=\"Username or Email Address\">\r\n          <a-input type=\"email\" v-model:value=\"formState.username\" />\r\n        </a-form-item>\r\n        <a-form-item name=\"password\" initialValue=\"123456\" label=\"Password\">\r\n          <a-input type=\"password\" v-model:value=\"formState.password\" placeholder=\"Password\" />\r\n        </a-form-item>\r\n        <div class=\"auth-form-action\">\r\n          <a-checkbox @change=\"onChange\">Keep me logged in</a-checkbox>\r\n          <router-link class=\"forgot-pass-link\" to=\"/auth/forgotPassword\">\r\n            Forgot password?\r\n          </router-link>\r\n        </div>\r\n        <a-form-item>\r\n          <sdButton class=\"btn-signin\" htmlType=\"submit\" type=\"primary\" size=\"large\">\r\n            {{ isLoading ? 'Loading...' : 'Sign In' }}\r\n          </sdButton>\r\n        </a-form-item>\r\n        <p class=\"form-divider\">\r\n          <span>Or</span>\r\n        </p>\r\n        <ul class=\"social-login\">\r\n          <li>\r\n            <a @click=\"() => dispatch('firebaseAuthLoginWithGoogle')\" class=\"google-signup\" href=\"#\">\r\n              <img :src=\"require('@/static/img/google.png')\" alt=\"\" />\r\n              <span>Sign in with Google</span>\r\n            </a>\r\n          </li>\r\n          <li>\r\n            <a @click=\"() => dispatch('firebaseAuthLoginWithFacebook')\" class=\"facebook-sign\" href=\"#\">\r\n              <FacebookOutlined />\r\n            </a>\r\n          </li>\r\n          <li>\r\n            <a class=\"twitter-sign\" href=\"#\">\r\n              <TwitterOutlined />\r\n            </a>\r\n          </li>\r\n        </ul>\r\n      </a-form>\r\n    </div>\r\n  </AuthWrapper>\r\n</template>\r\n<script>\r\nimport { FacebookOutlined, TwitterOutlined } from '@ant-design/icons-vue';\r\nimport { computed, reactive, ref, watchEffect } from 'vue';\r\nimport { useStore } from 'vuex';\r\nimport { AuthWrapper } from './style';\r\nimport { useRouter } from 'vue-router';\r\n\r\nconst SignIn = {\r\n  name: 'SignIn',\r\n  components: { FacebookOutlined, TwitterOutlined, AuthWrapper },\r\n  setup() {\r\n    const { state, dispatch } = useStore();\r\n    const isLoading = computed(() => state.firebase.loading);\r\n    const uid = computed(() => state.firebase.uid);\r\n    const checked = ref(null);\r\n    const router = useRouter();\r\n\r\n    const handleSubmit = value => {\r\n      dispatch('firebaseAuthLogin', { data: value });\r\n    };\r\n\r\n    const handleFbLogin = () => {\r\n      router.push('/');\r\n      dispatch('login');\r\n    };\r\n\r\n    watchEffect(() => {\r\n      if (uid.value) {\r\n        handleFbLogin();\r\n      }\r\n    });\r\n\r\n    const onChange = checked => {\r\n      checked.value = checked;\r\n    };\r\n\r\n    const formState = reactive({\r\n      username: '',\r\n      password: '',\r\n    });\r\n\r\n    return {\r\n      isLoading,\r\n      checked,\r\n      handleSubmit,\r\n      onChange,\r\n      formState,\r\n      dispatch,\r\n    };\r\n  },\r\n};\r\n\r\nexport default SignIn;\r\n</script>\r\n"],"mappings":";AAmDA,SAASA,gBAAgB,EAAEC,eAAc,QAAS,uBAAuB;AACzE,SAASC,QAAQ,EAAEC,QAAQ,EAAEC,GAAG,EAAEC,WAAU,QAAS,KAAK;AAC1D,SAASC,QAAO,QAAS,MAAM;AAC/B,SAASC,WAAU,QAAS,SAAS;AACrC,SAASC,SAAQ,QAAS,YAAY;AAEtC,MAAMC,MAAK,GAAI;EACbC,IAAI,EAAE,QAAQ;EACdC,UAAU,EAAE;IAAEX,gBAAgB;IAAEC,eAAe;IAAEM;EAAY,CAAC;EAC9DK,KAAKA,CAAA,EAAG;IACN,MAAM;MAAEC,KAAK;MAAEC;IAAS,IAAIR,QAAQ,EAAE;IACtC,MAAMS,SAAQ,GAAIb,QAAQ,CAAC,MAAMW,KAAK,CAACG,QAAQ,CAACC,OAAO,CAAC;IACxD,MAAMC,GAAE,GAAIhB,QAAQ,CAAC,MAAMW,KAAK,CAACG,QAAQ,CAACE,GAAG,CAAC;IAC9C,MAAMC,OAAM,GAAIf,GAAG,CAAC,IAAI,CAAC;IACzB,MAAMgB,MAAK,GAAIZ,SAAS,EAAE;IAE1B,MAAMa,YAAW,GAAIC,KAAI,IAAK;MAC5BR,QAAQ,CAAC,mBAAmB,EAAE;QAAES,IAAI,EAAED;MAAM,CAAC,CAAC;IAChD,