{"ast":null,"code":"import Chart from '../../../../components/utilities/chartjs';\nimport { ref, defineComponent } from 'vue';\nconst AccountGroup = defineComponent({\n  name: 'AccountGroup',\n  components: {\n    Chart\n  },\n  setup() {\n    const height = ref(window.innerWidth <= 575 ? 230 : 100);\n    return {\n      tooltips: {\n        mode: 'label',\n        intersect: false,\n        backgroundColor: '#ffffff',\n        position: 'average',\n        titleFontColor: '#5A5F7D',\n        titleFontSize: 13,\n        titleSpacing: 15,\n        bodyFontColor: '#868EAE',\n        bodyFontSize: 12,\n        borderColor: '#F1F2F6',\n        borderWidth: 2,\n        bodySpacing: 15,\n        xPadding: 15,\n        yPadding: 15,\n        z: 999999,\n        custom(tooltip) {\n          if (!tooltip) return;\n          tooltip.displayColors = false;\n        },\n        callbacks: {\n          title() {\n            return `Account Receivable`;\n          },\n          label(t) {\n            const {\n              yLabel,\n              xLabel\n            } = t;\n            return `${xLabel}: $${yLabel}k`;\n          },\n          labelColor() {\n            return {\n              backgroundColor: '#000',\n              borderColor: 'transparent'\n            };\n          }\n        }\n      },\n      height\n    };\n  }\n});\nexport default AccountGroup;","map":{"version":3,"names":["Chart","ref","defineComponent","AccountGroup","name","components","setup","height","window","innerWidth","tooltips","mode","intersect","backgroundColor","position","titleFontColor","titleFontSize","titleSpacing","bodyFontColor","bodyFontSize","borderColor","borderWidth","bodySpacing","xPadding","yPadding","z","custom","tooltip","displayColors","callbacks","title","label","t","yLabel","xLabel","labelColor"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/dashboard/overview/business/AccountGroup.vue"],"sourcesContent":["<template>\r\n  <a-col :lg=\"12\" :md=\"12\" :sm=\"24