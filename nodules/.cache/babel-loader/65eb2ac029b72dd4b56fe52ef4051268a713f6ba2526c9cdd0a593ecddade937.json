,"md","_component_sdCards","headless","isLoading","_createElementBlock","_hoisted_3","_component_a_spin","_hoisted_4","_component_TableWrapper","_component_a_table","rowSelection","pagination","pageSize","showSizeChanger","dataSource","columns","events","_hoisted_5","record","id","shape","onClick","showSuccessModal"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/pages/events/getEvent.vue"],"sourcesContent":["<template>\n    <RecordViewWrapper>\n      <sdPageHeader title=\"MassNet Events\">\n        <template #subTitle>\n          <sdButton class=\"btn-add_new\" size=\"default\" type=\"success\">\n            <router-link to=\"/events/event-create\">\n              <sdFeatherIcons type=\"plus\" size=\"14\" /> Event Info</router-link\n            >\n          </sdButton>\n        </template>\n        <template #buttons>\n          <div class=\"search-box\">\n            <span class=\"search-icon\">\n              <sdFeatherIcons type=\"search\" size=\"14\" />\n            </span>\n            <a-input\n              @change=\"onHandleSearch\"\n              v-model:value.trim=\"formState.searchItem\"\n              type=\"text\"\n              name=\"dataSource\"\n              placeholder=\"Search Here\"\n            /></div\n        ></template>\n      </sdPageHeader>\n      <Main>\n        <a-row :gutter=\"15\">\n          <a-col class=\"w-100\" :md=\"24\">\n            <sdCards headless>\n              <div v-if=\"isLoading\" class=\"spin\">\n                <a-spin />\n              </div>\n  \n              <div v-else>\n                <TableWrapper class=\"table-data-view table-responsive\">\n                  <a-table\n                    :rowSelection=\"rowSelection\"\n                    :pagination=\"{ pageSize: 10, showSizeChanger: true }\"\n                    :dataSource=\"dataSource\"\n                    :columns=\"columns\"\n                  >\n                    <template #events=\"{}\">\n                      <td>\n                        <div class=\"table-actions\">\n                          <sdButton\n                          >\n                            <router-link\n                              :to=\"`/event/show/${record.id}`\"\n                              class=\"btn-icon\"\n                              type=\"info\"\n                              shape=\"circle\"\n                            >\n                              <sdFeatherIcons type=\"eye\" size=\"16\" />\n                              &nbsp;&nbsp; View\n                            </router-link>\n                            <!-- <sdFeatherIcons type=\"edit\" size=\"16\" /> -->\n                            <!-- &nbsp;&nbsp; View -->\n                          </sdButton>\n                          <sdButton\n                            @click=\"showSuccessModal\"\n                            size=\"small\"\n                            type=\"success\"\n                          >\n                            <sdFeatherIcons type=\"user-plus\" size=\"17\" />\n                            &nbsp;&nbsp; Register\n                          </sdButton>\n                        </div>\n                      </td>\n                    </template>\n                  </a-table>\n                </TableWrapper>\n              </div>\n            </sdCards>\n          </a-col>\n        </a-row>\n      </Main>\n    </RecordViewWrapper>\n  </template>\n  <script>\n  import axios from \"axios\";\n  import authHeader from \"../../../services/auth-header\";\n  import { RecordViewWrapper } from \"./style\";\n  import { Main, TableWrapper } from \"../../styled\";\n  import { useStore } from \"vuex\";\n  import { computed, onMounted, ref, reactive, defineComponent } from \"vue\";\n  import { useRouter } from \"vue-router\";\n  import { Modal } from \"ant-design-vue\";\n  \n  const router = useRouter();\n  \n  const columns = [\n    {\n      title: \"Participant Name\",\n      dataIndex: \"name\",\n      key: \"id\",\n    },\n    {\n      title: \"Participant Phone\",\n      dataIndex: \"event_code\",\n      key: \"id\",\n    },\n    {\n      title: \"Organization\",\n      dataIndex: \"user_id\",\n      key: \"id\",\n    },\n    {\n      title: \"Role\",\n      dataIndex: \"campaign_id\",\n      key: \"id\",\n    },\n    {\n      title: \"\",\n      dataIndex: \"\",\n      key: \"events\",\n      slots: { customRender: \"events\" },\n    },\n  ];\n  \n  const ViewPage = defineComponent({\n    name: \"ViewPage\",\n    components: { RecordViewWrapper, Main, TableWrapper },\n    data() {\n      return {\n        visible: false,\n        confirmLoading: false,\n        modalType: \"primary\",\n        colorVisible: false,\n      };\n    },\n    methods: {\n      showModal() {\n        this.visible = true;\n      },\n      showSuccessModal() {\n        Modal.success({\n          title: \"Event Registration\",\n          content: (\n            <div>\n              <p>Enter Registration Code to Register</p>\n              <Input v-model={this.eventCode} placeholder=\"Enter Registration code\" />\n            </div>\n          ),\n          okText: \"Register\",\n          onOk: async () => {\n            try {\n              // Validate the event code\n              const { data } = await axios.get(\n                `${process.env.VUE_APP_BASE_URL}/events/all?event_code=${this.eventCode}`,\n                { headers: authHeader() }\n              );\n              console.log(data);\n              if (!data || data.length === 0) {\n                throw new Error(\"Invalid event code\");\n              }\n  \n              // Navigate to the event registration page\n              // const participantId = 2; // Change this to the participant's ID\n              // get the event registration code when user clicks to register pae\n  \n              const eventReg = '';\n              const response = await axios.post(\n                `${process.env.VUE_APP_BASE_URL}/event/${data[0].id}/participant/${eventReg}/assign`,\n                { headers: authHeader() }\n              );\n              if (response.status !== 200) {\n                throw new Error(\"Failed to Register Participant to event\");\n              }\n              else {\n                console.log('Participant Registered');\n              }\n  \n              // Show success message\n              Modal.success({\n                title: \"Success\",\n                content: \"You have been registered for the event\",\n              });\n            } catch (error) {\n              Modal.error({\n                title: \"Error\",\n                content: error.message,\n              });\n            }\n          },\n          style: {\n            float: \"center\",\n            display: \"grid\",\n            placeContent: \"center\",\n          },\n        });\n      },\n  \n      handleOk() {\n        this.confirmLoading = true;\n        setTimeout(() => {\n          this.visible = false;\n          this.colorVisible = false;\n          this.confirmLoading = false;\n        }, 2000);\n      },\n      handleCancel() {\n        this.visible = false;\n        this.colorVisible = false;\n      },\n      changeType(type) {\n        this.modalType = type;\n      },\n      // info() {\n      //   //const h = this.$createElement;\n      //   Modal.info({\n      //     title: 'This is a notification message',\n      //     content: h('div', {}, [h('p', 'some messages...some messages...'), h('p', 'some messages...some messages...')]),\n      //     onOk() {\n      //       console.log('ok');\n      //     },\n      //   });\n      // },\n      success() {\n        Modal.success({\n          title: \"This is a success message\",\n          // JSX support\n          content: (\n            <div>\n              <p>some messages...some messages...</p>\n              <p>some messages...some messages...</p>\n            </div>\n          ),\n        });\n      },\n  \n      error() {\n        Modal.error({\n          title: \"This is an error message\",\n          content: \"some messages...some messages...\",\n        });\n      },\n  \n      warning() {\n        Modal.warning({\n          title: \"This is a warning message\",\n          content: \"some messages...some messages...\",\n        });\n      },\n    },\n    setup() {\n      const { state, dispatch } = useStore();\n      const crud = computed(() => state.crud.data);\n      const isLoading = computed(() => state.crud.loading);\n      const selectedRowKeys = ref([]);\n      const dataSource = ref([]);\n      const eventCode = ref(\"\");\n  \n      const API_URL = `${process.env.VUE_APP_BASE_URL}/events/all`;\n  \n      onMounted(() => {\n        axios\n          .get(API_URL, {\n            headers: authHeader(),\n          })\n          .then((response) => {\n            console.log(response.data.data);\n            dataSource.value = response.data.data;\n          })\n          .catch((error) => {\n            console.error(error);\n          });\n      });\n  \n      async () => {\n        try {\n          // Validate the event code\n          const { data } = await axios.get(\n            `${API_URL}?event_code=${eventCode.value}`\n          );\n          if (!data || data.length === 0) {\n            throw new Error(\"Invalid event code\");\n          }\n  \n          // Navigate to the event registration page\n          const eventId = data[0].id;\n          router.push(`/event/register/${eventId}`);\n        } catch (error) {\n          console.error(error);\n          // Modal.error({\n          //   title: \"Registration failed\",\n          //   content: \"Invalid event code\",\n          // });\n        }\n      };\n  \n      const handleDelete = (id) => {\n        const confirm = window.confirm(\"Are you sure delete this?\");\n        if (confirm) {\n          dispatch(\"axiosDataDelete\", {\n            id,\n            getData: () => {\n              dispatch(\"axiosCrudGetData\");\n            },\n          });\n        }\n        return false;\n      };\n  \n      const formState = reactive({\n        searchItem: \"\",\n      });\n  \n      const onSelectChange = (selectedRowKey) => {\n        selectedRowKeys.value = selectedRowKey;\n      };\n  \n      const rowSelection = {\n        selectedRowKeys,\n        onChange: onSelectChange,\n      };\n  \n      return {\n        crud,\n        isLoading,\n        selectedRowKeys,\n        handleDelete,\n        rowSelection,\n        onSelectChange,\n        dataSource,\n        columns,\n        formState,\n      };\n    },\n  });\n  \n  export default ViewPage;\n  </script>\n  "],"mappings":";;EAWeA,KAAK,EAAC;AAAY;;EACfA,KAAK,EAAC;AAAa;;;EAgBDA,KAAK,EAAC;;;;;;EAcbA,KAAK,EAAC;AAAe;;;;;;;;;;;;;;;uBAzC9CC,YAAA,CA0EoBC,4BAAA;sBAzElB,MAqBe,CArBfC,YAAA,CAqBeC,uBAAA;MArBDC,KAAK,EAAC;IAAgB;MACvBC,QAAQ,EAAAC,QAAA,CACjB,MAIW,CAJXJ,YAAA,CAIWK,mBAAA;QAJDR,KAAK,EAAC,aAAa;QAACS,IAAI,EAAC,SAAS;QAACC,IAAI,EAAC;;0BAChD,MAEC,CAFDP,YAAA,CAECQ,sBAAA;UAFYC,EAAE,EAAC;QAAsB;4BACpC,MAAwC,CAAxCT,YAAA,CAAwCU,yBAAA;YAAxBH,IAAI,EAAC,MAAM;YAACD,IAAI,EAAC;+BAAO,aAAW,E;;;;;MAI9CK,OAAO,EAAAP,QAAA,CAChB,MAWD,CAXCQ,mBAAA,CAWD,OAXCC,UAWD,GAVGD,mBAAA,CAEO,QAFPE,UAEO,GADLd,YAAA,CAA0CU,yBAAA;QAA1BH,IAAI,EAAC,QAAQ;QAACD,IAAI,EAAC;YAErCN,YAAA,CAMEe,kBAAA;QALCC,QAAM,EAAEC,IAAA,CAAAC,cAAc;QACfC,KAAK,EAAOF,IAAA,CAAAG,SAAS,CAACC,UAAU;8DAApBJ,IAAA,CAAAG,SAAS,CAACC,UAAU,GAAAC,MAAA;wBAAxC;UAAAC,IAAA;QAAA,CAAyC;QACzChB,IAAI,EAAC,MAAM;QACXiB,IAAI,EAAC,YAAY;QACjBC,WAAW,EAAC;;;QAIpBzB,YAAA,CAkDO0B,eAAA;wBAjDL,MAgDQ,CAhDR1B,YAAA,CAgDQ2B,gBAAA;QAhDAC,MAAM,EAAE;MAAE;0BAChB,MA8CQ,CA9CR5B,YAAA,CA8CQ6B,gBAAA;UA9CDhC,KAAK,EAAC,OAAO;UAAEiC,EAAE,EAAE;;4BACxB,MA4CU,CA5CV9B,YAAA,CA4CU+B,kBAAA;YA5CDC,QAAQ,EAAR;UAAQ;8BACf,MAEM,CAFKf,IAAA,CAAAgB,SAAS,I,cAApBC,mBAAA,CAEM,OAFNC,UAEM,GADJnC,YAAA,CAAUoC,iBAAA,E,oBAGZF,mBAAA,CAsCM,OAAAG,UAAA,GArCJrC,YAAA,CAoCesC,uBAAA;cApCDzC,KAAK,EAAC;YAAkC;gCACpD,MAkCU,CAlCVG,YAAA,CAkCUuC,kBAAA;gBAjCPC,YAAY,EAAEvB,IAAA,CAAAuB,YAAY;gBAC1B