{"ast":null,"code":"import { Main } from '../styled';\nimport Tag from '../../components/tags/Tag';\nimport { defineComponent } from 'vue';\nexport default defineComponent({\n  name: 'Tags',\n  components: {\n    Main,\n    Tag\n  },\n  setup() {\n    const colors = ['magenta', 'red', 'volcano', 'orange', 'gold', 'lime', 'green', 'cyan', 'blue', 'geekblue', 'purple'];\n    const customColors = ['#f50', '#2db7f5', '#87d068', '#108ee9', '#3b5999', '#5c0959'];\n    return {\n      colors,\n      customColors\n    };\n  }\n});","map":{"version":3,"names":["Main","Tag","defineComponent","name","components","setup","colors","customColors"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/uiElements/Tags.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <sdPageHeader title=\"Tags\">\r\n      <template v-slot:buttons>\r\n        <div class=\"page-header-actions\">\r\n          <sdCalendarButton />\r\n          <sdExportButton />\r\n          <sdShareButton />\r\n          <sdButton size=\"small\" type=\"primary\">\r\n            <sdFeatherIcons type=\"plus\" size=\"14\" />\r\n            Add New\r\n          </sdButton>\r\n        </div>\r\n      </template>\r\n    </sdPageHeader>\r\n    <Main>\r\n      <a-row :gutter=\"25\">\r\n        <a-col :md=\"12\" :sm=\"24\" :xs=\"24\">\r\n          <sdCards title=\"Basic\">\r\n            <div class=\"taglist-wrap\">\r\n              <Tag>Tag 1</Tag>\r\n              <Tag><a href=\"https://github.com/vueComponent/ant-design\">Link</a></Tag>\r\n              <Tag tagType=\"closable\">Tag 2</Tag>\r\n              <a-tag closable @close.prevent>Prevent Default</a-tag>\r\n            </div>\r\n          </sdCards>\r\n          <sdCards title=\"Hot Tag\">\r\n            <Tag tagType=\"hottags\" :data=\"['Movies', 'Books', 'Music', 'Sports']\" />\r\n          </sdCards>\r\n        </a-col>\r\n        <a-col :md=\"12\" :sm=\"24\" :xs=\"24\">\r\n          <sdCards title=\"Colorful Tag\">\r\n            <h4 style=\"margin-bottom: 16px\">Presets:</h4>\r\n            <div class=\"taglist-wrap\">\r\n              <Tag v-for=\"color in colors\" :key=\"color\" tagType=\"colorful\" :color=\"color\" />\r\n            </div>\r\n            <h4 :style=\"{ margin: '16px 0' }\">Custom:</h4>\r\n            <div class=\"taglist-wrap\">\r\n              <Tag v-for=\"color in customColors\" :key=\"color\" tagType=\"colorful\" :color=\"color\" />\r\n            </div>\r\n          </sdCards>\r\n          <sdCards title=\"Animated Tag\">\r\n            <div class=\"taglist-wrap\"><Tag tagType=\"dynamicTag\" :data=\"['Movies', 'Books', 'Music', 'Sports']\" /></div\r\n          ></sdCards>\r\n        </a-col>\r\n      </a-row>\r\n    </Main>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { Main } from '../styled';\r\nimport Tag from '../../components/tags/Tag';\r\nimport { defineComponent } from 'vue';\r\nexport default defineComponent({\r\n  name: 'Tags',\r\n  components: {\r\n    Main,\r\n    Tag,\r\n  },\r\n  setup() {\r\n    const colors = [\r\n      'magenta',\r\n      'red',\r\n      'volcano',\r\n      'orange',\r\n      'gold',\r\n      'lime',\r\n      'green',\r\n      'cyan',\r\n      'blue',\r\n      'geekblue',\r\n      'purple',\r\n    ];\r\n    const customColors = ['#f50', '#2db7f5', '#87d068', '#108ee9', '#3b5999', '#5c0959'];\r\n    return {\r\n      colors,\r\n      customColors,\r\n    };\r\n  },\r\n});\r\n</script>\r\n"],"mappings":"AAmDA,SAASA,IAAG,QAAS,WAAW;AAChC,OAAOC,GAAE,MAAO,2BAA2B;AAC3C,SAASC,eAAc,QAAS,KAAK;AACrC,eAAeA,eAAe,CAAC;EAC7BC,IAAI,EAAE,MAAM;EACZC,UAAU,EAAE;IACVJ,IAAI;IACJC;EACF,CAAC;EACDI,KAAKA,CAAA,EAAG;IACN,MAAMC,MAAK,GAAI,CACb,SAAS,EACT,KAAK,EACL,SAAS,EACT,QAAQ,EACR,MAAM,EACN,MAAM,EACN,OAAO,EACP,MAAM,EACN,MAAM,EACN,UAAU,EACV,QAAQ,CACT;IACD,MAAMC,YAAW,GAAI,CAAC,MAAM,EAAE,SAAS,EAAE,SAAS,EAAE,SAAS,EAAE,SAAS,EAAE,SAAS,CAAC;IACpF,OAAO;MACLD,MAAM;MACNC;IACF,CAAC;EACH;AACF,CAAC,CAAC"},"metadata":{},"sourceType":"module","externalDependencies":[]}