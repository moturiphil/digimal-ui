{"ast":null,"code":"import { Main, AutoCompleteWrapper } from '../styled';\nimport { ref, defineComponent } from 'vue';\nexport default defineComponent({\n  name: 'AutoComplete',\n  components: {\n    Main,\n    AutoCompleteWrapper\n  },\n  setup() {\n    const searchData = ref([{\n      id: 1,\n      title: 'AntDesign',\n      count: 10000\n    }, {\n      id: 2,\n      title: 'Design UI',\n      count: 10600\n    }, {\n      id: 3,\n      title: 'Bootstrap Design UI',\n      count: 60100\n    }, {\n      id: 4,\n      title: 'Meterial design',\n      count: 30010\n    }, {\n      id: 5,\n      title: 'AntDesign design language',\n      count: 100000\n    }]);\n    const onSearch = searchText => {\n      console.log(searchText);\n    };\n    const patternSearch = searchText => {\n      const data = searchData.value.filter(item => item.title.toUpperCase().startsWith(searchText.toUpperCase()));\n      console.log(data);\n    };\n    return {\n      searchData,\n      onSearch,\n      patternSearch\n    };\n  }\n});","map":{"version":3,"names":["Main","AutoCompleteWrapper","ref","defineComponent","name","components","setup","searchData","id","title","count","onSearch","searchText","console","log","patternSearch","data","value","filter","item","toUpperCase","startsWith"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/uiElements/AutoComplete.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <sdPageHeader title=\"Auto Complete\">\r\n      <template v-slot:buttons>\r\n        <div class=\"page-header-actions\">\r\n          <sdCalendarButton />\r\n          <sdExportButton />\r\n          <sdShareButton />\r\n          <sdButton size=\"small\" type=\"primary\">\r\n            <sdFeatherIcons type=\"plus\" size=\"14\" />\r\n            Add New\r\n          </sdButton>\r\n        </div>\r\n      </template>\r\n    </sdPageHeader>\r\n    <Main>\r\n      <AutoCompleteWrapper>\r\n        <a-row :gutter=\"25\">\r\n          <a-col :md=\"12\" :sm=\"24\" :xs=\"24\">\r\n            <sdCards title=\"Basic Usage\">\r\n              <div class=\"auto-complete-input\">\r\n                <sdAutoComplete :dataSource=\"searchData\" @onSearch=\"onSearch\" />\r\n                <sdAutoComplete :dataSource=\"searchData\" @onSearch=\"onSearch\" />\r\n              </div>\r\n            </sdCards>\r\n            <sdCards title=\"Customize Input Component\">\r\n              <div class=\"auto-complete-input\">\r\n                <sdAutoComplete customComponent :dataSource=\"searchData\" @onSearch=\"onSearch\">\r\n                  <a-textarea placeholder=\"input here\" class=\"custom\" :style=\"{ height: 50 }\" />\r\n                </sdAutoComplete>\r\n              </div>\r\n            </sdCards>\r\n            <sdCards title=\"Lookup-Patterns - Certain Category\">\r\n              <sdAutoComplete @onSearch=\"patternSearch\" :dataSource=\"searchData\" width=\"100%\" patterns />\r\n            </sdCards>\r\n          </a-col>\r\n          <a-col :md=\"12\" :sm=\"24\" :xs=\"24\">\r\n            <div class=\"auto-complete-input\">\r\n              <sdCards title=\"Customize\">\r\n                <sdAutoComplete :dataSource=\"searchData\" @onSearch=\"onSearch\" />\r\n              </sdCards>\r\n            </div>\r\n\r\n            <sdCards title=\"Lookup-Patterns - Uncertain Category\">\r\n              <div class=\"autocomplete-with-btn\">\r\n                <sdAutoComplete\r\n                  :dataSource=\"searchData\"\r\n                  @onSearch=\"patternSearch\"\r\n                  width=\"100%\"\r\n                  patterns\r\n                  patternButtons\r\n                />\r\n              </div>\r\n            </sdCards>\r\n          </a-col>\r\n        </a-row>\r\n      </AutoCompleteWrapper>\r\n    </Main>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { Main, AutoCompleteWrapper } from '../styled';\r\nimport { ref, defineComponent } from 'vue';\r\n\r\nexport default defineComponent({\r\n  name: 'AutoComplete',\r\n  components: {\r\n    Main,\r\n    AutoCompleteWrapper,\r\n  },\r\n  setup() {\r\n    const searchData = ref([\r\n      {\r\n        id: 1,\r\n        title: 'AntDesign',\r\n        count: 10000,\r\n      },\r\n      {\r\n        id: 2,\r\n        title: 'Design UI',\r\n        count: 10600,\r\n      },\r\n\r\n      {\r\n        id: 3,\r\n        title: 'Bootstrap Design UI',\r\n        count: 60100,\r\n      },\r\n      {\r\n        id: 4,\r\n        title: 'Meterial design',\r\n        count: 30010,\r\n      },\r\n\r\n      {\r\n        id: 5,\r\n        title: 'AntDesign design language',\r\n        count: 100000,\r\n      },\r\n    ]);\r\n    const onSearch = (searchText) => {\r\n      console.log(searchText);\r\n    };\r\n\r\n    const patternSearch = (searchText) => {\r\n      const data = searchData.value.filter((item) => item.title.toUpperCase().startsWith(searchText.toUpperCase()));\r\n      console.log(data);\r\n    };\r\n\r\n    return {\r\n      searchData,\r\n      onSearch,\r\n      patternSearch,\r\n    };\r\n  },\r\n});\r\n</script>"],"mappings":"AA8DA,SAASA,IAAI,EAAEC,mBAAkB,QAAS,WAAW;AACrD,SAASC,GAAG,EAAEC,eAAc,QAAS,KAAK;AAE1C,eAAeA,eAAe,CAAC;EAC7BC,IAAI,EAAE,cAAc;EACpBC,UAAU,EAAE;IACVL,IAAI;IACJC;EACF,CAAC;EACDK,KAAKA,CAAA,EAAG;IACN,MAAMC,UAAS,GAAIL,GAAG,CAAC,CACrB;MACEM,EAAE,EAAE,CAAC;MACLC,KAAK,EAAE,WAAW;MAClBC,KAAK,EAAE;IACT,CAAC,EACD;MACEF,EAAE,EAAE,CAAC;MACLC,KAAK,EAAE,WAAW;MAClBC,KAAK,EAAE;IACT,CAAC,EAED;MACEF,EAAE,EAAE,CAAC;MACLC,KAAK,EAAE,qBAAqB;MAC5BC,KAAK,EAAE;IACT,CAAC,EACD;MACEF,EAAE,EAAE,CAAC;MACLC,KAAK,EAAE,iBAAiB;MACxBC,KAAK,EAAE;IACT,CAAC,EAED;MACEF,EAAE,EAAE,CAAC;MACLC,KAAK,EAAE,2BAA2B;MAClCC,KAAK,EAAE;IACT,CAAC,CACF,CAAC;IACF,MAAMC,QAAO,GAAKC,UAAU,IAAK;MAC/BC,OAAO,CAACC,GAAG,CAACF,UAAU,CAAC;IACzB,CAAC;IAED,MAAMG,aAAY,GAAKH,UAAU,IAAK;MACpC,MAAMI,IAAG,GAAIT,UAAU,CAACU,KAAK,CAACC,MAAM,CAAEC,IAAI,IAAKA,IAAI,CAACV,KAAK,CAACW,WAAW,EAAE,CAACC,UAAU,CAACT,UAAU,CAACQ,WAAW,EAAE,CAAC,CAAC;MAC7GP,OAAO,CAACC,GAAG,CAACE,IAAI,CAAC;IACnB