{"ast":null,"code":"import \"ant-design-vue/es/message/style\";\nimport _message from \"ant-design-vue/es/message\";\nimport { ref, defineComponent } from 'vue';\nimport { PlusOutlined, LoadingOutlined } from '@ant-design/icons-vue';\nfunction getBase64(img, callback) {\n  const reader = new FileReader();\n  reader.addEventListener('load', () => callback(reader.result));\n  reader.readAsDataURL(img);\n}\nexport default defineComponent({\n  name: 'AvatarUpload',\n  components: {\n    LoadingOutlined,\n    PlusOutlined\n  },\n  setup() {\n    const fileList = ref([]);\n    const loading = ref(false);\n    const imageUrl = ref('');\n    const handleChange = info => {\n      if (info.file.status === 'uploading') {\n        loading.value = true;\n        return;\n      }\n      if (info.file.status === 'done') {\n        // Get this url from response in real world.\n        getBase64(info.file.originFileObj, base64Url => {\n          imageUrl.value = base64Url;\n          loading.value = false;\n        });\n      }\n      if (info.file.status === 'error') {\n        loading.value = false;\n        _message.error('upload error');\n      }\n    };\n    const beforeUpload = file => {\n      const isJpgOrPng = file.type === 'image/jpeg' || file.type === 'image/png';\n      if (!isJpgOrPng) {\n        _message.error('You can only upload JPG file!');\n      }\n      const isLt2M = file.size / 1024 / 1024 < 2;\n      if (!isLt2M) {\n        _message.error('Image must smaller than 2MB!');\n      }\n      return isJpgOrPng && isLt2M;\n    };\n    return {\n      fileList,\n      loading,\n      imageUrl,\n      handleChange,\n      beforeUpload\n    };\n  }\n});","map":{"version":3,"names":["ref","defineComponent","PlusOutlined","LoadingOutlined","getBase64","img","callback","reader","FileReader","addEventListener","result","readAsDataURL","name","components","setup","fileList","loading","imageUrl","handleChange","info","file","status","value","originFileObj","base64Url","_message","error","beforeUpload","isJpgOrPng","type","isLt2M","size"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/uiElements/upload/Avatar.vue"],"sourcesContent":["<template>\r\n  <a-upload\r\n    v-model:file-list=\"fileList\"\r\n    name=\"avatar\"\r\n    list-type=\"picture-card\"\r\n    class=\"avatar-uploader\"\r\n    :show-upload-list=\"false\"\r\n    action=\"https://www.mocky.io/v2/5cc8019d300000980a055e76\"\r\n    :before-upload=\"beforeUpload\"\r\n    @change=\"handleChange\"\r\n  >\r\n    <img v-if=\"imageUrl\" :src=\"imageUrl\" :style=\"{ width: '100%' }\" alt=\"avatar\" />\r\n    <div v-else>\r\n      <loading-outlined v-if=\"loading\"></loading-outlined>\r\n      <plus-outlined v-else></plus-outlined>\r\n      <div class=\"ant-upload-text\">Upload</div>\r\n    </div>\r\n  </a-upload>\r\n</template>\r\n\r\n<script>\r\nimport { ref, defineComponent } from 'vue';\r\nimport { message } from 'ant-design-vue';\r\nimport { PlusOutlined, LoadingOutlined } from '@ant-design/icons-vue';\r\nfunction getBase64(img, callback) {\r\n  const reader = new FileReader();\r\n  reader.addEventListener('load', () => callback(reader.result));\r\n  reader.readAsDataURL(img);\r\n}\r\nexport default defineComponent({\r\n  name: 'AvatarUpload',\r\n  components: {\r\n    LoadingOutlined,\r\n    PlusOutlined,\r\n  },\r\n  setup() {\r\n    const fileList = ref([]);\r\n    const loading = ref(false);\r\n    const imageUrl = ref('');\r\n\r\n    const handleChange = (info) => {\r\n      if (info.file.status === 'uploading') {\r\n        loading.value = true;\r\n        return;\r\n      }\r\n\r\n      if (info.file.status === 'done') {\r\n        // Get this url from response in real world.\r\n        getBase64(info.file.originFileObj, (base64Url) => {\r\n          imageUrl.value = base64Url;\r\n          loading.value = false;\r\n        });\r\n      }\r\n\r\n      if (info.file.status === 'error') {\r\n        loading.value = false;\r\n        message.error('upload error');\r\n      }\r\n    };\r\n\r\n    const beforeUpload = (file) => {\r\n      const isJpgOrPng = file.type === 'image/jpeg' || file.type === 'image/png';\r\n\r\n      if (!isJpgOrPng) {\r\n        message.error('You can only upload JPG file!');\r\n      }\r\n\r\n      const isLt2M = file.size / 1024 / 1024 < 2;\r\n\r\n      if (!isLt2M) {\r\n        message.error('Image must smaller than 2MB!');\r\n      }\r\n\r\n      return isJpgOrPng && isLt2M;\r\n    };\r\n\r\n    return {\r\n      fileList,\r\n      loading,\r\n      imageUrl,\r\n      handleChange,\r\n      beforeUpload,\r\n    };\r\n  },\r\n});\r\n</script>\r\n"],"mappings":";;AAqBA,SAASA,GAAG,EAAEC,eAAc,QAAS,KAAK;AAE1C,SAASC,YAAY,EAAEC,eAAc,QAAS,uBAAuB;AACrE,SAASC,SAASA,CAACC,GAAG,EAAEC,QAAQ,EAAE;EAChC,MAAMC,MAAK,GAAI,IAAIC,UAAU,EAAE;EAC/BD,MAAM,CAACE,gBAAgB,CAAC,MAAM,EAAE,MAAMH,QAAQ,CAACC,MAAM,CAACG,MAAM,CAAC,CAAC;EAC9DH,MAAM,CAACI,aAAa,CAACN,GAAG,CAAC;AAC3B;AACA,eAAeJ,eAAe,CAAC;EAC7BW,IAAI,EAAE,cAAc;EACpBC,UAAU,EAAE;IACVV,eAAe;IACfD;EACF,CAAC;EACDY,KAAKA,CAAA,EAAG;IACN,MAAMC,QAAO,GAAIf,GAAG,CAAC,EAAE,CAAC;IACxB,MAAMgB,OAAM,GAAIhB,GAAG,CAAC,KAAK,CAAC;IAC1B,MAAMiB,QAAO,GAAIjB,GAAG,CAAC,EAAE,CAAC;IAExB,MAAMkB,YAAW,GAAKC,IAAI,IAAK;MAC7B,IAAIA,IAAI,CAACC,IAAI,CAACC,MAAK,KAAM,WAAW,EAAE;QACpCL,OAAO,CAACM,KAAI,GAAI,IAAI;QACpB;MACF;MAEA,IAAIH,IAAI,CAACC,IAAI,CAACC,MAAK,KAAM,MAAM,EAAE;QAC/B;QACAjB,SAAS,CAACe,IAAI,CAACC,IAAI,CAACG,aAAa,EAAGC,SAAS,IAAK;UAChDP,QAAQ,CAACK,KAAI,GAAIE,SAAS;UAC1BR,OAAO,CAACM,KAAI,GAAI,KAAK;QACvB,CAAC,CAAC;MACJ;MAEA,IAAIH,IAAI,CAACC,IAAI,CAACC,MAAK,KAAM,OAAO,EAAE;QAChCL,OAAO,CAACM,KAAI,GAAI,KAAK;QACrBG,QAAA,CAAQC,KAAK,CAAC,cAAc,CAAC;MAC/B;IACF,CAAC;IAED,MAAMC,YAAW,GAAKP,IAAI,IAAK;MAC7B,MAAMQ,UAAS,GAAIR,IAAI,CAACS,IAAG,KAAM,YAAW,IAAKT,IAAI,CAACS,IAAG,KAAM,WAAW;MAE1E,IAAI,CAACD,UAAU,EAAE;QACfH,QAAA,CAAQC,KAAK,CAAC,+BAA+B,CAAC;MAChD;MAEA,MAAMI,MAAK,GAAIV,IAAI,CAACW,IAAG,GAAI,IAAG,GAAI,IAAG,GAAI,CAAC;MAE1C,IAAI,CAACD,MAAM,EAAE;QACXL,QAAA,CAAQC,KAAK,CAAC,8BAA8B,CAAC;MAC/C;MAEA,OAAOE,UAAS,IAAKE,MA