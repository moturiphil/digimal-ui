{"ast":null,"code":"import { onMounted, ref, computed, defineComponent } from 'vue';\nimport { useStore } from 'vuex';\nimport { SentEmailWrapper } from '../../style';\nimport Chartjs from '../../../../components/utilities/chartjs';\nconst labels = ['Total Sent', 'Opened', 'Not Opened'];\nconst icons = ['Sent', 'Opened', 'NotOpen'];\nconst types = ['success', 'primary', 'warning'];\nconst EmailSent = defineComponent({\n  name: 'EmailSent',\n  components: {\n    SentEmailWrapper,\n    Chartjs\n  },\n  setup() {\n    const {\n      state,\n      dispatch\n    } = useStore();\n    const deviceState = computed(() => state.chartContent.deviceData);\n    const dvIsLoading = computed(() => state.chartContent.dvLoading);\n    const device = ref('year');\n    const datasets = computed(() => [{\n      data: deviceState.value,\n      backgroundColor: ['#20C997', '#5F63F2', '#FA8B0C']\n    }]);\n    onMounted(() => {\n      dispatch('deviceGetData');\n      // return (datasets.value = [\n      //   {\n      //     data: deviceState.value,\n      //     backgroundColor: ['#20C997', '#5F63F2', '#FA8B0C'],\n      //   },\n      // ]);\n    });\n\n    const handleActiveChangeDevice = (event, value) => {\n      event.preventDefault();\n      device.value = value;\n      dispatch('deviceFilterData', value);\n    };\n    return {\n      deviceState,\n      dvIsLoading,\n      device,\n      handleActiveChangeDevice,\n      labels,\n      icons,\n      types,\n      datasets\n    };\n  }\n});\nexport default EmailSent;","map":{"version":3,"names":["onMounted","ref","computed","defineComponent","useStore","SentEmailWrapper","Chartjs","labels","icons","types","EmailSent","name","components","setup","state","dispatch","deviceState","chartContent","deviceData","dvIsLoading","dvLoading","device","datasets","data","value","backgroundColor","handleActiveChangeDevice","event","preventDefault"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/dashboard/overview/crm/EmailSent.vue"],"sourcesContent":["<template>\r\n  <SentEmailWrapper>\r\n    <sdCards v-if=\"deviceState\" title=\"Email Sent\">\r\n      <template #button>\r\n        <div class=\"card-nav\">\r\n          <ul>\r\n            <li :class=\"device === 'today' ? 'active' : 'deactivate'\">\r\n              <router-link @click=\"(e) => handleActiveChangeDevice(e, 'today')\" to=\"#\"> Today </router-link>\r\n            </li>\r\n            <li :class=\"device === 'week' ? 'active' : 'deactivate'\">\r\n              <router-link @click=\"(e) => handleActiveChangeDevice(e, 'week')\" to=\"#\"> Week </router-link>\r\n            </li>\r\n            <li :class=\"device === 'month' ? 'active' : 'deactivate'\">\r\n              <router-link @click=\"(e) => handleActiveChangeDevice(e, 'month')\" to=\"#\"> Month </router-link>\r\n            </li>\r\n            <li :class=\"device === 'year' ? 'active' : 'deactivate'\">\r\n              <router-link @click=\"(e) => handleActiveChangeDevice(e, 'year')\" to=\"#\"> Year </router-link>\r\n            </li>\r\n          </ul>\r\n        </div>\r\n      </template>\r\n\r\n      <div v-if=\"dvIsLoading\" class=\"sd-spin\">\r\n        <a-spin />\r\n      </div>\r\n\r\n      <div v-else class=\"sent-emial-chart\">\r\n        <Chartjs\r\n          :options=\"{\r\n            cutoutPercentage: 60,\r\n            maintainAspectRatio: false,\r\n            responsive: false,\r\n            legend: {\r\n              display: false,\r\n              position: 'bottom',\r\n            },\r\n            animation: {\r\n              animateScale: true,\r\n              animateRotate: true,\r\n            },\r\n          }\"\r\n          type=\"doughnut\"\r\n          class=\"sentMail\"\r\n          :labels=\"labels\"\r\n          :datasets=\"datasets\"\r\n          :height=\"180\"\r\n        />\r\n\r\n        <div class=\"sent-emial-data\">\r\n          <div v-for=\"(item, key) in datasets\" class=\"sent-emial-box align-center-v\" :key=\"key + 1\">\r\n            <div v-for=\"(value, index) in item.data\" class=\"sent-emial-item\" :key=\"value\">\r\n              <div :class=\"`sent-emial-icon icon-${types[index]}`\">\r\n                <img :src=\"require(`../../../../static/img/icon/${icons[index]}.svg`)\" alt=\"\" />\r\n              </div>\r\n              <div class=\"sent-emial-content\">\r\n                <h4>\r\n                  <strong>{{ value }}</strong>\r\n                </h4>\r\n                <p>{{ labels[index] }}</p>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </sdCards>\r\n  </SentEmailWrapper>\r\n</template>\r\n<script>\r\nimport { onMounted, ref, computed, defineComponent } from 'vue';\r\nimport { useStore } from 'vuex';\r\nimport { SentEmailWrapper } from '../../style';\r\nimport Chartjs from '../../../../components/utilities/chartjs';\r\n\r\nconst labels = ['Total Sent', 'Opened', 'Not Opened'];\r\nconst icons = ['Sent', 'Opened', 'NotOpen'];\r\nconst types = ['success', 'primary', 'warning'];\r\n\r\nconst EmailSent = defineComponent({\r\n  name: 'EmailSent',\r\n  components: { SentEmailWrapper, Chartjs },\r\n  setup() {\r\n    const { state, dispatch } = useStore();\r\n    const deviceState = computed(() => state.chartContent.deviceData);\r\n    const dvIsLoading = computed(() => state.chartContent.dvLoading);\r\n    const device = ref('year');\r\n\r\n    const datasets = computed(() => [\r\n      {\r\n        data: deviceState.value,\r\n        backgroundColor: ['#20C997', '#5F63F2', '#FA8B0C'],\r\n      },\r\n    ]);\r\n\r\n    onMounted(() => {\r\n      dispatch('deviceGetData');\r\n      // return (datasets.value = [\r\n      //   {\r\n      //     data: deviceState.value,\r\n      //     backgroundColor: ['#20C997', '#5F63F2', '#FA8B0C'],\r\n      //   },\r\n      // ]);\r\n    });\r\n\r\n    const handleActiveChangeDevice = (event, value) => {\r\n      event.preventDefault();\r\n      device.value = value;\r\n      dispatch('deviceFilterData', value);\r\n    };\r\n\r\n    return {\r\n      deviceState,\r\n      dvIsLoading,\r\n      device,\r\n      handleActiveChangeDevice,\r\n      labels,\r\n      icons,\r\n      types,\r\n      datasets,\r\n    };\r\n  },\r\n});\r\n\r\nexport default EmailSent;\r\n</script>\r\n"],"mappings":"AAoEA,SAASA,SAAS,EAAEC,GAAG,EAAEC,QAAQ,EAAEC,eAAc,QAAS,KAAK;AAC/D,SAASC,QAAO,QAAS,MAAM;AAC/B,SAASC,gBAAe,QAAS,aAAa;AAC9C,OAAOC,OAAM,MAAO,0CAA0C;AAE9D,MAAMC,MAAK,GAAI,CAAC,YAAY,EAAE,QAAQ,EAAE,YAAY,CAAC;AACrD,MAAMC,KAAI,GAAI,CAAC,MAAM,EAAE,QAAQ,EAAE,SAAS,CAAC;AAC3C,MAAMC,KAAI,GAAI,CAAC,SAAS,EAAE,SAAS,EAAE,SAAS,CAAC;AAE/C,MAAMC,SAAQ,GAAIP,eAAe,CAAC;EAChCQ,IAAI,EAAE,WAAW;EACjBC,UAAU,EAAE;IAAEP,gBAAgB;IAAEC;EAAQ,CAAC;EACzCO,KAAKA,CAAA,EAAG;IACN,MAAM;MAAEC,KAAK;MAAEC;IAAS,IAAIX,QAAQ,EAAE;IACtC,MAAMY,WAAU,GAAId,QAAQ,CAAC,MAAMY,KAAK,CAACG,YAAY,CAACC,UAAU,CAAC;IACjE,MAAMC,WAAU,GAAIjB,QAAQ,CAAC,MAAMY,KAAK,CAACG,YAAY,CAACG,SAAS,CAAC;IAChE,MAAMC,MAAK,GAAIpB,GAAG,CAAC,MAAM,CAAC;IAE1B,MAAMqB,QAAO,GAAIpB,QAAQ,CAAC,MAAM,CAC9B;MACEqB,IAAI,EAAEP,WAAW,CAACQ,KAAK;MACvBC,eAAe,EAAE,CAAC,SAAS,EAAE,SAAS,EAAE,SAAS;IACnD,CAAC,CACF,CAAC;IAEFzB,SAAS,CAAC,MAAM;MACde,QAAQ,CAAC,eAAe,CAAC;MACzB;MACA;MACA;MACA;MACA;MACA;IACF,CAAC,CAAC;;IAEF,MAAMW,wBAAuB,GAAIA,CAACC,KAAK,EAAEH,KAAK,KAAK;MACjDG,KAAK,CAACC,cAAc,EAAE;MACtBP,MAAM,CAACG,KAAI,GAAIA,KAAK;MACpBT,QAAQ,CAAC,kBAAkB,EAAES,KAAK,CAAC;IACrC,CAAC;IAED,OAAO;MACLR,WAAW;MACXG,WAAW;MACXE,MAAM;MACNK,wBAAwB;MACxBnB,MAAM;MACNC,KAAK;MACLC,KAAK;MACLa;IACF,CAAC;EACH;AACF,CAAC,CAAC;AAEF,eAAeZ,SAAS"},"metadata":{},"sourceType":"module","externalDependencies":[]}