{"ast":null,"code":"import { ref, defineComponent } from 'vue';\nimport { UploadOutlined } from '@ant-design/icons-vue';\nexport default defineComponent({\n  name: 'CompleteControlUpload',\n  components: {\n    UploadOutlined\n  },\n  setup() {\n    const fileList = ref([{\n      uid: '-1',\n      name: 'xxx.png',\n      status: 'done',\n      url: 'http://www.baidu.com/xxx.png'\n    }]);\n    const handleChange = info => {\n      let resFileList = [...info.fileList]; // 1. Limit the number of uploaded files\n      //    Only to show two recent uploaded files, and old ones will be replaced by the new\n\n      resFileList = resFileList.slice(-2); // 2. read from response and show file link\n\n      resFileList = resFileList.map(file => {\n        if (file.response) {\n          // Component will show file.url as link\n          file.url = file.response.url;\n        }\n        return file;\n      });\n      fileList.value = resFileList;\n    };\n    return {\n      fileList,\n      handleChange\n    };\n  }\n});","map":{"version":3,"names":["ref","defineComponent","UploadOutlined","name","components","setup","fileList","uid","status","url","handleChange","info","resFileList","slice","map","file","response","value"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/uiElements/upload/CompleteControl.vue"],"sourcesContent":["<template>\r\n  <a-upload\r\n    action=\"https://www.mocky.io/v2/5cc8019d300000980a055e76\"\r\n    :multiple=\"true\"\r\n    :file-list=\"fileList\"\r\n    @change=\"handleChange\"\r\n  >\r\n    <sdButton class=\"btn-outlined\" type=\"light\" size=\"large\" :outlined=\"true\">\r\n      <upload-outlined></upload-outlined>\r\n      <span>Upload</span>\r\n    </sdButton>\r\n  </a-upload>\r\n</template>\r\n\r\n<script>\r\nimport { ref, defineComponent } from 'vue';\r\nimport { UploadOutlined } from '@ant-design/icons-vue';\r\n\r\nexport default defineComponent({\r\n  name: 'CompleteControlUpload',\r\n  components: {\r\n    UploadOutlined,\r\n  },\r\n  setup() {\r\n    const fileList = ref([\r\n      {\r\n        uid: '-1',\r\n        name: 'xxx.png',\r\n        status: 'done',\r\n        url: 'http://www.baidu.com/xxx.png',\r\n      },\r\n    ]);\r\n\r\n    const handleChange = (info) => {\r\n      let resFileList = [...info.fileList]; // 1. Limit the number of uploaded files\r\n      //    Only to show two recent uploaded files, and old ones will be replaced by the new\r\n\r\n      resFileList = resFileList.slice(-2); // 2. read from response and show file link\r\n\r\n      resFileList = resFileList.map((file) => {\r\n        if (file.response) {\r\n          // Component will show file.url as link\r\n          file.url = file.response.url;\r\n        }\r\n\r\n        return file;\r\n      });\r\n      fileList.value = resFileList;\r\n    };\r\n\r\n    return {\r\n      fileList,\r\n      handleChange,\r\n    };\r\n  },\r\n});\r\n</script>\r\n"],"mappings":"AAeA,SAASA,GAAG,EAAEC,eAAc,QAAS,KAAK;AAC1C,SAASC,cAAa,QAAS,uBAAuB;AAEtD,eAAeD,eAAe,CAAC;EAC7BE,IAAI,EAAE,uBAAuB;EAC7BC,UAAU,EAAE;IACVF;EACF,CAAC;EACDG,KAAKA,CAAA,EAAG;IACN,MAAMC,QAAO,GAAIN,GAAG,CAAC,CACnB;MACEO,GAAG,EAAE,IAAI;MACTJ,IAAI,EAAE,SAAS;MACfK,MAAM,EAAE,MAAM;MACdC,GAAG,EAAE;IACP,CAAC,CACF,CAAC;IAEF,MAAMC,YAAW,GAAKC,IAAI,IAAK;MAC7B,IAAIC,WAAU,GAAI,CAAC,GAAGD,IAAI,CAACL,QAAQ,CAAC,EAAE;MACtC;;MAEAM,WAAU,GAAIA,WAAW,CAACC,KAAK,CAAC,CAAC,CAAC,CAAC,EAAE;;MAErCD,WAAU,GAAIA,WAAW,CAACE,GAAG,CAAEC,IAAI,IAAK;QACtC,IAAIA,IAAI,CAACC,QAAQ,EAAE;UACjB;UACAD,IAAI,CAACN,GAAE,GAAIM,IAAI,CAACC,QAAQ,CAACP,GAAG;QAC9B;QAEA,OAAOM,IAAI;MACb,CAAC,CAAC;MACFT,QAAQ,CAACW,KAAI,GAAIL,WAAW;IAC9B,CAAC;IAED,OAAO;MACLN,QAAQ;MACRI;IACF,CAAC;EACH;AACF,CAAC,CAAC"},"metadata":{},"sourceType":"module","externalDependencies":[]}