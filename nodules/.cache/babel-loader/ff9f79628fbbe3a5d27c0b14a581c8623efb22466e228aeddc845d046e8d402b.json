{"ast":null,"code":"import { RecordViewWrapper } from \"../style\";\nimport { Main, TableWrapper } from \"../../styled\";\nimport { useStore } from \"vuex\";\nimport { computed, onMounted, ref, reactive, defineComponent } from \"vue\";\n// import axios from \"axios\";\nimport { useRoute } from \"vue-router\";\nimport authHeader from \"../../../services/auth-header\";\nconst columns = [\n//   {\n//     title: \"Id\",\n//     dataIndex: \"id\",\n//     key: \"id\",\n//   },\n{\n  title: \"Ward Name\",\n  dataIndex: \"name\",\n  key: \"id\"\n}, {\n  title: \"Ward Code\",\n  dataIndex: \"code\",\n  key: \"name\"\n}, {\n  title: \"Org ID\",\n  dataIndex: \"org_id\",\n  key: \"org_id\"\n}, {\n  title: \"\",\n  dataIndex: \"\",\n  key: \"units\",\n  slots: {\n    customRender: \"units\"\n  }\n}];\nconst DragAndDropTable = defineComponent({\n  name: \"ViewPage\",\n  components: {\n    RecordViewWrapper,\n    Main,\n    TableWrapper\n  },\n  setup() {\n    const {\n      state,\n      dispatch\n    } = useStore();\n    const crud = computed(() => state.crud.data);\n    const isLoading = computed(() => state.crud.loading);\n    const selectedRowKeys = ref([]);\n    const dataSource = ref([]);\n    const {\n      params,\n      query\n    } = useRoute();\n\n    //   const api_url = UserService;\n    //   console.log(api_url);\n\n    console.log({\n      query,\n      params\n    });\n    console.log(query.id);\n    onMounted(async () => {\n      try {\n        const response = await fetch(`${process.env.VUE_APP_BASE_URL}/get_sub_counties_list?parent_id=${query.id}`, {\n          method: \"GET\",\n          headers: authHeader()\n        });\n        const data = await response.json();\n        console.log(data);\n        dataSource.value = data.message;\n        console.log(dataSource.value);\n      } catch (error) {\n        console.error(error);\n      }\n    });\n    const handleDelete = id => {\n      const confirm = window.confirm(\"Are you sure delete this?\");\n      if (confirm) {\n        dispatch(\"axiosDataDelete\", {\n          id,\n          getData: () => {\n            dispatch(\"axiosCrudGetData\");\n          }\n        });\n      }\n      return false;\n    };\n    const formState = reactive({\n      searchItem: \"\"\n    });\n    const onSelectChange = selectedRowKey => {\n      selectedRowKeys.value = selectedRowKey;\n    };\n    const rowSelection = {\n      selectedRowKeys,\n      onChange: onSelectChange\n    };\n    return {\n      crud,\n      isLoading,\n      selectedRowKeys,\n      handleDelete,\n      rowSelection,\n      onSelectChange,\n      dataSource,\n      columns,\n      formState\n    };\n  }\n});\nexport default DragAndDropTable;","map":{"version":3,"names":["RecordViewWrapper","Main","TableWrapper","useStore","computed","onMounted","ref","reactive","defineComponent","useRoute","authHeader","columns","title","dataIndex","key","slots","customRender","DragAndDropTable","name","components","setup","state","dispatch","crud","data","isLoading","loading","selectedRowKeys","dataSource","params","query","console","log","id","response","fetch","process","env","VUE_APP_BASE_URL","method","headers","json","value","message","error","handleDelete","confirm","window","getData","formState","searchItem","onSelectChange","selectedRowKey","rowSelection","onChange"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/pages/orgUnits/wardUnits.vue"],"sourcesContent":["<template>\n  <RecordViewWrapper>\n    <sdPageHeader title=\"Wards\">\n      <template #subTitle>\n        <sdButton class=\"btn-add_new\" size=\"default\" type=\"success\"> </sdButton>\n      </template>\n    </sdPageHeader>\n    <Main>\n      <a-row :gutter=\"15\">\n        <a-col class=\"w-100\" :md=\"24\">\n          <sdCards headless>\n            <div v-if=\"isLoading\" class=\"spin\">\n              <a-spin />\n            </div>\n\n            <div v-else>\n              <TableWrapper class=\"table-data-view table-responsive\">\n                <a-table\n                  :pagination=\"{ pageSize: 10, showSizeChanger: true }\"\n                  :dataSource=\"dataSource\"\n                  :columns=\"columns\"\n                >\n                  <template #units=\"{ record }\">\n                    <td>\n                      <div class=\"table-actions\">\n                        <sdButton>\n                          <router-link\n                            :to=\"{\n                              path: `/org-units${record.id}/locations`,\n                              query: { id: record.org_id },\n                            }\"\n                            class=\"btn-icon\"\n                            type=\"info\"\n                            shape=\"circle\"\n                          >\n                            <sdFeatherIcons type=\"eye\" size=\"16\" />\n                            &nbsp;&nbsp; View Locations\n                          </router-link>\n                        </sdButton>\n                      </div>\n                    </td>\n                  </template>\n                </a-table>\n              </TableWrapper>\n            </div>\n          </sdCards>\n        </a-col>\n      </a-row>\n      <a-col :xs=\"24\">\n        <DragAndDropTable />\n      </a-col>\n    </Main>\n  </RecordViewWrapper>\n</template>\n<script>\nimport { RecordViewWrapper } from \"../style\";\nimport { Main, TableWrapper } from \"../../styled\";\nimport { useStore } from \"vuex\";\nimport { computed, onMounted, ref, reactive, defineComponent } from \"vue\";\n// import axios from \"axios\";\nimport { useRoute } from \"vue-router\";\nimport authHeader from \"../../../services/auth-header\";\n\nconst columns = [\n//   {\n//     title: \"Id\",\n//     dataIndex: \"id\",\n//     key: \"id\",\n//   },\n  {\n    title: \"Ward Name\",\n    dataIndex: \"name\",\n    key: \"id\",\n  },\n  {\n    title: \"Ward Code\",\n    dataIndex: \"code\",\n    key: \"name\",\n  },\n  {\n    title: \"Org ID\",\n    dataIndex: \"org_id\",\n    key: \"org_id\",\n  },\n  {\n    title: \"\",\n    dataIndex: \"\",\n    key: \"units\",\n    slots: { customRender: \"units\" },\n  },\n];\n\nconst DragAndDropTable = defineComponent({\n  name: \"ViewPage\",\n  components: { RecordViewWrapper, Main, TableWrapper },\n\n  setup() {\n    const { state, dispatch } = useStore();\n    const crud = computed(() => state.crud.data);\n    const isLoading = computed(() => state.crud.loading);\n    const selectedRowKeys = ref([]);\n    const dataSource = ref([]);\n    const { params, query } = useRoute();\n\n    //   const api_url = UserService;\n    //   console.log(api_url);\n\n    console.log({ query, params });\n    console.log(query.id);\n\n    onMounted(async () => {\n      try {\n        const response = await fetch(\n          `${process.env.VUE_APP_BASE_URL}/get_sub_counties_list?parent_id=${query.id}`,\n          {\n            method: \"GET\",\n            headers: authHeader(),\n          }\n        );\n        const data = await response.json();\n        console.log(data);\n        dataSource.value = data.message;\n        console.log(dataSource.value);\n      } catch (error) {\n        console.error(error);\n      }\n    });\n\n    const handleDelete = (id) => {\n      const confirm = window.confirm(\"Are you sure delete this?\");\n      if (confirm) {\n        dispatch(\"axiosDataDelete\", {\n          id,\n          getData: () => {\n            dispatch(\"axiosCrudGetData\");\n          },\n        });\n      }\n      return false;\n    };\n\n    const formState = reactive({\n      searchItem: \"\",\n    });\n\n    const onSelectChange = (selectedRowKey) => {\n      selectedRowKeys.value = selectedRowKey;\n    };\n\n    const rowSelection = {\n      selectedRowKeys,\n      onChange: onSelectChange,\n    };\n\n    return {\n      crud,\n      isLoading,\n      selectedRowKeys,\n      handleDelete,\n      rowSelection,\n      onSelectChange,\n      dataSource,\n      columns,\n      formState,\n    };\n  },\n});\n\nexport default DragAndDropTable;\n</script>\n"],"mappings":"AAuDA,SAASA,iBAAgB,QAAS,UAAU;AAC5C,SAASC,IAAI,EAAEC,YAAW,QAAS,cAAc;AACjD,SAASC,QAAO,QAAS,MAAM;AAC/B,SAASC,QAAQ,EAAEC,SAAS,EAAEC,GAAG,EAAEC,QAAQ,EAAEC,eAAc,QAAS,KAAK;AACzE;AACA,SAASC,QAAO,QAAS,YAAY;AACrC,OAAOC,UAAS,MAAO,+BAA+B;AAEtD,MAAMC,OAAM,GAAI;AAChB;AACA;AACA;AACA;AACA;AACE;EACEC,KAAK,EAAE,WAAW;EAClBC,SAAS,EAAE,MAAM;EACjBC,GAAG,EAAE;AACP,CAAC,EACD;EACEF,KAAK,EAAE,WAAW;EAClBC,SAAS,EAAE,MAAM;EACjBC,GAAG,EAAE;AACP,CAAC,EACD;EACEF,KAAK,EAAE,QAAQ;EACfC,SAAS,EAAE,QAAQ;EACnBC,GAAG,EAAE;AACP,CAAC,EACD;EACEF,KAAK,EAAE,EAAE;EACTC,SAAS,EAAE,EAAE;EACbC,GAAG,EAAE,OAAO;EACZC,KAAK,EAAE;IAAEC,YAAY,EAAE;EAAQ;AACjC,CAAC,CACF;AAED,MAAMC,gBAAe,GAAIT,eAAe,CAAC;EACvCU,IAAI,EAAE,UAAU;EAChBC,UAAU,EAAE;IAAEnB,iBAAiB;IAAEC,IAAI;IAAEC;EAAa,CAAC;EAErDkB,KAAKA,CAAA,EAAG;IACN,MAAM;MAAEC,KAAK;MAAEC;IAAS,IAAInB,QAAQ,EAAE;IACtC,MAAMoB,IAAG,GAAInB,QAAQ,CAAC,MAAMiB,KAAK,CAACE,IAAI,CAACC,IAAI,CAAC;IAC5C,MAAMC,SAAQ,GAAIrB,QAAQ,CAAC,MAAMiB,KAAK,CAACE,IAAI,CAACG,OAAO,CAAC;IACpD,MAAMC,eAAc,GAAIrB,GAAG,CAAC,EAAE,CAAC;IAC/B,MAAMsB,UAAS,GAAItB,GAAG,CAAC,EAAE,CAAC;IAC1B,MAAM;MAAEuB,MAAM;MAAEC;IAAM,IAAIrB,QAAQ,EAAE;;IAEpC;IACA;;IAEAsB,OAAO,CAACC,GAAG,CAAC;MAAEF,KAAK;MAAED;IAAO,CAAC,CAAC;IAC9BE,OAAO,CAACC,GAAG,CAACF,KAAK,CAACG,EAAE,CAAC;IAErB5B,SAAS,CAAC,YAAY;MACpB,IAAI;QACF,MAAM6B,QAAO,GAAI,MAAMC,KAAK,CACzB,GAAEC,OAAO,CAACC,GAAG,CAACC,gBAAiB,oCAAmCR,KAAK,CAACG,EAAG,EAAC,EAC7E;UACEM,MAAM,EAAE,KAAK;UACbC,OAAO,EAAE9B,UAAU;QACrB,EACD;QACD,MAAMc,IAAG,GAAI,MAAMU,QAAQ,CAACO,IAAI,EAAE;QAClCV,OAAO,CAACC,GAAG,CAACR,IAAI,CAAC;QACjBI,UAAU,CAACc,KAAI,GAAIlB,IAAI,CAACmB,OAAO;QAC/BZ,OAAO,CAACC,GAAG,CAACJ,UAAU,CAACc,KAAK,CAAC;MAC/B,EAAE,OAAOE,KAAK,EAAE;QACdb,OAAO,CAACa,KAAK,CAACA,KAAK,CAAC;MACtB;IACF,CAAC,CAAC;IAEF,MAAMC,YAAW,GAAKZ,EAAE,IAAK;MAC3B,MAAMa,OAAM,GAAIC,MAAM,CAACD,OAAO,CAAC,2BAA2B,CAAC;MAC3D,IAAIA,OAAO,EAAE;QACXxB,QAAQ,CAAC,iBAAiB,EAAE;UAC1BW,EAAE;UACFe,OAAO,EAAEA,CAAA,KAAM;YACb1B,QAAQ,CAAC,kBAAkB,CAAC;UAC9B;QACF,CAAC,CAAC;