{"ast":null,"code":"import { ref, reactive, toRefs, nextTick, defineComponent } from 'vue';\nimport { PlusOutlined } from '@ant-design/icons-vue';\nimport VueTypes from 'vue-types';\nexport default defineComponent({\n  name: 'Tag',\n  components: {\n    PlusOutlined\n  },\n  props: {\n    tagType: VueTypes.oneOf(['basic', 'hottags', 'colorful', 'dynamicTag', 'closable']).def('basic'),\n    data: VueTypes.arrayOf(VueTypes.string),\n    color: VueTypes.string,\n    checked: VueTypes.bool\n  },\n  setup(props) {\n    const state = reactive({\n      selectedTags: [],\n      tags: props.data,\n      inputVisible: false,\n      inputValue: ''\n    });\n    const handleChange = (tag, checked) => {\n      const {\n        selectedTags\n      } = state;\n      const nextSelectedTags = checked ? [...selectedTags, tag] : selectedTags.filter(t => t !== tag);\n      state.selectedTags = nextSelectedTags;\n    };\n    const inputRef = ref();\n    const handleClose = removedTag => {\n      const tags = state.tags.filter(tag => tag !== removedTag);\n      state.tags = tags;\n    };\n    const showInput = () => {\n      state.inputVisible = true;\n      nextTick(() => {\n        inputRef.value.focus();\n      });\n    };\n    const handleInputConfirm = () => {\n      const inputValue = state.inputValue;\n      let tags = state.tags;\n      if (inputValue && tags.indexOf(inputValue) === -1) {\n        tags = [...tags, inputValue];\n      }\n      Object.assign(state, {\n        tags,\n        inputVisible: false,\n        inputValue: ''\n      });\n    };\n    return {\n      ...toRefs(state),\n      handleChange,\n      handleClose,\n      showInput,\n      handleInputConfirm,\n      inputRef\n    };\n  }\n});","map":{"version":3,"names":["ref","reactive","toRefs","nextTick","defineComponent","PlusOutlined","VueTypes","name","components","props","tagType","oneOf","def","data","arrayOf","string","color","checked","bool","setup","state","selectedTags","tags","inputVisible","inputValue","handleChange","tag","nextSelectedTags","filter","t","inputRef","handleClose","removedTag","showInput","value","focus","handleInputConfirm","indexOf","Object","assign"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/components/tags/Tag.vue"],"sourcesContent":["<template>\r\n  <a-tag v-if=\"tagType == 'basic'\"><slot></slot></a-tag>\r\n  <a-tag closable v-if=\"tagType == 'closable'\"><slot></slot></a-tag>\r\n  <div v-if=\"tagType == 'hottags'\">\r\n    <span :style=\"{ marginRight: '8px' }\">Categories:</span>\r\n    <template v-for=\"tag in data\" :key=\"tag\">\r\n      <a-checkable-tag :checked=\"selectedTags.indexOf(tag) > -1\" @change=\"(checked) => handleChange(tag, checked)\">\r\n        {{ tag }}\r\n      </a-checkable-tag>\r\n    </template>\r\n  </div>\r\n  <a-tag v-if=\"tagType == 'colorful'\" :color=\"color\">{{ color }}</a-tag>\r\n  <div class=\"sDash-dynamic-tag\" v-if=\"tagType == 'dynamicTag'\">\r\n    <template v-for=\"(tag, index) in tags\" :key=\"index\">\r\n      <a-tooltip v-if=\"tag.length > 20\" :title=\"tag\">\r\n        <a-tag :key=\"tag\" :closable=\"index !== 0\" @close=\"handleClose(tag)\">\r\n          {{ `${tag.slice(0, 20)}...` }}\r\n        </a-tag>\r\n      </a-tooltip>\r\n      <a-tag v-else :closable=\"index !== 0\" @close=\"handleClose(tag)\">\r\n        {{ tag }}\r\n      </a-tag>\r\n    </template>\r\n    <a-input\r\n      v-if=\"inputVisible\"\r\n      ref=\"inputRef\"\r\n      type=\"text\"\r\n      size=\"small\"\r\n      :style=\"{ width: '78px' }\"\r\n      v-model:value=\"inputValue\"\r\n      @blur=\"handleInputConfirm\"\r\n      @keyup.enter=\"handleInputConfirm\"\r\n    />\r\n    <a-tag v-else @click=\"showInput\" class=\"sDash-new-tag-input\">\r\n      <plus-outlined />\r\n      New Tag\r\n    </a-tag>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { ref, reactive, toRefs, nextTick, defineComponent } from 'vue';\r\nimport { PlusOutlined } from '@ant-design/icons-vue';\r\nimport VueTypes from 'vue-types';\r\nexport default defineComponent({\r\n  name: 'Tag',\r\n  components: { PlusOutlined },\r\n  props: {\r\n    tagType: VueTypes.oneOf(['basic', 'hottags', 'colorful', 'dynamicTag', 'closable']).def('basic'),\r\n    data: VueTypes.arrayOf(VueTypes.string),\r\n    color: VueTypes.string,\r\n    checked: VueTypes.bool,\r\n  },\r\n  setup(props) {\r\n    const state = reactive({\r\n      selectedTags: [],\r\n      tags: props.data,\r\n      inputVisible: false,\r\n      inputValue: '',\r\n    });\r\n\r\n    const handleChange = (tag, checked) => {\r\n      const { selectedTags } = state;\r\n      const nextSelectedTags = checked ? [...selectedTags, tag] : selectedTags.filter((t) => t !== tag);\r\n      state.selectedTags = nextSelectedTags;\r\n    };\r\n\r\n    const inputRef = ref();\r\n\r\n    const handleClose = (removedTag) => {\r\n      const tags = state.tags.filter((tag) => tag !== removedTag);\r\n      state.tags = tags;\r\n    };\r\n\r\n    const showInput = () => {\r\n      state.inputVisible = true;\r\n      nextTick(() => {\r\n        inputRef.value.focus();\r\n      });\r\n    };\r\n\r\n    const handleInputConfirm = () => {\r\n      const inputValue = state.inputValue;\r\n      let tags = state.tags;\r\n\r\n      if (inputValue && tags.indexOf(inputValue) === -1) {\r\n        tags = [...tags, inputValue];\r\n      }\r\n      Object.assign(state, {\r\n        tags,\r\n        inputVisible: false,\r\n        inputValue: '',\r\n      });\r\n    };\r\n\r\n    return { ...toRefs(state), handleChange, handleClose, showInput, handleInputConfirm, inputRef };\r\n  },\r\n});\r\n</script>\r\n"],"mappings":"AAyCA,SAASA,GAAG,EAAEC,QAAQ,EAAEC,MAAM,EAAEC,QAAQ,EAAEC,eAAc,QAAS,KAAK;AACtE,SAASC,YAAW,QAAS,uBAAuB;AACpD,OAAOC,QAAO,MAAO,WAAW;AAChC,eAAeF,eAAe,CAAC;EAC7BG,IAAI,EAAE,KAAK;EACXC,UAAU,EAAE;IAAEH;EAAa,CAAC;EAC5BI,KAAK,EAAE;IACLC,OAAO,EAAEJ,QAAQ,CAACK,KAAK,CAAC,CAAC,OAAO,EAAE,SAAS,EAAE,UAAU,EAAE,YAAY,EAAE,UAAU,CAAC,CAAC,CAACC,GAAG,CAAC,OAAO,CAAC;IAChGC,IAAI,EAAEP,QAA