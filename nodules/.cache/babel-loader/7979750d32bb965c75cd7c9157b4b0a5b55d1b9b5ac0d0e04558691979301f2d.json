{"ast":null,"code":"import { computed, defineAsyncComponent, defineComponent } from 'vue';\nimport { useStore } from 'vuex';\nimport { Main, CardToolbox } from '../../styled';\nconst TeamCard = defineAsyncComponent(() => import('./overview/TeamCard'));\nconst Team = defineComponent({\n  name: 'Team',\n  components: {\n    Main,\n    CardToolbox,\n    TeamCard\n  },\n  setup() {\n    const {\n      state\n    } = useStore();\n    const searchData = computed(() => state.headerSearchData);\n    const team = computed(() => state.team.data);\n    return {\n      searchData,\n      team\n    };\n  }\n});\nexport default Team;","map":{"version":3,"names":["computed","defineAsyncComponent","defineComponent","useStore","Main","CardToolbox","TeamCard","Team","name","components","setup","state","searchData","headerSearchData","team","data"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/apps/users/Team.vue"],"sourcesContent":["<template>\r\n  <CardToolbox>\r\n    <sdPageHeader title=\"Team Members\">\r\n      <template #subTitle>\r\n        <span class=\"title-counter\">274 Users</span>\r\n        <sdAutoComplete :dataSource=\"searchData\" width=\"100%\" placeholder=\"Search by Name\" patterns />\r\n      </template>\r\n      <template #buttons>\r\n        <sdButton class=\"btn-add_new\" size=\"default\" key=\"1\" type=\"primary\">\r\n          <sdFeatherIcons type=\"plus\" size=\"14\" /> Add New Member\r\n        </sdButton>\r\n      </template>\r\n    </sdPageHeader>\r\n  </CardToolbox>\r\n\r\n  <Main>\r\n    <a-row :gutter=\"25\">\r\n      <a-col v-for=\"user in team\" :key=\"user.id\" :xxl=\"6\" :lg=\"8\" :sm=\"12\" :xs=\"24\">\r\n        <Suspense>\r\n          <template #fallback>\r\n            <sdCards headless>\r\n              <a-skeleton avatar active />\r\n            </sdCards>\r\n          </template>\r\n          <template #default>\r\n            <TeamCard :user=\"user\">\r\n              <template #item>\r\n                <a to=\"#\">\r\n                  <sdFeatherIcons size=\"14\" type=\"eye\" />\r\n                  <span>View</span>\r\n                </a>\r\n                <a to=\"#\">\r\n                  <sdFeatherIcons size=\"14\" type=\"edit\" />\r\n                  <span>Edit</span>\r\n                </a>\r\n                <a to=\"#\">\r\n                  <sdFeatherIcons size=\"14\" type=\"trash-2\" />\r\n                  <span>Delete</span>\r\n                </a>\r\n              </template>\r\n            </TeamCard>\r\n          </template>\r\n        </Suspense>\r\n      </a-col></a-row\r\n    >\r\n  </Main>\r\n</template>\r\n<script>\r\nimport { computed, defineAsyncComponent, defineComponent } from 'vue';\r\nimport { useStore } from 'vuex';\r\nimport { Main, CardToolbox } from '../../styled';\r\nconst TeamCard = defineAsyncComponent(() => import('./overview/TeamCard'));\r\n\r\nconst Team = defineComponent({\r\n  name: 'Team',\r\n  components: { Main, CardToolbox, TeamCard },\r\n  setup() {\r\n    const { state } = useStore();\r\n    const searchData = computed(() => state.headerSearchData);\r\n    const team = computed(() => state.team.data);\r\n    return {\r\n      searchData,\r\n      team,\r\n    };\r\n  },\r\n});\r\n\r\nexport default Team;\r\n</script>\r\n"],"mappings":"AAgDA,SAASA,QAAQ,EAAEC,oBAAoB,EAAEC,eAAc,QAAS,KAAK;AACrE,SAASC,QAAO,QAAS,MAAM;AAC/B,SAASC,IAAI,EAAEC,WAAU,QAAS,cAAc;AAChD,MAAMC,QAAO,GAAIL,oBAAoB,CAAC,MAAM,MAAM,CAAC,qBAAqB,CAAC,CAAC;AAE1E,MAAMM,IAAG,GAAIL,eAAe,CAAC;EAC3BM,IAAI,EAAE,MAAM;EACZC,UAAU,EAAE;IAAEL,IAAI;IAAEC,WAAW;IAAEC;EAAS,CAAC;EAC3CI,KAAKA,CAAA,EAAG;IACN,MAAM;MAAEC;IAAM,IAAIR,QAAQ,EAAE;IAC5B,MAAMS,UAAS,GAAIZ,QAAQ,CAAC,MAAMW,KAAK,CAACE,gBAAgB,CAAC;IACzD,MAAMC,IAAG,GAAId,QAAQ,CAAC,MAAMW,KAAK,CAACG,IAAI,CAACC,IAAI,CAAC;IAC5C,OAAO;MACLH,UAAU;MACVE;IACF,CAAC;EACH;AACF,CAAC,CAAC;AAEF,eAAeP,IAAI"},"metadata":{},"sourceType":"module","externalDependencies":[]}