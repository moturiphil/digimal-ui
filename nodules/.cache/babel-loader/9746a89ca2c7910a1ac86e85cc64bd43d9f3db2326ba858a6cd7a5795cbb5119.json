{"ast":null,"code":"import { computed, onMounted, ref, defineComponent } from 'vue';\nimport { RegionList, RegionMap } from '../../style';\nimport WorldMap from '@/components/utilities/VectorMap.vue';\nimport { useStore } from 'vuex';\nimport { PerfectScrollbar } from 'vue3-perfect-scrollbar';\nimport 'vue3-perfect-scrollbar/dist/vue3-perfect-scrollbar.css';\nimport svgMapDataGPD from '@/demoData/vectorMap.js';\nconst regionColumns = [{\n  title: 'Top Region',\n  dataIndex: 'region',\n  key: 'region'\n}, {\n  title: 'Sessions',\n  dataIndex: 'sessions',\n  key: 'sessions'\n}];\nconst SessionsbyRegion = defineComponent({\n  name: 'SessionsbyRegion',\n  components: {\n    RegionList,\n    RegionMap,\n    WorldMap,\n    PerfectScrollbar\n  },\n  setup() {\n    const {\n      state,\n      dispatch\n    } = useStore();\n    const sessionByRegionState = computed(() => state.chartContent.regionData);\n    const region = ref('year');\n    const handleActiveChangeRegion = (event, value) => {\n      event.preventDefault();\n      region.value = value;\n      dispatch('topRegionFilterData', value);\n    };\n    const regionData = computed(() => sessionByRegionState.value ? sessionByRegionState.value.map((value, index) => {\n      return {\n        key: index + 1,\n        region: value[0],\n        sessions: value[1]\n      };\n    }) : []);\n    onMounted(() => dispatch('topRegionGetData'));\n    return {\n      sessionByRegionState,\n      handleActiveChangeRegion,\n      regionColumns,\n      regionData,\n      region,\n      svgMapDataGPD,\n      options: {\n        width: 492,\n        height: 188,\n        zoom: true,\n        hideAntarctic: true,\n        landsColor: '#ddd',\n        landsBorder: '#fff'\n      }\n    };\n  }\n});\nexport default SessionsbyRegion;","map":{"version":3,"names":["computed","onMounted","ref","defineComponent","RegionList","RegionMap","WorldMap","useStore","PerfectScrollbar","svgMapDataGPD","regionColumns","title","dataIndex","key","SessionsbyRegion","name","components","setup","state","dispatch","sessionByRegionState","chartContent","regionData","region","handleActiveChangeRegion","event","value","preventDefault","map","index","sessions","options","width","height","zoom","hideAntarctic","landsColor","landsBorder"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/dashboard/overview/performance/SessionsbyRegion.vue"],"sourcesContent":["<template>\r\n  <div class=\"full-width-table region-list-table\">\r\n    <sdCards title=\"Sessions by Region\" bodypadding=\"0px\">\r\n      <template #button>\r\n        <div class=\"card-nav\">\r\n          <ul>\r\n            <li :class=\"region === 'week' ? 'active' : 'deactivate'\">\r\n              <router-link @click=\"(e) => handleActiveChangeRegion(e, 'week')\" to=\"#\"> Week </router-link>\r\n            </li>\r\n            <li :class=\"region === 'month' ? 'active' : 'deactivate'\">\r\n              <router-link @click=\"(e) => handleActiveChangeRegion(e, 'month')\" to=\"#\"> Month </router-link>\r\n            </li>\r\n            <li :class=\"region === 'year' ? 'active' : 'deactivate'\">\r\n              <router-link @click=\"(e) => handleActiveChangeRegion(e, 'year')\" to=\"#\"> Year </router-link>\r\n            </li>\r\n          </ul>\r\n        </div>\r\n      </template>\r\n      <a-row>\r\n        <a-col :xxl=\"10\" :md=\"11\" :xs=\"24\">\r\n          <RegionList>\r\n            <perfect-scrollbar\r\n              :options=\"{\r\n                wheelSpeed: 1,\r\n                swipeEasing: true,\r\n                suppressScrollX: true,\r\n              }\"\r\n            >\r\n              <a-table :columns=\"regionColumns\" :dataSource=\"regionData\" :pagination=\"false\" />\r\n            </perfect-scrollbar>\r\n          </RegionList>\r\n        </a-col>\r\n        <a-col :xxl=\"14\" :md=\"13\" :xs=\"24\">\r\n          <RegionMap>\r\n            <WorldMap :options=\"{ ...svgMapDataGPD }\" />\r\n          </RegionMap>\r\n        </a-col>\r\n      </a-row>\r\n    </sdCards>\r\n  </div>\r\n</template>\r\n<script>\r\nimport { computed, onMounted, ref, defineComponent } from 'vue';\r\nimport { RegionList, RegionMap } from '../../style';\r\nimport WorldMap from '@/components/utilities/VectorMap.vue';\r\nimport { useStore } from 'vuex';\r\nimport { PerfectScrollbar } from 'vue3-perfect-scrollbar';\r\nimport 'vue3-perfect-scrollbar/dist/vue3-perfect-scrollbar.css';\r\nimport svgMapDataGPD from '@/demoData/vectorMap.js';\r\n\r\nconst regionColumns = [\r\n  {\r\n    title: 'Top Region',\r\n    dataIndex: 'region',\r\n    key: 'region',\r\n  },\r\n  {\r\n    title: 'Sessions',\r\n    dataIndex: 'sessions',\r\n    key: 'sessions',\r\n  },\r\n];\r\n\r\nconst SessionsbyRegion = defineComponent({\r\n  name: 'SessionsbyRegion',\r\n  components: { RegionList, RegionMap, WorldMap, PerfectScrollbar },\r\n  setup() {\r\n    const { state, dispatch } = useStore();\r\n    const sessionByRegionState = computed(() => state.chartContent.regionData);\r\n    const region = ref('year');\r\n\r\n    const handleActiveChangeRegion = (event, value) => {\r\n      event.preventDefault();\r\n      region.value = value;\r\n      dispatch('topRegionFilterData', value);\r\n    };\r\n\r\n    const regionData = computed(() =>\r\n      sessionByRegionState.value\r\n        ? sessionByRegionState.value.map((value, index) => {\r\n            return { key: index + 1, region: value[0], sessions: value[1] };\r\n          })\r\n        : [],\r\n    );\r\n\r\n    onMounted(() => dispatch('topRegionGetData'));\r\n\r\n    return {\r\n      sessionByRegionState,\r\n      handleActiveChangeRegion,\r\n      regionColumns,\r\n      regionData,\r\n      region,\r\n      svgMapDataGPD,\r\n      options: {\r\n        width: 492,\r\n        height: 188,\r\n        zoom: true,\r\n        hideAntarctic: true,\r\n        landsColor: '#ddd',\r\n        landsBorder: '#fff',\r\n      },\r\n    };\r\n  },\r\n});\r\n\r\nexport default SessionsbyRegion;\r\n</script>\r\n<style scoped>\r\n.ps {\r\n  height: 200px;\r\n}\r\n</style>\r\n"],"mappings":"AA0CA,SAASA,QAAQ,EAAEC,SAAS,EAAEC,GAAG,EAAEC,eAAc,QAAS,KAAK;AAC/D,SAASC,UAAU,EAAEC,SAAQ,QAAS,aAAa;AACnD,OAAOC,QAAO,MAAO,sCAAsC;AAC3D,SAASC,QAAO,QAAS,MAAM;AAC/B,SAASC,gBAAe,QAAS,wBAAwB;AACzD,OAAO,wDAAwD;AAC/D,OAAOC,aAAY,MAAO,yBAAyB;AAEnD,MAAMC,aAAY,GAAI,CACpB;EACEC,KAAK,EAAE,YAAY;EACnBC,SAAS,EAAE,QAAQ;EACnBC,GAAG,EAAE;AACP,CAAC,EACD;EACEF,KAAK,EAAE,UAAU;EACjBC,SAAS,EAAE,UAAU;EACrBC,GAAG,EAAE;AACP,CAAC,CACF;AAED,MAAMC,gBAAe,GAAIX,eAAe,CAAC;EACvCY,IAAI,EAAE,kBAAkB;EACxBC,UAAU,EAAE;IAAEZ,UAAU;IAAEC,SAAS;IAAEC,QAAQ;IAAEE;EAAiB,CAAC;EACjES,KAAKA,CAAA,EAAG;IACN,MAAM;MAAEC,KAAK;MAAEC;IAAS,IAAIZ,QAAQ,EAAE;IACtC,MAAMa,oBAAmB,GAAIpB,QAAQ,CAAC,MAAMkB,KAAK,CAACG,YAAY,CAACC,UAAU,CAAC;IAC1E,MAAMC,MAAK,GAAIrB,GAAG,CAAC,MAAM,CAAC;IAE1B,MAAMsB,wBAAuB,GAAIA,CAACC,KAAK,EAAEC,KAAK,KAAK;MACjDD,KAAK,CAACE,cAAc,EAAE;MACtBJ,MAAM,CAACG,KAAI,GAAIA,KAAK;MACpBP,QAAQ,CAAC,qBAAqB,EAAEO,KAAK,CAAC;IACxC,CAAC;IAED,MAAMJ,UAAS,GAAItB,QAAQ,CAAC,MAC1BoB,oBAAoB,CAACM,KAAI,GACrBN,oBAAoB,CAACM,KAAK,CAACE,GAAG,CAAC,CAACF,KAAK,EAAEG,KAAK,KAAK;MAC/C,OAAO;QAAEhB,GAAG,EAAEgB,KAAI,GAAI,CAAC;QAAEN,MAAM,EAAEG,KAAK,CAAC,CAAC,CAAC;QAAEI,QAAQ,EAAEJ,KAAK,CAAC,CAAC;MAAE,CAAC;IACjE,CAAC,IACD,EAAE,CACP;IAEDzB,SAAS,CAAC,MAAMkB,QAAQ,CAAC,kBAAkB,CAAC,CAAC;IAE7C,OAAO;MACLC,oBAAoB;MACpBI,wBAAwB;MACxBd,aAAa;MACbY,UAAU;MACVC,MAAM;MACNd,aAAa;MACbsB,OAAO,EAAE;QACPC,KAAK,EAAE,GAAG;QACVC,MAAM,EAAE,GAAG;QACXC,IAAI,EAAE,IAAI;QACVC,aAAa,EAAE,IAAI;QACnBC,UAAU,EAAE,MAAM;QAClBC,WAAW,EAAE;MACf;IACF,CAAC;EACH;AACF,CAAC,CAAC;AAEF,eAAevB,gBAAgB"},"metadata":{},"sourceType":"module","externalDependencies":[]}