nty_id: \"\",\n      campaign_id: \"\",\n      start_date: \"\",\n      end_date: \"\",\n      payable_travel_days: \"\",\n      number_of_officers: \"\",\n      activity_facilitator: [],\n      matrix: []\n    });\n\n    //get activities list\n\n    const getActivityList = async () => {\n      const response = await fetch(`${process.env.VUE_APP_BASE_URL}/activity_list`, {\n        method: \"GET\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          ...authHeader()\n        }\n      });\n      const data = await response.json();\n      // console.log(data.data);\n      this.activities = data.data;\n      // console.log(data);\n    };\n    //counties\n    const getCounties = async () => {\n      const response = await fetch(`${process.env.VUE_APP_BASE_URL}/counties`, {\n        method: \"GET\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          ...authHeader()\n        }\n      });\n      const data = await response.json();\n      this.counties = data.map(county => ({\n        ...county\n        // org_id: county.org_id,\n      }));\n      // console.log(this.counties);\n      this.loading = false;\n    };\n\n    //get sub_counties\n    const getSubCounties = async org_id => {\n      // console.log(org_id);\n      const response = await fetch(`${process.env.VUE_APP_BASE_URL}/get_sub_counties_list?parent_id=${org_id}`, {\n        method: \"GET\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          ...authHeader()\n        }\n      });\n      const data = await response.json();\n      // console.log(data);\n      this.sub_counties = data.message;\n    };\n    //campaigns\n    const getCampaigns = async () => {\n      const response = await fetch(`${process.env.VUE_APP_BASE_URL}/campaign_all`, {\n        method: \"GET\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          ...authHeader()\n        }\n      });\n      const data = await response.json();\n      this.campaigns = data.data;\n    };\n    // const handleSelect = (values)\n    const handleSubmit = values => {\n      values = {\n        activity_list_id: values.activity_id,\n        county_id: values.county_id,\n        sub_county_id: values.sub_county_id,\n        campaign_id: values.campaign_id,\n        start_date: new Date(values.start_date.$d).toISOString().substr(0, 10),\n        // end_date: new Date(values.end_date.$d).toISOString().substr(0, 10),\n        // payable_travel_days: values.payable_travel_days,\n        number_of_officers: values.number_of_officers,\n        activity_facilitator: values.activity_facilitator,\n        pay_matrix: values.matrix,\n        location_type_id: 1\n      };\n      console.log({\n        values\n      });\n      fetch(API_URL, {\n        method: \"POST\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          ...authHeader()\n        },\n        body: JSON.stringify(values)\n      }).then(response => response.json()).then(({\n        success,\n        data\n      }) => {\n        // console.log(data); \n        if (success) {\n          router.push(\"activity-view\");\n          _notification[\"success\"]({\n            message: \"Activity Created\",\n            description: `Activity Created successfully. Your activity code is ${data.activity_code}`,\n            duration: 5.5\n          });\n        }\n      }).catch(error => {\n        console.error(\"Error:\", error);\n      });\n    };\n    onMounted(() => {\n      axios.get(`${process.env.VUE_APP_BASE_URL}/users`, {\n        headers: authHeader()\n      }).then(function ({\n        data\n      }) {\n        // console.log({ data: data.data });\n        users.value = data.data;\n      }).catch(function (error) {\n        console.log(error);\n      });\n      getCounties();\n      getCampaigns();\n      getSubCounties();\n      getActivityList();\n    });\n    return {\n      isLoading,\n      apiUrl,\n      users,\n      isFileLoading,\n      getSubCounties,\n      activities,\n      counties,\n      sub_counties,\n      campaigns,\n      handleSubmit,\n      dateFormat,\n      formState,\n      join,\n      participants: []\n    };\n  },\n  methods: {\n    // disabledDate(date) {\n    //   // Get today's date\n    //   const today = new Date();\n    //   // Disable dates before today\n    //   return date && date >= today ? false : true ;\n    // },\n\n    disabledDate(date) {\n      // Get today's date at midnight\n      const today = new Date();\n      today.setHours(0, 0, 0, 0);\n      // Disable dates before today, but include today\n      return date && date < today ? true : false;\n    },\n    showModal() {\n      this.visible = true;\n    },\n    showConfirmModal(activity_facilitator) {\n      // console.log(activity_facilitator);\n      _Modal.success({\n        title: \"Activity Officers\",\n        content: _createVNode(\"div\", null, [_createVNode(\"p\", null, [_createTextVNode(\"Confirm Officers Participating\")]), _createVNode(\"ul\", null, [activity_facilitator.map(facilitator => _createVNode(\"li\", {\n          \"key\": facilitator\n        }, [facilitator]))])]),\n        okText: \"Register\",\n        onOk: async () => {\n          // handle form submission here rk\n        },\n        style: {\n          float: \"center\",\n          display: \"grid\",\n          placeContent: \"center\"\n        }\n      });\n    },\n    handleOk() {\n      this.confirmLoading = true;\n      setTimeout(() => {\n        this.visible = false;\n        this.colorVisible = false;\n        this.confirmLoading = false;\n      }, 2000);\n    },\n    handleCancel() {\n      this.visible = false;\n      this.colorVisible = false;\n    },\n    changeType(type) {\n      this.modalType = type;\n    }\n  },\n  beforeRouteEnter(to, from, next) {\n    if (!sessionStorage.getItem(\"user\")) {\n      next(\"/auth/login\");\n    } else {\n      next();\n    }\n  }\n});\nexport default AddNew;","map":{"