rue : false;\n    },\n    \n    showModal() {\n      this.visible = true;\n    },\n    showConfirmModal(activity_facilitator) {\n      // console.log(activity_facilitator);\n      Modal.success({\n        title: \"Activity Officers\",\n        content: (\n          <div>\n            <p>Confirm Officers Participating</p>\n            <ul>\n              {activity_facilitator.map((facilitator) => (\n                <li key={facilitator}>{facilitator}</li>\n              ))}\n            </ul>\n          </div>\n        ),\n        okText: \"Register\",\n        onOk: async () => {\n          // handle form submission here rk\n        },\n        style: {\n          float: \"center\",\n          display: \"grid\",\n          placeContent: \"center\",\n        },\n      });\n    },\n    handleOk() {\n      this.confirmLoading = true;\n      setTimeout(() => {\n        this.visible = false;\n        this.colorVisible = false;\n        this.confirmLoading = false;\n      }, 2000);\n    },\n    handleCancel() {\n      this.visible = false;\n      this.colorVisible = false;\n    },\n    changeType(type) {\n      this.modalType = type;\n    },\n  },\n  beforeRouteEnter(to, from, next) {\n    if (!sessionStorage.getItem(\"user\")) {\n      next(\"/auth/login\");\n    } else {\n      next();\n    }\n  },\n});\nexport default AddNew;\n</script>\n"],"mappings":";;;;;;AA8NA,SAASA,iBAAgB,QAAS,SAAS;AAC3C,SAASC,IAAI,EAAEC,gBAAe,QAAS,cAAc;AACrD,SAASC,QAAO,QAAS,MAAM;AAC/B,SAASC,QAAQ,EAAEC,GAAG,EAAEC,eAAe,EAAEC,QAAQ,EAAEC,SAAQ,QAAS,KAAK;AAEzE,SAASC,SAAQ,QAAS,YAAY;AACtC,OAAOC,KAAI,MAAO,OAAO;AACzB,OAAOC,UAAS,MAAO,+BAA+B;AAEtD,MAAMC,UAAS,GAAI,YAAY;AAC/B,MAAMC,MAAK,GAAIP,eAAe,CAAC;EAC7BQ,IAAI,EAAE,QAAQ;EACdC,UAAU,EAAE;IAAEf,iBAAiB;IAAEC,IAAI;IAAEC;EAAiB,CAAC;EACzDK,QAAQ,EAAE;IACRS,0BAA0BA,CAAA,EAAG;MAC3B,OACE,IAAI,CAACC,SAAS,CAACC,oBAAoB,CAACC,MAAK,IACzC,IAAI,CAACF,SAAS,CAACG,kBAAiB;IAEpC,CAAC;IACDC,yBAAyBA,CAAA,EAAG;MAC1B,MAAMC,QAAO,GAAI,IAAI,CAACC,UAAU,CAACC,IAAI,CAClCF,QAAQ,IAAKA,QAAQ,