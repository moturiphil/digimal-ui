{"ast":null,"code":"import { ref, defineComponent } from 'vue';\nimport VueTypes from 'vue-types';\nimport { TabBasic, Child } from './Style';\nexport default defineComponent({\n  name: 'Tab',\n  components: {\n    TabBasic,\n    Child\n  },\n  props: {\n    color: VueTypes.string,\n    tabPosition: VueTypes.oneOf(['top', 'right', 'bottom', 'left']).def('top'),\n    data: VueTypes.arrayOf(VueTypes.object)\n  },\n  setup() {\n    return {\n      activeKey: ref(1)\n    };\n  }\n});","map":{"version":3,"names":["ref","defineComponent","VueTypes","TabBasic","Child","name","components","props","color","string","tabPosition","oneOf","def","data","arrayOf","object","setup","activeKey"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/components/tabs/Tabs.vue"],"sourcesContent":["<template>\r\n  <TabBasic\r\n    v-model:activeKey=\"activeKey\"\r\n    :color=\"color && color\"\r\n    :tabPosition=\"tabPosition !== undefined ? tabPosition : 'top'\"\r\n  >\r\n    <Child v-for=\"(item, index) in data\" :key=\"index + 1\" :color=\"color && color\">\r\n      <template #tab>\r\n        <span v-if=\"item.icon && item.icon !== 'undefined'\">\r\n          <sdFeatherIcons :type=\"item.icon\" size=\"18\" />\r\n          {{ item.tabTitle }}\r\n        </span>\r\n        <span v-if=\"!item.icon\">\r\n          {{ item.tabTitle }}\r\n        </span>\r\n      </template>\r\n      <h2>{{ item.title }}</h2>\r\n      <p>{{ item.content }}</p>\r\n    </Child>\r\n  </TabBasic>\r\n</template>\r\n\r\n<script>\r\nimport { ref, defineComponent } from 'vue';\r\nimport VueTypes from 'vue-types';\r\nimport { TabBasic, Child } from './Style';\r\nexport default defineComponent({\r\n  name: 'Tab',\r\n  components: { TabBasic, Child },\r\n  props: {\r\n    color: VueTypes.string,\r\n    tabPosition: VueTypes.oneOf(['top', 'right', 'bottom', 'left']).def('top'),\r\n    data: VueTypes.arrayOf(VueTypes.object),\r\n  },\r\n  setup() {\r\n    return {\r\n      activeKey: ref(1),\r\n    };\r\n  },\r\n})