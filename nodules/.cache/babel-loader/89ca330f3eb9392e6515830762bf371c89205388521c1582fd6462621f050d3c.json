{"ast":null,"code":"import \"ant-design-vue/es/notification/style\";\nimport _notification from \"ant-design-vue/es/notification\";\nimport \"core-js/modules/es.array.push.js\";\nimport { computed, ref, reactive } from \"vue\";\n// import { mapState } from 'vuex'\nimport AuthService from \"../../services/auth.service\";\nimport { useRouter } from \"vue-router\";\n// import { useStore } from 'vuex';\nimport { AuthWrapper } from \"./style\";\nimport store from \"../../vuex/store\";\nexport default {\n  name: \"SignIn\",\n  components: {\n    AuthWrapper\n  },\n  setup() {\n    // console.log(store.state.auth);\n    const isLoading = computed(() => store.state.auth.loading);\n    // console.log(isLoading);\n    const checked = ref(null);\n    const router = useRouter();\n    // console.log(store.state);\n    const formState = reactive({\n      id_no: \"\",\n      password: \"\"\n    });\n    const handleSubmit = async () => {\n      const response = await AuthService.login({\n        id_no: formState.id_no,\n        password: formState.password\n      });\n      console.log(response.data.user);\n      sessionStorage.setItem(\"auth-user\", response.data.user);\n      console.log(sessionStorage.getItem(\"user\"));\n      if (response.status == 200) {\n        console.log(response.status);\n        console.log(\"response successful.................\");\n        try {\n          store.commit(\"auth/setUser\", response.data.user);\n          // console.log(store)\n          router.push({\n            path: \"/\"\n          });\n          console.log(\"...............auth-user................\");\n          _notification.success({\n            message: \"Login Successful\",\n            description: \"Welcome to Campaign Dashboard\"\n          });\n        } catch (e) {\n          console.log(e);\n        }\n      } else if (response.status == 401) {\n        // new code to display error notification\n        // console.log(response.status);\n        console.log('other error responses');\n        _notification.error({\n          message: \"Login Failed\",\n          description: \"Invalid Credentials\"\n        });\n      }\n    };\n    return {\n      isLoading,\n      checked,\n      handleSubmit,\n      formState,\n      // new computed properties to access the error state from the store\n      isError: computed(() => store.state.auth.isError),\n      errorMessage: computed(() => store.state.auth.errorMessage),\n      errorDescription: computed(() => store.state.auth.errorDescription)\n    };\n  }\n};","map":{"version":3,"names":["computed","ref","reactive","AuthService","useRouter","AuthWrapper","store","name","components","setup","isLoading","state","auth","loading","checked","router","formState","id_no","password","handleSubmit","response","login","console","log","data","user","sessionStorage","setItem","getItem","status","commit","push","path","_notification","success","message","description","e","error","isError","errorMessage","errorDescription"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/authentication/SignIn.vue"],"sourcesContent":["<template>\r\n  <AuthWrapper>\r\n    <p class=\"auth-notice\">Don&rsquo;t have an account? Contact Admin</p>\r\n    <div class=\"auth-contents\">\r\n      <a-form @finish=\"handleSubmit\" :model=\"formState\" layout=\"vertical\">\r\n        <sdHeading as=\"h3\">\r\n          Sign in to <span class=\"color-success\">DigiMal KE Dashboard</span>\r\n        </sdHeading>\r\n        <a-form-item name=\"id_no\" label=\"National ID No\">\r\n          <a-input type=\"number\" v-model:value=\"formState.id_no\"  placeholder=\"Enter ID No\"/>\r\n        </a-form-item>\r\n        <a-form-item name=\"password\" initialValue=\"\" label=\"Password\">\r\n          <a-input\r\n            type=\"password\"\r\n            v-model:value=\"formState.password\"\r\n            placeholder=\"Password\"\r\n          />\r\n        </a-form-item>\r\n        <div class=\"auth-form-action\">\r\n          <a-checkbox v-model=\"checked\" @change=\"onChange\"\r\n            >Keep me logged in</a-checkbox\r\n          >\r\n          <router-link class=\"forgot-pass-link\" to=\"/auth/register\">\r\n\r\n            New User?\r\n          </router-link>\r\n        </div>\r\n        <a-form-item>\r\n          <sdButton\r\n            class=\"btn-signin\"\r\n            htmlType=\"submit\"\r\n            :loading=\"isLoading\"\r\n            type=\"success\"\r\n            size=\"large\"\r\n          >\r\n            Sign In\r\n          </sdButton>\r\n        </a-form-item>\r\n        <p class=\"form-divider\"></p>\r\n      </a-form>\r\n      <!-- implement the notification if user is not authorized -->\r\n      <a-notification\r\n        v-if=\"isError\"\r\n        :message=\"errorMessage\"\r\n        type=\"error\"\r\n        :description=\"errorDescription\"\r\n        :showIcon=\"true\"\r\n        :duration=\"0\"\r\n        :style=\"{ width: '100%' }\"\r\n      />\r\n    </div>\r\n  </AuthWrapper>\r\n</template>\r\n<script>\r\nimport { computed, ref, reactive } from \"vue\";\r\n// import { mapState } from 'vuex'\r\nimport AuthService from \"../../services/auth.service\";\r\nimport { useRouter } from \"vue-router\";\r\n// import { useStore } from 'vuex';\r\nimport { AuthWrapper } from \"./style\";\r\nimport store from \"../../vuex/store\";\r\nimport { notification } from \"ant-design-vue\";\r\nexport default {\r\n  name: \"SignIn\",\r\n  components: { AuthWrapper },\r\n  setup() {\r\n    // console.log(store.state.auth);\r\n    const isLoading = computed(() => store.state.auth.loading);\r\n    // console.log(isLoading);\r\n    const checked = ref(null);\r\n    const router = useRouter();\r\n    // console.log(store.state);\r\n    const formState = reactive({\r\n      id_no: \"\",\r\n      password: \"\",\r\n    });\r\n    \r\n    const handleSubmit = async () => {\r\n      const response = await AuthService.login({\r\n        id_no: formState.id_no,\r\n        password: formState.password,\r\n      });\r\n      console.log(response.data.user);\r\n      sessionStorage.setItem(\"auth-user\", response.data.user);\r\n      console.log(sessionStorage.getItem(\"user\"));\r\n      if (response.status == 200) {\r\n        console.log(response.status);\r\n        console.log(\"response successful.................\");\r\n\r\n        try {\r\n          store.commit(\"auth/setUser\", response.data.user);\r\n          // console.log(store)\r\n          router.push({ path: \"/\" });\r\n          console.log(\"...............auth-user................\");\r\n          notification.success({\r\n            message: \"Login Successful\",\r\n            description: \"Welcome to Campaign Dashboard\",\r\n          });\r\n        } catch (e) {\r\n          console.log(e);\r\n        }\r\n      } else if (response.status == 401) {\r\n        // new code to display error notification\r\n        // console.log(response.status);\r\n        console.log('other error responses');\r\n        notification.error({\r\n          message: \"Login Failed\",\r\n          description: \"Invalid Credentials\",\r\n        });\r\n      }\r\n    };\r\n\r\n    return {\r\n      isLoading,\r\n      checked,\r\n      handleSubmit,\r\n      formState,\r\n      // new computed properties to access the error state from the store\r\n      isError: computed(() => store.state.auth.isError),\r\n      errorMessage: computed(() => store.state.auth.errorMessage),\r\n      errorDescription: computed(() => store.state.auth.errorDescription),\r\n    };\r\n  },\r\n};\r\n</script>\r\n"],"mappings":";;;AAsDA,SAASA,QAAQ,EAAEC,GAAG,EAAEC,QAAO,QAAS,KAAK;AAC7C;AACA,OAAOC,WAAU,MAAO,6BAA6B;AACrD,SAASC,SAAQ,QAAS,YAAY;AACtC;AACA,SAASC,WAAU,QAAS,SAAS;AACrC,OAAOC,KAAI,MAAO,kBAAkB;AAEpC,eAAe;EACbC,IAAI,EAAE,QAAQ;EACdC,UAAU,EAAE;IAAEH;EAAY,CAAC;EAC3BI,KAAKA,CAAA,EAAG;IACN;IACA,MAAMC,SAAQ,GAAIV,QAAQ,CAAC,MAAMM,KAAK,CAACK,KAAK,CAACC,IAAI,CAACC,OAAO,CAAC;IAC1D;IACA,MAAMC,OAAM,GAAIb,GAAG,CAAC,IAAI,CAAC;IACz