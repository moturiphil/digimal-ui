{"ast":null,"code":"import \"ant-design-vue/es/notification/style\";\nimport _notification from \"ant-design-vue/es/notification\";\nimport \"core-js/modules/es.array.push.js\";\nimport { RecordFormWrapper } from \"../style\";\nimport { Main, BasicFormWrapper } from \"../../styled\";\nimport { useStore } from \"vuex\";\nimport { reactive, ref, defineComponent, computed, onMounted } from \"vue\";\n// import axios from \"axios\";\n\nimport authHeader from \"../../../services/auth-header\";\nimport { useRouter } from \"vue-router\";\nimport { useRoute } from \"vue-router\";\nconst dateFormat = \"YYYY-MM-DD\";\nconst AddNew = defineComponent({\n  name: \"AddNew\",\n  components: {\n    RecordFormWrapper,\n    Main,\n    BasicFormWrapper\n  },\n  data() {\n    const {\n      state\n    } = useStore();\n    const isLoading = computed(() => state.crud.loading);\n    const apiUrl = computed(() => state.crud.url);\n    const isFileLoading = computed(() => state.crud.fileLoading);\n    const join = ref(\"\");\n    const API_URL = `${process.env.VUE_APP_BASE_URL}/add_post_workers`;\n    const router = useRouter();\n    const {\n      query\n    } = useRoute();\n    const parameters = {\n      query\n    };\n    const post_id = parameters.query.id;\n\n    // console.log(parameters);\n    console.log(post_id);\n    const formState = reactive({\n      post_id: \"\",\n      number_of_nets: \"\",\n      date_received: \"\",\n      received_from: \"\",\n      received_by: []\n    });\n    const {\n      villages,\n      loading,\n      isFacility,\n      users,\n      posts\n    } = reactive({\n      villages: [],\n      loading: true,\n      isFacility: false,\n      users: [],\n      posts: []\n    });\n\n    //get posts\n    const getPosts = async () => {\n      const response = await fetch(`${process.env.VUE_APP_BASE_URL}/posts_data`, {\n        method: \"GET\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          ...authHeader()\n        }\n      });\n      const data = await response.json();\n      console.log(data.data);\n      this.posts = data.data;\n      // this.posts = data.map((post) => ({\n      //   ...post,\n      // }));\n      this.loading = false;\n    };\n\n    //counties\n    const getVillages = async () => {\n      const response = await fetch(`${process.env.VUE_APP_BASE_URL}/villages/list`, {\n        method: \"GET\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          ...authHeader()\n        }\n      });\n      const data = await response.json();\n      console.log(data);\n      this.villages = data.data;\n      this.loading = false;\n    };\n\n    //users\n    const getUsers = async () => {\n      const response = await fetch(`${process.env.VUE_APP_BASE_URL}/users`, {\n        method: \"GET\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          ...authHeader()\n        }\n      });\n      const data = await response.json();\n      this.users = data.data;\n    };\n    onMounted(() => {\n      getUsers();\n      getVillages();\n      getPosts();\n    });\n    // console.log(formState.isFacility)\n    const handleSubmit = values => {\n      values = {\n        post_id: values.post_id,\n        workers: values.received_by\n      };\n      values.post_id = post_id;\n      const workersProxy = values.workers;\n      const workersArray = Object.values(workersProxy); // [2, 4]\n\n      console.log(workersArray);\n      values.workers = workersArray;\n      console.log(values);\n      fetch(API_URL, {\n        method: \"POST\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          ...authHeader()\n        },\n        body: JSON.stringify(values)\n      }).then(response => response.json()).then(({\n        status,\n        data\n      }) => {\n        console.log(data);\n        if (status) {\n          router.push(\"/nets/distribution\");\n          _notification[\"success\"]({\n            message: \"Post Workers Added\",\n            description: \"Post Workers have been successfully assigner\",\n            duration: 5.5\n          });\n        }\n      }).catch(error => {\n        console.error(\"Error:\", error);\n      });\n    };\n    return {\n      isLoading,\n      loading,\n      apiUrl,\n      isFileLoading,\n      isFacility,\n      handleSubmit,\n      dateFormat,\n      formState,\n      join,\n      villages,\n      posts,\n      users\n    };\n  },\n  beforeRouteEnter(to, from, next) {\n    if (!sessionStorage.getItem(\"user\")) {\n      next(\"/auth/login\");\n    } else {\n      next();\n    }\n  }\n});\nexport default AddNew;","map":{"version":3,"names":["RecordFormWrapper","Main","BasicFormWrapper","useStore","reactive","ref","defineComponent","computed","onMounted","authHeader","useRouter","useRoute","dateFormat","AddNew","name","components","data","state","isLoading","crud","loading","apiUrl","url","isFileLoading","fileLoading","join","API_URL","process","env","VUE_APP_BASE_URL","router","query","parameters","post_id","id","console","log","formState","number_of_nets","date_received","received_from","received_by","villages","isFacility","users","posts","getPosts","response","fetch","method","headers","json","getVillages","getUsers","handleSubmit","values","workers","workersProxy","workersArray","Object","body","JSON","stringify","then","status","push","_notification","message","description","duration","catch","error","beforeRouteEnter","to","from","next","sessionStorage","getItem"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/pages/net-distribution/AssignWorker.vue"],"sourcesContent":["<template>\n  <sdPageHeader title=\"Assign Worker\">\n    <sdButton class=\"btn-add_new\" size=\"default\" key=\"1\" type=\"success\">\n      <router-link to=\"/crud/axios-view\">View All</router-link>\n    </sdButton>\n  </sdPageHeader>\n  <Main>\n    <a-row :gutter=\"15\">\n      <a-col :xs=\"24\">\n        <RecordFormWrapper>\n          <sdCards headless>\n            <a-row justify=\"center\">\n              <a-col :xl=\"10\" :md=\"16\" :xs=\"24\">\n                <BasicFormWrapper>\n                  <a-form\n                    class=\"add-record-form\"\n                    :style=\"{ width: '100%' }\"\n                    layout=\"vertical\"\n                    name=\"addnew\"\n                    :model=\"formState\"\n                    @finish=\"handleSubmit\"\n                  >\n                    <!-- <a-form-item name=\"post_id\" label=\"Post Name\">\n                      <a-select\n                        size=\"large\"\n                        name=\"basic-select\"\n                        class=\"sDash_fullwidth-select\"\n                        placeholder=\"Select Post\"\n                        v-model:value=\"formState.post_id\"\n                      >\n                        <a-select-option\n                          v-for=\"post in posts\"\n                          :value=\"post.id\"\n                          :key=\"post.id\"\n                          >{{ post.name }}</a-select-option\n                        >\n                      </a-select>\n                    </a-form-item> -->\n                    <a-form-item name=\"received_by\" label=\"Post Workers\">\n                      <a-select\n                        mode=\"multiple\"\n                        v-model:value=\"formState.received_by\"\n                        v-if=\"!loading\"\n                        placeholder=\"Select post workers\"\n                      >\n                        <a-select-option\n                          v-for=\"worker in users\"\n                          :key=\"worker.id\"\n                          :value=\"worker.id\"\n                        >\n                          {{ worker.first_name }}\n                          {{ worker.last_name }} - {{ worker.role_id }}\n                        </a-select-option>\n                      </a-select>\n                    </a-form-item>\n\n                    <div class=\"record-form-actions text-right\">\n                      <sdButton size=\"default\" htmlType=\"Save\" type=\"success\">\n                        {{ isLoading ? \"Loading...\" : \"Submit\" }}\n                      </sdButton>\n                    </div>\n                  </a-form>\n                </BasicFormWrapper>\n              </a-col>\n            </a-row>\n          </sdCards>\n        </RecordFormWrapper>\n      </a-col>\n    </a-row>\n  </Main>\n</template>\n<script>\nimport { RecordFormWrapper } from \"../style\";\nimport { Main, BasicFormWrapper } from \"../../styled\";\nimport { useStore } from \"vuex\";\nimport { reactive, ref, defineComponent, computed, onMounted } from \"vue\";\n// import axios from \"axios\";\nimport { notification } from \"ant-design-vue\";\nimport authHeader from \"../../../services/auth-header\";\nimport { useRouter } from \"vue-router\";\nimport { useRoute } from \"vue-router\";\n\nconst dateFormat = \"YYYY-MM-DD\";\n\nconst AddNew = defineComponent({\n  name: \"AddNew\",\n  components: { RecordFormWrapper, Main, BasicFormWrapper },\n  data() {\n    const { state } = useStore();\n    const isLoading = computed(() => state.crud.loading);\n    const apiUrl = computed(() => state.crud.url);\n    const isFileLoading = computed(() => state.crud.fileLoading);\n    const join = ref(\"\");\n    const API_URL = `${process.env.VUE_APP_BASE_URL}/add_post_workers`;\n    const router = useRouter();\n    const { query } = useRoute();\n\n    const parameters = { query };\n\n    const post_id = parameters.query.id;\n\n    // console.log(parameters);\n    console.log(post_id);\n\n    const formState = reactive({\n      post_id: \"\",\n      number_of_nets: \"\",\n      date_received: \"\",\n      received_from: \"\",\n      received_by: [],\n    });\n\n    const { villages, loading, isFacility, users, posts } = reactive({\n      villages: [],\n      loading: true,\n      isFacility: false,\n      users: [],\n      posts: [],\n    });\n\n    //get posts\n    const getPosts = async () => {\n      const response = await fetch(\n        `${process.env.VUE_APP_BASE_URL}/posts_data`,\n        {\n          method: \"GET\",\n          headers: {\n            \"Content-Type\": \"application/json\",\n            ...authHeader(),\n          },\n        }\n      );\n      const data = await response.json();\n      console.log(data.data);\n      this.posts = data.data;\n      // this.posts = data.map((post) => ({\n      //   ...post,\n      // }));\n      this.loading = false;\n    };\n\n    //counties\n    const getVillages = async () => {\n      const response = await fetch(\n        `${process.env.VUE_APP_BASE_URL}/villages/list`,\n        {\n          method: \"GET\",\n          headers: {\n            \"Content-Type\": \"application/json\",\n            ...authHeader(),\n          },\n        }\n      );\n      const data = await response.json();\n      console.log(data);\n      this.villages = data.data;\n      this.loading = false;\n    };\n\n    //users\n    const getUsers = async () => {\n      const response = await fetch(`${process.env.VUE_APP_BASE_URL}/users`, {\n        method: \"GET\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          ...authHeader(),\n        },\n      });\n      const data = await response.json();\n      this.users = data.data;\n    };\n\n    onMounted(() => {\n      getUsers();\n      getVillages();\n      getPosts();\n    });\n    // console.log(formState.isFacility)\n    const handleSubmit = (values) => {\n      values = {\n        post_id: values.post_id,\n        workers: values.received_by,\n      };\n\n      values.post_id = post_id;\n\n      const workersProxy = values.workers;\n      const workersArray = Object.values(workersProxy); // [2, 4]\n\n      console.log(workersArray);\n\n      values.workers = workersArray;\n\n      console.log(values);\n\n      fetch(API_URL, {\n        method: \"POST\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          ...authHeader(),\n        },\n        body: JSON.stringify(values),\n      })\n        .then((response) => response.json())\n        .then(({ status, data }) => {\n          console.log(data);\n          if (status) {\n            router.push(\"/nets/distribution\");\n            notification[\"success\"]({\n              message: \"Post Workers Added\",\n              description: \"Post Workers have been successfully assigner\",\n              duration: 5.5,\n            });\n          }\n        })\n        .catch((error) => {\n          console.error(\"Error:\", error);\n        });\n    };\n\n    return {\n      isLoading,\n      loading,\n      apiUrl,\n      isFileLoading,\n      isFacility,\n      handleSubmit,\n      dateFormat,\n      formState,\n      join,\n      villages,\n      posts,\n      users,\n    };\n  },\n  beforeRouteEnter(to, from, next) {\n    if (!sessionStorage.getItem(\"user\")) {\n      next(\"/auth/login\");\n    } else {\n      next();\n    }\n  },\n});\n\nexport default AddNew;\n</script>\n"],"mappings":";;;AAwEA,SAASA,iBAAgB,QAAS,UAAU;AAC5C,SAASC,IAAI,EAAEC,gBAAe,QAAS,cAAc;AACrD,SAASC,QAAO,QAAS,MAAM;AAC/B,SAASC,QAAQ,EAAEC,GAAG,EAAEC,eAAe,EAAEC,QAAQ,EAAEC,SAAQ,QAAS,KAAK;AACzE;;AAEA,OAAOC,UAAS,MAAO,+BAA+B;AACtD,SAASC,SAAQ,QAAS,YAAY;AACtC,SAASC,QAAO,QAAS,YAAY;AAErC,MAAMC,UAAS,GAAI,YAAY;AAE/B,MAAMC,MAAK,GAAIP,eAAe,CAAC;EAC7BQ,IAAI,EAAE,QAAQ;EACdC,UAAU,EAAE;IAAEf,iBAAiB;IAAEC,IAAI;IAAEC;EAAiB,CAAC;EACzDc,IAAIA,CAAA,EAAG;IACL,MAAM;MAAEC;IAAM,IAAId,QAAQ,EAAE;IAC5B,MAAMe,SAAQ,GAAIX,QAAQ,CAAC,MAAMU,KAAK,CAACE,IAAI,CAACC,OAAO,CAAC;IACpD,MAAMC,MAAK,GAAId,QAAQ,CAAC,MAAMU,KAAK,CAACE,IAAI,CAACG,GAAG,CAAC;IAC7C,MAAMC,aAAY,GAAIhB,QAAQ,CAAC,MAAMU,KAAK,CAACE,IAAI,CAACK,WAAW,CAAC;IAC5D,MAAMC,IAAG,GAAIpB,GAAG,CAAC,EAAE,CAAC;IACpB,MAAMqB,OAAM,GAAK,GAAEC,OAAO,CAACC,GAAG,CAACC,gBAAiB,mBAAkB;IAClE,MAAMC,MAAK,GAAIpB,SAAS,EAAE;IAC1B,MAAM;MAAEqB;IAAM,IAAIpB,QAAQ,EAAE;IAE5B,MAAMqB,UAAS,GAAI;MAAED;IA