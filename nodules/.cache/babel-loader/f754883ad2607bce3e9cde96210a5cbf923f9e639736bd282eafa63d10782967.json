{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { computed, ref, reactive, onMounted } from \"vue\";\n// import { mapState } from 'vuex'\nimport AuthService from \"../../services/auth.service\";\nimport { useRouter } from \"vue-router\";\nimport { AuthWrapper } from \"./style\";\nimport store from \"../../vuex/store\";\nexport default {\n  name: \"SignIn\",\n  components: {\n    AuthWrapper\n  },\n  setup() {\n    // console.log(store.state.auth);\n    const isLoading = computed(() => store.state.auth.loading);\n    // console.log(isLoading);\n    const checked = ref(null);\n    const router = useRouter();\n    // console.log(store.state);\n    const formState = reactive({\n      id_no: \"\",\n      password: \"\"\n    });\n    const handleSubmit = async () => {\n      const response = await AuthService.login({\n        id_no: formState.id_no,\n        password: formState.password\n      });\n      if (response.data.token) {\n        localStorage.setItem(\"user\", JSON.stringify(response.data.token));\n        store.dispatch(\"auth/login\", {\n          user: {\n            id_no: formState.id_no,\n            password: formState.password\n          }\n        });\n        router.push({\n          path: \"/campaigns/create\"\n        });\n        // .then(() => {\n        //   router.push({ path: \"/dashboard/home\" });\n        // });\n      }\n    };\n\n    const status = computed(() => store.state.auth.status);\n    onMounted(() => {\n      if (status.value.loggedIn) {\n        console.log(\"logged in\", status.value.loggedIn);\n        router.push({\n          path: \"/campaigns/create\"\n        });\n      }\n    });\n    return {\n      isLoading,\n      checked,\n      handleSubmit,\n      formState\n    };\n  }\n};","map":{"version":3,"names":["computed","ref","reactive","onMounted","AuthService","useRouter","AuthWrapper","store","name","components","setup","isLoading","state","auth","loading","checked","router","formState","id_no","password","handleSubmit","response","login","data","token","localStorage","setItem","JSON","stringify","dispatch","user","push","path","status","value","loggedIn","console","log"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/authentication/TestFile.vue"],"sourcesContent":["<template>\n    <AuthWrapper>\n      <p class=\"auth-notice\">\n        Don&rsquo;t have an account?\n        <router-link to=\"/auth/register\">Sign up now</router-link>\n      </p>\n      <div class=\"auth-contents\">\n        <a-form @finish=\"handleSubmit\" :model=\"formState\" layout=\"vertical\">\n          <sdHeading as=\"h3\">\n            Sign in to <span class=\"color-success\">Campaign Dashboard</span>\n          </sdHeading>\n          <a-form-item name=\"id_no\" label=\"ID No\">\n            <a-input type=\"number\" v-model:value=\"formState.id_no\" />\n          </a-form-item>\n          <a-form-item name=\"password\" initialValue=\"admin123\" label=\"Password\">\n            <a-input\n              type=\"password\"\n              v-model:value=\"formState.password\"\n              placeholder=\"Password\"\n            />\n          </a-form-item>\n          <div class=\"auth-form-action\">\n            <a-checkbox v-model=\"checked\" @change=\"onChange\"\n              >Keep me logged in</a-checkbox\n            >\n            <router-link class=\"forgot-pass-link\" to=\"/auth/forgotPassword\">\n              Forgot password?\n            </router-link>\n          </div>\n          <a-form-item>\n            <sdButton\n              class=\"btn-signin\"\n              htmlType=\"submit\"\n              :loading=\"isLoading\"\n              type=\"success\"\n              size=\"large\"\n            >\n              Sign In\n            </sdButton>\n          </a-form-item>\n          <p class=\"form-divider\"></p>\n        </a-form>\n      </div>\n    </AuthWrapper>\n  </template>\n  <script>\n  import { computed, ref, reactive, onMounted } from \"vue\";\n  // import { mapState } from 'vuex'\n  import AuthService from \"../../services/auth.service\";\n  import { useRouter } from \"vue-router\";\n  import { AuthWrapper } from \"./style\";\n  import store from \"../../vuex/store\";\n  export default {\n    name: \"SignIn\",\n    components: { AuthWrapper },\n    setup() {\n      // console.log(store.state.auth);\n      const isLoading = computed(() => store.state.auth.loading);\n      // console.log(isLoading);\n      const checked = ref(null);\n      const router = useRouter();\n      // console.log(store.state);\n      const formState = reactive({\n        id_no: \"\",\n        password: \"\",\n      });\n      const handleSubmit = async () => {\n        const response = await AuthService.login({\n          id_no: formState.id_no,\n          password: formState.password,\n        });\n        if ( response.data.token) {\n          localStorage.setItem(\"user\", JSON.stringify(response.data.token));\n          store\n            .dispatch(\"auth/login\", {\n              user: {\n                id_no: formState.id_no,\n                password: formState.password,\n              },\n            })\n            router.push({ path: \"/campaigns/create\" });\n            // .then(() => {\n            //   router.push({ path: \"/dashboard/home\" });\n            // });\n        }\n      };\n      const status = computed(() => store.state.auth.status);\n      onMounted(() => {\n        if (status.value.loggedIn) {\n          console.log(\"logged in\", status.value.loggedIn);\n          router.push({ path: \"/campaigns/create\" });\n        }\n      });\n      return {\n        isLoading,\n        checked,\n        handleSubmit,\n        formState,\n      };\n    },\n  };\n  </script>"],"mappings":";AA8CE,SAASA,QAAQ,EAAEC,GAAG,EAAEC,QAAQ,EAAEC,SAAQ,QAAS,KAAK;AACxD;AACA,OAAOC,WAAU,MAAO,6BAA6B;AACrD,SAASC,SAAQ,QAAS,YAAY;AACtC,SAASC,WAAU,QAAS,SAAS;AACrC,OAAOC,KAAI,MAAO,kBAAkB;AACpC,eAAe;EACbC,IAAI,EAAE,QAAQ;EACdC,UAAU,EAAE;IAAEH;EAAY,