{"ast":null,"code":"import axios from \"axios\";\nimport authHeader from \"../../../services/auth-header\";\nimport { useRoute } from \"vue-router\";\nexport default {\n  name: \"ActivitySummary\",\n  data() {\n    return {\n      data: [],\n      activity: \"\",\n      perdiem: 0,\n      promoCode: \"\",\n      formState: {\n        layout: \"horizontal\"\n      },\n      current: 0\n    };\n  },\n  methods: {\n    submitPromo(e) {\n      e.preventDefault();\n    },\n    onSubmit() {\n      this.$emit(\"submit\", this.data);\n    }\n  },\n  mounted() {\n    const {\n      params,\n      query\n    } = useRoute();\n    console.log({\n      params,\n      query\n    });\n    const API_URL = `${process.env.VUE_APP_BASE_URL}/payroll_detail?payroll_list_id=${query.id}`;\n    axios.get(API_URL, {\n      headers: authHeader()\n    }).then(response => {\n      this.data = response.data.data;\n      const activityElement = document.querySelector(\".activity:nth-of-type(1) + .amount\");\n      activityElement.textContent = this.data[0].item;\n      this.perdiem = this.data.reduce((total, item) => {\n        if (item.item === \"Perdiem for National Officers - Cities\") {\n          return total + item.amount;\n        } else {\n          return total;\n        }\n      }, 0);\n      const perdiemElement = document.querySelector(\".activity:nth-of-type(2) + .amount\");\n      perdiemElement.textContent = this.perdiem;\n    }).catch(error => {\n      console.error(error);\n    });\n  }\n};","map":{"version":3,"names":["axios","authHeader","useRoute","name","data","activity","perdiem","promoCode","formState","layout","current","methods","submitPromo","e","preventDefault","onSubmit","$emit","mounted","params","query","console","log","API_URL","process","env","VUE_APP_BASE_URL","id","get","headers","then","response","activityElement","document","querySelector","textContent","item","reduce","total","amount","perdiemElement","catch","error"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/pages/payroll/PaySummary.vue"],"sourcesContent":["<template>\n  <div class=\"activity-summary-inner\">\n    <br />\n    <sdHeading class=\"summary-total\" as=\"h4\">\n      <span class=\"activity\">Activity : </span>\n      <span class=\"amount\">{{ activity }}</span>\n    </sdHeading>\n    <br />\n    <sdHeading class=\"summary-total\" as=\"h4\">\n      <span class=\"activity\">Perdiem : </span>\n      <span class=\"amount\">{{ perdiem }}</span>\n    </sdHeading>\n    <br />\n    <br />\n    <a-form\n      :layout=\"formState.layout\"\n      :model=\"formState\"\n      :onFinish=\"submitPromo\"\n    >\n      <div class=\"promo-apply-form\">\n        <a-form-item name=\"promoCode\" label=\"Comments\">\n          <a-input v-model:value=\"promoCode\" placeholder=\"Comment\" />\n        </a-form-item>\n        <a-form-item>\n          <sdButton htmlType=\"submit\" size=\"default\" type=\"success\" outlined>\n            Approve\n          </sdButton>\n          &nbsp;&nbsp;\n          <sdButton htmlType=\"submit\" size=\"default\" type=\"danger\" outlined>\n            Decline\n          </sdButton>\n        </a-form-item>\n      </div>\n    </a-form>\n    <sdButton\n      v-if=\"current === 3\"\n      @click=\"onSubmit\"\n      class=\"btn-proceed\"\n      type=\"secondary\"\n      size=\"large\"\n    >\n      <a to=\"#\">Place Order</a>\n    </sdButton>\n  </div>\n</template>\n\n<script>\nimport axios from \"axios\";\nimport authHeader from \"../../../services/auth-header\";\nimport { useRoute } from \"vue-router\";\n\n\nexport default {\n  name: \"ActivitySummary\",\n  data() {\n    return {\n      data: [],\n      activity: \"\",\n      perdiem: 0,\n      promoCode: \"\",\n      formState: {\n        layout: \"horizontal\",\n      },\n      current: 0,\n    };\n  },\n  methods: {\n    submitPromo(e) {\n      e.preventDefault();\n    },\n    onSubmit() {\n      this.$emit(\"submit\", this.data);\n    },\n  },\n  mounted() {\n    const { params, query } = useRoute();\n      console.log({params, query});\n    const API_URL = `${process.env.VUE_APP_BASE_URL}/payroll_detail?payroll_list_id=${query.id}`;\n\n    axios\n      .get(API_URL, {\n        headers: authHeader(),\n      })\n      .then((response) => {\n        this.data = response.data.data;\n\n        const activityElement = document.querySelector(\n          \".activity:nth-of-type(1) + .amount\"\n        );\n        activityElement.textContent = this.data[0].item;\n\n        this.perdiem = this.data.reduce((total, item) => {\n          if (item.item === \"Perdiem for National Officers - Cities\") {\n            return total + item.amount;\n          } else {\n            return total;\n          }\n        }, 0);\n\n        const perdiemElement = document.querySelector(\n          \".activity:nth-of-type(2) + .amount\"\n        );\n        perdiemElement.textContent = this.perdiem;\n      })\n      .catch((error) => {\n        console.error(error);\n      });\n  },\n};\n</script>\n"],"mappings":"AA+CA,OAAOA,KAAI,MAAO,OAAO;AACzB,OAAOC,UAAS,MAAO,+BAA+B;AACtD,SAASC,QAAO,QAAS,YAAY;AAGrC,eAAe;EACbC,IAAI,EAAE,iBAAiB;EACvBC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLA,IAAI,EAAE,EAAE;MACRC,QAAQ,EAAE,EAAE;MACZC,OAAO,EAAE,CAAC;MACVC,SAAS,EAAE,EAAE;MACbC,SAAS,EAAE;QACTC,MAAM,EAAE;MACV,CAAC;MACDC,OAAO,EAAE;IACX,CAAC;EACH,CAAC;EACDC,OAAO,EAAE;IACPC,WAAWA,CAACC,CAAC,EAAE;MACbA,CAAC,CAACC,cAAc,EAAE;IACpB,CAAC;IACDC,QAAQA,CAAA,EAAG;MACT,IAAI,CAACC,KAAK,CAAC,QAAQ,EAAE,IAAI,CAACZ,IAAI,CAAC;IACjC;EACF,CAAC;EACDa,OAAOA,CAAA,EAAG;IACR,MAAM;MAAEC,MAAM;MAAEC;IAAM,IAAIjB,QAAQ,EAAE;IAClCkB,OAAO,CAACC,GAAG,CAAC;MAACH,MAAM;MAAEC;IAAK,CAAC,CAAC;IAC9B,MAAMG,OAAM,GAAK,GAAEC,OAAO,CAACC,GAAG,CAACC,gBAAiB,mCAAkCN,KAAK,CAACO,EAAG,EAAC;IAE5F1B,KAAI,CACD2B,GAAG,CAACL,OAAO,EAAE;MACZM,OAAO,EAAE3B,UAAU;IACrB,CAAC,EACA4B,IAAI,CAAEC,QAAQ,IAAK;MAClB,IAAI,CAAC1B,IAAG,GAAI0B,QAAQ,CAAC1B,IAAI,CAACA,IAAI;MAE9B,MAAM2B,eAAc,GAAIC,QAAQ,CAACC,aAAa,CAC5C,oCAAmC,CACpC;MACDF,eAAe,CAACG,WAAU,GAAI,IAAI,CAAC9B,IAAI,CA