{"ast":null,"code":"import { computed, onMounted, defineComponent } from 'vue';\nimport { useRoute, useRouter } from 'vue-router';\nimport { useStore } from 'vuex';\nimport { Main } from '../../../styled';\nimport { ProductDetailsWrapper } from '../Style';\nimport DetailsRight from './overview/DetailsRight';\nconst ProductDetails = defineComponent({\n  name: 'ProductDetails',\n  components: {\n    Main,\n    ProductDetailsWrapper,\n    DetailsRight\n  },\n  setup() {\n    const {\n      state,\n      dispatch\n    } = useStore();\n    const product = computed(() => state.ecommerce.product);\n    const isProductLoading = computed(() => state.ecommerce.isProductLoading);\n    const products = computed(() => product.value && state.ecommerce.products);\n    const filterData = computed(() => products.value.filter(value => {\n      return value.category === product.value[0].category;\n    }));\n    const {\n      params,\n      matched\n    } = useRoute();\n    const {\n      path\n    } = matched;\n    onMounted(() => dispatch('filterSinglePage', {\n      paramsId: parseInt(params.id, 10),\n      currentState: products.value\n    }));\n    const router = useRouter();\n    router.beforeEach(to => {\n      dispatch('filterSinglePage', {\n        paramsId: parseInt(to.params.id, 10),\n        currentState: products.value\n      });\n    });\n    return {\n      product,\n      path,\n      filterData,\n      isProductLoading\n    };\n  }\n});\nexport default ProductDetails;","map":{"version":3,"names":["computed","onMounted","defineComponent","useRoute","useRouter","useStore","Main","ProductDetailsWrapper","DetailsRight","ProductDetails","name","components","setup","state","dispatch","product","ecommerce","isProductLoading","products","value","filterData","filter","category","params","matched","path","paramsId","parseInt","id","currentState","router","beforeEach","to"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/apps/ecommerce/product/ProductDetails.vue"],"sourcesContent":["<template>\r\n  <sdPageHeader title=\"Product Details\"\r\n    ><template v-slot:buttons>\r\n      <div class=\"page-header-actions\">\r\n        <sdCalendarButton />\r\n        <sdExportButton />\r\n        <sdShareButton />\r\n        <sdButton size=\"small\" type=\"primary\">\r\n          <sdFeatherIcons type=\"plus\" size=\"14\" />\r\n          Add New\r\n        </sdButton>\r\n      </div>\r\n    </template>\r\n  </sdPageHeader>\r\n  <Main>\r\n    <sdCards headless>\r\n      <ProductDetailsWrapper v-if=\"product[0]\">\r\n        <div class=\"product-details-box\">\r\n          <a-row :gutter=\"30\">\r\n            <a-col :xs=\"24\" :lg=\"10\">\r\n              <div class=\"product-details-box__left pdbl\">\r\n                <figure>\r\n                  <img\r\n                    :style=\"{ width: '100%' }\"\r\n                    :src=\"product[0] && require(`../../../../${product[0].img}`)\"\r\n                    alt=\"\"\r\n                  />\r\n                </figure>\r\n                <div class=\"pdbl__slider pdbs\">\r\n                  <a-row v-if=\"filterData.length\" :gutter=\"5\">\r\n                    <a-col v-for=\"(value, index) in filterData\" :key=\"value.id\">\r\n                      <div class=\"pdbl__image\" v-if=\"index <= 3\">\r\n                        <figure>\r\n                          <router-link :to=\"`/app/ecommerce/productDetails/${value.id}`\">\r\n                            <img :style=\"{ width: '100%' }\" :src=\"require(`../../../../${value.img}`)\" alt=\"\" />\r\n                          </router-link>\r\n                        </figure>\r\n                      </div>\r\n                    </a-col>\r\n                  </a-row>\r\n                </div>\r\n              </div>\r\n            </a-col>\r\n            <a-col :xs=\"24\" :lg=\"14\">\r\n              <DetailsRight :product=\"product[0]\" />\r\n            </a-col>\r\n          </a-row>\r\n        </div>\r\n      </ProductDetailsWrapper>\r\n      <div v-else class=\"spin\">\r\n        <a-spin />\r\n      </div>\r\n    </sdCards>\r\n  </Main>\r\n</template>\r\n<script>\r\nimport { computed, onMounted, defineComponent } from 'vue';\r\nimport { useRoute, useRouter } from 'vue-router';\r\nimport { useStore } from 'vuex';\r\nimport { Main } from '../../../styled';\r\nimport { ProductDetailsWrapper } from '../Style';\r\nimport DetailsRight from './overview/DetailsRight';\r\n\r\nconst ProductDetails = defineComponent({\r\n  name: 'ProductDetails',\r\n  components: { Main, ProductDetailsWrapper, DetailsRight },\r\n  setup() {\r\n    const { state, dispatch } = useStore();\r\n    const product = computed(() => state.ecommerce.product);\r\n    const isProductLoading = computed(() => state.ecommerce.isProductLoading);\r\n    const products = computed(() => product.value && state.ecommerce.products);\r\n    const filterData = computed(() =>\r\n      products.value.filter((value) => {\r\n        return value.category === product.value[0].category;\r\n      }),\r\n    );\r\n    const { params, matched } = useRoute();\r\n    const { path } = matched;\r\n\r\n    onMounted(() => dispatch('filterSinglePage', { paramsId: parseInt(params.id, 10), currentState: products.value }));\r\n    const router = useRouter();\r\n    router.beforeEach((to) => {\r\n      dispatch('filterSinglePage', { paramsId: parseInt(to.params.id, 10), currentState: products.value });\r\n    });\r\n    return {\r\n      product,\r\n      path,\r\n      filterData,\r\n      isProductLoading,\r\n    };\r\n  },\r\n});\r\n\r\nexport default ProductDetails;\r\n</script>\r\n"],"mappings":"AAwDA,SAASA,QAAQ,EAAEC,SAAS,EAAEC,eAAc,QAAS,KAAK;AAC1D,SAASC,QAAQ,EAAEC,SAAQ,QAAS,YAAY;AAChD,SAASC,QAAO,QAAS,MAAM;AAC/B,SAASC,IAAG,QAAS,iBAAiB;AACtC,SAASC,qBAAoB,QAAS,UAAU;AAChD,OAAOC,YAAW,MAAO,yBAAyB;AAElD,MAAMC,cAAa,GAAIP,eAAe,CAAC;EACrCQ,IAAI,EAAE,gBAAgB;EACtBC,UAAU,EAAE;IAAEL,IAAI;IAAEC,qBAAqB;IAAEC;EAAa,CAAC;EACzDI,KAAKA,CAAA,EAAG;IACN,MAAM;MAAEC,KAAK;MAAEC;