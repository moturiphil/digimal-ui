{"ast":null,"code":"import { AccountWrapper } from \"./style\";\nimport { BasicFormWrapper } from \"../../../styled\";\nimport { reactive, defineComponent } from \"vue\";\nconst Account = defineComponent({\n  name: \"Account\",\n  components: {\n    AccountWrapper,\n    BasicFormWrapper\n  },\n  data() {\n    const name = \"clayton\";\n    const formState = reactive({\n      username: name,\n      email: \"contact@example.com\"\n    });\n    const handleFinish = values => {\n      this.values = {\n        ...values\n      };\n      console.log(values, formState);\n    };\n    const handleFinishFailed = errors => {\n      console.log(errors);\n    };\n    return {\n      name,\n      values: null,\n      formState,\n      handleFinish,\n      handleFinishFailed\n      // form: this.$form.createForm(this, { name: \"account\" }),\n    };\n  },\n\n  methods: {\n    handleSubmit(e) {\n      e.preventDefault();\n      this.form.validateFields((err, values) => {\n        if (!err) {\n          this.values = {\n            ...values,\n            tags: this.tags\n          };\n          console.log(values);\n        }\n      });\n    },\n    handleCancel(e) {\n      e.preventDefault();\n    },\n    handleChange(e) {\n      this.name = e.target.value;\n    }\n  }\n});\nexport default Account;","map":{"version":3,"names":["AccountWrapper","BasicFormWrapper","reactive","defineComponent","Account","name","components","data","formState","username","email","handleFinish","values","console","log","handleFinishFailed","errors","methods","handleSubmit","e","preventDefault","form","validateFields","err","tags","handleCancel","handleChange","target","value"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/pages/settings/overview/Account.vue"],"sourcesContent":["<template>\r\n  <AccountWrapper>\r\n    <sdCards>\r\n      <template v-slot:title>\r\n        <div class=\"setting-card-title\">\r\n          <sdHeading as=\"h4\">Account Settings</sdHeading>\r\n          <span>Update your username and manage your account</span>\r\n        </div>\r\n      </template>\r\n      <a-row>\r\n        <a-col :xs=\"24\">\r\n          <BasicFormWrapper>\r\n            <a-form\r\n              :model=\"formState\"\r\n              @finish=\"handleFinish\"\r\n              @finishFailed=\"handleFinishFailed\"\r\n              layout=\"vertical\"\r\n            >\r\n              <div class=\"account-form-top\">\r\n                <a-row type=\"flex\" justify=\"center\">\r\n                  <a-col :xxl=\"10\" :lg=\"16\" :md=\"18\" :xs=\"24\">\r\n                    <div class=\"account-form\">\r\n                      <a-form-item label=\"Username\">\r\n                        <a-input\r\n                          v-model:value=\"formState.username\"\r\n                          @change=\"handleChange\"\r\n                        />\r\n                      </a-form-item>\r\n                      <p>\r\n                        Your Dashboard URL: http://dashboard.com/<span>{{\r\n                          name\r\n                        }}</span>\r\n                      </p>\r\n                      <a-form-item label=\"Email\">\r\n                        <a-input v-model:value=\"formState.email\" />\r\n                      </a-form-item>\r\n                    </div>\r\n                  </a-col>\r\n                </a-row>\r\n              </div>\r\n\r\n              <div class=\"account-form-bottom\">\r\n                <a-row type=\"flex\" justify=\"center\">\r\n                  <a-col :xxl=\"10\" :lg=\"16\" :md=\"18\" :xs=\"24\">\r\n                    <div class=\"account-closing\">\r\n                      <a-row>\r\n                        <a-col :lg=\"18\" :md=\"24\" :sm=\"18\" :xs=\"24\">\r\n                          <sdHeading class=\"account-closing__title\" as=\"h4\">\r\n                            Close Account\r\n                          </sdHeading>\r\n                          <p>Delete Your Account and Account data</p>\r\n                        </a-col>\r\n                        <a-col :lg=\"6\" :md=\"24\" :sm=\"6\" :xs=\"24\">\r\n                          <sdButton size=\"small\" type=\"danger\">\r\n                            Close Account\r\n                          </sdButton>\r\n                        </a-col>\r\n                      </a-row>\r\n                    </div>\r\n                    <div class=\"account-action\">\r\n                      <div class=\"setting-form-actions\">\r\n                        <sdButton\r\n                          size=\"default\"\r\n                          htmlType=\"submit\"\r\n                          type=\"primary\"\r\n                        >\r\n                          Save Change\r\n                        </sdButton>\r\n                        &nbsp; &nbsp;\r\n                        <sdButton\r\n                          size=\"default\"\r\n                          @click=\"handleCancel\"\r\n                          type=\"light\"\r\n                        >\r\n                          Cancel\r\n                        </sdButton>\r\n                      </div>\r\n                    </div>\r\n                  </a-col>\r\n                </a-row>\r\n              </div>\r\n            </a-form>\r\n          </BasicFormWrapper>\r\n        </a-col>\r\n      </a-row>\r\n    </sdCards>\r\n  </AccountWrapper>\r\n</template>\r\n\r\n<script>\r\nimport { AccountWrapper } from \"./style\";\r\nimport { BasicFormWrapper } from \"../../../styled\";\r\nimport { reactive, defineComponent } from \"vue\";\r\n\r\nconst Account = defineComponent({\r\n  name: \"Account\",\r\n  components: { AccountWrapper, BasicFormWrapper },\r\n  data() {\r\n    const name = \"clayton\";\r\n    const formState = reactive({\r\n      username: name,\r\n      email: \"contact@example.com\",\r\n    });\r\n\r\n    const handleFinish = (values) => {\r\n      this.values = { ...values };\r\n      console.log(values, formState);\r\n    };\r\n\r\n    const handleFinishFailed = (errors) => {\r\n      console.log(errors);\r\n    };\r\n    return {\r\n      name,\r\n      values: null,\r\n      formState,\r\n      handleFinish,\r\n      handleFinishFailed,\r\n      // form: this.$form.createForm(this, { name: \"account\" }),\r\n    };\r\n  },\r\n\r\n  methods: {\r\n    handleSubmit(e) {\r\n      e.preventDefault();\r\n      this.form.validateFields((err, values) => {\r\n        if (!err) {\r\n          this.values = { ...values, tags: this.tags };\r\n          console.log(values);\r\n        }\r\n      });\r\n    },\r\n    handleCancel(e) {\r\n      e.preventDefault();\r\n    },\r\n    handleChange(e) {\r\n      this.name = e.target.value;\r\n    },\r\n  },\r\n});\r\n\r\nexport default Account;\r\n</script>\r\n"],"mappings":"AA0FA,SAASA,cAAa,QAAS,SAAS;AACxC,SAASC,gBAAe,QAAS,iBAAiB;AAClD,SAASC,QAAQ,EAAEC,eAAc,QAAS,KAAK;AAE/C,MAAMC,OAAM,GAAID,eAAe,CAAC;EAC9BE,IAAI,EAAE,SAAS;EACfC,UAAU,EAAE;IAAEN,cAAc;IAAEC;EAAiB,CAAC;EAChDM,IAAIA,CAAA,EAAG;IACL,MAAMF,IAAG,GAAI,SAAS;IACtB,MAAMG,SAAQ,GAAIN,QAAQ,CAAC;MACzBO,QAAQ,EAAEJ,IAAI;MACdK,KAAK,EAAE;IACT,CAAC,CAAC;IAEF,MAAMC,YAAW,GAAKC,MAAM,IAAK;MAC/B,IAAI,CAACA,MAAK,GAAI;QAAE,GAAGA;MAAO,CAAC;MAC3BC,OAAO,CAACC,GAAG,CAACF,MAAM,EAAEJ,SAAS,CAAC;IAChC,CAAC;IAED,MAAMO,kBAAiB,GAAKC,MAAM,IAAK;MACrCH,OAAO,CAACC,GAAG,CAACE,MAAM,CAAC;IACrB,CAAC;IACD,OAAO;MACLX,IAAI;MACJO,MAAM,EAAE,IAAI;MACZJ,SAAS;MACTG,YAAY;MACZI;MACA;IACF,CAAC;EACH,CAAC;;EAEDE,OAAO,EAAE;IACPC,YAAYA,CAACC,CAAC,EAAE;MACdA,CAAC,CAACC,cAAc,EAAE;MAClB,IAAI,CAACC,IAAI,CAACC,cAAc,CAAC,CAACC,GAAG,EAAEX,MAAM,KAAK;QACxC,IAAI,CAACW,GAAG,EAAE;UACR,IAAI,CAACX,MAAK,GAAI;YAAE,GAAGA,MAAM;YAAEY,IAAI,EAAE,IAAI,CAACA;UAAK,CAAC;UAC5CX,OAAO,CAACC,GAAG,CAACF,MAAM,CAAC;QACrB;MACF,CAAC,CAAC;IACJ,CAAC;IACDa,YAAYA,CAACN,CAAC,EAAE;MACdA,CAAC,CAACC,cAAc,EAAE;IACpB,CAAC;IACDM,YAAYA,CAACP,CAAC,EAAE;MACd,IAAI,CAACd,IAAG,GAAIc,CAAC,CAACQ,MAAM,CAACC,KAAK;IAC5B;EACF;AACF,CAAC,CAAC;AAEF,eAAexB,OAAO"},"metadata":{},"sourceType":"module","externalDependencies":[]}