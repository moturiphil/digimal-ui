ace(\"/auth/activity-confirm?\", \"act_part_cfm?\");\n      console.log(newUrl);\n      const confirm_response = fetch(`${process.env.VUE_APP_BASE_URL}/${newUrl}`, {\n        method: \"GET\",\n        headers: authHeader()\n      });\n      // console.log(confirm_response);\n      confirm_response.then(res => {\n        console.log(res);\n        // return res.json();\n        if (res.status == 200) {\n          _notification.success({\n            message: \"Success\",\n            description: \"Activity Participation Confirmed\"\n          });\n          this.$router.push(\"/\");\n        } else {\n          _notification.error({\n            message: \"Error\",\n            description: \"Activity Participation Not Confirmed\"\n          });\n        }\n      });\n    }\n  }\n};\nexport default Sales;","map":{"version":3,"names":["CardBarChart2","OverviewSalesCard","Main","SvgConverter","authHeader","Sales","name","components","data","currentUrl","newUrl","participant_name","activity_name","activity_date","activity_location","mounted","$route","fullPath","replace","response","fetch","process","env","VUE_APP_BASE_URL","method","headers","console","log","then","res","json","user_id","activity_id","catch","error","methods","confirm","confirm_response","status","_notification","success","message","description","$router","push"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/authentication/ActivityConfirm.vue"],"sourcesContent":["<template>\n  <sdPageHeader\n    class=\"header-boxed\"\n    title=\"ACTIVITY PARTICIPATION CONFIRMATION\"\n  >\n  </sdPageHeader>\n  <Main class=\"grid-boxed\">\n    <a-row :gutter=\"25\">\n      <a-col :lg=\"24\" :xs=\"24\">\n        <sdCards headless>\n          <OverviewSalesCard>\n            <div class=\"card-chunk\">\n              <CardBarChart2>\n                <h3>\n                  <b>\n                    Confirm Participation Details\n                    <div>\n                      <my-script :url=\"currentUrl\"></my-script>\n                    </div>\n                  </b>\n                </h3>\n                <br />\n                <p>\n                  <span class=\"growth-upward\">\n                    <sdFeatherIcons type=\"at-sign\"\n                  /></span>\n                  <span> <b>Participants Name:</b> {{ participant_name }}</span>\n                </p>\n                <p>\n                  <span class=\"growth-upward\">\n                    <sdFeatherIcons type=\"cast\"\n                  /></span>\n                  <span> <b> Activity Name: </b>{{ activity_name }} </span>\n                </p>\n                <p>\n                  <span class=\"growth-upward\">\n                    <sdFeatherIcons type=\"flag\" />\n                  </span>\n                  <span> <b>Confirmation Date:</b> {{ activity_date }} </span>\n                </p>\n                <br />\n                <!-- get button to align to the center -->\n\n                <sdButton\n                  class=\"btn-signin\"\n                  htmlType=\"submit\"\n                  :loading=\"isLoading\"\n                  type=\"success\"\n                  size=\"large\"\n                  @click=\"confirm\"\n                >\n                  Confirm\n                </sdButton>\n              </CardBarChart2>\n            </div>\n          </OverviewSalesCard>\n        </sdCards>\n      </a-col>\n    </a-row>\n  </Main>\n</template>\n<script>\nimport { CardBarChart2, OverviewSalesCard } from \"../dashboard/style\";\nimport { Main } from \"../styled\";\n// import { defineAsyncComponent } from 'vue';\nimport SvgConverter from \"@/components/utilities/SvgConverter.vue\";\nimport { notification } from \"ant-design-vue\";\n\n\nimport authHeader from \"../../services/auth-header\";\n\nconst Sales = {\n  name: \"Sales\",\n  components: {\n    Main,\n    CardBarChart2,\n    OverviewSalesCard,\n    SvgConverter,\n  },\n  data() {\n    // let url = this.currentUrl.replace(\"/auth/activity-confirm?\", \"act_part_cfm?\");\n    // console.log(url);\n    // const confirm_response = fetch(`${process.env.VUE_APP_BASE_URL}/${url}`, {\n    //   method: \"GET\",\n    //   headers: authHeader(),\n    // });\n    // confirm_response.then((res) => {\n    //   console.log(res);\n    //   return res.json();\n    // });\n    return {\n      currentUrl: \"\",\n      newUrl: \"\",\n      participant_name: \"\",\n      activity_name: \"\",\n      activity_date: \"\",\n      activity_location: \"\",\n    };\n  },\n  mounted() {\n    this.currentUrl = this.$route.fullPath;\n    let newUrl = this.currentUrl.replace(\n      \"/auth/activity-confirm?\",\n      \"act_part?\"\n    );\n    // console.log(this.currentUrl);\n\n    const response = fetch(`${process.env.VUE_APP_BASE_URL}/${newUrl}`, {\n      method: \"GET\",\n      headers: authHeader(),\n    });\n    console.log(newUrl);\n\n    response\n      .then((res) => {\n        console.log(res);\n        return res.json();\n      })\n      .then((data) => {\n        console.log(data); // This should log the \"id\" property from the response data\n        this.participant_name = data.user_id;\n        this.activity_name = data.activity_id;\n        this.activity_date = data.activity_date;\n      })\n      .catch((error) => {\n        console.log(error);\n      });\n  },\n  methods: {\n    confirm() {\n      let newUrl = this.currentUrl.replace(\n        \"/auth/activity-confirm?\",\n        \"act_part_cfm?\"\n      );\n      console.log(newUrl);\n      const confirm_response = fetch(`${process.env.VUE_APP_BASE_URL}/${newUrl}`, {\n        method: \"GET\",\n        headers: authHeader(),\n      });\n      // console.log(confirm_response);\n      confirm_response.then((res) => {\n        console.log(res);\n        // return res.json();\n        if (res.status == 200) {\n          notification.success({\n            message: \"Success\",\n            description: \"Activity Participation Confirmed\",\n          });\n 