{"ast":null,"code":"import axios from \"axios\";\nimport authHeader from \"../../../services/auth-header\";\nimport { RecordViewWrapper } from \"../style\";\nimport { Main, TableWrapper } from \"../../styled\";\nimport { useStore } from \"vuex\";\nimport { computed, onMounted, ref, reactive, defineComponent } from \"vue\";\n// import { useRouter } from \"vue-router\";\n// import { Modal } from \"ant-design-vue\";\n\n// const router = useRouter();\n\nconst columns = [{\n  title: \"First name\",\n  dataIndex: \"first_name\",\n  key: \"id_no\"\n}, {\n  title: \"Last name\",\n  dataIndex: \"last_name\",\n  key: \"id_no\"\n}, {\n  title: \"Phone number\",\n  dataIndex: \"phone_no\",\n  key: \"id_no\"\n}, {\n  title: \"Household size\",\n  dataIndex: \"hh_size\",\n  key: \"id_no\"\n}, {\n  title: \"Location\",\n  dataIndex: \"location_id\",\n  key: \"id_no\"\n}, {\n  title: \"CHW\",\n  dataIndex: \"chw_id\",\n  key: \"id_no\"\n}];\nconst ViewPage = defineComponent({\n  name: \"ViewPage\",\n  components: {\n    RecordViewWrapper,\n    Main,\n    TableWrapper\n  },\n  data() {\n    return {\n      visible: false,\n      confirmLoading: false,\n      modalType: \"primary\",\n      colorVisible: false\n    };\n  },\n  setup() {\n    const {\n      state\n    } = useStore();\n    const crud = computed(() => state.crud.data);\n    const isLoading = computed(() => state.crud.loading);\n    const selectedRowKeys = ref([]);\n    const dataSource = ref([]);\n    const API_URL = `${process.env.VUE_APP_BASE_URL}/households`;\n    onMounted(() => {\n      axios.get(API_URL, {\n        headers: authHeader()\n      }).then(response => {\n        console.log(response.data.data);\n        dataSource.value = response.data.data;\n        // let house_hold_sz = dataSource; \n      }).catch(error => {\n        console.error(error);\n      });\n    });\n    const formState = reactive({\n      searchItem: \"\"\n    });\n\n    // const onSelectChange = (selectedRowKey) => {\n    //   selectedRowKeys.value = selectedRowKey;\n    // };\n\n    // const rowSelection = {\n    //   selectedRowKeys,\n    //   onChange: onSelectChange,\n    // };\n\n    return {\n      crud,\n      isLoading,\n      selectedRowKeys,\n      // handleDelete,\n      // rowSelection,\n      // onSelectChange,\n      dataSource,\n      columns,\n      formState\n    };\n  }\n});\nexport default ViewPage;","map":{"version":3,"names":["axios","authHeader","RecordViewWrapper","Main","TableWrapper","useStore","computed","onMounted","ref","reactive","defineComponent","columns","title","dataIndex","key","ViewPage","name","components","data","visible","confirmLoading","modalType","colorVisible","setup","state","crud","isLoading","loading","selectedRowKeys","dataSource","API_URL","process","env","VUE_APP_BASE_URL","get","headers","then","response","console","log","value","catch","error","formState","searchItem"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/pages/household/viewHouseholds.vue"],"sourcesContent":["<template>\n    <RecordViewWrapper>\n      <sdPageHeader title=\"Households Lists\">\n        <template #subTitle>\n          \n        </template>\n        <template #buttons>\n          <div class=\"search-box\">\n            <span class=\"search-icon\">\n              <sdFeatherIcons type=\"search\" size=\"14\" />\n            </span>\n            <a-input\n              @change=\"onHandleSearch\"\n              v-model:value.trim=\"formState.searchItem\"\n              type=\"text\"\n              name=\"dataSource\"\n              placeholder=\"Search Here\"\n            /></div\n        ></template>\n      </sdPageHeader>\n      <Main>\n        <a-row :gutter=\"15\">\n          <a-col class=\"w-100\" :md=\"24\">\n            <sdCards headless>\n              <div v-if=\"isLoading\" class=\"spin\">\n                <a-spin />\n              </div>\n  \n              <div v-else>\n                <TableWrapper class=\"table-data-view table-responsive\">\n                  <a-table\n                    :pagination=\"{ pageSize: 10, showSizeChanger: true }\"\n                    :dataSource=\"dataSource\"\n                    :columns=\"columns\"\n                  >\n                  </a-table>\n                </TableWrapper>\n              </div>\n            </sdCards>\n          </a-col>\n        </a-row>\n      </Main>\n    </RecordViewWrapper>\n  </template>\n  <script>\n  import axios from \"axios\";\n  import authHeader from \"../../../services/auth-header\";\n  import { RecordViewWrapper } from \"../style\";\n  import { Main, TableWrapper } from \"../../styled\";\n  import { useStore } from \"vuex\";\n  import { computed, onMounted, ref, reactive, defineComponent } from \"vue\";\n  // import { useRouter } from \"vue-router\";\n  // import { Modal } from \"ant-design-vue\";\n  \n  // const router = useRouter();\n  \n  const columns = [\n    {\n      title: \"First name\",\n      dataIndex: \"first_name\",\n      key: \"id_no\",\n    },\n    {\n      title: \"Last name\",\n      dataIndex: \"last_name\",\n      key: \"id_no\",\n    },\n    {\n      title: \"Phone number\",\n      dataIndex: \"phone_no\",\n      key: \"id_no\",\n    },\n    {\n      title: \"Household size\",\n      dataIndex: \"hh_size\",\n      key: \"id_no\",\n    },\n    {\n      title: \"Location\",\n      dataIndex: \"location_id\",\n      key: \"id_no\",\n    },\n    {\n      title: \"CHW\",\n      dataIndex: \"chw_id\",\n      key: \"id_no\",\n    },\n  ];\n  \n  const ViewPage = defineComponent({\n    name: \"ViewPage\",\n    components: { RecordViewWrapper, Main, TableWrapper },\n    data() {\n      return {\n        visible: false,\n        confirmLoading: false,\n        modalType: \"primary\",\n        colorVisible: false,\n      };\n    },\n    setup() {\n      const { state } = useStore();\n      const crud = computed(() => state.crud.data);\n      const isLoading = computed(() => state.crud.loading);\n      const selectedRowKeys = ref([]);\n      const dataSource = ref([]);\n  \n      const API_URL = `${process.env.VUE_APP_BASE_URL}/households`;\n  \n      onMounted(() => {\n        axios\n          .get(API_URL, {\n            headers: authHeader(),\n          })\n          .then((response) => {\n            console.log(response.data.data);\n            dataSource.value = response.data.data;\n            // let house_hold_sz = dataSource; \n          })\n          .catch((error) => {\n            console.error(error);\n          });\n      });\n  \n     \n  \n      const formState = reactive({\n        searchItem: \"\",\n      });\n  \n      // const onSelectChange = (selectedRowKey) => {\n      //   selectedRowKeys.value = selectedRowKey;\n      // };\n  \n      // const rowSelection = {\n      //   selectedRowKeys,\n      //   onChange: onSelectChange,\n      // };\n  \n      return {\n        crud,\n        isLoading,\n        selectedRowKeys,\n        // handleDelete,\n        // rowSelection,\n        // onSelectChange,\n        dataSource,\n        columns,\n        formState,\n      };\n    },\n  });\n  \n  export default ViewPage;\n  </script>\n  "],"mappings":"AA6CE,OAAOA,KAAI,MAAO,OAAO;AACzB,OAAOC,UAAS,MAAO,+BAA+B;AACtD,SAASC,iBAAgB,QAAS,UAAU;AAC5C,SAASC,IAAI,EAAEC,YAAW,QAAS,cAAc;AACjD,SAASC,QAAO,QAAS,MAAM;AAC/B,SAASC,QAAQ,EAAEC,SAAS,EAAEC,GAAG,EAAEC,QAAQ,EAAEC,eAAc,QAAS,KAAK;AACzE;AACA;;AAEA;;AAEA,MAAMC,OAAM,GAAI,CACd;EACEC,KAAK,EAAE,YAAY;EACnBC,SAAS,EAAE,YAAY;EACvBC,GAAG,EAAE;AACP,CAAC,EACD;EACEF,KAAK,EAAE,WAAW;EAClBC,SAAS,EAAE,WAAW;EACtBC,GAAG,EAAE;AACP,CAAC,EACD;EACEF,KAAK,EAAE,cAAc;EACrBC,SAAS,EAAE,UAAU;EACrBC,GAAG,EAAE;AACP,CAAC,EACD;EACEF,KAAK,EAAE,gBAAgB;EACvBC,SAAS,EAAE,SAAS;EACpBC,GAAG,EAAE;AACP,CAAC,EACD;EACEF,KAAK,EAAE,UAAU;EACjBC,SAAS,EAAE,aAAa;EACxBC,GAAG,EAAE;AACP,CAAC,EACD;EACEF,KAAK,EAAE,KAAK;EACZC,SAAS,EAAE,QAAQ;EACnBC,GAAG,EAAE;AACP,CAAC,CACF;AAED,MAAMC,QAAO,GAAIL,eAAe,CAAC;EAC/BM,IAAI,EAAE,UAAU;EAChBC,UAAU,EAAE;IAAEf,iBAAiB;IAAEC,IAAI;IAAEC;EAAa,CAAC;EACrDc,IAAIA,CAAA,