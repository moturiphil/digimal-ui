{"ast":null,"code":"import { CardBarChart } from '../../style';\nimport Chart from '../../../../components/utilities/chartjs';\nimport { customTooltips } from '../../../../components/utilities/utilities';\nimport { computed, onMounted, ref, defineComponent } from 'vue';\nimport { useStore } from 'vuex';\nconst YoutubeSubscribers = defineComponent({\n  name: 'YoutubeSubscribers',\n  components: {\n    CardBarChart,\n    Chart\n  },\n  setup() {\n    const {\n      state,\n      dispatch\n    } = useStore();\n    const youtubeSubscribeTabActive = ref('year');\n    onMounted(() => dispatch('youtubeSubscribeGetData'));\n    const youtubeSubscribeState = computed(() => state.chartContent.youtubeSubscribeData);\n    const yuIsLoading = computed(() => state.chartContent.yuLoading);\n    const youtubeSubscribeDatasets = computed(() => [{\n      data: state.chartContent.youtubeSubscribeData.gained,\n      backgroundColor: '#5F63F280',\n      hoverBackgroundColor: '#5F63F2',\n      label: 'Gained',\n      maxBarThickness: 10,\n      barThickness: 12\n    }, {\n      data: state.chartContent.youtubeSubscribeData.lost,\n      backgroundColor: '#FF4D4F80',\n      hoverBackgroundColor: '#FF4D4F',\n      label: 'Lost',\n      maxBarThickness: 10,\n      barThickness: 12\n    }]);\n    const chartOptions = computed(() => {\n      return {\n        maintainAspectRatio: true,\n        responsive: true,\n        layout: {\n          padding: {\n            top: 20\n          }\n        },\n        legend: {\n          display: false,\n          position: 'top',\n          align: 'end',\n          labels: {\n            boxWidth: 6,\n            display: true,\n            usePointStyle: true\n          }\n        },\n        scales: {\n          yAxes: [{\n            gridLines: {\n              color: '#e5e9f2',\n              borderDash: [3, 3],\n              zeroLineColor: '#e5e9f2',\n              zeroLineWidth: 1,\n              zeroLineBorderDash: [3, 3]\n            },\n            ticks: {\n              beginAtZero: true,\n              fontSize: 12,\n              fontColor: '#182b49',\n              max: Math.max(...state.chartContent.youtubeSubscribeData.gained),\n              stepSize: Math.max(...state.chartContent.youtubeSubscribeData.gained) / 5,\n              display: true,\n              min: 0,\n              padding: 10\n            }\n          }],\n          xAxes: [{\n            gridLines: {\n              display: true,\n              zeroLineWidth: 2,\n              zeroLineColor: '#fff',\n              color: 'transparent',\n              z: 1\n            },\n            ticks: {\n              beginAtZero: true,\n              fontSize: 12,\n              fontColor: '#182b49',\n              min: 0\n            }\n          }]\n        },\n        tooltips: {\n          mode: 'label',\n          intersect: false,\n          position: 'average',\n          enabled: false,\n          custom: customTooltips,\n          callbacks: {\n            label(t, d) {\n              const dstLabel = d.datasets[t.datasetIndex].label;\n              const {\n                yLabel\n              } = t;\n              return `<span class=\"chart-data\">${yLabel}</span> <span class=\"data-label\">${dstLabel}</span>`;\n            },\n            labelColor(tooltipItem, chart) {\n              const dataset = chart.config.data.datasets[tooltipItem.datasetIndex];\n              return {\n                backgroundColor: dataset.backgroundColor,\n                borderColor: 'transparent',\n                usePointStyle: true\n              };\n            }\n          }\n        }\n      };\n    });\n    const handleActiveChangeYoutube = (e, value) => {\n      e.preventDefault();\n      youtubeSubscribeTabActive.value = value;\n      dispatch('youtubeSubscribeFilterData', value);\n    };\n    return {\n      handleActiveChangeYoutube,\n      youtubeSubscribeState,\n      yuIsLoading,\n      youtubeSubscribeDatasets,\n      chartOptions,\n      youtubeSubscribeTabActive\n    };\n  }\n});\nexport default YoutubeSubscribers;","map":{"version":3,"names":["CardBarChart","Chart","customTooltips","computed","onMounted","ref","defineComponent","useStore","YoutubeSubscribers","name","components","setup","state","dispatch","youtubeSubscribeTabActive","youtubeSubscribeState","chartContent","youtubeSubscribeData","yuIsLoading","yuLoading","youtubeSubscribeDatasets","data","gained","backgroundColor","hoverBackgroundColor","label","maxBarThickness","barThickness","lost","chartOptions","maintainAspectRatio","responsive","layout","padding","top","legend","display","position","align","labels","boxWidth","usePointStyle","scales","yAxes","gridLines","color","borderDash","zeroLineColor","zeroLineWidth","zeroLineBorderDash","ticks","beginAtZero","fontSize","fontColor","max","Math","stepSize","min","xAxes","z","tooltips","mode","intersect","enabled","custom","callbacks","t","d","dstLabel","datasets","datasetIndex","yLabel","labelColor","tooltipItem","chart","dataset","config","borderColor","handleActiveChangeYoutube","e","value","preventDefault"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/dashboard/overview/index/YoutubeSubscribers.vue"],"sourcesContent":["<template>\r\n  <sdCards v-if=\"youtubeSubscribeState !== null\" title=\"Youtube Subscribers\">\r\n    <template #button>\r\n      <div class=\"card-nav\">\r\n        <ul>\r\n          <li :class=\"youtubeSubscribeTabActive === 'week' ? 'active' : 'deactivate'\">\r\n            <router-link @click=\"(e) => handleActiveChangeYoutube(e, 'week')\" to=\"#\"> Week </router-link>\r\n          </li>\r\n          <li :class=\"youtubeSubscribeTabActive === 'month' ? 'active' : 'deactivate'\">\r\n            <router-link @click=\"(e) => handleActiveChangeYoutube(e, 'month')\" to=\"#\"> Month </router-link>\r\n          </li>\r\n          <li :class=\"youtubeSubscribeTabActive === 'year' ? 'active' : 'deactivate'\">\r\n            <router-link @click=\"(e) => handleActiveChangeYoutube(e, 'year')\" to=\"#\"> Year </router-link>\r\n          </li>\r\n        </ul>\r\n      </div>\r\n    </template>\r\n\r\n    <div v-if=\"yuIsLoading\" class=\"sd-spin\">\r\n      <a-spin />\r\n    </div>\r\n\r\n    <CardBarChart v-else>\r\n      <div\r\n        :style=\"{\r\n          display: 'flex',\r\n          alignItems: 'center',\r\n          justifyContent: 'space-between',\r\n        }\"\r\n      >\r\n        <div class=\"card-bar-top\">\r\n          <p>Subscribers</p>\r\n          <sdHeading as=\"h3\">\r\n            {{ youtubeSubscribeState.Subscribe }}\r\n            <sub>\r\n              <sdFeatherIcons type=\"arrow-up\" size=\"14\" />\r\n              {{ youtubeSubscribeState.percent }}%\r\n            </sub>\r\n          </sdHeading>\r\n        </div>\r\n        <ul v-if=\"youtubeSubscribeDatasets\">\r\n          <li v-for=\"(item, key) in youtubeSubscribeDatasets\" :key=\"key + 1\" class=\"custom-label\">\r\n            <span\r\n              :style=\"{\r\n                backgroundColor: item.hoverBackgroundColor,\r\n              }\"\r\n            />\r\n            {{ item.label }}\r\n          </li>\r\n        </ul>\r\n      </div>\r\n      <sdChartContainer class=\"parentContainer\">\r\n        <Chart\r\n          type=\"bar\"\r\n          class=\"youtubeSubscribe\"\r\n          :height=\"195\"\r\n          :labels=\"youtubeSubscribeState.labels\"\r\n          :datasets=\"youtubeSubscribeDatasets\"\r\n          :options=\"chartOptions\"\r\n          :style=\"{\r\n            marginBottom: '0',\r\n          }\"\r\n        />\r\n      </sdChartContainer>\r\n    </CardBarChart>\r\n  </sdCards>\r\n</template>\r\n<script>\r\nimport { CardBarChart } from '../../style';\r\nimport Chart from '../../../../components/utilities/chartjs';\r\nimport { customTooltips } from '../../../../components/utilities/utilities';\r\nimport { computed, onMounted, ref, defineComponent } from 'vue';\r\nimport { useStore } from 'vuex';\r\n\r\nconst YoutubeSubscribers = defineComponent({\r\n  name: 'YoutubeSubscribers',\r\n  components: {\r\n    CardBarChart,\r\n    Chart,\r\n  },\r\n  setup() {\r\n    const { state, dispatch } = useStore();\r\n    const youtubeSubscribeTabActive = ref('year');\r\n\r\n    onMounted(() => dispatch('youtubeSubscribeGetData'));\r\n\r\n    const youtubeSubscribeState = computed(() => state.chartContent.youtubeSubscribeData);\r\n    const yuIsLoading = computed(() => state.chartContent.yuLoading);\r\n    const youtubeSubscribeDatasets = computed(() => [\r\n      {\r\n        data: state.chartContent.youtubeSubscribeData.gained,\r\n        backgroundColor: '#5F63F280',\r\n        hoverBackgroundColor: '#5F63F2',\r\n        label: 'Gained',\r\n        maxBarThickness: 10,\r\n        barThickness: 12,\r\n      },\r\n      {\r\n        data: state.chartContent.youtubeSubscribeData.lost,\r\n        backgroundColor: '#FF4D4F80',\r\n        hoverBackgroundColor: '#FF4D4F',\r\n        label: 'Lost',\r\n        maxBarThickness: 10,\r\n        barThickness: 12,\r\n      },\r\n    ]);\r\n    const chartOptions = computed(() => {\r\n      return {\r\n        maintainAspectRatio: true,\r\n        responsive: true,\r\n        layout: {\r\n          padding: {\r\n            top: 20,\r\n          },\r\n        },\r\n        legend: {\r\n          display: false,\r\n          position: 'top',\r\n          align: 'end',\r\n          labels: {\r\n            boxWidth: 6,\r\n            display: true,\r\n            usePointStyle: true,\r\n          },\r\n        },\r\n\r\n        scales: {\r\n          yAxes: [\r\n            {\r\n              gridLines: {\r\n                color: '#e5e9f2',\r\n                borderDash: [3, 3],\r\n                zeroLineColor: '#e5e9f2',\r\n                zeroLineWidth: 1,\r\n                zeroLineBorderDash: [3, 3],\r\n              },\r\n              ticks: {\r\n                beginAtZero: true,\r\n                fontSize: 12,\r\n                fontColor: '#182b49',\r\n                max: Math.max(...state.chartContent.youtubeSubscribeData.gained),\r\n                stepSize: Math.max(...state.chartContent.youtubeSubscribeData.gained) / 5,\r\n                display: true,\r\n                min: 0,\r\n                padding: 10,\r\n              },\r\n            },\r\n          ],\r\n          xAxes: [\r\n            {\r\n              gridLines: {\r\n                display: true,\r\n                zeroLineWidth: 2,\r\n                zeroLineColor: '#fff',\r\n                color: 'transparent',\r\n                z: 1,\r\n              },\r\n              ticks: {\r\n                beginAtZero: true,\r\n                fontSize: 12,\r\n                fontColor: '#182b49',\r\n                min: 0,\r\n              },\r\n            },\r\n          ],\r\n        },\r\n        tooltips: {\r\n          mode: 'label',\r\n          intersect: false,\r\n          position: 'average',\r\n          enabled: false,\r\n          custom: customTooltips,\r\n          callbacks: {\r\n            label(t, d) {\r\n              const dstLabel = d.datasets[t.datasetIndex].label;\r\n              const { yLabel } = t;\r\n              return `<span class=\"chart-data\">${yLabel}</span> <span class=\"data-label\">${dstLabel}</span>`;\r\n            },\r\n            labelColor(tooltipItem, chart) {\r\n              const dataset = chart.config.data.datasets[tooltipItem.datasetIndex];\r\n              return {\r\n                backgroundColor: dataset.backgroundColor,\r\n                borderColor: 'transparent',\r\n                usePointStyle: true,\r\n              };\r\n            },\r\n          },\r\n        },\r\n      };\r\n    });\r\n    const handleActiveChangeYoutube = (e, value) => {\r\n      e.preventDefault();\r\n      youtubeSubscribeTabActive.value = value;\r\n      dispatch('youtubeSubscribeFilterData', value);\r\n    };\r\n    return {\r\n      handleActiveChangeYoutube,\r\n      youtubeSubscribeState,\r\n      yuIsLoading,\r\n      youtubeSubscribeDatasets,\r\n      chartOptions,\r\n      youtubeSubscribeTabActive,\r\n    };\r\n  },\r\n});\r\n\r\nexport default YoutubeSubscribers;\r\n</script>\r\n"],"mappings":"AAoEA,SAASA,YAAW,QAAS,aAAa;AAC1C,OAAOC,KAAI,MAAO,0CAA0C;AAC5D,SAASC,cAAa,QAAS,4CAA4C;AAC3E,SAASC,QAAQ,EAAEC,SAAS,EAAEC,GAAG,EAAEC,eAAc,QAAS,KAAK;AAC/D,SAASC,QAAO,QAAS,MAAM;AAE/B,MAAMC,kBAAiB,GAAIF,eAAe,CAAC;EACzCG,IAAI,EAAE,oBAAoB;EAC1BC,UAAU,EAAE;IACVV,YAAY;IACZC;EACF,CAAC;EACDU,KAAKA,CAAA,EAAG;IACN,MAAM;MAAEC,KAAK;MAAEC;IAAS,IAAIN,QAAQ,EAAE;IACtC,MAAMO,yBAAwB,GAAIT,GAAG,CAAC,MAAM,CAAC;IAE7CD,SAAS,CAAC,MAAMS,QAAQ,CAAC,yBAAyB,CAAC,CAAC;IAEpD,MAAME,qBAAoB,GAAIZ,QAAQ,CAAC,MAAMS,KAAK,CAACI,YAAY,CAACC,oBAAoB,CAAC;IACrF,MAAMC,WAAU,GAAIf,QAAQ,CAAC,MAAMS,KAAK,CAACI,YAAY,CAACG,SAAS,CAAC;IAChE,MAAMC,wBAAuB,GAAIjB,QAAQ,CAAC,MAAM,CAC9C;MACEkB,IAAI,EAAET,KAAK,CAACI,YAAY,CAACC,oBAAoB,CAACK,MAAM;MACpDC,eAAe,EAAE,WAAW;MAC5BC,oBAAoB,EAAE,SAAS;MAC/BC,KAAK,EAAE,QAAQ;MACfC,eAAe,EAAE,EAAE;MACnBC,YAAY,EAAE;IAChB,CAAC,EACD;MACEN,IAAI,EAAET,KAAK,CAACI,YAAY,CAACC,oBAAoB,CAACW,IAAI;MAClDL,eAAe,EAAE,WAAW;MAC5BC,oBAAoB,EAAE,SAAS;MAC/BC,KAAK,EAAE,MAAM;MACbC,eAAe,EAAE,EAAE;MACnBC,YAAY,EAAE;IAChB,CAAC,CACF,CAAC;IACF,MAAME,YAAW,GAAI1B,QAAQ,CAAC,MAAM;MAClC,OAAO;QACL2B,mBAAmB,EAAE,IAAI;QACzBC,UAAU,EAAE,IAAI;QAChBC,MAAM,EAAE;UACNC,OAAO,EAAE;YACPC,GAAG,EAAE;UACP;QACF,CAAC;QACDC,MAAM,EAAE;UACNC,OAAO,EAAE,KAAK;UACdC,QAAQ,EAAE,KAAK;UACfC,KAAK,EAAE,KAAK;UACZC,MAAM,EAAE;YACNC,QAAQ,EAAE,CAAC;YACXJ,OAAO,EAAE,IAAI;YACbK,aAAa,EAAE;UACjB;QACF,CAAC;QAEDC,MAAM,EAAE;UACNC,KAAK,EAAE,CACL;YACEC,SAAS,EAAE;cACTC,KAAK,EAAE,SAAS;cAChBC,UAAU,EAAE,CAAC,CAAC,EAAE,CAAC,CAAC;cAClBC,aAAa,EAAE,SAAS;cACxBC,aAAa,EAAE,CAAC;cAChBC,kBAAkB,EAAE,CAAC,CAAC,EAAE,CAAC;YAC3B,CAAC;YACDC,KAAK,EAAE;cACLC,WAAW,EAAE,IAAI;cACjBC,QAAQ,EAAE,EAAE;cACZC,SAAS,EAAE,SAAS;cACpBC,GAAG,EAAEC,IAAI,CAACD,GAAG,CAAC,GAAG1C,KAAK,CAACI,YAAY,CAACC,oBAAoB,CAACK,MAAM,CAAC;cAChEkC,QAAQ,EAAED,IAAI,CAACD,GAAG,CAAC,GAAG1C,KAAK,CAACI,YAAY,CAACC