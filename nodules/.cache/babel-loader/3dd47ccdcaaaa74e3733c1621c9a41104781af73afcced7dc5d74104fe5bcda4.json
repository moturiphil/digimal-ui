{"ast":null,"code":"import \"ant-design-vue/es/notification/style\";\nimport _notification from \"ant-design-vue/es/notification\";\nimport \"core-js/modules/es.array.push.js\";\nimport { RecordFormWrapper } from \"../style\";\nimport { Main, BasicFormWrapper } from \"../../styled\";\nimport { useStore } from \"vuex\";\nimport { reactive, ref, defineComponent, computed, onMounted } from \"vue\";\nimport authHeader from \"../../../services/auth-header\";\nimport { useRouter } from \"vue-router\";\nconst dateFormat = \"YYYY-MM-DD\";\nconst AddNew = defineComponent({\n  name: \"AddNew\",\n  components: {\n    RecordFormWrapper,\n    Main,\n    BasicFormWrapper\n  },\n  data() {\n    const {\n      state\n    } = useStore();\n    const isLoading = computed(() => state.crud.loading);\n    const apiUrl = computed(() => state.crud.url);\n    const isFileLoading = computed(() => state.crud.fileLoading);\n    const join = ref(\"\");\n    const API_URL = `${process.env.VUE_APP_BASE_URL}/new_drop_off_points`;\n    const router = useRouter();\n    const campaign_url = `${process.env.VUE_APP_BASE_URL}/campaign_all`;\n    const {\n      loading,\n      campaigns,\n      sub_counties,\n      counties\n    } = reactive({\n      campaigns: [],\n      counties: [],\n      sub_counties: [],\n      loading: true\n    });\n    const formState = reactive({\n      name: \"\",\n      campaign_id: \"\",\n      county_id: \"\",\n      sub_county: \"\"\n    });\n    console.log(formState);\n\n    //campaigns\n    const getCampaigns = async () => {\n      const response = await fetch(campaign_url, {\n        method: \"GET\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          ...authHeader()\n        }\n      });\n      const data = await response.json();\n      this.campaigns = data.data;\n      console.log(data.data);\n      this.loading = false;\n    };\n\n    //counties\n    const getCounties = async () => {\n      const response = await fetch(`${process.env.VUE_APP_BASE_URL}/counties`, {\n        method: \"GET\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          ...authHeader()\n        }\n      });\n      const data = await response.json();\n      this.counties = data.map(county => ({\n        ...county\n        // org_id: county.org_id,\n      }));\n\n      console.log(this.counties);\n      this.loading = false;\n    };\n\n    //get sub_counties\n    const getSubCounties = async org_id => {\n      const response = await fetch(`${process.env.VUE_APP_BASE_URL}/get_sub_counties_list?parent_id=${org_id}`, {\n        method: \"GET\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          ...authHeader()\n        }\n      });\n      const data = await response.json();\n      //   console.log(data.message);\n      this.sub_counties = data.message;\n    };\n    onMounted(() => {\n      getCounties();\n      getCampaigns();\n      getSubCounties();\n      console.log(getCounties());\n    });\n    const handleSubmit = values => {\n      console.log(values);\n      values = {\n        name: values.name,\n        campaign_id: values.campaign_id,\n        ou_sub_county: values.sub_county_id\n      };\n      console.log(values);\n      fetch(API_URL, {\n        method: \"POST\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          ...authHeader()\n        },\n        body: JSON.stringify(values)\n      }).then(response => response.json()).then(data => {\n        console.log(data);\n        console.log(\".......... \");\n        console.log(API_URL);\n        if (data.status == true) {\n          router.push(\"/nets/distribution-points\");\n          _notification[\"success\"]({\n            message: \"Distribution Point Created\",\n            description: `Distribution Point Created successfully.`,\n            duration: 5.5\n          });\n        } else {\n          _notification[\"error\"]({\n            message: \"Distribution Point Creation Failed\",\n            description: `Distribution Point Creation failed.`,\n            duration: 5.5\n          });\n        }\n      }).catch(error => {\n        console.error(\"Error:\", error);\n      });\n    };\n    return {\n      isLoading,\n      loading,\n      apiUrl,\n      isFileLoading,\n      handleSubmit,\n      dateFormat,\n      formState,\n      join,\n      getSubCounties,\n      sub_counties,\n      campaigns,\n      counties\n    };\n  },\n  beforeRouteEnter(to, from, next) {\n    if (!sessionStorage.getItem(\"user\")) {\n      next(\"/auth/login\");\n    } else {\n      next();\n    }\n  }\n});\nexport default AddNew;","map":{"version":3,"names":["RecordFormWrapper","Main","BasicFormWrapper","useStore","reactive","ref","defineComponent","computed","onMounted","authHeader","useRouter","dateFormat","AddNew","name","components","data","state","isLoading","crud","loading","apiUrl","url","isFileLoading","fileLoading","join","API_URL","process","env","VUE_APP_BASE_URL","router","campaign_url","campaigns","sub_counties","counties","formState","campaign_id","county_id","sub_county","console","log","getCampaigns","response","fetch","method","headers","json","getCounties","map","county","getSubCounties","org_id","message","handleSubmit","values","ou_sub_county","sub_county_id","body","JSON","stringify","then","status","push","_notification","description","duration","catch","error","beforeRouteEnter","to","from","next","sessionStorage","getItem"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/pages/net-distribution/DistributionPoint.vue"],"sourcesContent":["<template>\n  <sdPageHeader title=\"Create Dropoff Point\">\n    <sdButton class=\"btn-add_new\" size=\"default\" key=\"1\" type=\"sucess\">\n      <router-link to=\"/crud/axios-view\">View All</router-link>\n    </sdButton>\n  </sdPageHeader>\n  <Main>\n    <a-row :gutter=\"15\">\n      <a-col :xs=\"24\">\n        <RecordFormWrapper>\n          <sdCards headless>\n            <a-row justify=\"center\">\n              <a-col :xl=\"10\" :md=\"16\" :xs=\"24\">\n                <BasicFormWrapper>\n                  <a-form\n                    class=\"add-record-form\"\n                    :style=\"{ width: '100%' }\"\n                    layout=\"vertical\"\n                    name=\"addnew\"\n                    :model=\"formState\"\n                    @finish=\"handleSubmit\"\n                  >\n                    <a-form-item name=\"campaign_id\" label=\"Select Campaign\">\n                      <a-select\n                        size=\"large\"\n                        name=\"basic-select\"\n                        class=\"sDash_fullwidth-select\"\n                        v-model:value=\"formState.campaign_id\"\n                        v-if=\"!loading\"\n                        placeholder=\"Select Campaign\"\n                      >\n                      <a-select-option value=\"\" disabled\n                          >Select a campaign</a-select-option\n                        >\n                        <a-select-option\n                          v-for=\"campaign in campaigns\"\n                          :value=\"campaign.id\"\n                          :key=\"campaign.id\"\n                          >{{ campaign.name }}</a-select-option\n                        >\n                      </a-select>\n                    </a-form-item>\n                    <a-form-item name=\"name\" label=\"Distribution Point Name\">\n                      <a-input\n                        v-model:value=\"formState.name\"\n                        placeholder=\"Enter name of the distribution point\"\n                      />\n                    </a-form-item>\n                    <a-form-item name=\"county_id\" label=\"County\">\n                      <a-select\n                        size=\"large\"\n                        name=\"basic-select\"\n                        class=\"sDash_fullwidth-select\"\n                        placeholder=\"Select County\"\n                        v-on:change=\"getSubCounties($event)\"\n                        v-model:value=\"formState.county_id\"\n                        v-if=\"!loading\"\n                      >\n                        <a-select-option value=\"\"\n                          >Select an option</a-select-option\n                        >\n                        <a-select-option\n                          v-for=\"county in counties\"\n                          :value=\"county.org_id\"\n                          :key=\"county.id\"\n                          :org_id=\"county.org_id\"\n                        >\n                          {{ county.name }}\n                        </a-select-option>\n                      </a-select>\n                    </a-form-item>\n                    <a-form-item name=\"sub_county_id\" label=\"Sub County\">\n                      <a-select\n                        size=\"large\"\n                        name=\"basic-select\"\n                        class=\"sDash_fullwidth-select\"\n                        placeholder=\"Select Sub-County\"\n                        v-model:value=\"formState.sub_county_id\"\n                      >\n                        <a-select-option value=\"\"\n                          >Select an option</a-select-option\n                        >\n                        <a-select-option\n                          v-for=\"scounty in sub_counties\"\n                          :value=\"scounty.org_id\"\n                          :key=\"scounty.id\"\n                          >{{ scounty.name }}</a-select-option\n                        >\n                      </a-select>\n                    </a-form-item>\n\n                    <div class=\"record-form-actions text-right\">\n                      <sdButton size=\"default\" htmlType=\"Save\" type=\"success\">\n                        {{ isLoading ? \"Loading...\" : \"Submit\" }}\n                      </sdButton>\n                    </div>\n                  </a-form>\n                </BasicFormWrapper>\n              </a-col>\n            </a-row>\n          </sdCards>\n        </RecordFormWrapper>\n      </a-col>\n    </a-row>\n  </Main>\n</template>\n<script>\nimport { RecordFormWrapper } from \"../style\";\nimport { Main, BasicFormWrapper } from \"../../styled\";\nimport { useStore } from \"vuex\";\nimport { reactive, ref, defineComponent, computed, onMounted } from \"vue\";\nimport { notification } from \"ant-design-vue\";\nimport authHeader from \"../../../services/auth-header\";\nimport { useRouter } from \"vue-router\";\n\nconst dateFormat = \"YYYY-MM-DD\";\n\nconst AddNew = defineComponent({\n  name: \"AddNew\",\n  components: { RecordFormWrapper, Main, BasicFormWrapper },\n  data() {\n    const { state } = useStore();\n    const isLoading = computed(() => state.crud.loading);\n    const apiUrl = computed(() => state.crud.url);\n    const isFileLoading = computed(() => state.crud.fileLoading);\n    const join = ref(\"\");\n    const API_URL = `${process.env.VUE_APP_BASE_URL}/new_drop_off_points`;\n    const router = useRouter();\n    const campaign_url = `${process.env.VUE_APP_BASE_URL}/campaign_all`;\n\n    const { loading, campaigns, sub_counties, counties } = reactive({\n      campaigns: [],\n      counties: [],\n      sub_counties: [],\n      loading: true,\n    });\n\n    const formState = reactive({\n      name: \"\",\n      campaign_id: \"\",\n      county_id: \"\",\n      sub_county: \"\",\n    });\n\n    console.log(formState);\n\n    //campaigns\n    const getCampaigns = async () => {\n      const response = await fetch(campaign_url, {\n        method: \"GET\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          ...authHeader(),\n        },\n      });\n      const data = await response.json();\n      this.campaigns = data.data;\n      console.log(data.data);\n      this.loading = false;\n    };\n\n    //counties\n    const getCounties = async () => {\n      const response = await fetch(`${process.env.VUE_APP_BASE_URL}/counties`, {\n        method: \"GET\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          ...authHeader(),\n        },\n      });\n\n      const data = await response.json();\n      this.counties = data.map((county) => ({\n        ...county,\n        // org_id: county.org_id,\n      }));\n      console.log(this.counties);\n      this.loading = false;\n    };\n\n    //get sub_counties\n    const getSubCounties = async (org_id) => {\n      const response = await fetch(\n        `${process.env.VUE_APP_BASE_URL}/get_sub_counties_list?parent_id=${org_id}`,\n        {\n          method: \"GET\",\n          headers: {\n            \"Content-Type\": \"application/json\",\n            ...authHeader(),\n          },\n        }\n      );\n      const data = await response.json();\n    //   console.log(data.message);\n      this.sub_counties = data.message;\n    };\n\n    onMounted(() => {\n      getCounties();\n      getCampaigns();\n      getSubCounties();\n      console.log(getCounties());\n    });\n\n    const handleSubmit = (values) => {\n      console.log(values);\n      values = {\n        name: values.name,\n        campaign_id: values.campaign_id,\n        ou_sub_county: values.sub_county_id,\n      };\n      console.log(values);\n\n      fetch(API_URL, {\n        method: \"POST\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          ...authHeader(),\n        },\n        body: JSON.stringify(values),\n      })\n        .then((response) => response.json())\n        .then((data) => {\n          console.log(data);\n          console.log(\".......... \");\n          console.log(API_URL);\n          if (data.status == true) {\n            router.push(\"/nets/distribution-points\");\n            notification[\"success\"]({\n              message: \"Distribution Point Created\",\n              description: `Distribution Point Created successfully.`,\n              duration: 5.5,\n            });\n          } else {\n            notification[\"error\"]({\n              message: \"Distribution Point Creation Failed\",\n              description: `Distribution Point Creation failed.`,\n              duration: 5.5,\n            });\n          }\n        })\n        .catch((error) => {\n          console.error(\"Error:\", error);\n        });\n    };\n\n    return {\n      isLoading,\n      loading,\n      apiUrl,\n      isFileLoading,\n      handleSubmit,\n      dateFormat,\n      formState,\n      join,\n      getSubCounties,\n      sub_counties,\n      campaigns,\n      counties,\n    };\n  },\n  beforeRouteEnter(to, from, next) {\n    if (!sessionStorage.getItem(\"user\")) {\n      next(\"/auth/login\");\n    } else {\n      next();\n    }\n  },\n});\n\nexport default AddNew;\n</script>\n"],"mappings":";;;AA2GA,SAASA,iBAAgB,QAAS,UAAU;AAC5C,SAASC,IAAI,EAAEC,gBAAe,QAAS,cAAc;AACrD,SAASC,QAAO,QAAS,MAAM;AAC/B,SAASC,QAAQ,EAAEC,GAAG,EAAEC,eAAe,EAAEC,QAAQ,EAAEC,SAAQ,QAAS,KAAK;AAEzE,OAAOC,UAAS,MAAO,+BAA+B;AACtD,SAASC,SAAQ,QAAS,YAAY;AAEtC,MAAMC,UAAS,GAAI,YAAY;AAE/B,MAAMC,MAAK,GAAIN,eAAe,CAAC;EAC7BO,IAAI,EAAE,QAAQ;EACdC,UAAU,EAAE;IAAEd,iBAAiB;IAAEC,IAAI;IAAEC;EAAiB,CAAC;EACzDa,IAAIA,CAAA,EAAG;IACL,MAAM;MAAEC;IAAM,IAAIb,QAAQ,EAAE;IAC5B,MAAMc,SAAQ,GAAIV,QAAQ,CAAC,MAAMS,KAAK,CAACE,IAAI,CAACC,OAAO,CAAC;IACpD,MAAMC,MAAK,GAAIb,QAAQ,CAAC,MAAMS,KAAK,CAACE,IAAI,CAACG,GAAG,CAAC;IAC7C,MAAMC,aAAY,GAAIf,QAAQ,CAAC,MAAMS,KAAK,CAACE,IAAI,CAACK,WAAW,CAAC;IAC5D,MAAMC,IAAG,GAAInB,GAAG,CAAC,EAAE,CAAC;IACpB,MAAMoB,OAAM,GAAK,GAAEC,OAAO,CAACC,GAAG,CAACC,gBAAiB,sBAAqB;IACrE,MAAMC,MAAK,GAAInB,SAAS,EAAE;IAC1B,MAAMoB,YAAW,GAAK,GAAEJ,OAAO,CAACC,GAAG,CAACC,gBAAiB,eAAc;IAEnE,MAAM;MAAET,OAAO;MAAEY,SAAS;MAAEC,YAAY;MAAEC;IAAS,IAAI7B,QAAQ,CAAC;MAC9D2B,SAAS,EAAE,EAAE;MACbE,QAAQ,EAAE,EAAE;MACZD,YAAY,EAAE,EAAE;MAChBb,OAAO,EAAE;IACX,CAAC,CAAC;IAEF,MAAMe,SAAQ,GAAI9B,QAAQ,CAAC;MACzBS,IAAI,EAAE,EAAE;MACRsB,WAAW,EAAE,EAAE;MACfC,SAAS,EAAE,EAAE;MACbC,UAAU,EAAE;IACd,CAAC,CAAC;IAEFC,OAA