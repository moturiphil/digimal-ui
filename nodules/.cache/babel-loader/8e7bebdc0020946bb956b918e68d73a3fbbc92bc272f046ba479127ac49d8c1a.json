{"ast":null,"code":"import { onMounted, ref, defineComponent } from 'vue';\nimport { CustomDropDown } from './styled';\nexport default defineComponent({\n  name: 'CalendarButton',\n  components: {\n    CustomDropDown\n  },\n  data() {\n    return {\n      range: {\n        start: new Date(2021, 0, 1),\n        end: new Date(2021, 0, 5)\n      }\n    };\n  },\n  setup() {\n    const isVisible = ref(false);\n    const handleVisible = () => {\n      isVisible.value = !isVisible.value;\n    };\n    onMounted(() => {\n      document.body.addEventListener('click', e => {\n        if (e.target.closest('#dropdownParent')) {\n          return false;\n        } else {\n          isVisible.value = false;\n        }\n      });\n    });\n    return {\n      handleVisible,\n      isVisible\n    };\n  }\n});","map":{"version":3,"names":["onMounted","ref","defineComponent","CustomDropDown","name","components","data","range","start","Date","end","setup","isVisible","handleVisible","value","document","body","addEventListener","e","target","closest"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/components/buttons/CalendarButton.vue"],"sourcesContent":["<template>\r\n  <CustomDropDown id=\"dropdownParent\">\r\n    <div\r\n      v-if=\"isVisible\"\r\n      class=\"sDash-range-calendar\"\r\n      placement=\"bottomRight\"\r\n      title=\"Search by Calendar\"\r\n      action=\"click\"\r\n    >\r\n      <v-calendar :columns=\"$screens({ default: 1, lg: 2 })\" is-expanded v-model=\"range\" is-range />\r\n    </div>\r\n    <sdButton @click=\"handleVisible\" size=\"small\" type=\"white\">\r\n      <sdFeatherIcons type=\"calendar\" size=\"14\" />\r\n      <span>Calendar</span>\r\n    </sdButton>\r\n  </CustomDropDown>\r\n</template>\r\n\r\n<script>\r\nimport { onMounted, ref, defineComponent } from 'vue';\r\nimport { CustomDropDown } from './styled';\r\n\r\nexport default defineComponent({\r\n  name: 'CalendarButton',\r\n  components: {\r\n    CustomDropDown,\r\n  },\r\n  data() {\r\n    return {\r\n      range: {\r\n        start: new Date(2021, 0, 1),\r\n        end: new Date(2021, 0, 5),\r\n      },\r\n    };\r\n  },\r\n  setup() {\r\n    const isVisible = ref(false);\r\n    const handleVisible = () => {\r\n      isVisible.value = !isVisible.value;\r\n    };\r\n\r\n    onMounted(() => {\r\n      document.body.addEventListener('click', (e) => {\r\n        if (e.target.closest('#dropdownParent')) {\r\n          return false;\r\n        } else {\r\n          isVisible.value = false;\r\n        }\r\n      });\r\n    });\r\n\r\n    return {\r\n      handleVisible,\r\n      isVisible,\r\n    };\r\n  },\r\n});\r\n</script>\r\n\r\n<style>\r\n.ant-page-header-heading {\r\n  overflow: visible;\r\n}\r\n</style>\r\n"],"mappings":"AAmBA,SAASA,SAAS,EAAEC,GAAG,EAAEC,eAAc,QAAS,KAAK;AACrD,SAASC,cAAa,QAAS,UAAU;AAEzC,eAAeD,eAAe,CAAC;EAC7BE,IAAI,EAAE,gBAAgB;EACtBC,UAAU,EAAE;IACVF;EACF,CAAC;EACDG,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,KAAK,EAAE;QACLC,KAAK,EAAE,IAAIC,IAAI,CAAC,IAAI,EAAE,CAAC,EAAE,CAAC,CAAC;QAC3BC,GAAG,EAAE,IAAID,IAAI,CAAC,IAAI,EAAE,CAAC,EAAE,CAAC;MAC1B;IACF,CAAC;EACH,CAAC;EACDE,KAAKA,CAAA,EAAG;IACN,MAAMC,SAAQ,GAAIX,GAAG,CAAC,KAAK,CAAC;IAC5B,MAAMY,aAAY,GAAIA,CAAA,KAAM;MAC1BD,SAAS,CAACE,KAAI,GAAI,CAACF,SAAS,CAACE,KAAK;IACpC,CAAC;IAEDd,SAAS,CAAC,MAAM;MACde,QAAQ,CAACC,IAAI,CAACC,gBAAgB,CAAC,OAAO,EAAGC,CAAC,IAAK;QAC7C,IAAIA,CAAC,CAACC,MAAM,CAACC,OAAO,CAAC,iBAAiB,CAAC,EAAE;UACvC,OAAO,KAAK;QACd,OAAO;UACLR,SAAS,CAACE,KAAI,GAAI,KAAK;QACzB;MACF,CAAC,CAAC;IACJ,CAAC,CAAC;IAEF,OAAO;MACLD,aAAa;MACbD;IACF,CAAC;EACH;AACF,CAAC,CAAC"},"metadata":{},"sourceType":"module","externalDependencies":[]}