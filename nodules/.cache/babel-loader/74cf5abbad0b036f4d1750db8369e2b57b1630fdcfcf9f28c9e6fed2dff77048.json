{"ast":null,"code":"import { Main } from '../styled';\nimport { defineComponent } from 'vue';\nimport { BadgeWraperStyle, BadgeStandAloneStyle, BadgeOverflowStyle, BadgeRedStyle, BadgeDynamicStyle } from './ui-elements-styled';\nimport { mapState } from 'vuex';\nexport default defineComponent({\n  name: 'Badge',\n  components: {\n    Main,\n    BadgeWraperStyle,\n    BadgeStandAloneStyle,\n    BadgeOverflowStyle,\n    BadgeRedStyle,\n    BadgeDynamicStyle\n  },\n  data() {\n    return {\n      colors: ['pink', 'red', 'yellow', 'orange', 'cyan', 'green', 'blue', 'purple', 'geekblue', 'magenta', 'volcano', 'gold', 'lime'],\n      count: 5,\n      show: true\n    };\n  },\n  methods: {\n    increase() {\n      this.count = this.count + 1;\n    },\n    decline() {\n      let count = this.count - 1;\n      if (count < 0) {\n        count = 0;\n      }\n      this.count = count;\n    },\n    onChange(show) {\n      this.show = show;\n    }\n  },\n  computed: {\n    ...mapState(['rtl'])\n  }\n});","map":{"version":3,"names":["Main","defineComponent","BadgeWraperStyle","BadgeStandAloneStyle","BadgeOverflowStyle","BadgeRedStyle","BadgeDynamicStyle","mapState","name","components","data","colors","count","show","methods","increase","decline","onChange","computed"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/uiElements/Badge.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <sdPageHeader title=\"Blank Page\">\r\n      <template v-slot:buttons>\r\n        <div class=\"page-header-actions\">\r\n          <sdCalendarButton />\r\n          <sdExportButton />\r\n          <sdShareButton />\r\n          <sdButton size=\"small\" type=\"primary\">\r\n            <sdFeatherIcons type=\"plus\" size=\"14\" />\r\n            Add New\r\n          </sdButton>\r\n        </div>\r\n      </template>\r\n    </sdPageHeader>\r\n    <Main>\r\n      <a-row :gutter=\"25\">\r\n        <a-col :md=\"12\" :sm=\"12\" :xs=\"24\">\r\n          <sdCards title=\"Basic\">\r\n            