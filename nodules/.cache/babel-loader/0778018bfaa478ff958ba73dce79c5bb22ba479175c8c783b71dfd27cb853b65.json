ction updateSize() {\n          const width = window.innerWidth;\n          responsive.value = width;\n        }\n        window.addEventListener(\"resize\", updateSize);\n        updateSize();\n        // return () => window.removeEventListener('resize', updateSize);\n      });\n  \n      const toggleCollapsed = () => {\n        collapsed.value = !collapsed.value;\n      };\n  \n      return {\n        taskData,\n        responsive,\n        collapsed,\n        visible,\n        modalType,\n        showModal,\n        handleCancel,\n        handleAddTask,\n        toggleCollapsed,\n        formState,\n        path,\n      };\n    },\n  });\n  \n  export default Task;\n  </script>\n  "],"mappings":";AA+LE,SAASA,YAAY,EAAEC,WAAU,QAAS,SAAS;AACnD,SAASC,IAAI,EAAEC,gBAAe,QAAS,cAAc;AACrD,SAASC,QAAO,QAAS,MAAM;AAC/B,SAASC,QAAQ,EAAEC,WAAW,EAAEC,GAAG,EAAEC,QAAQ,EAAEC,eAAc,QAAS,KAAK;AAC3E,SAASC,QAAO,QAAS,YAAY;AAErC,MAAMC,IAAG,GAAIF,eAAe,CAAC;EAC3BG,IAAI,EAAE,MAAM;EACZC,UAAU,EAAE;IAAEb,YAAY;IAAEC,WAAW;IAAEC,IAAI;IAAEC;EAAiB,CAAC;EACjEW,KAAKA,CAAA,EAAG;IACN,MAAM;MAAEC,KAAK;MAAEC;IAAS,IAAIZ,QAAQ,EAAE;IACtC,MAAMa,QAAO,GAAIZ,QAAQ,CAAC,MAAMU,KAAK,CAACG,IAAI,CAACC,IAAI,CAAC;IAChD,MAAMC,UAAS,GAAIb,GAAG,CAAC,CAAC,CAAC;IACzB,MAAMc,SAAQ,GAAId,GAAG,CAAC,KAAK,CAAC;IAC5B,MAAMe,OAAM,GAAIf,GAAG,CAAC,KAAK,CAAC;IAC1B,MAAMgB,SAAQ,GAAIhB,GAAG,CAAC,SAAS,CAAC;IAChC,MAAM;MAAEiB;IAAQ,IAAId,QAAQ,EAAE;IAC9B,MAAM;MAAEe;IAAK,IAAID,OAAO,CAAC,CAAC,CAAC;IAE3B,MAAME,SAAQ,GAAIA,CAAA,KAAM;MACtBJ,OAAO,CAACK,KAAI,GAAI,IAAI;MACpBN,SAAS,CAACM,KAAI,GAAI,KAAK;IACzB,CAAC;IACD,MAAMC,YAAW,GAAIA,CAAA,KAAM;MACzBN,OAAO,CAACK,KAAI,GAAI,KAAK;IACvB,CAAC;IAED,MAAME,SAAQ,GAAIrB,QAAQ,CAAC;MACzBsB,KAAK,EAAE,EAAE;MACTC,WAAW,EAAE,EAAE;MACfC,MAAM,EAAE;IACV,CAAC,CAAC;IAEF,MAAMC,aAAY,GAAKC,MAAM,IAAK;MAChCN,YAAY,EAAE;MACd,MAAMO,SAAQ,GAAI,EAAE;MACpBlB,QAAQ,CAACU,KAAK,CAACS,GAAG,CAAEjB,IAAI,IAAK;QAC3B,OAAOgB,SAAS,CAACE,IAAI,CAAClB,IAAI,CAACmB,EAAE,CAAC;MAChC,CAAC,CAAC;MACF,MAAMC,GAAE,GAAIC,IAAI,CAACD,GAAG,CAAC,GAAGJ,SAAS,CAAC;MAClCnB,QAA