{"ast":null,"code":"import { RecordViewWrapper } from \"../style\";\nimport { Main, TableWrapper } from \"../../styled\";\nimport { useStore } from \"vuex\";\nimport { computed, onMounted, ref, reactive, defineComponent } from \"vue\";\n// import axios from \"axios\";\nimport authHeader from \"../../../services/auth-header\";\nimport UserService from \"../../../services/user.service\";\nimport * as FileSaver from \"file-saver\";\nimport * as XLSX from \"xlsx\";\nconst columns = [{\n  title: \"First Name\",\n  dataIndex: \"first_name\",\n  key: \"id\"\n}, {\n  title: \"Middle Name\",\n  dataIndex: \"middle_name\",\n  key: \"id\"\n}, {\n  title: \"Last Name\",\n  dataIndex: \"last_name\",\n  key: \"id\"\n}, {\n  title: \"Level\",\n  dataIndex: \"level_id\",\n  key: \"id\"\n}, {\n  title: \"Organization\",\n  dataIndex: \"org_types_id\",\n  key: \"id\"\n}, {\n  title: \"Role\",\n  dataIndex: \"role_id\",\n  key: \"id\"\n}, {\n  title: \"Phone Number\",\n  dataIndex: \"phone_no\",\n  key: \"id\"\n}];\nconst DragAndDropTable = defineComponent({\n  name: \"ViewPage\",\n  components: {\n    RecordViewWrapper,\n    Main,\n    TableWrapper\n  },\n  setup() {\n    const {\n      state,\n      dispatch\n    } = useStore();\n    const crud = computed(() => state.crud.data);\n    const isLoading = computed(() => state.crud.loading);\n    const selectedRowKeys = ref([]);\n    const dataSource = ref([]);\n    const showModal = () => {\n      isModalVisible.value = true;\n    };\n    const isModalVisible = ref(false);\n    const fileName = ref(\"DigiMal Users\");\n    const convertedTo = ref(\"csv\");\n    console.log(authHeader());\n    const api_url = UserService;\n    console.log(api_url);\n    onMounted(async () => {\n      try {\n        const response = await fetch(`${process.env.VUE_APP_BASE_URL}/users`, {\n          method: \"GET\",\n          headers: authHeader()\n        });\n        const data = await response.json();\n        dataSource.value = data.data;\n        console.log(data.data);\n      } catch (error) {\n        console.error(error);\n      }\n    });\n    const handleDelete = id => {\n      const confirm = window.confirm(\"Are you sure delete this?\");\n      if (confirm) {\n        dispatch(\"axiosDataDelete\", {\n          id,\n          getData: () => {\n            dispatch(\"axiosCrudGetData\");\n          }\n        });\n      }\n      return false;\n    };\n    const fileType = \"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;charset=UTF-8\";\n    const xlsxExtension = \".xlsx\";\n    const exportToXLSX = (inputData, fileName) => {\n      const ws = XLSX.utils.json_to_sheet(inputData);\n      const wb = {\n        Sheets: {\n          data: ws\n        },\n        SheetNames: [\"data\"]\n      };\n      const excelBuffer = XLSX.write(wb, {\n        bookType: \"xlsx\",\n        type: \"array\"\n      });\n      const data = new Blob([excelBuffer], {\n        type: fileType\n      });\n      FileSaver.saveAs(data, fileName + xlsxExtension);\n      isModalVisible.value = false;\n    };\n    const updateFileName = e => {\n      fileName.value = e.target.value;\n    };\n    const updateFileType = value => {\n      convertedTo.value = value;\n    };\n    const formState = reactive({\n      searchItem: \"\"\n    });\n    const onSelectChange = selectedRowKey => {\n      selectedRowKeys.value = selectedRowKey;\n    };\n    const rowSelection = {\n      selectedRowKeys,\n      onChange: onSelectChange\n    };\n    return {\n      crud,\n      isLoading,\n      selectedRowKeys,\n      handleDelete,\n      rowSelection,\n      onSelectChange,\n      dataSource,\n      columns,\n      formState,\n      showModal,\n      exportToXLSX,\n      updateFileName,\n      updateFileType,\n      fileType,\n      xlsxExtension\n    };\n  }\n});\nexport default DragAndDropTable;","map":{"version":3,"names":["RecordViewWrapper","Main","TableWrapper","useStore","computed","onMounted","ref","reactive","defineComponent","authHeader","UserService","FileSaver","XLSX","columns","title","dataIndex","key","DragAndDropTable","name","components","setup","state","dispatch","crud","data","isLoading","loading","selectedRowKeys","dataSource","showModal","isModalVisible","value","fileName","convertedTo","console","log","api_url","response","fetch","process","env","VUE_APP_BASE_URL","method","headers","json","error","handleDelete","id","confirm","window","getData","fileType","xlsxExtension","exportToXLSX","inputData","ws","utils","json_to_sheet","wb","Sheets","SheetNames","excelBuffer","write","bookType","type","Blob","saveAs","updateFileName","e","target","updateFileType","formState","searchItem","onSelectChange","selectedRowKey","rowSelection","onChange"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/pages/users/regUser.vue"],"sourcesContent":["<template>\n  <RecordViewWrapper>\n    <sdPageHeader title=\"Users\">\n      <template #subTitle>\n        <sdButton class=\"btn-add_new\" size=\"default\" type=\"success\"> </sdButton>\n      </template>\n    </sdPageHeader>\n    <Main>\n      <a-row :gutter=\"15\">\n        <a-col class=\"w-100\" :md=\"24\">\n          <sdCards headless>\n            <div v-if=\"isLoading\" class=\"spin\">\n              <a-spin />\n            </div>\n\n            <div v-else>\n              <TableWrapper class=\"table-data-view table-responsive\">\n                <sdButton class=\"btn-export\" @click=\"showModal\" type=\"success\">\n                  Export\n                </sdButton>\n                <sdModal\n                  title=\"Export File\"\n                  wrapclass=\"sDash_export-wrap\"\n                  :visible=\"isModalVisible\"\n                  :footer=\"null\"\n                  :onCancel=\"handleCancel\"\n                  class=\"export-modal\"\n                >\n                  <a-form name=\"contact\">\n                    <a-form-item name=\"f_name\">\n                      <a-input\n                        placeholder=\"File Name\"\n                        v-model:value=\"fileName\"\n                        @change=\"updateFileName\"\n                      />\n                    </a-form-item>\n                    <a-form-item name=\"f_type\">\n                      <a-select default-value=\"xlxs\" @change=\"updateFileType\">\n                        <!-- <a-select-option value=\"csv\">CSV</a-select-option> -->\n                        <a-select-option value=\"xlxs\">xlxs</a-select-option>\n                      </a-select>\n                    </a-form-item>\n                    <div class=\"sDash-button-grp\">\n                      <!-- <CSVLink v-if=\"convertedTo === 'csv'\" :filename=\"`${fileName}.csv`\" :data=\"csvJsonData\">\n                        <sdButton @click=\"handleCancel\" class=\"btn-export\" type=\"primary\">\n                          Export\n                        </sdButton>\n                      </CSVLink> -->\n\n                      <sdButton\n                        class=\"btn-export\"\n                        @click=\"() => exportToXLSX(csvData, fileName)\"\n                        type=\"primary\"\n                      >\n                        Export\n                      </sdButton>\n\n                      <sdButton\n                        htmlType=\"button\"\n                        @click=\"handleCancel\"\n                        size=\"default\"\n                        type=\"light\"\n                        outlined\n                      >\n                        Cancel\n                      </sdButton>\n                    </div>\n                  </a-form>\n                </sdModal>\n                <br />\n                <br />\n                <a-table\n                  :rowSelection=\"rowSelection\"\n                  :pagination=\"{ pageSize: 10, showSizeChanger: true }\"\n                  :dataSource=\"dataSource\"\n                  :columns=\"columns\"\n                />\n              </TableWrapper>\n            </div>\n          </sdCards>\n        </a-col>\n      </a-row>\n      <a-col :xs=\"24\">\n        <DragAndDropTable />\n      </a-col>\n    </Main>\n  </RecordViewWrapper>\n</template>\n<script>\nimport { RecordViewWrapper } from \"../style\";\nimport { Main, TableWrapper } from \"../../styled\";\nimport { useStore } from \"vuex\";\nimport { computed, onMounted, ref, reactive, defineComponent } from \"vue\";\n// import axios from \"axios\";\nimport authHeader from \"../../../services/auth-header\";\nimport UserService from \"../../../services/user.service\";\nimport * as FileSaver from \"file-saver\";\nimport * as XLSX from \"xlsx\";\n\n\nconst columns = [\n  {\n    title: \"First Name\",\n    dataIndex: \"first_name\",\n    key: \"id\",\n  },\n  {\n    title: \"Middle Name\",\n    dataIndex: \"middle_name\",\n    key: \"id\",\n  },\n  {\n    title: \"Last Name\",\n    dataIndex: \"last_name\",\n    key: \"id\",\n  },\n  {\n    title: \"Level\",\n    dataIndex: \"level_id\",\n    key: \"id\",\n  },\n  {\n    title: \"Organization\",\n    dataIndex: \"org_types_id\",\n    key: \"id\",\n  },\n  {\n    title: \"Role\",\n    dataIndex: \"role_id\",\n    key: \"id\",\n  },\n  {\n    title: \"Phone Number\",\n    dataIndex: \"phone_no\",\n    key: \"id\",\n  },\n];\n\nconst DragAndDropTable = defineComponent({\n  name: \"ViewPage\",\n  components: { RecordViewWrapper, Main, TableWrapper },\n\n  setup() {\n    const { state, dispatch } = useStore();\n    const crud = computed(() => state.crud.data);\n    const isLoading = computed(() => state.crud.loading);\n    const selectedRowKeys = ref([]);\n    const dataSource = ref([]);\n    const showModal = () => {\n      isModalVisible.value = true;\n    };\n    const isModalVisible = ref(false);\n    const fileName = ref(\"DigiMal Users\");\n    const convertedTo = ref(\"csv\");\n\n    console.log(authHeader());\n\n    const api_url = UserService;\n    console.log(api_url);\n\n    onMounted(async () => {\n      try {\n        const response = await fetch(`${process.env.VUE_APP_BASE_URL}/users`, {\n          method: \"GET\",\n          headers: authHeader(),\n        });\n        const data = await response.json();\n        dataSource.value = data.data;\n        console.log(data.data);\n      } catch (error) {\n        console.error(error);\n      }\n    });\n\n    const handleDelete = (id) => {\n      const confirm = window.confirm(\"Are you sure delete this?\");\n      if (confirm) {\n        dispatch(\"axiosDataDelete\", {\n          id,\n          getData: () => {\n            dispatch(\"axiosCrudGetData\");\n          },\n        });\n      }\n      return false;\n    };\n\n    const fileType =\n      \"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;charset=UTF-8\";\n    const xlsxExtension = \".xlsx\";\n\n    const exportToXLSX = (inputData, fileName) => {\n      const ws = XLSX.utils.json_to_sheet(inputData);\n      const wb = { Sheets: { data: ws }, SheetNames: [\"data\"] };\n      const excelBuffer = XLSX.write(wb, { bookType: \"xlsx\", type: \"array\" });\n      const data = new Blob([excelBuffer], { type: fileType });\n      FileSaver.saveAs(data, fileName + xlsxExtension);\n      isModalVisible.value = false;\n    };\n\n    const updateFileName = (e) => {\n      fileName.value = e.target.value;\n    };\n    const updateFileType = (value) => {\n      convertedTo.value = value;\n    };\n\n    const formState = reactive({\n      searchItem: \"\",\n    });\n\n    const onSelectChange = (selectedRowKey) => {\n      selectedRowKeys.value = selectedRowKey;\n    };\n\n    const rowSelection = {\n      selectedRowKeys,\n      onChange: onSelectChange,\n    };\n\n    return {\n      crud,\n      isLoading,\n      selectedRowKeys,\n      handleDelete,\n      rowSelection,\n      onSelectChange,\n      dataSource,\n      columns,\n      formState,\n      showModal,\n      exportToXLSX,\n      updateFileName,\n      updateFileType,\n      fileType,\n      xlsxExtension,\n    };\n  },\n});\n\nexport default DragAndDropTable;\n</script>\n"],"mappings":"AAyFA,SAASA,iBAAgB,QAAS,UAAU;AAC5C,SAASC,IAAI,EAAEC,YAAW,QAAS,cAAc;AACjD,SAASC,QAAO,QAAS,MAAM;AAC/B,SAASC,QAAQ,EAAEC,SAAS,EAAEC,GAAG,EAAEC,QAAQ,EAAEC,eAAc,QAAS,KAAK;AACzE;AACA,OAAOC,UAAS,MAAO,+BAA+B;AACtD,OAAOC,WAAU,MAAO,gCAAgC;AACxD,OAAO,KAAKC,SAAQ,MAAO,YAAY;AACvC,OAAO,KAAKC,IAAG,MAAO,MAAM;AAG5B,MAAMC,OAAM,GAAI,CACd;EACEC,KAAK,EAAE,YAAY;EACnBC,SAAS,EAAE,YAAY;EACvBC,GAAG,EAAE;AACP,CAAC,EACD;EACEF,KAAK,EAAE,aAAa;EACpBC,SAAS,EAAE,aAAa;EACxBC,GAAG,EAAE;AACP,CAAC,EACD;EACEF,KAAK,EAAE,WAAW;EAClBC,SAAS,EAAE,WAAW;EACtBC,GAAG,EAAE;AACP,CAAC,EACD;EACEF,KAAK,EAAE,OAAO;EACdC,SAAS,EAAE,UAAU;EACrBC,GAAG,EAAE;AACP,CAAC,EACD;EACEF,KAAK,EAAE,cAAc;EACrBC,SAAS,EAAE,cAAc;EACzBC,GAAG,EAAE;AACP,CAAC,EACD;EACEF,KAAK,EAAE,MAAM;EACbC,SAAS,EAAE,SAAS;EACpBC,GAAG,EAAE;AACP,CAAC,EACD;EACEF,KAAK,EAAE,cAAc;EACrBC,SAAS,EAAE,UAAU;EACrBC,GAAG,EAAE;AACP,CAAC,CACF;AAED,MAAMC,gBAAe,GAAIT,eAAe,CAAC;EACvCU,IAAI,EAAE,UAAU;EAChBC,UAAU,EAAE;IAAEnB,iBAAiB;IAAEC,IAAI;IAAEC;EAAa,CAAC;EAErDkB,KAAKA,CAAA,EAAG;IACN,MAAM;MAAEC,KAAK;MAAEC;IAAS,IAAInB,QAAQ,EAAE;IACtC,MAAMoB,IAAG,GAAInB,QAAQ,CAAC,MAAMiB,KAAK,CAACE,IAAI,CAACC,IAAI,CAAC;IAC5C,MAAMC,SAAQ,GAAIrB,QAAQ,CAAC,MAAMiB,KAAK,CAACE,IAAI,CAACG,OAAO,CAAC;IACpD,MAAMC,eAAc,GAAIrB,GAAG,CAAC,EAAE,CAAC;IAC/B,MAAMsB,UAAS,GAAItB,GAAG,CAAC,EAAE,CAAC;IAC1B,MAAMuB,SAAQ,GAAIA,CAAA,KAAM;MACtBC,cAAc,CAACC,KAAI,GAAI,IAAI;IAC7B,CAAC;IACD,MAAMD,cAAa,GAAIxB,GAAG,CAAC,KAAK,CAAC;IACjC,MAAM0B,QAAO,GAAI1B,GAAG,CAAC,eAAe,CAAC;IACrC,MAAM2B,WAAU,GAAI3B,GAAG,CAAC,KAAK,CAAC;IAE9B4B,OAAO,CAACC,GAAG,CAAC1B,UAAU,EAAE,CAAC;IAEzB,MAAM2B,OAAM,GAAI1B,WAAW;IAC3BwB,OAAO,CAACC,GAAG,CAACC,OAAO,CAAC;IAEpB/B,SAAS,CAAC,YAAY;MACpB,IAAI;QACF,MAAMgC,QAAO,GAAI,MAAMC,KAAK,CAAE,GAAEC,OAAO,CAACC,GAAG,CAACC,gBAAiB,QAAO,EAAE;UACpEC,MAAM,EAAE,KAAK;UACbC,OAAO,EAAElC,UAAU;QACrB,CAAC,CAAC;QACF,MAAMe,IAAG,GAAI,MAAMa,QAAQ,CAACO,IAAI,EAAE;QAClChB,UAAU,CAACG,KAAI,GAAIP,IAAI,CAACA,IAAI;QAC5BU,OAAO,CAACC,GAAG,CAACX,IAAI,CAACA,IAAI,CAAC;MACxB,EA