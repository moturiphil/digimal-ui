{"ast":null,"code":"import { CheckOutlined, CloseOutlined } from '@ant-design/icons-vue';\nimport { Main } from '../styled';\nimport { ref, reactive, toRefs, defineComponent } from 'vue';\nexport default defineComponent({\n  name: 'Switch',\n  components: {\n    Main,\n    CheckOutlined,\n    CloseOutlined\n  },\n  setup() {\n    const checked = ref(false);\n    const state = reactive({\n      checked1: true,\n      checked2: false,\n      checked3: true,\n      checked4: false,\n      checked5: false,\n      checked6: true,\n      checked7: false\n    });\n    return {\n      checked,\n      ...toRefs(state)\n    };\n  }\n});","map":{"version":3,"names":["CheckOutlined","CloseOutlined","Main","ref","reactive","toRefs","defineComponent","name","components","setup","checked","state","checked1","checked2","checked3","checked4","checked5","checked6","checked7"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/uiElements/Switch.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <sdPageHeader title=\"Switch\">\r\n      <template v-slot:buttons>\r\n        <div class=\"page-header-actions\">\r\n          <sdCalendarButton />\r\n          <sdExportButton />\r\n          <sdShareButton />\r\n          <sdButton size=\"small\" type=\"primary\">\r\n            Add New\r\n          </sdButton>\r\n        </div>\r\n      </template>\r\n    </sdPageHeader>\r\n    <Main>\r\n      <a-row :gutter=\"25\">\r\n        <a-col :md=\"12\" :sm=\"24\" :xs=\"24\">\r\n          <sdCards title=\"Basic\"><a-switch v-model:checked=\"checked\" /> </sdCards>\r\n        </a-col>\r\n        <a-col :md=\"12\" :sm=\"24\" :xs=\"24\">\r\n          <sdCards title=\"Size\">\r\n            <div class=\"sDash-switch-list\">\r\n              <a-switch v-model:checked=\"checked1\" />\r\n              <a-switch size=\"small\" v-model:checked=\"checked2\" />\r\n            </div>\r\n          </sdCards>\r\n        </a-col>\r\n        <a-col :md=\"12\" :sm=\"24\" :xs=\"24\">\r\n          <sdCards title=\"Text and Icon\">\r\n            <a-switch checked-children=\"A\" un-checked-children=\"B\" v-model:checked=\"checked3\" />\r\n            <br />\r\n            <a-switch checked-children=\"1\" un-checked-children=\"0\" v-model:checked=\"checked4\" />\r\n            <br />\r\n            <a-switch v-model:checked=\"checked5\">\r\n              <template #checkedChildren><check-outlined /></template>\r\n              <template #unCheckedChildren><close-outlined /></template>\r\n            </a-switch>\r\n          </sdCards>\r\n        </a-col>\r\n        <a-col :md=\"12\" :sm=\"24\" :xs=\"24\">\r\n          <sdCards title=\"Loading\">\r\n            <a-switch loading v-model:checked=\"checked6\" />\r\n            <br />\r\n            <a-switch size=\"small\" loading v-model:checked=\"checked7\" />\r\n          </sdCards>\r\n        </a-col>\r\n      </a-row>\r\n    </Main>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { CheckOutlined, CloseOutlined } from '@ant-design/icons-vue';\r\nimport { Main } from '../styled';\r\nimport { ref, reactive, toRefs, defineComponent } from 'vue';\r\nexport default defineComponent({\r\n  name: 'Switch',\r\n  components: {\r\n    Main,\r\n    CheckOutlined,\r\n    CloseOutlined\r\n  },\r\n  setup() {\r\n    const checked = ref(false);\r\n    const state = reactive({\r\n      checked1: true,\r\n      checked2: false,\r\n      checked3: true,\r\n      checked4: false,\r\n      checked5: false,\r\n      checked6: true,\r\n      checked7: false,\r\n    });\r\n    return {\r\n      checked,\r\n      ...toRefs(state),\r\n    };\r\n  },\r\n});\r\n</script>\r\n"],"mappings":"AAoDA,SAASA,aAAa,EAAEC,aAAY,QAAS,uBAAuB;AACpE,SAASC,IAAG,QAAS,WAAW;AAChC,SAASC,GAAG,EAAEC,QAAQ,EAAEC,MAAM,EAAEC,eAAc,QAAS,KAAK;AAC5D,eAAeA,eAAe,CAAC;EAC7BC,IAAI,EAAE,QAAQ;EACdC,UAAU,EAAE;IACVN,IAAI;IACJF,aAAa;IACbC;EACF,CAAC;EACDQ,KAAKA,CAAA,EAAG;IACN,MAAMC,OAAM,GAAIP,GAAG,CAAC,KAAK,CAAC;IAC1B,MAAMQ,KAAI,GAAIP,QAAQ,CAAC;MACrBQ,QAAQ,EAAE,IAAI;MACdC,QAAQ,EA