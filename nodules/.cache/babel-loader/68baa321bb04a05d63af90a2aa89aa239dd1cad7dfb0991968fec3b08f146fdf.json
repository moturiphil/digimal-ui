         <img :src=\"require(`../../static/img/icon/quote.png`)\" alt=\"\" />\r\n                    </span>\r\n                    <div class=\"testimonial-block__author\">\r\n                      <img :src=\"require(`../../${user.img}`)\" alt=\"\" />\r\n                      <div class=\"author-info\">\r\n                        <h2 class=\"client-name\">{{ user.name }}</h2>\r\n                        <p class=\"client-designation\">{{ user.designation }}</p>\r\n                      </div>\r\n                    </div>\r\n                    <div class=\"testimonial-block__review\">\r\n                      <p>\r\n                        It is a long established fact that a reader will page when looking at its was layout. The point\r\n                        of be distracted by the readable will page when looking at its was layout will page when\r\n                        looking.\r\n                      </p>\r\n                    </div>\r\n                  </SwiperSlide>\r\n                </Swiper>\r\n              </div>\r\n              <div class=\"testimonial-block theme-3\">\r\n                <h2 class=\"testimonial-title\">Testimonial 3</h2>\r\n                <div class=\"testimonial-wrapper\">\r\n                  <Swiper\r\n                    v-bind=\"galleryParams\"\r\n                    :pagination=\"{\r\n                      clickable: true,\r\n                      renderBullet(index, customClass) {\r\n                        return `<span class='${customClass} pagination-thumb'><img src='${require(`../../${users[index].img}`)}' alt='' /></span>`;\r\n                      },\r\n                    }\"\r\n                  >\r\n                    <SwiperSlide v-for=\"(user, index) in users\" :key=\"index + 1\" class=\"testimonial-block__single\">\r\n                      <div class=\"testimonial-block__inner\">\r\n                        <div class=\"testimonial-block__review\">\r\n                          <p>\r\n                            It is a long established fact that a reader will page when looking at its was layout. The\r\n                            point of be distracted by the readable will page when looking at its was layout will page\r\n                            when looking.\r\n                          </p>\r\n                        </div>\r\n                        <div class=\"testimonial-block__author\">\r\n                          <div class=\"author-info\">\r\n                            <h2 class=\"author-name\">{{ user.name }}</h2>\r\n                            <p class=\"author-designation\">\r\n                              {{ user.designation }}\r\n                            </p>\r\n                          </div>\r\n                        </div>\r\n                      </div>\r\n                    </SwiperSlide>\r\n                  </Swiper>\r\n                </div>\r\n              </div>\r\n              <div class=\"testimonial-block theme-4\">\r\n                <h2 class=\"testimonial-title\">Testimonial 4</h2>\r\n                <Swiper v-bind=\"paramsThree\" navigation>\r\n                  <SwiperSlide v-for=\"(user, index) in users\" :key=\"index + 1\" class=\"testimonial-block__single\">\r\n                    <div class=\"testimonial-block__inner\">\r\n                      <div class=\"testimonial-block__author\">\r\n                        <img :src=\"require(`../../${user.img}`)\" alt=\"\" />\r\n                      </div>\r\n                      <div class=\"testimonial-block__review\">\r\n                        <p>\r\n                          It is a long established fact that a reader will page when looking at its was layout. The\r\n                          point of be distracted by the readable will page when looking at its was layout will page when\r\n                          looking.\r\n                        </p>\r\n                      </div>\r\n                      <div class=\"author-info\">\r\n                        <h2 class=\"client-name\">{{ user.name }}</h2>\r\n                        <p class=\"client-designation\">{{ user.designation }}</p>\r\n                      </div>\r\n                    </div>\r\n                  </SwiperSlide>\r\n                </Swiper>\r\n              </div>\r\n            </sdCards>\r\n          </TestimonialStyleWrapper>\r\n        </a-col>\r\n      </a-row>\r\n    </Main>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { Main } from '../styled';\r\nimport { Swiper, SwiperSlide } from 'swiper/vue';\r\nimport { Navigation, Pagination } from 'swiper';\r\nimport { TestimonialStyleWrapper } from './style';\r\nimport { defineComponent } from 'vue';\r\n\r\nimport 'swiper/css';\r\nimport 'swiper/css/pagination';\r\n\r\nexport default defineComponent({\r\n  name: 'Testimonials',\r\n  components: {\r\n    Main,\r\n    Swiper,\r\n    SwiperSlide,\r\n    TestimonialStyleWrapper,\r\n  },\r\n  data() {\r\n    return {\r\n      users: this.$store.state.users.data,\r\n      paramsOne: {\r\n        slidesPerView: 3,\r\n        spaceBetween: 30,\r\n        centeredSlides: true,\r\n        loop: true,\r\n        breakpoints: {\r\n          992: {\r\n            slidesPerView: 3,\r\n            spaceBetween: 20,\r\n          },\r\n          320: {\r\n            slidesPerView: 1,\r\n            spaceBetween: 20,\r\n          },\r\n        },\r\n      },\r\n      paramsTwo: {\r\n        slidesPerView: 2,\r\n        spaceBetween: 30,\r\n        loop: true,\r\n        breakpoints: {\r\n          992: {\r\n            slidesPerView: 2,\r\n            spaceBetween: 20,\r\n          },\r\n          320: {\r\n            slidesPerView: 1,\r\n            spaceBetween: 0,\r\n          },\r\n        },\r\n      },\r\n      galleryParams: {\r\n        slidesPerView: 1,\r\n        centeredSlides: true,\r\n        loop: true,\r\n      },\r\n      paramsThree: {\r\n        slidesPerView: 1,\r\n        centeredSlides: true,\r\n        loop: true,\r\n      },\r\n    }\r\n  },\r\n  setup(){\r\n    return{\r\n      modules: [Navigation, Pagination]\r\n    }\r\n  }\r\n});\r\n</script>\r\n"],"mappings":"AAkIA,SAASA,IAAG,QAAS,WAAW;AAChC,SAASC,MAAM,EAAEC,WAAU,QAAS,YAAY;AAChD,SAASC,UAAU,EAAEC,UAAS,QAAS,QAAQ;AAC/C,SAASC,uBAAsB,QAAS,SAAS;AACjD,SAASC,eAAc,QAAS,KAAK;AAErC,OAAO,YAAY;AACnB,OAAO,uBAAuB;AAE9B,eAAeA,eAAe,CAAC;EAC7BC,IAAI,EAAE,cAAc;EACpBC,UAAU,EAAE;IACVR,IAAI;IACJC,MAAM;IACNC,WAAW;IACXG;EACF,CAAC;EACDI,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,KAAK,EAAE,IAAI,CAACC,MAAM,CAACC,KAAK,CAACF,KAAK,CAACD,IAAI;MACnCI,SAAS,EAAE;QACTC,aAAa,EAAE,CAAC;QAChBC,YAAY,EAAE,EAAE;QAChBC,cAAc,EAAE,IAAI;QACpBC,IAAI,EAAE,IAAI;QACVC,WAAW,EAAE;UACX,GAAG,EAAE;YACHJ,aAAa,EAAE,CAAC;YAChBC,YAAY,EAAE;UAChB,CAAC;UACD,GAAG,EAAE;YACHD,aAAa,EAAE,CAAC;YAChBC,YAAY,EAAE;UAChB;QACF;MACF,CAAC;MACDI,SAAS,EAAE;QACTL,aAAa,EAAE,CAAC;QAChBC,YAAY,EAAE,EAAE;QAChBE,IAAI,EAAE,IAAI;QACVC,WAAW,EAAE;UACX,GAAG,EAAE;YACHJ,aAAa,EAAE,CAAC;YAChBC,YAAY,EAAE;UAChB,CAAC;UACD,GAAG,EAAE;YACHD,aAAa,EAAE,CAAC;YAChBC,YAAY,EAAE;UAChB;QACF;MACF,CAAC;MACDK,aAAa,EAAE;QACbN,aAAa,EAAE,CAAC;QAChBE,cAAc,EAAE,IAAI;QACpBC,IAAI,EAAE;MACR,CAAC;MACDI,WAAW,EAAE;QACXP,aAAa,EAAE,CAAC;QAChBE,cAAc,EAAE,IAAI;QACpBC,IAAI,EAAE;MACR;IACF;EACF,CAAC;EACDK,KAAKA,CAAA,EAAE;IACL,OAAM;MACJC,OAAO,EAAE,CAACpB,UAAU,EAAEC,UAAU;IAClC;EACF;AACF,CAAC,CAAC"},"metadata":{},"sourceType":"module","externalDependencies":[]}