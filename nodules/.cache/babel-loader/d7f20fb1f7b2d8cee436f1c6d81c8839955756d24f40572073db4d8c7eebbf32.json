tent of the notification. This is the content of the notification.',\r\n        icon: <sdFeatherIcons type=\"smile\" size=\"14\" style=\"color: #108ee9\" />,\r\n      });\r\n    },\r\n    openNotificationWithIcon(type) {\r\n      Notification[type]({\r\n        message: 'Notification Title',\r\n        description:\r\n          'This is the content of the notification. This is the content of the notification. This is the content of the notification.',\r\n      });\r\n    },\r\n    openNotificationPlacement(placement) {\r\n      Notification.open({\r\n        message: `Notification ${placement}`,\r\n        description:\r\n          'This is the content of the notification. This is the content of the notification. This is the content of the notification.',\r\n        placement,\r\n      });\r\n    },\r\n  },\r\n});\r\n</script>\r\n"],"mappings":";;;AA8EA,SAASA,IAAG,QAAS,WAAW;AAEhC,SACEC,oBAAoB,EACpBC,qBAAqB,EACrBC,wBAAwB,EACxBC,yBAAyB,QACpB,uBAAuB;AAC9B,SAASC,eAAc,QAAS,KAAK;AACrC,eAAeA,eAAe,CAAC;EAC7BC,IAAI,EAAE,cAAc;EACpBC,UAAU,EAAE;IACVP,IAAI;IACJC,oBAAoB;IACpBC,qBAAqB;IACrBC,wBAAwB;IACxBC;EACF,CAAC;EACDI,IAAIA,CAAA,EAAG;IACL,OAAO,CAAC,CAAC;EACX,CAAC;EACDC,OAAO,EAAE;IACPC,gBAAgBA,CAAA,EAAG;MACjBC,aAAA,CAAaC,IAAI,CAAC;QAChBC,OAAO,EAAE,oBAAoB;QAC7BC,WAAW,EACT,4HAA4H;QAC9HC,OAAO,EAAEA,CAAA,KAAM;UACbC,OAAO,CAACC,GAAG,CAAC,uBAAuB,CAAC;QACtC;MACF,CAAC,CAAC;IACJ,CAAC;IACDC,sBAAsBA,CAAA,EAAG;MACvBP,aAAA,CAAaC,IAAI,CAAC;QAChBC,OAAO,EAAE,oBAAoB;QAC7BC,WAAW,EACT,4HAA4H;QAC9HK,KAAK,EAAE;UACLC,KAAK,EAAE,OAAO;UACdC,UAAU,EAAG,GAAE,GAAE,GAAI,GAAI;QAC3B;MACF,CAAC,CAAC;IACJ,CAAC;IACDC,oBAAoBA,CAAA,EAAG;MACrBX,aAAA,CAAaC,IAAI,CAAC;QAChBC,OAAO,EAAE,oBAAoB;QAC7BC,WAAW,EACT,4HAA4H;QAC9HS,IAAI,EAAAC,YAAA,CAAAC,iBAAA;UAAA,QAAuB,OAAM;UAAA,QAAO,IAAG;UAAA,SAAQ;QAAe;MACpE,CAAC,CAAC;IACJ,CAAC;IACDC,wBAAwBA,CAACC,IAAI,EAAE;MAC7BhB,aAAA,CAAagB,IAAI,CAAC,CAAC;QACjBd,OAAO,EAAE,oBAAoB;QAC7BC,WAAW,EACT;MACJ,CAAC,CAAC;IACJ,CAAC;IACDc,yBAAyBA,CAACC,SAAS,EAAE;MACnClB,aAAA,CAAaC,IAAI,CAAC;QAChBC,OAAO,EA