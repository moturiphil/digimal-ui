{"ast":null,"code":"import { RecordViewWrapper } from \"../style\";\nimport { Main, TableWrapper } from \"../../styled\";\nimport { useStore } from \"vuex\";\nimport { computed, onMounted, ref, reactive, defineComponent } from \"vue\";\n// import axios from \"axios\";\nimport authHeader from \"../../../services/auth-header\";\nimport UserService from \"../../../services/user.service\";\n// import { useRouter } from \"vue-router\";\n// import DragAndDropTable from '../../../view/table/DragTable.vue';\n\n// console.log(userService.getAll());\n\nconst columns = [{\n  title: \"First Name\",\n  dataIndex: \"first_name\",\n  key: \"id\"\n}, {\n  title: \"Middle Name\",\n  dataIndex: \"middle_name\",\n  key: \"id\"\n}, {\n  title: \"Last Name\",\n  dataIndex: \"last_name\",\n  key: \"id\"\n}, {\n  title: \"Level\",\n  dataIndex: \"level_id\",\n  key: \"id\"\n}, {\n  title: \"Organization\",\n  dataIndex: \"org_types_id\",\n  key: \"id\"\n}, {\n  title: \"Role\",\n  dataIndex: \"role_id\",\n  key: \"id\"\n}, {\n  title: \"Phone Number\",\n  dataIndex: \"phone_no\",\n  key: \"id\"\n}];\nconst DragAndDropTable = defineComponent({\n  name: \"ViewPage\",\n  components: {\n    RecordViewWrapper,\n    Main,\n    TableWrapper\n  },\n  setup() {\n    const {\n      state,\n      dispatch\n    } = useStore();\n    const crud = computed(() => state.crud.data);\n    const isLoading = computed(() => state.crud.loading);\n    const selectedRowKeys = ref([]);\n    const dataSource = ref([]);\n    // const { state, dispatch } = useStore();\n    // const router = useRouter();\n\n    // if (!state.auth.isAuthenticated) {\n    //   router.push({ name: \"login\" });\n    // }\n\n    console.log(authHeader());\n    const api_url = UserService;\n    console.log(api_url);\n    onMounted(async () => {\n      try {\n        const response = await fetch(`${process.env.VUE_APP_BASE_URL}/users`, {\n          method: \"GET\",\n          headers: authHeader()\n        });\n        const data = await response.json();\n        dataSource.value = data.data;\n        console.log(data.data);\n      } catch (error) {\n        console.error(error);\n      }\n    });\n    const handleDelete = id => {\n      const confirm = window.confirm(\"Are you sure delete this?\");\n      if (confirm) {\n        dispatch(\"axiosDataDelete\", {\n          id,\n          getData: () => {\n            dispatch(\"axiosCrudGetData\");\n          }\n        });\n      }\n      return false;\n    };\n    const formState = reactive({\n      searchItem: \"\"\n    });\n    const onSelectChange = selectedRowKey => {\n      selectedRowKeys.value = selectedRowKey;\n    };\n    const rowSelection = {\n      selectedRowKeys,\n      onChange: onSelectChange\n    };\n    return {\n      crud,\n      isLoading,\n      selectedRowKeys,\n      handleDelete,\n      rowSelection,\n      onSelectChange,\n      dataSource,\n      columns,\n      formState\n    };\n  }\n});\nexport default DragAndDropTable;","map":{"version":3,"names":["RecordViewWrapper","Main","TableWrapper","useStore","computed","onMounted","ref","reactive","defineComponent","authHeader","UserService","columns","title","dataIndex","key","DragAndDropTable","name","components","setup","state","dispatch","crud","data","isLoading","loading","selectedRowKeys","dataSource","console","log","api_url","response","fetch","process","env","VUE_APP_BASE_URL","method","headers","json","value","error","handleDelete","id","confirm","window","getData","formState","searchItem","onSelectChange","selectedRowKey","rowSelection","onChange"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/pages/users/registeredUsers.vue"],"sourcesContent":["<template>\n  <RecordViewWrapper>\n    <sdPageHeader title=\"Users\">\n      <template #subTitle>\n        <sdButton class=\"btn-add_new\" size=\"default\" type=\"success\">\n          <!-- <router-link to=\"/campaigns/create-campaign\">\n            <sdFeatherIcons type=\"plus\" size=\"14\" /> Start New\n            Campaign</router-link\n          > -->\n        </sdButton>\n      </template>\n      <!-- <template #buttons>\n        <div class=\"search-box\">\n          <span class=\"search-icon\">\n            <sdFeatherIcons type=\"search\" size=\"14\" />\n          </span></div\n      ></template> -->\n    </sdPageHeader>\n    <Main>\n      <a-row :gutter=\"15\">\n        <a-col class=\"w-100\" :md=\"24\">\n          <sdCards headless>\n            <div v-if=\"isLoading\" class=\"spin\">\n              <a-spin />\n            </div>\n\n            <div v-else>\n              <TableWrapper class=\"table-data-view table-responsive\">\n                <a-table\n                  :rowSelection=\"rowSelection\"\n                  :pagination=\"{ pageSize: 10, showSizeChanger: true }\"\n                  :dataSource=\"dataSource\"\n                  :columns=\"columns\"\n                />\n              </TableWrapper>\n            </div>\n          </sdCards>\n        </a-col>\n      </a-row>\n      <a-col :xs=\"24\">\n        <DragAndDropTable />\n      </a-col>\n    </Main>\n  </RecordViewWrapper>\n</template>\n<script>\nimport { RecordViewWrapper } from \"../style\";\nimport { Main, TableWrapper } from \"../../styled\";\nimport { useStore } from \"vuex\";\nimport { computed, onMounted, ref, reactive, defineComponent } from \"vue\";\n// import axios from \"axios\";\nimport authHeader from \"../../../services/auth-header\";\nimport UserService from \"../../../services/user.service\";\n// import { useRouter } from \"vue-router\";\n// import DragAndDropTable from '../../../view/table/DragTable.vue';\n\n// console.log(userService.getAll());\n\nconst columns = [\n  {\n    title: \"First Name\",\n    dataIndex: \"first_name\",\n    key: \"id\",\n  },\n  {\n    title: \"Middle Name\",\n    dataIndex: \"middle_name\",\n    key: \"id\",\n  },\n  {\n    title: \"Last Name\",\n    dataIndex: \"last_name\",\n    key: \"id\",\n  },\n  {\n    title: \"Level\",\n    dataIndex: \"level_id\",\n    key: \"id\",\n  },\n  {\n    title: \"Organization\",\n    dataIndex: \"org_types_id\",\n    key: \"id\",\n  },\n  {\n    title: \"Role\",\n    dataIndex: \"role_id\",\n    key: \"id\",\n  },\n  {\n    title: \"Phone Number\",\n    dataIndex: \"phone_no\",\n    key: \"id\",\n  },\n];\n\nconst DragAndDropTable = defineComponent({\n  name: \"ViewPage\",\n  components: { RecordViewWrapper, Main, TableWrapper },\n\n  setup() {\n    const { state, dispatch } = useStore();\n    const crud = computed(() => state.crud.data);\n    const isLoading = computed(() => state.crud.loading);\n    const selectedRowKeys = ref([]);\n    const dataSource = ref([]);\n    // const { state, dispatch } = useStore();\n    // const router = useRouter();\n\n    // if (!state.auth.isAuthenticated) {\n    //   router.push({ name: \"login\" });\n    // }\n\n    console.log(authHeader());\n\n    const api_url = UserService;\n    console.log(api_url);\n\n    onMounted(async () => {\n      try {\n        const response = await fetch(`${process.env.VUE_APP_BASE_URL}/users`, {\n          method: \"GET\",\n          headers: authHeader(),\n        });\n        const data = await response.json();\n        dataSource.value = data.data;\n        console.log(data.data);\n      } catch (error) {\n        console.error(error);\n      }\n    });\n\n    const handleDelete = (id) => {\n      const confirm = window.confirm(\"Are you sure delete this?\");\n      if (confirm) {\n        dispatch(\"axiosDataDelete\", {\n          id,\n          getData: () => {\n            dispatch(\"axiosCrudGetData\");\n          },\n        });\n      }\n      return false;\n    };\n\n    const formState = reactive({\n      searchItem: \"\",\n    });\n\n    const onSelectChange = (selectedRowKey) => {\n      selectedRowKeys.value = selectedRowKey;\n    };\n\n    const rowSelection = {\n      selectedRowKeys,\n      onChange: onSelectChange,\n    };\n\n    return {\n      crud,\n      isLoading,\n      selectedRowKeys,\n      handleDelete,\n      rowSelection,\n      onSelectChange,\n      dataSource,\n      columns,\n      formState,\n    };\n  },\n});\n\nexport default DragAndDropTable;\n\n</script>\n  "],"mappings":"AA8CA,SAASA,iBAAgB,QAAS,UAAU;AAC5C,SAASC,IAAI,EAAEC,YAAW,QAAS,cAAc;AACjD,SAASC,QAAO,QAAS,MAAM;AAC/B,SAASC,QAAQ,EAAEC,SAAS,EAAEC,GAAG,EAAEC,QAAQ,EAAEC,eAAc,QAAS,KAAK;AACzE;AACA,OAAOC,UAAS,MAAO,+BAA+B;AACtD,OAAOC,WAAU,MAAO,gCAAgC;AACxD;AACA;;AAEA;;AAEA,MAAMC,OAAM,GAAI,CACd;EACEC,KAAK,EAAE,YAAY;EACnBC,SAAS,EAAE,YAAY;EACvBC,GAAG,EAAE;AACP,CAAC,EACD;EACEF,KAAK,EAAE,aAAa;EACpBC,SAAS,EAAE,aAAa;EACxBC,GAAG,EAAE;AACP,CAAC,EACD;EACEF,KAAK,EAAE,WAAW;EAClBC,SAAS,EAAE,WAAW;EACtBC,GAAG,EAAE;AACP,CAAC,EACD;EACEF,KAAK,EAAE,OAAO;EACdC,SAAS,EAAE,UAAU;EACrBC,GAAG,EAAE;AACP,CAAC,EACD;EACEF,KAAK,EAAE,cAAc;EACrBC,SAAS,EAAE,cAAc;EACzBC,GAAG,EAAE;AACP,CAAC,EACD;EACEF,KAAK,EAAE,MAAM;EACbC,SAAS,EAAE,SAAS;EACpBC,GAAG,EAAE;AACP,CAAC,EACD;EACEF,KAAK,EAAE,cAAc;EACrBC,SAAS,EAAE,UAAU;EACrBC,GAAG,EAAE;AACP,CAAC,CACF;AAED,MAAMC,gBAAe,GAAIP,eAAe,CAAC;EACvCQ,IAAI,EAAE,UAAU;EAChBC,UAAU,EAAE;IAAEjB,iBAAiB;IAAEC,IAAI;IAAEC;EAAa,CAAC;EAErDgB,KAAKA,CAAA,EAAG;IACN,MAAM;MAAEC,KAAK;MAAEC;IAAS,IAAIjB,QAAQ,EAAE;IACtC,MAAMkB,IAAG,GAAIjB,QAAQ,CAAC,MAAMe,KAAK,CAACE,IAAI,CAACC,IAAI,CAAC;IAC5C,MAAMC,SAAQ,GAAInB,QAAQ,CAAC,MAAMe,KAAK,CAACE,IAAI,CAACG,OAAO,CAAC;IACpD,MAAMC,eAAc,GAAInB,GAAG,CAAC,EAAE,CAAC;IAC/B,MAAMoB,UAAS,GAAIpB,GAAG,CAAC,EAAE,CAAC;IAC1B;IACA;;IAEA;IACA;IACA;;IAEAqB,OAAO,CAACC,GAAG,CAACnB,UAAU,EAAE,CAAC;IAEzB,MAAMoB,OAAM,GAAInB,WAAW;IAC3BiB,OAAO,CAACC,GAAG,CAACC,OAAO,CAAC;IAEpBxB,SAAS,CAAC,YAAY;MACpB,IAAI;QACF,MAAMyB,QAAO,GAAI,MAAMC,KAAK,CAAE,GAAEC,OAAO,CAACC,GAAG,CAACC,gBAAiB,QAAO,EAAE;UACpEC,MAAM,EAAE,KAAK;UACbC,OAAO,EAAE3B,UAAU;QACrB,CAAC,CAAC;QACF,MAAMa,IAAG,GAAI,MAAMQ,QAAQ,CAACO,IAAI,EAAE;QAClCX,UAAU,CAACY,KAAI,GAAIhB,IAAI,CAACA,IAAI;QAC5BK,OAAO,CAACC,GAAG,CAACN,IAAI,CAACA,IAAI,CAAC;MACxB,EAAE,OAAOiB,KAAK,EAAE;QACdZ,OAAO,CAACY,KAAK,CAACA,KAAK,CAAC;MACtB;IACF,CAAC,CAAC;IAEF,MAAMC,YAAW,GAAKC,EAA