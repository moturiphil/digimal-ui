{"ast":null,"code":"import { computed, reactive, ref } from 'vue';\nimport { useStore } from 'vuex';\nimport { BasicFormWrapper } from '../../../styled';\nimport { TaskListWrap } from '../style';\nconst All = {\n  name: 'All',\n  components: {\n    BasicFormWrapper,\n    TaskListWrap\n  },\n  setup() {\n    const {\n      state,\n      dispatch\n    } = useStore();\n    const task = computed(() => state.task.data.sort((a, b) => b.id - a.id));\n    const visible = ref(false);\n    const taskEditId = ref('');\n    const editableItem = ref({});\n    let formState = reactive({\n      title: '',\n      description: '',\n      favourite: '',\n      completed: '',\n      id: ''\n    });\n    const showModal = (id, item) => {\n      console.log(item);\n      taskEditId.value = id;\n      visible.value = true;\n      editableItem.value = item;\n      formState.title = item.title;\n      formState.description = item.description;\n      formState.favourite = item.favourite;\n      formState.completed = item.completed;\n      formState.id = id;\n    };\n    const handleCancel = () => {\n      visible.value = false;\n    };\n    const handleTaskDelete = id => {\n      const value = task.value.filter(item => item.id !== id);\n      dispatch('ontaskDelete', value);\n    };\n    const onEditHandle = data => {\n      const updatedData = task.value.map(item => {\n        if (item.id === formState.id) {\n          // eslint-disable-next-line no-param-reassign\n          item = data;\n          return item;\n        }\n        return item;\n      });\n      visible.value = false;\n      dispatch('ontaskEdit', updatedData);\n    };\n    return {\n      task,\n      visible,\n      taskEditId,\n      editableItem,\n      showModal,\n      handleCancel,\n      handleTaskDelete,\n      onEditHandle,\n      dispatch,\n      formState\n    };\n  }\n};\nexport default All;","map":{"version":3,"names":["computed","reactive","ref","useStore","BasicFormWrapper","TaskListWrap","All","name","components","setup","state","dispatch","task","data","sort","a","b","id","visible","taskEditId","editableItem","formState","title","description","favourite","completed","showModal","item","console","log","value","handleCancel","handleTaskDelete","filter","onEditHandle","updatedData","map"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/apps/netDistribution/overview/national.vue"],"sourcesContent":["<template>\n    <TaskListWrap class=\"mb-30\">\n      <div class=\"sDash_tasklist-wrap\">\n        <div class=\"sDash_tasklist-head\">\n          <h2 class=\"sDash_task-list-title\">Net Distribution List</h2>\n        </div>\n        <div class=\"sDash_tasklist-body\">\n          <ul v-if=\"task.length > 0\" class=\"sDash_tasks\">\n            <li v-for=\"(item, i) in task\" class=\"sDash_tasks-item\" :key=\"i\">\n              <div class=\"sDash_tasks-item__content\">\n                <div class=\"sDash_tasks-item__title\">\n                  <a-checkbox\n                    :checked=\"!!item.completed\"\n                    @change=\"() => dispatch('onCompleteUpdate', { data: task, id: item.id })\"\n                  >\n                    {{ item.title }}\n                  </a-checkbox>\n                </div>\n                <div class=\"sDash_tasks-item__text\">\n                  <p>{{ item.description }}</p>\n                </div>\n              </div>\n  \n              <div class=\"sDash_tasks-item__action\">\n                <a\n                  to=\"#\"\n                  :class=\"`${item.favourite ? 'task-favourite active' : 'task-favourite'}`\"\n                  @click=\"() => dispatch('onStarUpdate', { data: task, id: item.id })\"\n                >\n                  <sdFeatherIcons type=\"star\" size=\"14\" />\n                </a>\n                <sdDropdown>\n                  <template #overlay>\n                    <a to=\"#\" @click=\"() => showModal(item.id, item)\">\n                      <sdFeatherIcons type=\"edit\" size=\"14\" />\n                      <span>Edit</span>\n                    </a>\n                    <a to=\"#\" @click=\"() => handleTaskDelete(item.id)\">\n                      <sdFeatherIcons type=\"trash-2\" size=\"14\" />\n                      <span>Delete</span>\n                    </a>\n                  </template>\n                  <a to=\"#\">\n                    <sdFeatherIcons type=\"more-vertical\" size=\"18\" />\n                  </a>\n                </sdDropdown>\n              </div>\n            </li>\n          </ul>\n  \n          <div v-else class=\"sDash_empty-task\">\n            <span>Sorry !! No Distibutuib Found :(</span>\n          </div>\n        </div>\n      </div>\n      <sdModal\n        title=\"Edit Task\"\n        class=\"sDash_addTask-modal\"\n        type=\"primary\"\n        :visible=\"visible\"\n        :footer=\"null\"\n        :onCancel=\"handleCancel\"\n      >\n        <div class=\"sDash_addTask-modal-inner\">\n          <BasicFormWrapper>\n            <a-form name=\"add-task\" :model=\"formState\" @finish=\"onEditHandle\">\n              <a-form-item name=\"title\">\n                <a-input v-model:value=\"formState.title\" placeholder=\"Title\" />\n              </a-form-item>\n  \n              <a-form-item name=\"description\">\n                <a-textarea :rows=\"4\" v-model:value=\"formState.description\" placeholder=\"Add Description\" />\n              </a-form-item>\n              <a-form-item hidden=\"true\" name=\"favourite\">\n                <a-input v-model:value=\"formState.favourite\" />\n              </a-form-item>\n              <a-form-item hidden=\"true\" name=\"completed\">\n                <a-input v-model:value=\"formState.completed\" />\n              </a-form-item>\n  \n              <div class=\"sDash-modal-actions\">\n                <sdButton size=\"small\" type=\"white\" key=\"cancel\" outlined @click=\"handleCancel\"> Cancel </sdButton>\n                <sdButton htmlType=\"submit\" size=\"small\" type=\"primary\" key=\"submit\"> Submit </sdButton>\n              </div>\n            </a-form>\n          </BasicFormWrapper>\n        </div>\n      </sdModal>\n    </TaskListWrap>\n  </template>\n  <script>\n  import { computed, reactive, ref } from 'vue';\n  import { useStore } from 'vuex';\n  import { BasicFormWrapper } from '../../../styled';\n  import { TaskListWrap } from '../style';\n  \n  const All = {\n    name: 'All',\n    components: { BasicFormWrapper, TaskListWrap },\n    setup() {\n      const { state, dispatch } = useStore();\n      const task = computed(() => state.task.data.sort((a, b) => b.id - a.id));\n      const visible = ref(false);\n      const taskEditId = ref('');\n      const editableItem = ref({});\n  \n      let formState = reactive({\n        title: '',\n        description: '',\n        favourite: '',\n        completed: '',\n        id: '',\n      });\n  \n      const showModal = (id, item) => {\n        console.log(item);\n        taskEditId.value = id;\n        visible.value = true;\n        editableItem.value = item;\n        formState.title = item.title;\n        formState.description = item.description;\n        formState.favourite = item.favourite;\n        formState.completed = item.completed;\n        formState.id = id;\n      };\n  \n      const handleCancel = () => {\n        visible.value = false;\n      };\n  \n      const handleTaskDelete = (id) => {\n        const value = task.value.filter((item) => item.id !== id);\n        dispatch('ontaskDelete', value);\n      };\n  \n      const onEditHandle = (data) => {\n        const updatedData = task.value.map((item) => {\n          if (item.id === formState.id) {\n            // eslint-disable-next-line no-param-reassign\n            item = data;\n            return item;\n          }\n          return item;\n        });\n  \n        visible.value = false;\n        dispatch('ontaskEdit', updatedData);\n      };\n  \n      return {\n        task,\n        visible,\n        taskEditId,\n        editableItem,\n        showModal,\n        handleCancel,\n        handleTaskDelete,\n        onEditHandle,\n        dispatch,\n        formState,\n      };\n    },\n  };\n  \n  export default All;\n  </script>\n  "],"mappings":"AA2FE,SAASA,QAAQ,EAAEC,QAAQ,EAAEC,GAAE,QAAS,KAAK;AAC7C,SAASC,QAAO,QAAS,MAAM;AAC/B,SAASC,gBAAe,QAAS,iBAAiB;AAClD,SAASC,YAAW,QAAS,UAAU;AAEvC,MAAMC,GAAE,GAAI;EACVC,IAAI,EAAE,KAAK;EACXC,UAAU,EAAE;IAAEJ,gBAAgB;IAAEC;EAAa,CAAC;EAC9CI,KAAKA,CAAA,EAAG;IACN,MAAM;MAAEC,KAAK;MAAEC;IAAS,IAAIR,QAAQ,EAAE;IACtC,MAAMS,IAAG,GAAIZ,QAAQ,CAAC,MAAMU,KAAK,CAACE,IAAI,CAACC,IAAI,CAACC,IAAI,CAAC,CAACC,CAAC,EAAEC,CAAC,KAAKA,CAAC,CAACC,EAAC,GAAIF,CAAC,CAACE,EAAE,CAAC,CAAC;IACxE,MAAMC,OAAM,GAAIhB,GAAG,CAAC,KAAK,CAAC;IAC1B,MAAMiB,UAAS,GAAIjB,GAAG,CAAC,EAAE,CAAC;IAC1B,MAAMkB,YAAW,GAAIlB,GAAG,CAAC,CAAC,CAAC,CAAC;IAE5B,IAAImB,SAAQ,GAAIpB,QAAQ,CAAC;MACvBqB,KAAK,EAAE,EAAE;MACTC,WAAW,EAAE,EAAE;MACfC,SAAS,EAAE,EAAE;MACbC,SAAS,EAAE,EAAE;MACbR,EAAE,EAAE;IACN,CAAC,CAAC;IAEF,MAAMS,SAAQ,GAAIA,CAACT,EAAE,EAAEU,IAAI,KAAK;MAC9BC,OAAO,CAACC,GAAG,CAACF,IAAI,CAAC;MACjBR,UAAU,CAACW,KAAI,GAAIb,EAAE;MACrBC,OAAO,CAACY,KAAI,GAAI,IAAI;MACpBV,YAAY,CAACU,KAAI,GAAIH,IAAI;MACzBN,SAAS,CAACC,KAAI,GAAIK,IAAI,CAACL,KAAK;MAC5BD,SAAS,CAACE,WAAU,GAAII,IAAI,CAACJ,WAAW;MACxCF,SAAS,CAACG,SAAQ,GAAIG,IAAI,CAACH,SAAS;MACpCH,SAAS,CAACI,SAAQ,GAAIE,IAAI,CAACF,SAAS;MACpCJ,SAAS,CAACJ,EAAC,GAAIA,EAAE;IACnB,CAAC;IAED,MAAMc,YAAW,GAAIA,CAAA,KAAM;MACzBb,OAAO,CAACY,KAAI,GAAI,KAAK;IACvB,CAAC;IAED,MAAME,gBAAe,GAAKf,EAAE,IAAK;MAC/B,MAAMa,KAAI,GAAIlB,IAAI,CAACkB,KAAK,CAACG,MAAM,CAAEN,IAAI,IAAKA,IAAI,CAACV,EAAC,KAAMA,EAAE,CAAC;MACzDN,QAAQ,CAAC,cAAc,EAAEmB,KAAK,CAAC;IACjC,CAAC;IAED,MAAMI,YAAW,GAAKrB,IAAI,IAAK;MAC7B,MAAMsB,WAAU,GAAIvB,IAAI,CAACkB,KAAK,CAACM,GAAG,CAAET,IAAI,IAAK;QAC3C,IAAIA,IAAI,CAACV,EAAC,KAAMI,SAAS,CAACJ,EAAE,EAAE;UAC5B;UACAU,IAAG,GAAId,IAAI;UACX,OAAOc,IAAI;QACb;QACA,OAAOA,IAAI;MACb,CAAC,CAAC;MAEFT,OAAO,CAACY,KAAI,GAAI,KAAK;MACrBnB,QAAQ,CAAC,YAAY,EAAEwB,WAAW,CAAC;IACrC,CAAC;IAED,OAAO;MACLvB,IAAI