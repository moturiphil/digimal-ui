{"ast":null,"code":"import { UsercardWrapper, UserCarrdTop } from './style';\nimport { Main, CardToolbox } from '../../styled';\nimport { useStore } from 'vuex';\nimport { computed, ref, defineComponent } from 'vue';\nimport userGroup from '@/demoData/usersGroupData.json';\nimport { useRoute } from 'vue-router';\nconst Users = defineComponent({\n  name: 'Users',\n  components: {\n    UsercardWrapper,\n    UserCarrdTop,\n    Main,\n    CardToolbox\n  },\n  setup() {\n    const {\n      state\n    } = useStore();\n    const searchData = computed(() => state.headerSearchData);\n    const {\n      path\n    } = useRoute().matched[2];\n    const current = ref(0);\n    const pageSize = ref(0);\n    const page = ref(0);\n    const onShowSizeChange = (c, p) => {\n      current.value = c;\n      pageSize.value = p;\n    };\n    const onChange = p => {\n      page.value = p;\n    };\n    return {\n      searchData,\n      userGroup,\n      path,\n      current,\n      pageSize,\n      page,\n      onShowSizeChange,\n      onChange\n    };\n  }\n});\nexport default Users;","map":{"version":3,"names":["UsercardWrapper","UserCarrdTop","Main","CardToolbox","useStore","computed","ref","defineComponent","userGroup","useRoute","Users","name","components","setup","state","searchData","headerSearchData","path","matched","current","pageSize","page","onShowSizeChange","c","p","value","onChange"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/apps/users/Users.vue"],"sourcesContent":["<template>\r\n  <CardToolbox>\r\n    <UserCarrdTop>\r\n      <sdPageHeader title=\"Users\">\r\n        <template #subTitle>\r\n          <span class=\"title-counter\">274 Users </span>\r\n          <sdAutoComplete :dataSource=\"searchData\" placeholder=\"Search by Name\" width=\"100%\" patterns />\r\n        </template>\r\n        <template #buttons>\r\n          <sdButton class=\"btn-add_new\" size=\"default\" type=\"primary\" key=\"1\">\r\n            <router-link to=\"/app/pages/add-user/info\">\r\n              <sdFeatherIcons type=\"plus\" size=\"14\" /> Add New User\r\n            </router-link>\r\n          </sdButton>\r\n          <router-link class=\"action-btn\" key=\"2\" :to=\"`${path}/user-grid`\">\r\n            <sdFeatherIcons type=\"grid\" size=\"14\" />\r\n          </router-link>\r\n          <router-link class=\"action-btn\" key=\"3\" :to=\"`${path}/user-list`\">\r\n            <sdFeatherIcons type=\"list\" size=\"14\" />\r\n          </router-link>\r\n          <router-link class=\"action-btn\" key=\"4\" :to=\"`${path}/grid-style`\">\r\n            <sdFeatherIcons type=\"maximize\" size=\"14\" />\r\n          </router-link>\r\n          <router-link class=\"action-btn\" key=\"5\" :to=\"`${path}/grid-group`\">\r\n            <sdFeatherIcons type=\"users\" size=\"14\" />\r\n          </router-link>\r\n        </template>\r\n      </sdPageHeader>\r\n    </UserCarrdTop>\r\n  </CardToolbox>\r\n  <Main>\r\n    <UsercardWrapper>\r\n      <a-row :gutter=\"25\">\r\n        <router-view name=\"descendant\"></router-view>\r\n        <a-col :xs=\"24\">\r\n          <div class=\"user-card-pagination\">\r\n            <a-pagination\r\n              @change=\"onChange\"\r\n              showSizeChanger\r\n              @showSizeChange=\"onShowSizeChange\"\r\n              :defaultCurrent=\"6\"\r\n              :total=\"500\"\r\n            />\r\n          </div>\r\n        </a-col>\r\n      </a-row>\r\n    </UsercardWrapper>\r\n  </Main>\r\n</template>\r\n<script>\r\nimport { UsercardWrapper, UserCarrdTop } from './style';\r\nimport { Main, CardToolbox } from '../../styled';\r\nimport { useStore } from 'vuex';\r\nimport { computed, ref, defineComponent } from 'vue';\r\nimport userGroup from '@/demoData/usersGroupData.json';\r\nimport { useRoute } from 'vue-router';\r\n\r\nconst Users = defineComponent({\r\n  name: 'Users',\r\n  components: { UsercardWrapper, UserCarrdTop, Main, CardToolbox },\r\n  setup() {\r\n    const { state } = useStore();\r\n    const searchData = computed(() => state.headerSearchData);\r\n    const { path } = useRoute().matched[2];\r\n\r\n    const current = ref(0);\r\n    const pageSize = ref(0);\r\n    const page = ref(0);\r\n\r\n    const onShowSizeChange = (c, p) => {\r\n      current.value = c;\r\n      pageSize.value = p;\r\n    };\r\n\r\n    const onChange = (p) => {\r\n      page.value = p;\r\n    };\r\n\r\n    return {\r\n      searchData,\r\n      userGroup,\r\n      path,\r\n      current,\r\n      pageSize,\r\n      page,\r\n      onShowSizeChange,\r\n      onChange,\r\n    };\r\n  },\r\n});\r\n\r\nexport default Users;\r\n</script>\r\n"],"mappings":"AAkDA,SAASA,eAAe,EAAEC,YAAW,QAAS,SAAS;AACvD,SAASC,IAAI,EAAEC,WAAU,QAAS,cAAc;AAChD,SAASC,QAAO,QAAS,MAAM;AAC/B,SAASC,QAAQ,EAAEC,GAAG,EAAEC,eAAc,QAAS,KAAK;AACpD,OAAOC,SAAQ,MAAO,gCAAgC;AACtD,SAASC,QAAO,QAAS,YAAY;AAErC,MAAMC,KAAI,GAAIH,eAAe,CAAC;EAC5BI,IAAI,EAAE,OAAO;EACbC,UAAU,EAAE;IAAEZ,eAAe;IAAEC,YAAY;IAAEC,IAAI;IAAEC;EAAY,CAAC;EAChEU,KAAKA,CAAA,EAAG;IACN,MAAM;MAAEC;IAAM,IAAIV,QAAQ,EAAE;IAC5B,MAAMW,UAAS,GAAIV,QAAQ,CAAC,MAAMS,KAAK,CAACE,gBAAgB,CAAC;IACzD,MAAM;MAAEC;IAAK,IAAIR,QAAQ,EAAE,CAACS,OAAO,CAAC,CAAC,CAAC;IAEtC,MAAMC,OAAM,GAAIb,GAAG,CAAC,CAAC,CAAC;IACtB,MAAMc,QAAO,GAAId,GAAG,CAAC,CAAC,CAAC;IACvB,MAAMe,IAAG,GAAIf,GAAG,CAAC,CAAC,CAAC;IAEnB,MAAMgB,gBAAe,GAAIA,CAACC,CAAC,EAAEC,CAAC,KAAK;MACjCL,OAAO,CAACM,KAAI,GAAIF,CAAC;MACjBH,QAAQ,CAACK,KAAI,GAAID,CAAC;IACpB,CAAC;IAED,MAAME,QAAO,GAAKF,CAAC,IAAK;MACtBH,IAAI,CAACI,KAAI,GAAID,CAAC;IAChB,CAAC;IAED,OAAO;MACLT,UAAU;MACVP,SAAS;MACTS,IAAI;MACJE,OAAO;MACPC,QAAQ;MACRC,IAAI;MACJC,gBAAgB;MAChBI;IACF,CAAC;EACH;AACF,CAAC,CAAC;AAEF,eAAehB,KAAK"},"metadata":{},"sourceType":"module","externalDependencies":[]}