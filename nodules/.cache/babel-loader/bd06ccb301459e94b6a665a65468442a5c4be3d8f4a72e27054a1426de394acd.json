{"ast":null,"code":"import { useStore } from 'vuex';\nimport { computed, ref, onMounted, defineComponent } from 'vue';\nimport { PerformanceChartWrapper, Pstates } from '../../style';\nimport { chartLinearGradient, customTooltips } from '../../../../components/utilities/utilities';\nimport Chart from '../../../../components/utilities/chartjs';\nconst WebsitePerformance = defineComponent({\n  components: {\n    PerformanceChartWrapper,\n    Pstates,\n    Chart\n  },\n  setup() {\n    const store = useStore();\n    const performance = ref('year');\n    const performanceTab = ref('users');\n    const height = ref(window.innerWidth <= 575 ? 200 : 85);\n    const performanceState = computed(() => store.state.chartContent.performanceData);\n    const preIsLoading = computed(() => store.state.chartContent.perLoading);\n    const performanceDatasets = computed(() => [{\n      data: performanceState.value[performanceTab.value][1],\n      borderColor: '#5F63F2',\n      borderWidth: 4,\n      fill: true,\n      backgroundColor: () => chartMethods('performance', ['#5F63F230', '#ffffff05']),\n      label: 'Current period',\n      pointStyle: 'circle',\n      pointRadius: '0',\n      hoverRadius: '9',\n      pointBorderColor: '#fff',\n      pointBackgroundColor: '#5F63F2',\n      hoverBorderWidth: 5\n    }, {\n      data: performanceState.value[performanceTab.value][2],\n      borderColor: '#C6D0DC',\n      borderWidth: 2,\n      fill: false,\n      backgroundColor: '#00173750',\n      label: 'Previous period',\n      borderDash: [3, 3],\n      pointRadius: '0',\n      hoverRadius: '0'\n    }]);\n    const handleActiveChangePerformance = (event, value) => {\n      event.preventDefault();\n      performance.value = value;\n      return store.dispatch('performanceFilterData', value);\n    };\n    function chartMethods(elementId, color) {\n      return chartLinearGradient(document.querySelector(`.${elementId}`), 300, {\n        start: color[0],\n        end: color[1]\n      });\n    }\n    const onPerformanceTab = value => {\n      performanceTab.value = value;\n      return store.dispatch('setIsLoading');\n    };\n    onMounted(() => {\n      store.dispatch('performanceGetData');\n    });\n    const chartOptions = {\n      maintainAspectRatio: true,\n      elements: {\n        z: 9999\n      },\n      legend: {\n        display: false\n      },\n      hover: {\n        mode: 'index',\n        intersect: false\n      },\n      tooltips: {\n        mode: 'label',\n        intersect: false,\n        backgroundColor: '#ffffff',\n        position: 'average',\n        enabled: false,\n        custom: customTooltips,\n        callbacks: {\n          title() {\n            return performanceTab.value;\n          },\n          label(t, d) {\n            const {\n              yLabel,\n              datasetIndex\n            } = t;\n            return `<span class=\"chart-data\">${yLabel}k</span> <span class=\"data-label\">${d.datasets[datasetIndex].label}</span>`;\n          }\n        }\n      },\n      scales: {\n        yAxes: [{\n          gridLines: {\n            color: '#e5e9f2',\n            borderDash: [3, 3],\n            zeroLineColor: '#e5e9f2',\n            zeroLineWidth: 1,\n            zeroLineBorderDash: [3, 3]\n          },\n          ticks: {\n            beginAtZero: true,\n            fontSize: 13,\n            fontColor: '#182b49',\n            max: 80,\n            stepSize: 20,\n            callback(label) {\n              return `${label}k`;\n            }\n          }\n        }],\n        xAxes: [{\n          gridLines: {\n            display: true,\n            zeroLineWidth: 2,\n            zeroLineColor: 'transparent',\n            color: 'transparent',\n            z: 1,\n            tickMarkLength: 0\n          },\n          ticks: {\n            padding: 10\n          }\n        }]\n      }\n    };\n    return {\n      performanceState,\n      preIsLoading,\n      performance,\n      performanceTab,\n      handleActiveChangePerformance,\n      onPerformanceTab,\n      height,\n      chartOptions,\n      chartLinearGradient,\n      chartMethods,\n      performanceDatasets\n    };\n  }\n});\nexport default WebsitePerformance;","map":{"version":3,"names":["useStore","computed","ref","onMounted","defineComponent","PerformanceChartWrapper","Pstates","chartLinearGradient","customTooltips","Chart","WebsitePerformance","components","setup","store","performance","performanceTab","height","window","innerWidth","performanceState","state","chartContent","performanceData","preIsLoading","perLoading","performanceDatasets","data","value","borderColor","borderWidth","fill","backgroundColor","chartMethods","label","pointStyle","pointRadius","hoverRadius","pointBorderColor","pointBackgroundColor","hoverBorderWidth","borderDash","handleActiveChangePerformance","event","preventDefault","dispatch","elementId","color","document","querySelector","start","end","onPerformanceTab","chartOptions","maintainAspectRatio","elements","z","legend","display","hover","mode","intersect","tooltips","position","enabled","custom","callbacks","title","t","d","yLabel","datasetIndex","datasets","scales","yAxes","gridLines","zeroLineColor","zeroLineWidth","zeroLineBorderDash","ticks","beginAtZero","fontSize","fontColor","max","stepSize","callback","xAxes","tickMarkLength","padding"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/dashboard/overview/performance/WebsitePerformance.vue"],"sourcesContent":["<template>\r\n  <PerformanceChartWrapper>\r\n    <sdCards v-if=\"performanceState !== null\" more title=\"Website Performance\">\r\n      <template #button>\r\n        <div class=\"card-nav\">\r\n          <ul>\r\n            <li :class=\"performance === 'week' ? 'active' : 'deactivate'\">\r\n              <router-link @click=\"(e) => handleActiveChangePerformance(e, 'week')\" to=\"#\"> Week </router-link>\r\n            </li>\r\n            <li :class=\"performance === 'month' ? 'active' : 'deactivate'\">\r\n              <router-link @click=\"(e) => handleActiveChangePerformance(e, 'month')\" to=\"#\"> Month </router-link>\r\n            </li>\r\n            <li :class=\"performance === 'year' ? 'active' : 'deactivate'\">\r\n              <router-link @click=\"(e) => handleActiveChangePerformance(e, 'year')\" to=\"#\"> Year </router-link>\r\n            </li>\r\n          </ul>\r\n        </div>\r\n      </template>\r\n      <template #more>\r\n        <router-link to=\"#\">\r\n          <sdFeatherIcons size=\"16\" type=\"printer\" />\r\n          <span>Printer</span>\r\n        </router-link>\r\n        <router-link to=\"#\">\r\n          <sdFeatherIcons size=\"16\" type=\"book-open\" />\r\n          <span>PDF</span>\r\n        </router-link>\r\n        <router-link to=\"#\">\r\n          <sdFeatherIcons size=\"16\" type=\"file-text\" />\r\n          <span>Google Sheets</span>\r\n        </router-link>\r\n        <router-link to=\"#\">\r\n          <sdFeatherIcons size=\"16\" type=\"x\" />\r\n          <span>Excel (XLSX)</span>\r\n        </router-link>\r\n        <router-link to=\"#\">\r\n          <sdFeatherIcons size=\"16\" type=\"file\" />\r\n          <span>CSV</span>\r\n        </router-link>\r\n      </template>\r\n      <Pstates>\r\n        <div\r\n          @click=\"() => onPerformanceTab('users')\"\r\n          :class=\"`growth-upward ${performanceTab === 'users' && 'active'}`\"\r\n          role=\"button\"\r\n        >\r\n          <p>Users</p>\r\n          <sdHeading as=\"h1\">\r\n            {{ performanceState.users[0] }}\r\n            <sub>\r\n              <span> <sdFeatherIcons type=\"arrow-up\" size=\"14\" /> 25% </span>\r\n            </sub>\r\n          </sdHeading>\r\n        </div>\r\n        <div\r\n          @click=\"() => onPerformanceTab('sessions')\"\r\n          :class=\"`growth-upward ${performanceTab === 'sessions' && 'active'}`\"\r\n          role=\"button\"\r\n        >\r\n          <p>Sessions</p>\r\n          <sdHeading as=\"h1\">\r\n            {{ performanceState.sessions[0] }}\r\n            <sub>\r\n              <span> <sdFeatherIcons type=\"arrow-up\" size=\"14\" /> 47% </span>\r\n            </sub>\r\n          </sdHeading>\r\n        </div>\r\n        <div\r\n          @click=\"() => onPerformanceTab('bounce')\"\r\n          :class=\"`growth-downward ${performanceTab === 'bounce' && 'active'}`\"\r\n          role=\"button\"\r\n        >\r\n          <p>Bounce Rate</p>\r\n          <sdHeading as=\"h1\">\r\n            {{ performanceState.bounce[0] }}\r\n            <sub>\r\n              <span> <sdFeatherIcons type=\"arrow-down\" size=\"14\" /> 28% </span>\r\n            </sub>\r\n          </sdHeading>\r\n        </div>\r\n        <div\r\n          @click=\"() => onPerformanceTab('duration')\"\r\n          :class=\"`growth-upward ${performanceTab === 'duration' && 'active'}`\"\r\n          role=\"button\"\r\n        >\r\n          <p>Session Duration</p>\r\n          <sdHeading as=\"h1\">\r\n            {{ performanceState.duration[0] }}\r\n            <sub>\r\n              <span> <sdFeatherIcons icon=\"arrow-up\" size=\"14\" /> 13% </span>\r\n            </sub>\r\n          </sdHeading>\r\n        </div>\r\n      </Pstates>\r\n\r\n      <div v-if=\"preIsLoading\" class=\"sd-spin\">\r\n        <a-spin />\r\n      </div>\r\n      <div v-else class=\"performance-lineChart\">\r\n        <sdChartContainer class=\"parentContainer\">\r\n          <Chart\r\n            v-if=\"performanceState\"\r\n            class=\"performance\"\r\n            type=\"line\"\r\n            id=\"performance\"\r\n            :labels=\"performanceState.labels\"\r\n            :datasets=\"performanceDatasets\"\r\n            :options=\"chartOptions\"\r\n            :height=\"height\"\r\n          />\r\n        </sdChartContainer>\r\n        <ul>\r\n          <li v-for=\"(item, index) in performanceDatasets\" :key=\"index + 1\" class=\"custom-label\">\r\n            <span\r\n              :style=\"{\r\n                backgroundColor: item.borderColor,\r\n              }\"\r\n            />\r\n            {{ item.label }}\r\n          </li>\r\n        </ul>\r\n      </div>\r\n    </sdCards>\r\n  </PerformanceChartWrapper>\r\n</template>\r\n<script>\r\nimport { useStore } from 'vuex';\r\nimport { computed, ref, onMounted, defineComponent } from 'vue';\r\nimport { PerformanceChartWrapper, Pstates } from '../../style';\r\nimport { chartLinearGradient, customTooltips } from '../../../../components/utilities/utilities';\r\nimport Chart from '../../../../components/utilities/chartjs';\r\n\r\nconst WebsitePerformance = defineComponent({\r\n  components: { PerformanceChartWrapper, Pstates, Chart },\r\n\r\n  setup() {\r\n    const store = useStore();\r\n    const performance = ref('year');\r\n    const performanceTab = ref('users');\r\n    const height = ref(window.innerWidth <= 575 ? 200 : 85);\r\n\r\n    const performanceState = computed(() => store.state.chartContent.performanceData);\r\n    const preIsLoading = computed(() => store.state.chartContent.perLoading);\r\n\r\n    const performanceDatasets = computed(() => [\r\n      {\r\n        data: performanceState.value[performanceTab.value][1],\r\n        borderColor: '#5F63F2',\r\n        borderWidth: 4,\r\n        fill: true,\r\n        backgroundColor: () => chartMethods('performance', ['#5F63F230', '#ffffff05']),\r\n        label: 'Current period',\r\n        pointStyle: 'circle',\r\n        pointRadius: '0',\r\n        hoverRadius: '9',\r\n        pointBorderColor: '#fff',\r\n        pointBackgroundColor: '#5F63F2',\r\n        hoverBorderWidth: 5,\r\n      },\r\n      {\r\n        data: performanceState.value[performanceTab.value][2],\r\n        borderColor: '#C6D0DC',\r\n        borderWidth: 2,\r\n        fill: false,\r\n        backgroundColor: '#00173750',\r\n        label: 'Previous period',\r\n        borderDash: [3, 3],\r\n        pointRadius: '0',\r\n        hoverRadius: '0',\r\n      },\r\n    ]);\r\n\r\n    const handleActiveChangePerformance = (event, value) => {\r\n      event.preventDefault();\r\n      performance.value = value;\r\n      return store.dispatch('performanceFilterData', value);\r\n    };\r\n\r\n    function chartMethods(elementId, color) {\r\n      return chartLinearGradient(document.querySelector(`.${elementId}`), 300, {\r\n        start: color[0],\r\n        end: color[1],\r\n      });\r\n    }\r\n\r\n    const onPerformanceTab = (value) => {\r\n      performanceTab.value = value;\r\n      return store.dispatch('setIsLoading');\r\n    };\r\n\r\n    onMounted(() => {\r\n      store.dispatch('performanceGetData');\r\n    });\r\n\r\n    const chartOptions = {\r\n      maintainAspectRatio: true,\r\n      elements: {\r\n        z: 9999,\r\n      },\r\n      legend: {\r\n        display: false,\r\n      },\r\n      hover: {\r\n        mode: 'index',\r\n        intersect: false,\r\n      },\r\n      tooltips: {\r\n        mode: 'label',\r\n        intersect: false,\r\n        backgroundColor: '#ffffff',\r\n        position: 'average',\r\n        enabled: false,\r\n        custom: customTooltips,\r\n        callbacks: {\r\n          title() {\r\n            return performanceTab.value;\r\n          },\r\n          label(t, d) {\r\n            const { yLabel, datasetIndex } = t;\r\n            return `<span class=\"chart-data\">${yLabel}k</span> <span class=\"data-label\">${d.datasets[datasetIndex].label}</span>`;\r\n          },\r\n        },\r\n      },\r\n      scales: {\r\n        yAxes: [\r\n          {\r\n            gridLines: {\r\n              color: '#e5e9f2',\r\n              borderDash: [3, 3],\r\n              zeroLineColor: '#e5e9f2',\r\n              zeroLineWidth: 1,\r\n              zeroLineBorderDash: [3, 3],\r\n            },\r\n            ticks: {\r\n              beginAtZero: true,\r\n              fontSize: 13,\r\n              fontColor: '#182b49',\r\n              max: 80,\r\n              stepSize: 20,\r\n              callback(label) {\r\n                return `${label}k`;\r\n              },\r\n            },\r\n          },\r\n        ],\r\n        xAxes: [\r\n          {\r\n            gridLines: {\r\n              display: true,\r\n              zeroLineWidth: 2,\r\n              zeroLineColor: 'transparent',\r\n              color: 'transparent',\r\n              z: 1,\r\n              tickMarkLength: 0,\r\n            },\r\n            ticks: {\r\n              padding: 10,\r\n            },\r\n          },\r\n        ],\r\n      },\r\n    };\r\n\r\n    return {\r\n      performanceState,\r\n      preIsLoading,\r\n      performance,\r\n      performanceTab,\r\n      handleActiveChangePerformance,\r\n      onPerformanceTab,\r\n      height,\r\n      chartOptions,\r\n      chartLinearGradient,\r\n      chartMethods,\r\n      performanceDatasets,\r\n    };\r\n  },\r\n});\r\n\r\nexport default WebsitePerformance;\r\n</script>\r\n"],"mappings":"AA8HA,SAASA,QAAO,QAAS,MAAM;AAC/B,SAASC,QAAQ,EAAEC,GAAG,EAAEC,SAAS,EAAEC,eAAc,QAAS,KAAK;AAC/D,SAASC,uBAAuB,EAAEC,OAAM,QAAS,aAAa;AAC9D,SAASC,mBAAmB,EAAEC,cAAa,QAAS,4CAA4C;AAChG,OAAOC,KAAI,MAAO,0CAA0C;AAE5D,MAAMC,kBAAiB,GAAIN,eAAe,CAAC;EACzCO,UAAU,EAAE;IAAEN,uBAAuB;IAAEC,OAAO;IAAEG;EAAM,CAAC;EAEvDG,KAAKA,CAAA,EAAG;IACN,MAAMC,KAAI,GAAIb,QAAQ,EAAE;IACxB,MAAMc,WAAU,GAAIZ,GAAG,CAAC,MAAM,CAAC;IAC/B,MAAMa,cAAa,GAAIb,GAAG,CAAC,OAAO,CAAC;IACnC,MAAMc,MAAK,GAAId,GAAG,CAACe,MAAM,CAACC,UAAS,IAAK,GAAE,GAAI,GAAE,GAAI,EAAE,CAAC;IAEvD,MAAMC,gBAAe,GAAIlB,QAAQ,CAAC,MAAMY,KAAK,CAACO,KAAK,CAACC,YAAY,CAACC,eAAe,CAAC;IACjF,MAAMC,YAAW,GAAItB,QAAQ,CAAC,MAAMY,KAAK,CAACO,KAAK,CAACC,YAAY,CAACG,UAAU,CAAC;IAExE,MAAMC,mBAAkB,GAAIxB,QAAQ,CAAC,MAAM,CACzC;MACEyB,IAAI,EAAEP,gBAAgB,CAACQ,KAAK,CAACZ,cAAc,CAACY,KAAK,CAAC,CAAC,CAAC,CAAC;MACrDC,WAAW,EAAE,SAAS;MACtBC,WAAW,EAAE,CAAC;MACdC,IAAI,EAAE,IAAI;MACVC,eAAe,EAAEA,CAAA,KAAMC,YAAY,CAAC,aAAa,EAAE,CAAC,WAAW,EAAE,WAAW,CAAC,CAAC;MAC9EC,KAAK,EAAE,gBAAgB;MACvBC,UAAU,EAAE,QAAQ;MACpBC,WAAW,EAAE,GAAG;MAChBC,WAAW,EAAE,GAAG;MAChBC,gBAAgB,EAAE,MAAM;MACxBC,oBA