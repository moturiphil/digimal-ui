{"ast":null,"code":"import { Focard, RatioCard } from '../../style';\nimport Chart from '../../../../components/utilities/chartjs';\nimport { chartLinearGradient, customTooltips } from '../../../../components/utilities/utilities';\nimport { defineComponent } from 'vue';\nconst CardGroup = defineComponent({\n  name: 'CardGroup',\n  components: {\n    Focard,\n    RatioCard,\n    chartjs: Chart\n  },\n  methods: {\n    chartMethods(elementId, color) {\n      return chartLinearGradient(document.querySelector(`.${elementId}`), 80, {\n        start: color[0],\n        end: color[1]\n      });\n    }\n  },\n  data() {\n    return {\n      areaChartOption: {\n        maintainAspectRatio: true,\n        responsive: false,\n        hover: {\n          mode: 'nearest',\n          intersect: false\n        },\n        layout: {\n          padding: {\n            left: -10,\n            right: 0,\n            top: 2,\n            bottom: -10\n          }\n        },\n        legend: {\n          display: false,\n          labels: {\n            display: false\n          }\n        },\n        elements: {\n          point: {\n            radius: 0\n          }\n        },\n        scales: {\n          yAxes: [{\n            stacked: true,\n            gridLines: {\n              display: false,\n              color: '#e5e9f2'\n            },\n            ticks: {\n              beginAtZero: true,\n              fontSize: 10,\n              display: false,\n              stepSize: 20\n            }\n          }],\n          xAxes: [{\n            stacked: true,\n            gridLines: {\n              display: false\n            },\n            ticks: {\n              beginAtZero: true,\n              fontSize: 11,\n              display: false\n            }\n          }]\n        },\n        tooltips: {\n          mode: 'label',\n          intersect: false,\n          position: 'average',\n          enabled: false,\n          custom: customTooltips,\n          callbacks: {\n            label(t, d) {\n              const dstLabel = d.datasets[t.datasetIndex].label;\n              const {\n                yLabel\n              } = t;\n              return `<span class=\"chart-data\">${yLabel}</span> <span class=\"data-label\">${dstLabel}</span>`;\n            },\n            labelColor(tooltipItem, chart) {\n              const dataset = chart.config.data.datasets[tooltipItem.datasetIndex];\n              return {\n                backgroundColor: dataset.borderColor,\n                borderColor: 'transparent',\n                usePointStyle: true\n              };\n            }\n          }\n        }\n      }\n    };\n  }\n});\nexport default CardGroup;","map":{"version":3,"names":["Focard","RatioCard","Chart","chartLinearGradient","customTooltips","defineComponent","CardGroup","name","components","chartjs","methods","chartMethods","elementId","color","document","querySelector","start","end","data","areaChartOption","maintainAspectRatio","responsive","hover","mode","intersect","layout","padding","left","right","top","bottom","legend","display","labels","elements","point","radius","scales","yAxes","stacked","gridLines","ticks","beginAtZero","fontSize","stepSize","xAxes","tooltips","position","enabled","custom","callbacks","label","t","d","dstLabel","datasets","datasetIndex","yLabel","labelColor","tooltipItem","chart","dataset","config","backgroundColor","borderColor","usePointStyle"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/dashboard/overview/business/CardGroup.vue"],"sourcesContent":["<template>\r\n  <a-row :gutter=\"25\">\r\n    <a-col :md=\"12\">\r\n      <Focard>\r\n        <div class=\"forcast-card-box\">\r\n          <sdCards headless title=\"Net Profit\">\r\n            <div class=\"focard-details growth-downward\">\r\n              <sdHeading as=\"h1\">$25.3k</sdHeading>\r\n              <p class=\"focard-status\">\r\n                <span class=\"focard-status__percentage\"> <sdFeatherIcons type=\"arrow-down\" /> 25% </span>\r\n                <span>Since last month</span>\r\n              </p>\r\n            </div>\r\n            <sdChartContainer class=\"parentContainer\">\r\n              <chartjs\r\n                type=\"line\"\r\n                class=\"netProfit\"\r\n                id=\"netProfit\"\r\n                :labels=\"['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'july', 'Aug', 'Sep', 'Oct']\"\r\n                :datasets=\"[\r\n                  {\r\n                    data: [30, 10, 20, 25, 20, 30, 15, 25, 15, 10],\r\n                    label: 'Net',\r\n                    borderColor: '#5F63F2',\r\n                    borderWidth: 3,\r\n                    fill: true,\r\n                    pointHoverBackgroundColor: '#5F63F2',\r\n                    pointHoverBorderWidth: 0,\r\n                    pointHoverBorderColor: 'transparent',\r\n                    backgroundColor: () => chartMethods('netProfit', ['#5F63F212', '#5F63F202']),\r\n                  },\r\n                ]\"\r\n                :options=\"areaChartOption\"\r\n                :height=\"80\"\r\n              />\r\n            </sdChartContainer>\r\n          </sdCards>\r\n        </div>\r\n      </Focard>\r\n    </a-col>\r\n    <a-col :md=\"12\">\r\n      <Focard>\r\n        <div class=\"forcast-card-box\">\r\n          <sdCards headless title=\"Gross Profit\">\r\n            <div class=\"focard-details growth-upward\">\r\n              <sdHeading as=\"h1\">$82.24k</sdHeading>\r\n              <p class=\"focard-status\">\r\n                <span class=\"focard-status__percentage\"> <sdFeatherIcons type=\"arrow-up\" /> 25% </span>\r\n                <span>Since last month</span>\r\n              </p>\r\n            </div>\r\n            <sdChartContainer class=\"parentContainer\">\r\n              <chartjs\r\n                id=\"grossProfit\"\r\n                class=\"grossProfit\"\r\n                type=\"line\"\r\n                :labels=\"['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'july', 'Aug', 'Sep', 'Oct']\"\r\n                :datasets=\"[\r\n                  {\r\n                    data: [30, 10, 20, 25, 20, 30, 15, 25, 15, 10],\r\n                    label: 'Gross',\r\n                    borderColor: '#20C997',\r\n                    borderWidth: 3,\r\n                    fill: true,\r\n                    pointHoverBackgroundColor: '#20c997',\r\n                    pointHoverBorderWidth: 0,\r\n                    pointHoverBorderColor: 'transparent',\r\n                    backgroundColor: () => chartMethods('grossProfit', ['#20C99712', '#20C99702']),\r\n                  },\r\n                ]\"\r\n                :height=\"80\"\r\n                :options=\"areaChartOption\"\r\n              />\r\n            </sdChartContainer>\r\n          </sdCards>\r\n        </div>\r\n      </Focard>\r\n    </a-col>\r\n    <a-col :md=\"12\" :sm=\"12\" :xs=\"24\">\r\n      <RatioCard>\r\n        <sdCards headless title=\"Quick Ratio\">\r\n          <div class=\"ratio-content\">\r\n            <sdHeading as=\"h1\">1.8</sdHeading>\r\n            <a-progress :percent=\"80\" class=\"progress-success\" />\r\n            <p><strong>1 or higher</strong> quick ratio target</p>\r\n          </div>\r\n        </sdCards>\r\n      </RatioCard>\r\n    </a-col>\r\n    <a-col :md=\"12\" :sm=\"12\" :xs=\"24\">\r\n      <RatioCard>\r\n        <sdCards headless title=\"Current Ratio\">\r\n          <div class=\"ratio-content\">\r\n            <sdHeading as=\"h1\">2.4</sdHeading>\r\n            <a-progress :percent=\"72\" class=\"ant-progress-status-warning\" />\r\n            <p><strong>3 or higher</strong> current ratio target</p>\r\n          </div>\r\n        </sdCards>\r\n      </RatioCard>\r\n    </a-col>\r\n  </a-row>\r\n</template>\r\n<script>\r\nimport { Focard, RatioCard } from '../../style';\r\nimport Chart from '../../../../components/utilities/chartjs';\r\nimport { chartLinearGradient, customTooltips } from '../../../../components/utilities/utilities';\r\nimport { defineComponent } from 'vue';\r\n\r\nconst CardGroup = defineComponent({\r\n  name: 'CardGroup',\r\n  components: { Focard, RatioCard, chartjs: Chart },\r\n  methods: {\r\n    chartMethods(elementId, color) {\r\n      return chartLinearGradient(document.querySelector(`.${elementId}`), 80, {\r\n        start: color[0],\r\n        end: color[1],\r\n      });\r\n    },\r\n  },\r\n  data() {\r\n    return {\r\n      areaChartOption: {\r\n        maintainAspectRatio: true,\r\n        responsive: false,\r\n        hover: {\r\n          mode: 'nearest',\r\n          intersect: false,\r\n        },\r\n        layout: {\r\n          padding: {\r\n            left: -10,\r\n            right: 0,\r\n            top: 2,\r\n            bottom: -10,\r\n          },\r\n        },\r\n        legend: {\r\n          display: false,\r\n          labels: {\r\n            display: false,\r\n          },\r\n        },\r\n        elements: {\r\n          point: {\r\n            radius: 0,\r\n          },\r\n        },\r\n        scales: {\r\n          yAxes: [\r\n            {\r\n              stacked: true,\r\n              gridLines: {\r\n                display: false,\r\n                color: '#e5e9f2',\r\n              },\r\n              ticks: {\r\n                beginAtZero: true,\r\n                fontSize: 10,\r\n                display: false,\r\n                stepSize: 20,\r\n              },\r\n            },\r\n          ],\r\n          xAxes: [\r\n            {\r\n              stacked: true,\r\n              gridLines: {\r\n                display: false,\r\n              },\r\n\r\n              ticks: {\r\n                beginAtZero: true,\r\n                fontSize: 11,\r\n                display: false,\r\n              },\r\n            },\r\n          ],\r\n        },\r\n        tooltips: {\r\n          mode: 'label',\r\n          intersect: false,\r\n          position: 'average',\r\n          enabled: false,\r\n          custom: customTooltips,\r\n          callbacks: {\r\n            label(t, d) {\r\n              const dstLabel = d.datasets[t.datasetIndex].label;\r\n              const { yLabel } = t;\r\n              return `<span class=\"chart-data\">${yLabel}</span> <span class=\"data-label\">${dstLabel}</span>`;\r\n            },\r\n            labelColor(tooltipItem, chart) {\r\n              const dataset = chart.config.data.datasets[tooltipItem.datasetIndex];\r\n              return {\r\n                backgroundColor: dataset.borderColor,\r\n                borderColor: 'transparent',\r\n                usePointStyle: true,\r\n              };\r\n            },\r\n          },\r\n        },\r\n      },\r\n    };\r\n  },\r\n});\r\n\r\nexport default CardGroup;\r\n</script>\r\n"],"mappings":"AAuGA,SAASA,MAAM,EAAEC,SAAQ,QAAS,aAAa;AAC/C,OAAOC,KAAI,MAAO,0CAA0C;AAC5D,SAASC,mBAAmB,EAAEC,cAAa,QAAS,4CAA4C;AAChG,SAASC,eAAc,QAAS,KAAK;AAErC,MAAMC,SAAQ,GAAID,eAAe,CAAC;EAChCE,IAAI,EAAE,WAAW;EACjBC,UAAU,EAAE;IAAER,MAAM;IAAEC,SAAS;IAAEQ,OAAO,EAAEP;EAAM,CAAC;EACjDQ,OAAO,EAAE;IACPC,YAAYA,CAACC,SAAS,EAAEC,KAAK,EAAE;MAC7B,OAAOV,mBAAmB,CAACW,QAAQ,CAACC,aAAa,CAAE,IAAGH,SAAU,EAAC,CAAC,EAAE,EAAE,EAAE;QACtEI,KAAK,EAAEH,KAAK,CAAC,CAAC,CAAC;QACfI,GAAG,EAAEJ,KAAK,CAAC,CAAC;MACd,CAAC,CAAC;IACJ;EACF,CAAC;EACDK,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,eAAe,EAAE;QACfC,mBAAmB,EAAE,IAAI;QACzBC,UAAU,EAAE,KAAK;QACjBC,KAAK,EAAE;UACLC,IAAI,EAAE,SAAS;UACfC,SAAS,EAAE;QACb,CAAC;QACDC,MAAM,EAAE;UACNC,OAAO,EAAE;YACPC,IAAI,EAAE,CAAC,EAAE;YACTC,KAAK,EAAE,CAAC;YACRC,GAAG,EAAE,CAAC;YACNC,MAAM,EAAE,CAAC;UACX;QACF,CAAC;QACDC,MAAM,EAAE;UACNC,OAAO,EAAE,KAAK;UACdC,MAAM,EAAE;YACND,OAAO,EAAE;UACX;QACF,CAAC;QACDE,QAAQ,EAAE;UACRC,KAAK,EAAE;YACLC,MAAM,EAAE;UACV;QACF,CAAC;QACDC,MAAM,EAAE;UACNC,KAAK,EAAE,CACL;YACEC,OAAO,EAAE,IAAI;YACbC,SAAS,EAAE;cACTR,OAAO,EAAE,KAAK;cACdnB,KAAK,EAAE;YACT,CAAC;YACD4B,KAAK,EAAE;cACLC,WAAW,EAAE,IAAI;cACjBC,QAAQ,EAAE,EAAE;cACZX,OAAO,EAAE,KAAK;cACdY,QAAQ,EAAE;YACZ;UACF,CAAC,CACF;UACDC,KAAK,EAAE,CACL;YACEN,OAAO,EAAE,IAAI;YACbC