{"ast":null,"code":"import { computed, onMounted, ref, defineComponent } from 'vue';\nimport { useStore } from 'vuex';\nimport { CardBarChart } from '../../style';\nimport Chartjs from '../../../../components/utilities/chartjs';\nconst ClosedDeals = defineComponent({\n  name: 'ClosedDeals',\n  components: {\n    CardBarChart,\n    Chartjs\n  },\n  setup() {\n    const {\n      state,\n      dispatch\n    } = useStore();\n    const closeDealTabActive = ref('year');\n    const closeDealState = computed(() => state.chartContent.closeDealData);\n    const cdIsLoading = computed(() => state.chartContent.cdLoading);\n    const height = ref(window.innerWidth <= 575 ? 200 : 78);\n    const closeDealDatasets = computed(() => [{\n      data: closeDealState.value.won,\n      backgroundColor: '#20C99780',\n      hoverBackgroundColor: '#20C997',\n      label: 'Nets Distributed',\n      average: '50.8',\n      maxBarThickness: 10,\n      barThickness: 12,\n      percent: 49\n    }, {\n      data: closeDealState.value.amount,\n      backgroundColor: '#5F63F280',\n      hoverBackgroundColor: '#5F63F2',\n      label: 'Closed Events',\n      average: '2900',\n      maxBarThickness: 10,\n      barThickness: 12,\n      percent: 20\n    }]);\n    onMounted(() => {\n      dispatch('closeDealGetData');\n    });\n    const handleActiveChangeYoutube = (e, value) => {\n      e.preventDefault();\n      closeDealTabActive.value = value;\n      dispatch('closeDealFilterData', value);\n    };\n    return {\n      closeDealState,\n      cdIsLoading,\n      closeDealTabActive,\n      closeDealDatasets,\n      handleActiveChangeYoutube,\n      height\n    };\n  }\n});\nexport default ClosedDeals;","map":{"version":3,"names":["computed","onMounted","ref","defineComponent","useStore","CardBarChart","Chartjs","ClosedDeals","name","components","setup","state","dispatch","closeDealTabActive","closeDealState","chartContent","closeDealData","cdIsLoading","cdLoading","height","window","innerWidth","closeDealDatasets","data","value","won","backgroundColor","hoverBackgroundColor","label","average","maxBarThickness","barThickness","percent","amount","handleActiveChangeYoutube","e","preventDefault"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/dashboard/overview/massnet/PerformancePerCounty.vue"],"sourcesContent":["<template>\n    <sdCards v-if=\"closeDealState\" title=\"Performance Per County\">\n      <template #button>\n        <div class=\"card-nav\">\n          <ul>\n            <li :class=\"closeDealTabActive === 'week' ? 'active' : 'deactivate'\">\n              <router-link @click=\"(e) => handleActiveChangeYoutube(e, 'week')\" to=\"#\"> Week </router-link>\n            </li>\n            <li :class=\"closeDealTabActive === 'month' ? 'active' : 'deactivate'\">\n              <router-link @click=\"(e) => handleActiveChangeYoutube(e, 'month')\" to=\"#\"> Month </router-link>\n            </li>\n            <li :class=\"closeDealTabActive === 'year' ? 'active' : 'deactivate'\">\n              <router-link @click=\"(e) => handleActiveChangeYoutube(e, 'year')\" to=\"#\"> Year </router-link>\n            </li>\n          </ul>\n        </div>\n      </template>\n  \n      <div v-if=\"cdIsLoading\" class=\"sd-spin\">\n        <a-spin />\n      </div>\n  \n      <CardBarChart v-else>\n        <div class=\"deals-barChart\">\n          <div v-for=\"(item, key) in closeDealDatasets\" :key=\"key + 1\" class=\"card-bar-top\">\n            <h4>\n              {{ item.label }}\n              <p :class=\"item.percent >= 50 ? 'growth-up' : 'growth-down'\">\n                <span class=\"deal-value\">{{ item.average }}</span>\n                <span class=\"deal-percentage\">\n                  <sdFeatherIcons :icon=\"item.percent >= 50 ? 'arrow-up' : 'arrow-down'\" size=\"14\" />\n                  {{ item.percent }}%\n                </span>\n              </p>\n            </h4>\n          </div>\n        </div>\n  \n        <Chartjs\n          class=\"closeDeal\"\n          :labels=\"closeDealState.labels\"\n          :datasets=\"closeDealDatasets\"\n          :options=\"{\n            maintainAspectRatio: true,\n            responsive: true,\n            layout: {\n              padding: {\n                top: 20,\n              },\n            },\n            legend: {\n              display: false,\n              position: 'top',\n              align: 'end',\n              labels: {\n                boxWidth: 6,\n                display: true,\n                usePointStyle: true,\n              },\n            },\n  \n            scales: {\n              yAxes: [\n                {\n                  gridLines: {\n                    color: '#e5e9f2',\n                    borderDash: [3, 3],\n                    zeroLineColor: '#e5e9f2',\n                    zeroLineWidth: 1,\n                    zeroLineBorderDash: [3, 3],\n                  },\n                  ticks: {\n                    beginAtZero: true,\n                    fontSize: 12,\n                    fontColor: '#182b49',\n                    max: Math.max(...closeDealState.won),\n                    stepSize: Math.max(...closeDealState.won) / 5,\n                    display: true,\n                    min: 0,\n                    padding: 10,\n                  },\n                },\n              ],\n              xAxes: [\n                {\n                  gridLines: {\n                    display: true,\n                    zeroLineWidth: 2,\n                    zeroLineColor: '#fff',\n                    color: 'transparent',\n                    z: 1,\n                  },\n                  ticks: {\n                    beginAtZero: true,\n                    fontSize: 12,\n                    fontColor: '#182b49',\n                    min: 0,\n                  },\n                },\n              ],\n            },\n          }\"\n          :height=\"height\"\n        />\n        <ul class=\"deals-list\">\n          <li v-for=\"(item, key) in closeDealDatasets\" :key=\"key + 1\" class=\"custom-label\">\n            <span\n              :style=\"{\n                backgroundColor: item.hoverBackgroundColor,\n              }\"\n            />\n            {{ item.label }}\n          </li>\n        </ul>\n      </CardBarChart>\n    </sdCards>\n  </template>\n  <script>\n  import { computed, onMounted, ref, defineComponent } from 'vue';\n  import { useStore } from 'vuex';\n  import { CardBarChart } from '../../style';\n  import Chartjs from '../../../../components/utilities/chartjs';\n  \n  const ClosedDeals = defineComponent({\n    name: 'ClosedDeals',\n    components: { CardBarChart, Chartjs },\n    setup() {\n      const { state, dispatch } = useStore();\n      const closeDealTabActive = ref('year');\n      const closeDealState = computed(() => state.chartContent.closeDealData);\n      const cdIsLoading = computed(() => state.chartContent.cdLoading);\n      const height = ref(window.innerWidth <= 575 ? 200 : 78);\n      const closeDealDatasets = computed(() => [\n        {\n          data: closeDealState.value.won,\n          backgroundColor: '#20C99780',\n          hoverBackgroundColor: '#20C997',\n          label: 'Nets Distributed',\n          average: '50.8',\n          maxBarThickness: 10,\n          barThickness: 12,\n          percent: 49,\n        },\n        {\n          data: closeDealState.value.amount,\n          backgroundColor: '#5F63F280',\n          hoverBackgroundColor: '#5F63F2',\n          label: 'Closed Events',\n          average: '2900',\n          maxBarThickness: 10,\n          barThickness: 12,\n          percent: 20,\n        },\n      ]);\n  \n      onMounted(() => {\n        dispatch('closeDealGetData');\n      });\n  \n      const handleActiveChangeYoutube = (e, value) => {\n        e.preventDefault();\n  \n        closeDealTabActive.value = value;\n  \n        dispatch('closeDealFilterData', value);\n      };\n  \n      return {\n        closeDealState,\n        cdIsLoading,\n        closeDealTabActive,\n        closeDealDatasets,\n        handleActiveChangeYoutube,\n        height,\n      };\n    },\n  });\n  \n  export default ClosedDeals;\n  </script>\n  "],"mappings":"AAsHE,SAASA,QAAQ,EAAEC,SAAS,EAAEC,GAAG,EAAEC,eAAc,QAAS,KAAK;AAC/D,SAASC,QAAO,QAAS,MAAM;AAC/B,SAASC,YAAW,QAAS,aAAa;AAC1C,OAAOC,OAAM,MAAO,0CAA0C;AAE9D,MAAMC,WAAU,GAAIJ,eAAe,CAAC;EAClCK,IAAI,EAAE,aAAa;EACnBC,UAAU,EAAE;IAAEJ,YAAY;IAAEC;EAAQ,CAAC;EACrCI,KAAKA,CAAA,EAAG;IACN,MAAM;MAAEC,KAAK;MAAEC;IAAS,IAAIR,QAAQ,EAAE;IACtC,MAAMS,kBAAiB,GAAIX,GAAG,CAAC,MAAM,CAAC;IACtC,MAAMY,cAAa,GAAId,QAAQ,CAAC,MAAMW,KAAK,CAACI,YAAY,CAACC,aAAa,CAAC;IACvE,MAAMC,WAAU,GAAIjB,QAAQ,CAAC,MAAMW,KAAK,CAACI,YAAY,CAACG,SAAS,CAAC;IAChE,MAAMC,MAAK,GAAIjB,GAAG,CAACkB,MAAM,CAACC,UAAS,IAAK,GAAE,GAAI,GAAE,GAAI,EAAE,CAAC;IACvD,MAAMC,iBAAgB,GAAItB,QAAQ,CAAC,MAAM,CACvC;MACEuB,IAAI,EAAET,cAAc,CAACU,KAAK,CAACC,GAAG;MAC9BC,eAAe,EAAE,WAAW;MAC5BC,oBAAoB,EAAE,SAAS;MAC/BC,KAAK,EAAE,kBAAkB;MACzBC,OAAO,EAAE,MAAM;MACfC,eAAe,EAAE,EAAE;MACnBC,YAAY,EAAE,EAAE;MAChBC,OAAO,EAAE;IACX,CAAC,EACD;MACET,IAAI,EAAET,cAAc,CAACU,KAAK,CAACS,MAAM;MACjCP,eAAe,EAAE,WAAW;MAC5BC,oBAAoB,EAAE,SAAS;MAC/BC,KAAK,EAAE,eAAe;MACtBC,OAAO,EAAE,MAAM;MACfC,eAAe,EAAE,EAAE;MACnBC,YAAY,EAAE,EAAE;MAChBC,OAAO,EAAE;IACX,CAAC,CACF,CAAC;IAEF/B,SAAS,CAAC,MAAM;MACdW,QAAQ,CAAC,kBAAkB,CAAC;IAC9B,CAAC,CAAC;IAEF,MAAMsB,yBAAwB,GAAIA,CAACC,CAAC,EAAEX,KAAK,KAAK;MAC9CW,CAAC,CAACC,cAAc,EAAE;MAElBvB,kBAAkB,CAACW,KAAI,GAAIA,KAAK;MAEhCZ,QAAQ,CAAC,qBAAqB,EAAEY,KAAK,CAAC;IACxC,CAAC;IAED,OAAO;MACLV,cAAc;MACdG,WAAW;MACXJ,kBAAkB;MAClBS,iBAAiB;MACjBY,yBAAyB;MACzBf;IACF,CAAC;EACH;AACF,CAAC,CAAC;AAEF,eAAeZ,WAAW"},"metadata":{},"sourceType":"module","externalDependencies":[]}