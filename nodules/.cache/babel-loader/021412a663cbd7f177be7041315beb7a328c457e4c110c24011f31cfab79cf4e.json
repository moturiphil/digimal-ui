{"ast":null,"code":"import { RecordViewWrapper } from \"../style\";\nimport { Main, TableWrapper } from \"../../styled\";\nimport { useStore } from \"vuex\";\nimport { computed, onMounted, ref, reactive, defineComponent } from \"vue\";\n// import axios from \"axios\";\nimport authHeader from \"../../../services/auth-header\";\nconst columns = [\n//   {\n//     title: \"Id\",\n//     dataIndex: \"id\",\n//     key: \"id\",\n//   },\n{\n  title: \"County Name\",\n  dataIndex: \"name\",\n  key: \"id\"\n}, {\n  title: \"County Code\",\n  dataIndex: \"code\",\n  key: \"name\"\n}, {\n  title: \"Org ID\",\n  dataIndex: \"org_id\",\n  key: \"org_id\"\n}, {\n  title: \"\",\n  dataIndex: \"\",\n  key: \"units\",\n  slots: {\n    customRender: \"units\"\n  }\n}];\nconst DragAndDropTable = defineComponent({\n  name: \"ViewPage\",\n  components: {\n    RecordViewWrapper,\n    Main,\n    TableWrapper\n  },\n  setup() {\n    const {\n      state,\n      dispatch\n    } = useStore();\n    const crud = computed(() => state.crud.data);\n    const isLoading = computed(() => state.crud.loading);\n    const selectedRowKeys = ref([]);\n    const dataSource = ref([]);\n\n    //   const api_url = UserService;\n    //   console.log(api_url);\n\n    onMounted(async () => {\n      try {\n        const response = await fetch(`${process.env.VUE_APP_BASE_URL}/counties`, {\n          method: \"GET\",\n          headers: authHeader()\n        });\n        const data = await response.json();\n        dataSource.value = data;\n        console.log(dataSource.value);\n      } catch (error) {\n        console.error(error);\n      }\n    });\n    const handleDelete = id => {\n      const confirm = window.confirm(\"Are you sure delete this?\");\n      if (confirm) {\n        dispatch(\"axiosDataDelete\", {\n          id,\n          getData: () => {\n            dispatch(\"axiosCrudGetData\");\n          }\n        });\n      }\n      return false;\n    };\n    const formState = reactive({\n      searchItem: \"\"\n    });\n    const onSelectChange = selectedRowKey => {\n      selectedRowKeys.value = selectedRowKey;\n    };\n    const rowSelection = {\n      selectedRowKeys,\n      onChange: onSelectChange\n    };\n    return {\n      crud,\n      isLoading,\n      selectedRowKeys,\n      handleDelete,\n      rowSelection,\n      onSelectChange,\n      dataSource,\n      columns,\n      formState\n    };\n  }\n});\nexport default DragAndDropTable;","map":{"version":3,"names":["RecordViewWrapper","Main","TableWrapper","useStore","computed","onMounted","ref","reactive","defineComponent","authHeader","columns","title","dataIndex","key","slots","customRender","DragAndDropTable","name","components","setup","state","dispatch","crud","data","isLoading","loading","selectedRowKeys","dataSource","response","fetch","process","env","VUE_APP_BASE_URL","method","headers","json","value","console","log","error","handleDelete","id","confirm","window","getData","formState","searchItem","onSelectChange","selectedRowKey","rowSelection","onChange"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/pages/orgUnits/viewUnits.vue"],"sourcesContent":["<template>\n  <RecordViewWrapper>\n    <sdPageHeader title=\"Kenya Counties\">\n      <template #subTitle>\n        <sdButton class=\"btn-add_new\" size=\"default\" type=\"success\"> </sdButton>\n      </template>\n    </sdPageHeader>\n    <Main>\n      <a-row :gutter=\"15\">\n        <a-col class=\"w-100\" :md=\"24\">\n          <sdCards headless>\n            <div v-if=\"isLoading\" class=\"spin\">\n              <a-spin />\n            </div>\n            <!-- :rowSelection=\"rowSelection\" -->\n            <div v-else>\n              <TableWrapper class=\"table-data-view table-responsive\">\n                <a-table\n                  :pagination=\"{ pageSize: 10, showSizeChanger: true }\"\n                  :dataSource=\"dataSource\"\n                  :columns=\"columns\"\n                >\n                  <template #units=\"{ record }\">\n                    <td>\n                      <div class=\"table-actions\">\n                        <sdButton>\n                          <router-link\n                            :to=\"{\n                              path: `/org-units${record.id}/sub-counties`,\n                              query: { id: record.org_id },\n                            }\"\n                            class=\"btn-icon\"\n                            type=\"info\"\n                            shape=\"circle\"\n                          >\n                            <sdFeatherIcons type=\"eye\" size=\"16\" />\n                            &nbsp;&nbsp; View Sub Counties\n                          </router-link>\n                        </sdButton>\n                      </div>\n                    </td>\n                  </template>\n                </a-table>\n              </TableWrapper>\n            </div>\n          </sdCards>\n        </a-col>\n      </a-row>\n      <a-col :xs=\"24\">\n        <DragAndDropTable />\n      </a-col>\n    </Main>\n  </RecordViewWrapper>\n</template>\n<script>\nimport { RecordViewWrapper } from \"../style\";\nimport { Main, TableWrapper } from \"../../styled\";\nimport { useStore } from \"vuex\";\nimport { computed, onMounted, ref, reactive, defineComponent } from \"vue\";\n// import axios from \"axios\";\nimport authHeader from \"../../../services/auth-header\";\n\nconst columns = [\n  //   {\n  //     title: \"Id\",\n  //     dataIndex: \"id\",\n  //     key: \"id\",\n  //   },\n  {\n    title: \"County Name\",\n    dataIndex: \"name\",\n    key: \"id\",\n  },\n  {\n    title: \"County Code\",\n    dataIndex: \"code\",\n    key: \"name\",\n  },\n  {\n    title: \"Org ID\",\n    dataIndex: \"org_id\",\n    key: \"org_id\",\n  },\n  {\n    title: \"\",\n    dataIndex: \"\",\n    key: \"units\",\n    slots: { customRender: \"units\" },\n  },\n];\n\nconst DragAndDropTable = defineComponent({\n  name: \"ViewPage\",\n  components: { RecordViewWrapper, Main, TableWrapper },\n\n  setup() {\n    const { state, dispatch } = useStore();\n    const crud = computed(() => state.crud.data);\n    const isLoading = computed(() => state.crud.loading);\n    const selectedRowKeys = ref([]);\n    const dataSource = ref([]);\n\n    //   const api_url = UserService;\n    //   console.log(api_url);\n\n    onMounted(async () => {\n      try {\n        const response = await fetch(\n          `${process.env.VUE_APP_BASE_URL}/counties`,\n          {\n            method: \"GET\",\n            headers: authHeader(),\n          }\n        );\n        const data = await response.json();\n        dataSource.value = data;\n        console.log(dataSource.value);\n      } catch (error) {\n        console.error(error);\n      }\n    });\n\n    const handleDelete = (id) => {\n      const confirm = window.confirm(\"Are you sure delete this?\");\n      if (confirm) {\n        dispatch(\"axiosDataDelete\", {\n          id,\n          getData: () => {\n            dispatch(\"axiosCrudGetData\");\n          },\n        });\n      }\n      return false;\n    };\n\n    const formState = reactive({\n      searchItem: \"\",\n    });\n\n    const onSelectChange = (selectedRowKey) => {\n      selectedRowKeys.value = selectedRowKey;\n    };\n\n    const rowSelection = {\n      selectedRowKeys,\n      onChange: onSelectChange,\n    };\n\n    return {\n      crud,\n      isLoading,\n      selectedRowKeys,\n      handleDelete,\n      rowSelection,\n      onSelectChange,\n      dataSource,\n      columns,\n      formState,\n    };\n  },\n});\n\nexport default DragAndDropTable;\n</script>\n"],"mappings":"AAuDA,SAASA,iBAAgB,QAAS,UAAU;AAC5C,SAASC,IAAI,EAAEC,YAAW,QAAS,cAAc;AACjD,SAASC,QAAO,QAAS,MAAM;AAC/B,SAASC,QAAQ,EAAEC,SAAS,EAAEC,GAAG,EAAEC,QAAQ,EAAEC,eAAc,QAAS,KAAK;AACzE;AACA,OAAOC,UAAS,MAAO,+BAA+B;AAEtD,MAAMC,OAAM,GAAI;AACd;AACA;AACA;AACA;AACA;AACA;EACEC,KAAK,EAAE,aAAa;EACpBC,SAAS,EAAE,MAAM;EACjBC,GAAG,EAAE;AACP,CAAC,EACD;EACEF,KAAK,EAAE,aAAa;