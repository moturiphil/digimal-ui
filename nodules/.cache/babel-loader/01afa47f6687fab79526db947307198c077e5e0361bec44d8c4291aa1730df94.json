yle=\"{ marginTop: 0 }\"\r\n                @click=\"toggleCollapsed\"\r\n              >\r\n                <sdFeatherIcons type=\"x\" />\r\n              </sdButton>\r\n              <div class=\"mail-sidebar-top\">\r\n                <sdButton @click=\"toggleMailComposer\" shape=\"round\" type=\"primary\" size=\"default\" block>\r\n                  + Compose\r\n                </sdButton>\r\n              </div>\r\n\r\n              <div class=\"mail-sidebar-bottom\">\r\n                <EmailNavbar :path=\"path + '/'\" :toggleCollapsed=\"toggleCollapsed\" />\r\n              </div>\r\n            </sdCards>\r\n          </MailSideBar>\r\n        </a-col>\r\n\r\n        <a-col :xxl=\"19\" :xl=\"17\" :lg=\"16\"> <router-view></router-view> </a-col>\r\n      </a-row>\r\n    </EmailWrapper>\r\n  </Main>\r\n</template>\r\n<script>\r\nimport EmailNavbar from './overview/Navbar';\r\nimport ComposeMail from './overview/Compose';\r\nimport { EmailWrapper, MailSideBar } from './overview/style';\r\nimport { Main } from '../../styled';\r\nimport { computed, onMounted, ref, defineComponent } from 'vue';\r\nimport { useRoute } from 'vue-router';\r\n\r\nconst Email = defineComponent({\r\n  name: 'Email',\r\n  components: { Main, MailSideBar, EmailNavbar, ComposeMail, EmailWrapper },\r\n  data() {\r\n    return {\r\n      path: this.$route.matched[1].path,\r\n    };\r\n  },\r\n  setup() {\r\n    const responsive = ref(0);\r\n    const collapsed = ref(false);\r\n    const isMailEditorOpen = ref(false);\r\n    const pageTitle = computed(() => (useRoute().matched[1] ? useRoute().matched[1].name : 'Inbox'));\r\n    const toggleMailComposer = () => {\r\n      isMailEditorOpen.value = !isMailEditorOpen.value;\r\n    };\r\n\r\n    const closeMailCompose = () => {\r\n      isMailEditorOpen.value = false;\r\n    };\r\n\r\n    const toggleCollapsed = () => {\r\n      collapsed.value = !collapsed.value;\r\n    };\r\n\r\n    function updateSize() {\r\n      const width = window.innerWidth;\r\n      responsive.value = width;\r\n    }\r\n    onMounted(() => {\r\n      updateSize();\r\n      window.addEventListener('resize', updateSize);\r\n    });\r\n\r\n    return {\r\n      responsive,\r\n      pageTitle,\r\n      toggleCollapsed,\r\n      collapsed,\r\n      toggleMailComposer,\r\n      isMailEditorOpen,\r\n      closeMailCompose,\r\n    };\r\n  },\r\n});\r\n\r\nexport default Email;\r\n</script>\r\n"],"mappings":"AAwEA,OAAOA,WAAU,MAAO,mBAAmB;AAC3C,OAAOC,WAAU,MAAO,oBAAoB;AAC5C,SAASC,YAAY,EAAEC,WAAU,QAAS,kBAAkB;AAC5D,SAASC,IAAG,QAAS,cAAc;AACnC,SAASC,QAAQ,EAAEC,SAAS,EAAEC,GAAG,EAAEC,eAAc,QAAS,KAAK;AAC/D,SAASC,QAAO,QAAS,YAAY;AAErC,MAAMC,KAAI,GAAIF,eAAe,CAAC;EAC5BG,IAAI,EAAE,OAAO;EACbC,UAAU,EAAE;IAAER,IAAI;IAAED,WAAW;IAAEH,WAAW;IAAEC,WAAW;IAAEC;EAAa,CAAC;EACzEW,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,IAAI,EAAE,IAAI,CAACC,MAAM,CAACC,OAAO,CAAC,CAAC,CAAC,CAACF;IAC/B,CAAC;EACH,CAAC;EACDG,KAAKA,CAAA,EAAG;IACN,MAAMC,UAAS,GAAIX,GAAG,CAAC,CAAC,CAAC;IACzB,MAAMY,SAAQ,GAAIZ,GAAG,CAAC,KAAK,CAAC;IAC5B,MAAMa,gBAAe,GAAIb,GAAG,CAAC,KAAK,CAAC;IACnC,MAAMc,SAAQ,GAAIhB,QAAQ,CAAC,MAAOI,QAAQ,EAAE,CAACO,OAAO,CAAC,CAAC,IAAIP,QAAQ,EAAE,CAACO,OAAO,CAAC,CAAC,CAAC,CAACL,IAAG,GAAI,OAAQ,CAAC;IAChG,MAAMW,kBAAiB,GAAIA,CAAA,KAAM;MAC/BF,gBAAgB,CAACG,KAAI,GAAI,CAACH,gBAAgB,CAACG,KAAK;IAClD,CAAC;IAED,MAAMC,gBAAe,GAAIA,CAAA,KAAM;MAC7BJ,gBAAgB,CAACG,KAAI,GAAI,KAAK;IAChC,CAAC;IAED,MAAME,eAAc,GAAIA,CAAA,KAAM;MAC5BN,SAAS,CAACI,KAAI,GAAI,CAACJ,SAAS,CAACI,KAAK;IACpC,CAAC;IAED,SAASG,UAAUA,CAAA,EAAG;MACpB,MAAMC,KAAI,GAAIC,MAAM,CAACC,UAAU;MAC/BX,UAAU,CAACK,KAAI,GAAII,KAAK;IAC1B;IACArB,SAAS,CAAC,MAAM;MACdoB,UAAU,EAAE;MACZE,MAAM,CAACE,gBAAgB,CAAC,QAAQ,EAAEJ,UAAU,CAAC;IAC/C,CAAC,CAAC;IAEF,OAAO;MACLR,UAAU;MACVG,SAAS;MACTI,eAAe;MACfN,SAAS;MACTG,kBAAkB;MAClBF,gBAAgB;MAChBI;IACF,CAAC;EACH;AACF,CAAC,CAAC;AAEF,eAAed,KAAK"},"metadata":{},"sourceType":"module","externalDependencies":[]}