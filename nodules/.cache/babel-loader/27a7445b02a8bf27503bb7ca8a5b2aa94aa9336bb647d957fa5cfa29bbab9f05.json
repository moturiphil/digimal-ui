{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { computed, ref, reactive } from \"vue\";\nimport { AuthWrapper } from \"./style\";\nimport store from \"../../vuex/store\";\n// import axios from \"axios\";\n// import { useRouter } from \"vue-router\";\nimport { useRoute } from \"vue-router\";\nimport { useRouter } from 'vue-router';\nimport AuthService from \"../../services/auth.service\";\nexport default {\n  name: \"Password\",\n  components: {\n    AuthWrapper\n  },\n  setup() {\n    // const id_no = props.route.params.id_no;\n    // const otp = props.route.query.otp;\n\n    const isLoading = computed(() => store.state.auth.loading);\n    const checked = ref(null);\n    const route = useRoute();\n    const router = useRouter();\n    const formattedId = computed(() => {\n      if (route.params?.id_no) {\n        return route.params.id_no.toString().padStart(6, \"0\");\n      } else {\n        return \"\";\n      }\n    });\n\n    // const API_URL = \"http://127.0.0.1:8000/api/set_users_password\";\n    const formState = reactive({\n      id_no: sessionStorage.getItem(\"id_no\") || \"\",\n      otp: sessionStorage.getItem(\"otp\") || \"\",\n      email: \"\",\n      password: \"\",\n      confirm_password: \"\"\n    });\n    const showOtpInput = ref(false);\n    const handleSubmit = async () => {\n      // const response = await axios.post(API_URL, values);\n      const response = await AuthService.register({\n        id_no: formState.id_no,\n        otp: formState.otp,\n        password: formState.password,\n        confirm_password: formState.confirm_password,\n        email: formState.email\n      });\n      // router.push(\"/\");\n      router.replace('/');\n      if (response.status == 200) {\n        console.log(response);\n        router.push(\"/auth/login\");\n        console.log(\"response successfully sent....\");\n        // router.push(\"/\"); \n      }\n      // handle success response\n      // handle error response\n    };\n\n    return {\n      isLoading,\n      checked,\n      handleSubmit,\n      formState,\n      isError: computed(() => store.state.auth.isError),\n      errorMessage: computed(() => store.state.auth.errorMessage),\n      errorDescription: computed(() => store.state.auth.errorDescription),\n      showOtpInput,\n      formattedId\n    };\n  }\n};","map":{"version":3,"names":["computed","ref","reactive","AuthWrapper","store","useRoute","useRouter","AuthService","name","components","setup","isLoading","state","auth","loading","checked","route","router","formattedId","params","id_no","toString","padStart","formState","sessionStorage","getItem","otp","email","password","confirm_password","showOtpInput","handleSubmit","response","register","replace","status","console","log","push","isError","errorMessage","errorDescription"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/authentication/setPassword.vue"],"sourcesContent":["<template>\n  <AuthWrapper>\n    <div class=\"auth-contents\">\n      <a-form @finish=\"handleSubmit\" :model=\"formState\" layout=\"vertical\">\n        <sdHeading as=\"h3\">Complete Profile?</sdHeading>\n        <p class=\"forgot-text\">\n          Create Password and submit email for your account\n        </p>\n        <a-form-item label=\"ID NO\">\n          <!-- <a-input :value=\"formattedId\" disabled /> -->\n          <a-input v-model:value=\"formState.id_no\" disabled />\n        </a-form-item>\n        <a-form-item label=\"Email\">\n          <a-input v-model:value=\"formState.email\" placeholder=\"Enter Email\" />\n        </a-form-item>\n        <a-form-item label=\"Password\" name=\"password\">\n          <a-input\n            type=\"password\"\n            v-model:value=\"formState.password\"\n            placeholder=\"Enter Password\"\n          />\n        </a-form-item>\n        <a-form-item label=\"Confirm Password\" name=\"password\">\n          <a-input\n            type=\"password\"\n            v-model:value=\"formState.confirm_password\"\n            placeholder=\"Confirm Password\"\n          />\n        </a-form-item>\n        <a-form-item>\n          <sdButton\n            class=\"btn-reset\"\n            htmlType=\"submit\"\n            type=\"success\"\n            size=\"large\"\n          >\n            <!-- {{ showOtpInput ? \"Verify OTP\" : \"Send OTP\" }} -->\n            Create Account\n          </sdButton>\n        </a-form-item>\n        <p class=\"return-text\">\n          Return to <router-link to=\"/auth/login\">Sign In</router-link>\n        </p>\n      </a-form>\n    </div>\n  </AuthWrapper>\n</template>\n<script>\nimport { computed, ref, reactive } from \"vue\";\nimport { AuthWrapper } from \"./style\";\nimport store from \"../../vuex/store\";\n// import axios from \"axios\";\n// import { useRouter } from \"vue-router\";\nimport { useRoute } from \"vue-router\";\nimport { useRouter } from 'vue-router';\nimport AuthService from \"../../services/auth.service\";\n\n\nexport default {\n  name: \"Password\",\n  components: { AuthWrapper },\n  setup() {\n    // const id_no = props.route.params.id_no;\n    // const otp = props.route.query.otp;\n\n    const isLoading = computed(() => store.state.auth.loading);\n    const checked = ref(null);\n    const route = useRoute();\n    const router = useRouter();\n\n    const formattedId = computed(() => {\n      if (route.params?.id_no) {\n        return route.params.id_no.toString().padStart(6, \"0\");\n      } else {\n        return \"\";\n      }\n    });\n\n    // const API_URL = \"http://127.0.0.1:8000/api/set_users_password\";\n    const formState = reactive({\n      id_no: sessionStorage.getItem(\"id_no\") || \"\",\n      otp: sessionStorage.getItem(\"otp\") || \"\",\n      email: \"\",\n      password: \"\",\n      confirm_password: \"\",\n    });\n\n    const showOtpInput = ref(false);\n\n    const handleSubmit = async () => {\n      // const response = await axios.post(API_URL, values);\n      const response = await AuthService.register({\n        id_no: formState.id_no,\n        otp: formState.otp,\n        password: formState.password,\n        confirm_password: formState.confirm_password,\n        email: formState.email,\n      });\n      // router.push(\"/\");\n      router.replace('/');\n      if (response.status == 200) {\n        console.log(response);\n        router.push(\"/auth/login\");\n        console.log(\"response successfully sent....\");\n        // router.push(\"/\"); \n      }\n      // handle success response\n      // handle error response\n    };\n\n    return {\n      isLoading,\n      checked,\n      handleSubmit,\n      formState,\n      isError: computed(() => store.state.auth.isError),\n      errorMessage: computed(() => store.state.auth.errorMessage),\n      errorDescription: computed(() => store.state.auth.errorDescription),\n      showOtpInput,\n      formattedId,\n    };\n  },\n};\n</script>\n"],"mappings":";AAgDA,SAASA,QAAQ,EAAEC,GAAG,EAAEC,QAAO,QAAS,KAAK;AAC7C,SAASC,WAAU,QAAS,SAAS;AACrC,OAAOC,KAAI,MAAO,kBAAkB;AACpC;AACA;AACA,SAASC,QAAO,QAAS,YAAY;AACrC,SAASC,SAAQ,QAAS,YAAY;AACtC,OAAOC,WAAU,MAAO,6BAA6B;AAGrD,eAAe;EACbC,IAAI,EAAE,UAAU;EAChBC,UAAU,EAAE;IAAEN;EAAY,CAAC;EAC3BO,KAAKA,CAAA,EAAG;IACN;IACA;;IAEA,MAAMC,SAAQ,GAAIX,QAAQ,CAAC,MAAMI,KAAK,CAACQ,KAAK,CAACC,IAAI,CAACC,OAAO,CAAC;IAC1D,MAAMC,OAAM,GAAId,GAAG,CAAC,IAAI,CAAC;IACzB,MAAMe,KAAI,GAAIX,QAAQ,EAAE;IACxB,MAAMY,MAAK,GAAIX,SAAS,EAAE;IAE1B,MAAMY,WAAU,GAAIlB,QAAQ,CAAC,MAAM;MACjC,IAAIgB,KAAK,CAACG,MAAM,EAAEC,KAAK,EAAE;QACvB,OAAOJ,KAAK,CAACG,MAAM,CAACC,KAAK,CAACC,QAAQ,EAAE,CAACC,QAAQ,CAAC,CAAC,EAAE,GAAG,CAAC;MACvD,OAAO;QACL,OAAO,EAAE;MACX;IACF,CAAC,CAAC;;IAEF;IACA,MAAMC,SAAQ,GAAIrB,QAAQ,CAAC;MACzBkB,KAAK,EAAEI,cAAc,CAACC,OAAO,CAAC,OAAO,KAAK,EAAE;MAC5CC,GAAG,EAAEF,cAAc,CAACC,OAAO,CAAC,KAAK,KAAK,EAAE;MACxCE,KAAK,EAAE,EAAE;MACTC,QAAQ,EAAE,EAAE;MACZC,gBAAgB,EAAE;IACpB,CAAC,CAAC;IAEF,MAAMC,YAAW,GAAI7B,GAAG,CAAC,KAAK,CAAC;IAE/B,MAAM8B,YAAW,GAAI,MAAAA,CAAA,KAAY;MAC/B;MACA,MAAMC,QAAO,GAAI,MAAMzB,WAAW,CAAC0