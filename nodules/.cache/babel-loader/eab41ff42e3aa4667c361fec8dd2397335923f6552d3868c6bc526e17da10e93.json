{"ast":null,"code":"import { CardBarChart2, EChartCard } from \"./style\";\nimport Chart from \"../../components/utilities/chartjs\";\nimport { Main } from \"../styled\";\nimport { defineAsyncComponent, onMounted, ref } from \"vue\";\nimport { defineComponent } from 'vue';\nimport authHeader from \"../../services/auth-header\";\n\n// import { useRouter } from \"vue-router\";\n\nconst NetsDistributed = defineAsyncComponent(() => import(\"./overview/massnet/NetsDistributed\"));\nconst PerformancePerCounty = defineAsyncComponent(() => import(\"./overview/massnet/PerformancePerCounty\"));\nconst EventsDetails = defineAsyncComponent(() => import(\"./overview/massnet/EventsDetails\"));\nconst OnGoingEvents = defineAsyncComponent(() => import(\"./overview/massnet/OnGoingEvents\"));\nconst HouseHoldRegistered = defineAsyncComponent(() => import(\"./overview/massnet/HouseHoldRegistered\"));\nconst chartOptions = {\n  legend: {\n    display: false,\n    labels: {\n      display: false\n    }\n  },\n  scales: {\n    yAxes: [{\n      stacked: true,\n      gridLines: {\n        display: false\n      },\n      ticks: {\n        display: false\n      }\n    }],\n    xAxes: [{\n      stacked: true,\n      gridLines: {\n        display: false\n      },\n      ticks: {\n        display: false\n      }\n    }]\n  }\n};\nexport default defineComponent({\n  name: \"CRM\",\n  components: {\n    Main,\n    CardBarChart2,\n    EChartCard,\n    Chart,\n    NetsDistributed,\n    PerformancePerCounty,\n    EventsDetails,\n    OnGoingEvents,\n    HouseHoldRegistered\n  },\n  data() {\n    return {};\n  },\n  setup() {\n    const active_events = ref(0);\n    const nets_distributed = ref(0);\n    const registered_house_holds = ref(0);\n    const registered_users = ref(0);\n\n    // console.log(sessionStorage.getItem(\"user\"));\n    onMounted(async () => {\n      try {\n        const response = await fetch(`${process.env.VUE_APP_BASE_URL}/dash_stats`, {\n          method: \"GET\",\n          headers: authHeader()\n        });\n        const data = await response.json();\n        console.log(data.active_events);\n        active_events.value = data.active_events;\n        nets_distributed.value = data.nets_distributed;\n        registered_house_holds.value = data.registered_house_holds;\n        registered_users.value = data.registered_users;\n        // console.log(data.active_events);\n      } catch (error) {\n        console.error(error);\n      }\n    });\n    return {\n      chartOptions,\n      active_events,\n      nets_distributed,\n      registered_house_holds,\n      registered_users\n    };\n  },\n  beforeRouteEnter(to, from, next) {\n    if (!sessionStorage.getItem(\"user\")) {\n      next(\"/auth/login\");\n    } else {\n      next();\n    }\n  }\n});","map":{"version":3,"names":["CardBarChart2","EChartCard","Chart","Main","defineAsyncComponent","onMounted","ref","defineComponent","authHeader","NetsDistributed","PerformancePerCounty","EventsDetails","OnGoingEvents","HouseHoldRegistered","chartOptions","legend","display","labels","scales","yAxes","stacked","gridLines","ticks","xAxes","name","components","data","setup","active_events","nets_distributed","registered_house_holds","registered_users","response","fetch","process","env","VUE_APP_BASE_URL","method","headers","json","console","log","value","error","beforeRouteEnter","to","from","next","sessionStorage","getItem"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/dashboard/index.vue"],"sourcesContent":["<template>\r\n  <sdPageHeader title=\"DigiMal KE Dashboard\">\r\n    <template v-slot:buttons>\r\n      <div class=\"page-header-actions\">\r\n        <!-- <sdCalendarButton />\r\n        <sdExportButton />\r\n        <sdShareButton /> -->\r\n        <router-link v-bind:to=\"'campaigns/create'\">\r\n          <sdButton size=\"small\" type=\"success\">\r\n            <sdFeatherIcons type=\"plus\" size=\"14\" />\r\n            Start Campaign\r\n          </sdButton>\r\n        </router-link>\r\n      </div>\r\n    </template>\r\n  </sdPageHeader>\r\n  <Main>\r\n    <a-row :gutter=\"25\">\r\n      <a-col :xxl=\"6\" :md=\"12\" :sm=\"12\" :xs=\"24\">\r\n        <sdCards headless>\r\n          <EChartCard>\r\n            <div class=\"card-chunk\">\r\n              <CardBarChart2>\r\n                <sdHeading as=\"h1\">{{ nets_distributed }}</sdHeading>\r\n                <span>Nets Distributed</span>\r\n                <p>\r\n                  <!-- <span class=\"growth-upward\"> <sdFeatherIcons type=\"arrow-up\" /> 25% </span>\r\n                  <span>Since last week</span> -->\r\n                </p>\r\n              </CardBarChart2>\r\n            </div>\r\n            <div class=\"card-chunk\">\r\n              <Chart\r\n                class=\"growth\"\r\n                :height=\"180\"\r\n                :labels=\"['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul']\"\r\n                :style=\"{\r\n                  marginBottom: '-5',\r\n                }\"\r\n                :datasets=\"[\r\n                  {\r\n                    data: [20, 60, 50, 45, 50, 60, 70],\r\n                    backgroundColor: '#E8FAF4',\r\n                    hoverBackgroundColor: '#20C997',\r\n                    label: 'Orders',\r\n                    barPercentage: 1,\r\n                  },\r\n                ]\"\r\n                :options=\"chartOptions\"\r\n              />\r\n            </div>\r\n          </EChartCard>\r\n        </sdCards>\r\n      </a-col>\r\n      <a-col :xxl=\"6\" :md=\"12\" :sm=\"12\" :xs=\"24\">\r\n        <sdCards headless>\r\n          <EChartCard>\r\n            <div class=\"card-chunk\">\r\n              <CardBarChart2>\r\n                <sdHeading as=\"h1\">{{registered_users}}</sdHeading>\r\n                <span>Registered Users</span>\r\n                <p>\r\n                  <!--<span class=\"growth-downward\"> <sdFeatherIcons type=\"arrow-down\" /> 25% </span>\r\n                  <span>Since last week</span> -->\r\n                </p>\r\n              </CardBarChart2>\r\n            </div>\r\n            <div class=\"card-chunk\">\r\n              <Chart\r\n                class=\"downward\"\r\n                :height=\"180\"\r\n                :labels=\"['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul']\"\r\n                :style=\"{\r\n                  marginBottom: '-5',\r\n                }\"\r\n                :datasets=\"[\r\n                  {\r\n                    data: [20, 60, 50, 45, 50, 60, 70],\r\n                    backgroundColor: '#E8FAF4',\r\n                    hoverBackgroundColor: '#20C997',\r\n                    label: 'Nets Distributed',\r\n                    barPercentage: 1,\r\n                  },\r\n                ]\"\r\n                :options=\"chartOptions\"\r\n              />\r\n            </div>\r\n          </EChartCard>\r\n        </sdCards>\r\n      </a-col>\r\n\r\n      <a-col :xxl=\"6\" :md=\"12\" :sm=\"12\" :xs=\"24\">\r\n        <sdCards headless>\r\n          <EChartCard>\r\n            <div class=\"card-chunk\">\r\n              <CardBarChart2>\r\n                <sdHeading as=\"h1\">{{ active_events }}</sdHeading>\r\n                <span>Active Events</span>\r\n                <p>\r\n                  <!-- <span class=\"growth-upward\"> <sdFeatherIcons type=\"arrow-up\" /> 25% </span>\r\n                   <span>Since last week</span> -->\r\n                </p>\r\n              </CardBarChart2>\r\n            </div>\r\n            <div class=\"card-chunk\">\r\n              <Chart\r\n                class=\"upward\"\r\n                :height=\"180\"\r\n                :labels=\"['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul']\"\r\n                :style=\"{\r\n                  marginBottom: '-5',\r\n                }\"\r\n                :datasets=\"[\r\n                  {\r\n                    data: [20, 60, 50, 45, 50, 60, 70],\r\n                    backgroundColor: '#E8FAF4',\r\n                    hoverBackgroundColor: '#20C997',\r\n                    label: 'Avg Orders',\r\n                    barPercentage: 1,\r\n                  },\r\n                ]\"\r\n                :options=\"chartOptions\"\r\n              />\r\n            </div>\r\n          </EChartCard>\r\n        </sdCards>\r\n      </a-col>\r\n      <a-col :xxl=\"6\" :md=\"12\" :sm=\"12\" :xs=\"24\">\r\n        <sdCards headless>\r\n          <EChartCard>\r\n            <div class=\"card-chunk\">\r\n              <CardBarChart2>\r\n                <sdHeading as=\"h1\">{{ registered_house_holds }}</sdHeading>\r\n                <span>Registered HouseHolds</span>\r\n                <p>\r\n                  <!--<span class=\"growth-upward\"> <sdFeatherIcons type=\"arrow-up\" /> 25% </span>\r\n                  <span>Since last week</span>-->\r\n                </p>\r\n              </CardBarChart2>\r\n            </div>\r\n            <div class=\"card-chunk\">\r\n              <Chart\r\n                class=\"visitors\"\r\n                :height=\"180\"\r\n                :labels=\"['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul']\"\r\n                :style=\"{\r\n                  marginBottom: '-5',\r\n                }\"\r\n                :datasets=\"[\r\n                  {\r\n                    data: [20, 60, 50, 45, 50, 60, 70],\r\n                    backgroundColor: '#E8FAF4',\r\n                    hoverBackgroundColor: '#20C997',\r\n                    label: 'Visitors',\r\n                    barPercentage: 1,\r\n                  },\r\n                ]\"\r\n                :options=\"chartOptions\"\r\n              />\r\n            </div>\r\n          </EChartCard>\r\n        </sdCards>\r\n      </a-col>\r\n    </a-row>\r\n    <a-row :gutter=\"25\">\r\n      <a-col :xxl=\"16\" :xs=\"24\"\r\n        ><Suspense>\r\n          <template #default>\r\n            <NetsDistributed title=\"Nets Distributed\" :chartHeight=\"70\" />\r\n          </template>\r\n          <template #fallback>\r\n            <sdCards headless>\r\n              <a-skeleton active />\r\n            </sdCards>\r\n          </template>\r\n        </Suspense>\r\n      </a-col>\r\n      <a-col :xxl=\"8\" :xs=\"24\"\r\n        ><Suspense>\r\n          <template #default>\r\n            <EventsDetails />\r\n          </template>\r\n          <template #fallback>\r\n            <sdCards headless>\r\n              <a-skeleton active />\r\n            </sdCards>\r\n          </template>\r\n        </Suspense>\r\n      </a-col>\r\n      <a-col :xxl=\"12\" :xl=\"12\" :xs=\"24\"\r\n        ><Suspense>\r\n          <template #default>\r\n            <OnGoingEvents />\r\n          </template>\r\n          <template #fallback>\r\n            <sdCards headless>\r\n              <a-skeleton active />\r\n            </sdCards>\r\n          </template>\r\n        </Suspense>\r\n      </a-col>\r\n      <a-col :xxl=\"12\" :xs=\"24\"\r\n        ><Suspense>\r\n          <template #default>\r\n            <HouseHoldRegistered />\r\n          </template>\r\n          <template #fallback>\r\n            <sdCards headless>\r\n              <a-skeleton active />\r\n            </sdCards>\r\n          </template>\r\n        </Suspense>\r\n      </a-col>\r\n      <a-col :xxl=\"24\" :xl=\"12\" :xs=\"24\"\r\n        ><Suspense>\r\n          <template #default>\r\n            <PerformancePerCounty />\r\n          </template>\r\n          <template #fallback>\r\n            <sdCards headless>\r\n              <a-skeleton active />\r\n            </sdCards>\r\n          </template>\r\n        </Suspense>\r\n      </a-col>\r\n    </a-row>\r\n  </Main>\r\n</template>\r\n<script>\r\nimport { CardBarChart2, EChartCard } from \"./style\";\r\nimport Chart from \"../../components/utilities/chartjs\";\r\nimport { Main } from \"../styled\";\r\nimport { defineAsyncComponent, onMounted, ref } from \"vue\";\r\nimport { defineComponent } from 'vue';\r\nimport authHeader from \"../../services/auth-header\";\r\n\r\n\r\n// import { useRouter } from \"vue-router\";\r\n\r\nconst NetsDistributed = defineAsyncComponent(() =>\r\n  import(\"./overview/massnet/NetsDistributed\")\r\n);\r\nconst PerformancePerCounty = defineAsyncComponent(() =>\r\n  import(\"./overview/massnet/PerformancePerCounty\")\r\n);\r\nconst EventsDetails = defineAsyncComponent(() =>\r\n  import(\"./overview/massnet/EventsDetails\")\r\n);\r\nconst OnGoingEvents = defineAsyncComponent(() =>\r\n  import(\"./overview/massnet/OnGoingEvents\")\r\n);\r\nconst HouseHoldRegistered = defineAsyncComponent(() =>\r\n  import(\"./overview/massnet/HouseHoldRegistered\")\r\n);\r\n\r\nconst chartOptions = {\r\n  legend: {\r\n    display: false,\r\n    labels: {\r\n      display: false,\r\n    },\r\n  },\r\n  scales: {\r\n    yAxes: [\r\n      {\r\n        stacked: true,\r\n        gridLines: {\r\n          display: false,\r\n        },\r\n        ticks: {\r\n          display: false,\r\n        },\r\n      },\r\n    ],\r\n    xAxes: [\r\n      {\r\n        stacked: true,\r\n        gridLines: {\r\n          display: false,\r\n        },\r\n        ticks: {\r\n          display: false,\r\n        },\r\n      },\r\n    ],\r\n  },\r\n};\r\n\r\nexport default defineComponent({\r\n  name: \"CRM\",\r\n  components: {\r\n    Main,\r\n    CardBarChart2,\r\n    EChartCard,\r\n    Chart,\r\n    NetsDistributed,\r\n    PerformancePerCounty,\r\n    EventsDetails,\r\n    OnGoingEvents,\r\n    HouseHoldRegistered,\r\n  },\r\n  data() {\r\n    return {\r\n    };\r\n  },\r\n  setup() {\r\n    const active_events = ref(0);\r\n    const nets_distributed= ref(0);\r\n    const registered_house_holds= ref(0);\r\n    const registered_users= ref(0);\r\n\r\n\r\n    // console.log(sessionStorage.getItem(\"user\"));\r\n    onMounted(async () => {\r\n      try {\r\n        const response = await fetch(\r\n          `${process.env.VUE_APP_BASE_URL}/dash_stats`,\r\n          {\r\n            method: \"GET\",\r\n            headers: authHeader(),\r\n          }\r\n        );\r\n        const data = await response.json();\r\n        console.log(data.active_events);\r\n        active_events.value = data.active_events;\r\n        nets_distributed.value = data.nets_distributed;\r\n        registered_house_holds.value = data.registered_house_holds;\r\n        registered_users.value = data.registered_users;\r\n        // console.log(data.active_events);\r\n      } catch (error) {\r\n        console.error(error);\r\n      }\r\n    });\r\n\r\n    return {\r\n      chartOptions,\r\n      active_events,\r\n      nets_distributed,\r\n      registered_house_holds,\r\n      registered_users,\r\n    };\r\n  },\r\n  beforeRouteEnter(to, from, next) {\r\n    if (!sessionStorage.getItem(\"user\")) {\r\n      next(\"/auth/login\");\r\n    } else {\r\n      next();\r\n    }\r\n  },\r\n});\r\n</script>\r\n\r\n"],"mappings":"AAqOA,SAASA,aAAa,EAAEC,UAAS,QAAS,SAAS;AACnD,OAAOC,KAAI,MAAO,oCAAoC;AACtD,SAASC,IAAG,QAAS,WAAW;AAChC,SAASC,oBAAoB,EAAEC,SAAS,EAAEC,GAAE,QAAS,KAAK;AAC1D,SAASC,eAAc,QAAS,KAAK;AACrC,OAAOC,UAAS,MAAO,4BAA4B;;AAGnD;;AAEA,MAAMC,eAAc,GAAIL,oBAAoB,CAAC,MAC3C,MAAM,CAAC,oCAAoC,EAC5C;AACD,MAAMM,oBAAmB,GAAIN,oBAAoB,CAAC,MAChD,MAAM,CAAC,yCAAyC,EACjD;AACD,MAAMO,aAAY,GAAIP,oBAAoB,CAAC,MACzC,MAAM,CAAC,kCAAkC,EAC1C;AACD,MAAMQ,aAAY,GAAIR,oBAAoB,CAAC,MACzC,MAAM,CAAC,kCAAkC,EAC1C;AACD,MAAMS,mBAAkB,GAAIT,oBAAoB,CAAC,MAC/C,MAAM,CAAC,wCAAwC,EAChD;AAED,MAAMU,YAAW,GAAI;EACnBC,MAAM,EAAE;IACNC,OAAO,EAAE,KAAK;IACdC,MAAM,EAAE;MACND,OAAO,EAAE;IACX;EACF,CAAC;EACDE,MAAM,EAAE;IACNC,KAAK,EAAE,CACL;MACEC,OAAO,EAAE,IAAI;MACbC,SAAS,EAAE;QACTL,OAAO,EAAE;MACX,CAAC;MACDM,KAAK,EAAE;QACLN,OAAO,EAAE;MACX;IACF,CAAC,CACF;IACDO,KAAK,EAAE,CACL;MACEH,OAAO,EAAE,IAAI;MACbC,SAAS,EAAE;QACTL,OAAO,EAAE;MACX,CAAC;MACDM,KAAK,EAAE;QACLN,OAAO,EAAE;MACX;IACF,CAAC;EAEL;AACF,CAAC;AAED,eAAeT,eAAe,CAAC;EAC7BiB,IAAI,EAAE,KAAK;EACXC,UAAU,EAAE;IACVtB,IAAI;IACJH,aAAa;IACbC,UAAU;IACVC,KAAK;IACLO,eAAe;IACfC,oBAAoB;IACpBC,aAAa;IACbC,aAAa;IACbC;EACF,CAAC;EACDa,IAAIA,CAAA,EAAG;IACL,OAAO,CACP,CAAC;E