{"ast":null,"code":"import { Div } from './header-search-style';\nimport { useStore } from 'vuex';\nimport { computed, ref, defineComponent } from 'vue';\nexport default defineComponent({\n  name: 'HeaderSearch',\n  props: ['darkMode'],\n  components: {\n    Div\n  },\n  setup() {\n    const {\n      state\n    } = useStore();\n    const searchData = ref([{\n      id: 1,\n      title: 'AntDesign',\n      count: 10000\n    }, {\n      id: 2,\n      title: 'Design UI',\n      count: 10600\n    }, {\n      id: 3,\n      title: 'Bootstrap Design UI',\n      count: 60100\n    }, {\n      id: 4,\n      title: 'Meterial design',\n      count: 30010\n    }, {\n      id: 5,\n      title: 'AntDesign design language',\n      count: 100000\n    }]);\n    const rtl = computed(() => state.themeLayout.rtlData);\n    const filteredData = ref([{\n      id: 1,\n      title: 'AntDesign',\n      count: 10000\n    }, {\n      id: 2,\n      title: 'Design UI',\n      count: 10600\n    }, {\n      id: 3,\n      title: 'Bootstrap Design UI',\n      count: 60100\n    }, {\n      id: 4,\n      title: 'Meterial design',\n      count: 30010\n    }, {\n      id: 5,\n      title: 'AntDesign design language',\n      count: 100000\n    }]);\n    const visible = ref(false);\n    const search = (e, searchDatas) => {\n      const data = searchDatas.filter(item => {\n        return item.title.startsWith(e.target.value);\n      });\n      filteredData.value = data;\n    };\n    const hide = () => {\n      visible.value = false;\n    };\n    return {\n      search,\n      hide,\n      searchData,\n      filteredData,\n      visible,\n      rtl\n    };\n  }\n});","map":{"version":3,"names":["Div","useStore","computed","ref","defineComponent","name","props","components","setup","state","searchData","id","title","count","rtl","themeLayout","rtlData","filteredData","visible","search","e","searchDatas","data","filter","item","startsWith","target","value","hide"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/components/header-search/HeaderSearch.vue"],"sourcesContent":["<template>\r\n  <Div class=\"certain-category-search-wrapper\" :style=\"{ width: '100%' }\" :darkMode=\"darkMode\">\r\n    <a-row class=\"ant-row-middle\">\r\n      <a-col :md=\"2\" :xs=\"1\" :class=\"rtl ? 'text-left' : 'text-right'\">\r\n        <span class=\"certain-category-icon\">\r\n          <sdFeatherIcons type=\"search\" />\r\n        </span>\r\n      </a-col>\r\n      <a-col :md=\"22\" :xs=\"23\">\r\n        <sdPopover\r\n          :placement=\"!rtl ? 'bottomLeft' : 'bottomRight'\"\r\n          v-model=\"visible\"\r\n          title=\"Search List\"\r\n          action=\"click\"\r\n        >\r\n          <template v-slot:content>\r\n            <div>\r\n              <router-link v-for=\"item in filteredData\" :key=\"item.id\" to=\"#\">\r\n                {{ item.title }}\r\n                <span class=\"certain-search-item-count\">{{ item.count }} people</span>\r\n              </router-link>\r\n              <router-link v-if=\"filteredData.length === 0\" to=\"#\"> Data Not Found..... </router-link>\r\n            </div>\r\n          </template>\r\n          <a-input placeholder=\"Search...\" @input=\"(e) => search(e, searchData)\" />\r\n        </sdPopover>\r\n      </a-col>\r\n    </a-row>\r\n  </Div>\r\n</template>\r\n\r\n<script>\r\nimport { Div } from './header-search-style';\r\nimport { useStore } from 'vuex';\r\nimport { computed, ref, defineComponent } from 'vue';\r\n\r\nexport default defineComponent({\r\n  name: 'HeaderSearch',\r\n  props: ['darkMode'],\r\n  components: {\r\n    Div,\r\n  },\r\n  setup() {\r\n    const { state } = useStore();\r\n    const searchData = ref([\r\n      {\r\n        id: 1,\r\n        title: 'AntDesign',\r\n        count: 10000,\r\n      },\r\n      {\r\n        id: 2,\r\n        title: 'Design UI',\r\n        count: 10600,\r\n      },\r\n\r\n      {\r\n        id: 3,\r\n        title: 'Bootstrap Design UI',\r\n        count: 60100,\r\n      },\r\n      {\r\n        id: 4,\r\n        title: 'Meterial design',\r\n        count: 30010,\r\n      },\r\n\r\n      {\r\n        id: 5,\r\n        title: 'AntDesign design language',\r\n        count: 100000,\r\n      },\r\n    ]);\r\n    const rtl = computed(() => state.themeLayout.rtlData);\r\n    const filteredData = ref([\r\n      {\r\n        id: 1,\r\n        title: 'AntDesign',\r\n        count: 10000,\r\n      },\r\n      {\r\n        id: 2,\r\n        title: 'Design UI',\r\n        count: 10600,\r\n      },\r\n\r\n      {\r\n        id: 3,\r\n        title: 'Bootstrap Design UI',\r\n        count: 60100,\r\n      },\r\n      {\r\n        id: 4,\r\n        title: 'Meterial design',\r\n        count: 30010,\r\n      },\r\n\r\n      {\r\n        id: 5,\r\n        title: 'AntDesign design language',\r\n        count: 100000,\r\n      },\r\n    ]);\r\n    const visible = ref(false);\r\n\r\n    const search = (e, searchDatas) => {\r\n      const data = searchDatas.filter((item) => {\r\n        return item.title.startsWith(e.target.value);\r\n      });\r\n      filteredData.value = data;\r\n    };\r\n    const hide = () => {\r\n      visible.value = false;\r\n    };\r\n\r\n    return {\r\n      search,\r\n      hide,\r\n      searchData,\r\n      filteredData,\r\n      visible,\r\n      rtl,\r\n    };\r\n  },\r\n});\r\n</script>\r\n"],"mappings":"AAgCA,SAASA,GAAE,QAAS,uBAAuB;AAC3C,SAASC,QAAO,QAAS,MAAM;AAC/B,SAASC,QAAQ,EAAEC,GAAG,EAAEC,eAAc,QAAS,KAAK;AAEpD,eAAeA,eAAe,CAAC;EAC7BC,IAAI,EAAE,cAAc;EACpBC,KAAK,EAAE,CAAC,UAAU,CAAC;EACnBC,UAAU,EAAE;IACVP;EACF,CAAC;EACDQ,KAAKA,CAAA,EAAG;IACN,MAAM;MAAEC;IAAM,IAAIR,QAAQ,EAAE;IAC5B,MAAMS,UAAS,GAAIP,GAAG,CAAC,CACrB;MACEQ,EAAE,EAAE,CAAC;MACLC,KAAK,EAAE,WAAW;MAClBC,KAAK,EAAE;IACT,CAAC,EACD;MACEF,EAAE,EAAE,CAAC;MACLC,KAAK,EAAE,WAAW;MAClBC,KAAK,EAAE;IACT,CAAC,EAED;MACEF,EAAE,EAAE,CAAC;MACLC,KAAK,EAAE,qBAAqB;MAC5BC,KAAK,EAAE;IACT,CAAC,EACD;MACEF,EAAE,EAAE,CAAC;MACLC,KAAK,EAAE,iBAAiB;MACxBC,KAAK,EAAE;IACT,CAAC,EAED;MACEF,EAAE,EAAE,