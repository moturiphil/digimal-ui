{"ast":null,"code":"import ProductCardsList from './ProductCardList.vue';\nimport { PaginationWrapper } from '../../Style';\nimport { computed, ref } from 'vue';\nimport { useStore } from 'vuex';\nconst List = {\n  name: 'List',\n  components: {\n    ProductCardsList,\n    PaginationWrapper\n  },\n  setup() {\n    const {\n      state\n    } = useStore();\n    const products = computed(() => state.ecommerce.products);\n    const isLoader = computed(() => state.ecommerce.isProductLoading);\n    const current = ref(1);\n    const pageSize = ref(10);\n    const onShowSizeChange = (current, pageSize) => {\n      current.value = current;\n      pageSize.value = pageSize;\n    };\n    const onHandleChange = (current, pageSize) => {\n      current.value = current;\n      pageSize.value = pageSize;\n    };\n    return {\n      onHandleChange,\n      onShowSizeChange,\n      pageSize,\n      current,\n      products,\n      isLoader\n    };\n  }\n};\nexport default List;","map":{"version":3,"names":["ProductCardsList","PaginationWrapper","computed","ref","useStore","List","name","components","setup","state","products","ecommerce","isLoader","isProductLoading","current","pageSize","onShowSizeChange","value","onHandleChange"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/pages/net-distribution/product/overview/List.vue"],"sourcesContent":["<template>\r\n  <a-row :gutter=\"15\">\r\n    <a-col v-if=\"isLoader\" :md=\"24\">\r\n      <div class=\"spin\">\r\n        <a-spin />\r\n      </div>\r\n    </a-col>\r\n    <template v-else-if=\"products.length\">\r\n      <a-col v-for=\"product in products\" :xs=\"24\" :key=\"product.id\">\r\n        <ProductCardsList :product=\"product\" />\r\n      </a-col>\r\n    </template>\r\n    <a-col v-else :xs=\"24\">\r\n      <sdHeading as=\"h1\">Data Not Found</sdHeading>\r\n    </a-col>\r\n    <a-col :xs=\"24\" class=\"pb-30\">\r\n      <PaginationWrapper v-if=\"products.length\">\r\n        <a-pagination\r\n          :style=\"{ marginTop: 10 }\"\r\n          :change=\"onHandleChange\"\r\n          showSizeChanger\r\n          @showSizeChange=\"onShowSizeChange\"\r\n          v-model:current=\"current\"\r\n          v-model:pageSize=\"pageSize\"\r\n          :defaultCurrent=\"1\"\r\n          :total=\"40\"\r\n        />\r\n      </PaginationWrapper>\r\n    </a-col>\r\n  </a-row>\r\n</template>\r\n<script>\r\nimport ProductCardsList from './ProductCardList.vue';\r\nimport { PaginationWrapper } from '../../Style';\r\nimport { computed, ref } from 'vue';\r\nimport { useStore } from 'vuex';\r\n\r\nconst List = {\r\n  name: 'List',\r\n  components: { ProductCardsList, PaginationWrapper },\r\n  setup() {\r\n    const { state } = useStore();\r\n    const products = computed(() => state.ecommerce.products);\r\n    const isLoader = computed(() => state.ecommerce.isProductLoading);\r\n\r\n    const current = ref(1);\r\n    const pageSize = ref(10);\r\n\r\n    const onShowSizeChange = (current, pageSize) => {\r\n      current.value = current;\r\n      pageSize.value = pageSize;\r\n    };\r\n\r\n    const onHandleChange = (current, pageSize) => {\r\n      current.value = current;\r\n      pageSize.value = pageSize;\r\n    };\r\n\r\n    return {\r\n      onHandleChange,\r\n      onShowSizeChange,\r\n      pageSize,\r\n      current,\r\n      products,\r\n      isLoader,\r\n    };\r\n  },\r\n};\r\n\r\nexport default List;\r\n</script>\r\n"],"mappings":"AAgCA,OAAOA,gBAAe,MAAO,uBAAuB;AACpD,SAASC,iBAAgB,QAAS,aAAa;AAC/C,SAASC,QAAQ,EAAEC,GAAE,QAAS,KAAK;AACnC,SAASC,QAAO,QAAS,MAAM;AAE/B,MAAMC,IAAG,GAAI;EACXC,IAAI,EAAE,MAAM;EACZC,UAAU,EAAE;IAAEP,gBAAgB;IAAEC;EAAkB,CAAC;EACnDO,KAAKA,CAAA,EAAG;IACN,MAAM;MAAEC;IAAM,IAAIL,QAAQ,EAAE;IAC5B,MAAMM,QAAO,GAAIR,QAAQ,CAAC,MAAMO,KAAK,CAACE,SAAS,CAACD,QAAQ,CAAC;IACzD,MAAME,QAAO,GAAIV,QAAQ,CAAC,MAAMO,KAAK,CAACE,SAAS,CAACE,gBAAgB,CAAC;IAEjE,MAAMC,OAAM,GAAIX,GAAG,CAAC,CAAC,CAAC;IACtB,MAAMY,QAAO,GAAIZ,GAAG,CAAC,EAAE,CAAC;IAExB,MAAMa,gBAAe,GAAIA,CAACF,OAAO,EAAEC,QAAQ,KAAK;MAC9CD,