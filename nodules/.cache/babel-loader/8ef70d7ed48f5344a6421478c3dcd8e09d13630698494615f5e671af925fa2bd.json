{"ast":null,"code":"import \"ant-design-vue/es/notification/style\";\nimport _notification from \"ant-design-vue/es/notification\";\nimport { RecordFormWrapper } from \"./style\";\nimport { Main, BasicFormWrapper } from \"../../styled\";\nimport { useStore } from \"vuex\";\nimport { reactive, ref, defineComponent, computed } from \"vue\";\n// import axios from \"axios\";\nimport authHeader from \"../../../services/auth-header\";\n// import { useRouter } from \"vue-router\";\n// testing app\nconst AddNew = defineComponent({\n  name: \"AddNew\",\n  components: {\n    RecordFormWrapper,\n    Main,\n    BasicFormWrapper\n  },\n  data() {\n    const {\n      state\n    } = useStore();\n    const isLoading = computed(() => state.crud.loading);\n    const apiUrl = computed(() => state.crud.url);\n    const isFileLoading = computed(() => state.crud.fileLoading);\n    const join = ref(\"\");\n\n    // const router = useRouter();\n\n    const API_URL = `${process.env.VUE_APP_BASE_URL}/users_doing_hh_reg`;\n    const campaign_url = `${process.env.VUE_APP_BASE_URL}/campaign_all`;\n\n    // const facilitator_url = `${process.env.VUE_APP_BASE_URL}/users`;\n\n    const chv_url = `${process.env.VUE_APP_BASE_URL}/get_user_given_the_role?role=chv`;\n    const {\n      campaigns,\n      chvs,\n      loading\n    } = reactive({\n      campaigns: \"\",\n      loading: true,\n      chvs: []\n    });\n    const fetchCampaigns = async () => {\n      const response = await fetch(campaign_url, {\n        method: \"GET\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          ...authHeader()\n        }\n      });\n      const data = await response.json();\n      this.campaigns = data.data;\n      // console.log(this.campaigns);\n      this.loading = false;\n    };\n    fetchCampaigns();\n    const fetchCHV = async () => {\n      const response = await fetch(chv_url, {\n        method: \"GET\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          ...authHeader()\n        }\n      });\n      const data = await response.json();\n      this.chvs = data.data;\n      // console.log(data.data);\n      this.loading = false;\n    };\n    fetchCHV();\n    const handleSubmit = () => {\n      const data = {\n        campaign_id: formState.campaign_id,\n        user_ids: formState.chv_id\n      };\n      console.log(JSON.stringify(data));\n      fetch(API_URL, {\n        method: \"POST\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          ...authHeader()\n        },\n        body: JSON.stringify(data)\n      }).then(response => response.json()).then(({\n        success,\n        message,\n        occupied_users\n      }) => {\n        if (success) {\n          // router.push(\"event-view\");\n          console.log(success, message, occupied_users);\n          if (occupied_users == null) {\n            _notification[\"success\"]({\n              message: message,\n              description: \"Users successfully assigned to a campaign\",\n              duration: 10.5\n            });\n          }\n          // output notification for each user\n          else if (occupied_users.length > 0) {\n            for (var i = 0; i < occupied_users.length; i++) {\n              _notification[\"error\"]({\n                message: message,\n                description: `User ${occupied_users[i].user} already assigned to a campaign`,\n                duration: 10.5\n              });\n            }\n          }\n\n          // for (var i = 0; i < occupied_users.length; i++) {\n          //   notification[\"success\"]({\n          //     message: message,\n          //     description: `User ${occupied_users[i].user} already assigned to a campaign`,\n          //     duration: 10.5,\n          //   });\n          // }\n          // notification[\"success\"]({\n          //   message: message,\n          //   description: `Users ${occupied_users} already assigned to a campaign`,\n          //   duration: 5.5,\n          // });\n        }\n      }).catch(error => {\n        console.error(\"Error:\", error);\n      });\n    };\n    const formState = reactive({\n      campaign_id: null,\n      user_id: []\n    });\n\n    // console.log(formState);\n\n    return {\n      isLoading,\n      apiUrl,\n      isFileLoading,\n      join,\n      handleSubmit,\n      formState,\n      campaigns,\n      chvs,\n      loading\n    };\n  },\n  beforeRouteEnter(to, from, next) {\n    if (!sessionStorage.getItem(\"user\")) {\n      next(\"/auth/login\");\n    } else {\n      next();\n    }\n  }\n});\nexport default AddNew;","map":{"version":3,"names":["RecordFormWrapper","Main","BasicFormWrapper","useStore","reactive","ref","defineComponent","computed","authHeader","AddNew","name","components","data","state","isLoading","crud","loading","apiUrl","url","isFileLoading","fileLoading","join","API_URL","process","env","VUE_APP_BASE_URL","campaign_url","chv_url","campaigns","chvs","fetchCampaigns","response","fetch","method","headers","json","fetchCHV","handleSubmit","campaign_id","formState","user_ids","chv_id","console","log","JSON","stringify","body","then","success","message","occupied_users","_notification","description","duration","length","i","user","catch","error","user_id","beforeRouteEnter","to","from","next","sessionStorage","getItem"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/pages/household/houseHoldCHV.vue"],"sourcesContent":["<template>\n  <sdPageHeader title=\"Assign Campaign Users\">\n    <sdButton class=\"btn-add_new\" size=\"default\" key=\"1\" type=\"success\">\n      <router-link to=\"/crud/axios-view\">View All</router-link>\n    </sdButton>\n  </sdPageHeader>\n  <Main>\n    <a-row :gutter=\"15\">\n      <a-col :xs=\"24\">\n        <RecordFormWrapper>\n          <sdCards headless>\n            <a-row justify=\"center\">\n              <a-col :xl=\"10\" :md=\"16\" :xs=\"24\">\n                <BasicFormWrapper>\n                  <a-form\n                    class=\"add-record-form\"\n                    :style=\"{ width: '100%' }\"\n                    layout=\"vertical\"\n                    name=\"addnew\"\n                    :model=\"formState\"\n                    @finish=\"handleSubmit\"\n                  >\n                    <a-form-item name=\"campaign_id\" label=\"Campaign Name\">\n                      <a-select\n                        v-model:value=\"formState.campaign_id\"\n                        v-if=\"!loading\"\n                        placeholder=\"Select Campaign Name\"\n                      >\n                        <a-select-option\n                          v-for=\"campaign in campaigns\"\n                          :key=\"campaign.id\"\n                          :value=\"campaign.id\"\n                        >\n                          {{ campaign.name }}\n                        </a-select-option>\n                      </a-select>\n                    </a-form-item>\n\n                    <a-form-item label=\"CHVs\">\n                      <a-select\n                        mode=\"multiple\"\n                        v-model:value=\"formState.chv_id\"\n                        v-if=\"!loading\"\n                        placeholder=\"Select facilitators\"\n                      >\n                        <a-select-option\n                          v-for=\"chv in chvs\"\n                          :key=\"chv.id\"\n                          :value=\"chv.id\"\n                        >\n                          {{ chv.first_name }}\n                          {{ chv.last_name }} - {{ chv.phone_no }}\n                        </a-select-option>\n                      </a-select>\n                    </a-form-item>\n\n\n                    <div class=\"record-form-actions text-right\">\n                      <sdButton size=\"default\" htmlType=\"Save\" type=\"success\">\n                        {{ isLoading ? \"Loading...\" : \"Submit\" }}\n                      </sdButton>\n                    </div>\n                  </a-form>\n                </BasicFormWrapper>\n              </a-col>\n            </a-row>\n          </sdCards>\n        </RecordFormWrapper>\n      </a-col>\n    </a-row>\n  </Main>\n</template>\n\n<script>\nimport { RecordFormWrapper } from \"./style\";\nimport { Main, BasicFormWrapper } from \"../../styled\";\nimport { useStore } from \"vuex\";\nimport { reactive, ref, defineComponent, computed } from \"vue\";\n// import axios from \"axios\";\nimport authHeader from \"../../../services/auth-header\";\nimport { notification } from \"ant-design-vue\";\n// import { useRouter } from \"vue-router\";\n\n// testing app\n\nconst AddNew = defineComponent({\n  name: \"AddNew\",\n  components: { RecordFormWrapper, Main, BasicFormWrapper },\n\n  data() {\n    const { state } = useStore();\n\n    const isLoading = computed(() => state.crud.loading);\n    const apiUrl = computed(() => state.crud.url);\n    const isFileLoading = computed(() => state.crud.fileLoading);\n    const join = ref(\"\");\n\n    // const router = useRouter();\n\n    const API_URL = `${process.env.VUE_APP_BASE_URL}/users_doing_hh_reg`;\n\n    const campaign_url = `${process.env.VUE_APP_BASE_URL}/campaign_all`;\n\n    // const facilitator_url = `${process.env.VUE_APP_BASE_URL}/users`;\n\n    const chv_url = `${process.env.VUE_APP_BASE_URL}/get_user_given_the_role?role=chv`;\n\n    const { campaigns, chvs, loading } = reactive({\n      campaigns: \"\",\n      loading: true,\n      chvs: [],\n    });\n\n    const fetchCampaigns = async () => {\n      const response = await fetch(campaign_url, {\n        method: \"GET\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          ...authHeader(),\n        },\n      });\n      const data = await response.json();\n      this.campaigns = data.data;\n      // console.log(this.campaigns);\n      this.loading = false;\n    };\n    fetchCampaigns();\n\n\n    const fetchCHV = async () => {\n      const response = await fetch(chv_url, {\n        method: \"GET\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          ...authHeader(),\n        },\n      });\n      const data = await response.json();\n      this.chvs = data.data;\n      // console.log(data.data);\n      this.loading = false;\n    };\n    fetchCHV();\n\n    const handleSubmit = () => {\n      const data = {\n        campaign_id: formState.campaign_id,\n        user_ids: formState.chv_id,\n      };\n\n      console.log(JSON.stringify(data));\n\n      fetch(API_URL, {\n        method: \"POST\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          ...authHeader(),\n        },\n        body: JSON.stringify(data),\n      })\n        .then((response) => response.json())\n        .then(({ success, message, occupied_users }) => {\n          if (success) {\n            // router.push(\"event-view\");\n            console.log(success,message, occupied_users);\n            if(occupied_users == null ){\n              notification[\"success\"]({\n                message: message,\n                description: \"Users successfully assigned to a campaign\",\n                duration: 10.5,\n              });\n            }\n            // output notification for each user\n            else if (occupied_users.length > 0) {\n              for (var i = 0; i < occupied_users.length; i++) {\n                notification[\"error\"]({\n                  message: message,\n                  description: `User ${occupied_users[i].user} already assigned to a campaign`,\n                  duration: 10.5,\n                });\n              }\n            }\n            \n\n\n\n            // for (var i = 0; i < occupied_users.length; i++) {\n            //   notification[\"success\"]({\n            //     message: message,\n            //     description: `User ${occupied_users[i].user} already assigned to a campaign`,\n            //     duration: 10.5,\n            //   });\n            // }\n            // notification[\"success\"]({\n            //   message: message,\n            //   description: `Users ${occupied_users} already assigned to a campaign`,\n            //   duration: 5.5,\n            // });\n          }\n        })\n        .catch((error) => {\n          console.error(\"Error:\", error);\n        });\n    };\n\n    const formState = reactive({\n      campaign_id: null,\n      user_id: [],\n    });\n\n    // console.log(formState);\n\n    return {\n      isLoading,\n      apiUrl,\n      isFileLoading,\n      join,\n      handleSubmit,\n      formState,\n      campaigns,\n      chvs,\n      loading,\n    };\n  },\n  beforeRouteEnter(to, from, next) {\n    if (!sessionStorage.getItem(\"user\")) {\n      next(\"/auth/login\");\n    } else {\n      next();\n    }\n  },\n});\n\nexport default AddNew;\n</script>\n"],"mappings":";;AA0EA,SAASA,iBAAgB,QAAS,SAAS;AAC3C,SAASC,IAAI,EAAEC,gBAAe,QAAS,cAAc;AACrD,SAASC,QAAO,QAAS,MAAM;AAC/B,SAASC,QAAQ,EAAEC,GAAG,EAAEC,eAAe,EAAEC,QAAO,QAAS,KAAK;AAC9D;AACA,OAAOC,UAAS,MAAO,+BAA+B;AAEtD;AAEA;AAEA,MAAMC,MAAK,GAAIH,eAAe,CAAC;EAC7BI,IAAI,EAAE,QAAQ;EACdC,UAAU,EAAE;IAAEX,iBAAiB;IAAEC,IAAI;IAAEC;EAAiB,CAAC;EAEzDU,IAAIA,CAAA,EAAG;IACL,MAAM;MAAEC;IAAM,IAAIV,QAAQ,EAAE;IAE5B,MAAMW,SAAQ,GAAIP,QAAQ,CAAC,MAAMM,KAAK,CAACE,IAAI,CAACC,OAAO,CAAC;IACpD,MAAMC,MAAK,GAAIV,QAAQ,CAAC,MAAMM,KAAK,CAACE,IAAI,CAACG,GAAG,CAAC;IAC7C,MAAMC,aAAY,GAAIZ,QAAQ,CAAC,MAAMM,KAAK,CAACE,IAAI,CAACK,WAAW,CAAC;IAC5D,MAAMC,IAAG,GAAIhB,GAAG,CAAC,EAAE,CAAC;;IAEpB;;IAEA,MAAMiB,OAAM,GAAK,GAAEC,OAAO,CAACC,GAAG,CAACC,gBAAiB,qBAAoB;IAEpE,MAAMC,YAAW,GAAK,GAAEH,OAAO,CAACC,GAAG,CAACC,gBAAiB,eAAc;;IAEnE;;IAEA,MAAME,OAAM,GAAK,GAAEJ,OAAO,CAACC,GAAG,CAACC,gBAAiB,mCAAkC;IAElF,MAAM;MAAEG,SAAS;MAAEC,IAAI;MAAEb;IAAQ,IAAIZ,QAAQ,CAAC;MAC5CwB,SAAS,EAAE,EAAE;MACbZ,OAAO,EAAE,IAAI;MACba,IAAI,EAAE;IACR,CAAC,CAAC;IAEF,MAAMC,cAAa,GAAI,MAAAA,CAAA,KAAY;MACjC,MAAMC,QAAO,GAAI,MAAMC,KAAK,CAACN,YAAY,EAAE;QACzCO,MAAM,EAAE,KAAK;QACbC,OAAO,EAAE;UACP,cAAc,EAAE,k