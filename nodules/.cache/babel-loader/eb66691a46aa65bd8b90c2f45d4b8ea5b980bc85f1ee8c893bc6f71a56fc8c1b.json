{"ast":null,"code":"import PropTypes from 'vue-types';\nimport { computed, toRefs, defineComponent } from 'vue';\nimport { useStore } from 'vuex';\nimport { NoteStyleCard, Bullet } from './style';\nconst NoteCard = defineComponent({\n  name: 'NoteCard',\n  props: {\n    data: PropTypes.object\n  },\n  components: {\n    NoteStyleCard,\n    Bullet\n  },\n  setup(props) {\n    const {\n      state,\n      dispatch\n    } = useStore();\n    const noteData = computed(() => state.note.data);\n    const {\n      data\n    } = toRefs(props);\n    const onLabelChange = labels => {\n      dispatch('onLabelUpdate', {\n        data: noteData.value,\n        id: data.value.key,\n        value: labels\n      });\n    };\n    const onHandleDelete = () => {\n      const value = noteData.value.filter(item => item.key !== data.value.key);\n      dispatch('noteDeleteData', value);\n    };\n    const onStarUpdate = () => {\n      dispatch('onStarUpdate', {\n        data: noteData.value,\n        id: data.value.key\n      });\n    };\n    return {\n      onStarUpdate,\n      noteData,\n      dispatch,\n      onHandleDelete,\n      onLabelChange\n    };\n  }\n});\nexport default NoteCard;","map":{"version":3,"names":["PropTypes","computed","toRefs","defineComponent","useStore","NoteStyleCard","Bullet","NoteCard","name","props","data","object","components","setup","state","dispatch","noteData","note","onLabelChange","labels","value","id","key","onHandleDelete","filter","item","onStarUpdate"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/components/note/Card.vue"],"sourcesContent":["<template>\r\n  <NoteStyleCard :class=\"data.label\">\r\n    <sdCards headless>\r\n      <h4>\r\n        <span>\r\n          {{ data.title }}\r\n          <span :class=\"`status-bullet ${data.label}`\" />\r\n        </span>\r\n        <sdFeatherIcons class=\"handle\" type=\"move\" />\r\n        <!-- <Dragger /> -->\r\n      </h4>\r\n      <p>{{ data.description }}</p>\r\n      <div class=\"actions\">\r\n        <span>\r\n          <a :class=\"data.stared ? 'star active' : 'star'\" @click=\"onStarUpdate\" to=\"#\">\r\n            <sdFeatherIcons type=\"star\" size=\"16\" />\r\n          </a>\r\n          <a @click=\"() => onHandleDelete()\" to=\"#\">\r\n            <sdFeatherIcons type=\"trash-2\" size=\"16\" />\r\n          </a>\r\n        </span>\r\n        <sdDropdown>\r\n          <template #overlay>\r\n            <div class=\"nav-labels\">\r\n              <ul>\r\n                <li>\r\n                  <a @click=\"() => onLabelChange('personal')\" to=\"#\"> <Bullet class=\"personal\" /> Personal </a>\r\n                </li>\r\n                <li>\r\n                  <a @click=\"() => onLabelChange('work')\" to=\"#\"> <Bullet class=\"work\" /> Work </a>\r\n                </li>\r\n                <li>\r\n                  <a @click=\"() => onLabelChange('social')\" to=\"#\"> <Bullet class=\"social\" /> Social </a>\r\n                </li>\r\n                <li>\r\n                  <a @click=\"() => onLabelChange('important')\" to=\"#\"> <Bullet class=\"important\" /> Important </a>\r\n                </li>\r\n              </ul>\r\n            </div>\r\n          </template>\r\n          <a to=\"#\">\r\n            <sdFeatherIcons type=\"more-vertical\" size=\"20\" />\r\n          </a>\r\n        </sdDropdown>\r\n      </div>\r\n    </sdCards>\r\n  </NoteStyleCard>\r\n</template>\r\n<script>\r\nimport PropTypes from 'vue-types';\r\nimport { computed, toRefs, defineComponent } from 'vue';\r\nimport { useStore } from 'vuex';\r\nimport { NoteStyleCard, Bullet } from './style';\r\n\r\nconst NoteCard = defineComponent({\r\n  name: 'NoteCard',\r\n  props: {\r\n    data: PropTypes.object,\r\n  },\r\n  components: { NoteStyleCard, Bullet },\r\n  setup(props) {\r\n    const { state, dispatch } = useStore();\r\n    const noteData = computed(() => state.note.data);\r\n    const { data } = toRefs(props);\r\n    const onLabelChange = (labels) => {\r\n      dispatch('onLabelUpdate', { data: noteData.value, id: data.value.key, value: labels });\r\n    };\r\n\r\n    const onHandleDelete = () => {\r\n      const value = noteData.value.filter((item) => item.key !== data.value.key);\r\n      dispatch('noteDeleteData', value);\r\n    };\r\n\r\n    const onStarUpdate = () => {\r\n      dispatch('onStarUpdate', { data: noteData.value, id: data.value.key });\r\n    };\r\n\r\n    return {\r\n      onStarUpdate,\r\n      noteData,\r\n      dispatch,\r\n      onHandleDelete,\r\n      onLabelChange,\r\n    };\r\n  },\r\n});\r\n\r\nexport default NoteCard;\r\n</script>\r\n"],"mappings":"AAiDA,OAAOA,SAAQ,MAAO,WAAW;AACjC,SAASC,QAAQ,EAAEC,MAAM,EAAEC,eAAc,QAAS,KAAK;AACvD,SAASC,QAAO,QAAS,MAAM;AAC/B,SAASC,aAAa,EAAEC,MAAK,QAAS,SAAS;AAE/C,MAAMC,QAAO,GAAIJ,eAAe,CAAC;EAC/BK,IAAI,EAAE,UAAU;EAChBC,KAAK,EAAE;IACLC,IAAI,EAAEV,SAAS,CAACW;EAClB,CAAC;EACDC,UAAU,EAAE;IAAEP,aAAa;IAAEC;EAAO,CAAC;EACrCO,KAAKA,CAACJ,KAAK,EAAE;IACX,MAAM;MAAEK,KAAK;MAAEC;IAAS,IAAIX,QAAQ,EAAE;IACtC,MAAMY,QAAO,GAAIf,QAAQ,CAAC,MAAMa,KAAK,CAACG,IAAI,CAACP,IAAI,CAAC;IAChD,MAAM;MAAEA;IAAK,IAAIR,MAAM,CAACO,KAAK,CAAC;IAC9B,MAAMS,aAAY,GAAKC,MAAM,IAAK;MAChCJ,QAAQ,CAAC,eAAe,EAAE;QAAEL,IAAI,EAAEM,QAAQ,CAACI,KAAK;QAAEC,EAAE,EAAEX,IAAI,CAACU,KAAK,CAACE,GAAG;QAAEF,KAAK,EAAED;MAAO,CAAC,CAAC;IACxF,CAAC;IAED,MAAMI,cAAa,GAAIA,CAAA,KAAM;MAC3B,MAAMH,KAAI,GAAIJ,QAAQ,CAACI,KAAK,CAACI,MAAM,CAAEC,IAAI,IAAKA,IAAI,CAACH,GAAE,KAAMZ,IAAI,CAACU,KAAK,CAACE,GAAG,CAAC;MAC1EP,QAAQ,CAAC,gBAAgB,EAAEK,KAAK,CAAC;IACnC,CAAC;IAED,MAAMM,YAAW,GAAIA,CAAA,KAAM;MACzBX,QAAQ,CAAC,cAAc,EAAE;QAAEL,IAAI,EAAEM,QAAQ,CAACI,KAAK;QAAEC,EAAE,EAAEX,IAAI,CAACU,KAAK,CAACE;MAAI,CAAC,CAAC;IACxE,CAAC;IAED,OAAO;MACLI,YAAY;MACZV,QAAQ;MACRD,QAAQ;MACRQ,cAAc;MACdL;IACF,CAAC;EACH;AACF,CAAC,CAAC;AAEF,eAAeX,QAAQ"},"metadata":{},"sourceType":"module","externalDependencies":[]}