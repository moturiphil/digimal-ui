{"ast":null,"code":"import { Main } from '../styled';\nimport { UserOutlined } from '@ant-design/icons-vue';\nimport config from '../../config/config';\nimport { AvatarWraperStyle } from './ui-elements-styled';\nimport { useStore } from 'vuex';\nimport { computed, ref, defineComponent } from 'vue';\nconst {\n  theme\n} = config;\nconst UserList = ['U', 'Lucy', 'Tom', 'Edward'];\nconst ColorList = ['#f56a00', '#7265e6', '#ffbf00', '#00a2ae'];\nexport default defineComponent({\n  name: 'Avatar',\n  components: {\n    Main,\n    AvatarWraperStyle,\n    UserOutlined\n  },\n  setup() {\n    const {\n      state\n    } = useStore();\n    const user = ref(UserList[0]);\n    const color = ref(ColorList[0]);\n    const rtl = computed(() => state.themeLayout.rtlData);\n    function changeUser() {\n      const index = UserList.indexOf(user.value);\n      user.value = index < UserList.length - 1 ? UserList[index + 1] : UserList[0];\n      color.value = index < ColorList.length - 1 ? ColorList[index + 1] : ColorList[0];\n    }\n    return {\n      theme,\n      user,\n      color,\n      rtl,\n      changeUser\n    };\n  }\n});","map":{"version":3,"names":["Main","UserOutlined","config","AvatarWraperStyle","useStore","computed","ref","defineComponent","theme","UserList","ColorList","name","components","setup","state","user","color","rtl","themeLayout","rtlData","changeUser","index","indexOf","value","length"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/uiElements/Avatar.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <sdPageHeader title=\"Avatar\">\r\n      <template v-slot:buttons>\r\n        <div class=\"page-header-actions\">\r\n          <sdCalendarButton />\r\n          <sdExportButton />\r\n          <sdShareButton />\r\n          <sdButton size=\"small\" type=\"primary\">\r\n            <sdFeatherIcons type=\"plus\" size=\"14\" />\r\n            Add New\r\n          </sdButton>\r\n        </div>\r\n      </template>\r\n    </sdPageHeader>\r\n    <Main>\r\n      <a-row :gutter=\"25\">\r\n        <a-col :md=\"12\" :sm=\"12\" :xs=\"24\">\r\n          <sdCards title=\"Basic\">\r\n            <AvatarWraperStyle :style=\"{ marginBottom: 10 }\">\r\n              <a-avatar :size=\"64\"\r\n                ><template #icon><UserOutlined /></template\r\n              ></a-avatar>\r\n              <a-avatar size=\"large\"\r\n                ><template #icon><UserOutlined /></template\r\n              ></a-avatar>\r\n              <a-avatar\r\n                ><template #icon><UserOutlined /></template\r\n              ></a-avatar>\r\n              <a-avatar size=\"small\"\r\n                ><template #icon><UserOutlined /></template\r\n              ></a-avatar>\r\n            </AvatarWraperStyle>\r\n            <AvatarWraperStyle>\r\n              <a-avatar shape=\"square\" :size=\"64\"\r\n                ><template #icon><UserOutlined /></template\r\n              ></a-avatar>\r\n              <a-avatar shape=\"square\" size=\"large\"\r\n                ><template #icon><UserOutlined /></template\r\n              ></a-avatar>\r\n              <a-avatar shape=\"square\"\r\n                ><template #icon><UserOutlined /></template\r\n              ></a-avatar>\r\n              <a-avatar shape=\"square\" size=\"small\"\r\n                ><template #icon><UserOutlined /></template\r\n              ></a-avatar>\r\n            </AvatarWraperStyle>\r\n          </sdCards>\r\n          <sdCards title=\"Autoset Font Size\">\r\n            <AvatarWraperStyle>\r\n              <div>\r\n                <a-avatar :style=\"{ backgroundColor: color, verticalAlign: 'middle' }\" size=\"large\">\r\n                  {{ user }}\r\n                </a-avatar>\r\n                <sdButton\r\n                  size=\"small\"\r\n                  class=\"btn-outlined\"\r\n                  type=\"light\"\r\n                  :outlined=\"true\"\r\n                  :style=\"{\r\n                    margin: '0 10px',\r\n                    verticalAlign: 'middle',\r\n                    color: '#ADB4D2',\r\n                  }\"\r\n                  @click=\"changeUser\"\r\n                >\r\n                  Change\r\n                </sdButton>\r\n              </div>\r\n            </AvatarWraperStyle>\r\n          </sdCards>\r\n        </a-col>\r\n        <a-col :md=\"12\" :sm=\"12\" :xs=\"24\">\r\n          <sdCards title=\"Type\">\r\n            <AvatarWraperStyle>\r\n              <a-avatar\r\n                ><template #icon><UserOutlined /></template\r\n              ></a-avatar>\r\n              <a-avatar\r\n                ><template #icon><UserOutlined /></template\r\n              ></a-avatar>\r\n              <a-avatar>U</a-avatar>\r\n              <a-avatar>USER</a-avatar>\r\n              <a-avatar src=\"https://zos.alipayobjects.com/rmsportal/ODTLcjxAfvqbxHnVXCYX.png\" />\r\n              <a-avatar :style=\"{ color: '#f56a00', backgroundColor: '#fde3cf' }\">U</a-avatar>\r\n              <a-avatar :style=\"{ backgroundColor: '#20C997' }\"\r\n                ><template #icon><UserOutlined /></template\r\n              ></a-avatar>\r\n            </AvatarWraperStyle>\r\n          </sdCards>\r\n          <sdCards title=\"with badge\">\r\n            <AvatarWraperStyle>\r\n              <span :style=\"{ [!rtl ? 'marginRight' : 'marginLeft']: 10 }\">\r\n                <a-badge :count=\"1\">\r\n                  <a-avatar shape=\"square\"\r\n                    ><template #icon><UserOutlined /></template\r\n                  ></a-avatar>\r\n                </a-badge>\r\n              </span>\r\n              <span>\r\n                <a-badge dot>\r\n                  <a-avatar shape=\"square\"\r\n                    ><template #icon><UserOutlined /></template\r\n                  ></a-avatar>\r\n                </a-badge>\r\n              </span>\r\n            </AvatarWraperStyle>\r\n          </sdCards>\r\n        </a-col>\r\n      </a-row>\r\n    </Main>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { Main } from '../styled';\r\nimport { UserOutlined } from '@ant-design/icons-vue';\r\nimport config from '../../config/config';\r\nimport { AvatarWraperStyle } from './ui-elements-styled';\r\nimport { useStore } from 'vuex';\r\nimport { computed, ref, defineComponent } from 'vue';\r\n\r\nconst { theme } = config;\r\nconst UserList = ['U', 'Lucy', 'Tom', 'Edward'];\r\nconst ColorList = ['#f56a00', '#7265e6', '#ffbf00', '#00a2ae'];\r\n\r\nexport default defineComponent({\r\n  name: 'Avatar',\r\n  components: {\r\n    Main,\r\n    AvatarWraperStyle,\r\n    UserOutlined,\r\n  },\r\n  setup() {\r\n    const { state } = useStore();\r\n    const user = ref(UserList[0]);\r\n    const color = ref(ColorList[0]);\r\n    const rtl = computed(() => state.themeLayout.rtlData);\r\n\r\n    function changeUser() {\r\n      const index = UserList.indexOf(user.value);\r\n      user.value = index < UserList.length - 1 ? UserList[index + 1] : UserList[0];\r\n      color.value = index < ColorList.length - 1 ? ColorList[index + 1] : ColorList[0];\r\n    }\r\n\r\n    return {\r\n      theme,\r\n      user,\r\n      color,\r\n      rtl,\r\n      changeUser,\r\n    };\r\n  },\r\n});\r\n</script>\r\n"],"mappings":"AAmHA,SAASA,IAAG,QAAS,WAAW;AAChC,SAASC,YAAW,QAAS,uBAAuB;AACpD,OAAOC,MAAK,MAAO,qBAAqB;AACxC,SAASC,iBAAgB,QAAS,sBAAsB;AACxD,SAASC,QAAO,QAAS,MAAM;AAC/B,SAASC,QAAQ,EAAEC,GAAG,EAAEC,eAAc,QAAS,KAAK;AAEpD,MAAM;EAAEC;AAAM,IAAIN,MAAM;AACxB,MAAMO,QAAO,GAAI,CAAC,GAAG,EAAE,MAAM,EAAE,KAAK,EAAE,QAAQ,CAAC;AAC/C,MAAMC,SAAQ,GAAI,CAAC,SAAS,EAAE,SAAS,EAAE,SAAS,EAAE,SAAS,CAAC;AAE9D,eAAeH,eAAe,CAAC;EAC7BI,IAAI,EAAE,QAAQ;EACdC,UAAU,EAAE;IACVZ,IAAI;IACJG,iBAAiB;IACjBF;EACF,CAAC;EACDY,KAAKA,CAAA,EAAG;IACN,MAAM;MAAEC;IAAM,IAAIV,QAAQ,EAAE;IAC5B,MAAMW,IAAG,GAAIT,GAAG,CAACG,QAAQ,CAAC,CAAC,CAAC,CAAC;IAC7B,MAAMO,KAAI,GAAIV,GAAG,CAACI,SAAS,CAAC,CAAC,CAAC,CAAC;IAC/B,MAAMO,GAAE,GAAIZ,QAAQ,CAAC,MAAMS,KAAK,CAACI,WAAW,CAACC,OAAO,CAAC;IAErD,SAASC,UAAUA,CAAA,EAAG;MACpB,MAAMC,KAAI,GAAIZ,QAAQ,CAA