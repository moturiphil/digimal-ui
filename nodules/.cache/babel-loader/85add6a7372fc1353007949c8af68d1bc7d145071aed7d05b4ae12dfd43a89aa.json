.string,\r\n    action: VueTypes.string.def('hover'),\r\n  },\r\n  data() {\r\n    return {\r\n      visible: false,\r\n      className: this.class,\r\n    };\r\n  },\r\n  components: {\r\n    Content,\r\n    Title,\r\n  },\r\n});\r\n</script>\r\n<style>\r\n@import './style.css';\r\n</style>\r\n"],"mappings":"AA4BA,SAASA,OAAO,EAAEC,KAAI,QAAS,SAAS;AACxC,OAAOC,QAAO,MAAO,WAAW;AAChC,SAASC,eAAc,QAAS,KAAK;AAErC,eAAeA,eAAe,CAAC;EAC7BC,IAAI,EAAE,SAAS;EACfC,KAAK,EAAE;IACLC,SAAS,EAAEJ,QAAQ,CAACK,MAAM,CAACC,GAAG,CAAC,QAAQ,CAAC;IACxCC,KAAK,EAAEP,QAAQ,CAACK,MAAM;IACtBG,KAAK,EAAER,QAAQ,CAACK,MAAM;IACtBI,MAAM,EAAET,QAAQ,CAACK,MAAM,CAACC,GAAG,CAAC,OAAO;EACrC,CAAC;EACDI,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,OAAO,EAAE,KAAK;MACdC,SAAS,EAAE,IAAI,CAACJ;IAClB,CAAC;EACH,CAAC;EACDK,UAAU,EAAE;IACVf,OAAO;IACPC;EACF;AACF,CAAC,CAAC"},"metadata":{},"sourceType":"module","externalDependencies":[]}