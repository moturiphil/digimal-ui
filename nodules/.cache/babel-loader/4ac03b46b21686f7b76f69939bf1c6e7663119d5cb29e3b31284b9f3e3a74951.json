{"ast":null,"code":"import { RecordViewWrapper } from \"../style\";\nimport { Main, TableWrapper } from \"../../styled\";\nimport { useStore } from \"vuex\";\nimport { computed, onMounted, ref, reactive, defineComponent } from \"vue\";\n// import axios from \"axios\";\nimport authHeader from \"../../../services/auth-header\";\nimport UserService from \"../../../services/user.service\";\n// import { useRouter } from \"vue-router\";\n// import DragAndDropTable from '../../../view/table/DragTable.vue';\n\n// console.log(userService.getAll());\n\nconst columns = [{\n  title: \"First Name\",\n  dataIndex: \"first_name\",\n  key: \"id\"\n}, {\n  title: \"Middle Name\",\n  dataIndex: \"middle_name\",\n  key: \"id\"\n}, {\n  title: \"Last Name\",\n  dataIndex: \"last_name\",\n  key: \"id\"\n}, {\n  title: \"Level\",\n  dataIndex: \"level_id\",\n  key: \"id\"\n}, {\n  title: \"Organization\",\n  dataIndex: \"org_types_id\",\n  key: \"id\"\n}, {\n  title: \"Role\",\n  dataIndex: \"role_id\",\n  key: \"id\"\n}, {\n  title: \"Phone Number\",\n  dataIndex: \"phone_no\",\n  key: \"id\"\n}];\nconst DragAndDropTable = defineComponent({\n  name: \"ViewPage\",\n  components: {\n    RecordViewWrapper,\n    Main,\n    TableWrapper\n  },\n  setup() {\n    const {\n      state,\n      dispatch\n    } = useStore();\n    const crud = computed(() => state.crud.data);\n    const isLoading = computed(() => state.crud.loading);\n    const selectedRowKeys = ref([]);\n    const dataSource = ref([]);\n    const API_URL = `${process.env.VUE_APP_BASE_URL}/generateUserCSV`;\n    console.log(authHeader());\n    const api_url = UserService;\n    console.log(api_url);\n    onMounted(async () => {\n      try {\n        const response = await fetch(`${process.env.VUE_APP_BASE_URL}/users`, {\n          method: \"GET\",\n          headers: authHeader()\n        });\n        const data = await response.json();\n        dataSource.value = data.data;\n        console.log(data.data);\n      } catch (error) {\n        console.error(error);\n      }\n    });\n    const exportUserData = async () => {\n      try {\n        const response = await fetch(API_URL, {\n          method: \"GET\",\n          headers: {\n            \"Content-Type\": \"application/json\",\n            ...authHeader()\n          }\n        });\n        if (!response.ok) {\n          throw new Error(\"Failed to fetch export data\");\n        }\n        const fileBlob = await response.blob();\n        const fileName = \"users.csv\";\n        const link = document.createElement(\"a\");\n        link.href = window.URL.createObjectURL(new Blob([fileBlob]));\n        link.setAttribute(\"download\", fileName);\n        document.body.appendChild(link);\n        link.click();\n        link.parentNode.removeChild(link);\n      } catch (error) {\n        console.error(error);\n      }\n    };\n    const handleDelete = id => {\n      const confirm = window.confirm(\"Are you sure delete this?\");\n      if (confirm) {\n        dispatch(\"axiosDataDelete\", {\n          id,\n          getData: () => {\n            dispatch(\"axiosCrudGetData\");\n          }\n        });\n      }\n      return false;\n    };\n    const formState = reactive({\n      searchItem: \"\"\n    });\n    const onSelectChange = selectedRowKey => {\n      selectedRowKeys.value = selectedRowKey;\n    };\n    const rowSelection = {\n      selectedRowKeys,\n      onChange: onSelectChange\n    };\n    return {\n      crud,\n      isLoading,\n      selectedRowKeys,\n      handleDelete,\n      rowSelection,\n      onSelectChange,\n      dataSource,\n      columns,\n      formState,\n      exportUserData\n    };\n  }\n});\nexport default DragAndDropTable;","map":{"version":3,"names":["RecordViewWrapper","Main","TableWrapper","useStore","computed","onMounted","ref","reactive","defineComponent","authHeader","UserService","columns","title","dataIndex","key","DragAndDropTable","name","components","setup","state","dispatch","crud","data","isLoading","loading","selectedRowKeys","dataSource","API_URL","process","env","VUE_APP_BASE_URL","console","log","api_url","response","fetch","method","headers","json","value","error","exportUserData","ok","Error","fileBlob","blob","fileName","link","document","createElement","href","window","URL","createObjectURL","Blob","setAttribute","body","appendChild","click","parentNode","removeChild","handleDelete","id","confirm","getData","formState","searchItem","onSelectChange","selectedRowKey","rowSelection","onChange"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/pages/users/registeredUsers.vue"],"sourcesContent":["<template>\n  <RecordViewWrapper>\n    <sdPageHeader title=\"Users\">\n      <template id=\"buttons\"></template>\n    </sdPageHeader>\n\n    <!-- sdPageBody -->\n\n    <Main>\n        <sdButton class=\"btn-import\" type=\"success\">\n          <router-link\n            :to=\"{\n              path: `/users/import`,\n            }\"\n            class=\"btn-icon\"\n            type=\"info\"\n            shape=\"circle\"\n          >\n            <!-- <sdFeatherIcons type=\"eye\" size=\"16\" /> -->\n            &nbsp;&nbsp; Import Master List\n          </router-link>\n        </sdButton>\n        &nbsp;&nbsp;&nbsp;&nbsp;\n        <sdButton class=\"btn-import\" type=\"success\" @click=\"exportUserData\">\n          Export Users\n        </sdButton>\n        <br>\n        <br>\n      <a-row :gutter=\"15\">\n        <a-col class=\"w-100\" :md=\"24\">\n          <sdCards headless>\n            <div v-if=\"isLoading\" class=\"spin\">\n              <a-spin />\n            </div>\n\n            <div v-else>\n              <TableWrapper class=\"table-data-view table-responsive\">\n                <a-table\n                  :pagination=\"{ pageSize: 100, showSizeChanger: true }\"\n                  :dataSource=\"dataSource\"\n                  :columns=\"columns\"\n                />\n              </TableWrapper>\n            </div>\n          </sdCards>\n        </a-col>\n      </a-row>\n      <a-col :xs=\"24\">\n        <DragAndDropTable />\n      </a-col>\n    </Main>\n  </RecordViewWrapper>\n</template>\n<script>\nimport { RecordViewWrapper } from \"../style\";\nimport { Main, TableWrapper } from \"../../styled\";\nimport { useStore } from \"vuex\";\nimport { computed, onMounted, ref, reactive, defineComponent } from \"vue\";\n// import axios from \"axios\";\nimport authHeader from \"../../../services/auth-header\";\nimport UserService from \"../../../services/user.service\";\n// import { useRouter } from \"vue-router\";\n// import DragAndDropTable from '../../../view/table/DragTable.vue';\n\n// console.log(userService.getAll());\n\nconst columns = [\n  {\n    title: \"First Name\",\n    dataIndex: \"first_name\",\n    key: \"id\",\n  },\n  {\n    title: \"Middle Name\",\n    dataIndex: \"middle_name\",\n    key: \"id\",\n  },\n  {\n    title: \"Last Name\",\n    dataIndex: \"last_name\",\n    key: \"id\",\n  },\n  {\n    title: \"Level\",\n    dataIndex: \"level_id\",\n    key: \"id\",\n  },\n  {\n    title: \"Organization\",\n    dataIndex: \"org_types_id\",\n    key: \"id\",\n  },\n  {\n    title: \"Role\",\n    dataIndex: \"role_id\",\n    key: \"id\",\n  },\n  {\n    title: \"Phone Number\",\n    dataIndex: \"phone_no\",\n    key: \"id\",\n  },\n];\n\nconst DragAndDropTable = defineComponent({\n  name: \"ViewPage\",\n  components: { RecordViewWrapper, Main, TableWrapper },\n\n  setup() {\n    const { state, dispatch } = useStore();\n    const crud = computed(() => state.crud.data);\n    const isLoading = computed(() => state.crud.loading);\n    const selectedRowKeys = ref([]);\n    const dataSource = ref([]);\n\n    const API_URL = `${process.env.VUE_APP_BASE_URL}/generateUserCSV`;\n\n    console.log(authHeader());\n\n    const api_url = UserService;\n    console.log(api_url);\n\n    onMounted(async () => {\n      try {\n        const response = await fetch(`${process.env.VUE_APP_BASE_URL}/users`, {\n          method: \"GET\",\n          headers: authHeader(),\n        });\n        const data = await response.json();\n        dataSource.value = data.data;\n        console.log(data.data);\n      } catch (error) {\n        console.error(error);\n      }\n    });\n\n    const exportUserData = async () => {\n      try {\n        const response = await fetch(\n          API_URL,\n          {\n            method: \"GET\",\n            headers: {\n              \"Content-Type\": \"application/json\",\n              ...authHeader(),\n            },\n          }\n        );\n\n        if (!response.ok) {\n          throw new Error(\"Failed to fetch export data\");\n        }\n\n        const fileBlob = await response.blob();\n        const fileName = \"users.csv\";\n        const link = document.createElement(\"a\");\n        link.href = window.URL.createObjectURL(new Blob([fileBlob]));\n        link.setAttribute(\"download\", fileName);\n        document.body.appendChild(link);\n        link.click();\n        link.parentNode.removeChild(link);\n      } catch (error) {\n        console.error(error);\n      }\n    };\n\n    const handleDelete = (id) => {\n      const confirm = window.confirm(\"Are you sure delete this?\");\n      if (confirm) {\n        dispatch(\"axiosDataDelete\", {\n          id,\n          getData: () => {\n            dispatch(\"axiosCrudGetData\");\n          },\n        });\n      }\n      return false;\n    };\n\n    const formState = reactive({\n      searchItem: \"\",\n    });\n\n    const onSelectChange = (selectedRowKey) => {\n      selectedRowKeys.value = selectedRowKey;\n    };\n\n    const rowSelection = {\n      selectedRowKeys,\n      onChange: onSelectChange,\n    };\n\n    return {\n      crud,\n      isLoading,\n      selectedRowKeys,\n      handleDelete,\n      rowSelection,\n      onSelectChange,\n      dataSource,\n      columns,\n      formState,\n      exportUserData,\n    };\n  },\n});\n\nexport default DragAndDropTable;\n</script>\n"],"mapping