{"ast":null,"code":"import { VueDraggableNext } from 'vue-draggable-next';\nimport KanbanBoardItem from './KanbanBoardItem';\nimport { defineComponent } from 'vue';\nexport default defineComponent({\n  name: 'TaskItem',\n  components: {\n    VueDraggableNext,\n    KanbanBoardItem\n  },\n  props: ['id', 'taskId', 'onBackShadow', 'onTaskTitleUpdate', 'onTaskTitleDelete', 'showModal'],\n  computed: {\n    taskData: {\n      get() {\n        return this.$store.state.KanbanBoard.taskData;\n      }\n    }\n  },\n  methods: {\n    checkMove(state) {\n      const boardId = state.to.getAttribute('data-boardId');\n      const keyId = state.item.getAttribute('data-keyId');\n      const data = this.$store.state.KanbanBoard.taskData.map(item => {\n        if (item.id == keyId) {\n          item.boardId = boardId;\n        }\n        return item;\n      });\n      this.$store.dispatch('ToAddTask', data);\n    }\n  }\n});","map":{"version":3,"names":["VueDraggableNext","KanbanBoardItem","defineComponent","name","components","props","computed","taskData","get","$store","state","KanbanBoard","methods","checkMove","boardId","to","getAttribute","keyId","item","data","map","id","dispatch"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/apps/kanban/overview/TaskItem.vue"],"sourcesContent":["<template>\r\n  <VueDraggableNext\r\n    :data-boardId=\"id\"\r\n    @end=\"checkMove\"\r\n    class=\"dragArea list-group w-full\"\r\n    v-model=\"taskData\"\r\n    item-key=\"id\"\r\n    group=\"people\"\r\n  >\r\n    <div\r\n      class=\"list-group-item sDash_kanvan-task__single\"\r\n      v-for=\"element in taskData.filter((item) => item.boardId === this.id)\"\r\n      :key=\"element.id\"\r\n      :data-keyId=\"element.id\"\r\n    >\r\n      <KanbanBoardItem\r\n        :taskId=\"taskId\"\r\n        :onBackShadow=\"onBackShadow\"\r\n        :onTaskTitleUpdate=\"onTaskTitleUpdate\"\r\n        :onTaskTitleDelete=\"onTaskTitleDelete\"\r\n        :showModal=\"showModal\"\r\n        :data=\"element\"\r\n      />\r\n    </div>\r\n  </VueDraggableNext>\r\n</template>\r\n<script>\r\nimport { VueDraggableNext } from 'vue-draggable-next';\r\nimport KanbanBoardItem from './KanbanBoardItem';\r\nimport { defineComponent } from 'vue';\r\n\r\nexport default defineComponent({\r\n  name: 'TaskItem',\r\n  components: { VueDraggableNext, KanbanBoardItem },\r\n  props: ['id', 'taskId', 'onBackShadow', 'onTaskTitleUpdate', 'onTaskTitleDelete', 'showModal'],\r\n  computed: {\r\n    taskData: {\r\n      get() {\r\n        return this.$store.state.KanbanBoard.taskData;\r\n      },\r\n    },\r\n  },\r\n  methods: {\r\n    checkMove(state) {\r\n      const boardId = state.to.getAttribute('data-boardId');\r\n      const keyId = state.item.getAttribute('data-keyId');\r\n\r\n      const data = this.$store.state.KanbanBoard.taskData.map((item) => {\r\n        if (item.id == keyId) {\r\n          item.boardId = boardId;\r\n        }\r\n        return item;\r\n      });\r\n\r\n      this.$store.dispatch('ToAddTask', data);\r\n    },\r\n  },\r\n});\r\n</script>\r\n"],"mappings":"AA2BA,SAASA,gBAAe,QAAS,oBAAoB;AACrD,OAAOC,eAAc,MAAO,mBAAmB;AAC/C,SAASC,eAAc,QAAS,KAAK;AAErC,eAAeA,eAAe,CAAC;EAC7BC,IAAI,EAAE,UAAU;EAChBC,UAAU,EAAE;IAAEJ,gBAAgB;IAAEC;EAAgB,CAAC;EACjDI,KAAK,EAAE,CAAC,IAAI,EAAE,QAAQ,EAAE,cAAc,EAAE,mBAAmB,EAAE,mBAAmB,EAAE,WAAW,CAAC;EAC9FC,QAAQ,EAAE;IACRC,QAAQ,EAAE;MACRC,GAAGA,CAAA,EAAG;QACJ,OAAO,IAAI,CAACC,MAAM,CAACC,KAAK,CAACC,WAAW,CAACJ,QAAQ;MAC/C;IACF;EACF,CAAC;EACDK,OAAO,EAAE;IACPC,SAASA,CAACH,KAAK,EAAE;MACf,MAAMI,OAAM,GAAIJ,KAAK,CAACK,EAAE,CAACC,YAAY,CAAC,cAAc,CAAC;MACrD,MAAMC,KAAI,GAAIP,KAAK,CAACQ,IAAI,CAACF,YAAY,CAAC,YAAY,CAAC;MAEnD,MAAMG,IAAG,GAAI,IAAI,CAACV,MAAM,CAACC,KAAK,CAACC,WAAW,CAACJ,QAAQ,CAACa,GAAG,CAAEF,IAAI,IAAK;QAChE,IAAIA,IAAI,CAACG,EAAC,IAAKJ,KAAK,EAAE;UACpBC,IAAI,CAACJ,OAAM,GAAIA,OAAO;QACxB;QACA,OAAOI,IAAI;MACb,CAAC,CAAC;MAEF,IAAI,CAACT,MAAM,CAACa,QAAQ,CAAC,WAAW,EAAEH,IAAI,CAAC;IACzC;EACF;AACF,CAAC,CAAC"},"metadata":{},"sourceType":"module","exter