{"ast":null,"code":"import { EmailNav } from './style';\nimport { ref, defineComponent } from 'vue';\nimport VueTypes from 'vue-types';\nconst EmailNavbar = defineComponent({\n  name: 'EmailNavbar',\n  components: {\n    EmailNav\n  },\n  props: {\n    path: VueTypes.string,\n    toggleCollapsed: VueTypes.func\n  },\n  setup() {\n    const labels = ref(['personal', 'social', 'promotions']);\n    const newLabel = ref('');\n    const addNewDisplay = ref(false);\n    const addNewLabels = e => {\n      e.preventDefault();\n      addNewDisplay.value = true;\n    };\n    const cancelAddNewLabels = e => {\n      e.preventDefault();\n      e.stopPropagation();\n      addNewDisplay.value = false;\n    };\n    const handelChange = e => {\n      e.preventDefault();\n      e.stopPropagation();\n      if (newLabel.value !== '') {\n        labels.value = [...labels.value, newLabel.value];\n        newLabel.value = '';\n      } else {\n        alert('Please Give a label...');\n      }\n    };\n    const onLabelChange = e => {\n      newLabel.value = e.target.value;\n    };\n    return {\n      labels,\n      newLabel,\n      addNewDisplay,\n      addNewLabels,\n      cancelAddNewLabels,\n      handelChange,\n      onLabelChange\n    };\n  }\n});\nexport default EmailNavbar;","map":{"version":3,"names":["EmailNav","ref","defineComponent","VueTypes","EmailNavbar","name","components","props","path","string","toggleCollapsed","func","setup","labels","newLabel","addNewDisplay","addNewLabels","e","preventDefault","value","cancelAddNewLabels","stopPropagation","handelChange","alert","onLabelChange","target"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/apps/email/overview/Navbar.vue"],"sourcesContent":["<template>\r\n  <EmailNav>\r\n    <ul>\r\n      <li>\r\n        <router-link :to=\"`${path}inbox`\" click=\"toggleCollapsed\">\r\n          <sdFeatherIcons type=\"inbox\" size=\"18\" />\r\n          <span class=\"nav-text\">\r\n            <span>Inbox</span>\r\n            <span class=\"badge badge-primary\">3</span>\r\n          </span>\r\n        </router-link>\r\n      </li>\r\n      <li>\r\n        <router-link :to=\"`${path}starred`\" click=\"toggleCollapsed\">\r\n          <sdFeatherIcons type=\"star\" size=\"18\" />\r\n          <span class=\"nav-text\">\r\n            <span>Starred</span>\r\n          </span>\r\n        </router-link>\r\n      </li>\r\n      <li>\r\n        <router-link :to=\"`${path}sent`\" click=\"toggleCollapsed\">\r\n          <sdFeatherIcons type=\"send\" size=\"18\" />\r\n          <span class=\"nav-text\">\r\n            <span>Sent</span>\r\n          </span>\r\n        </router-link>\r\n      </li>\r\n      <li>\r\n        <router-link :to=\"`${path}drafts`\" click=\"toggleCollapsed\">\r\n          <sdFeatherIcons type=\"edit\" size=\"18\" />\r\n          <span class=\"nav-text\">\r\n            <span>Drafts</span>\r\n          </span>\r\n          <span class=\"badge badge-primary\">12</span>\r\n        </router-link>\r\n      </li>\r\n      <li>\r\n        <router-link :to=\"`${path}spam`\" click=\"toggleCollapsed\">\r\n          <sdFeatherIcons type=\"alert-octagon\" size=\"18\" />\r\n          <span class=\"nav-text\">\r\n            <span>Spam</span>\r\n          </span>\r\n        </router-link>\r\n      </li>\r\n      <li>\r\n        <router-link :to=\"`${path}trash`\" click=\"toggleCollapsed\">\r\n          <sdFeatherIcons type=\"trash-2\" size=\"18\" />\r\n          <span class=\"nav-text\">\r\n            <span>Trash</span>\r\n          </span>\r\n        </router-link>\r\n      </li>\r\n    </ul>\r\n    <div class=\"nav-labels\">\r\n      <p>Labels</p>\r\n      <ul>\r\n        <li v-for=\"label in labels\" :key=\"label\">\r\n          <a to=\"#\"> <sdFeatherIcons type=\"list\" size=\"18\" /> {{ label }} </a>\r\n        </li>\r\n\r\n        <li class=\"add-label-btn\" @click=\"addNewLabels\" role=\"menuitem\">\r\n          <router-link @click=\"addNewLabels\" to=\"#\">\r\n            <sdFeatherIcons type=\"plus\" size=\"18\" /> Add New Label\r\n          </router-link>\r\n\r\n          <div v-if=\"addNewDisplay\" class=\"add-label\">\r\n            <form @submit=\"handelChange\">\r\n              <sdHeading as=\"h3\">Add New Label</sdHeading>\r\n              <a-input\r\n                @change=\"onLabelChange\"\r\n                v-model:value=\"newLabel\"\r\n                :name=\"newLabel\"\r\n                type=\"text\"\r\n                placeholder=\"Enter label name\"\r\n              />\r\n              <div class=\"btn-group\">\r\n                <sdButton size=\"default\" @click=\"handelChange\" type=\"primary\"> Add Label </sdButton>\r\n                <sdButton @click=\"cancelAddNewLabels\" type=\"default\"> Cancel </sdButton>\r\n              </div>\r\n            </form>\r\n          </div>\r\n        </li>\r\n      </ul>\r\n    </div>\r\n  </EmailNav>\r\n</template>\r\n<script>\r\nimport { EmailNav } from './style';\r\nimport { ref, defineComponent } from 'vue';\r\nimport VueTypes from 'vue-types';\r\n\r\nconst EmailNavbar = defineComponent({\r\n  name: 'EmailNavbar',\r\n  components: { EmailNav },\r\n  props: { path: VueTypes.string, toggleCollapsed: VueTypes.func },\r\n  setup() {\r\n    const labels = ref(['personal', 'social', 'promotions']);\r\n    const newLabel = ref('');\r\n    const addNewDisplay = ref(false);\r\n\r\n    const addNewLabels = (e) => {\r\n      e.preventDefault();\r\n      addNewDisplay.value = true;\r\n    };\r\n\r\n    const cancelAddNewLabels = (e) => {\r\n      e.preventDefault();\r\n      e.stopPropagation();\r\n      addNewDisplay.value = false;\r\n    };\r\n\r\n    const handelChange = (e) => {\r\n      e.preventDefault();\r\n      e.stopPropagation();\r\n      if (newLabel.value !== '') {\r\n        labels.value = [...labels.value, newLabel.value];\r\n        newLabel.value = '';\r\n      } else {\r\n        alert('Please Give a label...');\r\n      }\r\n    };\r\n\r\n    const onLabelChange = (e) => {\r\n      newLabel.value = e.target.value;\r\n    };\r\n\r\n    return {\r\n      labels,\r\n      newLabel,\r\n      addNewDisplay,\r\n      addNewLabels,\r\n      cancelAddNewLabels,\r\n      handelChange,\r\n      onLabelChange,\r\n    };\r\n  },\r\n});\r\n\r\nexport default EmailNavbar;\r\n</script>\r\n"],"mappings":"AAwFA,SAASA,QAAO,QAAS,SAAS;AAClC,SAASC,GAAG,EAAEC,eAAc,QAAS,KAAK;AAC1C,OAAOC,QAAO,MAAO,WAAW;AAEhC,MAAMC,WAAU,GAAIF,eAAe,CAAC;EAClCG,IAAI,EAAE,aAAa;EACnBC,UAAU,EAAE;IAAEN;EAAS,CAAC;EACxBO,KAAK,EAAE;IAAEC,IAAI,EAAEL,QAAQ,CAACM,MAAM;IAAEC,eAAe,EAAEP,QAAQ,CAACQ;EAAK,CAAC;EAChEC,KAAKA,CAAA,EAAG;IACN,MAAMC,MAAK,GAAIZ,GAAG,CAAC,CAAC,UAAU,EAAE,QAAQ,EAAE,YAAY,CAAC,CAAC;IACxD,MAAMa,QAAO,GAAIb,GAAG,CAAC,EAAE,CAAC;IACxB,MAAMc,aAAY,GAAId,GAAG,CAAC,KAAK,CAAC;IAEhC,MAAMe,YAAW,GAAKC,CAAC,IAAK;MAC1BA,CAAC,CAACC,cAAc,EAAE;MAClBH,aAAa,CAACI,KAAI,GAAI,IAAI;IAC5B,CAAC;IAED,MAAMC,kBAAiB,GAAKH,CAAC,IAAK;MAChCA,CAAC,CAACC,cAAc,EAAE;MAClBD,CAAC,CAACI,eAAe,EAAE;MACnBN,aAAa,CAACI,KAAI,GAAI,KAAK;IAC7B,CAAC;IAED,MAAMG,YAAW,GAAKL,CAAC,IAAK;MAC1BA,CAAC,CAACC,cAAc,EAAE;MAClBD,CAAC,CAACI,eAAe,EAAE;MACnB,IAAIP,QAAQ,CAACK,KAAI,KAAM,EAAE,EAAE;QACzBN,MAAM,CAACM,KAAI,GAAI,CAAC,GAAGN,MAAM,CAACM,KAAK,EAAEL,QAAQ,CAACK,KAAK,CAAC;QAChDL,QAAQ,CAACK,KAAI,GAAI,EAAE;MACrB,OAAO;QACLI,KAAK,CAAC,wBAAwB,CAAC;MACjC;IACF,CAAC;IAED,MAAMC,aAAY,GAAKP,CAAC,IAAK;MAC3BH,QAAQ,CAACK,KAAI,GAAIF,CAAC,CAACQ,MAAM,CAACN,KAAK;IACjC,CAAC;IAED,OAAO;MACLN,MAAM;MACNC,QAAQ;MACRC,aAAa;MACbC,YAAY;MACZI,kBAAkB;MAClBE,YAAY;MACZE;IACF,CAAC;EACH;AACF,CAAC,CAAC;AAEF,eAAepB,WAAW"},"metadata":{},"sourceType":"module","externalDependencies":[]}