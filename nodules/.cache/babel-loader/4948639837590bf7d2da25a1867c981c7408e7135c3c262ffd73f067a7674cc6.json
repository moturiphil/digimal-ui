{"ast":null,"code":"import { computed, onMounted, ref, defineComponent } from 'vue';\nimport { useStore } from 'vuex';\nimport { SessionChartWrapper, SessionState } from '../../style';\nimport Chart from '../../../../components/utilities/chartjs';\nconst SessionsByDevice = defineComponent({\n  name: 'SessionsByDevice',\n  components: {\n    SessionChartWrapper,\n    SessionState,\n    Chart\n  },\n  setup() {\n    const store = useStore();\n    const deviceState = computed(() => store.state.chartContent.deviceData);\n    const dvIsLoading = computed(() => store.state.chartContent.dvLoading);\n    const device = ref('year');\n    onMounted(() => {\n      store.dispatch('deviceGetData');\n    });\n    const handleActiveChangeDevice = (event, value) => {\n      event.preventDefault();\n      device.value = value;\n      store.dispatch('deviceFilterData', value);\n    };\n    return {\n      deviceState,\n      dvIsLoading,\n      device,\n      handleActiveChangeDevice\n    };\n  }\n});\nexport default SessionsByDevice;","map":{"version":3,"names":["computed","onMounted","ref","defineComponent","useStore","SessionChartWrapper","SessionState","Chart","SessionsByDevice","name","components","setup","store","deviceState","state","chartContent","deviceData","dvIsLoading","dvLoading","device","dispatch","handleActiveChangeDevice","event","value","preventDefault"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/dashboard/overview/performance/SessionsByDevice.vue"],"sourcesContent":["<template>\r\n  <SessionChartWrapper>\r\n    <sdCards v-if=\"deviceState\" title=\"Sessions By Device\">\r\n      <template #button>\r\n        <div class=\"card-nav\">\r\n          <ul>\r\n            <li :class=\"device === 'week' ? 'active' : 'deactivate'\">\r\n              <router-link @click=\"(e) => handleActiveChangeDevice(e, 'week')\" to=\"#\"> Week </router-link>\r\n            </li>\r\n            <li :class=\"device === 'month' ? 'active' : 'deactivate'\">\r\n              <router-link @click=\"(e) => handleActiveChangeDevice(e, 'month')\" to=\"#\"> Month </router-link>\r\n            </li>\r\n            <li :class=\"device === 'year' ? 'active' : 'deactivate'\">\r\n              <router-link @click=\"(e) => handleActiveChangeDevice(e, 'year')\" to=\"#\"> Year </router-link>\r\n            </li>\r\n          </ul>\r\n        </div>\r\n      </template>\r\n\r\n      <div v-if=\"dvIsLoading\" class=\"sd-spin\">\r\n        <a-spin />\r\n      </div>\r\n\r\n      <div v-else class=\"session-chart-inner\">\r\n        <div :style=\"{ position: 'relative' }\">\r\n          <p>\r\n            <span>{{\r\n              [\r\n                {\r\n                  data: deviceState,\r\n                  backgroundColor: ['#20C997', '#5F63F2', '#FA8B0C'],\r\n                  total: '9,283',\r\n                },\r\n              ][0].data.reduce((a, b) => a + b, 0)\r\n            }}</span>\r\n            Total visitors\r\n          </p>\r\n          <Chart\r\n            class=\"device\"\r\n            type=\"doughnut\"\r\n            :labels=\"['Desktop', 'Mobiles', 'Tablets']\"\r\n            :datasets=\"[\r\n              {\r\n                data: deviceState,\r\n                backgroundColor: ['#20C997', '#5F63F2', '#FA8B0C'],\r\n                total: '9,283',\r\n              },\r\n            ]\"\r\n            :options=\"{\r\n              cutoutPercentage: 70,\r\n              maintainAspectRatio: true,\r\n              responsive: true,\r\n              legend: {\r\n                display: false,\r\n                position: 'bottom',\r\n              },\r\n              animation: {\r\n                animateScale: true,\r\n                animateRotate: true,\r\n              },\r\n            }\"\r\n          />\r\n        </div>\r\n        <SessionState class=\"session-wrap d-flex justify-content-center\">\r\n          <div class=\"session-single\">\r\n            <div class=\"chart-label\">\r\n              <span class=\"label-dot dot-success\" />\r\n              Desktop\r\n            </div>\r\n            <span>{{ deviceState[0] }}</span>\r\n            <sub>45%</sub>\r\n          </div>\r\n          <div class=\"session-single\">\r\n            <div class=\"chart-label\">\r\n              <span class=\"label-dot dot-info\" />\r\n              Mobile\r\n            </div>\r\n            <span>{{ deviceState[1] }}</span>\r\n            <sub>30%</sub>\r\n          </div>\r\n          <div class=\"session-single\">\r\n            <div class=\"chart-label\">\r\n              <span class=\"label-dot dot-warning\" />\r\n              Tablets\r\n            </div>\r\n            <span>{{ deviceState[1] }}</span>\r\n            <sub>25%</sub>\r\n          </div>\r\n        </SessionState>\r\n      </div>\r\n    </sdCards>\r\n  </SessionChartWrapper>\r\n</template>\r\n<script>\r\nimport { computed, onMounted, ref, defineComponent } from 'vue';\r\nimport { useStore } from 'vuex';\r\nimport { SessionChartWrapper, SessionState } from '../../style';\r\nimport Chart from '../../../../components/utilities/chartjs';\r\n\r\nconst SessionsByDevice = defineComponent({\r\n  name: 'SessionsByDevice',\r\n  components: { SessionChartWrapper, SessionState, Chart },\r\n  setup() {\r\n    const store = useStore();\r\n    const deviceState = computed(() => store.state.chartContent.deviceData);\r\n    const dvIsLoading = computed(() => store.state.chartContent.dvLoading);\r\n    const device = ref('year');\r\n\r\n    onMounted(() => {\r\n      store.dispatch('deviceGetData');\r\n    });\r\n\r\n    const handleActiveChangeDevice = (event, value) => {\r\n      event.preventDefault();\r\n\r\n      device.value = value;\r\n      store.dispatch('deviceFilterData', value);\r\n    };\r\n\r\n    return {\r\n      deviceState,\r\n      dvIsLoading,\r\n      device,\r\n      handleActiveChangeDevice,\r\n    };\r\n  },\r\n});\r\n\r\nexport default SessionsByDevice;\r\n</script>\r\n"],"mappings":"AA8FA,SAASA,QAAQ,EAAEC,SAAS,EAAEC,GAAG,EAAEC,eAAc,QAAS,KAAK;AAC/D,SAASC,QAAO,QAAS,MAAM;AAC/B,SAASC,mBAAmB,EAAEC,YAAW,QAAS,aAAa;AAC/D,OAAOC,KAAI,MAAO,0CAA0C;AAE5D,MAAMC,gBAAe,GAAIL,eAAe,CAAC;EACvCM,IAAI,EAAE,kBAAkB;EACxBC,UAAU,EAAE;IAAEL,mBAAmB;IAAEC,YAAY;IAAEC;EAAM,CAAC;EACxDI,KAAKA,CAAA,EAAG;IACN,MAAMC,KAAI,GAAIR,QAAQ,EAAE;IACxB,MAAMS,WAAU,GAAIb,QAAQ,CAAC,MAAMY,KAAK,CAACE,KAAK,CAACC,YAAY,CAACC,UAAU,CAAC;IACvE,MAAMC,WAAU,GAAIjB,QAAQ,CAAC,MAAMY,KAAK,CAACE,KAAK,CAACC,YAAY,CAACG,SAAS,CAAC;IACtE,MAAMC,MAAK,GAAIjB,GAAG,CAAC,MAAM,CAAC;IAE1BD,SAAS,CAAC,MAAM;MACdW,KAAK,CAACQ,QAAQ,CAAC,eAAe,CAAC;IACjC,CAAC,CAAC;IAEF,MAAMC,wBAAuB,GAAIA,CAACC,KAAK,EAAEC,KAAK,KAAK;MACjDD,KAAK,CAACE,cAAc,EAAE;MAEtBL,MAAM,CAACI,KAAI,GAAIA,KAAK;MACpBX,KAAK,CAACQ,QAAQ,CAAC,kBAAkB,EAAEG,KAAK,CAAC;IAC3C,CAAC;IAED,OAAO;MACLV,WAAW;MACXI,WAAW;MACXE,MAAM;MACNE;IACF,CAAC;EACH;AACF,CAAC,CAAC;AAEF,eAAeb,gBAAgB"},"metadata":{},"sourceType":"module","externalDependencies":[]}