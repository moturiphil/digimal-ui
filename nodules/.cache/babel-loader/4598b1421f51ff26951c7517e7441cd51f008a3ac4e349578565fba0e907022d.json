{"ast":null,"code":"import { Main } from '../styled';\nimport { GalleryNav } from './style';\nimport GalleryCards from './overview/GalleryCards';\nimport { computed, reactive, defineComponent } from 'vue';\nimport { useStore } from 'vuex';\nexport default defineComponent({\n  name: 'Gallery',\n  components: {\n    Main,\n    GalleryNav,\n    GalleryCards\n  },\n  setup() {\n    const state = reactive({\n      activeClass: ''\n    });\n    const store = useStore();\n    const gallery = computed(() => store.state.gallery.data);\n    const isLoading = computed(() => store.state.gallery.isLoading);\n    function handleChange(value) {\n      state.activeClass = value;\n      store.dispatch('galleryFilter', {\n        column: 'category',\n        value\n      });\n    }\n    return {\n      handleChange,\n      gallery,\n      isLoading,\n      state\n    };\n  }\n});","map":{"version":3,"names":["Main","GalleryNav","GalleryCards","computed","reactive","defineComponent","useStore","name","components","setup","state","activeClass","store","gallery","data","isLoading","handleChange","value","dispatch","column"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/pages/Gallery.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <sdPageHeader title=\"Gallery\">\r\n      <template v-slot:buttons>\r\n        <div class=\"page-header-actions\">\r\n          <sdCalendarButton />\r\n          <sdExportButton />\r\n          <sdShareButton />\r\n          <sdButton size=\"small\" type=\"primary\">\r\n            <sdFeatherIcons type=\"plus\" size=\"14\" />\r\n            Add New\r\n          </sdButton>\r\n        </div>\r\n      </template>\r\n    </sdPageHeader>\r\n    <Main>\r\n      <a-row :gutter=\"25\">\r\n        <a-col :sm=\"24\" :xs=\"24\">\r\n          <GalleryNav>\r\n            <ul>\r\n              <li>\r\n                <a :class=\"state.activeClass === '' ? 'active' : 'deactivate'\" @click=\"() => handleChange('')\" href=\"#\">\r\n                  All\r\n                </a>\r\n              </li>\r\n              <li>\r\n                <a\r\n                  :class=\"state.activeClass === 'webDesign' ? 'active' : 'deactivate'\"\r\n                  @click=\"() => handleChange('webDesign')\"\r\n                  href=\"#\"\r\n                >\r\n                  Web Design\r\n                </a>\r\n              </li>\r\n              <li>\r\n                <a\r\n                  :class=\"state.activeClass === 'uiDesign' ? 'active' : 'deactivate'\"\r\n                  @click=\"() => handleChange('uiDesign')\"\r\n                  href=\"#\"\r\n                >\r\n                  UI Design\r\n                </a>\r\n              </li>\r\n              <li>\r\n                <a\r\n                  :class=\"state.activeClass === 'wireframe' ? 'active' : 'deactivate'\"\r\n                  @click=\"() => handleChange('wireframe')\"\r\n                  href=\"#\"\r\n                >\r\n                  Wireframe\r\n                </a>\r\n              </li>\r\n              <li>\r\n                <a\r\n                  :class=\"state.activeClass === 'Presentation' ? 'active' : 'deactivate'\"\r\n                  @click=\"() => handleChange('Presentation')\"\r\n                  href=\"#\"\r\n                >\r\n                  Presentation\r\n                </a>\r\n              </li>\r\n            </ul>\r\n          </GalleryNav>\r\n        </a-col>\r\n        <a-col v-if=\"isLoading\" :xs=\"24\">\r\n          <div class=\"spin\">\r\n            <a-spin />\r\n          </div>\r\n        </a-col>\r\n        <a-col v-else v-for=\"(item, index) in gallery\" :key=\"index + 1\" :xxl=\"6\" :lg=\"8\" :sm=\"12\" :xs=\"24\">\r\n          <GalleryCards :item=\"item\" :index=\"index\" />\r\n        </a-col>\r\n      </a-row>\r\n    </Main>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { Main } from '../styled';\r\nimport { GalleryNav } from './style';\r\nimport GalleryCards from './overview/GalleryCards';\r\nimport { computed, reactive, defineComponent } from 'vue';\r\nimport { useStore } from 'vuex';\r\n\r\nexport default defineComponent({\r\n  name: 'Gallery',\r\n  components: {\r\n    Main,\r\n    GalleryNav,\r\n    GalleryCards,\r\n  },\r\n  setup() {\r\n    const state = reactive({\r\n      activeClass: '',\r\n    });\r\n\r\n    const store = useStore();\r\n    const gallery = computed(() => store.state.gallery.data);\r\n    const isLoading = computed(() => store.state.gallery.isLoading);\r\n\r\n    function handleChange(value) {\r\n      state.activeClass = value;\r\n      store.dispatch('galleryFilter', {\r\n        column: 'category',\r\n        value,\r\n      });\r\n    }\r\n\r\n    return {\r\n      handleChange,\r\n      gallery,\r\n      isLoading,\r\n      state,\r\n    };\r\n  },\r\n});\r\n</script>\r\n"],"mappings":"AA8EA,SAASA,IAAG,QAAS,WAAW;AAChC,SAASC,UAAS,QAAS,SAAS;AACpC,OAAOC,YAAW,MAAO,yBAAyB;AAClD,SAASC,QAAQ,EAAEC,QAAQ,EAAEC,eAAc,QAAS,KAAK;AACzD,SAASC,QAAO,QAAS,MAAM;AAE/B,eAAeD,eAAe,CAAC;EAC7BE,IAAI,EAAE,SAAS;EACfC,UAAU,EAAE;IACVR,IAAI;IACJC,UAAU;IACVC;EACF,CAAC;EACDO,KAAKA,CAAA,EAAG;IACN,MAAMC,KAAI,GAAIN,QAAQ,CAAC;MACrBO,WAAW,EAAE;IACf,CAAC,CAAC;IAEF,MAAMC,KAAI,GAAIN,QAAQ,EAAE;IACxB,MAAMO,OAAM,GAAIV,QAAQ,CAAC,MAAMS,KAAK,CAACF,KAAK,CAACG,OAAO,CAACC,IAAI,CAAC;IACxD,MAAMC,SAAQ,GAAIZ,QAAQ,CAAC,MAAMS,KAAK,CAACF,KAAK,CAACG,OAAO,CAACE,SAAS,CAAC;IAE/D,SAASC,YAAYA,CAACC,KAAK,EAAE;MAC3BP,KAAK,CAACC,WAAU,GAAIM,KAAK;MACzBL,KAAK,CAACM,QAAQ,CAAC,eAAe,EAAE;QAC9BC,MAAM,EAAE,UAAU;QAClBF;MACF,CAAC,CAAC;IACJ;IAEA,OAAO;MACLD,YAAY;MACZH,OAAO;MACPE,SAAS;MACTL;IACF,CAAC;EACH;AACF,CAAC,CAAC"},"metadata":{},"sourceType":"module","externalDependencies":[]}