{"ast":null,"code":"import { computed, onMounted, ref, watchEffect, defineComponent } from 'vue';\nimport { useStore } from 'vuex';\nimport { RevenueChartWrapper } from '../../style';\nimport Chartjs from '../../../../components/utilities/chartjs';\nconst RevenueByDevice = defineComponent({\n  name: 'RevenueByDevice',\n  components: {\n    RevenueChartWrapper,\n    Chartjs\n  },\n  setup() {\n    const {\n      state,\n      dispatch\n    } = useStore();\n    const device = ref('year');\n    const labels = ref(['Desktop', 'Mobile', 'Tablets']);\n    const deviceState = computed(() => state.chartContent.deviceData);\n    const dvIsLoading = computed(() => state.chartContent.dvLoading);\n    const datasets = ref([]);\n    const handleActiveChangeDevice = (event, value) => {\n      event.preventDefault();\n      device.value = value;\n      dispatch('deviceFilterData', value);\n    };\n    onMounted(() => {\n      dispatch('deviceGetData');\n      datasets.value = [{\n        data: deviceState.value,\n        backgroundColor: ['#20C997', '#5F63F2', '#FA8B0C']\n      }];\n    });\n    watchEffect(() => {\n      datasets.value = [{\n        data: deviceState.value,\n        backgroundColor: ['#20C997', '#5F63F2', '#FA8B0C']\n      }];\n    });\n    return {\n      deviceState,\n      dvIsLoading,\n      device,\n      handleActiveChangeDevice,\n      labels,\n      datasets\n    };\n  }\n});\nexport default RevenueByDevice;","map":{"version":3,"names":["computed","onMounted","ref","watchEffect","defineComponent","useStore","RevenueChartWrapper","Chartjs","RevenueByDevice","name","components","setup","state","dispatch","device","labels","deviceState","chartContent","deviceData","dvIsLoading","dvLoading","datasets","handleActiveChangeDevice","event","value","preventDefault","data","backgroundColor"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/dashboard/overview/ecommerce/RevenueByDevice.vue"],"sourcesContent":["<template>\r\n  <RevenueChartWrapper>\r\n    <sdCards v-if=\"deviceState\" title=\"Revenue By Device\">\r\n      <template #button>\r\n        <div class=\"card-nav\">\r\n          <ul>\r\n            <li :class=\"device === 'today' ? 'active' : 'deactivate'\">\r\n              <router-link @click=\"(e) => handleActiveChangeDevice(e, 'today')\" to=\"#\"> Today </router-link>\r\n            </li>\r\n            <li :class=\"device === 'week' ? 'active' : 'deactivate'\">\r\n              <router-link @click=\"(e) => handleActiveChangeDevice(e, 'week')\" to=\"#\"> Week </router-link>\r\n            </li>\r\n            <li :class=\"device === 'month' ? 'active' : 'deactivate'\">\r\n              <router-link @click=\"(e) => handleActiveChangeDevice(e, 'month')\" to=\"#\"> Month </router-link>\r\n            </li>\r\n            <li :class=\"device === 'year' ? 'active' : 'deactivate'\">\r\n              <router-link @click=\"(e) => handleActiveChangeDevice(e, 'year')\" to=\"#\"> Year </router-link>\r\n            </li>\r\n          </ul>\r\n        </div>\r\n      </template>\r\n\r\n      <div v-if=\"dvIsLoading\" class=\"sd-spin\">\r\n        <a-spin />\r\n      </div>\r\n\r\n      <div v-else class=\"revenue-doughnut\">\r\n        <div>\r\n          <Chartjs\r\n            type=\"doughnut\"\r\n            class=\"revenue\"\r\n            :height=\"220\"\r\n            :style=\"{\r\n              marginBottom: '0',\r\n            }\"\r\n            :options=\"{\r\n              cutoutPercentage: 60,\r\n              maintainAspectRatio: false,\r\n              responsive: false,\r\n              legend: {\r\n                display: false,\r\n                position: 'bottom',\r\n              },\r\n              animation: {\r\n                animateScale: true,\r\n                animateRotate: true,\r\n              },\r\n            }\"\r\n            :labels=\"labels\"\r\n            :datasets=\"datasets\"\r\n          />\r\n          <div class=\"align-center-v justify-content-between rd-labels\">\r\n            <div class=\"revenue-chat-label\">\r\n              <div v-for=\"(label, key) in labels\" :key=\"key + 1\" class=\"chart-label\">\r\n                <span :class=\"`label-dot dot-${label}`\" />\r\n                {{ label }}\r\n              </div>\r\n            </div>\r\n            <div class=\"revenue-chart-data\">\r\n              <div v-for=\"(item, key) in datasets\" :key=\"key + 1\">\r\n                <p v-for=\"value in item.data\" :key=\"value\">\r\n                  <strong>${{ value }}</strong>\r\n                </p>\r\n              </div>\r\n            </div>\r\n            <div class=\"revenue-chat-percentage\">\r\n              <span>45%</span>\r\n              <span>45%</span>\r\n              <span>45%</span>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </sdCards>\r\n  </RevenueChartWrapper>\r\n</template>\r\n<script>\r\nimport { computed, onMounted, ref, watchEffect, defineComponent } from 'vue';\r\nimport { useStore } from 'vuex';\r\nimport { RevenueChartWrapper } from '../../style';\r\nimport Chartjs from '../../../../components/utilities/chartjs';\r\n\r\nconst RevenueByDevice = defineComponent({\r\n  name: 'RevenueByDevice',\r\n  components: { RevenueChartWrapper, Chartjs },\r\n  setup() {\r\n    const { state, dispatch } = useStore();\r\n    const device = ref('year');\r\n    const labels = ref(['Desktop', 'Mobile', 'Tablets']);\r\n\r\n    const deviceState = computed(() => state.chartContent.deviceData);\r\n    const dvIsLoading = computed(() => state.chartContent.dvLoading);\r\n    const datasets = ref([]);\r\n\r\n    const handleActiveChangeDevice = (event, value) => {\r\n      event.preventDefault();\r\n      device.value = value;\r\n      dispatch('deviceFilterData', value);\r\n    };\r\n\r\n    onMounted(() => {\r\n      dispatch('deviceGetData');\r\n      datasets.value = [\r\n        {\r\n          data: deviceState.value,\r\n          backgroundColor: ['#20C997', '#5F63F2', '#FA8B0C'],\r\n        },\r\n      ];\r\n    });\r\n\r\n    watchEffect(() => {\r\n      datasets.value = [\r\n        {\r\n          data: deviceState.value,\r\n          backgroundColor: ['#20C997', '#5F63F2', '#FA8B0C'],\r\n        },\r\n      ];\r\n    });\r\n\r\n    return {\r\n      deviceState,\r\n      dvIsLoading,\r\n      device,\r\n      handleActiveChangeDevice,\r\n      labels,\r\n      datasets,\r\n    };\r\n  },\r\n});\r\n\r\nexport default RevenueByDevice;\r\n</script>\r\n"],"mappings":"AA6EA,SAASA,QAAQ,EAAEC,SAAS,EAAEC,GAAG,EAAEC,WAAW,EAAEC,eAAc,QAAS,KAAK;AAC5E,SAASC,QAAO,QAAS,MAAM;AAC/B,SAASC,mBAAkB,QAAS,aAAa;AACjD,OAAOC,OAAM,MAAO,0CAA0C;AAE9D,MAAMC,eAAc,GAAIJ,eAAe,CAAC;EACtCK,IAAI,EAAE,iBAAiB;EACvBC,UAAU,EAAE;IAAEJ,mBAAmB;IAAEC;EAAQ,CAAC;EAC5CI,KAAKA,CAAA,EAAG;IACN,MAAM;MAAEC,KAAK;MAAEC;IAAS,IAAIR,QAAQ,EAAE;IACtC,MAAMS,MAAK,GAAIZ,GAAG,CAAC,MAAM,CAAC;IAC1B,MAAMa,MAAK,GAAIb,GAAG,CAAC,CAAC,SAAS,EAAE,QAAQ,EAAE,SAAS,CAAC,CAAC;IAEpD,MAAMc,WAAU,GAAIhB,QAAQ,CAAC,MAAMY,KAAK,CAACK,YAAY,CAACC,UAAU,CAAC;IACjE,MAAMC,WAAU,GAAInB,QAAQ,CAAC,MAAMY,KAAK,CAACK,YAAY,CAACG,SAAS,CAAC;IAChE,MAAMC,QAAO,GAAInB,GAAG,CAAC,EAAE,CAAC;IAExB,MAAMoB,wBAAuB,GAAIA,CAACC,KAAK,EAAEC,KAAK,KAAK;MACjDD,KAAK,CAACE,cAAc,EAAE;MACtBX,MAAM,CAACU,KAAI,GAAIA,KAAK;MACpBX,QAAQ,CAAC,kBAAkB,EAAEW,KAAK,CAAC;IACrC,CAAC;IAEDvB,SAAS,CAAC,MAAM;MACdY,QAAQ,CAAC,eAAe,CAAC;MACzBQ,QAAQ,CAACG,KAAI,GAAI,CACf;QACEE,IAAI,EAAEV,WAAW,CAACQ,KAAK;QACvBG,eAAe,EAAE,CAAC,SAAS,EAAE,SAAS,EAAE,SAAS;MACnD,CAAC,CACF;IACH,CAAC,CAAC;IAEFxB,WAAW,CAAC,MAAM;MAChBkB,QAAQ,CAACG,KAAI,GAAI,CACf;QACEE,IAAI,EAAEV,WAAW,CAACQ,KAAK;QACvBG,eAAe,EAAE,CAAC,SAAS,EAAE,SAAS,EAAE,SAAS;MACnD,CAAC,CACF;IACH,CAAC,CAAC;IAEF,OAAO;MACLX,WAAW;MACXG,WAAW;MACXL,MAAM;MACNQ,wBAAwB;MACxBP,MAAM;MACNM;IACF,CAAC;EACH;AACF,CAAC,CAAC;AAEF,eAAeb,eAAe"},"metadata":{},"sourceType":"module","externalDependencies":[]}