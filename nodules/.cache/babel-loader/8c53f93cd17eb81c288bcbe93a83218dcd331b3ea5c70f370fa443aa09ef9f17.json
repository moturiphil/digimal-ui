n-left' : 'align-right'\" />\r\n          </sdButton>\r\n\r\n          <div v-if=\"responsive > 991\" class=\"sidebar-card\">\r\n            <sdCards headless>\r\n              <div class=\"note-sidebar-top\">\r\n                <sdButton\r\n                  @click=\"showModal\"\r\n                  shape=\"round\"\r\n                  type=\"primary\"\r\n                  size=\"default\"\r\n                  block\r\n                >\r\n                  <sdFeatherIcons type=\"plus\" size=\"18\" /> Add Notes\r\n                </sdButton>\r\n              </div>\r\n\r\n              <div class=\"note-sidebar-bottom\">\r\n                <NoteNav>\r\n                  <ul>\r\n                    <li>\r\n                      <router-link :to=\"`${path}/all`\">\r\n                        <sdFeatherIcons type=\"edit\" size=\"18\" />\r\n                        <span class=\"nav-text\">\r\n                          <span>All</span>\r\n                        </span>\r\n                      </router-link>\r\n                    </li>\r\n                    <li>\r\n                      <router-link :to=\"`${path}/favorite`\">\r\n                        <sdFeatherIcons type=\"star\" size=\"18\" />\r\n                        <span class=\"nav-text\">\r\n                          <span>Favorites</span>\r\n                        </span>\r\n                      </router-link>\r\n                    </li>\r\n                  </ul>\r\n                  <div class=\"nav-labels\">\r\n                    <p>\r\n                      <img\r\n                        :src=\"require('@/static/img/icon/label.png')\"\r\n                        alt=\"icon\"\r\n                      />\r\n                      Labels\r\n                    </p>\r\n                    <ul>\r\n                      <li>\r\n                        <router-link :to=\"`${path}/personal`\">\r\n                          <Bullet class=\"personal\" /> Personal\r\n                        </router-link>\r\n                      </li>\r\n                      <li>\r\n                        <router-link :to=\"`${path}/work`\">\r\n                          <Bullet class=\"work\" /> Work\r\n                        </router-link>\r\n                      </li>\r\n                      <li>\r\n                        <router-link :to=\"`${path}/social`\">\r\n                          <Bullet class=\"social\" /> Social\r\n                        </router-link>\r\n                      </li>\r\n                      <li>\r\n                        <router-link :to=\"`${path}/important`\">\r\n                          <Bullet class=\"important\" /> Important\r\n                        </router-link>\r\n                      </li>\r\n                    </ul>\r\n                  </div>\r\n                </NoteNav>\r\n              </div>\r\n            </sdCards>\r\n          </div>\r\n\r\n          <div\r\n            v-else\r\n            :class=\"\r\n              collapsed\r\n                ? 'sidebar-card note-sideabr show'\r\n                : 'sidebar-card note-sideabr hide'\r\n            \"\r\n          >\r\n            <sdCards headless>\r\n              <sdButton\r\n                type=\"link\"\r\n                class=\"mail-sidebar-trigger trigger-close\"\r\n                :style=\"{ marginTop: 0 }\"\r\n                @click=\"toggleCollapsed\"\r\n              >\r\n                <sdFeatherIcons type=\"x\" />\r\n              </sdButton>\r\n              <div class=\"note-sidebar-top\">\r\n                <sdButton\r\n                  @click=\"showModal\"\r\n                  shape=\"round\"\r\n                  type=\"primary\"\r\n                  size=\"default\"\r\n                  block\r\n                >\r\n                  <sdFeatherIcons type=\"plus\" size=\"18\" /> Add Notes\r\n                </sdButton>\r\n              </div>\r\n\r\n              <div class=\"note-sidebar-bottom\">\r\n                <NoteNav>\r\n                  <ul>\r\n                    <li>\r\n                      <router-link :to=\"`${path}/all`\" @click=\"collapseSidebar\">\r\n                        <sdFeatherIcons type=\"edit\" size=\"18\" />\r\n                        <span class=\"nav-text\">\r\n                          <span>All</span>\r\n                        </span>\r\n                      </router-link>\r\n                    </li>\r\n                    <li>\r\n                      <router-link\r\n                        :to=\"`${path}/favorite`\"\r\n                        @click=\"collapseSidebar\"\r\n                      >\r\n                        <sdFeatherIcons type=\"star\" size=\"18\" />\r\n                        <span class=\"nav-text\">\r\n                          <span>Favorites</span>\r\n                        </span>\r\n                      </router-link>\r\n                    </li>\r\n                  </ul>\r\n                  <div class=\"nav-labels\">\r\n                    <p>\r\n                      <img\r\n                        :src=\"require('@/static/img/icon/label.png')\"\r\n                        alt=\"icon\"\r\n                      />\r\n                      Labels\r\n                    </p>\r\n                    <ul>\r\n                      <li>\r\n                        <router-link\r\n                          :to=\"`${path}/personal`\"\r\n                          @click=\"collapseSidebar\"\r\n                        >\r\n                          <Bullet class=\"personal\" /> Personal\r\n                        </router-link>\r\n                      </li>\r\n                      <li>\r\n                        <router-link\r\n                          :to=\"`${path}/work`\"\r\n                          @click=\"collapseSidebar\"\r\n                        >\r\n                          <Bullet class=\"work\" /> Work\r\n                        </router-link>\r\n                      </li>\r\n                      <li>\r\n                        <router-link\r\n                          :to=\"`${path}/social`\"\r\n                          @click=\"collapseSidebar\"\r\n                        >\r\n                          <Bullet class=\"social\" /> Social\r\n                        </router-link>\r\n                      </li>\r\n                      <li>\r\n                        <router-link\r\n                          :to=\"`${path}/important`\"\r\n                          @click=\"collapseSidebar\"\r\n                        >\r\n                          <Bullet class=\"important\" /> Important\r\n                        </router-link>\r\n                      </li>\r\n                    </ul>\r\n                  </div>\r\n                </NoteNav>\r\n              </div>\r\n            </sdCards>\r\n          </div>\r\n        </a-col>\r\n        <a-col :xxl=\"19\" :xl=\"17\" :lg=\"15\" :xs=\"24\">\r\n          <router-view name=\"child\"></router-view>\r\n        </a-col>\r\n      </a-row>\r\n    </NoteWrapper>\r\n    <a-modal\r\n      :type=\"modalType\"\r\n      :title=\"null\"\r\n      :visible=\"visible\"\r\n      :footer=\"null\"\r\n      :onCancel=\"handleCancel\"\r\n    >\r\n      <div class=\"project-modal\">\r\n        <BasicFormWrapper>\r\n          <a-form\r\n            name=\"createProject\"\r\n            :model=\"formState\"\r\n            @finish=\"handleOk\"\r\n            :layout=\"formState.layout\"\r\n          >\r\n            <a-form-item name=\"title\" label=\"Title\">\r\n              <a-input\r\n                v-model:value=\"formState.title\"\r\n                placeholder=\"Note Title\"\r\n              />\r\n            </a-form-item>\r\n\r\n            <a-form-item name=\"description\" label=\"Description\">\r\n              <a-textarea\r\n                v-model:value=\"formState.description\"\r\n                :rows=\"4\"\r\n                placeholder=\"Note Description\"\r\n              />\r\n            </a-form-item>\r\n            <a-form-item name=\"label\" label=\"Note Label\">\r\n              <a-select v-model:value=\"formState.label\" style=\"width: 100%\">\r\n                <a-select-option value=\"personal\">Personal</a-select-option>\r\n                <a-select-option value=\"work\">Work</a-select-option>\r\n                <a-select-option value=\"social\">Social</a-select-option>\r\n                <a-select-option value=\"important\">Important</a-select-option>\r\n              </a-select>\r\n            </a-form-item>\r\n            <sdButton\r\n              htmlType=\"submit\"\r\n              size=\"default\"\r\n              type=\"primary\"\r\n              key=\"submit\"\r\n            >\r\n              Add New Note\r\n            </sdButton>\r\n          </a-form>\r\n        </BasicFormWrapper>\r\n      </div>\r\n    </a-modal>\r\n  </Main>\r\n</template>\r\n<script>\r\nimport { NoteNav, NoteWrapper, Bullet } from \"./style\";\r\nimport { BasicFormWrapper, Main } from \"../../styled\";\r\nimport { useStore } from \"vuex\";\r\nimport { computed, onMounted, reactive, ref, defineComponent } from \"vue\";\r\nimport { useRoute } from \"vue-router\";\r\n\r\nconst Note = defineComponent({\r\n  name: \"Note\",\r\n  components: { NoteNav, NoteWrapper, Bullet, BasicFormWrapper, Main },\r\n  setup() {\r\n    const { state, dispatch } = useStore();\r\n    const noteData = computed(() => state.note.data);\r\n    const { matched } = useRoute();\r\n    const { path } = matched[1];\r\n\r\n    const visible = ref(false);\r\n    const modalType = ref(\"primary\");\r\n    const checked = ref([]);\r\n    const responsive = ref(0);\r\n    const collapsed = ref(false);\r\n\r\n    const formState = reactive({\r\n      title: \"\",\r\n      description: \"\",\r\n      label: \"personal\",\r\n      layout: \"vertical\",\r\n    });\r\n\r\n    onMounted(() => {\r\n      function updateSize() {\r\n        const width = window.innerWidth;\r\n        responsive.value = width;\r\n      }\r\n      window.addEventListener(\"resize\", updateSize);\r\n      updateSize();\r\n      // return () => window.removeEventListener('resize', updateSize);\r\n    });\r\n\r\n    const showModal = () => {\r\n      visible.value = true;\r\n    };\r\n\r\n    const onCancel = () => {\r\n      visible.value = false;\r\n    };\r\n\r\n    const handleOk = (values) => {\r\n      onCancel();\r\n      const arrayData = [];\r\n      noteData.value.map((data) => {\r\n        return arrayData.push(data.key);\r\n      });\r\n      const max = Math.max(...arrayData);\r\n      dispatch(\"noteAddData\", [\r\n        ...noteData.value,\r\n        {\r\n          ...values,\r\n          key: max + 1,\r\n          time: new Date().getTime(),\r\n          stared: false,\r\n        },\r\n      ]);\r\n    };\r\n\r\n    const handleCancel = () => {\r\n      onCancel();\r\n    };\r\n\r\n    const toggleCollapsed = () => {\r\n      collapsed.value = !collapsed.value;\r\n    };\r\n\r\n    const collapseSidebar = () => {\r\n      collapsed.value = false;\r\n    };\r\n\r\n    return {\r\n      collapseSidebar,\r\n      toggleCollapsed,\r\n      handleCancel,\r\n      handleOk,\r\n      showModal,\r\n      path,\r\n      modalType,\r\n      checked,\r\n      responsive,\r\n      collapsed,\r\n      visible,\r\n      formState,\r\n    };\r\n  },\r\n});\r\n\r\nexport default Note;\r\n</script>\r\n"],"mappings":";AAgQA,SAASA,OAAO,EAAEC,WAAW,EAAEC,MAAK,QAAS,SAAS;AACtD,SAASC,gBAAgB,EAAEC,IAAG,QAAS,cAAc;AACrD,SAASC,QAAO,QAAS,MAAM;AAC/B,SAASC,QAAQ,EAAEC,SAAS,EAAEC,QAAQ,EAAEC,GAAG,EAAEC,eAAc,QAAS,KAAK;AACzE,SAASC,QAAO,QAAS,YAAY;AAErC,MAAMC,IAAG,GAAIF,eAAe,CAAC;EAC3BG,IAAI,EAAE,MAAM;EACZC,UAAU,EAAE;IAAEd,OAAO;IAAEC,WAAW;IAAEC,MAAM;IAAEC,gBAAgB;IAAEC;EAAK,CAAC;EACpEW,KAAKA,CAAA,EAAG;IACN,MAAM;MAAEC,KAAK;MAAEC;IAAS,IAAIZ,QAAQ,EAAE;IACtC,MAAMa,QAAO,GAAIZ,QAAQ,CAAC,MAAMU,KAAK,CAACG,IAAI,CAACC,IAAI,CAAC;IAChD,MAAM;MAAEC;IAAQ,IAAIV,QAAQ,EAAE;IAC9B,MAAM;MAAEW;IAAK,IAAID,OAAO,CAAC,CAAC,CAAC;IAE3B,MAAME,OAAM,GAAId,GAAG,CAAC,KAAK,CAAC;IAC1B,MAAMe,SAAQ,GAAIf,GAAG,CAAC,S