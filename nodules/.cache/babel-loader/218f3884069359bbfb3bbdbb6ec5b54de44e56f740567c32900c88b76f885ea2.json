{"ast":null,"code":"import { computed, onMounted, ref, defineComponent } from 'vue';\nimport { useStore } from 'vuex';\nconst sellingColumns = [{\n  title: 'Product Name',\n  dataIndex: 'name',\n  key: 'name'\n}, {\n  title: 'Price',\n  dataIndex: 'price',\n  key: 'price'\n}, {\n  title: 'Sold',\n  dataIndex: 'sold',\n  key: 'sold'\n}, {\n  title: 'Revenue',\n  dataIndex: 'revenue',\n  key: 'revenue'\n}];\nconst TopSellingProduct = defineComponent({\n  name: 'TopSellingProduct',\n  components: {},\n  setup() {\n    const {\n      state,\n      dispatch\n    } = useStore();\n    const topSaleState = computed(() => state.chartContent.topSaleData);\n    const products = ref('year');\n    const handleActiveChangeProducts = (event, value) => {\n      event.preventDefault();\n      products.value = value;\n      dispatch('topSaleFilterData', value);\n    };\n    const sellingData = computed(() => topSaleState.value ? topSaleState.value.map(value => {\n      const {\n        key,\n        name,\n        price,\n        sold,\n        revenue\n      } = value;\n      return {\n        key,\n        name,\n        price,\n        sold,\n        revenue\n      };\n    }) : []);\n    onMounted(() => dispatch('topSaleGetData'));\n    return {\n      topSaleState,\n      handleActiveChangeProducts,\n      sellingColumns,\n      sellingData,\n      products\n    };\n  }\n});\nexport default TopSellingProduct;","map":{"version":3,"names":["computed","onMounted","ref","defineComponent","useStore","sellingColumns","title","dataIndex","key","TopSellingProduct","name","components","setup","state","dispatch","topSaleState","chartContent","topSaleData","products","handleActiveChangeProducts","event","value","preventDefault","sellingData","map","price","sold","revenue"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/dashboard/overview/ecommerce/TopSellingProduct.vue"],"sourcesContent":["<template>\r\n  <div class=\"full-width-table\">\r\n    <sdCards title=\"Top Selling Products\" bodypadding=\"0px\">\r\n      <template #button>\r\n        <div class=\"card-nav\">\r\n          <ul>\r\n            <li :class=\"products === 'today' ? 'active' : 'deactivate'\">\r\n              <router-link @click=\"(e) => handleActiveChangeProducts(e, 'today')\" to=\"#\"> Today </router-link>\r\n            </li>\r\n            <li :class=\"products === 'week' ? 'active' : 'deactivate'\">\r\n              <router-link @click=\"(e) => handleActiveChangeProducts(e, 'week')\" to=\"#\"> Week </router-link>\r\n            </li>\r\n            <li :class=\"products === 'month' ? 'active' : 'deactivate'\">\r\n              <router-link @click=\"(e) => handleActiveChangeProducts(e, 'month')\" to=\"#\"> Month </router-link>\r\n            </li>\r\n            <li :class=\"products === 'year' ? 'active' : 'deactivate'\">\r\n              <router-link @click=\"(e) => handleActiveChangeProducts(e, 'year')\" to=\"#\"> Year </router-link>\r\n            </li>\r\n          </ul>\r\n        </div>\r\n      </template>\r\n      <div class=\"table-bordered top-seller-table table-responsive\">\r\n        <a-table :columns=\"sellingColumns\" :dataSource=\"sellingData\" :pagination=\"false\" />\r\n      </div>\r\n    </sdCards>\r\n  </div>\r\n</template>\r\n<script>\r\nimport { computed, onMounted, ref, defineComponent } from 'vue';\r\nimport { useStore } from 'vuex';\r\n\r\nconst sellingColumns = [\r\n  {\r\n    title: 'Product Name',\r\n    dataIndex: 'name',\r\n    key: 'name',\r\n  },\r\n  {\r\n    title: 'Price',\r\n    dataIndex: 'price',\r\n    key: 'price',\r\n  },\r\n  {\r\n    title: 'Sold',\r\n    dataIndex: 'sold',\r\n    key: 'sold',\r\n  },\r\n  {\r\n    title: 'Revenue',\r\n    dataIndex: 'revenue',\r\n    key: 'revenue',\r\n  },\r\n];\r\n\r\nconst TopSellingProduct = defineComponent({\r\n  name: 'TopSellingProduct',\r\n  components: {},\r\n  setup() {\r\n    const { state, dispatch } = useStore();\r\n    const topSaleState = computed(() => state.chartContent.topSaleData);\r\n    const products = ref('year');\r\n\r\n    const handleActiveChangeProducts = (event, value) => {\r\n      event.preventDefault();\r\n      products.value = value;\r\n      dispatch('topSaleFilterData', value);\r\n    };\r\n\r\n    const sellingData = computed(() =>\r\n      topSaleState.value\r\n        ? topSaleState.value.map((value) => {\r\n            const { key, name, price, sold, revenue } = value;\r\n            return {\r\n              key,\r\n              name,\r\n              price,\r\n              sold,\r\n              revenue,\r\n            };\r\n          })\r\n        : [],\r\n    );\r\n\r\n    onMounted(() => dispatch('topSaleGetData'));\r\n\r\n    return {\r\n      topSaleState,\r\n      handleActiveChangeProducts,\r\n      sellingColumns,\r\n      sellingData,\r\n      products,\r\n    };\r\n  },\r\n});\r\n\r\nexport default TopSellingProduct;\r\n</script>\r\n"],"mappings":"AA4BA,SAASA,QAAQ,EAAEC,SAAS,EAAEC,GAAG,EAAEC,eAAc,QAAS,KAAK;AAC/D,SAASC,QAAO,QAAS,MAAM;AAE/B,MAAMC,cAAa,GAAI,CACrB;EACEC,KAAK,EAAE,cAAc;EACrBC,SAAS,EAAE,MAAM;EACjBC,GAAG,EAAE;AACP,CAAC,EACD;EACEF,KAAK,EAAE,OAAO;EACdC,SAAS,EAAE,OAAO;EAClBC,GAAG,EAAE;AACP,CAAC,EACD;EACEF,KAAK,EAAE,MAAM;EACbC,SAAS,EAAE,MAAM;EACjBC,GAAG,EAAE;AACP,CAAC,EACD;EACEF,KAAK,EAAE,SAAS;EAChBC,SAAS,EAAE,SAAS;EACpBC,GAAG,EAAE;AACP,CAAC,CACF;AAED,MAAMC,iBAAgB,GAAIN,eAAe,CAAC;EACxCO,IAAI,EAAE,mBAAmB;EACzBC,UAAU,EAAE,CAAC,CAAC;EACdC,KAAKA,CAAA,EAAG;IACN,MAAM;MAAEC,KAAK;MAAEC;IAAS,IAAIV,QAAQ,EAAE;IACtC,MAAMW,YAAW,GAAIf,QAAQ,CAAC,MAAMa,KAAK,CAACG,YAAY,CAACC,WAAW,CAAC;IACnE,MAAMC,QAAO,GAAIhB,GAAG,CAAC,MAAM,CAAC;IAE5B,MAAMiB,0BAAyB,GAAIA,CAACC,KAAK,EAAEC,KAAK,KAAK;MACnDD,KAAK,CAACE,cAAc,EAAE;MACtBJ,QAAQ,CAACG,KAAI,GAAIA,KAAK;MACtBP,QAAQ,CAAC,mBAAmB,EAAEO,KAAK,CAAC;IACtC,CAAC;IAED,MAAME,WAAU,GAAIvB,QAAQ,CAAC,MAC3Be,YAAY,CAACM,KAAI,GACbN,YAAY,CAACM,KAAK,CAACG,GAAG,CAAEH,KAAK,IAAK;MAChC,MAAM;QAAEb,GAAG;QAAEE,IAAI;QAAEe,KAAK;QAAEC,IAAI;QAAEC;MAAQ,IAAIN,KAAK;MACjD,OAAO;QACLb,GAAG;QACHE,IAAI;QAC