{"ast":null,"code":"import { UserTableStyleWrapper } from \"../style\";\nimport { TableWrapper } from \"../../../styled\";\nimport { computed, defineComponent, onMounted, ref } from \"vue\";\nimport { useRoute } from \"vue-router\";\nimport authHeader from \"../../../../../src/services/auth-header\";\nimport axios from \"axios\";\nimport { useStore } from \"vuex\";\nconst columns = [{\n  title: \"Participant Name\",\n  dataIndex: \"fullName\",\n  key: \"id\"\n  // render: (text, record) => `${record.first_name} ${record.last_name}`,\n}, {\n  title: \"Participant Phone\",\n  dataIndex: \"phone_no\",\n  key: \"id\"\n}, {\n  title: \"Organization\",\n  dataIndex: \"org_types_id\",\n  key: \"id\"\n}, {\n  title: \"Role\",\n  dataIndex: \"role_id\",\n  key: \"id\"\n}];\nconst EventCampaignTable = defineComponent({\n  name: \"EventCampaignTable\",\n  components: {\n    UserTableStyleWrapper,\n    TableWrapper\n  },\n  setup() {\n    const {\n      state\n    } = useStore();\n    const eventData = computed(() => state.crud.data);\n    const dataSource = ref([]);\n    const selectedRowKeys = ref([]);\n    const API_URL = `${process.env.VUE_APP_BASE_URL}`;\n    const {\n      query\n    } = useRoute();\n    console.log(query.id);\n    onMounted(async () => {\n      try {\n        const response = await axios.get(`${API_URL}/events/${query.id}/participants?status=0`, {\n          headers: authHeader()\n        });\n        console.log(response.data.data);\n        const updatedData = response.data.data.map(record => {\n          let fullName = `${record.first_name} ${record.last_name}`;\n          // fullName = fullName.toUpperCase();\n          return {\n            ...record,\n            fullName\n          };\n        });\n        dataSource.value = response.data.data;\n        console.log(updatedData);\n        dataSource.value = updatedData;\n        console.log(dataSource.value);\n      } catch (error) {\n        console.error(error);\n      }\n    });\n    const onSelectChange = selectedRowKey => {\n      selectedRowKeys.value = selectedRowKey;\n    };\n    const rowSelection = {\n      selectedRowKeys,\n      onChange: onSelectChange\n    };\n    return {\n      columns,\n      eventData,\n      rowSelection,\n      dataSource,\n      selectedRowKeys,\n      onSelectChange\n    };\n  }\n});\nexport default EventCampaignTable;","map":{"version":3,"names":["UserTableStyleWrapper","TableWrapper","computed","defineComponent","onMounted","ref","useRoute","authHeader","axios","useStore","columns","title","dataIndex","key","EventCampaignTable","name","components","setup","state","eventData","crud","data","dataSource","selectedRowKeys","API_URL","process","env","VUE_APP_BASE_URL","query","console","log","id","response","get","headers","updatedData","map","record","fullName","first_name","last_name","value","error","onSelectChange","selectedRowKey","rowSelection","onChange"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/pages/campaigns/CampaignTable/pendingConfirmation.vue"],"sourcesContent":["<template>\n    <UserTableStyleWrapper>\n      <TableWrapper class=\"table-responsive\">\n        <a-table\n          :rowSelection=\"rowSelection\"\n          :pagination=\"{ pageSize: 10, showSizeChanger: true }\"\n          :dataSource=\"dataSource\"\n          :columns=\"columns\"\n        >\n          <template #events=\"{ record }\">\n            <td>\n              <div class=\"table-actions\">\n                <sdButton @click=\"showSuccessModal\" size=\"small\" type=\"success\">\n                  <sdFeatherIcons type=\"edit-3\" size=\"16\" />\n                  &nbsp;&nbsp; Enroll Participants\n                </sdButton>\n                <sdButton>\n                  <router-link\n                    :to=\"`/event/view/${record.id}`\"\n                    class=\"btn-icon\"\n                    type=\"info\"\n                    shape=\"circle\"\n                  >\n                    <sdFeatherIcons type=\"eye\" size=\"16\" />\n                    &nbsp;&nbsp; View\n                  </router-link>\n                  <!-- <sdFeatherIcons type=\"edit\" size=\"16\" /> -->\n                  <!-- &nbsp;&nbsp; View -->\n                </sdButton>\n                <sdButton\n                  class=\"btn-icon\"\n                  type=\"danger\"\n                  @click=\"handleDelete(record.id)\"\n                  shape=\"circle\"\n                >\n                  <sdFeatherIcons type=\"trash-2\" size=\"16\" />\n                  <a href=\"\" title=\"Delete\"></a>\n                  <!-- &nbsp;&nbsp; Delete -->\n                </sdButton>\n              </div>\n            </td>\n          </template>\n        </a-table>\n      </TableWrapper>\n    </UserTableStyleWrapper>\n  </template>\n  \n  <script>\n  import { UserTableStyleWrapper } from \"../style\";\n  import { TableWrapper } from \"../../../styled\";\n  import { computed, defineComponent, onMounted, ref } from \"vue\";\n  import { useRoute } from \"vue-router\";\n  import authHeader from \"../../../../../src/services/auth-header\";\n  import axios from \"axios\";\n  import { useStore } from \"vuex\";\n  \n  const columns = [\n    {\n      title: \"Participant Name\",\n      dataIndex: \"fullName\",\n      key: \"id\",\n      // render: (text, record) => `${record.first_name} ${record.last_name}`,\n    },\n    {\n      title: \"Participant Phone\",\n      dataIndex: \"phone_no\",\n      key: \"id\",\n    },\n    {\n      title: \"Organization\",\n      dataIndex: \"org_types_id\",\n      key: \"id\",\n    },\n    {\n      title: \"Role\",\n      dataIndex: \"role_id\",\n      key: \"id\",\n    },\n  ];\n  \n  const EventCampaignTable = defineComponent({\n    name: \"EventCampaignTable\",\n    components: { UserTableStyleWrapper, TableWrapper },\n    setup() {\n      const { state } = useStore();\n      const eventData = computed(() => state.crud.data);\n  \n      const dataSource = ref([]);\n      const selectedRowKeys = ref([]);\n  \n      const API_URL = `${process.env.VUE_APP_BASE_URL}`;\n  \n      const { query } = useRoute();\n  \n      console.log(query.id);\n  \n      onMounted(async () => {\n        try {\n          const response = await axios.get(\n            `${API_URL}/events/${query.id}/participants?status=0`,\n            {\n              headers: authHeader(),\n            }\n          );\n          console.log(response.data.data);\n  \n          const updatedData = response.data.data.map((record) => {\n            let fullName = `${record.first_name} ${record.last_name}`;\n            // fullName = fullName.toUpperCase();\n            return {\n              ...record,\n              fullName,\n            };\n          });\n  \n          dataSource.value = response.data.data;\n          console.log(updatedData);\n          dataSource.value = updatedData;\n  \n          console.log(dataSource.value);\n        } catch (error) {\n          console.error(error);\n        }\n      });\n  \n      const onSelectChange = (selectedRowKey) => {\n        selectedRowKeys.value = selectedRowKey;\n      };\n  \n      const rowSelection = {\n        selectedRowKeys,\n        onChange: onSelectChange,\n      };\n  \n      return {\n        columns,\n        eventData,\n        rowSelection,\n        dataSource,\n        selectedRowKeys,\n        onSelectChange,\n      };\n    },\n  });\n  \n  export default EventCampaignTable;\n  </script>\n  "],"mappings":"AAgDE,SAASA,qBAAoB,QAAS,UAAU;AAChD,SAASC,YAAW,QAAS,iBAAiB;AAC9C,SAASC,QAAQ,EAAEC,eAAe,EAAEC,SAAS,EAAEC,GAAE,QAAS,KAAK;AAC/D,SAASC,QAAO,QAAS,YAAY;AACrC,OAAOC,UAAS,MAAO,yCAAyC;AAChE,OAAOC,KAAI,MAAO,OAAO;AACzB,SAASC,QAAO,QAAS,MAAM;AAE/B,MAAMC,OAAM,GAAI,CACd;EACEC,KAAK,EAAE,kBAAkB;EACzBC,SAAS,EAAE,UAAU;EACrBC,GAAG,EAAE;EACL;AACF,CAAC,EACD;EACEF,KAAK,EAAE,mBAAmB;EAC1BC,SAAS,EAAE,UAAU;EACrBC,GAAG,EAAE;AACP,CAAC,EACD;EACEF,KAAK,EAAE,cAAc;EACrBC,SAAS,EAAE,cAAc;EACzBC,GAAG,EAAE;AACP,CAAC,EACD;EACEF,KAAK,EAAE,MAAM;EACbC,SAAS,EAAE,SA