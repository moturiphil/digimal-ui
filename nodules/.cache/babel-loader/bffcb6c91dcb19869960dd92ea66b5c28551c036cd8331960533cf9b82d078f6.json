{"ast":null,"code":"import { RecordViewWrapper } from \"./style\";\nimport { Main, TableWrapper } from \"../../styled\";\nimport { useStore } from \"vuex\";\nimport { computed, onMounted, ref, reactive, defineComponent } from \"vue\";\n// import axios from \"axios\";\nimport authHeader from \"../../../services/auth-header\";\n// import { inject } from \"vue\";\n// import { useRouter } from \"vue-router\";\n// import DragAndDropTable from '../../../view/table/DragTable.vue';\n\nconst columns = [{\n  title: \"Campaign Name\",\n  dataIndex: \"name\",\n  key: \"id\"\n}, {\n  title: \"Campaign Start Date\",\n  dataIndex: \"start_date\",\n  key: \"id\"\n}, {\n  title: \"Campaign End Date\",\n  dataIndex: \"end_date\",\n  key: \"id\"\n}, {\n  title: \"Actions\",\n  dataIndex: \"\",\n  key: \"actions\",\n  slots: {\n    customRender: \"actions\"\n  }\n}];\nconst ViewPage = defineComponent({\n  name: \"ViewPage\",\n  components: {\n    RecordViewWrapper,\n    Main,\n    TableWrapper\n  },\n  setup() {\n    const {\n      state,\n      dispatch\n    } = useStore();\n    const crud = computed(() => state.crud.data);\n    const isLoading = computed(() => state.crud.loading);\n    const selectedRowKeys = ref([]);\n    const dataSource = ref([]);\n    console.log(authHeader());\n    onMounted(async () => {\n      try {\n        const response = await fetch(`${process.env.VUE_APP_BASE_URL}/campaign_all`, {\n          method: \"GET\",\n          headers: authHeader()\n        });\n        const data = await response.json();\n        dataSource.value = data.data;\n      } catch (error) {\n        console.error(error);\n      }\n    });\n    const handleDelete = id => {\n      const confirm = window.confirm(\"Are you sure delete this?\");\n      if (confirm) {\n        dispatch(\"axiosDataDelete\", {\n          id,\n          getData: () => {\n            dispatch(\"axiosCrudGetData\");\n          }\n        });\n      }\n      return false;\n    };\n    const formState = reactive({\n      searchItem: \"\"\n    });\n    const onSelectChange = selectedRowKey => {\n      selectedRowKeys.value = selectedRowKey;\n    };\n    const rowSelection = {\n      selectedRowKeys,\n      onChange: onSelectChange\n    };\n    return {\n      crud,\n      isLoading,\n      selectedRowKeys,\n      handleDelete,\n      rowSelection,\n      onSelectChange,\n      dataSource,\n      columns,\n      formState\n    };\n  },\n  beforeRouteEnter(to, from, next) {\n    if (!sessionStorage.getItem(\"user\")) {\n      next(\"/auth/login\");\n    } else {\n      next();\n    }\n  }\n});\nexport default ViewPage;","map":{"version":3,"names":["RecordViewWrapper","Main","TableWrapper","useStore","computed","onMounted","ref","reactive","defineComponent","authHeader","columns","title","dataIndex","key","slots","customRender","ViewPage","name","components","setup","state","dispatch","crud","data","isLoading","loading","selectedRowKeys","dataSource","console","log","response","fetch","process","env","VUE_APP_BASE_URL","method","headers","json","value","error","handleDelete","id","confirm","window","getData","formState","searchItem","onSelectChange","selectedRowKey","rowSelection","onChange","beforeRouteEnter","to","from","next","sessionStorage","getItem"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/pages/campaigns/exViewCampaign.vue"],"sourcesContent":["<template>\n    <RecordViewWrapper>\n      <sdPageHeader title=\"MassNet Campaigns\">\n        <template #subTitle>\n          <sdButton class=\"btn-add_new\" size=\"default\" type=\"success\">\n            <router-link to=\"/campaigns/create-campaign\">\n              <sdFeatherIcons type=\"plus\" size=\"14\" /> Start New\n              Campaign</router-link\n            >\n          </sdButton>\n        </template>\n        <template #buttons>\n          <div class=\"search-box\">\n            <span class=\"search-icon\">\n              <sdFeatherIcons type=\"search\" size=\"14\" />\n            </span></div\n        ></template>\n      </sdPageHeader>\n      <Main>\n        <a-row :gutter=\"15\">\n          <a-col class=\"w-100\" :md=\"24\">\n            <sdCards headless>\n              <div v-if=\"isLoading\" class=\"spin\">\n                <a-spin />\n              </div>\n  \n              <div v-else>\n                <TableWrapper class=\"table-data-view table-responsive\">\n                  <a-table\n                    :rowSelection=\"rowSelection\"\n                    :pagination=\"{ pageSize: 10, showSizeChanger: true }\"\n                    :dataSource=\"dataSource\"\n                    :columns=\"columns\"\n                  >\n                    <template #actions=\"{ record }\">\n                      <td>\n                        <div class=\"table-actions\">\n                          <sdButton\n                          >\n                            <router-link\n                              :to=\"`/campaigns/view/${record.id}`\"\n                              class=\"btn-icon\"\n                              type=\"info\"\n                              shape=\"circle\"\n                            >\n                              <sdFeatherIcons type=\"eye\" size=\"16\" />\n                              &nbsp;&nbsp; View\n                            </router-link>\n                          </sdButton>\n                        </div>\n                      </td>\n                    </template>\n                  </a-table>\n                </TableWrapper>\n              </div>\n            </sdCards>\n          </a-col>\n        </a-row>\n        <a-col :xs=\"24\">\n          <DragAndDropTable />\n        </a-col>\n      </Main>\n    </RecordViewWrapper>\n  </template>\n  <script>\n  import { RecordViewWrapper } from \"./style\";\n  import { Main, TableWrapper } from \"../../styled\";\n  import { useStore } from \"vuex\";\n  import { computed, onMounted, ref, reactive, defineComponent } from \"vue\";\n  // import axios from \"axios\";\n  import authHeader from \"../../../services/auth-header\";\n  // import { inject } from \"vue\";\n  // import { useRouter } from \"vue-router\";\n  // import DragAndDropTable from '../../../view/table/DragTable.vue';\n  \n  const columns = [\n    {\n      title: \"Campaign Name\",\n      dataIndex: \"name\",\n      key: \"id\",\n    },\n    {\n      title: \"Campaign Start Date\",\n      dataIndex: \"start_date\",\n      key: \"id\",\n    },\n    {\n      title: \"Campaign End Date\",\n      dataIndex: \"end_date\",\n      key: \"id\",\n    },\n    {\n      title: \"Actions\",\n      dataIndex: \"\",\n      key: \"actions\",\n      slots: { customRender: \"actions\" },\n    },\n  ];\n  \n  const ViewPage = defineComponent({\n    name: \"ViewPage\",\n    components: { RecordViewWrapper, Main, TableWrapper },\n  \n    setup() {\n      const { state, dispatch } = useStore();\n      const crud = computed(() => state.crud.data);\n      const isLoading = computed(() => state.crud.loading);\n      const selectedRowKeys = ref([]);\n      const dataSource = ref([]);\n  \n      console.log(authHeader());\n  \n      onMounted(async () => {\n        try {\n          const response = await fetch(`${process.env.VUE_APP_BASE_URL}/campaign_all`, \n          {\n            method: \"GET\",\n            headers: authHeader(),\n          });\n          const data = await response.json();\n          dataSource.value = data.data;\n        } catch (error) {\n          console.error(error);\n        }\n      });\n  \n      const handleDelete = (id) => {\n        const confirm = window.confirm(\"Are you sure delete this?\");\n        if (confirm) {\n          dispatch(\"axiosDataDelete\", {\n            id,\n            getData: () => {\n              dispatch(\"axiosCrudGetData\");\n            },\n          });\n        }\n        return false;\n      };\n  \n      const formState = reactive({\n        searchItem: \"\",\n      });\n  \n      const onSelectChange = (selectedRowKey) => {\n        selectedRowKeys.value = selectedRowKey;\n      };\n  \n      const rowSelection = {\n        selectedRowKeys,\n        onChange: onSelectChange,\n      };\n  \n      return {\n        crud,\n        isLoading,\n        selectedRowKeys,\n        handleDelete,\n        rowSelection,\n        onSelectChange,\n        dataSource,\n        columns,\n        formState,\n      };\n    },\n    beforeRouteEnter(to, from, next) {\n      if (!sessionStorage.getItem(\"user\")) {\n        next(\"/auth/login\");\n      } else {\n        next();\n      }\n    },\n  });\n  \n  export default ViewPage;\n  </script>\n  "],"mappings":"AAiEE,SAASA,iBAAgB,QAAS,SAAS;AAC3C,SAASC,IAAI,EAAEC,YAAW,QAAS,cAAc;AACjD,SAASC,QAAO,QAAS,MAAM;AAC/B,SAASC,QAAQ,EAAEC,SAAS,EAAEC,GAAG,EAAEC,QAAQ,EAAEC,eAAc,QAAS,KAAK;AACzE;AACA,OAAOC,UAAS,MAAO,+BAA+B;AACtD;AACA;AACA;;AAEA,MAAMC,OAAM,GAAI,CACd;EACEC,KAAK,EAAE,eAAe;EACtBC,SAAS,EAAE,MAAM;EACjBC,GAAG,EAAE;AACP,CAAC,EACD;EACEF,KAAK,EAAE,qBAAqB;EAC5BC,SAAS,EAAE,YAAY;EACvBC,GAAG,EAAE;AACP,CAAC,EACD;EACEF,KAAK,EAAE,mBAAmB;EAC1BC,SAAS,EAAE,UAAU;EACrBC,GAAG,EAAE;AACP,CAAC,EACD;EACEF,KAAK,EAAE,SAAS;EAChBC,SAAS,EAAE,EAAE;EACbC,GAAG,EAAE,SAAS;EACdC,KAAK,EAAE;IAAEC,YAAY,EAAE;EAAU;AACnC,CAAC,CACF;AAED,MAAMC,QAAO,GAAIR,eAAe,CAAC;EAC/BS,IAAI,EAAE,UAAU;EAChBC,UAAU,EAAE;IAAElB,iBAAiB;IAAEC,IAAI;IAAEC;EAAa,CAAC;EAErDiB,KAAKA,CAAA,EAAG;IACN,MAAM;MAAEC,KAAK;MAAEC;IAAS,IAAIlB,QAAQ,EAAE;IACtC,MAAMmB,IAAG,GAAIlB,QAAQ,CAAC,MAAMgB,KAAK,CAACE,IAAI,CAACC,IAAI,CAAC;IAC5C,MAAMC,SAAQ,GAAIpB,QAAQ,CAAC,MAAMgB,KAAK,CAACE,IAAI,CAACG,OAAO,CAAC;IACpD,MAAMC,eAAc,GAAIpB,GAAG,CAAC,EAAE,CAAC;IAC/B,MAAMqB,UAAS,GAAIrB,GAAG,CAAC,EAAE,CAAC;IAE1BsB,OAAO,CAACC,GAAG,CAACpB,UAAU,EAAE,CAAC;IAEzBJ,SAAS,CAAC,YAAY;MACpB,IAAI;QACF,MAAMyB,QAAO,GAAI,MAAMC,KAAK,CAAE,GAAEC,OAAO,CAACC,GAAG,CAACC,gBAAiB,eAAc,EAC3E;UACEC,MAAM,EAAE,KAAK;UACbC,OAAO,EAAE3B,UAAU;QACrB,CAAC,CAAC;QACF,MAAMc,IAAG,GAAI,MAAMO,QAAQ,CAACO,IAAI,EAAE;QAClCV,UAAU,CAACW,KAAI,GAAIf,IAAI,CAACA,IAAI;MAC9B,EAAE,OAAOgB,KAAK,EAAE;QACdX,OAAO,CAACW,KAAK