{"ast":null,"code":"import PropTypes from 'vue-types';\nimport { ProductCard } from '../../Style';\nimport { computed, toRefs, defineComponent } from 'vue';\nimport { useStore } from 'vuex';\nimport { useRoute } from 'vue-router';\nconst ProductCardsList = defineComponent({\n  name: 'ProductCards',\n  components: {\n    ProductCard\n  },\n  props: {\n    product: PropTypes.object.def({})\n  },\n  setup(props) {\n    const {\n      dispatch,\n      state\n    } = useStore();\n    const isLoader = computed(() => state.ecommerce.isProductLoading);\n    const {\n      product\n    } = toRefs(props);\n    const renderData = computed(() => product.value);\n    const {\n      matched\n    } = useRoute();\n    return {\n      dispatch,\n      renderData,\n      isLoader,\n      matched\n    };\n  }\n});\nexport default ProductCardsList;","map":{"version":3,"names":["PropTypes","ProductCard","computed","toRefs","defineComponent","useStore","useRoute","ProductCardsList","name","components","props","product","object","def","setup","dispatch","state","isLoader","ecommerce","isProductLoading","renderData","value","matched"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/pages/net-distribution/product/overview/ProductCardList.vue"],"sourcesContent":["<template>\r\n  <p v-if=\"isLoader\">Loading</p>\r\n  <ProductCard v-else class=\"list-view\" :style=\"{ marginBottom: '20px' }\">\r\n    <div class=\"product-list\">\r\n      <a-row :gutter=\"15\">\r\n        <a-col :md=\"6\" :xs=\"24\">\r\n          <figure>\r\n            <img :style=\"{ width: '100%' }\" :src=\"require(`@/${renderData.img}`)\" alt=\"\" />\r\n          </figure>\r\n        </a-col>\r\n        <a-col :md=\"12\" :xs=\"24\">\r\n          <div class=\"product-single-description\">\r\n            <sdHeading class=\"product-single-title\" as=\"h5\">\r\n              <router-link :to=\"`${matched[1].path}/ecommerce/productDetails/${renderData.id}`\">{{\r\n                renderData.name\r\n              }}</router-link>\r\n            </sdHeading>\r\n            <p>{{ renderData.description }}</p>\r\n          </div>\r\n        </a-col>\r\n        <a-col :md=\"6\" :xs=\"24\">\r\n          <div class=\"product-single-info\">\r\n            <a @click=\"() => dispatch('updateWishList', renderData.id)\" class=\"btn-heart\" to=\"#\">\r\n              <sdFeatherIcons\r\n                type=\"heart\"\r\n                size=\"14\"\r\n                :color=\"renderData.popular ? '#FF4D4F' : '#9299B8'\"\r\n                :fill=\"renderData.popular ? '#FF4D4F' : 'none'\"\r\n              />\r\n            </a>\r\n            <p class=\"product-single-price\">\r\n              <span class=\"product-single-price__new\">${{ renderData.price }} </span>\r\n\r\n              <template v-if=\"renderData.oldPrice\">\r\n                <del> ${{ renderData.oldPrice }} </del>\r\n                <span class=\"product-single-price__offer\"> 60% Off</span>\r\n              </template>\r\n            </p>\r\n            <div class=\"product-single-rating\">\r\n              <a-rate allow-half :default-value=\"renderData.rate\" disabled /> 4.9\r\n              <span class=\"total-reviews\"> 778 Reviews</span>\r\n            </div>\r\n            <div class=\"product-single-action\">\r\n              <sdButton size=\"small\" class=\"btn-cart\" type=\"white\" :outlined=\"true\">\r\n                <sdFeatherIcons type=\"shopping-bag\" size=\"14\" />\r\n                <span>Add To Cart</span>\r\n              </sdButton>\r\n              <sdButton size=\"small\" type=\"primary\"> Buy Now </sdButton>\r\n            </div>\r\n          </div>\r\n        </a-col>\r\n      </a-row>\r\n    </div>\r\n  </ProductCard>\r\n</template>\r\n<script>\r\nimport PropTypes from 'vue-types';\r\nimport { ProductCard } from '../../Style';\r\nimport { computed, toRefs, defineComponent } from 'vue';\r\nimport { useStore } from 'vuex';\r\nimport { useRoute } from 'vue-router';\r\n\r\nconst ProductCardsList = defineComponent({\r\n  name: 'ProductCards',\r\n  components: { ProductCard },\r\n  props: {\r\n    product: PropTypes.object.def({}),\r\n  },\r\n  setup(props) {\r\n    const { dispatch, state } = useStore();\r\n    const isLoader = computed(() => state.ecommerce.isProductLoading);\r\n    const { product } = toRefs(props);\r\n    const renderData = computed(() => product.value);\r\n    const { matched } = useRoute();\r\n\r\n    return {\r\n      dispatch,\r\n      renderData,\r\n      isLoader,\r\n      matched,\r\n    };\r\n  },\r\n});\r\n\r\nexport default ProductCardsList;\r\n</script>\r\n"],"mappings":"AAwDA,OAAOA,SAAQ,MAAO,WAAW;AACjC,SAASC,WAAU,QAAS,aAAa;AACzC,SAASC,QAAQ,EAAEC,MAAM,EAAEC,eAAc,QAAS,KAAK;AACvD,SAASC,QAAO,QAAS,MAAM;AAC/B,SAASC,QAAO,QAAS,YAAY;AAErC,MAAMC,gBAAe,GAAIH,eAAe,CAAC;EACvCI,IAAI,EAAE,cAAc;EACpBC,UAAU,EAAE;IAAER;EAAY,CAAC;EAC3BS,KAAK,EAAE;IACLC,OAAO,EAAEX,SAAS,CAACY,MAAM,CAACC,GAAG,CAAC,CAAC,CAAC;EAClC,CAAC;EACDC,KAAKA,CAACJ,KAAK,EAAE;IACX,MAAM;MAAEK,QAAQ;MAAEC;IAAM,IAAIX,QAAQ,EAAE;IACtC,MAAMY,QAAO,GAAIf,QAAQ,CAAC,MAAMc,KAAK,CAACE,SAAS,CAACC,gBAAgB,CAAC;IACjE,MAAM;MAAER;IAAQ,IAAIR,MAAM,CAACO,KAAK,CAAC;IACjC,MAAMU,UAAS,GAAIlB,QAAQ,CAAC,MAAMS,OAAO,CAACU,KAAK,CAAC;IAChD,MAAM;MAAEC;IAAQ,IAAIhB,QAAQ,EAAE;IAE9B,OAAO;MACLS,QAAQ;MACRK,UAAU;MACVH,QAAQ;MACRK;IACF,CAAC;EACH;AACF,CAAC,CAAC;AAEF,eAAef,gBAAgB"},"metadata":{},"sourceType":"module","externalDependencies":[]}