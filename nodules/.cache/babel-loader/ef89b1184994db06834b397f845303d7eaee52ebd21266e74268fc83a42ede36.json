{"ast":null,"code":"import { computed, onMounted, ref, defineComponent } from 'vue';\nimport { useStore } from 'vuex';\nconst sellingColumns = [{\n  title: 'County',\n  dataIndex: 'name',\n  key: 'name'\n}, {\n  title: 'Event Name',\n  dataIndex: 'deals',\n  key: 'deals'\n}, {\n  title: 'Nets Distributed',\n  dataIndex: 'amount',\n  key: 'amount'\n}];\nconst SalesLeaderBoard = defineComponent({\n  name: 'SalesLeaderBoard',\n  components: {},\n  setup() {\n    const {\n      state,\n      dispatch\n    } = useStore();\n    const topSaleState = computed(() => state.chartContent.topSaleData);\n    const products = ref('year');\n    onMounted(() => dispatch('topSaleGetData'));\n    const sellingData = computed(() => topSaleState.value ? topSaleState.value.map(value => {\n      const {\n        key,\n        name,\n        sold,\n        revenue\n      } = value;\n      return {\n        key,\n        name,\n        deals: sold,\n        amount: revenue\n      };\n    }) : []);\n    const handleActiveChangeProducts = (event, value) => {\n      event.preventDefault();\n      products.value = value;\n      dispatch('topSaleFilterData', value);\n    };\n    return {\n      products,\n      topSaleState,\n      handleActiveChangeProducts,\n      sellingData,\n      sellingColumns\n    };\n  }\n});\nexport default SalesLeaderBoard;","map":{"version":3,"names":["computed","onMounted","ref","defineComponent","useStore","sellingColumns","title","dataIndex","key","SalesLeaderBoard","name","components","setup","state","dispatch","topSaleState","chartContent","topSaleData","products","sellingData","value","map","sold","revenue","deals","amount","handleActiveChangeProducts","event","preventDefault"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/dashboard/overview/massnet/OnGoingEvents.vue"],"sourcesContent":["<template>\n    <div class=\"full-width-table\">\n      <sdCards title=\"OnGoing Events Per County\" bodypadding=\"0px\">\n        <template #button>\n          <div class=\"card-nav\">\n            <ul>\n              <li :class=\"products === 'today' ? 'active' : 'deactivate'\">\n                <router-link @click=\"(e) => handleActiveChangeProducts(e, 'today')\" to=\"#\"> Today </router-link>\n              </li>\n              <li :class=\"products === 'week' ? 'active' : 'deactivate'\">\n                <router-link @click=\"(e) => handleActiveChangeProducts(e, 'week')\" to=\"#\"> Week </router-link>\n              </li>\n              <li :class=\"products === 'month' ? 'active' : 'deactivate'\">\n                <router-link @click=\"(e) => handleActiveChangeProducts(e, 'month')\" to=\"#\"> Month </router-link>\n              </li>\n              <li :class=\"products === 'year' ? 'active' : 'deactivate'\">\n                <router-link @click=\"(e) => handleActiveChangeProducts(e, 'year')\" to=\"#\"> Year </router-link>\n              </li>\n            </ul>\n          </div>\n        </template>\n        <div class=\"table-bordered leaderboard-table table-responsive\">\n          <a-table :columns=\"sellingColumns\" :dataSource=\"[...sellingData]\" :pagination=\"false\" />\n        </div>\n      </sdCards>\n    </div>\n  </template>\n  <script>\n  import { computed, onMounted, ref, defineComponent } from 'vue';\n  import { useStore } from 'vuex';\n  \n  const sellingColumns = [\n    {\n      title: 'County',\n      dataIndex: 'name',\n      key: 'name',\n    },\n    {\n      title: 'Event Name',\n      dataIndex: 'deals',\n      key: 'deals',\n    },\n    {\n      title: 'Nets Distributed',\n      dataIndex: 'amount',\n      key: 'amount',\n    },\n  ];\n  const SalesLeaderBoard = defineComponent({\n    name: 'SalesLeaderBoard',\n    components: {},\n    setup() {\n      const { state, dispatch } = useStore();\n      const topSaleState = computed(() => state.chartContent.topSaleData);\n      const products = ref('year');\n      onMounted(() => dispatch('topSaleGetData'));\n  \n      const sellingData = computed(() =>\n        topSaleState.value\n          ? topSaleState.value.map((value) => {\n              const { key, name, sold, revenue } = value;\n              return {\n                key,\n                name,\n                deals: sold,\n                amount: revenue,\n              };\n            })\n          : [],\n      );\n  \n      const handleActiveChangeProducts = (event, value) => {\n        event.preventDefault();\n        products.value = value;\n        dispatch('topSaleFilterData', value);\n      };\n      return {\n        products,\n        topSaleState,\n        handleActiveChangeProducts,\n        sellingData,\n        sellingColumns,\n      };\n    },\n  });\n  \n  export default SalesLeaderBoard;\n  </script>\n  "],"mappings":"AA4BE,SAASA,QAAQ,EAAEC,SAAS,EAAEC,GAAG,EAAEC,eAAc,QAAS,KAAK;AAC/D,SAASC,QAAO,QAAS,MAAM;AAE/B,MAAMC,cAAa,GAAI,CACrB;EACEC,KAAK,EAAE,QAAQ;EACfC,SAAS,EAAE,MAAM;EACjBC,GAAG,EAAE;AACP,CAAC,EACD;EACEF,KAAK,EAAE,YAAY;EACnBC,SAAS,EAAE,OAAO;EAClBC,GAAG,EAAE;AACP,CAAC,EACD;EACEF,KAAK,EAAE,kBAAkB;EACzBC,SAAS,EAAE,QAAQ;EACnBC,GAAG,EAAE;AACP,CAAC,CACF;AACD,MAAMC,gBAAe,GAAIN,eAAe,CAAC;EACvCO,IAAI,EAAE,kBAAkB;EACxBC,UAAU,EAAE,CAAC,CAAC;EACdC,KAAKA,CAAA,EAAG;IACN,MAAM;MAAEC,KAAK;MAAEC;IAAS,IAAIV,QAAQ,EAAE;IACtC,MAAMW,YAAW,GAAIf,QAAQ,CAAC,MAAMa,KAAK,CAACG,YAAY,CAACC,WAAW,CAAC;IACnE,MAAMC,QAAO,GAAIhB,GAAG,CAAC,MAAM,CAAC;IAC5BD,SAAS,CAAC,MAAMa,QAAQ,CAAC,gBAAgB,CAAC,CAAC;IAE3C,MAAMK,WAAU,GAAInB,QAAQ,CAAC,MAC3Be,YAAY,CAACK,KAAI,GACbL,YAAY,CAACK,KAAK,CAACC,GAAG,CAAED,KAAK,IAAK;MAChC,MAAM;QAAEZ,GAAG;QAAEE,IAAI;QAAEY,IAAI;QAAEC;MAAQ,IAAIH,KAAK;MAC1C,OAAO;QACLZ,GAAG;QACHE,IAAI;QACJc,KAAK,EAAEF,IAAI;QACXG,MAAM,EAAEF;MACV,CAAC;IACH,CAAC,IACD,EAAE,CACP;IAED,MAAMG,0BAAyB,GAAIA,CAACC,KAAK,EAAEP,KAAK,KAAK;MACnDO,KAAK,CAACC,cAAc,EAAE;MACtBV,QAAQ,CAACE,KAAI,GAAIA,KAAK;MACtBN,QAAQ,CAAC,mBAAmB,EAAEM,KAAK,CAAC;IACtC,CAAC;IACD,OAAO;MACLF,QAAQ;MACRH,YAAY;MACZW,0BAA0B;MAC1BP,WAAW;MACXd;IACF,CAAC;EACH;AACF,CAAC,CAAC;AAEF,eAAeI,gBAAgB"},"metadata":{},"source