{"ast":null,"code":"import { Main } from '../styled';\nimport { mapState } from 'vuex';\nimport { CloseCircleOutlined } from '@ant-design/icons-vue';\nimport { defineComponent } from 'vue';\nexport default defineComponent({\n  name: 'Result',\n  components: {\n    Main,\n    CloseCircleOutlined\n  },\n  computed: {\n    ...mapState(['rtl'])\n  }\n});","map":{"version":3,"names":["Main","mapState","CloseCircleOutlined","defineComponent","name","components","computed"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/uiElements/Result.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <sdPageHeader title=\"Results\">\r\n      <template v-slot:buttons>\r\n        <div class=\"page-header-actions\">\r\n          <sdCalendarButton />\r\n          <sdExportButton />\r\n          <sdShareButton />\r\n          <sdButton size=\"small\" type=\"primary\">\r\n            <sdFeatherIcons type=\"plus\" size=\"14\" />\r\n            Add New\r\n          </sdButton>\r\n        </div>\r\n      </template>\r\n    </sdPageHeader>\r\n    <Main>\r\n      <a-row :gutter=\"25\">\r\n        <a-col :md=\"12\" :xs=\"24\">\r\n          <sdCards title=\"Success\" caption=\"The simplest use of Results\">\r\n            <a-result\r\n              status=\"success\"\r\n              title=\"Successfully Purchased Cloud Server ECS!\"\r\n              sub-title=\"Order number: 2017182818828182881 Cloud server configuration takes 1-5 minutes, please wait.\"\r\n              style=\"padding: 0\"\r\n            >\r\n              <template #extra>\r\n                <a-button key=\"console\" type=\"primary\"> Go Console </a-button>\r\n                <a-button key=\"buy\"> Buy Again </a-button>\r\n              </template>\r\n            </a-result>\r\n          </sdCards>\r\n          <sdCards title=\"Warning\" caption=\"The simplest use of Results\">\r\n            <a-result status=\"warning\" title=\"There are some problems with your operation.\" style=\"padding: 0\">\r\n              <template #extra>\r\n                <a-button key=\"console\" type=\"primary\"> Go Console </a-button>\r\n              </template>\r\n            </a-result>\r\n          </sdCards>\r\n          <sdCards title=\"404\" caption=\"The simplest use of Results\">\r\n            <a-result\r\n              status=\"404\"\r\n              title=\"404\"\r\n              sub-title=\"Sorry, the page you visited does not exist.\"\r\n              style=\"padding: 0\"\r\n            >\r\n              <template #extra>\r\n                <a-button type=\"primary\"> Back Home </a-button>\r\n              </template>\r\n            </a-result>\r\n          </sdCards>\r\n          <sdCards title=\"Error\" caption=\"The simplest use of Results\">\r\n            <a-result\r\n              status=\"error\"\r\n              title=\"Submission Failed\"\r\n              sub-title=\"Please check and modify the following information before resubmitting.\"\r\n              style=\"padding: 0\"\r\n            >\r\n              <template #extra>\r\n                <a-button key=\"console\" type=\"primary\"> Go Console </a-button>\r\n                <a-button key=\"buy\"> Buy Again </a-button>\r\n              </template>\r\n\r\n              <div class=\"desc ant-typography\">\r\n                <p class=\"ant-typography\" style=\"font-size: 16px\">\r\n                  <strong>The content you submitted has the following error:</strong>\r\n                </p>\r\n                <p class=\"ant-typography\">\r\n                  <CloseCircleOutlined :style=\"{ color: 'red' }\" /> Your account has been frozen\r\n                  <a>Thaw immediately &gt;</a>\r\n                </p>\r\n                <p class=\"ant-typography\">\r\n                  <CloseCircleOutlined :style=\"{ color: 'red' }\" /> Your account is not yet eligible to apply\r\n                  <a>Apply Unlock &gt;</a>\r\n                </p>\r\n              </div>\r\n            </a-result>\r\n          </sdCards>\r\n        </a-col>\r\n        <a-col :md=\"12\" :xs=\"24\">\r\n          <sdCards title=\"Info\" caption=\"The simplest use of Results\">\r\n            <a-result title=\"Your operation has been executed\" style=\"padding: 0\">\r\n              <template #extra>\r\n                <a-button key=\"console\" type=\"primary\"> Go Console </a-button>\r\n              </template>\r\n            </a-result>\r\n          </sdCards>\r\n          <sdCards title=\"403\" caption=\"The simplest use of Results\">\r\n            <a-result\r\n              status=\"403\"\r\n              title=\"403\"\r\n              sub-title=\"Sorry, you are not authorized to access this page.\"\r\n              style=\"padding: 0\"\r\n            >\r\n              <template #extra>\r\n                <a-button type=\"primary\"> Back Home </a-button>\r\n              </template>\r\n            </a-result>\r\n          </sdCards>\r\n          <sdCards title=\"500\" caption=\"The simplest use of Results\">\r\n            <a-result status=\"500\" title=\"500\" sub-title=\"Sorry, the server is wrong.\" style=\"padding: 0\">\r\n              <template #extra>\r\n                <a-button type=\"primary\"> Back Home </a-button>\r\n              </template>\r\n            </a-result>\r\n          </sdCards>\r\n        </a-col>\r\n      </a-row>\r\n    </Main>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { Main } from '../styled';\r\nimport { mapState } from 'vuex';\r\nimport { CloseCircleOutlined } from '@ant-design/icons-vue';\r\nimport { defineComponent } from 'vue';\r\nexport default defineComponent({\r\n  name: 'Result',\r\n  components: {\r\n    Main,\r\n    CloseCircleOutlined,\r\n  },\r\n  computed: {\r\n    ...mapState(['rtl']),\r\n  },\r\n});\r\n</script>\r\n<style scoped>\r\n.desc p {\r\n  margin-bottom: 1em;\r\n}\r\n</style>\r\n"],"mappings":"AAgHA,SAASA,IAAG,QAAS,WAAW;AAChC,SAASC,QAAO,QAAS,MAAM;AAC/B,SAASC,mBAAkB,QAAS,uBAAuB;AAC3D,SAASC,eAAc,QAAS,KAAK;AACrC,eAAeA,eAAe,CAAC;EAC7BC,IA