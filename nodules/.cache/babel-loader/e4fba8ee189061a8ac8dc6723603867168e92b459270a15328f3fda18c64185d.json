gs);\r\n      this.tags = tags;\r\n    },\r\n\r\n    showInput() {\r\n      this.inputVisible = true;\r\n      this.$nextTick(function () {\r\n        this.$refs.input.focus();\r\n      });\r\n    },\r\n\r\n    handleInputChange(e) {\r\n      this.inputValue = e.target.value;\r\n    },\r\n\r\n    handleInputConfirm() {\r\n      const inputValue = this.inputValue;\r\n      let tags = this.tags;\r\n      if (inputValue && tags.indexOf(inputValue) === -1) {\r\n        tags = [...tags, inputValue];\r\n      }\r\n      console.log(tags);\r\n      Object.assign(this, {\r\n        tags,\r\n        inputVisible: false,\r\n        inputValue: '',\r\n      });\r\n    },\r\n  },\r\n});\r\n\r\nexport default Profile;\r\n</script>\r\n"],"mappings":"AA+CA,SAASA,gBAAe,QAAS,iBAAiB;AAClD,SAASC,eAAe,EAAEC,QAAO,QAAS,KAAK;AAE/C,MAAMC,OAAM,GAAIF,eAAe,CAAC;EAC9BG,IAAI,EAAE,SAAS;EACfC,UAAU,EAAE;IAAEL;EAAiB,CAAC;EAEhCM,KAAKA,CAAA,EAAG;IACN,MAAMC,SAAQ,GAAIL,QAAQ,CAAC;MACzBE,IAAI,EAAE,eAAe;MACrBI,KAAK,EAAE,YAAY;MACnBC,IAAI,EAAE,EAAE;MACRC,YAAY,EAAE,eAAe;MAC7BC,OAAO,EAAE,0CAA0C;MACnDC,OAAO,EACL;IACJ,CAAC,CAAC;IAEF,MAAMC,YAAW,GAAKC,MAAM,IAAK;MAC/B,IAAI,CAACA,MAAK,GAAI;QAAE,GAAGA,MAAM;QAAEC,IAAI,EAAE,IAAI,CAACA;MAAK,CAAC;MAC5CC,OAAO,CAACC,GAAG,CAACH,MAAM,EAAEP,SAAS,CAAC;IAChC,CAAC;IAED,MAAMW,kBAAiB,GAAKC,MAAM,IAAK;MACrCH,OAAO,CAACC,GAAG,CAACE,MAAM,CAAC;IACrB,CAAC;IAED,OAAO;MACLZ,SAAS;MACTM,YAAY;MACZK;IACF,CAAC;EACH,CAAC;EAEDE,IAAIA,CAAA,EAAG;IACL,OAAO;MACL;MACAN,MAAM,EAAE,IAAI;MACZO,YAAY,EAAE,KAAK;MACnBC,UAAU,EAAE;IACd,CAAC;EACH,CAAC;EAEDC,OAAO,EAAE;IACPC,YAAYA,CAACC,CAAC,EAAE;MACdA,CAAC,CAACC,cAAc,EAAE;MAClB;IACF,CAAC;;IACDC,WAAWA,CAACC,UAAU,EAAE;MACtB,MAAMb,IAAG,GAAI,IAAI,CAACA,IAAI,CAACc,MAAM,CAAEC,GAAG,IAAKA,GAAE,KAAMF,UAAU,CAAC;MAC1DZ,OAAO,CAACC,GAAG,CAACF,IAAI,CAAC;MACjB,IAAI,CAACA,IAAG,GAAIA,IAAI;IAClB,CAAC;IAEDgB,SAASA,CAAA,EAAG;MACV,IAAI,CAACV,YAAW,GAAI,IAAI;MACxB,IAAI,CAACW,SAAS,CAAC,YAAY;QACzB,IAAI,CAACC,KAAK,CAACC,KAAK,CAACC,KAAK,EAAE;MAC1B,CAAC,CAAC;IACJ,CAAC;IAEDC,iBAAiBA,CAACX,CA