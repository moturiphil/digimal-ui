{"ast":null,"code":"import { toRefs, ref, computed } from 'vue';\nimport PropTypes from 'vue-types';\nimport { useStore } from 'vuex';\nimport { faFacebookF, faDribbble, faTwitter, faInstagram, faGithub, faMediumM } from '@fortawesome/free-brands-svg-icons';\nconst DetailsRight = {\n  name: 'DetailsRight',\n  props: {\n    product: PropTypes.object\n  },\n  setup(props) {\n    const quantity = ref(1);\n    const {\n      product\n    } = toRefs(props);\n    const {\n      state,\n      dispatch\n    } = useStore();\n    const incrementQuantity = e => {\n      e.preventDefault();\n      if (quantity.value !== 5) quantity.value = quantity.value + 1;\n    };\n    const decrementQuantity = e => {\n      e.preventDefault();\n      if (quantity.value !== 1) quantity.value = quantity.value - 1;\n    };\n    const isLoader = computed(() => state.ecommerce.isLoading);\n    return {\n      quantity,\n      incrementQuantity,\n      decrementQuantity,\n      product,\n      dispatch,\n      isLoader,\n      faFacebookF,\n      faDribbble,\n      faTwitter,\n      faInstagram,\n      faGithub,\n      faMediumM\n    };\n  }\n};\nexport default DetailsRight;","map":{"version":3,"names":["toRefs","ref","computed","PropTypes","useStore","faFacebookF","faDribbble","faTwitter","faInstagram","faGithub","faMediumM","DetailsRight","name","props","product","object","setup","quantity","state","dispatch","incrementQuantity","e","preventDefault","value","decrementQuantity","isLoader","ecommerce","isLoading"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/apps/ecommerce/product/overview/DetailsRight.vue"],"sourcesContent":["<template>\r\n  <div v-if=\"isLoader\" class=\"spin\">\r\n    <a-spin />\r\n  </div>\r\n  <div v-else class=\"product-details-box__right pdbr\">\r\n    <sdHeading class=\"pdbr__title\" as=\"h2\">\r\n      {{ product.name }}\r\n    </sdHeading>\r\n    <a-rate allow-half :default-value=\"product.rate\" disabled />\r\n    <span class=\"pdbr__rating\">{{ product.rate }}</span>\r\n    <span class=\"pdbr__review-count\"> 778 Reviews</span>\r\n    <p>\r\n      <span class=\"pdbr__brand-text\">Brand :</span>\r\n      <span class=\"pdbr__brand-name\">{{ product.brand }}</span>\r\n    </p>\r\n    <sdHeading class=\"pdbr__new-price\" as=\"h3\">\r\n      <span class=\"pdbr__currency\">$</span>\r\n      <span class=\"pdbr__price\">{{ product.price }}</span>\r\n    </sdHeading>\r\n\r\n    <sdHeading v-if=\"product.oldPrice\" class=\"pdbr__old-price\" as=\"h6\">\r\n      <del>${{ product.oldPrice }}</del> <span class=\"pdbr__offer-price\">30% Off</span>\r\n    </sdHeading>\r\n\r\n    <p class=\"pdbr__desc\">{{ product.description }}</p>\r\n    <div class=\"pdbr__current-status\">\r\n      <p>\r\n        <span class=\"current-status-title\">Available:</span>\r\n        <span class=\"stock-status in-stock\"> In Stock</span>\r\n      </p>\r\n      <p>\r\n        <span class=\"current-status-title\"> Shipping: </span>\r\n        <span class=\"shipping-cost\">Free</span>\r\n      </p>\r\n      <p class=\"pdbr__quantity\">\r\n        <span class=\"current-status-title\">Quantity:</span>\r\n\r\n        <sdButton class=\"btn-inc\" @click=\"decrementQuantity\" type=\"default\"> - </sdButton>\r\n        {{ quantity }}\r\n        <sdButton class=\"btn-dec\" @click=\"incrementQuantity\" type=\"default\"> + </sdButton>\r\n        <span class=\"pdbr__availability\">540 pieces available</span>\r\n      </p>\r\n    </div>\r\n\r\n    <div class=\"pdbr__Actions d-flex align-items-center\">\r\n      <div class=\"pdbr__product-action\">\r\n        <sdButton class=\"btn-buy\" size=\"default\" type=\"primary\"> Buy Now </sdButton>\r\n        <sdButton class=\"btn-cart\" size=\"default\" type=\"secondary\">\r\n          <sdFeatherIcons type=\"shopping-bag\" size=\"14\" /> <span>Add To Cart</span>\r\n        </sdButton>\r\n        <sdButton\r\n          @click=\"() => dispatch('updateWishList', parseInt(id, 10))\"\r\n          class=\"btn-icon\"\r\n          size=\"default\"\r\n          raised\r\n          type=\"white\"\r\n          shape=\"circle\"\r\n        >\r\n          <sdFeatherIcons\r\n            type=\"heart\"\r\n            size=\"14\"\r\n            :color=\"product.popular ? '#FF4D4F' : '#9299B8'\"\r\n            :fill=\"product.popular ? '#FF4D4F' : 'none'\"\r\n          />\r\n        </sdButton>\r\n        <sdButton class=\"btn-icon\" size=\"default\" raised type=\"white\" shape=\"circle\">\r\n          <sdFeatherIcons type=\"share-2\" size=\"14\" />\r\n        </sdButton>\r\n      </div>\r\n      <div class=\"pdbr__socials\">\r\n        <a to=\"#\">\r\n          <font-awesome-icon\r\n            class=\"super-crazy-colors\"\r\n            :icon=\"faFacebookF\"\r\n            size=\"1x\"\r\n            :style=\"{ textShadow: '0 1px 0 rgba(0, 0, 0, 0.1)' }\"\r\n          />\r\n        </a>\r\n        <a to=\"#\">\r\n          <font-awesome-icon\r\n            class=\"super-crazy-colors\"\r\n            :icon=\"faTwitter\"\r\n            size=\"1x\"\r\n            :style=\"{ textShadow: '0 1px 0 rgba(0, 0, 0, 0.1)' }\"\r\n          />\r\n        </a>\r\n        <a to=\"#\">\r\n          <font-awesome-icon\r\n            class=\"super-crazy-colors\"\r\n            :icon=\"faDribbble\"\r\n            size=\"1x\"\r\n            :style=\"{ textShadow: '0 1px 0 rgba(0, 0, 0, 0.1)' }\"\r\n          />\r\n        </a>\r\n        <a to=\"#\">\r\n          <font-awesome-icon\r\n            class=\"super-crazy-colors\"\r\n            :icon=\"faInstagram\"\r\n            size=\"1x\"\r\n            :style=\"{ textShadow: '0 1px 0 rgba(0, 0, 0, 0.1)' }\"\r\n          />\r\n        </a>\r\n        <a to=\"#\">\r\n          <font-awesome-icon\r\n            class=\"super-crazy-colors\"\r\n            :icon=\"faGithub\"\r\n            size=\"1x\"\r\n            :style=\"{ textShadow: '0 1px 0 rgba(0, 0, 0, 0.1)' }\"\r\n          />\r\n        </a>\r\n      </div>\r\n    </div>\r\n    <ul class=\"pdbr__list\">\r\n      <li>\r\n        <span>Category:</span>\r\n        <span>{{ product.category }}</span>\r\n      </li>\r\n    </ul>\r\n    <ul class=\"pdbr__list\">\r\n      <li>\r\n        <span>Tags:</span>\r\n        <span>Blue, Green, Light</span>\r\n      </li>\r\n    </ul>\r\n  </div>\r\n</template>\r\n<script>\r\nimport { toRefs, ref, computed } from 'vue';\r\nimport PropTypes from 'vue-types';\r\nimport { useStore } from 'vuex';\r\nimport {\r\n  faFacebookF,\r\n  faDribbble,\r\n  faTwitter,\r\n  faInstagram,\r\n  faGithub,\r\n  faMediumM,\r\n} from '@fortawesome/free-brands-svg-icons';\r\n\r\nconst DetailsRight = {\r\n  name: 'DetailsRight',\r\n  props: {\r\n    product: PropTypes.object,\r\n  },\r\n  setup(props) {\r\n    const quantity = ref(1);\r\n    const { product } = toRefs(props);\r\n    const { state, dispatch } = useStore();\r\n\r\n    const incrementQuantity = (e) => {\r\n      e.preventDefault();\r\n      if (quantity.value !== 5) quantity.value = quantity.value + 1;\r\n    };\r\n\r\n    const decrementQuantity = (e) => {\r\n      e.preventDefault();\r\n      if (quantity.value !== 1) quantity.value = quantity.value - 1;\r\n    };\r\n\r\n    const isLoader = computed(() => state.ecommerce.isLoading);\r\n\r\n    return {\r\n      quantity,\r\n      incrementQuantity,\r\n      decrementQuantity,\r\n      product,\r\n      dispatch,\r\n      isLoader,\r\n      faFacebookF,\r\n      faDribbble,\r\n      faTwitter,\r\n      faInstagram,\r\n      faGithub,\r\n      faMediumM,\r\n    };\r\n  },\r\n};\r\n\r\nexport default DetailsRight;\r\n</script>\r\n"],"mappings":"AA+HA,SAASA,MAAM,EAAEC,GAAG,EAAEC,QAAO,QAAS,KAAK;AAC3C,OAAOC,SAAQ,MAAO,WAAW;AACjC,SAASC,QAAO,QAAS,MAAM;AAC/B,SACEC,WAAW,EACXC,UAAU,EACVC,SAAS,EACTC,WAAW,EACXC,QAAQ,EACRC,SAAS,QACJ,oCAAoC;AAE3C,MAAMC,YAAW,GAAI;EACnBC,IAAI,EAAE,cAAc;EACpBC,KAAK,EAAE;IACLC,OAAO,EAAEX,SAAS,CAACY;EACrB,CAAC;EACDC,KAAKA,CAACH,KAAK,EAAE;IACX,MAAMI,QAAO,GAAIhB,GAAG,CAAC,CAAC,CAAC;IACvB,MAAM;MAAEa;IAAQ,IAAId,MAAM,CAACa,KAAK,CAAC;IACj