> {\r\n      values.value = values;\r\n    };\r\n\r\n    const handleFinishFailed = (errors) => {\r\n      console.log(errors);\r\n    };\r\n\r\n    return {\r\n      values,\r\n      formState,\r\n      rules,\r\n      handleFinish,\r\n      handleFinishFailed,\r\n      faFacebookF,\r\n      faYoutube,\r\n      faTwitter,\r\n      faInstagram,\r\n      faGithub,\r\n      faLinkedin,\r\n    };\r\n  },\r\n});\r\n\r\nexport default SocialProfile;\r\n</script>\r\n"],"mappings":"AA0FA,SAASA,gBAAe,QAAS,iBAAiB;AAClD,SAASC,GAAG,EAAEC,QAAQ,EAAEC,eAAc,QAAS,KAAK;AACpD,SACEC,WAAW,EACXC,SAAS,EACTC,SAAS,EACTC,WAAW,EACXC,QAAQ,EACRC,UAAU,QACL,oCAAoC;AAE3C,MAAMC,aAAY,GAAIP,eAAe,CAAC;EACpCQ,IAAI,EAAE,eAAe;EACrBC,UAAU,EAAE;IAAEZ;EAAiB,CAAC;EAChCa,KAAKA,CAAA,EAAG;IACN,MAAMC,MAAK,GAAIb,GAAG,CAAC,EAAE,CAAC;IACtB,MAAMc,SAAQ,GAAIb,QAAQ,CAAC;MACzBc,QAAQ,EAAE,EAAE;MACZC,OAAO,EAAE,EAAE;MACXC,SAAS,EAAE,EAAE;MACbC,MAAM,EAAE,EAAE;MACVC,OAAO,EAAE,EAAE;MACXC,QAAQ,EAAE,EAAE;MACZC,MAAM,EAAE;IACV,CAAC,CAAC;IAEF,MAAMC,KAAI,GAAI,CAAC,CAAC;IAEhB,MAAMC,YAAW,GAAKV,MAAM,IAAK;MAC/BA,MAAM,CAACW,KAAI,GAAIX,MAAM;IACvB,CAAC;IAED,MAAMY,kBAAiB,GAAKC,MAAM,IAAK;MACrCC,OAAO,CAACC,GAAG,CAACF,MAAM,CAAC;IACrB,CAAC;IAED,OAAO;MACLb,MAAM;MACNC,SAAS;MACTQ,KAAK;MACLC,YAAY;MACZE,kBAAkB;MAClBtB,WAAW;MACXC,SAAS;MACTC,SAAS;MACTC,WAAW;MACXC,QAAQ;MACRC;IACF,CAAC;EACH;AACF,CAAC,CAAC;AAEF,eAAeC,aAAa"},"metadata":{},"sourceType":"module","externalDependencies":[]}