                               <a-form\r\n                                    name=\"info\"\r\n                                    layout=\"vertical\"\r\n                                  >\r\n                                    <a-form-item\r\n                                      name=\"number\"\r\n                                      label=\"Card Number\"\r\n                                    >\r\n                                      <a-input\r\n                                        placeholder=\"6547-8702-6987-2527\"\r\n                                      />\r\n                                    </a-form-item>\r\n                                    <a-form-item\r\n                                      name=\"name\"\r\n                                      label=\"Name on Card\"\r\n                                    >\r\n                                      <a-input placeholder=\"Full name\" />\r\n                                    </a-form-item>\r\n                                    <a-form-item\r\n                                      name=\"month\"\r\n                                      initialValue=\"\"\r\n                                      label=\"Expiration Date\"\r\n                                    >\r\n                                      <div class=\"ex-date-year-wrap d-flex\">\r\n                                        <div class=\"ex-date\">\r\n                                          <a-select\r\n                                            v-model:value=\"exDate\"\r\n                                            :style=\"{ width: '100%' }\"\r\n                                          >\r\n                                            <a-select-option value=\"\"\r\n                                              >MM</a-select-option\r\n                                            >\r\n                                            <a-select-option\r\n                                              v-for=\"value in month\"\r\n                