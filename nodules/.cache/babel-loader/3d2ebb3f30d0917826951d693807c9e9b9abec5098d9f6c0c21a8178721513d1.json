{"ast":null,"code":"import { toRefs, defineComponent } from 'vue';\nimport VueTypes from 'vue-types';\nimport { UserCard } from '../style';\nimport { faFacebookF, faDribbble, faTwitter, faInstagram } from '@fortawesome/free-brands-svg-icons';\nexport default defineComponent({\n  name: 'TeamCard',\n  components: {\n    UserCard\n  },\n  props: {\n    user: VueTypes.object\n  },\n  async setup(props) {\n    const {\n      user\n    } = toRefs(props);\n    const {\n      name,\n      designation,\n      img\n    } = user.value;\n    return {\n      name,\n      designation,\n      img,\n      faFacebookF,\n      faDribbble,\n      faTwitter,\n      faInstagram\n    };\n  }\n});","map":{"version":3,"names":["toRefs","defineComponent","VueTypes","UserCard","faFacebookF","faDribbble","faTwitter","faInstagram","name","components","props","user","object","setup","designation","img","value"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/pages/overview/TeamCard.vue"],"sourcesContent":["<template>\r\n  <UserCard>\r\n    <div class=\"card team-card\">\r\n      <sdCards headless>\r\n        <figure>\r\n          <img :src=\"require(`@/${img}`)\" alt=\"\" />\r\n          <figcaption>\r\n            <div class=\"edit\">\r\n              <sdDropdown :action=\"['click']\" class=\"wide-dropdwon\">\r\n                <template #overlay>\r\n                  <slot name=\"item\"></slot>\r\n                </template>\r\n                <router-link to=\"#\" class=\"card__more_actions\">\r\n                  <sdFeatherIcons type=\"more-horizontal\" size=\"16\" />\r\n                </router-link>\r\n              </sdDropdown>\r\n            </div>\r\n            <sdHeading class=\"card__name\" as=\"h6\">\r\n              <router-link to=\"#\">{{ name }}</router-link>\r\n            </sdHeading>\r\n            <span class=\"card__designation\">{{ designation }}</span>\r\n            <div class=\"card__social\">\r\n              <a class=\"btn-icon facebook\" to=\"#\">\r\n                <font-awesome-icon :icon=\"faFacebookF\" size=\"1x\" />\r\n              </a>\r\n              <a class=\"btn-icon twitter\" to=\"#\">\r\n                <font-awesome-icon :icon=\"faTwitter\" size=\"1x\" />\r\n              </a>\r\n              <a class=\"btn-icon dribble\" to=\"#\">\r\n                <font-awesome-icon :icon=\"faDribbble\" size=\"1x\" />\r\n              </a>\r\n              <a class=\"btn-icon instagram\" to=\"#\">\r\n                <font-awesome-icon :icon=\"faInstagram\" size=\"1x\" />\r\n              </a>\r\n            </div>\r\n          </figcaption>\r\n        </figure>\r\n      </sdCards>\r\n    </div>\r\n  </UserCard>\r\n</template>\r\n\r\n<script>\r\nimport { toRefs, defineComponent } from 'vue';\r\nimport VueTypes from 'vue-types';\r\nimport { UserCard } from '../style';\r\nimport { faFacebookF, faDribbble, faTwitter, faInstagram } from '@fortawesome/free-brands-svg-icons';\r\nexport default defineComponent({\r\n  name: 'TeamCard',\r\n  components: { UserCard },\r\n  props: {\r\n    user: VueTypes.object,\r\n  },\r\n  async setup(props) {\r\n    const { user } = toRefs(props);\r\n    const { name, designation, img } = user.value;\r\n    return { name, designation, img, faFacebookF, faDribbble, faTwitter, faInstagram };\r\n  },\r\n});\r\n</script>\r\n"],"mappings":"AA2CA,SAASA,MAAM,EAAEC,eAAc,QAAS,KAAK;AAC7C,OAAOC,QAAO,MAAO,WAAW;AAChC,SAASC,QAAO,QAAS,UAAU;AACnC,SAASC,WAAW,EAAEC,UAAU,EAAEC,SAAS,EAAEC,WAAU,QAAS,oCAAoC;AACpG,eAAeN,eAAe,CAAC;EAC7BO,IAAI,EAAE,UAAU;EAChBC,UAAU,EAAE;IAAEN;EAAS,CAAC;EACxBO,KAAK,EAAE;IACLC,IAAI,EAAET,QAAQ,CAACU;EACjB,CAAC;EACD,MAAMC,KAAKA,CAACH,KAAK,EAAE;IACjB,MAAM;MAAEC;IAAK,IAAIX,MAAM,CAACU,KAAK,CAAC;IAC9B,MAAM;MAAEF,IAAI;MAAEM,WAAW;MAAEC;IAAI,IAAIJ,IAAI,CAACK,KAAK;IAC7C,OAAO;MAAER,IAAI;MAAEM,WAAW;MAAEC,GAAG;MAAEX,WAAW;MAAEC,UAAU;MAAEC,SAAS;MAAEC;IAAY,CAAC;EACpF;AACF,CAAC,CAAC"},"metadata":{},"sourceType":"module","externalDependencies":[]}