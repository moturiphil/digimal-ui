  </a-radio-button>\r\n                  </a-radio-group>\r\n                </div>\r\n              </a-col>\r\n              <a-col :xxl=\"4\" :xs=\"24\">\r\n                <div class=\"table-toolbox-actions\">\r\n                  <sdButton size=\"small\" type=\"secondary\" transparented> Export </sdButton>\r\n                  <sdButton size=\"small\" type=\"primary\"> <sdFeatherIcons type=\"plus\" size=\"12\" /> Add Order </sdButton>\r\n                </div>\r\n              </a-col>\r\n            </a-row>\r\n          </TopToolBox>\r\n        </a-col>\r\n      </a-row>\r\n      <a-row :gutter=\"15\">\r\n        <a-col :md=\"24\">\r\n          <TableWrapper class=\"table-order table-responsive\">\r\n            <a-table\r\n              :rowSelection=\"rowSelection\"\r\n              :dataSource=\"dataSource\"\r\n              :columns=\"columns\"\r\n              :pagination=\"{ pageSize: 7, showSizeChanger: true, total: orders ? orders.length : 20 }\"\r\n            />\r\n          </TableWrapper>\r\n        </a-col>\r\n      </a-row>\r\n    </sdCards>\r\n  </Main>\r\n</template>\r\n<script>\r\nimport { TopToolBox } from './Style';\r\nimport { Main, TableWrapper } from '../../styled';\r\nimport { computed, ref, defineComponent } from 'vue';\r\nimport { useStore } from 'vuex';\r\n\r\nconst columns = [\r\n  {\r\n    title: 'Order Id',\r\n    dataIndex: 'id',\r\n    key: 'id',\r\n  },\r\n  {\r\n    title: 'customer',\r\n    dataIndex: 'customer',\r\n    key: 'customer',\r\n  },\r\n  {\r\n    title: 'Status',\r\n    dataIndex: 'status',\r\n    key: 'status',\r\n  },\r\n  {\r\n    title: 'Amount',\r\n    dataIndex: 'amount',\r\n    key: 'amount',\r\n  },\r\n  {\r\n    title: 'Date',\r\n    dataIndex: 'date',\r\n    key: 'date',\r\n  },\r\n  {\r\n    title: 'Action',\r\n    dataIndex: 'action',\r\n    key: 'action',\r\n  },\r\n];\r\n\r\nconst Orders = defineComponent({\r\n  name: 'Orders',\r\n  components: { TopToolBox, Main, TableWrapper },\r\n\r\n  setup() {\r\n    const { state, dispatch } = useStore();\r\n    const searchData = computed(() => state.headerSearchData);\r\n    const orders = computed(() => state.orders.data);\r\n\r\n    const item = computed(() => state.orders.data);\r\n    const selectedRowKeys = ref([]);\r\n    const stateValue = ref('');\r\n    const filterKey = ref(['Shipped', 'Awaiting Shipment', 'Canceled']);\r\n\r\n    const handleChangeForFilter = (e) => {\r\n      dispatch('orderFilter', { column: 'status', value: e.target.value });\r\n    };\r\n\r\n    const dataSource = computed(() =>\r\n      orders.value.map((value, key) => {\r\n        const { status, orderId, customers, amount, date } = value;\r\n        return {\r\n          key: key + 1,\r\n          id: <span class=\"order-id\">{orderId}</span>,\r\n          customer: <span class=\"customer-name\">{customers}</span>,\r\n          status: (\r\n            <span\r\n              class={`status ${\r\n                status === 'Shipped' ? 'Success' : status === 'Awaiting Shipment' ? 'warning' : 'error'\r\n              }`}\r\n            >\r\n              {status}\r\n            </span>\r\n          ),\r\n          amount: <span class=\"ordered-amount\">{amount}</span>,\r\n          date: <span class=\"ordered-date\">{date}</span>,\r\n          action: (\r\n            <div class=\"table-actions\">\r\n              <>\r\n                <sdButton class=\"btn-icon\" type=\"primary\" to=\"#\" shape=\"circle\">\r\n                  <sdFeatherIcons type=\"eye\" size={16} />\r\n                </sdButton>\r\n                <sdButton class=\"btn-icon\" type=\"info\" to=\"#\" shape=\"circle\">\r\n                  <sdFeatherIcons type=\"edit\" size={16} />\r\n                </sdButton>\r\n                <sdButton class=\"btn-icon\" type=\"danger\" to=\"#\" shape=\"circle\">\r\n                  <sdFeatherIcons type=\"trash-2\" size={16} />\r\n                </sdButton>\r\n              </>\r\n            </div>\r\n          ),\r\n        };\r\n      }),\r\n    );\r\n\r\n    const onSelectChange = (selectedRowKey) => {\r\n      selectedRowKeys.value = selectedRowKey;\r\n    };\r\n\r\n    const rowSelection = {\r\n      onChange: (selectedRowKeys) => {\r\n        onSelectChange(selectedRowKeys);\r\n      },\r\n    };\r\n    return {\r\n      rowSelection,\r\n      onSelectChange,\r\n      dataSource,\r\n      handleChangeForFilter,\r\n      filterKey,\r\n      item,\r\n      searchData,\r\n      columns,\r\n      orders,\r\n      stateValue,\r\n    };\r\n  },\r\n});\r\n\r\nexport default Orders;\r\n</script>\r\n"],"mappings":";AA8DA,SAASA,UAAS,QAAS,SAAS;AACpC,SAASC,IAAI,EAAEC,YAAW,QAAS,cAAc;AACjD,SAASC,QAAQ,EAAEC,GAAG,EAAEC,eAAc,QAAS,KAAK;AACpD,SAASC,QAAO,QAAS,MAAM;AAE/B,MAAMC,OAAM,GAAI,CACd;EACEC,KAAK,EAAE,UAAU;EACjBC,SAAS,EAAE,IAAI;EACfC,GAAG,EAAE;AACP,CAAC,EACD;EACEF,KAAK,EAAE,UAAU;EACjBC,SAAS,EAAE,UAAU;EACrBC,GAAG,EAAE;AACP,CAAC,EACD;EACEF,KAAK,EAAE,QAAQ;EACfC,SAAS,EAAE,QAAQ;EACnBC,GAAG,EAAE;AACP,CAAC,EACD;EACEF,KAAK,EAAE,QAAQ;EACfC,SAAS,EAAE,QAAQ;EACnBC,GAAG,EAAE;AACP,CAAC,EACD;EACEF,KAAK,EAAE,MAAM;EACbC,SAAS,EAAE,MAAM;EACjBC,GAAG,EAAE;AACP,CAAC,EACD;EACEF,KAAK,EAAE,QAAQ;EACfC,SAAS,EAAE,QAAQ;EACnBC,GAAG,EAAE;AACP,CAAC,CACF;AAED,MAAMC,MAAK,GAAIN,eAAe,CAAC;EAC7BO,IAAI,EAAE,QAAQ;EACdC,UAAU,EAAE;IAAEb,UAAU;IAAEC,IAAI;IAAEC;EAAa,CAAC;EAE9CY,KAAKA,CAAA,EAAG;IACN,MAAM;MAAEC,KAAK;MAAEC;IAAS,IAAIV,QAAQ,EAAE;IACtC,MAAMW,UAAS,GAAId,QAAQ,CAAC,MAAMY,KAAK,CAACG,gBAAgB,CAAC;IACzD,MAAMC,MAAK,GAAIhB,QAAQ,CAAC,MAAMY,KAAK,CAACI,MAAM,CAACC,IAAI,CAAC;IAEhD,MAAMC,IAAG,GAAIlB,QAAQ,CAAC,MAAMY,KAAK,CAACI,MAAM,CAACC,IAAI,CAAC;IAC9C,MAAME,eAAc,GAAIlB,GAAG,CAAC,EAAE,CAAC;IAC/B,MAAMmB,UAAS,GAAInB,GAAG,CAAC,EAAE,CAAC;IAC1B,MAAMoB,SAAQ,GAAIpB,GAAG,CAAC,CAAC,SAAS,EAAE,mBAAmB,EAAE,UAAU,CAAC,CAAC;IAEnE,MAAMqB,qBAAoB,GAAKC,CAAC,IAAK;MACnCV,QAAQ,CAAC,aAAa,EAAE;QAAEW,MAAM,EAAE,QAAQ;QAAEC,KAAK,EAAEF,CAAC,CAACG,MAAM,CAACD;MAAM,CAAC,CAAC;IACtE,CAAC;IAED,MAAME,UAAS,GAAI3B,QAAQ,CAAC,MAC1BgB,MAAM,CAACS,KAAK,CAACG,GAAG,CAAC,CAACH,KAAK,EAAElB,G