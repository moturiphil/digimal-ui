\n        }, [status]),\n        amount: _createVNode(\"span\", {\n          \"class\": \"ordered-amount\"\n        }, [amount]),\n        date: _createVNode(\"span\", {\n          \"class\": \"ordered-date\"\n        }, [date]),\n        action: _createVNode(\"div\", {\n          \"class\": \"table-actions\"\n        }, [_createVNode(_Fragment, null, [_createVNode(_resolveComponent(\"sdButton\"), {\n          \"class\": \"btn-icon\",\n          \"type\": \"primary\",\n          \"to\": \"#\",\n          \"shape\": \"circle\"\n        }, {\n          default: () => [_createVNode(_resolveComponent(\"sdFeatherIcons\"), {\n            \"type\": \"eye\",\n            \"size\": 16\n          }, null)]\n        }), _createVNode(_resolveComponent(\"sdButton\"), {\n          \"class\": \"btn-icon\",\n          \"type\": \"info\",\n          \"to\": \"#\",\n          \"shape\": \"circle\"\n        }, {\n          default: () => [_createVNode(_resolveComponent(\"sdFeatherIcons\"), {\n            \"type\": \"edit\",\n            \"size\": 16\n          }, null)]\n        }), _createVNode(_resolveComponent(\"sdButton\"), {\n          \"class\": \"btn-icon\",\n          \"type\": \"danger\",\n          \"to\": \"#\",\n          \"shape\": \"circle\"\n        }, {\n          default: () => [_createVNode(_resolveComponent(\"sdFeatherIcons\"), {\n            \"type\": \"trash-2\",\n            \"size\": 16\n          }, null)]\n        })])])\n      };\n    }));\n    const onSelectChange = selectedRowKey => {\n      selectedRowKeys.value = selectedRowKey;\n    };\n    const rowSelection = {\n      onChange: selectedRowKeys => {\n        onSelectChange(selectedRowKeys);\n      }\n    };\n    return {\n      rowSelection,\n      onSelectChange,\n      dataSource,\n      handleChangeForFilter,\n      filterKey,\n      item,\n      searchData,\n      columns,\n      orders,\n      stateValue\n    };\n  }\n});\nexport default Orders;","map":{"version":3,"names":["TopToolBox","Main","Tab