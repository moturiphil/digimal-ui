,"map":{"version":3,"names":["computed","onMounted","ref","defineComponent","useStore","TopSellerWrap","sellingColumns","title","dataIndex","key","TopSellingProduct","name","components","setup","state","dispatch","topSaleState","chartContent","topSaleData","products","handleActiveChangeProducts","event","value","preventDefault","sellingData","map","img","price","sold","revenue","_createVNode","require"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/dashboard/overview/sales/TopSellingProduct.vue"],"sourcesContent":["<template>\r\n  <div class=\"full-width-table\">\r\n    <sdCards title=\"Top Selling Products\" bodypadding=\"0px\" more>\r\n      <template #button>\r\n        <div class=\"card-nav\">\r\n          <ul>\r\n            <li :class=\"products === 'today' ? 'active' : 'deactivate'\">\r\n              <router-link\r\n                @click=\"(e) => handleActiveChangeProducts(e, 'today')\"\r\n                to=\"#\"\r\n              >\r\n                Today\r\n              </router-link>\r\n            </li>\r\n            <li :class=\"products === 'week' ? 'active' : 'deactivate'\">\r\n              <router-link\r\n                @click=\"(e) => handleActiveChangeProducts(e, 'week')\"\r\n                to=\"#\"\r\n              >\r\n                Week\r\n              </router-link>\r\n            </li>\r\n            <li :class=\"products === 'month' ? 'active' : 'deactivate'\">\r\n              <router-link\r\n                @click=\"(e) => handleActiveChangeProducts(e, 'month')\"\r\n                to=\"#\"\r\n              >\r\n                Month\r\n              </router-link>\r\n            </li>\r\n            <li :class=\"products === 'year' ? 'active' : 'deactivate'\">\r\n              <router-link\r\n                @click=\"(e) => handleActiveChangeProducts(e, 'year')\"\r\n                to=\"#\"\r\n              >\r\n                Year\r\n              </router-link>\r\n            </li>\r\n          </ul>\r\n        </div>\r\n      </template>\r\n      <template #more>\r\n        <router-link to=\"#\">\r\n          <span>2 years</span>\r\n        </router-link>\r\n        <router-link to=\"#\">\r\n          <span>3 years</span>\r\n        </router-link>\r\n        <router-link to=\"#\">\r\n          <span>4 years</span>\r\n        </router-link>\r\n      </template>\r\n      <TopSellerWrap>\r\n        <div class=\"table-bordered top-seller-table table-responsive\">\r\n          <a-table\r\n            :columns=\"sellingColumns\"\r\n            :dataSource=\"sellingData\"\r\n            :pagination=\"false\"\r\n          />\r\n        </div>\r\n      </TopSellerWrap>\r\n    </sdCards>\r\n  </div>\r\n</template>\r\n<script>\r\nimport { computed, onMounted, ref, defineComponent } from \"vue\";\r\nimport { useStore } from \"vuex\";\r\nimport { TopSellerWrap } from \"../../style\";\r\n\r\nconst sellingColumns = [\r\n  {\r\n    title: \"Product Name\",\r\n    dataIndex: \"name\",\r\n    key: \"name\",\r\n  },\r\n  {\r\n    title: \"Price\",\r\n    dataIndex: \"price\",\r\n    key: \"price\",\r\n  },\r\n  {\r\n    title: \"Sold\",\r\n    dataIndex: \"sold\",\r\n    key: \"sold\",\r\n  },\r\n  {\r\n    title: \"Revenue\",\r\n    dataIndex: \"revenue\",\r\n    key: \"revenue\",\r\n  },\r\n];\r\n\r\nconst TopSellingProduct = defineComponent({\r\n  name: \"TopSellingProduct\",\r\n  components: { TopSellerWrap },\r\n  setup() {\r\n    const { state, dispatch } = useStore();\r\n    const topSaleState = computed(() => state.chartContent.topSaleData);\r\n    const products = ref(\"year\");\r\n    onMounted(() => dispatch(\"topSaleGetData\"));\r\n    const handleActiveChangeProducts = (event, value) => {\r\n      event.preventDefault();\r\n      products.value = value;\r\n      dispatch(\"topSaleFilterData\", value);\r\n    };\r\n\r\n    const sellingData = computed(() =>\r\n      topSaleState.value\r\n        ? topSaleState.value.map((value) => {\r\n            const { key, name, img, price,