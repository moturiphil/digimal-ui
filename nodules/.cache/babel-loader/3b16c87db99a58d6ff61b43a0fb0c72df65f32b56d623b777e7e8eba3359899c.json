{"ast":null,"code":"import { RecordViewWrapper } from \"../style\";\nimport { Main, TableWrapper } from \"../../styled\";\nimport { useStore } from \"vuex\";\nimport { computed, onMounted, ref, reactive, defineComponent } from \"vue\";\n// import axios from \"axios\";\nimport authHeader from \"../../../services/auth-header\";\nconst columns = [{\n  title: \"Distribution Point\",\n  dataIndex: \"drop_off_point_id\",\n  key: \"id\"\n}, {\n  title: \"Received From\",\n  dataIndex: \"received_from\",\n  key: \"id\"\n}, {\n  title: \"Received By\",\n  dataIndex: \"received_by\",\n  key: \"id\"\n}, {\n  title: \"No of Bales\",\n  dataIndex: \"no_of_bales\",\n  key: \"id\"\n}, {\n  title: \"Total Nets\",\n  dataIndex: \"total_no_nets\",\n  key: \"id\"\n}, {\n  title: \"Date Received\",\n  dataIndex: \"date_received\",\n  key: \"id\"\n}];\nconst DragAndDropTable = defineComponent({\n  name: \"ViewPage\",\n  components: {\n    RecordViewWrapper,\n    Main,\n    TableWrapper\n  },\n  setup() {\n    const {\n      state,\n      dispatch\n    } = useStore();\n    const crud = computed(() => state.crud.data);\n    const isLoading = computed(() => state.crud.loading);\n    const selectedRowKeys = ref([]);\n    const dataSource = ref([]);\n    console.log(authHeader());\n\n    //   const api_url = UserService;\n    //   console.log(api_url);\n\n    onMounted(async () => {\n      try {\n        const response = await fetch(`${process.env.VUE_APP_BASE_URL}/net_deliveries_drop_of_points`, {\n          method: \"GET\",\n          headers: authHeader()\n        });\n        console.log(response);\n        const data = await response.json();\n        dataSource.value = data.data;\n        console.log(data.data);\n      } catch (error) {\n        console.error(error);\n      }\n    });\n    const handleDelete = id => {\n      const confirm = window.confirm(\"Are you sure delete this?\");\n      if (confirm) {\n        dispatch(\"axiosDataDelete\", {\n          id,\n          getData: () => {\n            dispatch(\"axiosCrudGetData\");\n          }\n        });\n      }\n      return false;\n    };\n    const formState = reactive({\n      searchItem: \"\"\n    });\n    const onSelectChange = selectedRowKey => {\n      selectedRowKeys.value = selectedRowKey;\n    };\n    const rowSelection = {\n      selectedRowKeys,\n      onChange: onSelectChange\n    };\n    return {\n      crud,\n      isLoading,\n      selectedRowKeys,\n      handleDelete,\n      rowSelection,\n      onSelectChange,\n      dataSource,\n      columns,\n      formState\n    };\n  }\n});\nexport default DragAndDropTable;","map":{"version":3,"names":["RecordViewWrapper","Main","TableWrapper","useStore","computed","onMounted","ref","reactive","defineComponent","authHeader","columns","title","dataIndex","key","DragAndDropTable","name","components","setup","state","dispatch","crud","data","isLoading","loading","selectedRowKeys","dataSource","console","log","response","fetch","process","env","VUE_APP_BASE_URL","method","headers","json","value","error","handleDelete","id","confirm","window","getData","formState","searchItem","onSelectChange","selectedRowKey","rowSelection","onChange"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/pages/net-distribution/DistributionPointNets.vue"],"sourcesContent":["<template>\n    <RecordViewWrapper>\n      <sdPageHeader title=\"Nets Summary At Distribution Point\">\n        <template #subTitle>\n          <sdButton class=\"btn-add_new\" size=\"default\" type=\"success\">\n          </sdButton>\n        </template>\n      </sdPageHeader>\n      <Main>\n        <a-row :gutter=\"15\">\n          <a-col class=\"w-100\" :md=\"24\">\n            <sdCards headless>\n              <div v-if=\"isLoading\" class=\"spin\">\n                <a-spin />\n              </div>\n  \n              <div v-else>\n                <TableWrapper class=\"table-data-view table-responsive\">\n                  <a-table\n                    :pagination=\"{ pageSize: 10, showSizeChanger: true }\"\n                    :dataSource=\"dataSource\"\n                    :columns=\"columns\"\n                  />\n                </TableWrapper>\n              </div>\n            </sdCards>\n          </a-col>\n        </a-row>\n        <a-col :xs=\"24\">\n          <DragAndDropTable />\n        </a-col>\n      </Main>\n    </RecordViewWrapper>\n  </template>\n  <script>\n  import { RecordViewWrapper } from \"../style\";\n  import { Main, TableWrapper } from \"../../styled\";\n  import { useStore } from \"vuex\";\n  import { computed, onMounted, ref, reactive, defineComponent } from \"vue\";\n  // import axios from \"axios\";\n  import authHeader from \"../../../services/auth-header\";\n  \n  const columns = [\n  {\n      title: \"Distribution Point\",\n      dataIndex: \"drop_off_point_id\",\n      key: \"id\",\n    },\n    {\n      title: \"Received From\",\n      dataIndex: \"received_from\",\n      key: \"id\",\n    },\n    {\n      title: \"Received By\",\n      dataIndex: \"received_by\",\n      key: \"id\",\n    },\n    {\n      title: \"No of Bales\",\n      dataIndex: \"no_of_bales\",\n      key: \"id\",\n    },\n    {\n      title: \"Total Nets\",\n      dataIndex: \"total_no_nets\",\n      key: \"id\",\n    },\n    {\n      title: \"Date Received\",\n      dataIndex: \"date_received\",\n      key: \"id\",\n    },\n  ];\n  \n  \n  const DragAndDropTable = defineComponent({\n    name: \"ViewPage\",\n    components: { RecordViewWrapper, Main, TableWrapper },\n  \n    setup() {\n      const { state, dispatch } = useStore();\n      const crud = computed(() => state.crud.data);\n      const isLoading = computed(() => state.crud.loading);\n      const selectedRowKeys = ref([]);\n      const dataSource = ref([]);\n  \n      console.log(authHeader());\n  \n      //   const api_url = UserService;\n      //   console.log(api_url);\n  \n      onMounted(async () => {\n        try {\n          const response = await fetch(\n            `${process.env.VUE_APP_BASE_URL}/net_deliveries_drop_of_points`,\n            {\n              method: \"GET\",\n              headers: authHeader(),\n            }\n          );\n          console.log(response);\n          const data = await response.json();\n          dataSource.value = data.data;\n          console.log(data.data);\n        } catch (error) {\n          console.error(error);\n        }\n      });\n  \n      const handleDelete = (id) => {\n        const confirm = window.confirm(\"Are you sure delete this?\");\n        if (confirm) {\n          dispatch(\"axiosDataDelete\", {\n            id,\n            getData: () => {\n              dispatch(\"axiosCrudGetData\");\n            },\n          });\n        }\n        return false;\n      };\n  \n      const formState = reactive({\n        searchItem: \"\",\n      });\n  \n      const onSelectChange = (selectedRowKey) => {\n        selectedRowKeys.value = selectedRowKey;\n      };\n  \n      const rowSelection = {\n        selectedRowKeys,\n        onChange: onSelectChange,\n      };\n  \n      return {\n        crud,\n        isLoading,\n        selectedRowKeys,\n        handleDelete,\n        rowSelection,\n        onSelectChange,\n        dataSource,\n        columns,\n        formState,\n      };\n    },\n  });\n  \n  export default DragAndDropTable;\n  </script>\n  "],"mappings":"AAmCE,SAASA,iBAAgB,QAAS,UAAU;AAC5C,SAASC,IAAI,EAAEC,YAAW,QAAS,cAAc;AACjD,SAASC,QAAO,QAAS,MAAM;AAC/B,SAASC,QAAQ,EAAEC,SAAS,EAAEC,GAAG,EAAEC,QAAQ,EAAEC,eAAc,QAAS,KAAK;AACzE;AACA,OAAOC,UAAS,MAAO,+BAA+B;AAEtD,MAAMC,OAAM,GAAI,CAChB;EACIC,KAAK,EAAE,oBAAoB;EAC3BC,SAAS,EAAE,mBAAmB;EAC9BC,GAAG,EAAE;AACP,CAAC,EACD;EACEF,KAAK,EAAE,eAAe;EACtBC,SAAS,EAAE,eAAe;EAC1BC,GAAG,EAAE;AACP,CAAC,EACD;EACEF,KAAK,EAAE,aAAa;EACpBC,SAAS,EAAE,aAAa;EACxBC,GAAG,EAAE;AACP,CAAC,EACD;EACEF,KAAK,EAAE,aAAa;EACpBC,SAAS,EAAE,aAAa;EACxBC,GAAG,EAAE;AACP,CAAC,EACD;EACEF,KAAK,EAAE,YAAY;EACnBC,SAAS,EAAE,eAAe;EAC1BC,GAAG,EAAE;AACP,CAAC,EACD;EACEF,KAAK,EAAE,eAA