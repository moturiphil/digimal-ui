{"ast":null,"code":"import { UserTableStyleWrapper } from \"../style\";\nimport { TableWrapper } from \"../../../styled\";\nimport { computed, defineComponent, onMounted, ref } from \"vue\";\nimport { useRoute } from \"vue-router\";\nimport authHeader from \"../../../../../src/services/auth-header\";\nimport axios from \"axios\";\nimport { useStore } from \"vuex\";\nconst columns = [{\n  title: \"Participant Name\",\n  dataIndex: \"fullName\",\n  key: \"id\"\n  // render: (text, record) => `${record.first_name} ${record.last_name}`,\n}, {\n  title: \"Participant Phone\",\n  dataIndex: \"phone_no\",\n  key: \"id\"\n}, {\n  title: \"Organization\",\n  dataIndex: \"org_types_id\",\n  key: \"id\"\n}, {\n  title: \"Role\",\n  dataIndex: \"role_id\",\n  key: \"id\"\n}];\nconst EventCampaignTable = defineComponent({\n  name: \"EventCampaignTable\",\n  components: {\n    UserTableStyleWrapper,\n    TableWrapper\n  },\n  setup() {\n    const {\n      state\n    } = useStore();\n    const eventData = computed(() => state.crud.data);\n    const dataSource = ref([]);\n    const selectedRowKeys = ref([]);\n    const API_URL = `${process.env.VUE_APP_BASE_URL}`;\n    const {\n      query\n    } = useRoute();\n    onMounted(async () => {\n      try {\n        const response = await axios.get(`${API_URL}/events/${query.id}/participants?status=1`, {\n          headers: authHeader()\n        });\n        // console.log(response.data.data);\n\n        const updatedData = response.data.data.map(record => {\n          let fullName = `${record.first_name} ${record.last_name}`;\n          // fullName = fullName.toUpperCase();\n          return {\n            ...record,\n            fullName\n          };\n        });\n        dataSource.value = response.data.data;\n        // console.log(updatedData);\n        dataSource.value = updatedData;\n\n        // console.log(dataSource.value);\n      } catch (error) {\n        console.error(error);\n      }\n    });\n    const onSelectChange = selectedRowKey => {\n      selectedRowKeys.value = selectedRowKey;\n    };\n    const rowSelection = {\n      selectedRowKeys,\n      onChange: onSelectChange\n    };\n    return {\n      columns,\n      eventData,\n      rowSelection,\n      dataSource,\n      selectedRowKeys,\n      onSelectChange\n    };\n  }\n});\nexport default EventCampaignTable;","map":{"version":3,"names":["UserTableStyleWrapper","TableWrapper","computed","defineComponent","onMounted","ref","useRoute","authHeader","axios","useStore","columns","title","dataIndex","key","EventCampaignTable","name","components","setup","state","eventData","crud","data","dataSource","selectedRowKeys","API_URL","process","env","VUE_APP_BASE_URL","query","response","get","id","headers","updatedData","map","record","fullName","first_name","last_name","value","error","console","onSelectChange","selectedRowKey","rowSelection","onChange"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/pages/campaigns/CampaignTable/EventCampaign.vue"],"sourcesContent":["<template>\r\n  <UserTableStyleWrapper>\r\n    <TableWrapper class=\"table-responsive\">\r\n      <a-table\r\n        :pagination=\"{ pageSize: 10, showSizeChanger: true }\"\r\n        :dataSource=\"dataSource\"\r\n        :columns=\"columns\"\r\n      >\r\n        <template #events=\"{ record }\">\r\n          <td>\r\n            <div class=\"table-actions\">\r\n              <sdButton @click=\"showSuccessModal\" size=\"small\" type=\"success\">\r\n                <sdFeatherIcons type=\"edit-3\" size=\"16\" />\r\n                &nbsp;&nbsp; Enroll Participants\r\n              </sdButton>\r\n              <sdButton>\r\n                <router-link\r\n                  :to=\"`/event/view/${record.id}`\"\r\n                  class=\"btn-icon\"\r\n                  type=\"info\"\r\n                  shape=\"circle\"\r\n                >\r\n                  <sdFeatherIcons type=\"eye\" size=\"16\" />\r\n                  &nbsp;&nbsp; View\r\n                </router-link>\r\n                <!-- <sdFeatherIcons type=\"edit\" size=\"16\" /> -->\r\n                <!-- &nbsp;&nbsp; View -->\r\n              </sdButton>\r\n              <sdButton\r\n                class=\"btn-icon\"\r\n                type=\"danger\"\r\n                @click=\"handleDelete(record.id)\"\r\n                shape=\"circle\"\r\n              >\r\n                <sdFeatherIcons type=\"trash-2\" size=\"16\" />\r\n                <a href=\"\" title=\"Delete\"></a>\r\n                <!-- &nbsp;&nbsp; Delete -->\r\n              </sdButton>\r\n            </div>\r\n          </td>\r\n        </template>\r\n      </a-table>\r\n    </TableWrapper>\r\n  </UserTableStyleWrapper>\r\n</template>\r\n\r\n<script>\r\nimport { UserTableStyleWrapper } from \"../style\";\r\nimport { TableWrapper } from \"../../../styled\";\r\nimport { computed, defineComponent, onMounted, ref } from \"vue\";\r\nimport { useRoute } from \"vue-router\";\r\nimport authHeader from \"../../../../../src/services/auth-header\";\r\nimport axios from \"axios\";\r\nimport { useStore } from \"vuex\";\r\n\r\nconst columns = [\r\n  {\r\n    title: \"Participant Name\",\r\n    dataIndex: \"fullName\",\r\n    key: \"id\",\r\n    // render: (text, record) => `${record.first_name} ${record.last_name}`,\r\n  },\r\n  {\r\n    title: \"Participant Phone\",\r\n    dataIndex: \"phone_no\",\r\n    key: \"id\",\r\n  },\r\n  {\r\n    title: \"Organization\",\r\n    dataIndex: \"org_types_id\",\r\n    key: \"id\",\r\n  },\r\n  {\r\n    title: \"Role\",\r\n    dataIndex: \"role_id\",\r\n    key: \"id\",\r\n  },\r\n];\r\n\r\nconst EventCampaignTable = defineComponent({\r\n  name: \"EventCampaignTable\",\r\n  components: { UserTableStyleWrapper, TableWrapper },\r\n  setup() {\r\n    const { state } = useStore();\r\n    const eventData = computed(() => state.crud.data);\r\n\r\n    const dataSource = ref([]);\r\n    const selectedRowKeys = ref([]);\r\n\r\n    const API_URL = `${process.env.VUE_APP_BASE_URL}`;\r\n\r\n    const { query } = useRoute();\r\n\r\n    onMounted(async () => {\r\n      try {\r\n        const response = await axios.get(\r\n          `${API_URL}/events/${query.id}/participants?status=1`,\r\n          {\r\n            headers: authHeader(),\r\n          }\r\n        );\r\n        // console.log(response.data.data);\r\n\r\n        const updatedData = response.data.data.map((record) => {\r\n          let fullName = `${record.first_name} ${record.last_name}`;\r\n          // fullName = fullName.toUpperCase();\r\n          return {\r\n            ...record,\r\n            fullName,\r\n          };\r\n        });\r\n\r\n        dataSource.value = response.data.data;\r\n        // console.log(updatedData);\r\n        dataSource.value = updatedData;\r\n\r\n        // console.log(dataSource.value);\r\n      } catch (error) {\r\n        console.error(error);\r\n      }\r\n    });\r\n\r\n    const onSelectChange = (selectedRowKey) => {\r\n      selectedRowKeys.value = selectedRowKey;\r\n    };\r\n\r\n    const rowSelection = {\r\n      selectedRowKeys,\r\n      onChange: onSelectChange,\r\n    };\r\n\r\n    return {\r\n      columns,\r\n      eventData,\r\n      rowSelection,\r\n      dataSource,\r\n      selectedRowKeys,\r\n      onSelectChange,\r\n    };\r\n  },\r\n});\r\n\r\nexport default EventCampaignTable;\r\n</script>\r\n"],"mappings":"AA+CA,SAASA,qBAAoB,QAAS,UAAU;AAChD,SAASC,YAAW,QAAS,iBAAiB;AAC9C,SAASC,QAAQ,EAAEC,eAAe,EAAEC,SAAS,EAAEC,GAAE,QAAS,KAAK;AAC/D,SAASC,QAAO,QAAS,YAAY;AACrC,OAAOC,UAAS,MAAO,yCAAyC;AAChE,OAAOC,KAAI,MAAO,OAAO;AACzB,SAASC,QAAO,QAAS,MAAM;AAE/B,MAAMC,OAAM,GAAI,CACd;EACEC,KAAK,EAAE,kBAAkB;EACzBC,SAAS,EAAE,UAAU;EACrBC,GAAG,EAAE;EACL;AACF,CAAC,EACD;EACEF,KAAK,EAAE,mBAAmB;EAC1BC,SAAS,EAAE,UAAU;EACrBC,GAAG,EAAE;AACP,CAAC,EACD;EACEF,KAAK,EAAE,cAAc;EACrBC,SAAS,EAAE,cAAc;EACzBC,GAAG,EAAE;AACP,CAAC,EACD;EACEF,KAAK,EAAE,MAAM;EACbC,SAAS,EAAE,SAAS;EACpBC,GAAG,EAAE;AACP,CAAC,CACF;AAED,MAAMC,kBAAiB,GAAIX,eAAe,CAAC;EACzCY,IAAI,EAAE,oBAAoB;E