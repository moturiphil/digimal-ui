{"ast":null,"code":"import { computed, ref, defineComponent } from 'vue';\nimport { useStore } from 'vuex';\nimport { TableWrapper, DragDropStyle } from '../styled';\nimport draggable from 'vuedraggable';\nconst DragAndDropTable = defineComponent({\n  name: 'DragAndDropTable',\n  components: {\n    TableWrapper,\n    DragDropStyle,\n    draggable\n  },\n  setup() {\n    const {\n      state\n    } = useStore();\n    const users = computed(() => state.users.data);\n    const dragAbleData = ref(users.value);\n    return {\n      users,\n      dragAbleData\n    };\n  }\n});\nexport default DragAndDropTable;","map":{"version":3,"names":["computed","ref","defineComponent","useStore","TableWrapper","DragDropStyle","draggable","DragAndDropTable","name","components","setup","state","users","data","dragAbleData","value"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/table/DragTable.vue"],"sourcesContent":["<template>\r\n  <DragDropStyle>\r\n    <sdCards title=\"Drag & Drop\">\r\n      <TableWrapper class=\"table-responsive\">\r\n        <div class=\"ant-table-content\">\r\n          <table style=\"width: 100%\">\r\n            <draggable v-model=\"dragAbleData\" tag=\"tbody\" group=\"people\" handle=\".handle\" item-key=\"name\">\r\n              <template #item=\"{ element }\">\r\n                <tr>\r\n                  <td style=\"width: 30px\">\r\n                    <sdFeatherIcons classes=\"handle\" :style=\"{ cursor: 'pointer', color: '#999' }\" type=\"move\" />\r\n                  </td>\r\n                  <td scope=\"row\">\r\n                    <div class=\"user-info\">\r\n                      <figure><img :style=\"{ width: '40px' }\" :src=\"require(`@/${element.img}`)\" alt=\"\" /></figure>\r\n                      <figcaption>\r\n                        <sdHeading class=\"user-name\" as=\"h6\">\r\n                          {{ element.name }}\r\n                        </sdHeading>\r\n                      </figcaption>\r\n                    </div>\r\n                  </td>\r\n                  <td><span class=\"drag_email\">john@gmail.com</span></td>\r\n                  <td><span class=\"drag_company\">Business Development</span></td>\r\n                  <td>\r\n                    <span class=\"drag_designation\">{{ element.designation }}</span>\r\n                  </td>\r\n                  <td><span class=\"drag_join-date\">January 20, 2021</span></td>\r\n                  <td>\r\n                    <div class=\"table-actions\">\r\n                      <sdButton class=\"btn-icon\" type=\"info\" to=\"#\" shape=\"circle\">\r\n                        <sdFeatherIcons type=\"edit\" size=\"16\" />\r\n                      </sdButton>\r\n                      <sdButton class=\"btn-icon\" type=\"danger\" to=\"#\" shape=\"circle\">\r\n                        <sdFeatherIcons type=\"trash-2\" size=\"16\" />\r\n                      </sdButton>\r\n                    </div>\r\n                  </td>\r\n                </tr>\r\n              </template>\r\n            </draggable>\r\n          </table>\r\n        </div>\r\n      </TableWrapper>\r\n    </sdCards>\r\n  </DragDropStyle>\r\n</template>\r\n<script>\r\nimport { computed, ref, defineComponent } from 'vue';\r\nimport { useStore } from 'vuex';\r\nimport { TableWrapper, DragDropStyle } from '../styled';\r\nimport draggable from 'vuedraggable';\r\n\r\nconst DragAndDropTable = defineComponent({\r\n  name: 'DragAndDropTable',\r\n  components: { TableWrapper, DragDropStyle, draggable },\r\n  setup() {\r\n    const { state } = useStore();\r\n    const users = computed(() => state.users.data);\r\n    const dragAbleData = ref(users.value);\r\n\r\n    return {\r\n      users,\r\n      dragAbleData,\r\n    };\r\n  },\r\n});\r\n\r\nexport default DragAndDropTable;\r\n</script>\r\n"],"mappings":"AAgDA,SAASA,QAAQ,EAAEC,GAAG,EAAEC,eAAc,QAAS,KAAK;AACpD,SAASC,QAAO,QAAS,MAAM;AAC/B,SAASC,YAAY,EAAEC,aAAY,QAAS,WAAW;AACvD,OAAOC,SAAQ,MAAO,cAAc;AAEpC,MAAMC,gBAAe,GAAIL,e