{"ast":null,"code":"import { onMounted, ref, computed, defineComponent } from 'vue';\nimport { useStore } from 'vuex';\nimport { SentEmailWrapper } from '../../style';\nimport Chartjs from '../../../../components/utilities/chartjs';\nconst labels = ['Total Events', 'Events Opened', 'Not Opened'];\nconst icons = ['Sent', 'Opened', 'NotOpen'];\nconst types = ['success', 'success', 'success'];\nconst EventsDetails = defineComponent({\n  name: 'EventsDetails',\n  components: {\n    SentEmailWrapper,\n    Chartjs\n  },\n  setup() {\n    const {\n      state,\n      dispatch\n    } = useStore();\n    const deviceState = computed(() => state.chartContent.deviceData);\n    const dvIsLoading = computed(() => state.chartContent.dvLoading);\n    const device = ref('year');\n    const datasets = computed(() => [{\n      data: deviceState.value,\n      backgroundColor: ['#20C997', '#5F63F2', '#FA8B0C']\n    }]);\n    onMounted(() => {\n      dispatch('deviceGetData');\n      // return (datasets.value = [\n      //   {\n      //     data: deviceState.value,\n      //     backgroundColor: ['#20C997', '#5F63F2', '#FA8B0C'],\n      //   },\n      // ]);\n    });\n\n    const handleActiveChangeDevice = (event, value) => {\n      event.preventDefault();\n      device.value = value;\n      dispatch('deviceFilterData', value);\n    };\n    return {\n      deviceState,\n      dvIsLoading,\n      device,\n      handleActiveChangeDevice,\n      labels,\n      icons,\n      types,\n      datasets\n    };\n  }\n});\nexport default EventsDetails;","map":{"version":3,"names":["onMounted","ref","computed","defineComponent","useStore","SentEmailWrapper","Chartjs","labels","icons","types","EventsDetails","name","components","setup","state","dispatch","deviceState","chartContent","deviceData","dvIsLoading","dvLoading","device","datasets","data","value","backgroundColor","handleActiveChangeDevice","event","preventDefault"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/dashboard/overview/massnet/EventsDetails.vue"],"sourcesContent":["<template>\n    <SentEmailWrapper>\n      <sdCards v-if=\"deviceState\" title=\"Events Details\">\n        <template #button>\n          <div class=\"card-nav\">\n            <!-- <ul>\n              <li :class=\"device === 'today' ? 'active' : 'deactivate'\">\n                <router-link @click=\"(e) => handleActiveChangeDevice(e, 'today')\" to=\"#\"> Today </router-link>\n              </li>\n              <li :class=\"device === 'week' ? 'active' : 'deactivate'\">\n                <router-link @click=\"(e) => handleActiveChangeDevice(e, 'week')\" to=\"#\"> Week </router-link>\n              </li>\n              <li :class=\"device === 'month' ? 'active' : 'deactivate'\">\n                <router-link @click=\"(e) => handleActiveChangeDevice(e, 'month')\" to=\"#\"> Month </router-link>\n              </li>\n              <li :class=\"device === 'year' ? 'active' : 'deactivate'\">\n                <router-link @click=\"(e) => handleActiveChangeDevice(e, 'year')\" to=\"#\"> Year </router-link>\n              </li>\n            </ul> -->\n          </div>\n        </template>\n  \n        <div v-if=\"dvIsLoading\" class=\"sd-spin\">\n          <a-spin />\n        </div>\n  \n        <div v-else class=\"sent-emial-chart\">\n          <Chartjs\n            :options=\"{\n              cutoutPercentage: 60,\n              maintainAspectRatio: false,\n              responsive: false,\n              legend: {\n                display: false,\n                position: 'bottom',\n              },\n              animation: {\n                animateScale: true,\n                animateRotate: true,\n              },\n            }\"\n            type=\"doughnut\"\n            class=\"sentMail\"\n            :labels=\"labels\"\n            :datasets=\"datasets\"\n            :height=\"180\"\n          />\n  \n          <div class=\"sent-emial-data\">\n            <div v-for=\"(item, key) in datasets\" class=\"sent-emial-box align-center-v\" :key=\"key + 1\">\n              <div v-for=\"(value, index) in item.data\" class=\"sent-emial-item\" :key=\"value\">\n                <!-- <div :class=\"`sent-emial-icon icon-${types[index]}`\">\n                  <img :src=\"require(`../../../../static/img/icon/${icons[index]}.svg`)\" alt=\"\" />\n                </div> -->\n                <div class=\"sent-emial-content\">\n                  <h4>\n                    <strong>{{ value }}</strong>\n                  </h4>\n                  <p>{{ labels[index] }}</p>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </sdCards>\n    </SentEmailWrapper>\n  </template>\n  <script>\n  import { onMounted, ref, computed, defineComponent } from 'vue';\n  import { useStore } from 'vuex';\n  import { SentEmailWrapper } from '../../style';\n  import Chartjs from '../../../../components/utilities/chartjs';\n  \n  const labels = ['Total Events', 'Events Opened', 'Not Opened'];\n  const icons = ['Sent', 'Opened', 'NotOpen'];\n  const types = ['success', 'success', 'success'];\n  \n  const EventsDetails = defineComponent({\n    name: 'EventsDetails',\n    components: { SentEmailWrapper, Chartjs },\n    setup() {\n      const { state, dispatch } = useStore();\n      const deviceState = computed(() => state.chartContent.deviceData);\n      const dvIsLoading = computed(() => state.chartContent.dvLoading);\n      const device = ref('year');\n  \n      const datasets = computed(() => [\n        {\n          data: deviceState.value,\n          backgroundColor: ['#20C997', '#5F63F2', '#FA8B0C'],\n        },\n      ]);\n  \n      onMounted(() => {\n        dispatch('deviceGetData');\n        // return (datasets.value = [\n        //   {\n        //     data: deviceState.value,\n        //     backgroundColor: ['#20C997', '#5F63F2', '#FA8B0C'],\n        //   },\n        // ]);\n      });\n  \n      const handleActiveChangeDevice = (event, value) => {\n        event.preventDefault();\n        device.value = value;\n        dispatch('deviceFilterData', value);\n      };\n  \n      return {\n        deviceState,\n        dvIsLoading,\n        device,\n        handleActiveChangeDevice,\n        labels,\n        icons,\n        types,\n        datasets,\n      };\n    },\n  });\n  \n  export default EventsDetails;\n  </script>\n  "],"mappings":"AAoEE,SAASA,SAAS,EAAEC,GAAG,EAAEC,QAAQ,EAAEC,eAAc,QAAS,KAAK;AAC/D,SAASC,QAAO,QAAS,MAAM;AAC/B,SAASC,gBAAe,QAAS,aAAa;AAC9C,OAAOC,OAAM,MAAO,0CAA0C;AAE9D,MAAMC,MAAK,GAAI,CAAC,cAAc,EAAE,eAAe,EAAE,YAAY,CAAC;AAC9D,MAAMC,KAAI,GAAI,CAAC,MAAM,EAAE,QAAQ,EAAE,SAAS,CAAC;AAC3C,MAAMC,KAAI,GAAI,CAAC,SAAS,EAAE,SAAS,EAAE,SAAS,CAAC;AAE/C,MAAMC,aAAY,GAAIP,eAAe,CAAC;EACpCQ,IAAI,EAAE,eAAe;EACrBC,UAAU,EAAE;IAAEP,gBAAgB;IAAEC;EAAQ,CAAC;EACzCO,KAAKA,CAAA,EAAG;IACN,MAAM;MAAEC,KAAK;MAAEC;IAAS,IAAIX,QAAQ,EAAE;IACtC,MAAMY,WAAU,GAAId,QAAQ,CAAC,MAAMY,KAAK,CAACG,YAAY,CAACC,UAAU,CAAC;IACjE,MAAMC,WAAU,GAAIjB,QAAQ,CAAC,MAAMY,KAAK,CAACG,YAAY,CAACG,SAAS,CAAC;IAChE,MAAMC,MAAK,GAAIpB,GAAG,CAAC,MAAM,CAAC;IAE1B,MAAMqB,QAAO,GAAIpB,QAAQ,CAAC,MAAM,CAC9B;MACEqB,IAAI,EAAEP,WAAW,CAACQ,KAAK;MACvBC,eAAe,EAAE,CAAC,SAAS,EAAE,SAAS,EAAE,SAAS;IACnD,CAAC,CACF,CAAC;IAEFzB,SAAS,CAAC,MAAM;MACde,QAAQ,CAAC,eAAe,CAAC;MACzB;MACA;MACA;MACA;MACA;MACA;IACF,CAAC,CAAC;;IAEF,MAAMW,wBAAuB,GAAIA,CAACC,KAAK,EAAEH,KAAK,KAAK;MACjDG,KAAK,CAACC,cAAc,EAAE;MACtBP,MAAM,CAACG,KAAI,GAAIA,KAAK;MACpBT,QAAQ,CAAC,kBAAkB,EAAES,KAAK,CAAC;IACrC,CAAC;IAED,OAAO;MACLR,WAAW;MACXG,WAAW;MACXE,MAAM;MACNK,wBAAwB;MACxBnB,MAAM;MACNC,KAAK;MACLC,KAAK;MACLa;IACF,CAAC;EACH;AACF,CAAC,CAAC;AAEF,eAAeZ,aAAa"},"metadata":{},"sourceType":"module","externalDependencies":[]}