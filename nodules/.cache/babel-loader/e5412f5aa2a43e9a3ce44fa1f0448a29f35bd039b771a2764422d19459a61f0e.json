nst ProjectDetails = defineComponent({\n  name: \"ProjectDetails\",\n  components: { ProjectDetailsWrapper, Main, EventCampaignTable },\n\n  data() {\n    const { state, dispatch } = useStore();\n\n    const project = computed(() => state.project.singData);\n    const { params, matched, query } = useRoute();\n    const { title, content } = computed(() => state.project.singData[0]);\n    const API_URL = `${process.env.VUE_APP_BASE_URL}/generateEventParticipantCSV?event=${query.id}`;\n\n    console.log(query.id);\n    const { facilitators } = reactive({ facilitators: [] });\n\n    const columns = [\n      {\n        title: \"Name\",\n        dataIndex: \"first_name\",\n        // key: 'first_name',\n        render: (text, record) => (\n          <span>\n            {record.first_name} {record.last_name}\n          </span>\n        ),\n      },\n      {\n        title: \"Phone Number\",\n        dataIndex: \"phone_no\",\n        key: \"phone_no\",\n      },\n      {\n        title: \"ID Number\",\n        dataIndex: \"id_no\",\n        key: \"id_no\",\n      },\n    ];\n\n\n    const getfacilitators = async () => {\n      const response = await fetch(\n        `${process.env.VUE_APP_BASE_URL}/event/${query.event_code}/facilitators`,\n        {\n          method: \"GET\",\n          headers: {\n            \"Content-Type\": \"application/json\",\n            ...authHeader(),\n          },\n        }\n      );\n      const data = await response.json();\n      this.facilitators = data.data;\n      Modal.info({\n        title: \"Facilitators\",\n        content: (\n          <div>\n            <Table dataSource={data.data} columns={columns} />\n          </div>\n        ),\n        onOk() {},\n      });\n    };\n    onMounted(() => {\n      dispatch(\"eventCampaignData\", parseInt(params.id, 10));\n    });\n    const exportEventParticipants = async () => {\n      try {\n        const response = await fetch(API_URL, {\n          method: \"GET\",\n          headers: {\n            \"Content-Type\": \"application/json\",\n            ...authHeader(),\n          },\n        });\n\n        if (!response.ok) {\n          throw new Error(\"Failed to fetch export data\");\n        }\n\n        const fileBlob = await response.blob();\n        const fileName = \"event_participants.csv\";\n        const link = document.createElement(\"a\");\n        link.href = window.URL.createObjectURL(new Blob([fileBlob]));\n        link.setAttribute(\"download\", fileName);\n        document.body.appendChild(link);\n        link.click();\n        link.parentNode.removeChild(link);\n      } catch (error) {\n        console.error(error);\n      }\n    };\n\n    return {\n      title,\n      content,\n      project,\n      params,\n      matched,\n      facilitators,\n      getfacilitators,\n      exportEventParticipants,\n    };\n  },\n});\n\nexport default ProjectDetails;\n</script>\n<style>\n.page-header-actions {\n  float: right;\n}\n</style>\n"],"mappings":";;;;;AA4BA,SAASA,qBAAoB,QAAS,kBAAkB;AACxD;AACA,SAASC,IAAG,QAAS,cAAc;AACnC,SAASC,QAAO,QAAS,MAAM;AAE/B,SAASC,QAAQ,EAAEC,QAAQ,EAAEC,SAAS,EAAEC,eAAc,QAAS,KAAK;AAEpE,SAASC,QAAO,QAAS,YAAY;AACrC,OAAOC,kBAAiB,MAAO,8CAA8C;AAE7E,OAAOC,UAAS,MAAO,+BAA+B;AAEtD,MAAMC,cAAa,GAAIJ,eAAe,CAAC;EACrCK,IAAI,EAAE,gBAAgB;EACtBC,UAAU,EAAE;IAAEZ,qBAAqB;IAAEC,IAAI;IAAEO;EAAmB,CAAC;EAE/DK,IAAIA,CAAA,EAAG;IACL,MAAM;MAAEC,KAAK;MAAEC;IAAS,IAAIb,QAAQ,EAAE;IAEtC,MAAMc,OAAM,GAAIZ,QAAQ,CAAC,MAAMU,KAAK,CAACE,OAAO,CAACC,QAAQ,CAAC;IACtD,MAAM;MAAEC,MAAM;MAAEC,OAAO;MAAEC;IAAM,IAAIb,QAAQ,EAAE;IAC7C,MAAM;MAAEc,KAAK;MAAEC;IAAQ,IAAIlB,QAAQ,CAAC,MAAMU,KAAK,CAACE,OAAO,CAACC,QAAQ,CAAC,CAAC,CAAC,CAAC;IACpE,MAAMM,OAAM,GAAK,GAAEC,OAAO,CAACC,GAAG,CAACC,gBAAiB,sCAAqCN,KAAK,CAACO,EAAG,EAAC;IAE/FC,OAAO,CAACC,GAAG,CAACT,KAAK,CAACO,EAAE,CAAC;IACrB,MAAM;MAAEG;IAAa,IAAI3B,QAAQ,CAAC;MAAE2B,YAAY,EAAE;IAAG,CAAC,CAAC;IAEvD,MAAMC,OAAM,GAAI,CACd;MACEV,KAAK,EAAE,MAAM;MACbW,SAAS,EAAE,YAAY;MACvB;MACAC,MAAM,EAAEA,CAACC,IAAI,EAAEC,MAAM,KAAAC,YAAA,gBAEhBD,MAAM,CAACE,UAAU