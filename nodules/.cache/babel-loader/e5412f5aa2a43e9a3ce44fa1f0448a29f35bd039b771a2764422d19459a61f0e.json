{"ast":null,"code":"import \"ant-design-vue/es/table/style\";\nimport _Table from \"ant-design-vue/es/table\";\nimport \"ant-design-vue/es/modal/style\";\nimport _Modal from \"ant-design-vue/es/modal\";\nimport { createVNode as _createVNode, createTextVNode as _createTextVNode } from \"vue\";\nimport { ProjectDetailsWrapper } from \"./overview/style\";\n// import FileListCard from './overview/FileListCard';\nimport { Main } from \"../../styled\";\nimport { useStore } from \"vuex\";\nimport { reactive, computed, onMounted, defineComponent } from \"vue\";\nimport { useRoute } from \"vue-router\";\nimport EventCampaignTable from \"../campaigns/CampaignTable/EventCampaign.vue\";\nimport authHeader from \"../../../services/auth-header\";\nconst ProjectDetails = defineComponent({\n  name: \"ProjectDetails\",\n  components: {\n    ProjectDetailsWrapper,\n    Main,\n    EventCampaignTable\n  },\n  data() {\n    const {\n      state,\n      dispatch\n    } = useStore();\n    const project = computed(() => state.project.singData);\n    const {\n      params,\n      matched,\n      query\n    } = useRoute();\n    const {\n      title,\n      content\n    } = computed(() => state.project.singData[0]);\n    const API_URL = `${process.env.VUE_APP_BASE_URL}/generateEventParticipantCSV?event=${query.id}`;\n    console.log(query.id);\n    const {\n      facilitators\n    } = reactive({\n      facilitators: []\n    });\n    const columns = [{\n      title: \"Name\",\n      dataIndex: \"first_name\",\n      // key: 'first_name',\n      render: (text, record) => _createVNode(\"span\", null, [record.first_name, _createTextVNode(\" \"), record.last_name])\n    }, {\n      title: \"Phone Number\",\n      dataIndex: \"phone_no\",\n      key: \"phone_no\"\n    }, {\n      title: \"ID Number\",\n      dataIndex: \"id_no\",\n      key: \"id_no\"\n    }];\n    const getfacilitators = async () => {\n      const response = await fetch(`${process.env.VUE_APP_BASE_URL}/event/${query.event_code}/facilitators`, {\n        method: \"GET\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          ...authHeader()\n        }\n      });\n      const data = await response.json();\n      this.facilitators = data.data;\n      _Modal.info({\n        title: \"Facilitators\",\n        content: _createVNode(\"div\", null, [_createVNode(_Table, {\n          \"dataSource\": data.data,\n          \"columns\": columns\n        }, null)]),\n        onOk() {}\n      });\n    };\n    onMounted(() => {\n      dispatch(\"eventCampaignData\", parseInt(params.id, 10));\n    });\n    const exportEventParticipants = async () => {\n      try {\n        const response = await fetch(API_URL, {\n          method: \"GET\",\n          headers: {\n            \"Content-Type\": \"application/json\",\n            ...authHeader()\n          }\n        });\n        if (!response.ok) {\n          throw new Error(\"Failed to fetch export data\");\n        }\n        const fileBlob = await response.blob();\n        const fileName = \"event_participants.csv\";\n        const link = document.createElement(\"a\");\n        link.href = window.URL.createObjectURL(new Blob([fileBlob]));\n        link.setAttribute(\"download\", fileName);\n        document.body.appendChild(link);\n        link.click();\n        link.parentNode.removeChild(link);\n      } catch (error) {\n        console.error(error);\n      }\n    };\n    return {\n      title,\n      content,\n      project,\n      params,\n      matched,\n      facilitators,\n      getfacilitators,\n      exportEventParticipants\n    };\n  }\n});\nexport default ProjectDetails;","map":{"version":3,"names":["ProjectDetailsWrapper","Main","useStore","reactive","computed","onMounted","defineComponent","useRoute","EventCampaignTable","authHeader","ProjectDetails","name","components","data","state","dispatch","project","singData","params","matched","query","title","content","API_URL","process","env","VUE_APP_BASE_URL","id","console",