{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { computed, ref, defineComponent } from 'vue';\nimport { useStore } from 'vuex';\nimport { BackShadow } from './style';\nconst Post = defineComponent({\n  name: 'Post',\n  components: {\n    BackShadow\n  },\n  setup() {\n    const {\n      state,\n      dispatch\n    } = useStore();\n    const posts = computed(() => state.profile.posts);\n    const drawer = ref(false);\n    const textValue = ref('');\n    const onCreate = () => {\n      const arrayData = [];\n      posts.value.map(data => {\n        return arrayData.push(data.postId);\n      });\n      const max = Math.max(...arrayData);\n      if (textValue.value === '') {\n        alert('Please input minimum content');\n      } else {\n        dispatch('submitPost', [...posts.value, {\n          postId: max + 1,\n          from: 'David Warner',\n          time: new Date().getTime(),\n          img: ['static/img/profile/post/postImage.png'],\n          author: 'static/img/chat-author/t4.jpg',\n          content: textValue,\n          like: 0,\n          comment: []\n        }]);\n        textValue.value = '';\n      }\n      setTimeout(() => {\n        drawer.value = false;\n      }, 500);\n    };\n    const onTextChange = e => {\n      return textValue.value = e.target.value;\n    };\n    const setDrawer = value => {\n      drawer.value = value;\n    };\n    return {\n      setDrawer,\n      posts,\n      drawer,\n      textValue,\n      onTextChange,\n      onCreate\n    };\n  }\n});\nexport default Post;","map":{"version":3,"names":["computed","ref","defineComponent","useStore","BackShadow","Post","name","components","setup","state","dispatch","posts","profile","drawer","textValue","onCreate","arrayData","value","map","data","push","postId","max","Math","alert","from","time","Date","getTime","img","author","content","like","comment","setTimeout","onTextChange","e","target","setDrawer"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/apps/myProfile/overview/timeline/CreatePost.vue"],"sourcesContent":["<template>\r\n  <sdCreatePost>\r\n    <BackShadow v-if=\"drawer\" @click=\"() => setDrawer(false)\" />\r\n    <sdCards title=\"Post Something\">\r\n      <div @click=\"() => setDrawer(true)\" class=\"postBody\">\r\n        <img class=\"post-author\" :src=\"require('@/static/img/chat-author/t4.jpg')\" alt=\"\" />\r\n        <a-textarea v-model:value=\"textValue\" @change=\"onTextChange\" placeholder=\"Write something...\" />\r\n      </div>\r\n      <div @click=\"() => setDrawer(true)\" class=\"postFooter\">\r\n        <div class=\"postFooter_left\">\r\n          <a-upload>\r\n            <sdButton shape=\"circle\" type=\"light\">\r\n              <img :src=\"require('@/static/img/icon/image.png')\" alt=\"\" />\r\n              <span>Photo/Video</span>\r\n            </sdButton>\r\n          </a-upload>\r\n          <sdButton class=\"btn-more\" shape=\"circle\" type=\"light\">\r\n            <sdFeatherIcons type=\"more-horizontal\" />\r\n          </sdButton>\r\n        </div>\r\n        <div class=\"postFooter_right\">\r\n          <sdButton v-if=\"drawer\" class=\"btn-post\" @click=\"onCreate\" type=\"primary\"> Publish Post </sdButton>\r\n        </div>\r\n      </div>\r\n    </sdCards>\r\n  </sdCreatePost>\r\n</template>\r\n<script>\r\nimport { computed, ref, defineComponent } from 'vue';\r\nimport { useStore } from 'vuex';\r\nimport { BackShadow } from './style';\r\n\r\nconst Post = defineComponent({\r\n  name: 'Post',\r\n  components: { BackShadow },\r\n  setup() {\r\n    const { state, dispatch } = useStore();\r\n    const posts = computed(() => state.profile.posts);\r\n    const drawer = ref(false);\r\n    const textValue = ref('');\r\n\r\n    const onCreate = () => {\r\n      const arrayData = [];\r\n      posts.value.map((data) => {\r\n        return arrayData.push(data.postId);\r\n      });\r\n      const max = Math.max(...arrayData);\r\n      if (textValue.value === '') {\r\n        alert('Please input minimum content');\r\n      } else {\r\n        dispatch('submitPost', [\r\n          ...posts.value,\r\n          {\r\n            postId: max + 1,\r\n            from: 'David Warner',\r\n            time: new Date().getTime(),\r\n            img: ['static/img/profile/post/postImage.png'],\r\n            author: 'static/img/chat-author/t4.jpg',\r\n            content: textValue,\r\n            like: 0,\r\n            comment: [],\r\n          },\r\n        ]);\r\n        textValue.value = '';\r\n      }\r\n      setTimeout(() => {\r\n        drawer.value = false;\r\n      }, 500);\r\n    };\r\n\r\n    const onTextChange = (e) => {\r\n      return (textValue.value = e.target.value);\r\n    };\r\n\r\n    const setDrawer = (value) => {\r\n      drawer.value = value;\r\n    };\r\n\r\n    return {\r\n      setDrawer,\r\n      posts,\r\n      drawer,\r\n      textValue,\r\n      onTextChange,\r\n      onCreate,\r\n    };\r\n  },\r\n});\r\n\r\nexport default Post;\r\n</script>\r\n"],"mappings":";AA4BA,SAASA,QAAQ,EAAEC,GAAG,EAAEC,eAAc,QAAS,KAAK;AACpD,SAASC,QAAO,QAAS,MAAM;AAC/B,SAASC,UAAS,QAAS,SAAS;AAEpC,MAAMC,IAAG,GAAIH,eAAe,CAAC;EAC3BI,IAAI,EAAE,MAAM;EACZC,UAAU,EAAE;IAAEH;EAAW,CAAC;EAC1BI,KAAKA,CAAA,EAAG;IACN,MAAM;MAAEC,KAAK;MAAEC;IAAS,IAAIP,QAAQ,EAAE;IACtC,MAAMQ,KAAI,GAAIX,QAAQ,CAAC,MAAMS,KAAK,CAACG,OAAO,CAACD,KAAK,CAAC;IACjD,MAAME,MAAK,GAAIZ,GAAG,CAAC,KAAK,CAAC;IACzB,MAAMa,SAAQ,GAAIb,GAAG,CAAC,EAAE,CAAC;IAEzB,MAAMc,QAAO,GAAIA,CAAA,KAAM;MACrB,MAAMC,SAAQ,GAAI,EAAE;MACpBL,KAAK,CAACM,KAAK,CAACC,GAAG,CAAEC,IAAI,IAAK;QACxB,OAAOH,SAAS,CAACI,IAAI,CAACD,IAAI,CAACE,MAAM,CAAC;MACpC,CAAC,CAAC;MACF,MAAMC,GAAE,GAAIC,IAAI,CAACD,GAAG,CAAC,GAAGN,SAAS,CAAC;MAClC,IAAIF,SAAS,CAACG,KAAI,KAAM,EAAE,EAAE;QAC1BO,KAAK,CAAC,8BAA8B,CAAC;MACvC,OAAO;QACLd,QAAQ,CAAC,YAAY,EAAE,CACrB,GAAGC,KAAK,CAACM,KAAK,EACd;UACEI,MAAM,EAAEC,GAAE,GAAI,CAAC;UACfG,IAAI,EAAE,cAAc;UACpBC,IAAI,EAAE,IAAIC,IAAI,EAAE,CAACC,OAAO,EAAE;UAC1BC,GAAG,EAAE,CAAC,uCAAuC,CAAC;UAC9CC,MAAM,EAAE,+BAA+B;UACvCC,OAAO