    <sdCards headless>\n            <a-row justify=\"center\">\n              <a-col :xl=\"10\" :md=\"16\" :xs=\"24\">\n                <BasicFormWrapper>\n                  <a-form\n                    class=\"add-record-form\"\n                    :style=\"{ width: '100%' }\"\n                    layout=\"vertical\"\n                    name=\"addnew\"\n                    :model=\"formState\"\n                    @finish=\"handleSubmit\"\n                  >\n                    <a-form-item name=\"name\" label=\"Campaign Name\">\n                      <a-input\n                        v-model:value=\"formState.name\"\n                        placeholder=\"Input Campaign Name\"\n                      />\n                    </a-form-item>\n\n                    <a-form-item name=\"startDate\" label=\"Campaign Start Date\">\n                      <a-date-picker\n                        :style=\"{ width: '100%' }\"\n                        v-model:value=\"formState.startDate\"\n                        :format=\"dateFormat\"\n                        :disabledDate=\"disabledDate\"\n                      />\n                    </a-form-item>\n\n                    <a-form-item name=\"endDate\" label=\"Campaign End Date\">\n                      <a-date-picker\n                        :style=\"{ width: '100%' }\"\n                        v-model:value=\"formState.endDate\"\n                        :format=\"dateFormat\"\n                      />\n                    </a-form-item>\n\n                    <div class=\"record-form-actions text-right\">\n                      <sdButton size=\"default\" htmlType=\"Save\" type=\"success\">\n                        {{ isLoading ? \"Loading...\" : \"Submit\" }}\n                      </sdButton>\n                    </div>\n                  </a-form>\n                </BasicFormWrapper>\n              </a-col>\n            </a-row>\n          </sdCards>\n        </RecordFormWrapper>\n      </a-col>\n    </a-row>\n  </Main>\n</template>\n<script>\nimport { RecordFormWrapper } from \"./style\";\nimport { Main, BasicFormWrapper } from \"../../styled\";\nimport { useStore } from \"vuex\";\nimport { reactive, ref, defineComponent, computed } from \"vue\";\n// import axios from \"axios\";\nimport authHeader from \"../../../services/auth-header\";\nimport { notification } from \"ant-design-vue\";\nimport { useRouter } from \"vue-router\";\n\nconst dateFormat = \"YYYY-MM-DD\";\n\nconst AddNew = defineComponent({\n  name: \"AddNew\",\n  components: { RecordFormWrapper, Main, BasicFormWrapper },\n  setup() {\n    const { state } = useStore();\n\n    const isLoading = computed(() => state.crud.loading);\n    const apiUrl = computed(() => state.crud.url);\n    const isFileLoading = computed(() => state.crud.fileLoading);\n    const join = ref(\"\");\n\n    const router = useRouter();\n\n    const API_URL = `${process.env.VUE_APP_BASE_URL}/createCampaign`;\n\n\n    const handleSubmit = (values) => {\n      values = {\n        name: values.name,\n        start_date: new Date(values.startDate.$d).toISOString().substr(0, 10),\n        end_date: new Date(values.endDate.$d).toISOString().substr(0, 10),\n      };\n\n      fetch(API_URL, {\n        method: \"POST\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          ...authHeader(),\n        },\n        body: JSON.stringify(values),\n      })\n        .then((response) => response.json())\n        .then(({success}) => {\n          // console.log(data);\n          if(success){\n            router.push(\"view-campaign\")\n            notification['success']({\n                message: 'Campaign Created',\n                description: \"Campaign Created successfully.\",\n                duration: 4.5\n          });\n          }\n          })\n        .catch((error) => {\n          console.error(\"Error:\", error);\n        }); \n    };\n\n    //   axios\n    //     .post(API_URL, values, { headers: authHeader() })\n    //     .then(function (response) {\n    //       console.log(response);\n    //     })\n    //     .catch(function (error) {\n    //       console.log(error);\n    //     });\n    // };\n\n    const formState = reactive({\n      name: \"\",\n      startDate: \"\",\n      endDate: \"\",\n    });\n\n    return {\n      isLoading,\n      apiUrl,\n      isFileLoading,\n      handleSubmit,\n      dateFormat,\n      formState,\n      join,\n    };\n  },\n  methods: {\n    disabledDate(current) {\n      return current && current < Date.now();\n    },\n  },\n  beforeRouteEnter(to, from, next) {\n    if (!sessionStorage.getItem(\"user\")) {\n      next(\"/auth/login\");\n    } else {\n      next();\n    }\n  },\n});\n\nexport default AddNew;\n</script>\n"],"mappings":";;;AA8DA,SAASA,iBAAgB,QAAS,SAAS;AAC3C,SAASC,IAAI,EAAEC,gBAAe,QAAS,cAAc;AACrD,SAASC,QAAO,QAAS,MAAM;AAC/B,SAASC,QAAQ,EAAEC,GAAG,EAAEC,eAAe,EAAEC,QAAO,QAAS,KAAK;AAC9D;AACA,OAAOC,UAAS,MAAO,+BAA+B;AAEtD,SAASC,SAAQ,QAAS,YAAY;AAEtC,MAAMC,UAAS,GAAI,YAAY;AAE/B,MAAMC,MAAK,GAAIL,eAAe,CAAC;EAC7BM,IAAI,EAAE,QAAQ;EACdC,UAAU,EAAE;IAAEb,iBAAiB;IAAEC,IAAI;IAAEC;EAAiB,CAAC;EACzDY,KAAKA,CAAA,EAAG;IACN,MAAM;MAAEC;IAAM,IAAIZ,QAAQ,EAAE;IAE5B,MAAMa,SAAQ,GAAIT,QAAQ,CAAC,MAAMQ,KAAK,CAACE,IAAI,CAACC,OAAO,CAAC;IACpD,MAAMC,MAAK,GAAIZ,QAAQ,CAAC,MAAMQ,KAAK,CAACE,IAAI,CAACG,GAAG,CAAC;IAC7C,MAAMC,aAAY,GAAId,QAAQ,CAAC,MAAMQ,KAAK,CAACE,IAAI,CAACK,WAAW,CAAC;IAC5D,MAAMC,IAAG,GAAIlB,GAAG,CAAC,EAAE,CAAC;IAEpB,MAAMmB,MAAK,GAAIf,SAAS,EAAE;IAE1B,MAAMgB,OAAM,GAAK,GAAEC,OAAO,CAACC,GAAG,CAACC,gBAAiB,iBAAgB;IAGhE,MAAMC,YAAW,GAAKC,MAAM,IAAK;MAC/BA,MAAK,GAAI;QACPlB,IAAI,EAAEkB,MAAM,CAAClB,IAAI;QACjBmB,UAAU,EAAE,IAAIC,IAAI,CAACF,MAAM,CAACG,SAAS,CAACC,EAAE,CAAC,CAACC,WAAW,EAAE,CAACC,MAAM,CAAC,CAAC,EAAE,EAAE,CAAC;QACrEC,QAAQ,EAAE,IAAIL,IAAI,CAACF,MAAM,CAACQ,OAAO,CAACJ,EAAE,CAAC,CAACC,WAAW,EAAE,CAACC,MAAM,CAAC,CAAC,EAAE,EAAE;MAClE,CAAC;MAEDG,KAAK,CAACd,OAAO,EAAE;QACbe,MAAM,EAAE,MAAM;QACdC,OAAO,EAAE;UACP,cAAc,EAAE,kBAAkB;UAClC,GAAGjC,UAAU;QACf,CAAC;QACDkC,IAAI,EAAEC,IAAI