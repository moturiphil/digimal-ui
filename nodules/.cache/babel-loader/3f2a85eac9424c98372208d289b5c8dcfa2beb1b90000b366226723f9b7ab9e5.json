{"ast":null,"code":"import \"ant-design-vue/es/notification/style\";\nimport _notification from \"ant-design-vue/es/notification\";\nimport \"core-js/modules/es.array.push.js\";\nimport { RecordFormWrapper } from \"./style\";\nimport { Main, BasicFormWrapper } from \"../../styled\";\nimport { useStore } from \"vuex\";\nimport { reactive, ref, defineComponent, computed } from \"vue\";\n// import axios from \"axios\";\nimport authHeader from \"../../../services/auth-header\";\nimport { useRouter } from \"vue-router\";\nconst dateFormat = \"YYYY-MM-DD\";\nconst AddNew = defineComponent({\n  name: \"AddNew\",\n  components: {\n    RecordFormWrapper,\n    Main,\n    BasicFormWrapper\n  },\n  setup() {\n    const {\n      state\n    } = useStore();\n    const isLoading = computed(() => state.crud.loading);\n    const apiUrl = computed(() => state.crud.url);\n    const isFileLoading = computed(() => state.crud.fileLoading);\n    const join = ref(\"\");\n    const router = useRouter();\n    const API_URL = `${process.env.VUE_APP_BASE_URL}/createCampaign`;\n    const handleSubmit = values => {\n      values = {\n        name: values.name,\n        start_date: new Date(values.startDate.$d).toISOString().substr(0, 10),\n        end_date: new Date(values.endDate.$d).toISOString().substr(0, 10)\n      };\n      fetch(API_URL, {\n        method: \"POST\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          ...authHeader()\n        },\n        body: JSON.stringify(values)\n      }).then(response => response.json()).then(({\n        success\n      }) => {\n        // console.log(data);\n        if (success) {\n          router.push(\"view-campaign\");\n          _notification['success']({\n            message: 'Campaign Created',\n            description: \"Campaign Created successfully.\",\n            duration: 4.5\n          });\n        }\n      }).catch(error => {\n        console.error(\"Error:\", error);\n      });\n    };\n\n    //   axios\n   