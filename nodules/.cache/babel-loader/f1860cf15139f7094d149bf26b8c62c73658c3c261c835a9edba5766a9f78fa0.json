{"ast":null,"code":"import { ProjectDetailsWrapper } from \"./overview/style\";\n// import FileListCard from './overview/FileListCard';\nimport { Main } from \"../../styled\";\nimport { useStore } from \"vuex\";\nimport { computed, onMounted, defineComponent } from \"vue\";\nimport { useRoute } from \"vue-router\";\nimport EventCampaignTable from \"../campaigns/CampaignTable/CampaignInfo.vue\";\nconst ProjectDetails = defineComponent({\n  name: \"ProjectDetails\",\n  components: {\n    ProjectDetailsWrapper,\n    Main,\n    EventCampaignTable\n  },\n  setup() {\n    const {\n      state,\n      dispatch\n    } = useStore();\n    const project = computed(() => state.project.singData);\n    const {\n      params,\n      matched\n    } = useRoute();\n    const {\n      title,\n      content\n    } = computed(() => state.project.singData[0]);\n    onMounted(() => dispatch(\"eventCampaignData\", parseInt(params.id, 10)));\n    return {\n      title,\n      content,\n      project,\n      params,\n      matched\n    };\n  }\n});\nexport default ProjectDetails;","map":{"version":3,"names":["ProjectDetailsWrapper","Main","useStore","computed","onMounted","defineComponent","useRoute","EventCampaignTable","ProjectDetails","name","components","setup","state","dispatch","project","singData","params","matched","title","content","parseInt","id"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/pages/campaigns/showCampaign.vue"],"sourcesContent":["<template>\n  <ProjectDetailsWrapper>\n    <sdPageHeader v-if=\"project\">\n      <template #title\n        ><div key=\"1\" class=\"project-header\">\n          <sdHeading as=\"h2\">{{ project[0].title }}</sdHeading>\n        </div></template\n      >\n    </sdPageHeader>\n    <Main>\n      <div v-if=\"!project\" class=\"spin\">\n        <a-spin />\n      </div>\n      <a-row v-else :gutter=\"25\">\n        <a-col :xxl=\"6\" :xl=\"8\" :md=\"24\" :xs=\"24\">\n          <sdCards headless>\n            <!-- <div class=\"state-single\">\n              <div class=\"color-primary\">\n                <a to=\"#\">\n                  <sdFeatherIcons type=\"list\" size=\"25\" />\n                </a>\n              </div>\n              <div>\n                <sdHeading as=\"h5\">47</sdHeading>\n                <p>Event Participants</p>\n              </div>\n            </div>\n            <div class=\"state-single\">\n              <div class=\"color-secondary\">\n                <a to=\"#\">\n                  <sdFeatherIcons type=\"pie-chart\" size=\"25\" />\n                </a>\n              </div>\n              <div>\n                <sdHeading as=\"h5\">34</sdHeading>\n                <p>Event Facilitators</p>\n              </div>\n            </div>\n            <div class=\"state-single\">\n              <div class=\"color-success\">\n                <a to=\"#\">\n                  <sdFeatherIcons type=\"layout\" size=\"25\" />\n                </a>\n              </div>\n              <div>\n                <sdHeading as=\"h5\">$27,500</sdHeading>\n                <p>Spendings</p>\n              </div>\n            </div>\n            <div class=\"state-single\">\n              <div class=\"color-warning\">\n                <a to=\"#\">\n                  <sdFeatherIcons type=\"edit\" size=\"25\" />\n                </a>\n              </div>\n              <div>\n                <sdHeading as=\"h5\">Four Points</sdHeading>\n                <p>Event Location</p>\n              </div>\n            </div>\n            <div class=\"state-single\">\n              <div class=\"color-warning\">\n                <a to=\"#\">\n                  <sdFeatherIcons type=\"map\" size=\"25\" />\n                </a>\n              </div>\n              <div>\n                <sdHeading as=\"h5\">4</sdHeading>\n                <p>Event Facilitators</p>\n              </div>\n            </div> -->\n          </sdCards>\n        </a-col>\n        <a-col :xxl=\"18\" :xl=\"24\" :md=\"24\" :xs=\"24\">\n          <sdCards title=\"Event List Table\"> <EventCampaignTable /></sdCards>\n        </a-col>\n      </a-row>\n    </Main>\n  </ProjectDetailsWrapper>\n</template>\n<script>\nimport { ProjectDetailsWrapper } from \"./overview/style\";\n// import FileListCard from './overview/FileListCard';\nimport { Main } from \"../../styled\";\nimport { useStore } from \"vuex\";\nimport { computed, onMounted, defineComponent } from \"vue\";\nimport { useRoute } from \"vue-router\";\nimport EventCampaignTable from \"../campaigns/CampaignTable/CampaignInfo.vue\";\n\nconst ProjectDetails = defineComponent({\n  name: \"ProjectDetails\",\n  components: { ProjectDetailsWrapper, Main, EventCampaignTable },\n  setup() {\n    const { state, dispatch } = useStore();\n    const project = computed(() => state.project.singData);\n    const { params, matched } = useRoute();\n    const { title, content } = computed(() => state.project.singData[0]);\n\n    onMounted(() => dispatch(\"eventCampaignData\", parseInt(params.id, 10)));\n\n    return {\n      title,\n      content,\n      project,\n      params,\n      matched,\n    };\n  },\n});\n\nexport default ProjectDetails;\n</script>\n"],"mappings":"AAiFA,SAASA,qBAAoB,QAAS,kBAAkB;AACxD;AACA,SAASC,IAAG,QAAS,cAAc;AACnC,SAASC,QAAO,QAAS,MAAM;AAC/B,SAASC,QAAQ,EAAEC,SAAS,EAAEC,eAAc,QAAS,KAAK;AAC1D,SAASC,QAAO,QAAS,YAAY;AACrC,OAAOC,kBAAiB,MAAO,6CAA6C;AAE5E,MAAMC,cAAa,GAAIH,eAAe,CAAC;EACrCI,IAAI,EAAE,gBAAgB;EACtBC,UAAU,EAAE;IAAEV,qBAAqB;IAAEC,IAAI;IAAEM;EAAmB,CAAC;EAC/DI,KAAKA,CAAA,EAAG;IACN,MAAM;MAAEC,KAAK;MAAEC;IAAS,IAAIX,QAAQ,EAAE;IACtC,MAAMY,OAAM,GAAIX,QAAQ,CAAC,MAAMS,KAAK,CAACE,OAAO,CAACC,QAAQ,CAAC;IACtD,MAAM;MAAEC,MAAM;MAAEC;IAAQ,IAAIX,QAAQ,EAAE;IACtC,MAAM;MAAEY,KAAK;MAAEC;IAAQ,IAAIhB,QAAQ,CAAC,MAAMS,KAAK,CAACE,OAAO,CAACC,QAAQ,CAAC,CAAC,CAAC,CAAC;IAEpEX,SAAS,CAAC,MAAMS,QAAQ,CAAC,mBAAmB,EAAEO,QAAQ,CAACJ,MAAM,CAACK,EAAE,EAAE,EAAE,CAAC,CAAC,CAAC;IAEvE,OAAO;MACLH,KAAK;MACLC,OAAO;MACPL,OAAO;MACPE,MAAM;MACNC;IACF,CAAC;EACH;AACF,CAAC,CAAC;AAEF,eAAeT,