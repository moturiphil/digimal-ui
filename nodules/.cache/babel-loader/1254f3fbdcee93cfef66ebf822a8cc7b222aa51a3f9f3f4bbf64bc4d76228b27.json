{"ast":null,"code":"import { RecordFormWrapper } from './style';\nimport { Main, BasicFormWrapper } from '../../styled';\nimport { useStore } from 'vuex';\nimport { computed, onMounted, reactive, ref, watchEffect } from 'vue';\nimport { useRoute } from 'vue-router';\nimport moment from 'moment';\n// import moment from 'moment';\n\nconst dateFormat = 'YYYY/MM/DD';\nconst UpdateData = {\n  name: 'UpdateData',\n  components: {\n    RecordFormWrapper,\n    Main,\n    BasicFormWrapper\n  },\n  setup() {\n    const {\n      state,\n      dispatch\n    } = useStore();\n    const {\n      params\n    } = useRoute();\n    const isLoading = computed(() => state.fireStore.loading);\n    const crud = computed(() => state.fireStore.data);\n    const url = computed(() => state.fireStore.url);\n    const isFileLoading = computed(() => state.fireStore.fileLoading);\n    const join = ref('2021/04/14');\n    const handleSubmit = values => {\n      dispatch('fireStoreDataUpdate', {\n        id: params.id,\n        data: {\n          ...values,\n          join: moment(join.value).format('YYYY/MM/DD'),\n          image: url.value\n        }\n      });\n      dispatch('fireStoreFileClear');\n    };\n    onMounted(() => {\n      dispatch('fireStoreSingleDataGet', params.id);\n    });\n    const props = {\n      name: 'file',\n      action: 'https://www.mocky.io/v2/5cc8019d300000980a055e76',\n      multiple: false,\n      showUploadList: false,\n      headers: {\n        authorization: 'authorization-text'\n      },\n      onChange(info) {\n        if (info.file.status !== 'uploading') {\n          dispatch('fireStoreFileUploader', info.file.originFileObj);\n        }\n      }\n    };\n    const formState = reactive({\n      name: '',\n      email: '',\n      country: '',\n      city: '',\n      company: '',\n      position: '',\n      status: ''\n    });\n    watchEffect(() => {\n      if (crud.value.name) {\n        formState.name = crud.value.name;\n        formState.email = crud.value.email;\n        formState.country = crud.value.country;\n        formState.city = crud.value.city;\n        formState.company = crud.value.company;\n        join.value = crud.value.join;\n        formState.position = crud.value.position;\n        formState.status = crud.value.status;\n      }\n    });\n    return {\n      isLoading,\n      url,\n      isFileLoading,\n      handleSubmit,\n      props,\n      dateFormat,\n      formState,\n      join\n    };\n  }\n};\nexport default UpdateData;","map":{"version":3,"names":["RecordFormWrapper","Main","BasicFormWrapper","useStore","computed","onMounted","reactive","ref","watchEffect","useRoute","moment","dateFormat","UpdateData","name","components","setup","state","dispatch","params","isLoading","fireStore","loading","crud","data","url","isFileLoading","fileLoading","join","handleSubmit","values","id","value","format","image","props","action","multiple","showUploadList","headers","authorization","onChange","info","file","status","originFileObj","formState","email","country","city","company","position"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/crud/fireStore/edit.vue"],"sourcesContent":["<template>\r\n  <sdPageHeader title=\"Update Your Recored\">\r\n    <template #buttons>\r\n      <sdButton class=\"btn-add_new\" size=\"default\" key=\"1\" type=\"primary\">\r\n        <router-link to=\"/crud/fireStore-view\">View All</router-link>\r\n      </sdButton>\r\n    </template>\r\n  </sdPageHeader>\r\n  <Main>\r\n    <a-row :gutter=\"15\">\r\n      <a-col :xs=\"24\">\r\n        <div v-if=\"isLoading\" class=\"spin\">\r\n          <a-spin />\r\n        </div>\r\n        <RecordFormWrapper v-else>\r\n          <sdCards headless>\r\n            <a-row justify=\"center\">\r\n              <a-col :xl=\"10\" :md=\"16\" :xs=\"24\">\r\n                <BasicFormWrapper>\r\n                  <a-form\r\n                    class=\"add-record-form\"\r\n                    :style=\"{ width: '100%' }\"\r\n                    layout=\"vertical\"\r\n                    name=\"addnew\"\r\n                    :model=\"formState\"\r\n                    @finish=\"handleSubmit\"\r\n                  >\r\n                    <figure class=\"pro-image align-center-v\">\r\n                      <img :src=\"url === null ? require('@/static/img/avatar/profileImage.png') : url\" alt=\"\" />\r\n                      <figcaption>\r\n                        <a-upload v-bind=\"props\">\r\n                          <a class=\"upload-btn\" to=\"#\">\r\n                            <sdFeatherIcons type=\"camera\" size=\"16\" />\r\n                          </a>\r\n                        </a-upload>\r\n                        <div class=\"info\">\r\n                          <sdHeading as=\"h4\">Profile Photo</sdHeading>\r\n                        </div>\r\n\r\n                        <div v-if=\"isFileLoading\" class=\"isUploadSpain\">\r\n                          <a-spin />\r\n                        </div>\r\n                      </figcaption>\r\n                    </figure>\r\n                    <a-form-item name=\"name\" label=\"Name\">\r\n                      <a-input v-model:value=\"formState.name\" placeholder=\"Input Name\" />\r\n                    </a-form-item>\r\n                    <a-form-item name=\"email\" label=\"Email\">\r\n                      <a-input v-model:value=\"formState.email\" type=\"email\" placeholder=\"example@gmail.com\" />\r\n                    </a-form-item>\r\n                    <a-form-item name=\"country\" label=\"Country\">\r\n                      <a-select v-model:value=\"formState.country\" :style=\"{ width: '100%' }\">\r\n                        <a-select-option value=\"\">Please Select</a-select-option>\r\n                        <a-select-option value=\"bangladesh\">Bangladesh</a-select-option>\r\n                        <a-select-option value=\"india\">India</a-select-option>\r\n                        <a-select-option value=\"pakistan\">Pakistan</a-select-option>\r\n                        <a-select-option value=\"srilanka\">Srilanka</a-select-option>\r\n                      </a-select>\r\n                    </a-form-item>\r\n                    <a-form-item name=\"city\" label=\"City\">\r\n                      <a-select v-model:value=\"formState.city\" :style=\"{ width: '100%' }\">\r\n                        <a-select-option value=\"\">Please Select</a-select-option>\r\n                        <a-select-option value=\"dhaka\">Dhaka</a-select-option>\r\n                        <a-select-option value=\"mymensingh\">Mymensingh</a-select-option>\r\n                        <a-select-option value=\"khulna\">Khulna</a-select-option>\r\n                        <a-select-option value=\"barisal\">Barisal</a-select-option>\r\n                      </a-select>\r\n                    </a-form-item>\r\n                    <a-form-item name=\"company\" label=\"Company\">\r\n                      <a-input v-model:value=\"formState.company\" placeholder=\"Company Name\" />\r\n                    </a-form-item>\r\n                    <a-form-item name=\"position\" label=\"Position\">\r\n                      <a-input v-model:value=\"formState.position\" placeholder=\"Position\" />\r\n                    </a-form-item>\r\n                    <a-form-item label=\"Joining Date\">\r\n                      <a-date-picker :style=\"{ width: '100%' }\" v-model:value=\"join\" :format=\"dateFormat\" />\r\n                    </a-form-item>\r\n                    <a-form-item name=\"status\" label=\"Status\">\r\n                      <a-radio-group v-model:value=\"formState.status\">\r\n                        <a-radio value=\"active\">Active</a-radio>\r\n                        <a-radio value=\"deactivated\">Deactivated</a-radio>\r\n                        <a-radio value=\"blocked\">Blocked</a-radio>\r\n                      </a-radio-group>\r\n                    </a-form-item>\r\n                    <div class=\"record-form-actions text-right\">\r\n                      <sdButton size=\"default\" htmlType=\"Save\" type=\"primary\">\r\n                        {{ isLoading ? 'Loading...' : 'Submit' }}\r\n                      </sdButton>\r\n                    </div>\r\n                  </a-form>\r\n                </BasicFormWrapper>\r\n              </a-col>\r\n            </a-row>\r\n          </sdCards>\r\n        </RecordFormWrapper>\r\n      </a-col>\r\n    </a-row>\r\n  </Main>\r\n</template>\r\n<script>\r\nimport { RecordFormWrapper } from './style';\r\nimport { Main, BasicFormWrapper } from '../../styled';\r\nimport { useStore } from 'vuex';\r\nimport { computed, onMounted, reactive, ref, watchEffect } from 'vue';\r\nimport { useRoute } from 'vue-router';\r\nimport moment from 'moment';\r\n// import moment from 'moment';\r\n\r\nconst dateFormat = 'YYYY/MM/DD';\r\n\r\nconst UpdateData = {\r\n  name: 'UpdateData',\r\n  components: { RecordFormWrapper, Main, BasicFormWrapper },\r\n  setup() {\r\n    const { state, dispatch } = useStore();\r\n    const { params } = useRoute();\r\n    const isLoading = computed(() => state.fireStore.loading);\r\n    const crud = computed(() => state.fireStore.data);\r\n    const url = computed(() => state.fireStore.url);\r\n    const isFileLoading = computed(() => state.fireStore.fileLoading);\r\n    const join = ref('2021/04/14');\r\n\r\n    const handleSubmit = values => {\r\n      dispatch('fireStoreDataUpdate', {\r\n        id: params.id,\r\n        data: {\r\n          ...values,\r\n          join: moment(join.value).format('YYYY/MM/DD'),\r\n          image: url.value,\r\n        },\r\n      });\r\n      dispatch('fireStoreFileClear');\r\n    };\r\n\r\n    onMounted(() => {\r\n      dispatch('fireStoreSingleDataGet', params.id);\r\n    });\r\n\r\n    const props = {\r\n      name: 'file',\r\n      action: 'https://www.mocky.io/v2/5cc8019d300000980a055e76',\r\n      multiple: false,\r\n      showUploadList: false,\r\n      headers: {\r\n        authorization: 'authorization-text',\r\n      },\r\n      onChange(info) {\r\n        if (info.file.status !== 'uploading') {\r\n          dispatch('fireStoreFileUploader', info.file.originFileObj);\r\n        }\r\n      },\r\n    };\r\n\r\n    const formState = reactive({\r\n      name: '',\r\n      email: '',\r\n      country: '',\r\n      city: '',\r\n      company: '',\r\n      position: '',\r\n      status: '',\r\n    });\r\n\r\n    watchEffect(() => {\r\n      if (crud.value.name) {\r\n        formState.name = crud.value.name;\r\n        formState.email = crud.value.email;\r\n        formState.country = crud.value.country;\r\n        formState.city = crud.value.city;\r\n        formState.company = crud.value.company;\r\n        join.value = crud.value.join;\r\n        formState.position = crud.value.position;\r\n        formState.status = crud.value.status;\r\n      }\r\n    });\r\n\r\n    return {\r\n      isLoading,\r\n      url,\r\n      isFileLoading,\r\n      handleSubmit,\r\n      props,\r\n      dateFormat,\r\n      formState,\r\n      join,\r\n    };\r\n  },\r\n};\r\n\r\nexport default UpdateData;\r\n</script>\r\n"],"mappings":"AAoGA,SAASA,iBAAgB,QAAS,SAAS;AAC3C,SAASC,IAAI,EAAEC,gBAAe,QAAS,cAAc;AACrD,SAASC,QAAO,QAAS,MAAM;AAC/B,SAASC,QAAQ,EAAEC,SAAS,EAAEC,QAAQ,EAAEC,GAAG,EAAEC,WAAU,QAAS,KAAK;AACrE,SAASC,QAAO,QAAS,YAAY;AACrC,OAAOC,MAAK,MAAO,QAAQ;AAC3B;;AAEA,MAAMC,UAAS,GAAI,YAAY;AAE/B,MAAMC,UAAS,GAAI;EACjBC,IAAI,EAAE,YAAY;EAClBC,UAAU,EAAE;IAAEd,iBAAiB;IAAEC,IAAI;IAAEC;EAAiB,CAAC;EACzDa,KAAKA,CAAA,EAAG;IACN,MAAM;MAAEC,KAAK;MAAEC;IAAS,IAAId,QAAQ,EAAE;IACtC,MAAM;MAAEe;IAAO,IAAIT,QAAQ,EAAE;IAC7B,MAAMU,SAAQ,GAAIf,QAAQ,CAAC,MAAMY,KAAK,CAACI,SAAS,CAACC,OAAO,CAAC;IACzD,MAAMC,IAAG,GAAIlB,QAAQ,CAAC,MAAMY,KAAK,CAACI,SAAS,CAACG,IAAI,CAAC;IACjD,MAAMC,GAAE,GAAIpB,QAAQ,CAAC,MAAMY,KAAK,CAACI,SAAS,CAACI,GAAG,CAAC;IAC/C,MAAMC,aAAY,GAAIrB,QAAQ,CAAC,MAAMY,KAAK,CAACI,SAAS,CAACM,WAAW,CAAC;IACjE,MAAMC,IAAG,GAAIpB,GAAG,CAAC,YAAY,CAAC;IAE9B,MAAMqB,YAAW,GAAIC,MAAK,IAAK;MAC7BZ,QAAQ,CAAC