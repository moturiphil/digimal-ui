{"ast":null,"code":"import authHeader from \"../../../services/auth-header\";\nimport { useRoute } from \"vue-router\";\nimport axios from \"axios\";\nexport default {\n  data() {\n    return {\n      data: [],\n      formState: {\n        layout: \"vertical\"\n      },\n      promoCode: \"\",\n      current: 1\n    };\n  },\n  mounted() {\n    const {\n      params,\n      query\n    } = useRoute();\n    console.log({\n      params,\n      query\n    });\n    const API_URL = `${process.env.VUE_APP_BASE_URL}/payroll_detail?payroll_list_id=${query.id}`;\n    axios.get(API_URL, {\n      headers: authHeader()\n    }).then(response => {\n      this.data = response.data.data;\n      console.log(this.data);\n    }).catch(error => {\n      console.error(error);\n    });\n  },\n  methods: {\n    submitPromo() {},\n    onSubmit() {}\n  }\n};","map":{"version":3,"names":["authHeader","useRoute","axios","data","formState","layout","promoCode","current","mounted","params","query","console","log","API_URL","process","env","VUE_APP_BASE_URL","id","get","headers","then","response","catch","error","methods","submitPromo","onSubmit"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/pages/payroll/PaySummary.vue"],"sourcesContent":["<template>\n  <div class=\"activity-summary-inner\">\n    <br />\n    <div v-for=\"item in data\" :key=\"item.id\">\n      <sdHeading class=\"summary-total\" as=\"h4\">\n        <!-- <span class=\"activity\">{{ item.item }} : </span> -->\n        <span class=\"activity\">{{ item.item }} : </span>\n        <span class=\"amount\">{{ item.amount }}</span>\n      </sdHeading>\n      <br />\n    </div>\n    <br />\n    <a-form\n      :layout=\"formState.layout\"\n      :model=\"formState\"\n      :onFinish=\"submitPromo\"\n    >\n      <div class=\"promo-apply-form\">\n        <a-form-item name=\"promoCode\" label=\"Comments\">\n          <a-input v-model:value=\"promoCode\" placeholder=\"Comment\" />\n        </a-form-item>\n        <a-form-item>\n          <sdButton htmlType=\"submit\" size=\"default\" type=\"success\" outlined>\n            Approve\n          </sdButton>\n          &nbsp;&nbsp;\n          <sdButton htmlType=\"submit\" size=\"default\" type=\"danger\" outlined>\n            Decline\n          </sdButton>\n        </a-form-item>\n      </div>\n    </a-form>\n    <sdButton\n      v-if=\"current === 3\"\n      @click=\"onSubmit\"\n      class=\"btn-proceed\"\n      type=\"secondary\"\n      size=\"large\"\n    >\n      <a to=\"#\">Place Order</a>\n    </sdButton>\n  </div>\n</template>\n\n<script>\nimport authHeader from \"../../../services/auth-header\";\nimport { useRoute } from \"vue-router\";\nimport axios from \"axios\";\n\nexport default {\n  data() {\n    return {\n      data: [],\n      formState: {\n        layout: \"vertical\",\n      },\n      promoCode: \"\",\n      current: 1,\n    };\n  },\n  mounted() {\n    const { params, query } = useRoute();\n    console.log({ params, query });\n    const API_URL = `${process.env.VUE_APP_BASE_URL}/payroll_detail?payroll_list_id=${query.id}`;\n    axios\n      .get(API_URL, {\n        headers: authHeader(),\n      })\n      .then((response) => {\n        this.data = response.data.data;\n        console.log(this.data);\n      })\n      .catch((error) => {\n        console.error(error);\n      });\n  },\n  methods: {\n    submitPromo() {},\n    onSubmit() {},\n  },\n};\n</script>\n"],"mappings":"AA6CA,OAAOA,UAAS,MAAO,+BAA+B;AACtD,SAASC,QAAO,QAAS,YAAY;AACrC,OAAOC,KAAI,MAAO,OAAO;AAEzB,eAAe;EACbC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLA,IAAI,EAAE,EAAE;MACRC,SAAS,EAAE;QACTC,MAAM,EAAE;MACV,CAAC;MACDC,SAAS,EAAE,EAAE;MACbC,OAAO,EAAE;IACX,CAAC;EACH,CAAC;EACDC,OAAOA,CAAA,EAAG;IACR,MAAM;MAAEC,MAAM;MAAEC;IAAM,IAAIT,QAAQ,EAAE;IACpCU,OAAO,CAACC,GAAG,CAAC;MAAEH,MAAM;MAAEC;IAAM,CAAC,CAAC;IAC9B,MAAMG,OAAM,GAAK,GAAEC,OAAO,CAACC,GAAG,CAACC,gBAAiB,mCAAkCN,KAAK,CAACO,EAAG,EAAC;IAC5Ff,KAAI,CACDgB,GAAG,CAACL,OAAO,EAAE;MACZM,OAAO,EAAEnB,UAAU;IACrB,CAAC,EACAoB,IAAI,CAAEC,QAAQ,