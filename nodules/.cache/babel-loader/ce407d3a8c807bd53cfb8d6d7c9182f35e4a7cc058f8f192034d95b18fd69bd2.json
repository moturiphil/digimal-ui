{"ast":null,"code":"import { Main } from '../styled';\nimport { defineComponent } from 'vue';\nimport { BreadcrumbWrapperStyle } from './ui-elements-styled';\nexport default defineComponent({\n  name: 'Badge',\n  components: {\n    Main,\n    BreadcrumbWrapperStyle\n  },\n  data() {\n    return {\n      basePath: '/components/breadcrumb',\n      routes: [{\n        path: 'index',\n        breadcrumbName: 'home'\n      }, {\n        path: 'first',\n        breadcrumbName: 'first',\n        children: [{\n          path: '/general',\n          breadcrumbName: 'General'\n        }, {\n          path: '/layout',\n          breadcrumbName: 'Layout'\n        }, {\n          path: '/navigation',\n          breadcrumbName: 'Navigation'\n        }]\n      }, {\n        path: 'second',\n        breadcrumbName: 'second'\n      }]\n    };\n  }\n});","map":{"version":3,"names":["Main","defineComponent","BreadcrumbWrapperStyle","name","components","data","basePath","routes","path","breadcrumbName","children"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/uiElements/Breadcrumb.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <sdPageHeader title=\"Breadcrumb\">\r\n      <template v-slot:buttons>\r\n        <div class=\"page-header-actions\">\r\n          <sdCalendarButton />\r\n          <sdExportButton />\r\n          <sdShareButton />\r\n          <sdButton size=\"small\" type=\"primary\">\r\n            <sdFeatherIcons type=\"plus\" size=\"14\" />\r\n            Add New\r\n          </sdButton>\r\n        </div>\r\n      </template>\r\n    </sdPageHeader>\r\n    <Main>\r\n      <a-row :gutter=\"25\">\r\n        <a-col :md=\"12\" :sm=\"24\" :xs=\"24\">\r\n          <sdCards title=\"Basic\">\r\n            <BreadcrumbWrapperStyle>\r\n              <a-breadcrumb>\r\n                <a-breadcrumb-item>Home</a-breadcrumb-item>\r\n                <a-breadcrumb-item>\r\n                  <a to=\"#\">Application Center</a>\r\n                </a-breadcrumb-item>\r\n                <a-breadcrumb-item>\r\n                  <a to=\"#\">Application List</a>\r\n                </a-breadcrumb-item>\r\n                <a-breadcrumb-item>An Application</a-breadcrumb-item>\r\n              </a-breadcrumb>\r\n            </BreadcrumbWrapperStyle>\r\n          </sdCards>\r\n          <sdCards title=\"Other Router Integration\">\r\n            <BreadcrumbWrapperStyle>\r\n              <a-breadcrumb :routes=\"routes\">\r\n                <template v-slot:itemRender=\"{ route, routes, paths }\">\r\n                  <span v-if=\"routes.indexOf(route) === routes.length - 1\">\r\n                    {{ route.breadcrumbName }}\r\n                  </span>\r\n                  <router-link v-else :to=\"`${basePath}/${paths.join('/')}`\">\r\n                    {{ route.breadcrumbName }}\r\n                  </router-link>\r\n                </template>\r\n              </a-breadcrumb>\r\n              <br />\r\n              {{ $route.path }}\r\n            </BreadcrumbWrapperStyle>\r\n          </sdCards>\r\n          <sdCards title=\"Bread crumbs with drop down menu\">\r\n            <BreadcrumbWrapperStyle>\r\n              <a-breadcrumb>\r\n                <a-breadcrumb-item>Ant Design Vue</a-breadcrumb-item>\r\n                <a-breadcrumb-item><a href=\"\">Component</a></a-breadcrumb-item>\r\n                <a-breadcrumb-item>\r\n                  <a href=\"\">General</a>\r\n                  <template v-slot:overlay>\r\n                    <a-menu>\r\n                      <a-menu-item>\r\n                        <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"http://www.alipay.com/\"> General </a>\r\n                      </a-menu-item>\r\n                      <a-menu-item>\r\n                        <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"http://www.taobao.com/\"> Layout </a>\r\n                      </a-menu-item>\r\n                      <a-menu-item>\r\n                        <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"http://www.tmall.com/\"> Navigation </a>\r\n                      </a-menu-item>\r\n                    </a-menu>\r\n                  </template>\r\n                </a-breadcrumb-item>\r\n                <a-breadcrumb-item>Button</a-breadcrumb-item>\r\n              </a-breadcrumb>\r\n            </BreadcrumbWrapperStyle>\r\n          </sdCards>\r\n        </a-col>\r\n        <a-col :md=\"12\" :sm=\"24\" :xs=\"24\">\r\n          <sdCards title=\"With Icon\">\r\n            <BreadcrumbWrapperStyle>\r\n              <a-breadcrumb>\r\n                <a-breadcrumb-item>\r\n                  <sdFeatherIcons type=\"home\" />\r\n                </a-breadcrumb-item>\r\n                <a-breadcrumb-item>\r\n                  <a to=\"#\">Application Center</a>\r\n                </a-breadcrumb-item>\r\n                <a-breadcrumb-item>\r\n                  <a to=\"#\">\r\n                    <span>Application List</span>\r\n                  </a>\r\n                </a-breadcrumb-item>\r\n                <a-breadcrumb-item>An Application</a-breadcrumb-item>\r\n              </a-breadcrumb>\r\n            </BreadcrumbWrapperStyle>\r\n          </sdCards>\r\n\r\n          <sdCards title=\"Configuring the Separator\">\r\n            <BreadcrumbWrapperStyle>\r\n              <a-breadcrumb separator=\">\">\r\n                <a-breadcrumb-item>Home</a-breadcrumb-item>\r\n                <a-breadcrumb-item>\r\n                  <a to=\"#\">Application Center</a>\r\n                </a-breadcrumb-item>\r\n                <a-breadcrumb-item>\r\n                  <a to=\"#\">Application List</a>\r\n                </a-breadcrumb-item>\r\n                <a-breadcrumb-item>An Application</a-breadcrumb-item>\r\n              </a-breadcrumb>\r\n            </BreadcrumbWrapperStyle>\r\n          </sdCards>\r\n\r\n          <sdCards title=\"Configuring the Separator\">\r\n            <BreadcrumbWrapperStyle>\r\n              <a-breadcrumb separator=\"\">\r\n                <a-breadcrumb-item>Location</a-breadcrumb-item>\r\n                <a-breadcrumb-separator>:</a-breadcrumb-separator>\r\n                <a-breadcrumb-item>\r\n                  <a to=\"#\">Application Center</a>\r\n                </a-breadcrumb-item>\r\n                <a-breadcrumb-separator />\r\n                <a-breadcrumb-item>\r\n                  <a to=\"#\">Application List</a>\r\n                </a-breadcrumb-item>\r\n                <a-breadcrumb-separator />\r\n                <a-breadcrumb-item>An Application</a-breadcrumb-item>\r\n              </a-breadcrumb>\r\n            </BreadcrumbWrapperStyle>\r\n          </sdCards>\r\n        </a-col>\r\n      </a-row>\r\n    </Main>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { Main } from '../styled';\r\nimport { defineComponent } from 'vue';\r\nimport { BreadcrumbWrapperStyle } from './ui-elements-styled';\r\nexport default defineComponent({\r\n  name: 'Badge',\r\n  components: {\r\n    Main,\r\n    BreadcrumbWrapperStyle,\r\n  },\r\n  data() {\r\n    return {\r\n      basePath: '/components/breadcrumb',\r\n      routes: [\r\n        {\r\n          path: 'index',\r\n          breadcrumbName: 'home',\r\n        },\r\n        {\r\n          path: 'first',\r\n          breadcrumbName: 'first',\r\n          children: [\r\n            {\r\n              path: '/general',\r\n              breadcrumbName: 'General',\r\n            },\r\n            {\r\n              path: '/layout',\r\n              breadcrumbName: 'Layout',\r\n            },\r\n            {\r\n              path: '/navigation',\r\n              breadcrumbName: 'Navigation',\r\n            },\r\n          ],\r\n        },\r\n        {\r\n          path: 'second',\r\n          breadcrumbName: 'second',\r\n        },\r\n      ],\r\n    };\r\n  },\r\n});\r\n</script>\r\n"],"mappings":"AAqIA,SAASA,IAAG,QAAS,WAAW;AAChC,SAASC,eAAc,QAAS,KAAK;AACrC,SAASC,sBAAqB,QAAS,sBAAsB;AAC7D,eAAeD,eAAe,CAAC;EAC7BE,IAAI,EAAE,OAAO;EACbC,UAA