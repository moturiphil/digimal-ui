{"ast":null,"code":"import { ProjectDetailsWrapper, TaskLists } from './style';\nimport FileListCard from './overview/FileListCard';\nimport { Main } from '../../styled';\nimport { useStore } from 'vuex';\nimport { computed, onMounted, defineComponent } from 'vue';\nimport { useRoute } from 'vue-router';\nconst ProjectDetails = defineComponent({\n  name: 'ProjectDetails',\n  components: {\n    ProjectDetailsWrapper,\n    TaskLists,\n    Main,\n    FileListCard\n  },\n  setup() {\n    const {\n      state,\n      dispatch\n    } = useStore();\n    const project = computed(() => state.project.singleData);\n    const {\n      params,\n      matched\n    } = useRoute();\n    const {\n      title,\n      content\n    } = computed(() => state.project.singleData[0]);\n    onMounted(() => dispatch('filterSinglePage', parseInt(params.id, 10)));\n    return {\n      title,\n      content,\n      project,\n      params,\n      matched\n    };\n  }\n});\nexport default ProjectDetails;","map":{"version":3,"names":["ProjectDetailsWrapper","TaskLists","FileListCard","Main","useStore","computed","onMounted","defineComponent","useRoute","ProjectDetails","name","components","setup","state","dispatch","project","singleData","params","matched","title","content","parseInt","id"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/apps/project/ProjectDetails.vue"],"sourcesContent":["<template>\r\n  <ProjectDetailsWrapper>\r\n    <sdPageHeader v-if=\"project\">\r\n      <template #title\r\n        ><div key=\"1\" class=\"project-header\">\r\n          <sdHeading as=\"h2\">{{ project[0].title }}</sdHeading>\r\n          <sdButton type=\"primary\" size=\"small\">\r\n            <sdFeatherIcons type=\"plus\" size=\"14\" /> <span>Add Task</span>\r\n          </sdButton>\r\n          <sdButton class=\"btn-markComplete\" :outlined=\"true\" type=\"light\" size=\"small\">\r\n            <sdFeatherIcons type=\"check\" size=\"14\" /> <span>Mark as Complete</span>\r\n          </sdButton>\r\n        </div></template\r\n      >\r\n      <template #buttons>\r\n        <div :key=\"1\" class=\"project-action\">\r\n          <a :key=\"1\" to=\"#\" class=\"project-edit\">\r\n            <sdFeatherIcons type=\"edit-3\" size=\"14\" />\r\n            Edit\r\n          </a>\r\n          <a :key=\"2\" to=\"#\" class=\"project-remove\">\r\n            <sdFeatherIcons type=\"trash-2\" size=\"14\" />\r\n            Remove\r\n          </a>\r\n        </div>\r\n      </template>\r\n    </sdPageHeader>\r\n    <Main>\r\n      <div v-if=\"!project\" class=\"spin\">\r\n        <a-spin />\r\n      </div>\r\n      <a-row v-else :gutter=\"25\">\r\n        <a-col :xxl=\"6\" :xl=\"8\" :md=\"24\" :xs=\"24\">\r\n          <div class=\"project-progress\">\r\n            <h3>Progress</h3>\r\n            <a-progress :percent=\"65\" :stroke-width=\"5\" status=\"active\" />\r\n          </div>\r\n          <sdCards headless>\r\n            <div class=\"state-single\">\r\n              <div class=\"color-primary\">\r\n                <a to=\"#\">\r\n                  <sdFeatherIcons type=\"list\" size=\"25\" />\r\n                </a>\r\n              </div>\r\n              <div>\r\n                <sdHeading as=\"h5\">47</sdHeading>\r\n                <p>Total Task</p>\r\n              </div>\r\n            </div>\r\n            <div class=\"state-single\">\r\n              <div class=\"color-secondary\">\r\n                <a to=\"#\">\r\n                  <sdFeatherIcons type=\"pie-chart\" size=\"25\" />\r\n                </a>\r\n              </div>\r\n              <div>\r\n                <sdHeading as=\"h5\">34</sdHeading>\r\n                <p>Task Completed</p>\r\n              </div>\r\n            </div>\r\n            <div class=\"state-single\">\r\n              <div class=\"color-success\">\r\n                <a to=\"#\">\r\n                  <sdFeatherIcons type=\"layout\" size=\"25\" />\r\n                </a>\r\n              </div>\r\n              <div>\r\n                <sdHeading as=\"h5\">$27,500</sdHeading>\r\n                <p>Spendings</p>\r\n              </div>\r\n            </div>\r\n            <div class=\"state-single\">\r\n              <div class=\"color-warning\">\r\n                <a to=\"#\">\r\n                  <sdFeatherIcons type=\"clock\" size=\"25\" />\r\n                </a>\r\n              </div>\r\n              <div>\r\n                <sdHeading as=\"h5\">250</sdHeading>\r\n                <p>Hours Spent</p>\r\n              </div>\r\n            </div>\r\n          </sdCards>\r\n        </a-col>\r\n        <a-col :xxl=\"12\" :xl=\"16\" :md=\"24\" :xs=\"24\">\r\n          <div class=\"about-project-wrapper\">\r\n            <sdCards title=\"About Project\">\r\n              <div class=\"about-content\">\r\n                <p>{{ project[0].content }}</p>\r\n              </div>\r\n              <div class=\"about-project\">\r\n                <div>\r\n                  <span>Project Owner</span>\r\n                  <p>Peter Jackson</p>\r\n                </div>\r\n                <div>\r\n                  <span>Budget</span>\r\n                  <p>$56,700</p>\r\n                </div>\r\n                <div>\r\n                  <span>Start Date</span>\r\n                  <p class=\"color-primary\">28 Dec 2019</p>\r\n                </div>\r\n                <div>\r\n                  <span>Deadline</span>\r\n                  <p class=\"color-danger\">18 Mar 2021</p>\r\n                </div>\r\n              </div>\r\n            </sdCards>\r\n          </div>\r\n        </a-col>\r\n        <a-col :xxl=\"6\" :lg=\"9\" :xs=\"24\">\r\n          <div class=\"project-users-wrapper\">\r\n            <sdCards title=\"Users\">\r\n              <template #button>\r\n                <sdButton class=\"btn-addUser\" outlined type=\"white\" size=\"small\">\r\n                  <sdFeatherIcons type=\"user-plus\" size=\"14\" /> <span>Add Users</span>\r\n                </sdButton>\r\n              </template>\r\n              <div class=\"project-users\">\r\n                <div class=\"porject-user-single\">\r\n                  <div>\r\n                    <img :src=\"require(`@/static/img/users/1.png`)\" alt=\"\" />\r\n                  </div>\r\n                  <div>\r\n                    <sdHeading as=\"h5\">Meyri Carles</sdHeading>\r\n                    <p>Web Developer</p>\r\n                  </div>\r\n                </div>\r\n                <div class=\"porject-user-single\">\r\n                  <div>\r\n                    <img :src=\"require(`@/static/img/users/3.png`)\" alt=\"\" />\r\n                  </div>\r\n                  <div>\r\n                    <sdHeading as=\"h5\">Tuhin Molla</sdHeading>\r\n                    <p>Project Manager</p>\r\n                  </div>\r\n                </div>\r\n                <div class=\"porject-user-single\">\r\n                  <div>\r\n                    <img :src=\"require(`@/static/img/users/9.jpg`)\" alt=\"\" />\r\n                  </div>\r\n                  <div>\r\n                    <sdHeading as=\"h5\">Billal Hossain</sdHeading>\r\n                    <p>App Developer</p>\r\n                  </div>\r\n                </div>\r\n                <div class=\"porject-user-single\">\r\n                  <div>\r\n                    <img :src=\"require(`@/static/img/users/4.png`)\" alt=\"\" />\r\n                  </div>\r\n                  <div>\r\n                    <sdHeading as=\"h5\">Khalid Hasan</sdHeading>\r\n                    <p>App Developer</p>\r\n                  </div>\r\n                </div>\r\n                <div class=\"porject-user-single\">\r\n                  <div>\r\n                    <img :src=\"require(`@/static/img/users/5.png`)\" alt=\"\" />\r\n                  </div>\r\n                  <div>\r\n                    <sdHeading as=\"h5\">Meyri Carles</sdHeading>\r\n                    <p>Ui Designer</p>\r\n                  </div>\r\n                </div>\r\n              </div>\r\n            </sdCards>\r\n          </div>\r\n        </a-col>\r\n        <a-col :xxl=\"16\" :lg=\"15\" :xs=\"24\">\r\n          <TaskLists>\r\n            <sdCards>\r\n              <template #title>\r\n                <nav>\r\n                  <router-link :to=\"`${matched[1].path.split('/:')[0]}/${params.id}/tasklist`\">Task List</router-link>\r\n                  &nbsp; &nbsp;\r\n                  <router-link :to=\"`${matched[1].path.split('/:')[0]}/${params.id}/activities`\"\r\n                    >Activities</router-link\r\n                  >\r\n                </nav>\r\n              </template>\r\n              <router-view name=\"child\"></router-view>\r\n            </sdCards>\r\n          </TaskLists>\r\n        </a-col>\r\n        <a-col :xxl=\"8\" :xs=\"24\">\r\n          <FileListCard />\r\n        </a-col>\r\n      </a-row>\r\n    </Main>\r\n  </ProjectDetailsWrapper>\r\n</template>\r\n<script>\r\nimport { ProjectDetailsWrapper, TaskLists } from './style';\r\nimport FileListCard from './overview/FileListCard';\r\nimport { Main } from '../../styled';\r\nimport { useStore } from 'vuex';\r\nimport { computed, onMounted, defineComponent } from 'vue';\r\nimport { useRoute } from 'vue-router';\r\n\r\nconst ProjectDetails = defineComponent({\r\n  name: 'ProjectDetails',\r\n  components: { ProjectDetailsWrapper, TaskLists, Main, FileListCard },\r\n  setup() {\r\n    const { state, dispatch } = useStore();\r\n    const project = computed(() => state.project.singleData);\r\n    const { params, matched } = useRoute();\r\n    const { title, content } = computed(() => state.project.singleData[0]);\r\n\r\n    onMounted(() => dispatch('filterSinglePage', parseInt(params.id, 10)));\r\n\r\n    return {\r\n      title,\r\n      content,\r\n      project,\r\n      params,\r\n      matched,\r\n    };\r\n  },\r\n});\r\n\r\nexport default ProjectDetails;\r\n</script>\r\n"],"mappings":"AAiMA,SAASA,qBAAqB,EAAEC,SAAQ,QAAS,SAAS;AAC1D,OAAOC,YAAW,MAAO,yBAAyB;AAClD,SAASC,IAAG,QAAS,cAAc;AACnC,SAASC,QAAO,QAAS,MAAM;AAC/B,SAASC,QAAQ,EAAEC,SAAS,EAAEC,eAAc,QAAS,KAAK;AAC1D,SAASC,QAAO,QAAS,YAAY;AAErC,MAAMC,cAAa,GAAIF,eAAe,CAAC;EACrCG,IAAI,EAAE,gBAAgB;EACtBC,UAAU,EAAE;IAAEX,qBAAqB;IAAEC,SAAS;IAAEE,IAAI;IAAED;EAAa,CAAC;EACpEU,KAAKA,CAAA,EAAG;IACN,MAAM;MAAEC,KAAK;MAAEC;IAAS,IAAIV,QAAQ,EAAE;IACtC,MAAMW,OAAM,GAAIV,QAAQ,CAAC,MAAMQ,KAAK,CAACE,OAAO,CAACC,UAAU,CAAC;IACxD,MAAM;MAAEC,MAAM;MAAEC;IAAQ,IAAIV,QAAQ,EAAE;IACtC,MAAM;MAAEW,KAAK;MAAEC;IAAQ,IAAIf,QAAQ,CAAC,MAAMQ,KAAK,CAACE,OAAO,CAACC,UAAU,CAAC,CAAC,CAAC,CAAC;IAEtEV,SAAS,CAAC,MAAMQ,QAAQ,CAAC,kBAAkB,EAAEO,QAAQ,CAACJ,MAAM,CAACK,EAAE,EAAE,EAAE,CAAC,CAAC,CAAC;IAEtE,OAAO;MACLH,KAAK;MACLC,OAAO;MACPL,OAAO;MACPE,MAAM;MACNC;IACF,CAAC;EACH;AACF,CAAC,CAAC;AAEF,eAAeT,cAAc"},"metadata":{},"sourceType":"module","externalDependencies":[]}