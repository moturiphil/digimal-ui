{"ast":null,"code":"import { toRefs, ref, defineComponent } from 'vue';\nimport VueTypes from 'vue-types';\nimport { StepsStyle, ActionWrapper } from './style';\nconst stepStyle = {\n  marginBottom: 60,\n  boxShadow: '0px -1px 0 0 #e8e8e8 inset'\n};\nconst Steps = defineComponent({\n  name: 'Steps',\n  components: {\n    StepsStyle,\n    ActionWrapper\n  },\n  props: {\n    size: VueTypes.string.def('default'),\n    current: VueTypes.number.def(0),\n    direction: VueTypes.string.def('horizontal'),\n    status: VueTypes.string,\n    description: VueTypes.string,\n    //progressDot: VueTypes.func.def(() => 1),\n    steps: VueTypes.arrayOf(VueTypes.object),\n    wizardItem: VueTypes.arrayOf(VueTypes.object),\n    isSwitch: VueTypes.bool.def(false),\n    navigation: VueTypes.bool.def(false),\n    isFinished: VueTypes.bool.def(false),\n    isVertical: VueTypes.bool.def(false),\n    height: VueTypes.number.def(150)\n  },\n  emits: ['onPrev', 'onNext', 'onDone'],\n  setup(props, {\n    emit\n  }) {\n    const {\n      current\n    } = toRefs(props);\n    const currents = ref(current.value);\n    const next = () => {\n      currents.value = currents.value + 1;\n      emit('onNext', currents.value);\n    };\n    const prev = () => {\n      currents.value = currents.value - 1;\n      emit('onPrev', currents.value);\n    };\n    const onDone = () => {\n      emit('onDone', currents.value);\n    };\n    const onChanges = curr => {\n      currents.value = curr;\n      emit('onChange', curr);\n    };\n    return {\n      onChanges,\n      prev,\n      next,\n      currents,\n      stepStyle,\n      onDone\n    };\n  }\n});\nexport default Steps;","map":{"version":3,"names":["toRefs","ref","defineComponent","VueTypes","StepsStyle","ActionWrapper","stepStyle","marginBottom","boxShadow","Steps","name","components","props","size","string","def","current","number","direction","status","description","steps","arrayOf","object","wizardItem","isSwitch","bool","navigation","isFinished","isVertical","height","emits","setup","emit","currents","value","next","prev","onDone","onChanges","curr"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/components/steps/steps.vue"],"sourcesContent":["<template>\r\n  <StepsStyle\r\n    v-if=\"!isSwitch\"\r\n    :type=\"navigation && 'navigation'\"\r\n    :style=\"navigation && stepStyle\"\r\n    :size=\"size\"\r\n    :current=\"navigation ? currents : current\"\r\n    :direction=\"direction\"\r\n    :status=\"status\"\r\n    @change=\"onChanges\"\r\n  >\r\n    <slot></slot>\r\n  </StepsStyle>\r\n\r\n  <template v-else>\r\n    <StepsStyle v-if=\"steps !== undefined\" :current=\"currents\" :direction=\"direction\" :status=\"status\" :size=\"size\">\r\n      <a-step\r\n        v-for=\"item in steps\"\r\n        :class=\"item.class && item.class\"\r\n        :icon=\"item.icon && item.icon\"\r\n        :key=\"item.title\"\r\n        :title=\"item.title\"\r\n        :description=\"item.titleDescription\"\r\n      >\r\n        <template #description>\r\n          <div v-if=\"item.path\" class=\"wizard-item\">\r\n            <h2>{{ item.subTitle }}</h2>\r\n            <p>{{ item.description }}</p>\r\n            <img :src=\"require('../../static/' + item.path)\" alt=\"\" />\r\n          </div>\r\n        </template>\r\n      </a-step>\r\n    </StepsStyle>\r\n\r\n    <div v-if=\"isVertical\" class=\"steps-wrapper\">\r\n      <div\r\n        class=\"steps-content\"\r\n        :style=\"{ minHeight: height, display: 'flex', justifyContent: 'center', marginTop: 100 }\"\r\n      >\r\n        <slot :name=\"steps[currents].content\"></slot>\r\n      </div>\r\n      <ActionWrapper v-if=\"!isFinished\">\r\n        <div class=\"step-action-wrap\">\r\n          <div class=\"step-action-inner\">\r\n            <a-row>\r\n              <a-col :xs=\"24\">\r\n                <div class=\"steps-action\">\r\n                  <sdButton v-if=\"currents > 0\" class=\"btn-prev\" type=\"light\" @click=\"() => prev()\">\r\n                    <sdFeatherIcons type=\"arrow-left\" size=\"16\" />\r\n                    Previous\r\n                  </sdButton>\r\n\r\n                  <sdButton v-if=\"currents < steps.length - 1\" class=\"btn-next\" type=\"primary\" @click=\"() => next()\">\r\n                    Save & Next\r\n                    <sdFeatherIcons type=\"arrow-right\" size=\"16\" />\r\n                  </sdButton>\r\n\r\n                  <sdButton v-if=\"currents === steps.length - 1\" type=\"primary\" @click=\"onDone\"> Done </sdButton>\r\n                </div>\r\n              </a-col>\r\n            </a-row>\r\n          </div>\r\n        </div>\r\n      </ActionWrapper>\r\n    </div>\r\n    <template v-else>\r\n      <div\r\n        class=\"steps-content\"\r\n        :style=\"{ minHeight: height, display: 'flex', justifyContent: 'center', marginTop: 100 }\"\r\n      >\r\n        <slot :name=\"steps[currents].content\"></slot>\r\n      </div>\r\n      <ActionWrapper v-if=\"!isFinished\">\r\n        <div class=\"step-action-wrap\">\r\n          <div class=\"step-action-inner\">\r\n            <a-row>\r\n              <a-col :xs=\"24\">\r\n                <div class=\"steps-action\">\r\n                  <sdButton v-if=\"currents > 0\" class=\"btn-prev\" type=\"light\" @click=\"() => prev()\">\r\n                    <sdFeatherIcons type=\"arrow-left\" size=\"16\" />\r\n                    <span>Previous</span>\r\n                  </sdButton>\r\n                  <sdButton v-if=\"currents < steps.length - 1\" class=\"btn-next\" type=\"primary\" @click=\"() => next()\">\r\n                    <span>Save & Next</span>\r\n                    <sdFeatherIcons type=\"arrow-right\" size=\"16\" />\r\n                  </sdButton>\r\n                  <sdButton v-if=\"currents === steps.length - 1\" type=\"primary\" @click=\"onDone\">\r\n                    <span>Done</span>\r\n                  </sdButton>\r\n                </div>\r\n              </a-col>\r\n            </a-row>\r\n          </div>\r\n        </div>\r\n      </ActionWrapper>\r\n    </template>\r\n  </template>\r\n</template>\r\n<script>\r\nimport { toRefs, ref, defineComponent } from 'vue';\r\nimport VueTypes from 'vue-types';\r\nimport { StepsStyle, ActionWrapper } from './style';\r\n\r\nconst stepStyle = {\r\n  marginBottom: 60,\r\n  boxShadow: '0px -1px 0 0 #e8e8e8 inset',\r\n};\r\n\r\nconst Steps = defineComponent({\r\n  name: 'Steps',\r\n  components: { StepsStyle, ActionWrapper },\r\n  props: {\r\n    size: VueTypes.string.def('default'),\r\n    current: VueTypes.number.def(0),\r\n    direction: VueTypes.string.def('horizontal'),\r\n    status: VueTypes.string,\r\n    description: VueTypes.string,\r\n    //progressDot: VueTypes.func.def(() => 1),\r\n    steps: VueTypes.arrayOf(VueTypes.object),\r\n    wizardItem: VueTypes.arrayOf(VueTypes.object),\r\n    isSwitch: VueTypes.bool.def(false),\r\n    navigation: VueTypes.bool.def(false),\r\n    isFinished: VueTypes.bool.def(false),\r\n    isVertical: VueTypes.bool.def(false),\r\n    height: VueTypes.number.def(150),\r\n  },\r\n  emits: ['onPrev', 'onNext', 'onDone'],\r\n  setup(props, { emit }) {\r\n    const { current } = toRefs(props);\r\n    const currents = ref(current.value);\r\n    const next = () => {\r\n      currents.value = currents.value + 1;\r\n      emit('onNext', currents.value);\r\n    };\r\n\r\n    const prev = () => {\r\n      currents.value = currents.value - 1;\r\n      emit('onPrev', currents.value);\r\n    };\r\n\r\n    const onDone = () => {\r\n      emit('onDone', currents.value);\r\n    };\r\n\r\n    const onChanges = (curr) => {\r\n      currents.value = curr;\r\n      emit('onChange', curr);\r\n    };\r\n\r\n    return {\r\n      onChanges,\r\n      prev,\r\n      next,\r\n      currents,\r\n      stepStyle,\r\n      onDone,\r\n    };\r\n  },\r\n});\r\n\r\nexport default Steps;\r\n</script>\r\n"],"mappings":"AAmGA,SAASA,MAAM,EAAEC,GAAG,EAAEC,eAAc,QAAS,KAAK;AAClD,OAAOC,QAAO,MAAO,WAAW;AAChC,SAASC,UAAU,EAAEC