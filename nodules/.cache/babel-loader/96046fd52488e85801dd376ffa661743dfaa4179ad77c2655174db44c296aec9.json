{"ast":null,"code":"import { computed, onMounted, reactive, ref, toRefs, defineComponent } from \"vue\";\nimport { useStore } from \"vuex\";\nimport { OrderSummary } from \"../Style\";\nconst OrdersSummary = defineComponent({\n  name: \"OrdersSummary\",\n  components: {\n    OrderSummary\n  },\n  props: [\"subtotal\", \"isExact\", \"path\"],\n  setup() {\n    const {\n      state,\n      dispatch\n    } = useStore();\n    const rtl = computed(() => state.themeLayout.rtlData);\n    const coupon = ref(0);\n    const promo = ref(0);\n    const current = ref(0);\n    const submitPromo = values => {\n      promo.value = values;\n    };\n    const formState = reactive({\n      couponType: \"\",\n      promoCode: \"\",\n      layout: \"vertical\"\n    });\n    const onSubmit = () => {\n      document.querySelectorAll(\"button span\").forEach(item => {\n        if (item.innerHTML === \"Done\") {\n          item.click();\n        }\n      });\n    };\n    onMounted(() => dispatch(\"cartGetData\"));\n    return {\n      onSubmit,\n      submitPromo,\n      current,\n      coupon,\n      rtl,\n      formState,\n      ...toRefs(formState)\n    };\n  }\n});\nexport default OrdersSummary;","map":{"version":3,"names":["computed","onMounted","reactive","ref","toRefs","defineComponent","useStore","OrderSummary","OrdersSummary","name","components","props","setup","state","dispatch","rtl","themeLayout","rtlData","coupon","promo","current","submitPromo","values","value","formState","couponType","promoCode","layout","onSubmit","document","querySelectorAll","forEach","item","innerHTML","click"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/pages/net-distribution/overview/Ordersummary.vue"],"sourcesContent":["<template>\r\n  <sdCards\r\n    :bodyStyle=\"{\r\n      backgroundColor: '#F8F9FB',\r\n      borderRadius: '20px',\r\n    }\"\r\n    headless\r\n  >\r\n    <OrderSummary>\r\n      <sdHeading class=\"summary-table-title\" as=\"h4\"> Order Summary </sdHeading>\r\n      <sdCards\r\n        :bodyStyle=\"{\r\n          backgroundColor: '#ffffff',\r\n          borderRadius: '20px',\r\n        }\"\r\n        headless\r\n      >\r\n        <div class=\"order-summary-inner\">\r\n          <ul class=\"summary-list\">\r\n            <li>\r\n              <span class=\"summary-list-title\">Subtotal :</span>\r\n              <span class=\"summary-list-text\">{{ `$${subtotal}` }}</span>\r\n            </li>\r\n            <li>\r\n              <span class=\"summary-list-title\">Discount :</span>\r\n              <span class=\"summary-list-text\">{{ `$${-20}` }}</span>\r\n            </li>\r\n            <li>\r\n              <span class=\"summary-list-title\">Shipping Charge :</span>\r\n              <span class=\"summary-list-text\">{{ `$${30}` }}</span>\r\n            </li>\r\n          </ul>\r\n          <a-form\r\n            :layout=\"formState.layout\"\r\n            :model=\"formState\"\r\n            :onFinish=\"submitPromo\"\r\n          >\r\n            <a-form-item name=\"couponType\" label=\"\">\r\n              <a-select v-model:value=\"couponType\" :style=\"{ width: '100%' }\">\r\n                <a-select-option value=\"\">\r\n                  <span>\r\n                    <img\r\n                      :src=\"require('@/static/img/Subtraction1.png')\"\r\n                      alt=\"\"\r\n                    />\r\n                    Select Coupon\r\n                  </span>\r\n                </a-select-option>\r\n                <a-select-option value=\"one\">\r\n                  <span>\r\n                    <img\r\n                      :src=\"require('@/static/img/Subtraction1.png')\"\r\n                      alt=\"\"\r\n                    />\r\n                    Coupon one\r\n                  </span>\r\n                </a-select-option>\r\n                <a-select-option value=\"tow\">\r\n                  <span>\r\n                    <img\r\n                      :src=\"require('@/static/img/Subtraction1.png')\"\r\n                      alt=\"\"\r\n                    />\r\n                    Coupon tow\r\n                  </span>\r\n                </a-select-option>\r\n              </a-select>\r\n            </a-form-item>\r\n            <div class=\"promo-apply-form\">\r\n              <a-form-item name=\"promoCode\" label=\"Promo Code\">\r\n                <a-input v-model:value=\"promoCode\" placeholder=\"Promo Code\" />\r\n              </a-form-item>\r\n              <a-form-item>\r\n                <sdButton\r\n                  htmlType=\"submit\"\r\n                  size=\"default\"\r\n                  type=\"success\"\r\n                  outlined\r\n                >\r\n                  Apply\r\n                </sdButton>\r\n              </a-form-item>\r\n            </div>\r\n          </a-form>\r\n          <sdHeading class=\"summary-total\" as=\"h4\">\r\n            <span class=\"summary-total-label\">Total : </span>\r\n            <span class=\"summary-total-amount\">{{\r\n              `$${subtotal + 30 - 20}`\r\n            }}</span>\r\n          </sdHeading>\r\n\r\n          <sdButton\r\n            v-if=\"isExact\"\r\n            class=\"btn-proceed\"\r\n            type=\"secondary\"\r\n            size=\"large\"\r\n          >\r\n            <router-link :to=\"`${path}/checkout`\">\r\n              Proceed To Checkout\r\n              <sdFeatherIcons\r\n                :type=\"!rtl ? 'arrow-right' : 'arrow-left'\"\r\n                size=\"14\"\r\n              />\r\n            </router-link>\r\n          </sdButton>\r\n\r\n          <sdButton\r\n            v-if=\"current === 3\"\r\n            @click=\"onSubmit\"\r\n            class=\"btn-proceed\"\r\n            type=\"secondary\"\r\n            size=\"large\"\r\n          >\r\n            <a to=\"#\">Place Order</a>\r\n          </sdButton>\r\n        </div>\r\n      </sdCards>\r\n    </OrderSummary>\r\n  </sdCards>\r\n</template>\r\n<script>\r\nimport {\r\n  computed,\r\n  onMounted,\r\n  reactive,\r\n  ref,\r\n  toRefs,\r\n  defineComponent,\r\n} from \"vue\";\r\nimport { useStore } from \"vuex\";\r\nimport { OrderSummary } from \"../Style\";\r\n\r\nconst OrdersSummary = defineComponent({\r\n  name: \"OrdersSummary\",\r\n  components: { OrderSummary },\r\n  props: [\"subtotal\", \"isExact\", \"path\"],\r\n  setup() {\r\n    const { state, dispatch } = useStore();\r\n    const rtl = computed(() => state.themeLayout.rtlData);\r\n    const coupon = ref(0);\r\n    const promo = ref(0);\r\n    const current = ref(0);\r\n    const submitPromo = (values) => {\r\n      promo.value = values;\r\n    };\r\n\r\n    const formState = reactive({\r\n      couponType: \"\",\r\n      promoCode: \"\",\r\n      layout: \"vertical\",\r\n    });\r\n\r\n    const onSubmit = () => {\r\n      document.querySelectorAll(\"button span\").forEach((item) => {\r\n        if (item.innerHTML === \"Done\") {\r\n          item.click();\r\n        }\r\n      });\r\n    };\r\n    onMounted(() => dispatch(\"cartGetData\"));\r\n    return {\r\n      onSubmit,\r\n      submitPromo,\r\n      current,\r\n      coupon,\r\n      rtl,\r\n      formState,\r\n      ...toRefs(formState),\r\n    };\r\n  },\r\n});\r\n\r\nexport default OrdersSummary;\r\n</script>\r\n"],"mappings":"AAyHA,SACEA,QAAQ,EACRC,SAAS,EACTC,QAAQ,EACRC,GAAG,EACHC,MAAM,EACNC,eAAe,QACV,KAAK;AACZ,SAASC,QAAO,QAAS,MAAM;AAC/B,SAASC,YAAW,QAAS,UAAU;AAEvC,MAAMC,aAAY,GAAIH,eAAe,CAAC;EACpCI,IAAI,EAAE,eAAe;EACrBC,UAAU,EAAE;IAAEH;EAAa,CAAC;EAC5BI,KAAK,EAAE,CAAC,UAAU,EAAE,SAAS,EAAE,MAAM,CAAC;EACtCC,KAAKA,CAAA,EAAG;IACN,MAAM;MAAEC,KAAK;MAAEC;IAAS,IAAIR,QAAQ,EAAE;IACtC,MAAMS,GAAE,GAAIf,QAAQ,CAAC,MAAMa,KAAK,CAACG,WAAW,CAACC,OAAO,CAAC;IACrD,MAAMC,MAAK,GAAIf,GAAG,CAAC,CAAC,CAAC;IACrB,MAAMgB,KAAI,GAAIhB,GAAG,CAAC,CAAC,CAAC;IACpB,MAAMiB,OAAM,GAAIjB,GAAG,CAAC,CAAC,CAAC;IACtB,MAAMkB,WAAU,GAAKC,MAAM,IAAK;MAC9BH,KAAK,CAACI,KAAI,GAAID,MAAM;IACtB,CAAC;IAED,MAAME,SAAQ,GAAItB,QAAQ,CAAC;MACzBuB,UAAU,EAAE,EAAE;MACdC,SAAS,EAAE,EAAE;MACbC,MAAM,EAAE;IACV,