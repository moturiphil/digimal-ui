{"ast":null,"code":"import { computed, onMounted, ref, defineComponent } from 'vue';\nimport { useStore } from 'vuex';\nimport { CardBarChart } from '../../style';\nimport Chartjs from '../../../../components/utilities/chartjs';\nconst ClosedDeals = defineComponent({\n  name: 'ClosedDeals',\n  components: {\n    CardBarChart,\n    Chartjs\n  },\n  setup() {\n    const {\n      state,\n      dispatch\n    } = useStore();\n    const closeDealTabActive = ref('year');\n    const closeDealState = computed(() => state.chartContent.closeDealData);\n    const cdIsLoading = computed(() => state.chartContent.cdLoading);\n    const height = ref(window.innerWidth <= 575 ? 200 : 178);\n    const closeDealDatasets = computed(() => [{\n      data: closeDealState.value.won,\n      backgroundColor: '#20C99780',\n      hoverBackgroundColor: '#20C997',\n      label: 'Won',\n      average: '50.8',\n      maxBarThickness: 10,\n      barThickness: 12,\n      percent: 49\n    }, {\n      data: closeDealState.value.amount,\n      backgroundColor: '#5F63F280',\n      hoverBackgroundColor: '#5F63F2',\n      label: 'Amount',\n      average: '$28k',\n      maxBarThickness: 10,\n      barThickness: 12,\n      percent: 60\n    }]);\n    onMounted(() => {\n      dispatch('closeDealGetData');\n    });\n    const handleActiveChangeYoutube = (e, value) => {\n      e.preventDefault();\n      closeDealTabActive.value = value;\n      dispatch('closeDealFilterData', value);\n    };\n    return {\n      closeDealState,\n      cdIsLoading,\n      closeDealTabActive,\n      closeDealDatasets,\n      handleActiveChangeYoutube,\n      height\n    };\n  }\n});\nexport default ClosedDeals;","map":{"version":3,"names":["computed","onMounted","ref","defineComponent","useStore","CardBarChart","Chartjs","ClosedDeals","name","components","setup","state","dispatch","closeDealTabActive","closeDealState","chartContent","closeDealData","cdIsLoading","cdLoading","height","window","innerWidth","closeDealDatasets","data","value","won","backgroundColor","hoverBackgroundColor","label","average","maxBarThickness","barThickness","percent","amount","handleActiveChangeYoutube","e","preventDefault"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/dashboard/overview/crm/ClosedDeals.vue"],"sourcesContent":["<template>\r\n  <sdCards v-if=\"closeDealState\" title=\"Closed Deals Performance\">\r\n    <template #button>\r\n      <div class=\"card-nav\">\r\n        <ul>\r\n          <li :class=\"closeDealTabActive === 'week' ? 'active' : 'deactivate'\">\r\n            <router-link @click=\"(e) => handleActiveChangeYoutube(e, 'week')\" to=\"#\"> Week </router-link>\r\n          </li>\r\n          <li :class=\"closeDealTabActive === 'month' ? 'active' : 'deactivate'\">\r\n            <router-link @click=\"(e) => handleActiveChangeYoutube(e, 'month')\" to=\"#\"> Month </router-link>\r\n          </li>\r\n          <li :class=\"closeDealTabActive === 'year' ? 'active' : 'deactivate'\">\r\n            <router-link @click=\"(e) => handleActiveChangeYoutube(e, 'year')\" to=\"#\"> Year </router-link>\r\n          </li>\r\n        </ul>\r\n      </div>\r\n    </template>\r\n\r\n    <div v-if=\"cdIsLoading\" class=\"sd-spin\">\r\n      <a-spin />\r\n    </div>\r\n\r\n    <CardBarChart v-else>\r\n      <div class=\"deals-barChart\">\r\n        <div v-for=\"(item, key) in closeDealDatasets\" :key=\"key + 1\" class=\"card-bar-top\">\r\n          <h4>\r\n            {{ item.label }}\r\n            <p :class=\"item.percent >= 50 ? 'growth-up' : 'growth-down'\">\r\n              <span class=\"deal-value\">{{ item.average }}</span>\r\n              <span class=\"deal-percentage\">\r\n                <sdFeatherIcons :icon=\"item.percent >= 50 ? 'arrow-up' : 'arrow-down'\" size=\"14\" />\r\n                {{ item.percent }}%\r\n              </span>\r\n            </p>\r\n          </h4>\r\n        </div>\r\n      </div>\r\n\r\n      <Chartjs\r\n        class=\"closeDeal\"\r\n        :labels=\"closeDealState.labels\"\r\n        :datasets=\"closeDealDatasets\"\r\n        :options=\"{\r\n          maintainAspectRatio: true,\r\n          responsive: true,\r\n          layout: {\r\n            padding: {\r\n              top: 20,\r\n            },\r\n          },\r\n          legend: {\r\n            display: false,\r\n            position: 'top',\r\n            align: 'end',\r\n            labels: {\r\n              boxWidth: 6,\r\n              display: true,\r\n              usePointStyle: true,\r\n            },\r\n          },\r\n\r\n          scales: {\r\n            yAxes: [\r\n              {\r\n                gridLines: {\r\n                  color: '#e5e9f2',\r\n                  borderDash: [3, 3],\r\n                  zeroLineColor: '#e5e9f2',\r\n                  zeroLineWidth: 1,\r\n                  zeroLineBorderDash: [3, 3],\r\n                },\r\n                ticks: {\r\n                  beginAtZero: true,\r\n                  fontSize: 12,\r\n                  fontColor: '#182b49',\r\n                  max: Math.max(...closeDealState.won),\r\n                  stepSize: Math.max(...closeDealState.won) / 5,\r\n                  display: true,\r\n                  min: 0,\r\n                  padding: 10,\r\n                },\r\n              },\r\n            ],\r\n            xAxes: [\r\n              {\r\n                gridLines: {\r\n                  display: true,\r\n                  zeroLineWidth: 2,\r\n                  zeroLineColor: '#fff',\r\n                  color: 'transparent',\r\n                  z: 1,\r\n                },\r\n                ticks: {\r\n                  beginAtZero: true,\r\n                  fontSize: 12,\r\n                  fontColor: '#182b49',\r\n                  min: 0,\r\n                },\r\n              },\r\n            ],\r\n          },\r\n        }\"\r\n        :height=\"height\"\r\n      />\r\n      <ul class=\"deals-list\">\r\n        <li v-for=\"(item, key) in closeDealDatasets\" :key=\"key + 1\" class=\"custom-label\">\r\n          <span\r\n            :style=\"{\r\n              backgroundColor: item.hoverBackgroundColor,\r\n            }\"\r\n          />\r\n          {{ item.label }}\r\n        </li>\r\n      </ul>\r\n    </CardBarChart>\r\n  </sdCards>\r\n</template>\r\n<script>\r\nimport { computed, onMounted, ref, defineComponent } from 'vue';\r\nimport { useStore } from 'vuex';\r\nimport { CardBarChart } from '../../style';\r\nimport Chartjs from '../../../../components/utilities/chartjs';\r\n\r\nconst ClosedDeals = defineComponent({\r\n  name: 'ClosedDeals',\r\n  components: { CardBarChart, Chartjs },\r\n  setup() {\r\n    const { state, dispatch } = useStore();\r\n    const closeDealTabActive = ref('year');\r\n    const closeDealState = computed(() => state.chartContent.closeDealData);\r\n    const cdIsLoading = computed(() => state.chartContent.cdLoading);\r\n    const height = ref(window.innerWidth <= 575 ? 200 : 178);\r\n    const closeDealDatasets = computed(() => [\r\n      {\r\n        data: closeDealState.value.won,\r\n        backgroundColor: '#20C99780',\r\n        hoverBackgroundColor: '#20C997',\r\n        label: 'Won',\r\n        average: '50.8',\r\n        maxBarThickness: 10,\r\n        barThickness: 12,\r\n        percent: 49,\r\n      },\r\n      {\r\n        data: closeDealState.value.amount,\r\n        backgroundColor: '#5F63F280',\r\n        hoverBackgroundColor: '#5F63F2',\r\n        label: 'Amount',\r\n        average: '$28k',\r\n        maxBarThickness: 10,\r\n        barThickness: 12,\r\n        percent: 60,\r\n      },\r\n    ]);\r\n\r\n    onMounted(() => {\r\n      dispatch('closeDealGetData');\r\n    });\r\n\r\n    const handleActiveChangeYoutube = (e, value) => {\r\n      e.preventDefault();\r\n\r\n      closeDealTabActive.value = value;\r\n\r\n      dispatch('closeDealFilterData', value);\r\n    };\r\n\r\n    return {\r\n      closeDealState,\r\n      cdIsLoading,\r\n      closeDealTabActive,\r\n      closeDealDatasets,\r\n      handleActiveChangeYoutube,\r\n      height,\r\n    };\r\n  },\r\n});\r\n\r\nexport default ClosedDeals;\r\n</script>\r\n"],"mappings":"AAsHA,SAASA,QAAQ,EAAEC,SAAS,EAAEC,GAAG,EAAEC,eAAc,QAAS,KAAK;AAC/D,SAASC,QAAO,QAAS,MAAM;AAC/B,SAASC,YAAW,QAAS,aAAa;AAC1C,OAAOC,OAAM,MAAO,0CAA0C;AAE9D,MAAMC,WAAU,GAAIJ,eAAe,CAAC;EAClCK,IAAI,EAAE,aAAa;EACnBC,UAAU,EAAE;IAAEJ,YAAY;IAAEC;EAAQ,CAAC;EACrCI,KAAKA,CAAA,EAAG;IACN,MAAM;MAAEC,KAAK;MAAEC;IAAS,IAAIR,QAAQ,EAAE;IACtC,MAAMS,kBAAiB,GAAIX,GAAG,CAAC,MAAM,CAAC;IACtC,MAAMY,cAAa,GAAId,QAAQ,CAAC,MAAMW,KAAK,CAACI,YAAY,CAACC,aAAa,CAAC;IACvE,MAAMC,WAAU,GAAIjB,QAAQ,CAAC,MAAMW,KAAK,CAACI,YAAY,CAACG,SAAS,CAAC;IAChE,MAAMC,MAAK,GAAIjB,GAAG,CAACkB,MAAM,CAACC,UAAS,IAAK,GAAE,GAAI,GAAE,GAAI,GAAG,CAAC;IACxD,MAAMC,iBAAgB,GAAItB,QAAQ,CAAC,MAAM,CACvC;MACEuB,IAAI,EAAET,cAAc,CAACU,KAAK,CAACC,GAAG;MAC9BC,eAAe,EAAE,WAAW;MAC5BC,oBAAoB,EAAE,SAAS;MAC/BC,KAAK,EAAE,KAAK;MACZC,OAAO,EAAE,MAAM;MACfC,eAAe,EAAE,EAAE;MACnBC,YAAY,EAAE,EAAE;MAChBC,OAAO,EAAE;IACX,CAAC,EACD;MACET,IAAI,EAAET,cAAc,CAACU,KAAK,CAACS,MAAM;MACjCP,eAAe,EAAE,WAAW;MAC5BC,oBAAoB,EAAE,SAAS;MAC/BC,KAAK,EAAE,QAAQ;MACfC,OAAO,EAAE,MAAM;MACfC,eAAe,EAAE,EAAE;MACnBC,YAAY,EAAE,EAAE;MAChBC,OAAO,EAAE;IACX,CAAC,CACF,CAAC;IAEF/B,SAAS,CAAC,MAAM;MACdW,QAAQ,CAAC,kBAAkB,CAAC;IAC9B,CAAC,CAAC;IAEF,MAAMsB,yBAAwB,GAAIA,CAACC,CAAC,EAAEX,KAAK,KAAK;MAC9CW,CAAC,CAACC,cAAc,EAAE;MAElBvB,kBAAkB,CAACW,KAAI,GAAIA,KAAK;MAEhCZ,QAAQ,CAAC,qBAAqB,EAAEY,KAAK,CAAC;IACxC,CAAC;IAED,OAAO;MACLV,cAAc;MACdG,WAAW;MACXJ,kBAAkB;MAClBS,iBAAiB;MACjBY,yBAAyB;MACzBf;IACF,CAAC;EACH;AACF,CAAC,CAAC;AAEF,eAAeZ,WAAW"},"metadata":{},"sourceType":"module","externalDependencies":[]}