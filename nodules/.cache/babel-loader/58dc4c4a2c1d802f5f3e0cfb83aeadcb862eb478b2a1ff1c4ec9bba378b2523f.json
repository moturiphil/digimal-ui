{"ast":null,"code":"import { isVNode as _isVNode, resolveComponent as _resolveComponent, createVNode as _createVNode, createTextVNode as _createTextVNode } from \"vue\";\nimport { computed, onMounted, reactive, ref } from 'vue';\nimport { useStore } from 'vuex';\nimport Steps from '@/components/steps/steps';\nimport { BasicFormWrapper } from '../../../styled';\nimport { FigureCart, CheckoutWrapper, ProductTable, OrderSummary } from '../Style';\nfunction _isSlot(s) {\n  return typeof s === 'function' || Object.prototype.toString.call(s) === '[object Object]' && !_isVNode(s);\n}\nconst columns = [{\n  title: 'Product',\n  dataIndex: 'product',\n  key: 'product'\n}, {\n  title: 'Price',\n  dataIndex: 'price',\n  key: 'price'\n}, {\n  title: 'Quantity',\n  dataIndex: 'quantity',\n  key: 'quantity'\n}, {\n  title: 'Total',\n  dataIndex: 'total',\n  key: 'total'\n}];\nconst CheckOut = {\n  name: 'Checkout',\n  components: {\n    BasicFormWrapper,\n    FigureCart,\n    CheckoutWrapper,\n    ProductTable,\n    OrderSummary,\n    Steps\n  },\n  setup(_, {\n    emit\n  }) {\n    const {\n      state,\n      dispatch\n    } = useStore();\n    const cartData = computed(() => state.cart.data);\n    const isLoading = computed(() => state.cart.loading);\n    const rtl = computed(() => state.themeLayout.rtlData);\n    const stateAccount = reactive({\n      username: '',\n      email: '',\n      password: ''\n    });\n    const stateAddress = reactive({\n      name: '',\n      company: '',\n      street: '',\n      street2: '',\n      country: '',\n      city: '',\n      phone: '',\n      zip: ''\n    });\n    const stateMethod = reactive({\n      month: '',\n      year: '',\n      name: '',\n      number: ''\n    });\n    const handleAccountSubmit = values => {\n      console.log(values);\n    };\n    const handleAddressSubmit = values => {\n      console.log(values);\n    };\n    const status = ref('process');\n    const isFinished = ref(false);\n    const current = ref(1);\n    onMounted(() => dispatch('cartGetData'));\n    const incrementUpdate = (id, quantity) => {\n      const data = parseInt(quantity, 10) + 1;\n      dispatch('cartUpdateQuantity', {\n        id,\n        quantity: data,\n        cartData: cartData.value\n      });\n    };\n    const decrementUpdate = (id, quantity) => {\n      const data = parseInt(quantity, 10) >= 2 ? parseInt(quantity, 10) - 1 : 1;\n      dispatch('cartUpdateQuantity', {\n        id,\n        quantity: data,\n        cartData: cartData.value\n      });\n    };\n    const cartDeleted = id => {\n      const confirm = window.confirm('Are you sure to delete this product?');\n      if (confirm) dispatch('cartDelete', {\n        id,\n        cartData: cartData.value\n      });\n    };\n    const PlaceOrder = _createVNode(_resolveComponent(\"sdButton\"), {\n      \"class\": \"btn-proceed\",\n      \"type\": \"secondary\",\n      \"size\": \"large\"\n    }, {\n      default: () => [_createVNode(\"a\", {\n        \"to\": \"#\"\n      }, [_createTextVNode(\"Place Order\")])]\n    });\n    const next = () => {\n      emit('onCurrentChange', current, PlaceOrder);\n      status.value = 'process';\n      current.value = current.value + 1;\n    };\n    const prev = () => {\n      emit('onCurrentChange', current, PlaceOrder);\n      status.value = 'process';\n      current.value = current.value - 1;\n    };\n    const done = () => {\n      const confirm = window.confirm('Are sure to submit order?');\n      emit('onCurrentChange', current, PlaceOrder);\n      if (confirm) {\n        status.value = 'finish';\n        isFinished.value = true;\n        current.value = 0;\n      }\n    };\n    const month = ['01', '02', '03', '04', '05', '06', '07', '08', '09', '10', '11', '12'];\n    let subtotal = ref(0);\n    const dataSource = computed(() => {\n      subtotal.value = 0;\n      return state.cart.data.map(data => {\n        const {\n          id,\n          img,\n          name,\n          quantity,\n          price,\n          size,\n          color\n        } = data;\n        subtotal.value += parseInt(quantity, 10) * parseInt(price, 10);\n        return {\n          key: id,\n          product: _createVNode(\"div\", {\n            \"class\": \"cart-single\"\n          }, [_createVNode(FigureCart, null, {\n            default: () => [_createVNode(\"img\", {\n              \"style\": {\n                width: 80\n              },\n              \"src\": require(`@/${img}`),\n              \"alt\": \"\"\n            }, null), _createVNode(\"figcaption\", null, [_createVNode(\"div\", {\n              \"class\": \"cart-single__info\"\n            }, [_createVNode(_resolveComponent(\"sdHeading\"), {\n              \"as\": \"h6\"\n            }, _isSlot(name) ? name : {\n              default: () => [name]\n            }), _createVNode(\"ul\", {\n              \"class\": \"info-list\"\n            }, [_createVNode(\"li\", null, [_createVNode(\"span\", {\n              \"class\": \"info-title\"\n            }, [_createTextVNode(\"Size :\")]), _createVNode(\"span\", null, [size])]), _createVNode(\"li\", null, [_createVNode(\"span\", {\n              \"class\": \"info-title\"\n            }, [_createTextVNode(\" Color :\")]), _createVNode(\"span\", null, [color])])])])])]\n          })]),\n          price: _createVNode(\"span\", {\n            \"class\": \"cart-single-price\"\n          }, [_createTextVNode(\"$\"), price]),\n          quantity: _createVNode(\"div\", {\n            \"class\": \"cart-single-quantity\"\n          }, [_createVNode(_resolveComponent(\"sdButton\"), {\n            \"onClick\": () => decrementUpdate(id, quantity),\n            \"class\": \"btn-dec\",\n            \"type\": \"default\"\n          }, {\n            default: () => [_createVNode(_resolveComponent(\"sdFeatherIcons\"), {\n              \"type\": \"minus\",\n              \"size\": 12\n            }, null)]\n          }), quantity, _createVNode(_resolveComponent(\"sdButton\"), {\n            \"onClick\": () => incrementUpdate(id, quantity),\n            \"class\": \"btn-inc\",\n            \"type\": \"default\"\n          }, {\n            default: () => [_createVNode(_resolveComponent(\"sdFeatherIcons\"), {\n              \"type\": \"plus\",\n              \"size\": 12\n            }, null)]\n          })]),\n          total: _createVNode(\"span\", {\n            \"class\": \"cart-single-t-price\"\n          }, [_createTextVNode(\"$\"), quantity * price]),\n          action: _createVNode(\"div\", {\n            \"class\": \"table-action\"\n          }, [_createVNode(_resolveComponent(\"sdButton\"), {\n            \"onClick\": () => cartDeleted(id),\n            \"class\": \"btn-icon\",\n            \"to\": \"#\",\n            \"size\": \"default\",\n            \"type\": \"danger\",\n            \"shape\": \"circle\",\n            \"transparented\": true\n          }, {\n            default: () => [_createVNode(_resolveComponent(\"sdFeatherIcons\"), {\n              \"type\": \"trash-2\",\n              \"size\": 16\n            }, null)]\n          })])\n        };\n      });\n    });\n    return {\n      prev,\n      stateAccount,\n      handleAccountSubmit,\n      handleAddressSubmit,\n      stateAddress,\n      dataSource,\n      next,\n      done,\n      month,\n      subtotal,\n      PlaceOrder,\n      cartData,\n      isLoading,\n      rtl,\n      status,\n      isFinished,\n      current,\n      cartDeleted,\n      decrementUpdate,\n      incrementUpdate,\n      columns,\n      steps: [{\n        title: 'Create Account',\n        content: 'account'\n      }, {\n        title: 'Shipping Address',\n        content: 'address'\n      }, {\n        title: 'Payment Method',\n        content: 'method'\n      }, {\n        title: 'Review Order',\n        content: 'review'\n      }],\n      stateMethod\n    };\n  }\n};\nexport default CheckOut;","map":{"version":3,"names":["computed","onMounted","reactive","ref","useStore","Steps","BasicFormWrapper","FigureCart","CheckoutWrapper","ProductTable","OrderSummary","_isSlot","s","Object","prototype","toString","call","_isVNode","columns","title","dataIndex","key","CheckOut","name","components","setup","_","emit","state","dispatch","cartData","cart","data","isLoading","loading","rtl","themeLayout","rtlData","stateAccount","username","email","password","stateAddress","company","street","street2","country","city","phone","zip","stateMethod","month","year","number","handleAccountSubmit","values","console","log","handleAddressSubmit","status","isFinished","current","incrementUpdate","id","quantity","parseInt","value","decrementUpdate","cartDeleted","confirm","window","PlaceOrder","_createVNode","_resolveComponent","default","_createTextVNode","next","prev","done","subtotal","dataSource","map","img","price","size","color","product","width","require","onClick","total","action","steps","content"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/pages/net-distribution/overview/CheckOut.vue"],"sourcesContent":["<template>\r\n  <CheckoutWrapper>\r\n    <Steps\r\n      isSwitch\r\n      :current=\"0\"\r\n      :status=\"status\"\r\n      :steps=\"steps\"\r\n      @onNext=\"next\"\r\n      @onPrev=\"prev\"\r\n      @onDone=\"done\"\r\n      :isFinished=\"isFinished\"\r\n    >\r\n      <template #account>\r\n        <BasicFormWrapper class=\"basic-form-inner\">\r\n          <div class=\"atbd-form-checkout\">\r\n            <a-row justify=\"center\">\r\n              <a-col :sm=\"22\" :xs=\"24\">\r\n                <div class=\"create-account-form\">\r\n                  <sdHeading as=\"h4\">1. Please Create Your Account</sdHeading>\r\n                  <a-form :model=\"stateAccount\" @finish=\"handleAccountSubmit\" name=\"account\">\r\n                    <a-form-item name=\"username\" label=\"Username\">\r\n                      <a-input v-model:value=\"stateAccount.username\" placeholder=\"Username\" />\r\n                    </a-form-item>\r\n                    <a-form-item name=\"email\" label=\"Email Address\">\r\n                      <a-input type=\"email\" v-model:value=\"stateAccount.email\" placeholder=\"name@gmail.com\" />\r\n                    </a-form-item>\r\n                    <a-form-item name=\"password\" label=\"Password\">\r\n                      <a-input type=\"password\" v-model:value=\"stateAccount.password\" placeholder=\"Password\" />\r\n                      <span class=\"input-message\">Enter a valid password. Min 6 characters long</span>\r\n                    </a-form-item>\r\n                  </a-form>\r\n                </div>\r\n              </a-col>\r\n            </a-row>\r\n          </div>\r\n        </BasicFormWrapper>\r\n      </template>\r\n      <template #address>\r\n        <BasicFormWrapper class=\"basic-form-inner\">\r\n          <div class=\"atbd-form-checkout\">\r\n            <a-row justify=\"center\">\r\n              <a-col :sm=\"22\" :xs=\"24\">\r\n                <div class=\"create-account-form\">\r\n                  <sdHeading as=\"h4\">2. Please Fill in Your Shipping Address</sdHeading>\r\n                  <a-form @finish=\"handleAddressSubmit\" :model=\"stateAddress\" name=\"address\">\r\n                    <a-form-item name=\"name\" label=\"Contact Name\">\r\n                      <a-input v-model:value=\"stateAddress.name\" placeholder=\"Ibn adam\" />\r\n                    </a-form-item>\r\n                    <a-form-item name=\"company\">\r\n                      <template #label\r\n                        ><span> Company Name <span>(Optional)</span> </span></template\r\n                      >\r\n                      <a-input v-model:value=\"stateAddress.company\" placeholder=\"adam\" />\r\n                    </a-form-item>\r\n                    <a-form-item name=\"phone\" label=\"Phone Number\">\r\n                      <a-input v-model:value=\"stateAddress.phone\" placeholder=\"+880\" />\r\n                    </a-form-item>\r\n                    <a-form-item name=\"country\" label=\"Country/Region\">\r\n                      <a-select v-model:value=\"stateAddress.country\" :style=\"{ width: '100%' }\">\r\n                        <a-select-option value=\"\">Please Select</a-select-option>\r\n                        <a-select-option value=\"bangladesh\">Bangladesh</a-select-option>\r\n                        <a-select-option value=\"india\">India</a-select-option>\r\n                      </a-select>\r\n                    </a-form-item>\r\n                    <a-form-item name=\"street\" label=\"Street Address\">\r\n                      <a-input v-model:value=\"stateAddress.street\" placeholder=\"House Number and Street Name\" />\r\n                    </a-form-item>\r\n                    <a-form-item name=\"street2\" label=\"\">\r\n                      <a-input v-model:value=\"stateAddress.street2\" placeholder=\"Apartment, Suite, Unit etc.\" />\r\n                    </a-form-item>\r\n                    <a-form-item name=\"city\" label=\"City\">\r\n                      <a-input v-model:value=\"stateAddress.city\" placeholder=\"Enter City\" />\r\n                    </a-form-item>\r\n                    <a-form-item name=\"zip\" label=\"Zip/Postal Code\">\r\n                      <a-input v-model:value=\"stateAddress.zip\" placeholder=\"Enter Zip\" />\r\n                    </a-form-item>\r\n                  </a-form>\r\n                </div>\r\n              </a-col>\r\n            </a-row>\r\n          </div>\r\n        </BasicFormWrapper>\r\n      </template>\r\n      <template #method>\r\n        <BasicFormWrapper class=\"basic-form-inner\">\r\n          <div class=\"atbd-form-checkout\">\r\n            <a-row justify=\"center\">\r\n              <a-col :sm=\"22\" :xs=\"24\">\r\n                <div class=\"payment-method-form\">\r\n                  <sdHeading as=\"h4\">3. Please Please Select Your Payment Method</sdHeading>\r\n                  <div class=\"shipping-selection\">\r\n                    <a-radio-group :style=\"{ width: '100%' }\">\r\n                      <div class=\"shipping-selection__card\">\r\n                        <a-radio :style=\"{ width: '100%' }\" value=\"card\">\r\n                          <sdCards\r\n                            headless\r\n                            :bodyStyle=\"{\r\n                              backgroundColor: '#F8F9FB',\r\n                              borderRadius: '20px',\r\n                              border: '1px solid #F1F2F6',\r\n                            }\"\r\n                          >\r\n                            <div class=\"supported-card d-flex\">\r\n                              <span>Credit/Debit Card</span>\r\n                              <div class=\"supported-card_logos\">\r\n                                <img\r\n                                  :style=\"{ width: '50px' }\"\r\n                                  :src=\"require('@/static/img/cards-logo/ms.png')\"\r\n                                  alt=\"\"\r\n                                />\r\n                                <img\r\n                                  :style=\"{ width: '50px' }\"\r\n                                  :src=\"require('@/static/img/cards-logo/american-express.png')\"\r\n                                  alt=\"\"\r\n                                />\r\n                                <img\r\n                                  :style=\"{ width: '50px' }\"\r\n                                  :src=\"require('@/static/img/cards-logo/visa.png')\"\r\n                                  alt=\"\"\r\n                                />\r\n                              </div>\r\n                            </div>\r\n                            <sdCards headless :style=\"{ marginBottom: 0 }\">\r\n                              <a-form @finish=\"handleMethodSubmit\" :model=\"stateMethod\" name=\"info\">\r\n                                <a-form-item name=\"number\" label=\"Card Number\">\r\n                                  <a-input v-model:value=\"stateMethod.number\" placeholder=\"6547-8702-6987-2527\" />\r\n                                </a-form-item>\r\n                                <a-form-item name=\"name\" label=\"Name on Card\">\r\n                                  <a-input v-model:value=\"stateMethod.name\" placeholder=\"Full name\" />\r\n                                </a-form-item>\r\n                                <a-form-item name=\"month\" label=\"Expiration Date\">\r\n                                  <a-select v-model:value=\"stateMethod.month\" :style=\"{ width: '100%' }\">\r\n                                    <a-select-option value=\"\">MM</a-select-option>\r\n                                    <a-select-option v-for=\"value in month\" :key=\"value\" :value=\"value\">\r\n                                      {{ value }}\r\n                                    </a-select-option>\r\n                                  </a-select>\r\n                                </a-form-item>\r\n                                <a-form-item name=\"year\">\r\n                                  <a-select v-model:value=\"stateMethod.year\" :style=\"{ width: '100%' }\">\r\n                                    <a-select-option value=\"\">YY</a-select-option>\r\n                                    <a-select-option :value=\"new Date().getFullYear()\">{{\r\n                                      new Date().getFullYear()\r\n                                    }}</a-select-option>\r\n\r\n                                    <a-select-option\r\n                                      v-for=\"value in month\"\r\n                                      :key=\"value\"\r\n                                      :value=\"parseInt(new Date().getFullYear(), 10) + parseInt(value, 10)\"\r\n                                    >\r\n                                      {{ parseInt(new Date().getFullYear(), 10) + parseInt(value, 10) }}\r\n                                    </a-select-option>\r\n                                  </a-select>\r\n                                </a-form-item>\r\n                                <a-form-item name=\"cvv\" label=\"CVV\">\r\n                                  <div class=\"cvv-wrap\">\r\n                                    <a-input :style=\"{ width: '60%' }\" placeholder=\"XXX\" />\r\n                                    <a class=\"input-leftText\" to=\"#\"> What is this? </a>\r\n                                  </div>\r\n                                </a-form-item>\r\n                              </a-form>\r\n                            </sdCards>\r\n                          </sdCards>\r\n                        </a-radio>\r\n                      </div>\r\n                      <div class=\"shipping-selection__paypal\">\r\n                        <a-radio value=\"payPal\" :style=\"{ width: '100%' }\">\r\n                          Pay With PayPal\r\n                          <img :src=\"require('@/static/img/PayPalLogo.png')\" alt=\"paypal\" />\r\n                        </a-radio>\r\n                      </div>\r\n                      <div class=\"shipping-selection__cash\">\r\n                        <a-radio value=\"cash\" :style=\"{ width: '100%' }\"> Cash on delivery </a-radio>\r\n                      </div>\r\n                    </a-radio-group>\r\n                  </div>\r\n                </div>\r\n              </a-col>\r\n            </a-row>\r\n          </div>\r\n        </BasicFormWrapper>\r\n      </template>\r\n      <template #review>\r\n        <BasicFormWrapper v-if=\"status !== 'finish'\" :style=\"{ width: '100%' }\">\r\n          <div class=\"atbd-review-order\" :style=\"{ width: '100%' }\">\r\n            <sdHeading as=\"h4\">4. Review and confirm Order</sdHeading>\r\n            <sdCards :bodyStyle=\"{ backgroundColor: '#F8F9FB', borderRadius: 10 }\" headless>\r\n              <div class=\"atbd-review-order__single\">\r\n                <sdCards headless>\r\n                  <div class=\"atbd-review-order__shippingTitle\">\r\n                    <sdHeading as=\"h5\">\r\n                      Shipping Information\r\n                      <a to=\"#\">\r\n                        <sdFeatherIcons type=\"edit\" />\r\n                        Edit\r\n                      </a>\r\n                    </sdHeading>\r\n                  </div>\r\n                  <article class=\"atbd-review-order__shippingInfo\">\r\n                    <a-radio-group :style=\"{ width: '100%' }\">\r\n                      <a-radio value=\"ms\" :style=\"{ width: '100%' }\">\r\n                        <div class=\"shipping-info-text\">\r\n                          <sdHeading as=\"h6\">Ibn Adam</sdHeading>\r\n                          <sdHeading as=\"h6\">Phone: +61412345678</sdHeading>\r\n                          <p>\r\n                            795 Folsom Ave, Suite 600 <br />\r\n                            San Francisco, CA 94107 <br />\r\n                            United States\r\n                          </p>\r\n                        </div>\r\n                      </a-radio>\r\n                    </a-radio-group>\r\n                    <a class=\"btn-addNew\" to=\"#\"> + Add New Address </a>\r\n                  </article>\r\n                </sdCards>\r\n              </div>\r\n              <div class=\"atbd-review-order__single\">\r\n                <sdCards headless>\r\n                  <div>\r\n                    <sdHeading as=\"h5\">Payment Method</sdHeading>\r\n                  </div>\r\n                  <a-radio-group :style=\"{ width: '100%' }\">\r\n                    <a-radio value=\"ms\" :style=\"{ width: '100%' }\">\r\n                      <div class=\"method-info\">\r\n                        <img :src=\"require('@/static/img/ms.svg')\" alt=\"\" />\r\n                        **** **** **** 2597\r\n                      </div>\r\n                    </a-radio>\r\n                  </a-radio-group>\r\n                  <a class=\"btn-addCard\" to=\"#\"> + Add New Card </a>\r\n                </sdCards>\r\n              </div>\r\n\r\n              <div class=\"atbd-review-order__single\">\r\n                <sdCards headless>\r\n                  <ProductTable>\r\n                    <div class=\"table-cart table-responsive\">\r\n                      <a-table :pagination=\"false\" :dataSource=\"dataSource\" :columns=\"columns\" />\r\n                    </div>\r\n                  </ProductTable>\r\n\r\n                  <a-row justify=\"end\">\r\n                    <a-col :xxl=\"8\" :xl=\"5\" :md=\"9\" :sm=\"14\" :xs=\"24\" :offset=\"!rtl ? 10 : 0\">\r\n                      <OrderSummary>\r\n                        <div class=\"invoice-summary-inner\">\r\n                          <ul class=\"summary-list\">\r\n                            <li>\r\n                              <span class=\"summary-list-title\">Subtotal :</span>\r\n                              <span class=\"summary-list-text\">{{ `$${subtotal}` }}</span>\r\n                            </li>\r\n                            <li>\r\n                              <span class=\"summary-list-title\">Discount :</span>\r\n                              <span class=\"summary-list-text\">{{ `$${-20}` }}</span>\r\n                            </li>\r\n                            <li>\r\n                              <span class=\"summary-list-title\">Shipping Charge :</span>\r\n                              <span class=\"summary-list-text\">{{ `$${30}` }}</span>\r\n                            </li>\r\n                          </ul>\r\n                          <sdHeading class=\"summary-total\" as=\"h4\">\r\n                            <span class=\"summary-total-label\">Total : </span>\r\n                            <span class=\"summary-total-amount\">{{ `$${subtotal + 30 - 20}` }}</span>\r\n                          </sdHeading>\r\n                        </div>\r\n                      </OrderSummary>\r\n                    </a-col>\r\n                  </a-row>\r\n                </sdCards>\r\n              </div>\r\n            </sdCards>\r\n          </div>\r\n        </BasicFormWrapper>\r\n\r\n        <a-row v-else justify=\"start\" :style=\"{ width: '100%' }\">\r\n          <a-col :xl=\"20\" :xs=\"24\">\r\n            <div class=\"checkout-successful\">\r\n              <sdCards\r\n                headless\r\n                :bodyStyle=\"{\r\n                  backgroundColor: '#F8F9FB',\r\n                  borderRadius: '20px',\r\n                }\"\r\n              >\r\n                <sdCards headless>\r\n                  <span class=\"icon-success\">\r\n                    <sdFeatherIcons type=\"check\" />\r\n                  </span>\r\n                  <sdHeading as=\"h3\">Payment Successful</sdHeading>\r\n                  <p>Thank you! We have received your Payment</p>\r\n                </sdCards>\r\n              </sdCards>\r\n            </div>\r\n          </a-col>\r\n        </a-row>\r\n      </template>\r\n    </Steps>\r\n  </CheckoutWrapper>\r\n</template>\r\n<script>\r\nimport { computed, onMounted, reactive, ref } from 'vue';\r\nimport { useStore } from 'vuex';\r\nimport Steps from '@/components/steps/steps';\r\nimport { BasicFormWrapper } from '../../../styled';\r\nimport { FigureCart, CheckoutWrapper, ProductTable, OrderSummary } from '../Style';\r\n\r\nconst columns = [\r\n  {\r\n    title: 'Product',\r\n    dataIndex: 'product',\r\n    key: 'product',\r\n  },\r\n  {\r\n    title: 'Price',\r\n    dataIndex: 'price',\r\n    key: 'price',\r\n  },\r\n  {\r\n    title: 'Quantity',\r\n    dataIndex: 'quantity',\r\n    key: 'quantity',\r\n  },\r\n  {\r\n    title: 'Total',\r\n    dataIndex: 'total',\r\n    key: 'total',\r\n  },\r\n];\r\n\r\nconst CheckOut = {\r\n  name: 'Checkout',\r\n  components: { BasicFormWrapper, FigureCart, CheckoutWrapper, ProductTable, OrderSummary, Steps },\r\n  setup(_, { emit }) {\r\n    const { state, dispatch } = useStore();\r\n    const cartData = computed(() => state.cart.data);\r\n    const isLoading = computed(() => state.cart.loading);\r\n    const rtl = computed(() => state.themeLayout.rtlData);\r\n\r\n    const stateAccount = reactive({\r\n      username: '',\r\n      email: '',\r\n      password: '',\r\n    });\r\n\r\n    const stateAddress = reactive({\r\n      name: '',\r\n      company: '',\r\n      street: '',\r\n      street2: '',\r\n      country: '',\r\n      city: '',\r\n      phone: '',\r\n      zip: '',\r\n    });\r\n\r\n    const stateMethod = reactive({\r\n      month: '',\r\n      year: '',\r\n      name: '',\r\n      number: '',\r\n    });\r\n\r\n    const handleAccountSubmit = (values) => {\r\n      console.log(values);\r\n    };\r\n\r\n    const handleAddressSubmit = (values) => {\r\n      console.log(values);\r\n    };\r\n\r\n    const status = ref('process');\r\n    const isFinished = ref(false);\r\n    const current = ref(1);\r\n\r\n    onMounted(() => dispatch('cartGetData'));\r\n\r\n    const incrementUpdate = (id, quantity) => {\r\n      const data = parseInt(quantity, 10) + 1;\r\n      dispatch('cartUpdateQuantity', { id, quantity: data, cartData: cartData.value });\r\n    };\r\n\r\n    const decrementUpdate = (id, quantity) => {\r\n      const data = parseInt(quantity, 10) >= 2 ? parseInt(quantity, 10) - 1 : 1;\r\n      dispatch('cartUpdateQuantity', { id, quantity: data, cartData: cartData.value });\r\n    };\r\n\r\n    const cartDeleted = (id) => {\r\n      const confirm = window.confirm('Are you sure to delete this product?');\r\n      if (confirm) dispatch('cartDelete', { id, cartData: cartData.value });\r\n    };\r\n\r\n    const PlaceOrder = (\r\n      <sdButton class=\"btn-proceed\" type=\"secondary\" size=\"large\">\r\n        <a to=\"#\">Place Order</a>\r\n      </sdButton>\r\n    );\r\n\r\n    const next = () => {\r\n      emit('onCurrentChange', current, PlaceOrder);\r\n      status.value = 'process';\r\n      current.value = current.value + 1;\r\n    };\r\n\r\n    const prev = () => {\r\n      emit('onCurrentChange', current, PlaceOrder);\r\n      status.value = 'process';\r\n      current.value = current.value - 1;\r\n    };\r\n\r\n    const done = () => {\r\n      const confirm = window.confirm('Are sure to submit order?');\r\n      emit('onCurrentChange', current, PlaceOrder);\r\n      if (confirm) {\r\n        status.value = 'finish';\r\n        isFinished.value = true;\r\n        current.value = 0;\r\n      }\r\n    };\r\n    const month = ['01', '02', '03', '04', '05', '06', '07', '08', '09', '10', '11', '12'];\r\n    let subtotal = ref(0);\r\n\r\n    const dataSource = computed(() => {\r\n      subtotal.value = 0;\r\n      return state.cart.data.map((data) => {\r\n        const { id, img, name, quantity, price, size, color } = data;\r\n        subtotal.value += parseInt(quantity, 10) * parseInt(price, 10);\r\n\r\n        return {\r\n          key: id,\r\n          product: (\r\n            <div class=\"cart-single\">\r\n              <FigureCart>\r\n                <img style={{ width: 80 }} src={require(`@/${img}`)} alt=\"\" />\r\n                <figcaption>\r\n                  <div class=\"cart-single__info\">\r\n                    <sdHeading as=\"h6\">{name}</sdHeading>\r\n                    <ul class=\"info-list\">\r\n                      <li>\r\n                        <span class=\"info-title\">Size :</span>\r\n                        <span>{size}</span>\r\n                      </li>\r\n                      <li>\r\n                        <span class=\"info-title\"> Color :</span>\r\n                        <span>{color}</span>\r\n                      </li>\r\n                    </ul>\r\n                  </div>\r\n                </figcaption>\r\n              </FigureCart>\r\n            </div>\r\n          ),\r\n          price: <span class=\"cart-single-price\">${price}</span>,\r\n          quantity: (\r\n            <div class=\"cart-single-quantity\">\r\n              <sdButton onClick={() => decrementUpdate(id, quantity)} class=\"btn-dec\" type=\"default\">\r\n                <sdFeatherIcons type=\"minus\" size={12} />\r\n              </sdButton>\r\n              {quantity}\r\n              <sdButton onClick={() => incrementUpdate(id, quantity)} class=\"btn-inc\" type=\"default\">\r\n                <sdFeatherIcons type=\"plus\" size={12} />\r\n              </sdButton>\r\n            </div>\r\n          ),\r\n          total: <span class=\"cart-single-t-price\">${quantity * price}</span>,\r\n          action: (\r\n            <div class=\"table-action\">\r\n              <sdButton\r\n                onClick={() => cartDeleted(id)}\r\n                class=\"btn-icon\"\r\n                to=\"#\"\r\n                size=\"default\"\r\n                type=\"danger\"\r\n                shape=\"circle\"\r\n                transparented\r\n              >\r\n                <sdFeatherIcons type=\"trash-2\" size={16} />\r\n              </sdButton>\r\n            </div>\r\n          ),\r\n        };\r\n      });\r\n    });\r\n\r\n    return {\r\n      prev,\r\n      stateAccount,\r\n      handleAccountSubmit,\r\n      handleAddressSubmit,\r\n      stateAddress,\r\n      dataSource,\r\n      next,\r\n      done,\r\n      month,\r\n      subtotal,\r\n      PlaceOrder,\r\n      cartData,\r\n      isLoading,\r\n      rtl,\r\n      status,\r\n      isFinished,\r\n      current,\r\n      cartDeleted,\r\n      decrementUpdate,\r\n      incrementUpdate,\r\n      columns,\r\n      steps: [\r\n        {\r\n          title: 'Create Account',\r\n          content: 'account',\r\n        },\r\n        {\r\n          title: 'Shipping Address',\r\n          content: 'address',\r\n        },\r\n        {\r\n          title: 'Payment Method',\r\n          content: 'method',\r\n        },\r\n        {\r\n          title: 'Review Order',\r\n          content: 'review',\r\n        },\r\n      ],\r\n      stateMethod,\r\n    };\r\n  },\r\n};\r\n\r\nexport default CheckOut;\r\n</script>\r\n"],"mappings":";AA2S