{"ast":null,"code":"import \"ant-design-vue/es/notification/style\";\nimport _notification from \"ant-design-vue/es/notification\";\nimport \"core-js/modules/es.array.push.js\";\nimport { RecordFormWrapper } from \"../style\";\nimport { Main, BasicFormWrapper } from \"../../styled\";\nimport { useStore } from \"vuex\";\nimport { reactive, ref, defineComponent, computed, onMounted } from \"vue\";\n// import axios from \"axios\";\n\nimport authHeader from \"../../../services/auth-header\";\nimport { useRouter } from \"vue-router\";\nconst dateFormat = \"YYYY-MM-DD\";\nconst AddNew = defineComponent({\n  name: \"AddNew\",\n  components: {\n    RecordFormWrapper,\n    Main,\n    BasicFormWrapper\n  },\n  data() {\n    const {\n      state\n    } = useStore();\n    const isLoading = computed(() => state.crud.loading);\n    const apiUrl = computed(() => state.crud.url);\n    const isFileLoading = computed(() => state.crud.fileLoading);\n    const join = ref(\"\");\n    const API_URL = `${process.env.VUE_APP_BASE_URL}/net_deliveries`;\n    const router = useRouter();\n    const formState = reactive({\n      post_id: \"\",\n      number_of_nets: \"\",\n      date_received: \"\",\n      received_from: \"\",\n      received_by: \"\"\n    });\n    const {\n      villages,\n      loading,\n      isFacility,\n      users,\n      posts\n    } = reactive({\n      villages: [],\n      loading: true,\n      isFacility: false,\n      users: [],\n      posts: []\n    });\n\n    //get posts\n    const getPosts = async () => {\n      const response = await fetch(`${process.env.VUE_APP_BASE_URL}/posts_data`, {\n        method: \"GET\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          ...authHeader()\n        }\n      });\n      const data = await response.json();\n      console.log(data.data.data);\n      this.posts = data.data.data;\n      // this.posts = data.map((post) => ({\n      //   ...post,\n      // }));\n      this.loading = false;\n    };\n\n    //counties\n    const getVillages = async () => {\n      const response = await fetch(`${process.env.VUE_APP_BASE_URL}/villages/list`, {\n        method: \"GET\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          ...authHeader()\n        }\n      });\n      const data = await response.json();\n      console.log(data);\n      this.villages = data.data;\n      this.loading = false;\n    };\n\n    //users\n    const getUsers = async () => {\n      const response = await fetch(`${process.env.VUE_APP_BASE_URL}/users`, {\n        method: \"GET\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          ...authHeader()\n        }\n      });\n      const data = await response.json();\n      this.users = data.data;\n    };\n    onMounted(() => {\n      getUsers();\n      getVillages();\n      getPosts();\n    });\n    // console.log(formState.isFacility)\n    const handleSubmit = values => {\n      values = {\n        post_id: values.post_id,\n        number_of_nets: values.number_of_nets,\n        date_received: new Date(values.date_received).toISOString().substr(0, 10),\n        received_from: values.received_from,\n        received_by: values.received_by\n      };\n      console.log(values);\n      fetch(API_URL, {\n        method: \"POST\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          ...authHeader()\n        },\n        body: JSON.stringify(values)\n      }).then(response => response.json()).then(({\n        success,\n        data\n      }) => {\n        console.log(data);\n        if (success) {\n          router.push(\"delivered\");\n          _notification[\"success\"]({\n            message: \"Nets Received\",\n            description: \"Nets have been successfully delivered\",\n            duration: 5.5\n          });\n        }\n      }).catch(error => {\n        console.error(\"Error:\", error);\n      });\n    };\n    return {\n      isLoading,\n      loading,\n      apiUrl,\n      isFileLoading,\n      isFacility,\n      handleSubmit,\n      dateFormat,\n      formState,\n      join,\n      villages,\n      posts,\n      users\n    };\n  },\n  beforeRouteEnter(to, from, next) {\n    if (!sessionStorage.getItem(\"user\")) {\n      next(\"/auth/login\");\n    } else {\n      next();\n    }\n  }\n});\nexport default AddNew;","map":{"version":3,"names":["RecordFormWrapper","Main","BasicFormWrapper","useStore","reactive","ref","defineComponent","computed","onMounted","authHeader","useRouter","dateFormat","AddNew","name","components","data","state","isLoading","crud","loading","apiUrl","url","isFileLoading","fileLoading","join","API_URL","process","env","VUE_APP_BASE_URL","router","formState","post_id","number_of_nets","date_received","received_from","received_by","villages","isFacility","users","posts","getPosts","response","fetch","method","headers","json","console","log","getVillages","getUsers","handleSubmit","values","Date","toISOString","substr","body","JSON","stringify","then","success","push","_notification","message","description","duration","catch","error","beforeRouteEnter","to","from","next","sessionStorage","getItem"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/pages/net-distribution/ReceiveNets.vue"],"sourcesContent":["<template>\n  <sdPageHeader title=\"Receive Nets\">\n    <sdButton class=\"btn-add_new\" size=\"default\" key=\"1\" type=\"sucess\">\n      <router-link to=\"/crud/axios-view\">View All</router-link>\n    </sdButton>\n  </sdPageHeader>\n  <Main>\n    <a-row :gutter=\"15\">\n      <a-col :xs=\"24\">\n        <RecordFormWrapper>\n          <sdCards headless>\n            <a-row justify=\"center\">\n              <a-col :xl=\"10\" :md=\"16\" :xs=\"24\">\n                <BasicFormWrapper>\n                  <a-form\n                    class=\"add-record-form\"\n                    :style=\"{ width: '100%' }\"\n                    layout=\"vertical\"\n                    name=\"addnew\"\n                    :model=\"formState\"\n                    @finish=\"handleSubmit\"\n                  >\n                    <a-form-item name=\"post_id\" label=\"Post Name\">\n                      <a-select\n                        size=\"large\"\n                        name=\"basic-select\"\n                        class=\"sDash_fullwidth-select\"\n                        placeholder=\"Select Post\"\n                        v-model:value=\"formState.post_id\"\n                      >\n                        <a-select-option\n                          v-for=\"post in posts\"\n                          :value=\"post.id\"\n                          :key=\"post.id\"\n                          >{{ post.name }}</a-select-option\n                        >\n                      </a-select>\n                    </a-form-item>\n                    <a-form-item name=\"bale_size\" label=\"Bale Size\">\n                      <a-input\n                      v-model:value=\"formState.bale_size\"\n                        placeholder=\"Enter bale size\"\n                        type=\"number\"\n                      >\n                      </a-input>\n                    </a-form-item>\n                    <a-form-item name=\"number_of_nets\" label=\"Number of Bales\">\n                      <a-input\n                        v-model:value=\"formState.number_of_nets\"\n                        placeholder=\"Enter number of bales\"\n                        type=\"number\"\n                      />\n                    </a-form-item>\n                    <a-form-item\n                      name=\"number_of_nets\"\n                      label=\"Delivery Note No.\"\n                    >\n                      <a-input\n                        v-model:value=\"formState.delivery_note_number\"\n                        placeholder=\"Delivery Note No.\"\n                      />\n                    </a-form-item>\n                    <a-form-item name=\"date_received\" label=\"Date Received\">\n                      <a-date-picker\n                        :style=\"{ width: '100%' }\"\n                        v-model:value=\"formState.date_received\"\n                        :format=\"dateFormat\"\n                      />\n                    </a-form-item>\n                    <a-form-item name=\"received_from\" label=\"Received From\">\n                      <a-select\n                        v-model:value=\"formState.received_from\"\n                        v-if=\"!loading\"\n                        placeholder=\"Select Received By\"\n                      >\n                        <a-select-option value=\"KEMSA\">KEMSA</a-select-option>\n                        <a-select-option value=\"MEDS\">MEDS</a-select-option>\n                      </a-select>\n                    </a-form-item>\n\n                    <a-form-item name=\"received_by\" label=\"Received By\">\n                      <a-select\n                        v-model:value=\"formState.received_by\"\n                        v-if=\"!loading\"\n                        placeholder=\"Select Received By\"\n                      >\n                        <a-select-option\n                          v-for=\"user in users\"\n                          :key=\"user.id\"\n                          v-model:value=\"user.id\"\n                        >\n                          {{ user.first_name }}\n                          {{ user.last_name }} - {{ user.id_no }}\n                        </a-select-option>\n                      </a-select>\n                    </a-form-item>\n\n                    <div class=\"record-form-actions text-right\">\n                      <sdButton size=\"default\" htmlType=\"Save\" type=\"success\">\n                        {{ isLoading ? \"Loading...\" : \"Submit\" }}\n                      </sdButton>\n                    </div>\n                  </a-form>\n                </BasicFormWrapper>\n              </a-col>\n            </a-row>\n          </sdCards>\n        </RecordFormWrapper>\n      </a-col>\n    </a-row>\n  </Main>\n</template>\n<script>\nimport { RecordFormWrapper } from \"../style\";\nimport { Main, BasicFormWrapper } from \"../../styled\";\nimport { useStore } from \"vuex\";\nimport { reactive, ref, defineComponent, computed, onMounted } from \"vue\";\n// import axios from \"axios\";\nimport { notification } from \"ant-design-vue\";\nimport authHeader from \"../../../services/auth-header\";\nimport { useRouter } from \"vue-router\";\n\nconst dateFormat = \"YYYY-MM-DD\";\n\nconst AddNew = defineComponent({\n  name: \"AddNew\",\n  components: { RecordFormWrapper, Main, BasicFormWrapper },\n  data() {\n    const { state } = useStore();\n    const isLoading = computed(() => state.crud.loading);\n    const apiUrl = computed(() => state.crud.url);\n    const isFileLoading = computed(() => state.crud.fileLoading);\n    const join = ref(\"\");\n    const API_URL = `${process.env.VUE_APP_BASE_URL}/net_deliveries`;\n    const router = useRouter();\n\n    const formState = reactive({\n      post_id: \"\",\n      number_of_nets: \"\",\n      date_received: \"\",\n      received_from: \"\",\n      received_by: \"\",\n    });\n\n    const { villages, loading, isFacility, users, posts } = reactive({\n      villages: [],\n      loading: true,\n      isFacility: false,\n      users: [],\n      posts: [],\n    });\n\n    //get posts\n    const getPosts = async () => {\n      const response = await fetch(\n        `${process.env.VUE_APP_BASE_URL}/posts_data`,\n        {\n          method: \"GET\",\n          headers: {\n            \"Content-Type\": \"application/json\",\n            ...authHeader(),\n          },\n        }\n      );\n      const data = await response.json();\n      console.log(data.data.data);\n      this.posts = data.data.data;\n      // this.posts = data.map((post) => ({\n      //   ...post,\n      // }));\n      this.loading = false;\n    };\n\n    //counties\n    const getVillages = async () => {\n      const response = await fetch(\n        `${process.env.VUE_APP_BASE_URL}/villages/list`,\n        {\n          method: \"GET\",\n          headers: {\n            \"Content-Type\": \"application/json\",\n            ...authHeader(),\n          },\n        }\n      );\n      const data = await response.json();\n      console.log(data);\n      this.villages = data.data;\n      this.loading = false;\n    };\n\n    //users\n    const getUsers = async () => {\n      const response = await fetch(`${process.env.VUE_APP_BASE_URL}/users`, {\n        method: \"GET\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          ...authHeader(),\n        },\n      });\n      const data = await response.json();\n      this.users = data.data;\n    };\n\n    onMounted(() => {\n      getUsers();\n      getVillages();\n      getPosts();\n    });\n    // console.log(formState.isFacility)\n    const handleSubmit = (values) => {\n      values = {\n        post_id: values.post_id,\n        number_of_nets: values.number_of_nets,\n        date_received: new Date(values.date_received)\n          .toISOString()\n          .substr(0, 10),\n        received_from: values.received_from,\n        received_by: values.received_by,\n      };\n      console.log(values);\n      fetch(API_URL, {\n        method: \"POST\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          ...authHeader(),\n        },\n        body: JSON.stringify(values),\n      })\n        .then((response) => response.json())\n        .then(({ success, data }) => {\n          console.log(data);\n          if (success) {\n            router.push(\"delivered\");\n            notification[\"success\"]({\n              message: \"Nets Received\",\n              description: \"Nets have been successfully delivered\",\n              duration: 5.5,\n            });\n          }\n        })\n        .catch((error) => {\n          console.error(\"Error:\", error);\n        });\n    };\n\n    return {\n      isLoading,\n      loading,\n      apiUrl,\n      isFileLoading,\n      isFacility,\n      handleSubmit,\n      dateFormat,\n      formState,\n      join,\n      villages,\n      posts,\n      users,\n    };\n  },\n  beforeRouteEnter(to, from, next) {\n    if (!sessionStorage.getItem(\"user\")) {\n      next(\"/auth/login\");\n    } else {\n      next();\n    }\n  },\n});\n\nexport default AddNew;\n</script>\n"],"mappings":";;;AAiHA,SAASA,iBAAgB,QAAS,UAAU;AAC5C,SAASC,IAAI,EAAEC,gBAAe,QAAS,cAAc;AACrD,SAASC,QAAO,QAAS,MAAM;AAC/B,SAASC,QAAQ,EAAEC,GAAG,EAAEC,eAAe,EAAEC,QAAQ,EAAEC,SAAQ,QAAS,KAAK;AACzE;;AAEA,OAAOC,UAAS,MAAO,+BAA+B;AACtD,SAASC,SAAQ,QAAS,YAAY;AAEtC,MAAMC,UAAS,GAAI,YAAY;AAE/B,MAAMC,MAAK,GAAIN,eAAe,CAAC;EAC7BO,IAAI,EAAE,QAAQ;EACdC,UAAU,EAAE;IAAEd,iBAAiB;IAAEC,IAAI;IAAEC;EAAiB,CAAC;EACzDa,IAAIA,CAAA,EAAG;IACL,MAAM;MAAEC;IAAM,IAAIb,QAAQ,EAAE;IAC5B,MAAMc,SAAQ,GAAIV,QAAQ,CAAC,MAAMS,KAAK,CAACE,IAAI,CAACC,OAAO,CAAC;IACpD,MAAMC,MAAK,GAAIb,QAAQ,CAAC,MAAMS,KAAK,CAACE,IAAI,CAACG,GAAG,CAAC;IAC7C,MAAMC,aAAY,GAAIf,QAAQ,CAAC,MAAMS,KAAK,CAACE,IAAI,CAACK,WAAW,CAAC;IAC5D,MAAMC,IAAG,GAAInB,GAAG,CAAC,EAAE,CAAC;IACpB,MAAMoB,OAAM,GAAK,GAAEC,OAAO,CAACC,GAAG,CAACC,gBAAiB,iBAAgB;IAChE,MAAMC,MAAK,GAAInB,SAAS,EAAE;IAE1B,MAAMoB,SAAQ,GAAI1B,QAAQ,CAAC;MACzB2B,OAAO,EAAE,EAAE;MACXC,cAAc,EAAE,EAAE;MAClBC,aAAa,EAAE,EAAE;MACjBC,aAAa,EAAE,EAAE;MACjBC,WAAW,EAAE;IACf,CAAC,CAAC;IAEF,MAAM;MAAEC,QAAQ;MAAEjB,OAAO;MAAEkB,UAAU;MAAEC,KAAK;MAAEC;IAAM,IAAInC,QAAQ,CAAC;MAC/DgC,QAAQ,EAAE,EAAE;MACZjB,OAAO,EAAE,IAAI;MACbkB,UAAU,EAAE,KAAK;MACjBC,KAAK,EAAE,EAAE;MACTC,KAAK,EAAE;IACT,CAAC,CAAC;;IAEF;IACA,MAAMC,QAAO,GAAI,MAAAA,CAAA,KAAY;MAC3B,MAAMC,QAAO,GAAI,MAAMC,KAAK,CACzB,GAAEhB,OAAO,CAACC,GAAG,CAACC,gBAAiB,aAAY,EAC5C;QACEe,MAAM,EAAE,KAAK;QACbC,OAAO,EAAE;UACP,cAAc,EAAE,kBAAkB;UAClC,GAAGnC,UAAU;QACf;MACF,EACD;MACD,MAAMM,IAAG,GAAI,MAAM0B,QAAQ,CAACI,IAAI,EAAE;MAClCC,OAAO,CAACC,GAAG,CAAChC,IAAI,CAACA,IAAI,CAACA,IAAI,CAAC;MAC3B,IAAI,CAACwB,KAAI,GAAIxB,IAAI,CAACA,IAAI,CAACA,IAAI;MAC3B;MACA;MACA;M