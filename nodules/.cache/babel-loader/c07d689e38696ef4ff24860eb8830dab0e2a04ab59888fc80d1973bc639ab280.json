   </figure>\r\n        </sdCards>\r\n      </div>\r\n    </sdUserCard>\r\n  </a-col>\r\n</template>\r\n<script>\r\nimport users from '@/demoData/usersData.json';\r\nimport { defineComponent } from 'vue';\r\nconst UserCardStyle = defineComponent({\r\n  name: 'UserCardStyle',\r\n  setup() {\r\n    return {\r\n      users,\r\n    };\r\n  },\r\n});\r\n\r\nexport default UserCardStyle;\r\n</script>\r\n"],"mappings":"AA0CA,OAAOA,KAAI,MAAO,2BAA2B;AAC7C,SAASC,eAAc,QAAS,KAAK;AACrC,MAAMC,aAAY,GAAID,eAAe,CAAC;EACpCE,IAAI,EAAE,eAAe;EACrBC,KAAKA,CAAA,EAAG;IACN,OAAO;MACLJ;IACF,CAAC;EACH;AACF,CAAC,CAAC;AAEF,eAAeE,aAAa"},"metadata":{},"sourceType":"module","externalDependencies":[]}