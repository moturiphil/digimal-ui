{"ast":null,"code":"import { Main } from '../styled';\nimport dayjs from 'dayjs';\nimport { defineComponent } from 'vue';\nconst relativeTime = require('dayjs/plugin/relativeTime');\ndayjs.extend(relativeTime);\nexport default defineComponent({\n  name: 'Comments',\n  components: {\n    Main\n  },\n  data() {\n    return {\n      comments: [],\n      submitting: false,\n      value: '',\n      likes: 0,\n      dislikes: 0,\n      action: null,\n      dayjs,\n      data: [{\n        actions: ['Reply to'],\n        author: 'Han Solo',\n        avatar: 'https://zos.alipayobjects.com/rmsportal/ODTLcjxAfvqbxHnVXCYX.png',\n        content: 'We supply a series of design principles, practical patterns and high quality design resources (Sketch and Axure), to help people create their product prototypes beautifully and efficiently.',\n        datetime: dayjs().subtract(1, 'days')\n      }, {\n        actions: ['Reply to'],\n        author: 'Han Solo',\n        avatar: 'https://zos.alipayobjects.com/rmsportal/ODTLcjxAfvqbxHnVXCYX.png',\n        content: 'We supply a series of design principles, practical patterns and high quality design resources (Sketch and Axure), to help people create their product prototypes beautifully and efficiently.',\n        datetime: dayjs().subtract(2, 'days')\n      }]\n    };\n  },\n  methods: {\n    like() {\n      this.likes = 1;\n      this.dislikes = 0;\n      this.action = 'liked';\n    },\n    dislike() {\n      this.likes = 0;\n      this.dislikes = 1;\n      this.action = 'disliked';\n    },\n    handleSubmit() {\n      if (!this.value) {\n        return;\n      }\n      this.submitting = true;\n      setTimeout(() => {\n        this.submitting = false;\n        this.comments = [{\n          author: 'Han Solo',\n          avatar: 'https://zos.alipayobjects.com/rmsportal/ODTLcjxAfvqbxHnVXCYX.png',\n          content: this.value,\n          datetime: dayjs().fromNow()\n        }, ...this.comments];\n        this.value = '';\n      }, 1000);\n    },\n    handleChange(e) {\n      this.value = e.target.value;\n    }\n  }\n});","map":{"version":3,"names":["Main","dayjs","defineComponent","relativeTime","require","extend","name","components","data","comments","submitting","value","likes","dislikes","action","actions","author","avatar","content","datetime","subtract","methods","like","dislike","handleSubmit","setTimeout","fromNow","handleChange","e","target"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/uiElements/Comments.vue"],"sourcesContent":["/* eslint-disable vue/require-v-for-key */ /* eslint-disable vue/require-v-for-key */\r\n<template>\r\n  <div>\r\n    <sdPageHeader title=\"Comments\">\r\n      <template v-slot:buttons>\r\n        <div class=\"page-header-actions\">\r\n          <sdCalendarButton />\r\n          <sdExportButton />\r\n          <sdShareButton />\r\n          <sdButton size=\"small\" type=\"primary\">\r\n            <sdFeatherIcons type=\"plus\" size=\"14\" />\r\n            Add New\r\n          </sdButton>\r\n        </div>\r\n      </template>\r\n    </sdPageHeader>\r\n    <Main>\r\n      <a-row :gutter=\"25\">\r\n        <a-col :xs=\"24\">\r\n          <sdCards title=\"Basic comment\">\r\n            <a-comment>\r\n              <template v-slot:actions>\r\n                <span key=\"comment-basic-like\">\r\n                  <a-tooltip title=\"Like\">\r\n                    <sdFeatherIcons\r\n                      type=\"thumbs-up\"\r\n                      size=\"12\"\r\n                      :theme=\"action === 'liked' ? 'filled' : 'outlined'\"\r\n                      @click=\"like\"\r\n                    />\r\n                  </a-tooltip>\r\n                  <span class=\"comment-ld-action\">\r\n                    {{ likes }}\r\n                  </span>\r\n                </span>\r\n                <span key=\"comment-basic-dislike\">\r\n                  <a-tooltip title=\"Dislike\">\r\n                    <sdFeatherIcons\r\n                      type=\"thumbs-down\"\r\n                      size=\"12\"\r\n                      ::theme=\"action === 'disliked' ? 'filled' : 'outlined'\"\r\n                      @click=\"dislike\"\r\n                    />\r\n                  </a-tooltip>\r\n                  <span class=\"comment-ld-action\">\r\n                    {{ dislikes }}\r\n                  </span>\r\n                </span>\r\n                <span key=\"comment-basic-reply-to\">Reply to</span>\r\n              </template>\r\n              <template v-slot:author>\r\n                <a>Han Solo</a>\r\n              </template>\r\n\r\n              <template v-slot:avatar>\r\n                <a-avatar src=\"https://zos.alipayobjects.com/rmsportal/ODTLcjxAfvqbxHnVXCYX.png\" alt=\"Han Solo\" />\r\n              </template>\r\n              <template v-slot:content>\r\n                <p>\r\n                  We supply a series of design principles, practical patterns and high quality design resources (Sketch\r\n                  and Axure), to help people create their product prototypes beautifully and efficiently.\r\n                </p>\r\n              </template>\r\n              <template v-slot:datetime>\r\n                <a-tooltip :title=\"dayjs().format('YYYY-MM-DD HH:mm:ss')\">\r\n                  <span>{{ dayjs().fromNow() }}</span>\r\n                </a-tooltip>\r\n              </template>\r\n            </a-comment>\r\n          </sdCards>\r\n        </a-col>\r\n        <a-col :xs=\"24\">\r\n          <sdCards title=\"Usage with list\">\r\n            <a-list\r\n              class=\"comment-list\"\r\n              :header=\"`${data.length} replies`\"\r\n              item-layout=\"horizontal\"\r\n              :data-source=\"data\"\r\n            >\r\n              <template #renderItem=\"{ item }\">\r\n                <a-list-item>\r\n                  <a-comment :author=\"item.author\" :avatar=\"item.avatar\">\r\n                    <template #actions>\r\n                      <span v-for=\"(action, index) in item.actions\" :key=\"index\">{{ action }}</span>\r\n                    </template>\r\n                    <template #content>\r\n                      <p>\r\n                        {{ item.content }}\r\n                      </p>\r\n                    </template>\r\n                    <template #datetime>\r\n                      <a-tooltip :title=\"item.datetime.format('YYYY-MM-DD HH:mm:ss')\">\r\n                        <span>{{ item.datetime.fromNow() }}</span>\r\n                      </a-tooltip>\r\n                    </template>\r\n                  </a-comment>\r\n                </a-list-item>\r\n              </template>\r\n            </a-list>\r\n          </sdCards>\r\n        </a-col>\r\n\r\n        <a-col :xs=\"24\">\r\n          <sdCards title=\"Nested comments\">\r\n            <a-comment>\r\n              <template v-slot:actions>\r\n                <span key=\"comment-nested-reply-to\">Reply to</span>\r\n              </template>\r\n              <template v-slot:author>\r\n                <a>Han Solo</a>\r\n              </template>\r\n              <template v-slot:avatar>\r\n                <a-avatar src=\"https://zos.alipayobjects.com/rmsportal/ODTLcjxAfvqbxHnVXCYX.png\" alt=\"Han Solo\" />\r\n              </template>\r\n              <template v-slot:content>\r\n                <p>\r\n                  We supply a series of design principles, practical patterns and high quality design resources (Sketch\r\n                  and Axure).\r\n                </p>\r\n              </template>\r\n              <a-comment>\r\n                <template v-slot:actions>\r\n                  <span>Reply to</span>\r\n                </template>\r\n                <template v-slot:author>\r\n                  <a>Han Solo</a>\r\n                </template>\r\n                <template v-slot:avatar>\r\n                  <a-avatar src=\"https://zos.alipayobjects.com/rmsportal/ODTLcjxAfvqbxHnVXCYX.png\" alt=\"Han Solo\" />\r\n                </template>\r\n                <template v-slot:content>\r\n                  <p>\r\n                    We supply a series of design principles, practical patterns and high quality design resources\r\n                    (Sketch and Axure).\r\n                  </p>\r\n                </template>\r\n                <a-comment>\r\n                  <template v-slot:actions>\r\n                    <span>Reply to</span>\r\n                  </template>\r\n                  <template v-slot:author>\r\n                    <a>Han Solo</a>\r\n                  </template>\r\n                  <template v-slot:avatar>\r\n                    <a-avatar src=\"https://zos.alipayobjects.com/rmsportal/ODTLcjxAfvqbxHnVXCYX.png\" alt=\"Han Solo\" />\r\n                  </template>\r\n                  <template v-slot:content>\r\n                    <p>\r\n                      We supply a series of design principles, practical patterns and high quality design resources\r\n                      (Sketch and Axure).\r\n                    </p>\r\n                  </template>\r\n                </a-comment>\r\n                <a-comment>\r\n                  <template v-slot:actions>\r\n                    <span>Reply to</span>\r\n                  </template>\r\n                  <template v-slot:author>\r\n                    <a>Han Solo</a>\r\n                  </template>\r\n                  <template v-slot:avatar>\r\n                    <a-avatar src=\"https://zos.alipayobjects.com/rmsportal/ODTLcjxAfvqbxHnVXCYX.png\" alt=\"Han Solo\" />\r\n                  </template>\r\n                  <template v-slot:content>\r\n                    <p>\r\n                      We supply a series of design principles, practical patterns and high quality design resources\r\n                      (Sketch and Axure).\r\n                    </p>\r\n                  </template>\r\n                </a-comment>\r\n              </a-comment>\r\n            </a-comment>\r\n          </sdCards>\r\n        </a-col>\r\n\r\n        <a-col :lg=\"12\" :xs=\"24\">\r\n          <sdCards title=\"Reply Editor\">\r\n            <a-list\r\n              v-if=\"comments.length\"\r\n              :data-source=\"comments\"\r\n              :header=\"`${comments.length} ${comments.length > 1 ? 'replies' : 'reply'}`\"\r\n              item-layout=\"horizontal\"\r\n            >\r\n              <template v-slot:renderItem:iteam>\r\n                <a-list-item>\r\n                  <a-comment\r\n                    :author=\"item.author\"\r\n                    :avatar=\"item.avatar\"\r\n                    :content=\"item.content\"\r\n                    :datetime=\"item.datetime\"\r\n                  />\r\n                </a-list-item>\r\n              </template>\r\n            </a-list>\r\n            <a-comment>\r\n              <template v-slot:avatar>\r\n                <a-avatar src=\"https://zos.alipayobjects.com/rmsportal/ODTLcjxAfvqbxHnVXCYX.png\" alt=\"Han Solo\" />\r\n              </template>\r\n              <template v-slot:content>\r\n                <a-textarea :rows=\"4\" :value=\"value\" @change=\"handleChange\" />\r\n                <sdButton\r\n                  html-type=\"submit\"\r\n                  class=\"add-comment\"\r\n                  size=\"large\"\r\n                  :load=\"true\"\r\n                  type=\"primary\"\r\n                  @click=\"handleSubmit\"\r\n                >\r\n                  Add Comment\r\n                </sdButton>\r\n              </template>\r\n            </a-comment>\r\n          </sdCards>\r\n        </a-col>\r\n      </a-row>\r\n    </Main>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { Main } from '../styled';\r\nimport dayjs from 'dayjs';\r\nimport { defineComponent } from 'vue';\r\n\r\nconst relativeTime = require('dayjs/plugin/relativeTime');\r\ndayjs.extend(relativeTime);\r\n\r\nexport default defineComponent({\r\n  name: 'Comments',\r\n  components: {\r\n    Main,\r\n  },\r\n  data() {\r\n    return {\r\n      comments: [],\r\n      submitting: false,\r\n      value: '',\r\n      likes: 0,\r\n      dislikes: 0,\r\n      action: null,\r\n      dayjs,\r\n      data: [\r\n        {\r\n          actions: ['Reply to'],\r\n          author: 'Han Solo',\r\n          avatar: 'https://zos.alipayobjects.com/rmsportal/ODTLcjxAfvqbxHnVXCYX.png',\r\n          content:\r\n            'We supply a series of design principles, practical patterns and high quality design resources (Sketch and Axure), to help people create their product prototypes beautifully and efficiently.',\r\n          datetime: dayjs().subtract(1, 'days'),\r\n        },\r\n        {\r\n          actions: ['Reply to'],\r\n          author: 'Han Solo',\r\n          avatar: 'https://zos.alipayobjects.com/rmsportal/ODTLcjxAfvqbxHnVXCYX.png',\r\n          content:\r\n            'We supply a series of design principles, practical patterns and high quality design resources (Sketch and Axure), to help people create their product prototypes beautifully and efficiently.',\r\n          datetime: dayjs().subtract(2, 'days'),\r\n        },\r\n      ],\r\n    };\r\n  },\r\n  methods: {\r\n    like() {\r\n      this.likes = 1;\r\n      this.dislikes = 0;\r\n      this.action = 'liked';\r\n    },\r\n    dislike() {\r\n      this.likes = 0;\r\n      this.dislikes = 1;\r\n      this.action = 'disliked';\r\n    },\r\n    handleSubmit() {\r\n      if (!this.value) {\r\n        return;\r\n      }\r\n\r\n      this.submitting = true;\r\n\r\n      setTimeout(() => {\r\n        this.submitting = false;\r\n        this.comments = [\r\n          {\r\n            author: 'Han Solo',\r\n            avatar: 'https://zos.alipayobjects.com/rmsportal/ODTLcjxAfvqbxHnVXCYX.png',\r\n            content: this.value,\r\n            datetime: dayjs().fromNow(),\r\n          },\r\n          ...this.comments,\r\n        ];\r\n        this.value = '';\r\n      }, 1000);\r\n    },\r\n    handleChange(e) {\r\n      this.value = e.target.value;\r\n    },\r\n  },\r\n});\r\n</script>\r\n"],"mappings":"AA4NA,SAASA,IAAG,QAAS,WAAW;AAChC,OAAOC,KAAI,MAAO,OAAO;AACzB,SAASC,eAAc,QAAS,KAAK;AAErC,MAAMC,YAAW,GAAIC,OAAO,CAAC,2BAA2B,CAAC;AACzDH,KAAK,CAACI,MAAM,CAACF,YAAY,CAAC;AAE1B,eAAeD,eAAe,CAAC;EAC7BI,IAAI,EAAE,UAAU;EAChBC,UAAU,EAAE;IACVP;EACF,CAAC;EACDQ,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,QAAQ,EAAE,EAAE;MACZC,UAAU,EAAE,KAAK;MACjBC,KAAK,EAAE,EAAE;MACTC,KAAK,EAAE,CAAC;MACRC,QAAQ,EAAE,CAAC;MACXC,MAAM,EAAE,IAAI;MACZb,KAAK;MACLO,IAAI,EAAE,CACJ;QACEO,OAAO,EAAE,CAAC,UAAU,CAAC;QACrBC,MAAM,EAAE,UAAU;QAClBC,MAAM,EAAE,kEAAkE;QAC1EC,OAAO,EACL,+LAA+L;QACjMC,QAAQ,EAAElB,KAAK,EAAE,CAACmB,QAAQ,CAAC,CAAC,EAAE,MAAM;MACtC,CAAC,EACD;QACEL,OAAO,EAAE,CAAC,UAAU,CAAC;QACrBC,MAAM,EAAE,UAAU;QAClBC,MAAM,EAAE,kEAAkE;QAC1EC,OAAO,EACL,+LAA+L;QACjMC,QAAQ,EAAElB,KAAK,EAAE,CAACmB,QAAQ,CAAC,CAAC,EAAE,MAAM;MACtC,CAAC;IAEL,CAAC;EACH,CAAC;EACDC,OAAO,EAAE;IACPC,IAAIA,CAAA,EAAG;MACL,IAAI,CAACV,KAAI,GAAI,CAAC;MACd,IAAI,CAACC,QAAO,GAAI,CAAC;MACjB,IAAI,CAACC,MAAK,GAAI,OAAO;IACvB,CAAC;IACDS,OAAOA,CAAA,EAAG;MACR,IAAI,CAACX,KAAI,GAAI,CAAC;MACd,IAAI,CAACC,QAAO,GAAI,CAAC;MACjB,IAAI,CAACC,MAAK,GAAI,UAAU;IAC1B,CAAC;IACDU,YAAYA,CAAA,EAAG;MACb,IAAI,CAAC,IAAI,CAACb,KAAK,EAAE;QACf;MACF;MAEA,IAAI,CAACD,UAAS,GAAI,IAAI;MAEtBe,UAAU,CAAC,MAAM;QACf,IAAI,CAACf,UAAS,GAAI,KAAK;QACvB,IAAI,CAACD,QAAO,GAAI,CACd;UACEO,MAAM,EAAE,UAAU;UAClBC,MAAM,EAAE,kEAAkE;UAC1EC,OAAO,EAAE,IAAI,CAACP,KAAK;UACnBQ,QAAQ,EAAElB,KAAK,EAAE,CAACyB,OAAO;QAC3B,CAAC,EACD,GAAG,IAAI,CAACjB,QAAQ,CACjB;QACD,IAAI,CAACE,KAAI,GAAI,EAAE;MACjB,CAAC,EAAE,IAAI,CAAC;IACV,CAAC;IACDgB,YAAYA,CAACC,CAAC,EAAE;MACd,IAAI,CAACjB,KAAI,GAAIiB,CAAC,CAACC,MAAM,CAAClB,KAAK;IAC7B;EACF;AACF,CAAC,CAAC"},"metadata":{},"sourceType":"module","externalDependencies":[]}