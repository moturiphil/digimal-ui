        }\n      });\n      const data = await response.json();\n      this.facilitators = data.data;\n      // console.log(data.data);\n      this.loading = false;\n    };\n    fetchTrainer();\n\n    // const handleSubmit = () => {\n    //   const data = {\n    //     campaign_id: formState.campaign_id,\n    //     trainers: formState.trainer_id,\n    //   };\n\n    //   console.log(data);\n    //   console.log(authHeader());\n    //   console.log(API_URL);\n\n    //   fetch(API_URL, {\n    //     method: \"POST\",\n    //     headers: {\n    //       \"Content-Type\": \"application/json\",\n    //       ...authHeader(),\n    //     },\n    //     body: JSON.stringify(data),\n    //   })\n    //     .then((response) => response.json())\n    //     .then(({ success }) => {\n    //       if (success) {\n    //         router.push(\"event-view\");\n    //         notification[\"success\"]({\n    //           message: \"CHVs added successfully\",\n    //           description: `CHVs added successful to the campaign`,\n    //           duration: 5.5,\n    //         });\n    //       }\n    //     })\n    //     .catch((error) => {\n    //       console.error(\"Error:\", error);\n    //     });\n    // };\n    const handleSubmit = async () => {\n      const data = {\n        campaign_id: formState.campaign_id,\n        trainers: formState.trainer_id\n      };\n      console.log(data);\n      try {\n        const response = await axios.post(API_URL, data, {\n          headers: {\n            \"Content-Type\": \"application/json\",\n            ...authHeader()\n          }\n        });\n        if (response.data.success) {\n          router.push(\"event-view\");\n          _notification[\"success\"]({\n            message: \"CHVs added successfully\",\n            description: `CHVs added successful to the campaign`,\n            duration: 5.5\n          });\n        }\n      } catch (error) {\n        console.error(\"Error:\", error);\n      }\n    };\n    const formState = reactive({\n      campaign_id: null,\n      trainer_id: []\n    });\n\n    // console.log(formState);\n\n    return {\n      isLoading,\n      apiUrl,\n      isFileLoading,\n      join,\n      handleSubmit,\n      formState,\n      campaigns,\n      facilitators,\n      loading\n    };\n  },\n  beforeRouteEnter(to, from, next) {\n    if (!sessionStorage.getItem(\"user\")) {\n      next(\"/auth/login\");\n    } else {\n      next();\n    }\n  }\n});\nexport default AddNew;","map":{"version":3,"names":["RecordFormWrapper","Main","BasicFormWrapper","useStore","reactive","ref","defineComponent","computed","authHeader","useRouter","axios","AddNew","name","components","data","state","isLoading","crud","loading","apiUrl","url","isFileLoading","fileLoading","join","router","API_URL","process","env","VUE_APP_BASE_URL","campaign_url","trainer_url","campaigns","facilitators","fetchCampaigns","response","fetch","method","headers","json","fetchTrainer","handleSubmit","campaign_id","formState","trainers","trainer_id","console","log","post","success","push","_notification","message","description","duration","error","beforeRouteEnter","to","from","next","sessionStorage","getItem"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/pages/household/test.vue"],"sourcesContent":["<template>\n    <sdPageHeader title=\"Assign CHV\">\n      <sdButton class=\"btn-add_new\" size=\"default\" key=\"1\" type=\"success\">\n        <router-link to=\"/crud/axios-view\">View All</router-link>\n      </sdButton>\n    </sdPageHeader>\n    <Main>\n      <a-row :gutter=\"15\">\n        <a-col :xs=\"24\">\n          <RecordFormWrapper>\n            <sdCards headless>\n              <a-row justify=\"center\">\n                <a-col :xl=\"10\" :md=\"16\" :xs=\"24\">\n                  <BasicFormWrapper>\n                    <a-form\n                      class=\"add-record-form\"\n                      :style=\"{ width: '100%' }\"\n                      layout=\"vertical\"\n              