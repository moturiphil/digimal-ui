=> {\n        const response = await fetch(trainer_url, {\n          method: \"GET\",\n          headers: {\n            \"Content-Type\": \"application/json\",\n            ...authHeader(),\n          },\n        });\n        const data = await response.json();\n        this.facilitators = data.data;\n        // console.log(data.data);\n        this.loading = false;\n      };\n      fetchTrainer();\n  \n      // const handleSubmit = () => {\n      //   const data = {\n      //     campaign_id: formState.campaign_id,\n      //     trainers: formState.trainer_id,\n      //   };\n  \n      //   console.log(data);\n      //   console.log(authHeader());\n      //   console.log(API_URL);\n  \n      //   fetch(API_URL, {\n      //     method: \"POST\",\n      //     headers: {\n      //       \"Content-Type\": \"application/json\",\n      //       ...authHeader(),\n      //     },\n      //     body: JSON.stringify(data),\n      //   })\n      //     .then((response) => response.json())\n      //     .then(({ success }) => {\n      //       if (success) {\n      //         router.push(\"event-view\");\n      //         notification[\"success\"]({\n      //           message: \"CHVs added successfully\",\n      //           description: `CHVs added successful to the campaign`,\n      //           duration: 5.5,\n      //         });\n      //       }\n      //     })\n      //     .catch((error) => {\n      //       console.error(\"Error:\", error);\n      //     });\n      // };\n      const handleSubmit = async () => {\n        const data = {\n          campaign_id: formState.campaign_id,\n          trainers: formState.trainer_id,\n        };\n  \n        console.log(data);\n  \n        try {\n          const response = await axios.post(API_URL, data, {\n            headers: {\n              \"Content-Type\": \"application/json\",\n              ...authHeader(),\n            },\n          });\n  \n          if (response.data.success) {\n            router.push(\"event-view\");\n            notification[\"success\"]({\n              message: \"CHVs added successfully\",\n              description: `CHVs added successful to the campaign`,\n              duration: 5.5,\n            });\n          }\n        } catch (error) {\n          console.error(\"Error:\", error);\n        }\n      };\n  \n      const formState = reactive({\n        campaign_id: null,\n        trainer_id: [],\n      });\n  \n      // console.log(formState);\n  \n      return {\n        isLoading,\n        apiUrl,\n        isFileLoading,\n        join,\n        handleSubmit,\n        formState,\n        campaigns,\n        facilitators,\n        loading,\n      };\n    },\n    beforeRouteEnter(to, from, next) {\n      if (!sessionStorage.getItem(\"user\")) {\n        next(\"/auth/login\");\n      } else {\n        next();\n      }\n    },\n  });\n  \n  export default AddNew;\n  </script>\n  "],"mappings":";;;AAyEE,SAASA,iBAAgB,QAAS,SAAS;AAC3C,SAASC,IAAI,EAAEC,gBAAe,QAAS,cAAc;AACrD,SAASC,QAAO,QAAS,MAAM;AAC/B,SAASC,QAAQ,EAAEC,GAAG,EAAEC,eAAe,EAAEC,QAAO,QAAS,KAAK;AAC9D;AACA,OAAOC,UAAS,MAAO,+BAA+B;AAEtD,SAASC,SAAQ,QAAS,YAAY;AACtC,OAAOC,KAAI,MAAO,OAAO;AAEzB,MAAMC,MAAK,GAAIL,eAAe,CAAC;EAC7BM,IAAI,EAAE,QAAQ;EACdC,UAAU,EAAE;IAAEb,iBAAiB;IAAEC,IAAI;IAAEC;EAAiB,CAAC;EAEzDY,IAAIA,CAAA,EAAG;IACL,MAAM;MAAEC;IAAM,IAAIZ,QAAQ,EAAE;IAE5B,MAAMa,SAAQ,GAAIT,QAAQ,CAAC,MAAMQ,KAAK,CAACE,IAAI,CAACC,OAAO,CAAC;IACpD,MAAMC,MAAK,GAAIZ,QAAQ,CAAC,MAAMQ,KAAK,CAACE,IAAI,CAACG,GAAG,CAAC;IAC7C,MAAMC,aAAY,GAAId,QAAQ,CAAC,MAAMQ,KAAK,CAACE,IAAI,CAACK,WAAW,CAAC;IAC5D,MAAMC,IAAG,GAAIlB,GAAG,CAAC,EAAE,CAAC;IAEpB,MAAMmB,MAAK,GAAIf,SAAS,EAAE;IAE1B,MAAMgB,OAAM,GAAK,GAAEC,OAAO,CAACC,GAAG,CAACC,gBAAiB,qBAAoB;IAEpE,MAAMC,YAAW,GAAK,GAAEH,OAAO,CAACC,GAAG,CAACC,gBAAiB,eAAc;IAEnE,MAAME,WAAU,GAAK,GAAEJ,OAAO,CAACC,GAAG,CAACC,gBAAiB,QAAO;IAE3D,MAAM;MAAEG,SAAS;MAAEC,YAAY;MAAEd;IAAQ,IAAId,QAAQ,CAAC;MACpD2B,SAAS,EAAE,EAAE;MACbb,OAAO,EAAE,IAAI;MACbc,YAAY,EAAE;IAChB,CAAC,CAAC;IAEF,MAAMC,cAAa,GAAI,MAAAA,CAAA,KAAY;MACjC,MA