{"ast":null,"code":"import { Main } from '../../styled';\nimport KnowledgeBaseTop from './overview/knowledgebase/KnowledgeTop';\nimport { KnowledgebaseArticleWrap, ArticleTabWrap, PopularArticleWrap, CtaWrap } from './style';\nimport articles from '../../../demoData/article.json';\nimport { defineComponent } from 'vue';\nexport default defineComponent({\n  name: 'KnowledgeBase',\n  components: {\n    Main,\n    KnowledgeBaseTop,\n    KnowledgebaseArticleWrap,\n    ArticleTabWrap,\n    PopularArticleWrap,\n    CtaWrap\n  },\n  setup() {\n    return {\n      articles\n    };\n  }\n});","map":{"version":3,"names":["Main","KnowledgeBaseTop","KnowledgebaseArticleWrap","ArticleTabWrap","PopularArticleWrap","CtaWrap","articles","defineComponent","name","components","setup"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/pages/knowledgebase/Index.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <sdPageHeader title=\"Knowledgebase\">\r\n      <template v-slot:buttons>\r\n        <div class=\"page-header-actions\">\r\n          <sdCalendarButton />\r\n          <sdExportButton />\r\n          <sdShareButton />\r\n          <sdButton size=\"small\" type=\"primary\">\r\n            <sdFeatherIcons type=\"plus\" size=\"14\" />\r\n            Add New\r\n          </sdButton>\r\n        </div>\r\n      </template>\r\n    </sdPageHeader>\r\n    <Main>\r\n      <KnowledgeBaseTop />\r\n      <KnowledgebaseArticleWrap>\r\n        <div class=\"knowledgebase-article-container\">\r\n          <ArticleTabWrap class=\"sDash_article-tab\">\r\n            <div class=\"sDash_article-tab__menu\">\r\n              <nav>\r\n                <ul>\r\n                  <li>\r\n                    <router-link to=\"/page/knowledgebase/base/plugins\">Plugins</router-link>\r\n                  </li>\r\n                  <li>\r\n                    <router-link to=\"/page/knowledgebase/base/themes\">Themes</router-link>\r\n                  </li>\r\n                  <li>\r\n                    <router-link to=\"/page/knowledgebase/base/extensions\">Extensions</router-link>\r\n                  </li>\r\n                </ul>\r\n              </nav>\r\n            </div>\r\n            <div>\r\n              <router-view></router-view>\r\n            </div>\r\n          </ArticleTabWrap>\r\n          <PopularArticleWrap>\r\n            <div class=\"sDash_popular-article sDash_popular-article-container\">\r\n              <h2 class=\"sDash_popular-article__title\">Popular articles</h2>\r\n              <div v-masonry=\"\" transition-duration=\"0.3s\" item-selector=\".item\" class=\"ant-masonry\">\r\n                <div class=\"sDash_popular-article__box\">\r\n                  <a-row>\r\n                    <a-col\r\n                      :md=\"8\"\r\n                      :sm=\"12\"\r\n                      :xs=\"24\"\r\n                      v-masonry-tile\r\n                      class=\"item\"\r\n                      v-for=\"article in articles\"\r\n                      :key=\"article.id\"\r\n                    >\r\n                      <div :class=\"`sDash_popular-article__single theme-${article.type}`\">\r\n                        <h4 class=\"single-article-title\">{{ article.title }}</h4>\r\n                        <p>{{ article.text }}</p>\r\n                        <router-link class=\"btn-link\" to=\"/page/knowledgebase/single/1\">\r\n                          Read more\r\n                        </router-link>\r\n                      </div>\r\n                    </a-col>\r\n                  </a-row>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </PopularArticleWrap>\r\n          <CtaWrap>\r\n            <div class=\"sDash_knowledgebase-cta\">\r\n              <h2 class=\"sDash_knowledgebase-cta__title\">Still no luck? We can help!</h2>\r\n              <p>Contact us and we’ll get back to you as soon as possible.</p>\r\n              <sdButton class=\"btn-rqSubmit\" type=\"primary\" size=\"large\"> Submit a Request </sdButton>\r\n            </div>\r\n          </CtaWrap>\r\n        </div>\r\n      </KnowledgebaseArticleWrap>\r\n    </Main>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport { Main } from '../../styled';\r\n\r\nimport KnowledgeBaseTop from './overview/knowledgebase/KnowledgeTop';\r\nimport { KnowledgebaseArticleWrap, ArticleTabWrap, PopularArticleWrap, CtaWrap } from './style';\r\nimport articles from '../../../demoData/article.json';\r\nimport { defineComponent } from 'vue';\r\nexport default defineComponent({\r\n  name: 'KnowledgeBase',\r\n  components: {\r\n    Main,\r\n    KnowledgeBaseTop,\r\n    KnowledgebaseArticleWrap,\r\n    ArticleTabWrap,\r\n    PopularArticleWrap,\r\n    CtaWrap,\r\n  },\r\n  setup() {\r\n    return {\r\n      articles,\r\n    };\r\n  },\r\n});\r\n</script>\r\n"],"mappings":"AAiFA,SAASA,IAAG,QAAS,cAAc;AAEnC,OAAOC,gBAAe,MAAO,uCAAuC;AACpE,SAASC,wBAAwB,EAAEC,cAAc,EAAEC,kBAAkB,EAAEC,OAAM,QAAS,SAAS;AAC/F,OAAOC,QAAO,MAAO,gCAAgC;AACrD,SAASC,eAAc,QAAS,KAAK;AACrC,eAAeA,eAAe,CAAC;EAC7BC,IAAI,EAAE,eAAe;EACrBC,UAAU,EAAE;IACVT,IAAI;IACJC,gBAAgB;IAChBC,wBAAwB;IACxBC,cAAc;IACdC,kBAAkB;IAClBC;EACF,CAAC;EACDK,KAAKA,CAAA,EAAG;IACN,OAAO;MACLJ;IACF,CAAC;EACH;AACF,CAAC,CAAC"},"metadata":{},"sourceType":"module","externalDependencies":[]}