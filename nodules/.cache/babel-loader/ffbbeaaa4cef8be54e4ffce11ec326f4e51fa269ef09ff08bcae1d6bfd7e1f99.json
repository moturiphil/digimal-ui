 >\n                  <a-form name=\"contact\">\n                    <a-form-item name=\"f_name\">\n                      <a-input\n                        placeholder=\"File Name\"\n                        v-model:value=\"fileName\"\n                        @change=\"updateFileName\"\n                      />\n                    </a-form-item>\n                    <a-form-item name=\"f_type\">\n                      <a-select default-value=\"xlxs\" @change=\"updateFileType\">\n                        <!-- <a-select-option value=\"csv\">CSV</a-select-option> -->\n                        <a-select-option value=\"xlxs\">xlxs</a-select-option>\n                      </a-select>\n                    </a-form-item>\n                    <div class=\"sDash-button-grp\">\n                      <!-- <CSVLink v-if=\"convertedTo === 'csv'\" :filename=\"`${fileName}.csv`\" :data=\"csvJsonData\">\n                        <sdButton @click=\"handleCancel\" class=\"btn-export\" type=\"primary\">\n                          Export\n                        </sdButton>\n                      </CSVLink> -->\n\n                      <sdButton\n                        class=\"btn-export\"\n                        @click=\"() => exportToXLSX(csvData, fileName)\"\n                        type=\"success\"\n                      >\n                        Export\n                      </sdButton>\n\n                      <sdButton\n                        htmlType=\"button\"\n                        @click=\"handleCancel\"\n                        size=\"default\"\n                        type=\"light\"\n                        outlined\n                      >\n                        Cancel\n                      </sdButton>\n                    </div>\n                  </a-form>\n                </sdModal>\n              </template>\n\n              <sdButton\n                v-else\n                class=\"btn-export\"\n                @click=\"warning\"\n                type=\"success\"\n              >\n                Export\n              </sdButton>\n              <sdButton class=\"btn-import\" type=\"success\">\n                <router-link\n                  :to=\"{\n                    path: `/users/import`\n                  }\"\n                  class=\"btn-icon\"\n                  type=\"info\"\n                  shape=\"circle\"\n                >\n                  <!-- <sdFeatherIcons type=\"eye\" size=\"16\" /> -->\n                  &nbsp;&nbsp; Import Master List\n                </router-link>\n              </sdButton>\n\n              <a-input\n                v-model:value=\"searchData\"\n                @change=\"handleSearch\"\n                placeholder=\"Search by Name\"\n              >\n                <template #prefix>\n                  <sdFeatherIcons type=\"search\" size=\"14\" />\n                </template>\n              </a-input>\n            </div>\n            <div\n              class=\"sDash_export-file-table table-bordered table-responsive\"\n            >\n              <a-table\n                :rowSelection=\"rowSelection\"\n                :dataSource=\"usersTableData\"\n                :columns=\"usersTableColumns\"\n                :pagination=\"{\n                  defaultPageSize: 7,\n                  total: usersTableData.length,\n                  showTotal: (total, range) =>\n                    `${range[0]}-${range[1]} of ${total} items`,\n                }\"\n              />\n            </div>\n          </sdCards>\n        </ExportStyleWrap>\n      </a-col>\n    </a-row>\n  </Main>\n</template>\n<script>\nimport * as FileSaver from \"file-saver\";\nimport * as XLSX from \"xlsx\";\nimport { Main, ExportStyleWrap } from \"../../styled\";\nimport { useStore } from \"vuex\";\nimport { computed, ref, watchEffect, onMounted } from \"vue\";\nimport { Modal } from \"ant-design-vue\";\nimport authHeader from \"../../../services/auth-header\";\n// import UserService from \"../../../services/user.service\";\n\nconst Import = {\n  name: \"Import\",\n  components: { Main, ExportStyleWrap },\n  setup() {\n    const { dispatch } = useStore();\n    // const users = computed(() => state.contact.data);\n    const isModalVisible = ref(false);\n    const fileName = ref(\"DigiMal Ke Users\");\n    const convertedTo = ref(\"csv\");\n    const selectedRowKeys = ref(0);\n    const selectedRows = ref([]);\n    const searchData = ref(\"\");\n    const dataSource = ref([]);\n\n    const showModal = () => {\n      isModalVisible.value = true;\n    };\n\n    const handleCancel = () => {\n      isModalVisible.value = false;\n    };\n\n    const handleSearch = () => {\n      dispatch(\"contactSearchData\", searchData.value);\n    };\n    const csvData = [\n      [\n        \"first_name\",\n        \"middle_name\",\n        \"last_name\",\n        \"level_id\",\n        \"org_types_id\",\n        \"role_id\",\n        \"phone_no\",\n      ],\n    ];\n    const csvJsonData = [\n      {\n        first_name: \"first_name\",\n        middle_name: \"middle_name\",\n        last_name: \"last_name\",\n        level_id: \"level_id\",\n        org_types_id: \"org_types_id\",\n        role_id: \"role_id\",\n        phone_no: \"phone_no\",\n      },\n    ];\n    onMounted(async () => {\n      try {\n        const response = await fetch(`${process.env.VUE_APP_BASE_URL}/users`, {\n          method: \"GET\",\n          headers: authHeader(),\n        });\n        const data = await response.json();\n        dataSource.value = data.data;\n        console.log(data.data);\n      } catch (error) {\n        console.error(error);\n      }\n    });\n    // console.log(data);\n    const usersTableData = computed(() =>\n      dataSource.value\n        .sort((a, b) => {\n          return b.time - a.time;\n        })\n        .map((user) => {\n          // console.log(user);\n          const {\n            first_name,\n            middle_name,\n            last_name,\n            level_id,\n            org_types_id,\n            role_id,\n            phone_no,\n          } = user;\n          return {\n            first_name: first_name,\n            middle_name: middle_name,\n            last_name: last_name,\n            org_types_id: org_types_id,\n            level_id: level_id,\n            role_id: role_id,\n            phone_no: phone_no,\n          };\n        })\n    );\n\n    const usersTableColumns = [\n      {\n        title: \"First Name\",\n        dataIndex: \"first_name\",\n        key: \"id\",\n      },\n      {\n        title: \"Middle Name\",\n        dataIndex: \"middle_name\",\n        key: \"id\",\n      },\n      {\n        title: \"Last Name\",\n        dataIndex: \"last_name\",\n        key: \"id\",\n      },\n      {\n        title: \"Level\",\n        dataIndex: \"level_id\",\n        key: \"id\",\n      },\n      {\n        title: \"Organization\",\n        dataIndex: \"org_types_id\",\n        key: \"id\",\n      },\n      {\n        title: \"Role\",\n        dataIndex: \"role_id\",\n        key: \"id\",\n      },\n      {\n        title: \"Phone Number\",\n        dataIndex: \"phone_no\",\n        key: \"id\",\n      },\n    ];\n\n    const rowSelection = {\n      // selectedRows,\n      onChange: (keys, rows) => {\n        selectedRowKeys.value = keys;\n        selectedRows.value = rows;\n        // selectedRows.value = selectedRows;\n      },\n\n      getCheckboxProps: (record) => ({\n        disabled: record.name === \"Disabled User\", // Column configuration not to be checked\n        name: record.name,\n      }),\n    };\n\n    const warning = () => {\n      Modal.warning({\n        title: \"Please Select your Required Rows!\",\n      });\n    };\n\n    const fileType =\n      \"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;charset=UTF-8\";\n    const xlsxExtension = \".xlsx\";\n\n    const exportToXLSX = (inputData, fileName) => {\n      const ws = XLSX.utils.json_to_sheet(inputData);\n      const wb = { Sheets: { data: ws }, SheetNames: [\"data\"] };\n      const excelBuffer = XLSX.write(wb, { bookType: \"xlsx\", type: \"array\" });\n      const data = new Blob([excelBuffer], { type: fileType });\n      FileSaver.saveAs(data, fileName + xlsxExtension);\n      isModalVisible.value = false;\n    };\n\n    const updateFileName = (e) => {\n      fileName.value = e.target.value;\n    };\n    const updateFileType = (value) => {\n      convertedTo.value = value;\n    };\n\n    watchEffect(() => {\n      selectedRows.value.map((member) => {\n        console.log(member);\n        const {\n          first_name,\n          middle_name,\n          last_name,\n          level_id,\n          org_types_id,\n          role_id,\n          phone_no,\n        } = member;\n        csvJsonData.push({\n          first_name: first_name,\n          middle_name: middle_name,\n          last_name: last_name,\n          level_id,\n          org_types_id,\n          role_id,\n          phone_no,\n        });\n        return csvData.push([\n          first_name,\n          middle_name,\n          last_name,\n          level_id,\n          org_types_id,\n          role_id,\n          phone_no,\n        ]);\n      });\n    });\n\n    return {\n      usersTableColumns,\n      exportToXLSX,\n      updateFileName,\n      updateFileType,\n      fileType,\n      xlsxExtension,\n      rowSelection,\n      warning,\n      usersTableData,\n      handleSearch,\n      searchData,\n      handleCancel,\n      showModal,\n      fileName,\n      convertedTo,\n      selectedRowKeys,\n      selectedRows,\n      isModalVisible,\n      csvData,\n      csvJsonData,\n    };\n  },\n};\n\nexport default Import;\n</script>\n"],"mappings":";;;AAiIA,OAAO,KAAKA,SAAQ,MAAO,YAAY;AACvC,OAAO,KAAKC,IAAG,MAAO,MAAM;AAC5B,SAASC,IAAI,EAAEC,eAAc,QAAS,cAAc;AACpD,SAASC,QAAO,QAAS,MAAM;AAC/B,SAASC,QAAQ,EAAEC,GAAG,EAAEC,WAAW,EAAEC,SAAQ,QAAS,KAAK;AAE3D,OAAOC,UAAS,MAAO,+BAA+B;AACtD;;AAEA,MAAMC,MAAK,GAAI;EACbC,IAAI,EAAE,QAAQ;EACdC,UAAU,EAAE;IAA