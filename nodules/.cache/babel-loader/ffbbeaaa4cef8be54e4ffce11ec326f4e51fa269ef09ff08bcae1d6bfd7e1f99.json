{"ast":null,"code":"import \"ant-design-vue/es/modal/style\";\nimport _Modal from \"ant-design-vue/es/modal\";\nimport \"core-js/modules/es.array.push.js\";\nimport * as FileSaver from \"file-saver\";\nimport * as XLSX from \"xlsx\";\nimport { Main, ExportStyleWrap } from \"../../styled\";\nimport { useStore } from \"vuex\";\nimport { computed, ref, watchEffect, onMounted } from \"vue\";\nimport authHeader from \"../../../services/auth-header\";\n// import UserService from \"../../../services/user.service\";\n\nconst Import = {\n  name: \"Import\",\n  components: {\n    Main,\n    ExportStyleWrap\n  },\n  setup() {\n    const {\n      dispatch\n    } = useStore();\n    // const users = computed(() => state.contact.data);\n    const isModalVisible = ref(false);\n    const fileName = ref(\"DigiMal Ke Users\");\n    const convertedTo = ref(\"csv\");\n    const selectedRowKeys = ref(0);\n    const selectedRows = ref([]);\n    const searchData = ref(\"\");\n    const dataSource = ref([]);\n    const showModal = () => {\n      isModalVisible.value = true;\n    };\n    const handleCancel = () => {\n      isModalVisible.value = false;\n    };\n    const handleSearch = () => {\n      dispatch(\"contactSearchData\", searchData.value);\n    };\n    const csvData = [[\"first_name\", \"middle_name\", \"last_name\", \"level_id\", \"org_types_id\", \"role_id\", \"phone_no\"]];\n    const csvJsonData = [{\n      first_name: \"first_name\",\n      middle_name: \"middle_name\",\n      last_name: \"last_name\",\n      level_id: \"level_id\",\n      org_types_id: \"org_types_id\",\n      role_id: \"role_id\",\n      phone_no: \"phone_no\"\n    }];\n    onMounted(async () => {\n      try {\n        const response = await fetch(`${process.env.VUE_APP_BASE_URL}/users`, {\n          method: \"GET\",\n          headers: authHeader()\n        });\n        const data = await response.json();\n        dataSource.value = data.data;\n        console.log(data.data);\n      } catch (error) {\n        console.error(error);\n      }\n    });\n    // console.log(data);\n    const usersTableData = computed(() => dataSource.value.sort((a, b) => {\n      return b.time - a.time;\n    }).map(user => {\n      // console.log(user);\n      const {\n        first_name,\n        middle_name,\n        last_name,\n        level_id,\n        org_types_id,\n        role_id,\n        phone_no\n      } = user;\n      return {\n        first_name: first_name,\n        middle_name: middle_name,\n        last_name: last_name,\n        org_types_id: org_types_id,\n        level_id: level_id,\n        role_id: role_id,\n        phone_no: phone_no\n      };\n    }));\n    const usersTableColumns = [{\n      title: \"First Name\",\n      dataIndex: \"first_name\",\n      key: \"id\"\n    }, {\n      title: \"Middle Name\",\n      dataIndex: \"middle_name\",\n      key: \"id\"\n    }, {\n      title: \"Last Name\",\n      dataIndex: \"last_name\",\n      key: \"id\"\n    }, {\n      title: \"Level\",\n      dataIndex: \"level_id\",\n      key: \"id\"\n    }, {\n      title: \"Organization\",\n      dataIndex: \"org_types_id\",\n      key: \"id\"\n    }, {\n      title: \"Role\",\n      dataIndex: \"role_id\",\n      key: \"id\"\n    }, {\n      title: \"Phone Number\",\n      dataIndex: \"phone_no\",\n      key: \"id\"\n    }];\n    const rowSelection = {\n      // selectedRows,\n      onChange: (keys, rows) => {\n        selectedRowKeys.value = keys;\n        selectedRows.value = rows;\n        // selectedRows.value = selectedRows;\n      },\n\n      getCheckboxProps: record => ({\n        disabled: record.name === \"Disabled User\",\n        // Column configuration not to be checked\n        name: record.name\n      })\n    };\n    const warning = () => {\n      _Modal.warning({\n        title: \"Please Select your Required Rows!\"\n      });\n    };\n    const fileType = \"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;charset=UTF-8\";\n    const xlsxExtension = \".xlsx\";\n    const exportToXLSX = (inputData, fileName) => {\n      const ws = XLSX.utils.json_to_sheet(inputData);\n      const wb = {\n        Sheets: {\n          data: ws\n        },\n        SheetNames: [\"data\"]\n      };\n      const excelBuffer = XLSX.write(wb, {\n        bookType: \"xlsx\",\n        type: \"array\"\n      });\n      const data = new Blob([excelBuffer], {\n        type: fileType\n      });\n      FileSaver.saveAs(data, fileName + xlsxExtension);\n      isModalVisible.value = false;\n    };\n    const updateFileName = e => {\n      fileName.value = e.target.value;\n    };\n    const updateFileType = value => {\n      convertedTo.value = value;\n    };\n    watchEffect(() => {\n      selectedRows.value.map(member => {\n        console.log(member);\n        const {\n          first_name,\n          middle_name,\n          last_name,\n          level_id,\n          org_types_id,\n          role_id,\n          phone_no\n        } = member;\n        csvJsonData.push({\n          first_name: first_name,\n          middle_name: middle_name,\n          last_name: last_name,\n          level_id,\n          org_types_id,\n          role_id,\n          phone_no\n        });\n        return csvData.push([first_name, middle_name, last_name, level_id, org_types_id, role_id, phone_no]);\n      });\n    });\n    return {\n      usersTableColumns,\n      exportToXLSX,\n      updateFileName,\n      updateFileType,\n      fileType,\n      xlsxExtension,\n      rowSelection,\n      warning,\n      usersTableData,\n      handleSearch,\n      searchData,\n      handleCancel,\n      showModal,\n      fileName,\n      convertedTo,\n      selectedRowKeys,\n      selectedRows,\n      isModalVisible,\n      csvData,\n      csvJsonData\n    };\n  }\n};\nexport default Import;","map":{"version":3,"names":["FileSaver","XLSX","Main","ExportStyleWrap","useStore","computed","ref","watchEffect","onMounted","authHeader","Import","name","components","setup","dispatch","isMo