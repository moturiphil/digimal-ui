{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport { computed, ref, reactive } from \"vue\";\nimport { AuthWrapper } from \"./style\";\nimport store from \"../../vuex/store\";\nimport axios from \"axios\";\nimport { useRouter } from \"vue-router\";\nexport default {\n  name: \"Register\",\n  components: {\n    AuthWrapper\n  },\n  setup() {\n    const isLoading = computed(() => store.state.auth.loading);\n    const checked = ref(null);\n    const API_URL = `${process.env.VUE_APP_BASE_URL}/generate_otp`;\n    const router = useRouter();\n    const formState = reactive({\n      id_no: \"\",\n      otp: \"\"\n    });\n    const showOtpInput = ref(false);\n    const handleSubmit = async () => {\n      if (!showOtpInput.value) {\n        // Send request to backend to generate OTP\n        const values = {\n          id_no: formState.id_no\n        };\n        console.log(sessionStorage.getItem(\"id_no\"));\n        const response = await axios.post(API_URL, values);\n        console.log(response);\n        if (response.status === 200 || response.status === 226 || response.status === 201) {\n          // Remove id_no and otp then store generated OTP and id_no in session storage\n          sessionStorage.removeItem(\"id_no\", values.id_no);\n          sessionStorage.removeItem(\"otp\", response.data.OTP);\n          sessionStorage.setItem(\"otp\", response.data.OTP);\n          sessionStorage.setItem(\"id_no\", values.id_no);\n          console.log(response.data);\n        } else {\n          throw new Error(\"Network response was not ok.\");\n        }\n        showOtpInput.value = true;\n      } else {\n        // Verify user input against sessionly stored OTP\n        const generatedOTP = sessionStorage.getItem(\"otp\");\n        const userOTP = formState.otp;\n        if (generatedOTP === userOTP) {\n          router.push(\"/auth/set-password\");\n        } else {\n          console.log(\"OTP does not match\");\n        }\n      }\n    };\n    return {\n      isLoading,\n      checked,\n      handleSubmit,\n      formState,\n      isError: computed(() => store.state.auth.isError),\n      errorMessage: computed(() => store.state.auth.errorMessage),\n      errorDescription: computed(() => store.state.auth.errorDescription),\n      showOtpInput\n    };\n  }\n};","map":{"version":3,"names":["computed","ref","reactive","AuthWrapper","store","axios","useRouter","name","components","setup","isLoading","state","auth","loading","checked","API_URL","process","env","VUE_APP_BASE_URL","router","formState","id_no","otp","showOtpInput","handleSubmit","value","values","console","log","sessionStorage","getItem","response","post","status","removeItem","data","OTP","setItem","Error","generatedOTP","userOTP","push","isError","errorMessage","errorDescription"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/authentication/UserRegistration.vue"],"sourcesContent":["<template>\r\n  <AuthWrapper>\r\n    <div class=\"auth-contents\">\r\n      <a-form @finish=\"handleSubmit\" :model=\"formState\" layout=\"vertical\">\r\n        <sdHeading as=\"h3\">Registered as New User?</sdHeading>\r\n        <p class=\"forgot-text\">\r\n          Enter your ID No you used to register via USSD and we’ll send you\r\n          instructions to set your password and email.\r\n        </p>\r\n        <a-form-item label=\"ID No\" name=\"id_no\">\r\n          <a-input\r\n            type=\"number\"\r\n            v-model:value=\"formState.id_no\"\r\n            placeholder=\"34567890\"\r\n          />\r\n        </a-form-item>\r\n        <a-form-item v-if=\"showOtpInput\" label=\"OTP\" name=\"otp\">\r\n          <a-input\r\n            type=\"text\"\r\n            v-model:value=\"formState.otp\"\r\n            placeholder=\"Enter OTP\"\r\n          />\r\n        </a-form-item>\r\n        <a-form-item>\r\n          <sdButton\r\n            class=\"btn-reset\"\r\n            htmlType=\"submit\"\r\n            type=\"success\"\r\n            size=\"large\"\r\n          >\r\n            {{ showOtpInput ? \"Verify OTP\" : \"Send OTP\" }}\r\n          </sdButton>\r\n        </a-form-item>\r\n        <p class=\"return-text\">\r\n          Return to <router-link to=\"/auth/login\">Sign In</router-link>\r\n        </p>\r\n      </a-form>\r\n    </div>\r\n  </AuthWrapper>\r\n</template>\r\n<script>\r\nimport { computed, ref, reactive } from \"vue\";\r\nimport { AuthWrapper } from \"./style\";\r\nimport store from \"../../vuex/store\";\r\nimport axios from \"axios\";\r\nimport { useRouter } from \"vue-router\";\r\n\r\nexport default {\r\n  name: \"Register\",\r\n  components: { AuthWrapper },\r\n  setup() {\r\n    const isLoading = computed(() => store.state.auth.loading);\r\n    const checked = ref(null);\r\n    const API_URL = `${process.env.VUE_APP_BASE_URL}/generate_otp`;\r\n    const router = useRouter();\r\n    const formState = reactive({\r\n      id_no: \"\",\r\n      otp: \"\",\r\n    });\r\n    const showOtpInput = ref(false);\r\n\r\n    const handleSubmit = async () => {\r\n      if (!showOtpInput.value) {\r\n        // Send request to backend to generate OTP\r\n        const values = {\r\n          id_no: formState.id_no,\r\n        };\r\n\r\n        console.log(sessionStorage.getItem(\"id_no\"));\r\n\r\n        const response = await axios.post(API_URL, values);\r\n\r\n        console.log(response);\r\n\r\n        if (response.status === 200 || response.status === 226 || response.status === 201) {\r\n          // Remove id_no and otp then store generated OTP and id_no in session storage\r\n          sessionStorage.removeItem(\"id_no\", values.id_no);\r\n          sessionStorage.removeItem(\"otp\", response.data.OTP);\r\n\r\n          sessionStorage.setItem(\"otp\", response.data.OTP);\r\n          sessionStorage.setItem(\"id_no\", values.id_no);\r\n          console.log(response.data);\r\n        } else {\r\n          throw new Error(\"Network response was not ok.\");\r\n        }\r\n        showOtpInput.value = true;\r\n      } else {\r\n        // Verify user input against sessionly stored OTP\r\n        const generatedOTP = sessionStorage.getItem(\"otp\");\r\n        const userOTP = formState.otp;\r\n        if (generatedOTP === userOTP) {\r\n          router.push(\"/auth/set-password\");\r\n        } else {\r\n          console.log(\"OTP does not match\");\r\n        }\r\n      }\r\n    };\r\n\r\n    return {\r\n      isLoading,\r\n      checked,\r\n      handleSubmit,\r\n      formState,\r\n      isError: computed(() => store.state.auth.isError),\r\n      errorMessage: computed(() => store.state.auth.errorMessage),\r\n      errorDescription: computed(() => store.state.auth.errorDescription),\r\n      showOtpInput,\r\n    };\r\n  },\r\n};\r\n</script>"],"mappings":";AAyCA,SAASA,QAAQ,EAAEC,GAAG,EAAEC,QAAO,QAAS,KAAK;AAC7C,SAASC,WAAU,QAAS,SAAS;AACrC,OAAOC,KAAI,MAAO,kBAAkB;AACpC,OAAOC,KAAI,MAAO,OAAO;AACzB,SAASC,SAAQ,QAAS,YAAY;AAEtC,eAAe;EACbC,IAAI,EAAE,UAAU;EAChBC,UAAU,EAAE;IAAEL;EAAY,CAAC;EAC3BM,KAAKA,CAAA,EAAG;IACN,MAAMC,SAAQ,GAAIV,QAAQ,CAAC,MAAMI,KAAK,CAACO,KAAK,CAACC,IAAI,CAACC,OAAO,CAAC;IAC1D,MAAMC,OAAM,GAAIb,GAAG,CAAC,IAAI,CAAC;IACzB,MAAMc,OAAM,GAAK,GAAEC,OAAO,CAACC,GAAG,CAACC,gBAAiB,eAAc;IAC9D,MAAMC,MAAK,GAAIb,SAAS,EAAE;IAC1B,MAAMc,SAAQ,GAAIlB,QAAQ,CAAC;MACzBmB,KAAK,EAAE,EAAE;MACTC,GAAG,EAAE;IACP,CAAC,CAAC;IACF,MAAMC,YAAW,GAAItB,GAAG,CAAC,KAAK,CAAC;IAE/B,MAAMuB,YAAW,GAAI,MAAAA,CAAA,KAAY;MAC/B,IAAI,CAACD,YAAY,CAACE,KAAK,EAAE;QACvB;QACA,MAAMC,MAAK,GAAI;UACbL,KAAK,EAAED,SAAS,CAACC;QACnB,CAAC;QAEDM,OAAO,CAACC,GAAG,CAACC,cAAc,CAACC,OAAO,CAAC,OAAO,CAAC,CAAC;QAE5C,MAAMC,QAAO,GAAI,MAAM1B,KAAK,CAAC2B,IAAI,CAACjB,OAAO,EAAEW,MAAM,CAAC;QAElDC,OAAO,CAACC,GAAG,CAACG,QAAQ,CAAC;QAErB,IAAIA,QAAQ,CAACE,MAAK,KAAM,GAAE,IAAKF,QAAQ,CAACE,MAAK,KAAM,GAAE,IAAKF,QAAQ,CAACE,MAAK,KAAM,GAAG,EAAE;UACjF;UACAJ,cAAc,CAACK,UAAU,CAAC,OAAO,EAAER,MAAM,CAACL,KAAK,CAAC;UAChDQ,cAAc,CAACK,UAAU,CAAC,KAAK,EAAEH,QAAQ,CAACI,IAAI,CAACC,GAAG,CAAC;UAEnDP,cAAc,CAACQ,OAAO,CAAC,KAAK,EAAEN,QAAQ,CAACI,IAAI