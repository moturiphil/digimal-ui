               :value=\"formState.dribble\"\r\n                  class=\"dribbble\"\r\n                  placeholder=\"URL\"\r\n                >\r\n                  <template #prefix>\r\n                    <font-awesome-icon\r\n                      class=\"super-crazy-colors\"\r\n                      :icon=\"faDribbble\"\r\n                      size=\"1x\"\r\n                      :style=\"{ textShadow: '0 1px 0 rgba(0, 0, 0, 0.1)' }\"\r\n                    />\r\n                  </template>\r\n                </a-input>\r\n              </a-form-item>\r\n              <a-form-item label=\"Instagram\">\r\n                <a-input\r\n                  :value=\"formState.instagram\"\r\n                  class=\"instagram\"\r\n                  placeholder=\"URL\"\r\n                >\r\n                  <template #prefix>\r\n                    <font-awesome-icon\r\n                      class=\"super-crazy-colors\"\r\n                      :icon=\"faInstagram\"\r\n                      size=\"1x\"\r\n                      :style=\"{ textShadow: '0 1px 0 rgba(0, 0, 0, 0.1)' }\"\r\n                    />\r\n                  </template>\r\n                </a-input>\r\n              </a-form-item>\r\n\r\n              <a-form-item label=\"Github\">\r\n                <a-input\r\n                  :value=\"formState.github\"\r\n                  class=\"github\"\r\n                  placeholder=\"URL\"\r\n                >\r\n                  <template #prefix>\r\n                    <font-awesome-icon\r\n                      class=\"super-crazy-colors\"\r\n                      :icon=\"faGithub\"\r\n                      size=\"1x\"\r\n                      :style=\"{ textShadow: '0 1px 0 rgba(0, 0, 0, 0.1)' }\"\r\n                    />\r\n                  </template>\r\n                </a-input>\r\n              </a-form-item>\r\n\r\n              <a-form-item label=\"Medium\">\r\n                <a-input\r\n                  :value=\"formState.medium\"\