{"ast":null,"code":"import { SocialProfileForm } from \"./style\";\nimport { BasicFormWrapper } from \"../../../styled\";\nimport { faFacebookF, faDribbble, faTwitter, faInstagram, faGithub, faMediumM } from \"@fortawesome/free-brands-svg-icons\";\nimport { reactive, defineComponent } from \"vue\";\nconst SocialProfile = defineComponent({\n  name: \"SocialProfile\",\n  data() {\n    const name = \"clayton\";\n    const formState = reactive({\n      facebook: \"\",\n      twitter: \"\",\n      instagram: \"\",\n      dribble: \"\",\n      medium: \"\",\n      github: \"\"\n    });\n    const handleFinish = values => {\n      this.values = {\n        ...values\n      };\n      console.log(values, formState);\n    };\n    const handleFinishFailed = errors => {\n      console.log(errors);\n    };\n    return {\n      name,\n      values: null,\n      formState,\n      handleFinish,\n      handleFinishFailed,\n      faFacebookF,\n      faDribbble,\n      faTwitter,\n      faInstagram,\n      faGithub,\n      faMediumM\n    };\n  },\n  components: {\n    SocialProfileForm,\n    BasicFormWrapper\n  },\n  methods: {\n    handleSubmit(e) {\n      e.preventDefault();\n      this.form.validateFields((err, values) => {\n        if (!err) {\n          this.values = {\n            ...values,\n            tags: this.tags\n          };\n          console.log(values);\n        }\n      });\n    },\n    handleCancel(e) {\n      e.preventDefault();\n      //form.resetFields();\n    }\n  }\n});\n\nexport default SocialProfile;","map":{"version":3,"names":["SocialProfileForm","BasicFormWrapper","faFacebookF","faDribbble","faTwitter","faInstagram","faGithub","faMediumM","reactive","defineComponent","SocialProfile","name","data","formState","facebook","twitter","instagram","dribble","medium","github","handleFinish","values","console","log","handleFinishFailed","errors","components","methods","handleSubmit","e","preventDefault","form","validateFields","err","tags","handleCancel"],"sources"