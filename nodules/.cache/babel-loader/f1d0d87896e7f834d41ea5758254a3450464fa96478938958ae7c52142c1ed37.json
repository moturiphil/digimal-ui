\r\n    };\r\n\r\n    const handleFinishFailed = (errors) => {\r\n      console.log(errors);\r\n    };\r\n    return {\r\n      name,\r\n      values: null,\r\n      formState,\r\n      handleFinish,\r\n      handleFinishFailed,\r\n      faFacebookF,\r\n      faDribbble,\r\n      faTwitter,\r\n      faInstagram,\r\n      faGithub,\r\n      faMediumM,\r\n    };\r\n  },\r\n  components: { SocialProfileForm, BasicFormWrapper },\r\n  methods: {\r\n    handleSubmit(e) {\r\n      e.preventDefault();\r\n      this.form.validateFields((err, values) => {\r\n        if (!err) {\r\n          this.values = { ...values, tags: this.tags };\r\n          console.log(values);\r\n        }\r\n      });\r\n    },\r\n\r\n    handleCancel(e) {\r\n      e.preventDefault();\r\n      //form.resetFields();\r\n    },\r\n  },\r\n});\r\n\r\nexport default SocialProfile;\r\n</script>\r\n"],"mappings":"AAuIA,SAASA,iBAAgB,QAAS,SAAS;AAC3C,SAASC,gBAAe,QAAS,iBAAiB;AAClD,SACEC,WAAW,EACXC,UAAU,EACVC,SAAS,EACTC,WAAW,EACXC,QAAQ,EACRC,SAAS,QACJ,oCAAoC;AAC3C,SAASC,QAAQ,EAAEC,eAAc,QAAS,KAAK;AAE/C,MAAMC,aAAY,GAAID,eAAe,CAAC;EACpCE,IAAI,EAAE,eAAe;EACrBC,IAAIA,CAAA,EAAG;IACL,MAAMD,IAAG,GAAI,SAAS;IACtB,MAAME,SAAQ,GAAIL,QAAQ,CAAC;MACzBM,QAAQ,EAAE,EAAE;MACZC,OAAO,EAAE,EAAE;MACXC,SAAS,EAAE,EAAE;MACbC,OAAO,EAAE,EAAE;MACXC,MAAM,EAAE,EAAE;MACVC,MAAM,EAAE;IACV,CAAC,CAAC;IAEF,MAAMC,YAAW,GAAKC,MAAM,IAAK;MAC/B,IAAI,CAACA,MAAK,GAAI;QAAE,GAAGA;MAAO,CAAC;MAC3BC,OAAO,CAACC,GAAG,CAACF,MAAM,EAAER,SAAS,CAAC;IAChC,CAAC;IAED,MAAMW,kBAAiB,GAAKC,MAAM,IAAK;MACrCH,OAAO,CAACC,GAAG,CAACE,MAAM,CAAC;IACrB,CAAC;IACD,OAAO;MACLd,IAAI;MACJU,MAAM,EAAE,IAAI;MACZR,SAAS;MACTO,YAAY;MACZI,kBAAkB;MAClBtB,WAAW;MACXC,UAAU;MACVC,SAAS;MACTC,WAAW;MACXC,QAAQ;MACRC;IACF,CAAC;EACH,CAAC;EACDmB,UAAU,EAAE;IAAE1B,iBAAiB;IAAEC;EAAiB,CAAC;EACnD0B,OAAO,EAAE;IACPC,YAAYA,CAACC,CAAC,EAAE;MACdA,CAAC,CAACC,cAAc,EAAE;MAClB,IAAI,CAACC,IAAI,CAACC,cAAc,CAAC,CAACC,GAAG,EAAEZ,MAAM,KAAK;QACxC,IAAI,CAACY,GAAG,EAAE;UACR,IAAI,CAACZ,MAAK,GAAI;YAAE,GAAGA,MAAM;YAAEa,IAAI,EAAE,IAA