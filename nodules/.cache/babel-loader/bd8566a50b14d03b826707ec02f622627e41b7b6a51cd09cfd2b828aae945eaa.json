{"ast":null,"code":"import { IncomeExpenseWrapper, ExList } from \"../../style\";\nimport Chart from \"../../../../components/utilities/chartjs\";\nimport { customTooltips } from \"../../../../components/utilities/utilities\";\nimport { computed, onMounted, ref, defineComponent } from \"vue\";\nimport { useStore } from \"vuex\";\nimport authHeader from \"../../../../services/auth-header\";\nconst IncomeAndExpenses = defineComponent({\n  name: \"HouseHolds Registration\",\n  components: {\n    IncomeExpenseWrapper,\n    Chart,\n    ExList\n  },\n  setup() {\n    const {\n      state,\n      dispatch\n    } = useStore();\n    const incomeFlowActive = ref(\"year\");\n    // onMounted(() => dispatch('incomeGetData'));\n\n    const active_events = ref(0);\n    const nets_distributed = ref(0);\n    const registered_house_holds = ref(0);\n    const registered_users = ref(0);\n    const household_population = ref(0);\n    const total_nets_required = ref(0);\n    const activities = ref(0);\n    onMounted(async () => {\n      dispatch(\"incomeGetData\");\n      try {\n        const response = await fetch(`${process.env.VUE_APP_BASE_URL}/dash_stats`, {\n          method: \"GET\",\n          headers: authHeader()\n        });\n        console.log(\"Endpoint working...............\");\n        const data = await response.json();\n        console.log(data);\n        active_events.value = data.active_events;\n        nets_distributed.value = data.nets_distributed;\n        registered_house_holds.value = data.registered_house_holds;\n        registered_users.value = data.registered_users;\n        household_population.value = data.all_hh_members;\n        total_nets_required.value = data.sys_allocation;\n        activities.value = data.active_activities;\n      } catch (error) {\n        console.error(error);\n      }\n    });\n    const handleActiveChangeIncome = value => {\n      incomeFlowActive.value = value;\n      return dispatch(\"incomeFilterData\", value);\n    };\n    const incomeState = computed(() => state.chartContent.incomeData);\n    const isIcLoading = computed(() => state.chartContent.icLoading);\n    const incomeDataset = computed(() => [{\n      data: state.chartContent.incomeData.hh[1],\n      backgroundColor: \"#5F63F250\",\n      hoverBackgroundColor: \"#5F63F2\",\n      label: \"Total Registered HouseHolds\",\n      barPercentage: 0.6\n    }, {\n      data: state.chartContent.incomeData.population[1],\n      backgroundColor: \"#FF69A550\",\n      hoverBackgroundColor: \"#FF69A5\",\n      label: \"Total Population\",\n      barPercentage: 0.6\n    }, {\n      data: state.chartContent.incomeData.nets_req[1],\n      backgroundColor: \"#FA8B0C40\",\n      hoverBackgroundColor: \"#FA8B0C\",\n      label: \"Total Nets Required\",\n      barPercentage: 0.6\n    }, {\n      data: state.chartContent.incomeData.nets_dist[1],\n      backgroundColor: \"#20C99740\",\n      hoverBackgroundColor: \"#20C997\",\n      label: \"Total Nets Distributed\",\n      barPercentage: 0.6\n    }]);\n    return {\n      incomeState,\n      isIcLoading,\n      incomeFlowActive,\n      incomeDataset,\n      handleActiveChangeIncome,\n      toolTips: {\n        tooltips: {\n          mode: \"label\",\n          intersect: false,\n          position: \"average\",\n          enabled: false,\n          custom: customTooltips,\n          callbacks: {\n            label(t, d) {\n              const dstLabel = d.datasets[t.datasetIndex].label;\n              const {\n                yLabel\n              } = t;\n              return `<span class=\"chart-data\">${yLabel}</span> <span class=\"data-label\">${dstLabel}</span>`;\n            },\n            labelColor(tooltipItem, chart) {\n              const dataset = chart.config.data.datasets[tooltipItem.datasetIndex];\n              return {\n                backgroundColor: dataset.hoverBackgroundColor,\n                borderColor: \"transparent\",\n                usePointStyle: true\n              };\n            }\n          }\n        }\n      }\n    };\n  }\n});\nexport default IncomeAndExpenses;","map":{"version":3,"names":["IncomeExpenseWrapper","ExList","Chart","customTooltips","computed","onMounted","ref","defineComponent","useStore","authHeader","IncomeAndExpenses","name","components","setup","state","dispatch","incomeFlowActive","active_events","nets_distributed","registered_house_holds","registered_users","household_population","total_nets_required","activities","response","fetch","process","env","VUE_APP_BASE_URL","method","headers","console","log","data","json","value","all_hh_members","sys_allocation","active_activities","error","handleActiveChangeIncome","incomeState","chartContent","incomeData","isIcLoading","icLoading","incomeDataset","hh","backgroundColor","hoverBackgroundColor","label","barPercentage","population","nets_req","nets_dist","toolTips","tooltips","mode","intersect","position","enabled","custom","callbacks","t","d","dstLabel","datasets","datasetIndex","yLabel","labelColor","tooltipItem","chart","dataset","config","borderColor","usePointStyle"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/dashboard/overview/business/IncomeAndExpenses.vue"],"sourcesContent":["<template>\r\n  <IncomeExpenseWrapper>\r\n    <sdCards v-if=\"incomeState !== null\" more>\r\n      <template #title\r\n        ><div>HouseHolds MassNet <span>Bungoma Pilot</span></div></template\r\n      >\r\n      <div v-if=\"isIcLoading\" class=\"sd-spin\">\r\n        <a-spin />\r\n      </div>\r\n\r\n      <a-row v-else :gutter=\"25\">\r\n        <a-col :xxl=\"6\" :sm=\"24\">\r\n          <ExList>\r\n            <div>\r\n              <p>Bukengele Coverage Per Capita</p>\r\n              <sdHeading as=\"h1\">\r\n                <span>59.8 %</span>\r\n              </sdHeading>\r\n            </div>\r\n            <div>\r\n              <p>Mufungu Coverage Per Capita</p>\r\n              <sdHeading as=\"h1\">\r\n                <span>40.2 %</span>\r\n              </sdHeading>\r\n            </div>\r\n          </ExList>\r\n        </a-col>\r\n        <a-col :xxl=\"24\" :xs=\"24\">\r\n          <sdChartContainer class=\"parentContainer\">\r\n            <Chart\r\n              type=\"bar\"\r\n              class=\"incomeExpanse\"\r\n              :labels=\"incomeState.labels\"\r\n              :datasets=\"incomeDataset\"\r\n              :height=\"88\"\r\n              :style=\"{\r\n                marginBottom: '0',\r\n              }\"\r\n              :options=\"{\r\n                maintainAspectRatio: true,\r\n                responsive: true,\r\n                legend: {\r\n                  display: false,\r\n                  position: 'bottom',\r\n                  labels: {\r\n                    boxWidth: 6,\r\n                    display: true,\r\n                    usePointStyle: true,\r\n                  },\r\n                  align: 'start',\r\n                },\r\n                layout: {\r\n                  padding: {\r\n                    left: '0',\r\n                    right: 0,\r\n                    top: 0,\r\n                    bottom: '0',\r\n                  },\r\n                },\r\n                ...toolTips,\r\n                scales: {\r\n                  yAxes: [\r\n                    {\r\n                      gridLines: {\r\n                        color: '#e5e9f2',\r\n                        borderDash: [3, 3],\r\n                        zeroLineColor: '#e5e9f2',\r\n                        zeroLineWidth: 1,\r\n                        zeroLineBorderDash: [3, 3],\r\n                      },\r\n                      ticks: {\r\n                        beginAtZero: true,\r\n                        fontSize: 13,\r\n                        fontColor: '#182b49',\r\n                        max: Math.max(...incomeState.population[1]),\r\n                        stepSize: Math.max(...incomeState.population[1]) / 5,\r\n                        callback(label) {\r\n                          return `${label}`;\r\n                        },\r\n                      },\r\n                    },\r\n                  ],\r\n                  xAxes: [\r\n                    {\r\n                      gridLines: {\r\n                        display: true,\r\n                        zeroLineWidth: 2,\r\n                        zeroLineColor: '#fff',\r\n                        color: 'transparent',\r\n                        z: 1,\r\n                      },\r\n                      ticks: {\r\n                        beginAtZero: true,\r\n                        fontSize: 13,\r\n                        fontColor: '#182b49',\r\n                      },\r\n                    },\r\n                  ],\r\n                },\r\n              }\"\r\n            />\r\n          </sdChartContainer>\r\n          <ul v-if=\"incomeDataset\" class=\"chart-dataIndicator\">\r\n            <li\r\n              v-for=\"(item, index) in incomeDataset\"\r\n              :key=\"index + 1\"\r\n              :style=\"{ display: 'inline-flex', alignItems: 'center' }\"\r\n            >\r\n              <span\r\n                :style=\"{\r\n                  width: '10px',\r\n                  height: '10px',\r\n                  display: 'flex',\r\n                  backgroundColor: item.hoverBackgroundColor,\r\n                  borderRadius: '50%',\r\n                  margin: '0px 5px',\r\n                }\"\r\n              />\r\n              {{ item.label }}\r\n            </li>\r\n          </ul>\r\n        </a-col>\r\n      </a-row>\r\n    </sdCards>\r\n  </IncomeExpenseWrapper>\r\n</template>\r\n<script>\r\nimport { IncomeExpenseWrapper, ExList, } from \"../../style\";\r\nimport Chart from \"../../../../components/utilities/chartjs\";\r\nimport { customTooltips } from \"../../../../components/utilities/utilities\";\r\nimport { computed, onMounted, ref, defineComponent } from \"vue\";\r\nimport { useStore } from \"vuex\";\r\nimport authHeader from \"../../../../services/auth-header\";\r\n\r\n\r\nconst IncomeAndExpenses = defineComponent({\r\n  name: \"HouseHolds Registration\",\r\n  components: {  IncomeExpenseWrapper, Chart, ExList },\r\n  setup() {\r\n    const { state, dispatch } = useStore();\r\n    const incomeFlowActive = ref(\"year\");\r\n    // onMounted(() => dispatch('incomeGetData'));\r\n\r\n    const active_events = ref(0);\r\n    const nets_distributed = ref(0);\r\n    const registered_house_holds = ref(0);\r\n    const registered_users = ref(0);\r\n    const household_population = ref(0);\r\n    const total_nets_required = ref(0);\r\n    const activities = ref(0);\r\n\r\n\r\n    onMounted(async () => {\r\n      dispatch(\"incomeGetData\");\r\n      try {\r\n        const response = await fetch(\r\n          `${process.env.VUE_APP_BASE_URL}/dash_stats`,\r\n          {\r\n            method: \"GET\",\r\n            headers: authHeader(),\r\n          }\r\n        );\r\n        console.log(\"Endpoint working...............\");\r\n        const data = await response.json();\r\n        console.log(data);\r\n        active_events.value = data.active_events;\r\n        nets_distributed.value = data.nets_distributed;\r\n        registered_house_holds.value = data.registered_house_holds;\r\n        registered_users.value = data.registered_users;\r\n        household_population.value = data.all_hh_members;\r\n        total_nets_required.value = data.sys_allocation;\r\n        activities.value = data.active_activities;\r\n      } catch (error) {\r\n        console.error(error);\r\n      }\r\n    });\r\n    const handleActiveChangeIncome = (value) => {\r\n      incomeFlowActive.value = value;\r\n      return dispatch(\"incomeFilterData\", value);\r\n    };\r\n    const incomeState = computed(() => state.chartContent.incomeData);\r\n    const isIcLoading = computed(() => state.chartContent.icLoading);\r\n    const incomeDataset = computed(() => [\r\n      {\r\n        data: state.chartContent.incomeData.hh[1],\r\n        backgroundColor: \"#5F63F250\",\r\n        hoverBackgroundColor: \"#5F63F2\",\r\n        label: \"Total Registered HouseHolds\",\r\n        barPercentage: 0.6,\r\n      },\r\n      {\r\n        data: state.chartContent.incomeData.population[1],\r\n        backgroundColor: \"#FF69A550\",\r\n        hoverBackgroundColor: \"#FF69A5\",\r\n        label: \"Total Population\",\r\n        barPercentage: 0.6,\r\n      },\r\n      {\r\n        data: state.chartContent.incomeData.nets_req[1],\r\n        backgroundColor: \"#FA8B0C40\",\r\n        hoverBackgroundColor: \"#FA8B0C\",\r\n        label: \"Total Nets Required\",\r\n        barPercentage: 0.6,\r\n      },\r\n      {\r\n        data: state.chartContent.incomeData.nets_dist[1],\r\n        backgroundColor: \"#20C99740\",\r\n        hoverBackgroundColor: \"#20C997\",\r\n        label: \"Total Nets Distributed\",\r\n        barPercentage: 0.6,\r\n      },\r\n    ]);\r\n\r\n    return {\r\n      incomeState,\r\n      isIcLoading,\r\n      incomeFlowActive,\r\n      incomeDataset,\r\n      handleActiveChangeIncome,\r\n      toolTips: {\r\n        tooltips: {\r\n          mode: \"label\",\r\n          intersect: false,\r\n          position: \"average\",\r\n          enabled: false,\r\n          custom: customTooltips,\r\n          callbacks: {\r\n            label(t, d) {\r\n              const dstLabel = d.datasets[t.datasetIndex].label;\r\n              const { yLabel } = t;\r\n              return `<span class=\"chart-data\">${yLabel}</span> <span class=\"data-label\">${dstLabel}</span>`;\r\n            },\r\n            labelColor(tooltipItem, chart) {\r\n              const dataset =\r\n                chart.config.data.datasets[tooltipItem.datasetIndex];\r\n              return {\r\n                backgroundColor: dataset.hoverBackgroundColor,\r\n                borderColor: \"transparent\",\r\n                usePointStyle: true,\r\n              };\r\n            },\r\n          },\r\n        },\r\n      },\r\n    };\r\n  },\r\n});\r\n\r\nexport default IncomeAndExpenses;\r\n</script>\r\n"],"mappings":"AA+HA,SAASA,oBAAoB,EAAEC,MAAM,QAAS,aAAa;AAC3D,OAAOC,KAAI,MAAO,0CAA0C;AAC5D,SAASC,cAAa,QAAS,4CAA4C;AAC3E,SAASC,QAAQ,EAAEC,SAAS,EAAEC,GAAG,EAAEC,eAAc,QAAS,KAAK;AAC/D,SAASC,QAAO,QAAS,MAAM;AAC/B,OAAOC,UAAS,MAAO,kCAAkC;AAGzD,MAAMC,iBAAgB,GAAIH,eAAe,CAAC;EACxCI,IAAI,EAAE,yBAAyB;EAC/BC,UAAU,EAAE;IAAGZ,oBAAoB;IAAEE,KAAK;IAAED;EAAO,CAAC;EACpDY,KAAKA,CAAA,EAAG;IACN,MAAM;MAAEC,KAAK;MAAEC;IAAS,IAAIP,QAAQ,EAAE;IACtC,MAAMQ,gBAAe,GAAIV,GAAG,CAAC,MAAM,CAAC;IACpC;;IAEA,MAAMW,aAAY,GAAIX,GAAG,CAAC,CAAC,CAAC;IAC5B,MAAMY,gBAAe,GAAIZ,GAAG,CAAC,CAAC,CAAC;IAC/B,MAAMa,sBAAqB,GAAIb,GAAG,CAAC,CAAC,CAAC;IACrC,MAAMc,gBAAe,GAAId,GAAG,CAAC,CAAC,CAAC;IAC/B,MAAMe,oBAAmB,GAAIf,GAAG,CAAC,CAAC,CAAC;IACnC,MAAMgB,mBAAkB,GAAIhB,GAAG,CAAC,CAAC,CAAC;IAClC,MAAMiB,UAAS,GAAIjB,GAAG,CAAC,CAAC,CAAC;IAGzBD,SAAS,CAAC,YAAY;MACpBU,QAAQ,CAAC,eAAe,CAAC;MACzB,IAAI;QACF,MAAMS,QAAO,GAAI,MAAMC,KAAK,CACzB,GAAEC,OAAO,CAACC,GAAG,CAACC,gBAAiB,aAAY,EAC5C;UACEC,MAAM,EAAE,KAAK;UACbC,OAAO,EAAErB,UAAU;QACrB,EACD;QACDsB,OAAO,CAACC,GAAG,CAAC,iCAAiC,CAAC;QAC9C,MAAMC,IAAG,GAAI,MAAMT,QAAQ,CAACU,IAAI,EAAE;QAClCH,OAAO,CAACC,GAAG,CAACC,IAAI,CAAC;QACjBhB,aAAa,CAACkB,KAAI,GAAIF,IAAI,CAAChB,aAAa;QACxCC,gBAAgB,CAACiB,KAAI,GAAIF,IAAI,CAACf,gBAAgB;QAC9CC,sBAAsB,CAACgB,KAAI,GAAIF,IAAI,CAACd,sBAAsB;QAC1DC,gBAAgB,CAACe,KAAI,GAAIF,IAAI,CAACb,gBAAgB;QAC9CC,oBAAoB,CAACc,KAAI,GAAIF,IAAI,CAACG,cAAc;QAChDd,mBAAmB,CAACa,KAAI,GAAIF,IAAI,CAACI,cAAc;QAC/Cd,UAAU,CAACY,KAAI,GAAIF,IAAI,CAACK,iBAAiB;MAC3C,EAAE,OAAOC,KAAK,EAAE;QACdR,OAAO,CAACQ,KAAK,CAACA,KAAK,CAAC;MACtB;IACF,CAAC,CAAC;IACF,MAAMC,wBAAuB,GAAKL,KAAK,IAAK;MAC1CnB,gBAAgB,CAACmB,KAAI,GAAIA,KAAK;MAC9B,OAAOpB,QAAQ,CAAC,kBAAkB,EAAEoB,KAAK,CAAC;IAC5C,CAAC;IACD,MAAMM,WAAU,GAAIrC,QAAQ,CAAC,MAAMU,KAAK,CAAC4B,YAAY,CAACC,UAAU,CAAC;IACjE,MAAMC,WAAU,GAAIxC,QAAQ,CAAC,MAAMU,KAAK,CAAC4B,YAAY,CAACG,SAAS,CAAC;IAChE,MAAMC,aAAY,GAAI1C,QAAQ,CAAC,MAAM,CACnC;MACE6B,IAAI,EAAEnB,KAAK,CAAC4B,YAAY,CAACC,UAAU,CAACI,EAAE,CAAC,CAAC,CAAC;MACzCC,eAA