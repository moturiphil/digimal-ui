{"ast":null,"code":"import { ProjectHeader, ProjectSorting } from './style';\nimport { Main } from '../../styled';\nimport { useStore } from 'vuex';\nimport { computed, ref } from 'vue';\nimport { useRoute } from 'vue-router';\nconst Project = {\n  name: 'Project',\n  components: {\n    ProjectHeader,\n    ProjectSorting,\n    Main\n  },\n  setup() {\n    const {\n      state,\n      dispatch\n    } = useStore();\n    const searchData = computed(() => state.headerSearchData);\n    const {\n      path\n    } = useRoute().matched[1];\n    const visible = ref(false);\n    const categoryActive = ref('all');\n    const onSorting = selectedItems => {\n      dispatch('sortingProjectByCategory', selectedItems);\n    };\n    const onChangeCategory = value => {\n      categoryActive.value = value;\n      dispatch('filterProjectByStatus', value);\n    };\n    const showModal = () => {\n      visible.value = true;\n    };\n    const onCancel = () => {\n      visible.value = false;\n    };\n    return {\n      onCancel,\n      showModal,\n      onChangeCategory,\n      onSorting,\n      searchData,\n      categoryActive,\n      path,\n      visible\n    };\n  }\n};\nexport default Project;","map":{"version":3,"names":["ProjectHeader","ProjectSorting","Main","useStore","computed","ref","useRoute","Project","name","components","setup","state","dispatch","searchData","headerSearchData","path","matched","visible","categoryActive","onSorting","selectedItems","onChangeCategory","value","showModal","onCancel"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/apps/project/Project.vue"],"sourcesContent":["<template>\r\n  <sdPageHeader title=\"Projects\" subTitle=\"12 Running Projects\">\r\n    <template v-slot:buttons>\r\n      <sdButton @click=\"showModal\" key=\"1\" type=\"primary\">\r\n        <sdFeatherIcons type=\"plus\" size=\"16\" /> Create Projects\r\n      </sdButton>\r\n    </template>\r\n  </sdPageHeader>\r\n\r\n  <Main>\r\n    <a-row :gutter=\"25\">\r\n      <a-col :xs=\"24\">\r\n        <ProjectSorting>\r\n          <div class=\"project-sort-bar\">\r\n            <div class=\"project-sort-nav\">\r\n              <nav>\r\n                <ul>\r\n                  <li :class=\"categoryActive === 'all' ? 'active' : 'deactivate'\">\r\n                    <a @click=\"() => onChangeCategory('all')\" to=\"#\"> All </a>\r\n                  </li>\r\n                  <li :class=\"categoryActive === 'progress' ? 'active' : 'deactivate'\">\r\n                    <a @click=\"() => onChangeCategory('progress')\" to=\"#\"> In Progress </a>\r\n                  </li>\r\n                  <li :class=\"categoryActive === 'complete' ? 'active' : 'deactivate'\">\r\n                    <a @click=\"() => onChangeCategory('complete')\" to=\"#\"> Complete </a>\r\n                  </li>\r\n                  <li :class=\"categoryActive === 'late' ? 'active' : 'deactivate'\">\r\n                    <a @click=\"() => onChangeCategory('late')\" to=\"#\"> Late </a>\r\n                  </li>\r\n                  <li :class=\"categoryActive === 'early' ? 'active' : 'deactivate'\">\r\n                    <a @click=\"() => onChangeCategory('early')\" to=\"#\"> Early </a>\r\n                  </li>\r\n                </ul>\r\n              </nav>\r\n            </div>\r\n            <div class=\"project-sort-search\">\r\n              <sdAutoComplete :dataSource=\"searchData\" placeholder=\"Search projects\" patterns />\r\n            </div>\r\n            <div class=\"project-sort-group\">\r\n              <div class=\"sort-group\">\r\n                <span>Sort By:</span>\r\n                <a-select @change=\"onSorting\" defaultValue=\"category\">\r\n                  <a-select-option value=\"category\">Project Category</a-select-option>\r\n                  <a-select-option value=\"rate\">Top Rated</a-select-option>\r\n                  <a-select-option value=\"popular\">Popular</a-select-option>\r\n                  <a-select-option value=\"time\">Newest</a-select-option>\r\n                  <a-select-option value=\"price\">Price</a-select-option>\r\n                </a-select>\r\n                <div class=\"layout-style\">\r\n                  <router-link :to=\"`${path}/grid`\">\r\n                    <sdFeatherIcons type=\"grid\" size=\"16\" />\r\n                  </router-link>\r\n                  <router-link :to=\"`${path}/list`\">\r\n                    <sdFeatherIcons type=\"list\" size=\"16\" />\r\n                  </router-link>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </ProjectSorting>\r\n        <div>\r\n          <router-view name=\"child\"></router-view>\r\n        </div>\r\n      </a-col>\r\n    </a-row>\r\n    <sdCreateProject :onCancel=\"onCancel\" :visible=\"visible\" />\r\n  </Main>\r\n</template>\r\n<script>\r\nimport { ProjectHeader, ProjectSorting } from './style';\r\nimport { Main } from '../../styled';\r\nimport { useStore } from 'vuex';\r\nimport { computed, ref } from 'vue';\r\nimport { useRoute } from 'vue-router';\r\n\r\nconst Project = {\r\n  name: 'Project',\r\n  components: { ProjectHeader, ProjectSorting, Main },\r\n  setup() {\r\n    const { state, dispatch } = useStore();\r\n    const searchData = computed(() => state.headerSearchData);\r\n    const { path } = useRoute().matched[1];\r\n    const visible = ref(false);\r\n    const categoryActive = ref('all');\r\n\r\n    const onSorting = (selectedItems) => {\r\n      dispatch('sortingProjectByCategory', selectedItems);\r\n    };\r\n\r\n    const onChangeCategory = (value) => {\r\n      categoryActive.value = value;\r\n      dispatch('filterProjectByStatus', value);\r\n    };\r\n\r\n    const showModal = () => {\r\n      visible.value = true;\r\n    };\r\n\r\n    const onCancel = () => {\r\n      visible.value = false;\r\n    };\r\n    return {\r\n      onCancel,\r\n      showModal,\r\n      onChangeCategory,\r\n      onSorting,\r\n      searchData,\r\n      categoryActive,\r\n      path,\r\n      visible,\r\n    };\r\n  },\r\n};\r\n\r\nexport default Project;\r\n</script>\r\n"],"mappings":"AAqEA,SAASA,aAAa,EAAEC,cAAa,QAAS,SAAS;AACvD,SAASC,IAAG,QAAS,cAAc;AACnC,SAASC,QAAO,QAAS,MAAM;AAC/B,SAASC,QAAQ,EAAEC,GAAE,QAAS,KAAK;AACnC,SAASC,QAAO,QAAS,YAAY;AAErC,MAAMC,OAAM,GAAI;EACdC,IAAI,EAAE,SAAS;EACfC,UAAU,EAAE;IAAET,aAAa;IAAEC,cAAc;IAAEC;EAAK,CAAC;EACnDQ,KAAKA,CAAA,EAAG;IACN,MAAM;MAAEC,KAAK;MAAEC;IAAS,IAAIT,QAAQ,EAAE;IACtC,MAAMU,UAAS,GAAIT,QAAQ,CAAC,MAAMO,KAAK,CAACG,gBAAgB,CAAC;IACzD,MAAM;MAAEC;IAAK,IAAIT,QAAQ,EAAE,CAACU,OAAO,CAAC,CAAC,CAAC;IACtC,MAAMC,OAAM,GAAIZ,GAAG,CAAC,KAAK,CAAC;IAC1B,MAAMa,cAAa,GAAIb,GAAG,CAAC,KAAK,CAAC;IAEjC,MAAMc,SAAQ,GAAKC,aAAa,IAAK;MACnCR,QAAQ,CAAC,0BAA0B,EAAEQ,aAAa,CAAC;IACrD,CAAC;IAED,MAAMC,gBAAe,GAAKC,KAAK,IAAK;MAClCJ,cAAc,CAACI,KAAI,GAAIA,KAAK;MAC5BV,QAAQ,CAAC,uBAAuB,EAAEU,KAAK,CAAC;IAC1C,CAAC;IAED,MAAMC,SAAQ,GAAIA,CAAA,KAAM;MACtBN,OAAO,CAACK,KAAI,GAAI,IAAI;IACtB,CAAC;IAED,MAAME,QAAO,GAAIA,CAAA,KAAM;MACrBP,OAAO,CAACK,KAAI,GAAI,KAAK;IACvB,CAAC;IACD,OAAO;MACLE,QAAQ;MACRD,SAAS;MACTF,gBAAgB;MAChBF,SAAS;MACTN,UAAU;MACVK,cAAc;MACdH,IAAI;MACJE;IACF,CAAC;EACH;AACF,CAAC;AAED,eAAeV,OAAO"},"metadata":{},"sourceType":"module","externalDependencies":[]}