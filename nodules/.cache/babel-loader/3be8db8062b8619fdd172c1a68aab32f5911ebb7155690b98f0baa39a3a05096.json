{"ast":null,"code":"import \"ant-design-vue/es/notification/style\";\nimport _notification from \"ant-design-vue/es/notification\";\nimport \"core-js/modules/es.array.push.js\";\nimport { RecordFormWrapper } from \"../style\";\nimport { Main, BasicFormWrapper } from \"../../styled\";\nimport { useStore } from \"vuex\";\nimport { reactive, ref, defineComponent, computed, onMounted } from \"vue\";\nimport authHeader from \"../../../services/auth-header\";\nimport { useRouter } from \"vue-router\";\nconst dateFormat = \"YYYY-MM-DD\";\nconst AddNew = defineComponent({\n  name: \"AddNew\",\n  components: {\n    RecordFormWrapper,\n    Main,\n    BasicFormWrapper\n  },\n  data() {\n    const {\n      state\n    } = useStore();\n    const isLoading = computed(() => state.crud.loading);\n    const apiUrl = computed(() => state.crud.url);\n    const isFileLoading = computed(() => state.crud.fileLoading);\n    const join = ref(\"\");\n    const API_URL = `${process.env.VUE_APP_BASE_URL}/distribution_post`;\n    const router = useRouter();\n    const formState = reactive({\n      name: \"\",\n      distribution_start_date: \"\",\n      distribution_end_date: \"\",\n      post_supervisor_user_id: \"\",\n      villages: [],\n      post_code: \"\",\n      isFacility: 0\n    });\n    const {\n      villages,\n      loading,\n      isFacility,\n      users\n    } = reactive({\n      villages: [],\n      users: [],\n      loading: true,\n      isFacility: false\n    });\n\n    //counties\n    const getVillages = async () => {\n      const response = await fetch(`${process.env.VUE_APP_BASE_URL}/villages/list`, {\n        method: \"GET\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          ...authHeader()\n        }\n      });\n      console.log(response);\n      const data = await response.json();\n      this.villages = data.data;\n      this.loading = false;\n    };\n\n    //users\n    const getUsers = async () => {\n      const response = await fetch(`${process.env.VUE_APP_BASE_URL}/users`, {\n        method: \"GET\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          ...authHeader()\n        }\n      });\n      const data = await response.json();\n      this.users = data.data;\n    };\n    onMounted(() => {\n      getUsers();\n      getVillages();\n    });\n\n    // notification\n    // const openNotification = (type) => {\n    //   notification[type]({\n    //     message: \"Notification Title\",\n    //     description:\n    //       type == \"success\"\n    //         ? \"Post created successfully\"\n    //         : \"Post creation failed\",\n    //   });\n    // };\n\n    // distribution_start_date: new Date(values.distribution_start_date)\n    //       .toISOString()\n    //       .substr(0, 10),\n    //     distribution_end_date: new Date(values.distribution_end_date)\n    //       .toISOString()\n    //       .substr(0, 10),\n\n    const handleSubmit = values => {\n      let post_code = values.post_code;\n      values = {\n        name: values.name,\n        distribution_start_date: \"2023-01-01\",\n        distribution_end_date: \"2023-01-01\",\n        post_supervisor_user_id: values.post_supervisor_user_id,\n        villages: values.villages,\n        isFacility: values.isFacility\n      };\n      console.log(values);\n      if (post_code) {\n        values.post_code = post_code;\n      }\n      fetch(API_URL, {\n        method: \"POST\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          ...authHeader()\n        },\n        body: JSON.stringify(values)\n      }).then(response => response.json()).then(data => {\n        console.log(data);\n        console.log(\".......... \");\n        console.log(API_URL);\n        if (data.success == true) {\n          router.push(\"/nets/distribution\");\n          _notification[\"success\"]({\n            message: \"Post Created\",\n            description: `Post Created successfully.`,\n            duration: 5.5\n          });\n        } else {\n          _notification[\"error\"]({\n            message: \"Post Creation Failed\",\n            description: `Post Creation failed.`,\n            duration: 5.5\n          });\n        }\n      }).catch(error => {\n        console.error(\"Error:\", error);\n      });\n    };\n    return {\n      isLoading,\n      loading,\n      apiUrl,\n      isFileLoading,\n      isFacility,\n      handleSubmit,\n      dateFormat,\n      formState,\n      join,\n      villages,\n      users\n    };\n  },\n  beforeRouteEnter(to, from, next) {\n    if (!sessionStorage.getItem(\"user\")) {\n      next(\"/auth/login\");\n    } else {\n      next();\n    }\n  }\n});\nexport default AddNew;","map":{"version":3,"names":["RecordFormWrapper","Main","BasicFormWrapper","useStore","reactive","ref","defineComponent","computed","onMounted","authHeader","useRouter","dateFormat","AddNew","name","components","data","state","isLoading","crud","loading","apiUrl","url","isFileLoading","fileLoading","join","API_URL","process","env","VUE_APP_BASE_URL","router","formState","distribution_start_date","distribution_end_date","post_supervisor_user_id","villages","post_code","isFacility","users","getVillages","response","fetch","method","headers","console","log","json","getUsers","handleSubmit","values","body","JSON","stringify","then","success","push","_notification","message","description","duration","catch","error","beforeRouteEnter","to","from","next","sessionStorage","getItem"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/pages/net-distribution/CreatePost.vue"],"sourcesContent":["<template>\n  <sdPageHeader title=\"Create Post\">\n    <sdButton class=\"btn-add_new\" size=\"default\" key=\"1\" type=\"sucess\">\n      <router-link to=\"/crud/axios-view\">View All</router-link>\n    </sdButton>\n  </sdPageHeader>\n  <Main>\n    <a-row :gutter=\"15\">\n      <a-col :xs=\"24\">\n        <RecordFormWrapper>\n          <sdCards headless>\n            <a-row justify=\"center\">\n              <a-col :xl=\"10\" :md=\"16\" :xs=\"24\">\n                <BasicFormWrapper>\n                  <a-form\n                    class=\"add-record-form\"\n                    :style=\"{ width: '100%' }\"\n                    layout=\"vertical\"\n                    name=\"addnew\"\n                    :model=\"formState\"\n                    @finish=\"handleSubmit\"\n                  >\n                    <a-form-item name=\"name\" label=\"Post Name\">\n                      <a-input\n                        v-model:value=\"formState.name\"\n                        placeholder=\"Enter post name\"\n                      />\n                    </a-form-item>\n                    <!-- <a-form-item\n                      name=\"distribution_start_date\"\n                      label=\"Start Date\"\n                    >\n                      <a-date-picker\n                        :style=\"{ width: '100%' }\"\n                        v-model:value=\"formState.distribution_start_date\"\n                        :format=\"dateFormat\"\n                      />\n                    </a-form-item>\n                    <a-form-item name=\"distribution_end_date\" label=\"End Date\">\n                      <a-date-picker\n                        :style=\"{ width: '100%' }\"\n                        v-model:value=\"formState.distribution_end_date\"\n                        :format=\"dateFormat\"\n                      />\n                    </a-form-item> -->\n                    <a-form-item\n                      name=\"post_supervisor_user_id\"\n                      label=\"Post Admin\"\n                    >\n                      <a-select\n                        size=\"medium\"\n                        name=\"basic-select\"\n                        class=\"sDash_fullwidth-select\"\n                        v-model:value=\"formState.post_supervisor_user_id\"\n                      >\n                        <a-select-option\n                          v-for=\"user in users\"\n                          :value=\"user.id\"\n                          :key=\"user.id\"\n                          >{{\n                            user.first_name + \" \" + user.last_name\n                          }}</a-select-option\n                        >\n                      </a-select>\n                    </a-form-item>\n                    <a-form-item name=\"villages\" label=\"Select villages\">\n                      <a-select\n                        mode=\"multiple\"\n                        size=\"large\"\n                        name=\"basic-select\"\n                        class=\"sDash_fullwidth-select\"\n                        v-model:value=\"formState.villages\"\n                        v-if=\"!loading\"\n                      >\n                        <a-select-option\n                          v-for=\"village in villages\"\n                          :value=\"village.id\"\n                          :key=\"village.id\"\n                          >{{ village.name }}</a-select-option\n                        >\n                      </a-select>\n                    </a-form-item>\n                    <a-form-item name=\"isFacility\">\n                      <a-checkbox v-model:checked=\"isFacility\"\n                        >Is Post a Facility?</a-checkbox\n                      >\n                    </a-form-item>\n                    <!-- label = {{ !isFacility ? `fyufuyfuy`: `jjkhkjhkj` }} -->\n                    <a-form-item name=\"post_code\">\n                      <label>{{\n                        !isFacility ? \" \" : `Facility MFL code`\n                      }}</label>\n                      <br />\n                      <a-input\n                        v-if=\"isFacility\"\n                        v-model:value=\"formState.post_code\"\n                        placeholder=\"Enter facility mfl code\"\n                      />\n                    </a-form-item>\n\n                    <div class=\"record-form-actions text-right\">\n                      <sdButton size=\"default\" htmlType=\"Save\" type=\"success\">\n                        {{ isLoading ? \"Loading...\" : \"Submit\" }}\n                      </sdButton>\n                    </div>\n                  </a-form>\n                </BasicFormWrapper>\n              </a-col>\n            </a-row>\n          </sdCards>\n        </RecordFormWrapper>\n      </a-col>\n    </a-row>\n  </Main>\n</template>\n<script>\nimport { RecordFormWrapper } from \"../style\";\nimport { Main, BasicFormWrapper } from \"../../styled\";\nimport { useStore } from \"vuex\";\nimport { reactive, ref, defineComponent, computed, onMounted } from \"vue\";\nimport { notification } from \"ant-design-vue\";\nimport authHeader from \"../../../services/auth-header\";\nimport { useRouter } from \"vue-router\";\n\nconst dateFormat = \"YYYY-MM-DD\";\n\nconst AddNew = defineComponent({\n  name: \"AddNew\",\n  components: { RecordFormWrapper, Main, BasicFormWrapper },\n  data() {\n    const { state } = useStore();\n    const isLoading = computed(() => state.crud.loading);\n    const apiUrl = computed(() => state.crud.url);\n    const isFileLoading = computed(() => state.crud.fileLoading);\n    const join = ref(\"\");\n    const API_URL = `${process.env.VUE_APP_BASE_URL}/distribution_post`;\n    const router = useRouter();\n\n    const formState = reactive({\n      name: \"\",\n      distribution_start_date: \"\",\n      distribution_end_date: \"\",\n      post_supervisor_user_id: \"\",\n      villages: [],\n      post_code: \"\",\n      isFacility: 0,\n    });\n\n    const { villages, loading, isFacility, users } = reactive({\n      villages: [],\n      users: [],\n      loading: true,\n      isFacility: false,\n    });\n\n    //counties\n    const getVillages = async () => {\n      const response = await fetch(\n        `${process.env.VUE_APP_BASE_URL}/villages/list`,\n        {\n          method: \"GET\",\n          headers: {\n            \"Content-Type\": \"application/json\",\n            ...authHeader(),\n          },\n        }\n      );\n      console.log(response);\n      const data = await response.json();\n      this.villages = data.data;\n      this.loading = false;\n    };\n\n    //users\n    const getUsers = async () => {\n      const response = await fetch(`${process.env.VUE_APP_BASE_URL}/users`, {\n        method: \"GET\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          ...authHeader(),\n        },\n      });\n      const data = await response.json();\n      this.users = data.data;\n    };\n\n    onMounted(() => {\n      getUsers();\n      getVillages();\n    });\n\n    // notification\n    // const openNotification = (type) => {\n    //   notification[type]({\n    //     message: \"Notification Title\",\n    //     description:\n    //       type == \"success\"\n    //         ? \"Post created successfully\"\n    //         : \"Post creation failed\",\n    //   });\n    // };\n\n    // distribution_start_date: new Date(values.distribution_start_date)\n    //       .toISOString()\n    //       .substr(0, 10),\n    //     distribution_end_date: new Date(values.distribution_end_date)\n    //       .toISOString()\n    //       .substr(0, 10),\n\n    const handleSubmit = (values) => {\n      let post_code = values.post_code;\n      values = {\n        name: values.name,\n        distribution_start_date: \"2023-01-01\",\n        distribution_end_date: \"2023-01-01\",\n        post_supervisor_user_id: values.post_supervisor_user_id,\n        villages: values.villages,\n        isFacility: values.isFacility,\n      };\n      console.log(values);\n\n      if (post_code) {\n        values.post_code = post_code;\n      }\n      fetch(API_URL, {\n        method: \"POST\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          ...authHeader(),\n        },\n        body: JSON.stringify(values),\n      })\n        .then((response) => response.json())\n        .then((data) => {\n          console.log(data);\n          console.log(\".......... \");\n          console.log(API_URL);\n          if (data.success == true) {\n            router.push(\"/nets/distribution\");\n            notification[\"success\"]({\n              message: \"Post Created\",\n              description: `Post Created successfully.`,\n              duration: 5.5,\n            });\n          } else {\n            notification[\"error\"]({\n              message: \"Post Creation Failed\",\n              description: `Post Creation failed.`,\n              duration: 5.5,\n            });\n          }\n        })\n        .catch((error) => {\n          console.error(\"Error:\", error);\n        });\n    };\n\n    return {\n      isLoading,\n      loading,\n      apiUrl,\n      isFileLoading,\n      isFacility,\n      handleSubmit,\n      dateFormat,\n      formState,\n      join,\n      villages,\n      users,\n    };\n  },\n  beforeRouteEnter(to, from, next) {\n    if (!sessionStorage.getItem(\"user\")) {\n      next(\"/auth/login\");\n    } else {\n      next();\n    }\n  },\n});\n\nexport default AddNew;\n</script>\n"],"mappings":";;;AAoHA,SAASA,iBAAgB,QAAS,UAAU;AAC5C,SAASC,IAAI,EAAEC,gBAAe,QAAS,cAAc;AACrD,SAASC,QAAO,QAAS,MAAM;AAC/B,SAASC,QAAQ,EAAEC,GAAG,EAAEC,eAAe,EAAEC,QAAQ,EAAEC,SAAQ,QAAS,KAAK;AAEzE,OAAOC,UAAS,MAAO,+BAA+B;AACtD,SAASC,SAAQ,QAAS,YAAY;AAEtC,MAAMC,UAAS,GAAI,YAAY;AAE/B,MAAMC,MAAK,GAAIN,eAAe,CAAC;EAC7BO,IAAI,EAAE,QAAQ;EACdC,UAAU,EAAE;IAAEd,iBAAiB;IAAEC,IAAI;IAAEC;EAAiB,CAAC;EACzDa,IAAIA,CAAA,EAAG;IACL,MAAM;MAAEC;IAAM,IAAIb,QAAQ,EAAE;IAC5B,MAAMc,SAAQ,GAAIV,QAAQ,CAAC,MAAMS,KAAK,CAACE,IAAI,CAACC,OAAO,CAAC;IACpD,MAAMC,MAAK,GAAIb,QAAQ,CAAC,MAAMS,KAAK,CAACE,IAAI,CAACG,GAAG,CAAC;IAC7C,MAAMC,aAAY,GAAIf,QAAQ,CAAC,MAAMS,KAAK,CAACE,IAAI,CAACK,WAAW,CAAC;IAC5D,MAAMC,IAAG,GAAInB,GAAG,CAAC,EAAE,CAAC;IACpB,MAAMoB,OAAM,GAAK,GAAEC,OAAO,CAACC,GAAG,CAACC,gBAAiB,oBAAmB;IACnE,MAAMC,MAAK,GAAInB,SAAS,EAAE;IAE1B,MAAMoB,SA