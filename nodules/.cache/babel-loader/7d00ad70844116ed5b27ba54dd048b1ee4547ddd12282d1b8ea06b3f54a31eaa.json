{"ast":null,"code":"import { BasicFormWrapper } from \"../../../styled\";\nimport { reactive, ref, defineComponent } from \"vue\";\nconst Info = defineComponent({\n  name: \"Info\",\n  components: {\n    BasicFormWrapper\n  },\n  setup() {\n    const values = ref(\"\");\n    const formState = reactive({\n      name: \"\",\n      email: \"\",\n      phone: \"\",\n      country: \"\",\n      city: \"\",\n      website: \"\",\n      layout: \"vertical\"\n    });\n    const rules = {\n      name: [{\n        required: true,\n        message: \"Please input Activity name\",\n        trigger: \"blur\"\n      }],\n      email: [{\n        required: true,\n        message: \"Please input Activity email\",\n        trigger: \"blur\"\n      }, {\n        type: \"email\",\n        message: \"Please input a valid email\",\n        trigger: \"blur\"\n      }]\n    };\n    const handleFinish = values => {\n      values.value = values;\n    };\n    const handleFinishFailed = errors => {\n      console.log(errors);\n    };\n    return {\n      values,\n      formState,\n      handleFinish,\n      handleFinishFailed,\n      rules\n    };\n  }\n});\nexport default Info;","map":{"version":3,"names":["BasicFormWrapper","reactive","ref","defineComponent","Info","name","components","setup","values","formState","email","phone","country","city","website","layout","rules","required","message","trigger","type","handleFinish","value","handleFinishFailed","errors","console","log"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/apps/users/overview/Info.vue"],"sourcesContent":["<template>\r\n  <a-row justify=\"center\">\r\n    <a-col :xl=\"10\" :md=\"16\" :xs=\"24\">\r\n      <div class=\"user-info-form\">\r\n        <BasicFormWrapper>\r\n          <a-form\r\n            style=\"width: 100%\"\r\n            name=\"info\"\r\n            :model=\"formState\"\r\n            :rules=\"rules\"\r\n            @finish=\"handleFinish\"\r\n            @finishFailed=\"handleFinishFailed\"\r\n            :layout=\"formState.layout\"\r\n          >\r\n            <sdHeading class=\"form-title\" as=\"h4\">\r\n              Personal Information\r\n            </sdHeading>\r\n\r\n            <figure class=\"photo-upload align-center-v\">\r\n              <img\r\n                :src=\"require('@/static/img/avatar/profileImage.png')\"\r\n                alt=\"\"\r\n              />\r\n              <figcaption>\r\n                <a-upload>\r\n                  <a class=\"btn-upload\" to=\"#\">\r\n                    <sdFeatherIcons type=\"camera\" size=\"16\" />\r\n                  </a>\r\n                </a-upload>\r\n                <div class=\"info\">\r\n                  <sdHeading as=\"h4\">Profile Photo</sdHeading>\r\n                </div>\r\n              </figcaption>\r\n            </figure>\r\n\r\n            <a-form-item label=\"Name\" name=\"name\">\r\n              <a-input\r\n                v-model:value=\"formState.name\"\r\n                placeholder=\"Input Name\"\r\n              />\r\n            </a-form-item>\r\n\r\n            <a-form-item label=\"Email Address\" name=\"email\">\r\n              <a-input\r\n                v-model:value=\"formState.email\"\r\n                placeholder=\"name@example.com\"\r\n              />\r\n            </a-form-item>\r\n\r\n            <a-form-item name=\"phone\" label=\"Phone Number\">\r\n              <a-input\r\n                v-model:value=\"formState.phone\"\r\n                placeholder=\"+440 2546 5236\"\r\n              />\r\n            </a-form-item>\r\n\r\n            <a-form-item name=\"country\" label=\"Country\">\r\n              <a-select v-model:value=\"formState.country\" style=\"width: 100%\">\r\n                <a-select-option value=\"\">Please Select</a-select-option>\r\n                <a-select-option value=\"bangladesh\">Bangladesh</a-select-option>\r\n                <a-select-option value=\"india\">India</a-select-option>\r\n                <a-select-option value=\"pakistan\">Pakistan</a-select-option>\r\n              </a-select>\r\n            </a-form-item>\r\n\r\n            <a-form-item name=\"city\" label=\"City\">\r\n              <a-select v-model:value=\"formState.city\" style=\"width: 100%\">\r\n                <a-select-option value=\"\">Please Select</a-select-option>\r\n                <a-select-option value=\"dhaka\">Dhaka</a-select-option>\r\n                <a-select-option value=\"khulna\">Khulna</a-select-option>\r\n                <a-select-option value=\"barisal\">Barisal</a-select-option>\r\n              </a-select>\r\n            </a-form-item>\r\n\r\n            <a-form-item name=\"website\" label=\"Website\">\r\n              <a-input\r\n                v-model:value=\"formState.website\"\r\n                placeholder=\"www.example.com\"\r\n              />\r\n            </a-form-item>\r\n\r\n            <a-form-item>\r\n              <div class=\"add-user-bottom text-right\">\r\n                <sdButton class=\"ant-btn ant-btn-light\"> Reset </sdButton>\r\n                <sdButton htmlType=\"submit\" type=\"primary\">\r\n                  <router-link to=\"work\">Save & Next</router-link>\r\n                </sdButton>\r\n              </div>\r\n            </a-form-item>\r\n          </a-form>\r\n        </BasicFormWrapper>\r\n      </div>\r\n    </a-col>\r\n  </a-row>\r\n</template>\r\n<script>\r\nimport { BasicFormWrapper } from \"../../../styled\";\r\nimport { reactive, ref, defineComponent } from \"vue\";\r\nconst Info = defineComponent({\r\n  name: \"Info\",\r\n  components: { BasicFormWrapper },\r\n  setup() {\r\n    const values = ref(\"\");\r\n    const formState = reactive({\r\n      name: \"\",\r\n      email: \"\",\r\n      phone: \"\",\r\n      country: \"\",\r\n      city: \"\",\r\n      website: \"\",\r\n      layout: \"vertical\",\r\n    });\r\n\r\n    const rules = {\r\n      name: [\r\n        {\r\n          required: true,\r\n          message: \"Please input Activity name\",