{"ast":null,"code":"import { useStore } from \"vuex\";\nimport { computed, ref, onMounted, defineComponent } from \"vue\";\nimport { PerformanceChartWrapper, Pstates } from \"../../style\";\nimport { chartLinearGradient, customTooltips } from \"../../../../components/utilities/utilities\";\nimport authHeader from \"../../../../services/auth-header\";\nconst WebsitePerformance = defineComponent({\n  components: {\n    PerformanceChartWrapper,\n    Pstates\n  },\n  setup() {\n    const store = useStore();\n    const performance = ref(\"year\");\n    const performanceTab = ref(\"users\");\n    const height = ref(window.innerWidth <= 575 ? 200 : 85);\n    const performanceState = computed(() => store.state.chartContent.performanceData);\n    const preIsLoading = computed(() => store.state.chartContent.perLoading);\n    const performanceDatasets = computed(() => [{\n      data: performanceState.value[performanceTab.value][1],\n      borderColor: \"#5F63F2\",\n      borderWidth: 4,\n      fill: true,\n      backgroundColor: () => chartMethods(\"performance\", [\"#5F63F230\", \"#ffffff05\"]),\n      label: \"Current period\",\n      pointStyle: \"circle\",\n      pointRadius: \"0\",\n      hoverRadius: \"9\",\n      pointBorderColor: \"#fff\",\n      pointBackgroundColor: \"#5F63F2\",\n      hoverBorderWidth: 5\n    }, {\n      data: performanceState.value[performanceTab.value][2],\n      borderColor: \"#C6D0DC\",\n      borderWidth: 2,\n      fill: false,\n      backgroundColor: \"#00173750\",\n      label: \"Previous period\",\n      borderDash: [3, 3],\n      pointRadius: \"0\",\n      hoverRadius: \"0\"\n    }]);\n    const handleActiveChangePerformance = (event, value) => {\n      event.preventDefault();\n      performance.value = value;\n      return store.dispatch(\"performanceFilterData\", value);\n    };\n    function chartMethods(elementId, color) {\n      return chartLinearGradient(document.querySelector(`.${elementId}`), 300, {\n        start: color[0],\n        end: color[1]\n      });\n    }\n    const onPerformanceTab = value => {\n      performanceTab.value = value;\n      return store.dispatch(\"setIsLoading\");\n    };\n    onMounted(() => {\n      store.dispatch(\"performanceGetData\");\n    });\n    const chartOptions = {\n      maintainAspectRatio: true,\n      elements: {\n        z: 9999\n      },\n      legend: {\n        display: false\n      },\n      hover: {\n        mode: \"index\",\n        intersect: false\n      },\n      tooltips: {\n        mode: \"label\",\n        intersect: false,\n        backgroundColor: \"#ffffff\",\n        position: \"average\",\n        enabled: false,\n        custom: customTooltips,\n        callbacks: {\n          title() {\n            return performanceTab.value;\n          },\n          label(t, d) {\n            const {\n              yLabel,\n              datasetIndex\n            } = t;\n            return `<span class=\"chart-data\">${yLabel}k</span> <span class=\"data-label\">${d.datasets[datasetIndex].label}</span>`;\n          }\n        }\n      },\n      scales: {\n        yAxes: [{\n          gridLines: {\n            color: \"#e5e9f2\",\n            borderDash: [3, 3],\n            zeroLineColor: \"#e5e9f2\",\n            zeroLineWidth: 1,\n            zeroLineBorderDash: [3, 3]\n          },\n          ticks: {\n            beginAtZero: true,\n            fontSize: 13,\n            fontColor: \"#182b49\",\n            max: 80,\n            stepSize: 20,\n            callback(label) {\n              return `${label}k`;\n            }\n          }\n        }],\n        xAxes: [{\n          gridLines: {\n            display: true,\n            zeroLineWidth: 2,\n            zeroLineColor: \"transparent\",\n            color: \"transparent\",\n            z: 1,\n            tickMarkLength: 0\n          },\n          ticks: {\n            padding: 10\n          }\n        }]\n      }\n    };\n    const bukengele_friends_church = ref(0);\n    const bukengele_sda = ref(0);\n    const mukholi_primary = ref(0);\n    const ranje_dispensary = ref(0);\n    const percentage_net_distribution = ref(0);\n    onMounted(async () => {\n      try {\n        const response = await fetch(`${process.env.VUE_APP_BASE_URL}/dash_stats`, {\n          method: \"GET\",\n          headers: authHeader()\n        });\n        const data = await response.json();\n        console.log(data);\n        bukengele_friends_church.value = data.distribution_details_bukengele_friends_church;\n        bukengele_sda.value = data.distribution_details_bukengele_sda;\n        mukholi_primary.value = data.distribution_details_mukholi_primary;\n        ranje_dispensary.value = data.distribution_details_ranje_dispensary;\n        percentage_net_distribution.value = data.percentage_net_distribution;\n      } catch (error) {\n        console.error(error);\n      }\n    });\n    return {\n      performanceState,\n      preIsLoading,\n      performance,\n      performanceTab,\n      handleActiveChangePerformance,\n      onPerformanceTab,\n      height,\n      chartOptions,\n      chartLinearGradient,\n      chartMethods,\n      performanceDatasets,\n      bukengele_friends_church,\n      bukengele_sda,\n      mukholi_primary,\n      ranje_dispensary,\n      percentage_net_distribution\n    };\n  }\n});\nexport default WebsitePerformance;","map":{"version":3,"names":["useStore","computed","ref","onMounted","defineComponent","PerformanceChartWrapper","Pstates","chartLinearGradient","customTooltips","authHeader","WebsitePerformance","components","setup","store","performance","performanceTab","height","window","innerWidth","performanceState","state","chartContent","performanceData","preIsLoading","perLoading","performanceDatasets","data","value","borderColor","borderWidth","fill","backgroundColor","chartMethods","label","pointStyle","pointRadius","hoverRadius","pointBorderColor","pointBackgroundColor","hoverBorderWidth","borderDash","handleActiveChangePerformance","event","p