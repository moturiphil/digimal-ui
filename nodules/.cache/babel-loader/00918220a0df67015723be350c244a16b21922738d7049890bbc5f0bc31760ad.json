{"ast":null,"code":"import \"ant-design-vue/es/notification/style\";\nimport _notification from \"ant-design-vue/es/notification\";\nimport { RecordFormWrapper } from \"./style\";\nimport { Main, BasicFormWrapper } from \"../../styled\";\nimport { useStore } from \"vuex\";\nimport { reactive, ref, defineComponent, computed, onMounted } from \"vue\";\n// import axios from \"axios\";\nimport authHeader from \"../../../services/auth-header\";\nconst dateFormat = \"YYYY-MM-DD\";\nconst AddNew = defineComponent({\n  name: \"AddNew\",\n  components: {\n    RecordFormWrapper,\n    Main,\n    BasicFormWrapper\n  },\n  data() {\n    const {\n      state\n    } = useStore();\n    const isLoading = computed(() => state.crud.loading);\n    const apiUrl = computed(() => state.crud.url);\n    const isFileLoading = computed(() => state.crud.fileLoading);\n    const join = ref(\"\");\n    const API_URL = `${process.env.VUE_APP_BASE_URL}/ouCreation?unit=location`;\n    const formState = reactive({\n      name: \"\",\n      ward_id: \"\"\n    });\n    const {\n      counties,\n      loading,\n      sub_counties,\n      wards\n    } = reactive({\n      counties: [],\n      loading: true,\n      sub_counties: [],\n      wards: []\n    });\n\n    //counties\n    const getCounties = async () => {\n      const response = await fetch(`${process.env.VUE_APP_BASE_URL}/counties`, {\n        method: \"GET\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          ...authHeader()\n        }\n      });\n      const data = await response.json();\n      this.counties = data.map(county => ({\n        ...county\n        // org_id: county.org_id,\n      }));\n\n      console.log(this.counties);\n      this.loading = false;\n    };\n    onMounted(() => {\n      getCounties();\n      getSubCounties();\n    });\n\n    // sub_county\n\n    const getSubCounties = async org_id => {\n      console.log(org_id);\n      const response = await fetch(`${process.env.VUE_APP_BASE_URL}/get_sub_counties_list?parent_id=${org_id}`, {\n        method: \"GET\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          ...authHeader()\n        }\n      });\n      const data = await response.json();\n      console.log(data);\n      this.sub_counties = data.message;\n    };\n\n    //wards\n\n    const getWards = async org_id => {\n      console.log(org_id);\n      const response = await fetch(`${process.env.VUE_APP_BASE_URL}/get_sub_counties_list?parent_id=${org_id}`, {\n        method: \"GET\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          ...authHeader()\n        }\n      });\n      const data = await response.json();\n      console.log(data);\n      this.wards = data.message;\n    };\n    const handleSubmit = values => {\n      console.log(\" values from the form submitted\");\n      console.log(values.ward_id);\n      console.log(values.name);\n      const data = {\n        parent_id: values.ward_id,\n        data: [{\n          name: values.name\n        }]\n      };\n      console.log(API_URL);\n      fetch(API_URL, {\n        method: \"POST\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          ...authHeader()\n        },\n        body: JSON.stringify(data)\n      }).then(response => response.json()).then(({\n        success\n      }) => {\n        if (success) {\n          // router.push(\"activity-view\");\n          _notification[\"success\"]({\n            message: \"Location Created\",\n            description: `Location Created successfully`,\n            //${data.activity_code}\n            duration: 5.5\n          });\n        }\n      }).catch(error => {\n        console.error(\"Error:\", error);\n      });\n    };\n    return {\n      isLoading,\n      loading,\n      apiUrl,\n      isFileLoading,\n      handleSubmit,\n      dateFormat,\n      formState,\n      join,\n      counties,\n      sub_counties,\n      wards,\n      getSubCounties,\n      getWards\n    };\n  },\n  beforeRouteEnter(to, from, next) {\n    if (!sessionStorage.getItem(\"user\")) {\n      next(\"/auth/login\");\n    } else {\n      next();\n    }\n  }\n});\nexport default AddNew;","map":{"version":3,"names":["RecordFormWrapper","Main","BasicFormWrapper","useStore","reactive","ref","defineComponent","computed","onMounted","authHeader","dateFormat","AddNew","name","components","data","state","isLoading","crud","loading","apiUrl","url","isFileLoading","fileLoading","join","API_URL","process","env","VUE_APP_BASE_URL","formState","ward_id","counties","sub_counties","wards","getCounties","response","fetch","method","headers","json","map","county","console","log","getSubCounties","org_id","message","getWards","handleSubmit","values","parent_id","body","JSON","stringify","then","success","_notification","description","duration","catch","error","beforeRouteEnter","to","from","next","sessionStorage","getItem"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/pages/orgUnits/createLocation.vue"],"sourcesContent":["<template>\n  <sdPageHeader title=\"Create Location\">\n    <sdButton class=\"btn-add_new\" size=\"default\" key=\"1\" type=\"sucess\">\n      <router-link to=\"/crud/axios-view\">View All</router-link>\n    </sdButton>\n  </sdPageHeader>\n  <Main>\n    <a-row :gutter=\"15\">\n      <a-col :xs=\"24\">\n        <RecordFormWrapper>\n          <sdCards headless>\n            <a-row justify=\"center\">\n              <a-col :xl=\"10\" :md=\"16\" :xs=\"24\">\n                <BasicFormWrapper>\n                  <a-form\n                    class=\"add-record-form\"\n                    :style=\"{ width: '100%' }\"\n                    layout=\"vertical\"\n                    name=\"addnew\"\n                    :model=\"formState\"\n                    @finish=\"handleSubmit\"\n                  >\n                    <a-form-item name=\"county\" label=\"County\">\n                      <a-select\n                        size=\"large\"\n                        name=\"basic-select\"\n                        class=\"sDash_fullwidth-select\"\n                        placeholder=\"Select County\"\n                        v-on:change=\"getSubCounties($event)\"\n                        v-if=\"!loading\"\n                      >\n                        <a-select-option value=\"\"\n                          >Select an option</a-select-option\n                        >\n                        <a-select-option\n                          v-for=\"county in counties\"\n                          :value=\"county.org_id\"\n                          :key=\"county.id\"\n                          :org_id=\"county.org_id\"\n                        >\n                          {{ county.name }}\n                        </a-select-option>\n                      </a-select>\n                    </a-form-item>\n                    <a-form-item name=\"sub_county\" label=\"Sub County\">\n                      <a-select\n                        size=\"large\"\n                        name=\"basic-select\"\n                        class=\"sDash_fullwidth-select\"\n                        placeholder=\"Select Sub-County\"\n                        v-on:change=\"getWards($event)\"\n                      >\n                        <a-select-option value=\"\"\n                          >Select an option</a-select-option\n                        >\n                        <a-select-option\n                          v-for=\"scounty in sub_counties\"\n                          :value=\"scounty.org_id\"\n                          :key=\"scounty.id\"\n                          >{{ scounty.name }}</a-select-option\n                        >\n                      </a-select>\n                    </a-form-item>\n\n                    <a-form-item name=\"ward_id\" label=\"Ward\">\n                      <a-select\n                        size=\"large\"\n                        name=\"basic-select\"\n                        class=\"sDash_fullwidth-select\"\n                        placeholder=\"Select Ward\"\n                        v-model:value=\"formState.ward_id\"\n                      >\n                        <a-select-option value=\"\"\n                          >Select an option</a-select-option\n                        >\n                        <a-select-option\n                          v-for=\"ward in wards\"\n                          :value=\"ward.org_id\"\n                          :key=\"ward.id\"\n                          >{{ ward.name }}</a-select-option\n                        >\n                      </a-select>\n                    </a-form-item>\n\n                    <a-form-item name=\"name\" label=\"Location Name\">\n                      <a-input\n                        v-model:value=\"formState.name\"\n                        placeholder=\"Enter Location name\"\n                      />\n                    </a-form-item>\n\n                    <div class=\"record-form-actions text-right\">\n                      <sdButton size=\"default\" htmlType=\"Save\" type=\"success\">\n                        {{ isLoading ? \"Loading...\" : \"Submit\" }}\n                      </sdButton>\n                    </div>\n                  </a-form>\n                </BasicFormWrapper>\n              </a-col>\n            </a-row>\n          </sdCards>\n        </RecordFormWrapper>\n      </a-col>\n    </a-row>\n  </Main>\n</template>\n<script>\nimport { RecordFormWrapper } from \"./style\";\nimport { Main, BasicFormWrapper } from \"../../styled\";\nimport { useStore } from \"vuex\";\nimport { reactive, ref, defineComponent, computed, onMounted } from \"vue\";\nimport { notification } from \"ant-design-vue\";\n// import axios from \"axios\";\nimport authHeader from \"../../../services/auth-header\";\n\nconst dateFormat = \"YYYY-MM-DD\";\n\nconst AddNew = defineComponent({\n  name: \"AddNew\",\n  components: { RecordFormWrapper, Main, BasicFormWrapper },\n  data() {\n    const { state } = useStore();\n    const isLoading = computed(() => state.crud.loading);\n    const apiUrl = computed(() => state.crud.url);\n    const isFileLoading = computed(() => state.crud.fileLoading);\n    const join = ref(\"\");\n    const API_URL = `${process.env.VUE_APP_BASE_URL}/ouCreation?unit=location`;\n\n    const formState = reactive({\n      name: \"\",\n      ward_id: \"\",\n    });\n\n    const { counties, loading, sub_counties, wards } = reactive({\n      counties: [],\n      loading: true,\n      sub_counties: [],\n      wards: [],\n    });\n\n    //counties\n    const getCounties = async () => {\n      const response = await fetch(`${process.env.VUE_APP_BASE_URL}/counties`, {\n        method: \"GET\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          ...authHeader(),\n        },\n      });\n\n      const data = await response.json();\n      this.counties = data.map((county) => ({\n        ...county,\n        // org_id: county.org_id,\n      }));\n      console.log(this.counties);\n      this.loading = false;\n    };\n\n    onMounted(() => {\n      getCounties();\n      getSubCounties();\n    });\n\n    // sub_county\n\n    const getSubCounties = async (org_id) => {\n      console.log(org_id);\n      const response = await fetch(\n        `${process.env.VUE_APP_BASE_URL}/get_sub_counties_list?parent_id=${org_id}`,\n        {\n          method: \"GET\",\n          headers: {\n            \"Content-Type\": \"application/json\",\n            ...authHeader(),\n          },\n        }\n      );\n      const data = await response.json();\n      console.log(data);\n      this.sub_counties = data.message;\n    };\n\n    //wards\n\n    const getWards = async (org_id) => {\n      console.log(org_id);\n      const response = await fetch(\n        `${process.env.VUE_APP_BASE_URL}/get_sub_counties_list?parent_id=${org_id}`,\n        {\n          method: \"GET\",\n          headers: {\n            \"Content-Type\": \"application/json\",\n            ...authHeader(),\n          },\n        }\n      );\n      const data = await response.json();\n      console.log(data);\n      this.wards = data.message;\n    };\n\n    const handleSubmit = (values) => {\n      console.log(\" values from the form submitted\");\n      console.log(values.ward_id);\n      console.log(values.name);\n\n      const data = {\n        parent_id: values.ward_id,\n        data: [\n          {\n            name: values.name,\n          },\n        ],\n      };\n      console.log(API_URL);\n\n      fetch(API_URL, {\n        method: \"POST\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          ...authHeader(),\n        },\n        body: JSON.stringify(data),\n      })\n        .then((response) => response.json())\n        .then(({ success }) => {\n          if (success) {\n            // router.push(\"activity-view\");\n            notification[\"success\"]({\n              message: \"Location Created\",\n              description: `Location Created successfully`, //${data.activity_code}\n              duration: 5.5,\n            });\n          }\n        })\n        .catch((error) => {\n          console.error(\"Error:\", error);\n        });\n    };\n\n    return {\n      isLoading,\n      loading,\n      apiUrl,\n      isFileLoading,\n      handleSubmit,\n      dateFormat,\n      formState,\n      join,\n      counties,\n      sub_counties,\n      wards,\n      getSubCounties,\n      getWards,\n    };\n  },\n  beforeRouteEnter(to, from, next) {\n    if (!sessionStorage.getItem(\"user\")) {\n      next(\"/auth/login\");\n    } else {\n      next();\n    }\n  },\n});\n\nexport default AddNew;\n</script>\n"],"mappings":";;AA2GA,SAASA,iBAAgB,QAAS,SAAS;AAC3C,SAASC,IAAI,EAAEC,gBAAe,QAAS,cAAc;AACrD,SAASC,QAAO,QAAS,MAAM;AAC/B,SAASC,QAAQ,EAAEC,GAAG,EAAEC,eAAe,EAAEC,QAAQ,EAAEC,SAAQ,QAAS,KAAK;AAEzE;AACA,OAAOC,UAAS,MAAO,+BAA+B;AAEtD,MAAMC,UAAS,GAAI,YAAY;AAE/B,MAAMC,MAAK,GAAIL,eAAe,CAAC;EAC7BM,IAAI,EAAE,QAAQ;EACd