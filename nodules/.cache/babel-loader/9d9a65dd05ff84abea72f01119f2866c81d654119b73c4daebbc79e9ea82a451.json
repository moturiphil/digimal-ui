{"ast":null,"code":"import \"ant-design-vue/es/notification/style\";\nimport _notification from \"ant-design-vue/es/notification\";\nimport { RecordFormWrapper } from \"./style\";\nimport { Main, BasicFormWrapper } from \"../../styled\";\nimport { useStore } from \"vuex\";\nimport { reactive, ref, defineComponent, computed, onMounted } from \"vue\";\n// import axios from \"axios\";\n\nimport authHeader from \"../../../services/auth-header\";\nconst dateFormat = \"YYYY-MM-DD\";\nconst AddNew = defineComponent({\n  name: \"AddNew\",\n  components: {\n    RecordFormWrapper,\n    Main,\n    BasicFormWrapper\n  },\n  data() {\n    const {\n      state\n    } = useStore();\n    const isLoading = computed(() => state.crud.loading);\n    const apiUrl = computed(() => state.crud.url);\n    const isFileLoading = computed(() => state.crud.fileLoading);\n    const join = ref(\"\");\n    const API_URL = `${process.env.VUE_APP_BASE_URL}/ouCreation?unit=sub-location`;\n    const formState = reactive({\n      name: \"\",\n      ward_id: \"\"\n      // subLocations: [],\n    });\n\n    const {\n      counties,\n      loading,\n      sub_counties,\n      wards,\n      locations\n    } = reactive({\n      counties: [],\n      loading: true,\n      sub_counties: [],\n      wards: [],\n      locations: []\n    });\n\n    //counties\n    const getCounties = async () => {\n      const response = await fetch(`${process.env.VUE_APP_BASE_URL}/counties`, {\n        method: \"GET\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          ...authHeader()\n        }\n      });\n      const data = await response.json();\n      this.counties = data.map(county => ({\n        ...county\n        // org_id: county.org_id,\n      }));\n\n      this.loading = false;\n    };\n    onMounted(() => {\n      getCounties();\n      getSubCounties();\n    });\n\n    // sub_county\n\n    const getSubCounties = async org_id => {\n      const response = await fetch(`${process.env.VUE_APP_BASE_URL}/get_sub_counties_list?parent_id=${org_id}`, {\n        method: \"GET\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          ...authHeader()\n        }\n      });\n      const data = await response.json();\n      console.log(data);\n      this.sub_counties = data.message;\n    };\n\n    //wards\n    const getWards = async org_id => {\n      const response = await fetch(`${process.env.VUE_APP_BASE_URL}/get_sub_counties_list?parent_id=${org_id}`, {\n        method: \"GET\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          ...authHeader()\n        }\n      });\n      const data = await response.json();\n      console.log(data);\n      this.wards = data.message;\n    };\n    const getLocations = async org_id => {\n      console.log(org_id);\n      const response = await fetch(`${process.env.VUE_APP_BASE_URL}/get_sub_counties_list?parent_id=${org_id}`, {\n        method: \"GET\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          ...authHeader()\n        }\n      });\n      const data = await response.json();\n      console.log(data);\n      this.locations = data.message;\n    };\n    const handleSubmit = values => {\n      console.log(\" values from the form submitted\");\n      console.log(values.location_id);\n      console.log(values);\n      const data = {\n        parent_id: values.location_id,\n        data: [{\n          name: values.name\n        }]\n      };\n      console.log(API_URL);\n      fetch(API_URL, {\n        method: \"POST\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          ...authHeader()\n        },\n        body: JSON.stringify(data)\n      }).then(response => response.json()).then(({\n        success\n      }) => {\n        if (success) {\n          // router.push(\"activity-view\");\n          _notification[\"success\"]({\n            message: \"Sub Location Created\",\n            description: `Sub Location Created successfully`,\n            //${data.activity_code}\n            duration: 5.5\n          });\n        }\n      }).catch(error => {\n        console.error(\"Error:\", error);\n      });\n    };\n    return {\n      isLoading,\n      loading,\n      apiUrl,\n      isFileLoading,\n      handleSubmit,\n      dateFormat,\n      formState,\n      join,\n      counties,\n      sub_counties,\n      locations,\n      wards,\n      getSubCounties,\n      getLocations,\n      getWards\n    };\n  },\n  beforeRouteEnter(to, from, next) {\n    if (!sessionStorage.getItem(\"user\")) {\n      next(\"/auth/login\");\n    } else {\n      next();\n    }\n  }\n  // methods: {\n  //   addSubLocation() {\n  //     this.formState.subLocations.push(\"\");\n  //   },\n  // },\n});\n\nexport default AddNew;","map":{"version":3,"names":["RecordFormWrapper","Main","BasicFormWrapper","useStore","reactive","ref","defineComponent","computed","onMounted","authHeader","dateFormat","AddNew","name","components","data","state","isLoading","crud","loading","apiUrl","url","isFileLoading","fileLoading","join","API_URL","process","env","VUE_APP_BASE_URL","formState","ward_id","counties","sub_counties","wards","locations","getCounties","response","fetch","method","headers","json","map","county","getSubCounties","org_id","console","log","message","getWards","getLocations","handleSubmit","values","location_id","parent_id","body","JSON","stringify","then","success","_notification","description","duration","catch","error","beforeRouteEnter","to","from","next","sessionStorage","getItem"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/pages/orgUnits/createSubLocation.vue"],"sourcesContent":["<template>\n  <sdPageHeader title=\"Create Sub-Location\">\n    <sdButton class=\"btn-add_new\" size=\"default\" key=\"1\" type=\"sucess\">\n      <router-link to=\"/crud/axios-view\">View All</router-link>\n    </sdButton>\n  </sdPageHeader>\n  <Main>\n    <a-row :gutter=\"15\">\n      <a-col :xs=\"24\">\n        <RecordFormWrapper>\n          <sdCards headless>\n            <a-row justify=\"center\">\n              <a-col :xl=\"10\" :md=\"16\" :xs=\"24\">\n                <BasicFormWrapper>\n                  <a-form\n                    class=\"add-record-form\"\n                    :style=\"{ width: '100%' }\"\n                    layout=\"vertical\"\n                    name=\"addnew\"\n                    :model=\"formState\"\n                    @finish=\"handleSubmit\"\n                  >\n                    <a-form-item name=\"county\" label=\"County\">\n                      <a-select\n                        size=\"large\"\n                        name=\"basic-select\"\n                        class=\"sDash_fullwidth-select\"\n                        placeholder=\"Select County\"\n                        v-on:change=\"getSubCounties($event)\"\n                        v-if=\"!loading\"\n                      >\n                        <a-select-option value=\"\"\n                          >Select an option</a-select-option\n                        >\n                        <a-select-option\n                          v-for=\"county in counties\"\n                          :value=\"county.org_id\"\n                          :key=\"county.id\"\n                          :org_id=\"county.org_id\"\n                        >\n                          {{ county.name }}\n                        </a-select-option>\n                      </a-select>\n                    </a-form-item>\n                    <a-form-item name=\"sub_county\" label=\"Sub County\">\n                      <a-select\n                        size=\"large\"\n                        name=\"basic-select\"\n                        class=\"sDash_fullwidth-select\"\n                        placeholder=\"Select Sub-County\"\n                        v-on:change=\"getWards($event)\"\n                      >\n                        <a-select-option value=\"\"\n                          >Select an option</a-select-option\n                        >\n                        <a-select-option\n                          v-for=\"scounty in sub_counties\"\n                          :value=\"scounty.org_id\"\n                          :key=\"scounty.id\"\n                          >{{ scounty.name }}</a-select-option\n                        >\n                      </a-select>\n                    </a-form-item>\n\n                    <a-form-item name=\"ward_id\" label=\"Ward\">\n                      <a-select\n                        size=\"large\"\n                        name=\"basic-select\"\n                        class=\"sDash_fullwidth-select\"\n                        placeholder=\"Select Ward\"\n                        v-on:change=\"getLocations($event)\"\n                        v-model:value=\"formState.ward_id\"\n                      >\n                        <a-select-option value=\"\"\n                          >Select an option</a-select-option\n                        >\n                        <a-select-option\n                          v-for=\"ward in wards\"\n                          :value=\"ward.org_id\"\n                          :key=\"ward.id\"\n                          >{{ ward.name }}</a-select-option\n                        >\n                      </a-select>\n                    </a-form-item>\n\n                    <a-form-item name=\"location_id\" label=\"Location\">\n                      <a-select\n                        size=\"large\"\n                        name=\"basic-select\"\n                        class=\"sDash_fullwidth-select\"\n                        placeholder=\"Select Location\"\n                        v-model:value=\"formState.location_id\"\n                      >\n                        <a-select-option value=\"\"\n                          >Select an option</a-select-option\n                        >\n                        <a-select-option\n                          v-for=\"location in locations\"\n                          :value=\"location.org_id\"\n                          :key=\"location.id\"\n                          >{{ location.name }}</a-select-option\n                        >\n                      </a-select>\n                    </a-form-item>\n\n                    <a-form-item name=\"name\" label=\"Sub Location Name\">\n                      <a-input\n                        v-model:value=\"formState.name\"\n                        placeholder=\"Enter Sub Location name\"\n                      />\n                    </a-form-item>\n                    <!-- <a-form-item label=\"Sub-location\">\n                      <div\n                        v-for=\"(subLocation, index) in formState.subLocations\"\n                        :key=\"index\"\n                      >\n                        <a-input\n                          v-model:value=\"formState.subLocations[index]\"\n                          placeholder=\"Enter sub-location name\"\n                        />\n                      </div>\n                      <a-button type=\"success\" @click.prevent=\"addSubLocation\"\n                        >Add Sub-Location</a-button\n                      >\n                    </a-form-item>\n                    <a-form-item>\n                      <a-button type=\"success\" @click.prevent=\"submitForm\"\n                        >Submit</a-button\n                      >\n                    </a-form-item> -->\n\n                    <div class=\"record-form-actions text-right\">\n                      <sdButton size=\"default\" htmlType=\"Save\" type=\"success\">\n                        {{ isLoading ? \"Loading...\" : \"Submit\" }}\n                      </sdButton>\n                    </div>\n                  </a-form>\n                </BasicFormWrapper>\n              </a-col>\n            </a-row>\n          </sdCards>\n        </RecordFormWrapper>\n      </a-col>\n    </a-row>\n  </Main>\n</template>\n<script>\nimport { RecordFormWrapper } from \"./style\";\nimport { Main, BasicFormWrapper } from \"../../styled\";\nimport { useStore } from \"vuex\";\nimport { reactive, ref, defineComponent, computed, onMounted } from \"vue\";\n// import axios from \"axios\";\nimport { notification } from \"ant-design-vue\";\nimport authHeader from \"../../../services/auth-header\";\n\nconst dateFormat = \"YYYY-MM-DD\";\n\nconst AddNew = defineComponent({\n  name: \"AddNew\",\n  components: { RecordFormWrapper, Main, BasicFormWrapper },\n  data() {\n    const { state } = useStore();\n    const isLoading = computed(() => state.crud.loading);\n    const apiUrl = computed(() => state.crud.url);\n    const isFileLoading = computed(() => state.crud.fileLoading);\n    const join = ref(\"\");\n    const API_URL = `${process.env.VUE_APP_BASE_URL}/ouCreation?unit=sub-location`;\n\n    const formState = reactive({\n      name: \"\",\n      ward_id: \"\",\n      // subLocations: [],\n    });\n\n    const { counties, loading, sub_counties, wards, locations } = reactive({\n      counties: [],\n      loading: true,\n      sub_counties: [],\n      wards: [],\n      locations: [],\n    });\n\n    //counties\n    const getCounties = async () => {\n      const response = await fetch(`${process.env.VUE_APP_BASE_URL}/counties`, {\n        method: \"GET\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          ...authHeader(),\n        },\n      });\n\n      const data = await response.json();\n      this.counties = data.map((county) => ({\n        ...county,\n        // org_id: county.org_id,\n      }));\n      this.loading = false;\n    };\n\n    onMounted(() => {\n      getCounties();\n      getSubCounties();\n    });\n\n    // sub_county\n\n    const getSubCounties = async (org_id) => {\n      const response = await fetch(\n        `${process.env.VUE_APP_BASE_URL}/get_sub_counties_list?parent_id=${org_id}`,\n        {\n          method: \"GET\",\n          headers: {\n            \"Content-Type\": \"application/json\",\n            ...authHeader(),\n          },\n        }\n      );\n      const data = await response.json();\n      console.log(data);\n      this.sub_counties = data.message;\n    };\n\n    //wards\n    const getWards = async (org_id) => {\n      const response = await fetch(\n        `${process.env.VUE_APP_BASE_URL}/get_sub_counties_list?parent_id=${org_id}`,\n        {\n          method: \"GET\",\n          headers: {\n            \"Content-Type\": \"application/json\",\n            ...authHeader(),\n          },\n        }\n      );\n      const data = await response.json();\n      console.log(data);\n      this.wards = data.message;\n    };\n\n    const getLocations = async (org_id) => {\n      console.log(org_id);\n      const response = await fetch(\n        `${process.env.VUE_APP_BASE_URL}/get_sub_counties_list?parent_id=${org_id}`,\n        {\n          method: \"GET\",\n          headers: {\n            \"Content-Type\": \"application/json\",\n            ...authHeader(),\n          },\n        }\n      );\n      const data = await response.json();\n      console.log(data);\n      this.locations = data.message;\n    };\n\n    const handleSubmit = (values) => {\n      console.log(\" values from the form submitted\");\n      console.log(values.location_id);\n      console.log(values);\n\n      const data = {\n        parent_id: values.location_id,\n        data: [\n          {\n            name: values.name,\n          },\n        ],\n      };\n      console.log(API_URL);\n\n      fetch(API_URL, {\n        method: \"POST\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          ...authHeader(),\n        },\n        body: JSON.stringify(data),\n      })\n        .then((response) => response.json())\n        .then(({ success }) => {\n          if (success) {\n            // router.push(\"activity-view\");\n            notification[\"success\"]({\n              message: \"Sub Location Created\",\n              description: `Sub Location Created successfully`, //${data.activity_code}\n              duration: 5.5,\n            });\n          }\n        })\n        .catch((error) => {\n          console.error(\"Error:\", error);\n        });\n    };\n\n    return {\n      isLoading,\n      loading,\n      apiUrl,\n      isFileLoading,\n      handleSubmit,\n      dateFormat,\n      formState,\n      join,\n      counties,\n      sub_counties,\n      locations,\n      wards,\n      getSubCounties,\n      getLocations,\n      getWards,\n    };\n  },\n  beforeRouteEnter(to, from, next) {\n    if (!sessionStorage.getItem(\"user\")) {\n      next(\"/auth/login\");\n    } else {\n      next();\n    }\n  },\n  // methods: {\n  //   addSubLocation() {\n  //     this.formState.subLocations.push(\"\");\n  //   },\n  // },\n});\n\nexport default AddNew;\n</script>\n"],"mappings":";;AAmJA,SAASA,iBAAgB,QAAS,SAAS;AAC3C,SAASC,IAAI,EAAEC,gBAAe,QAAS,cAAc;AACrD,SAASC,QAAO,QAAS,MAAM;AAC/B,SAASC,QAAQ,EAAEC,GAAG,EAAEC,eAAe,EAAEC,QAAQ,EAAEC,SAAQ,QAAS,KAAK;AACzE;;AAEA,OAAOC,UAAS,MAAO,+BAA+B;AAEtD,MAAMC,UAAS,GAAI,YAAY;AAE/B,MAAMC,MAAK,GAAIL,eAAe,CAAC;EAC7BM,IAAI,EAAE,QAAQ;EACdC,UAAU,EAAE;IAAEb,iBAAiB;IAAEC,IAAI;IAAEC;EAAiB,CAAC;EACzDY,IAAIA,CAAA,EAAG;IACL,MAAM;MAAEC;IAAM,IAAIZ,QAAQ,EAAE;IAC5B,MAAMa,SAAQ,GAAIT,QAAQ,CAAC,MAAMQ,KAAK,CAACE,IAAI,CAACC,OAAO,CAAC;IACpD,MAAMC,MAAK,GAAIZ,QAAQ,CAAC,MAAMQ,KAAK,CAACE,IAAI,CAACG,GAAG,CAAC;IAC7C,MAAMC,aAAY,GAAId,QAAQ,CAAC,MAAMQ,KAAK,CAACE,IAAI,CAACK,WAAW,CAAC;IAC5D,MAAMC,IAAG,GAAIlB,GAAG,CAAC,EAAE,CAAC;IACpB,MAAMmB,OAAM,GAAK,GAAEC,OAAO,CAACC,GAAG,CAACC,gBAAiB,+BAA8B;IAE9E,MAAMC,SAAQ,GAAIxB,QAAQ,CAAC;MACzBQ,IAAI,EAAE,EAAE;MACRiB,OAAO,EAAE;MACT;IACF,CAAC,CAAC;;IAEF,MAAM;MAAEC,QAAQ;MAAEZ,OAAO;MAAEa,YAAY;MAAEC,KAAK;MAAEC;IAAU,IAAI7B,QAAQ,CAAC;MACrE0B,QAAQ,EAAE,EAAE;MACZZ,OAAO,EAAE,IAAI;MACba,YAAY,EAAE,EAAE;MAChBC,KAAK,EAAE,EAAE;MACTC,SAAS,EAAE;IACb,CAAC,CAAC;;IAEF;IACA,MAAMC,WAAU,GAAI,MAAAA,CAAA,KAAY;MAC9B,MAAMC,QAAO,GAAI,MAAMC,KAAK,CAAE,GAAEX,OAAO,CAACC,GAAG,CAACC,gBAAiB,WAAU,EA