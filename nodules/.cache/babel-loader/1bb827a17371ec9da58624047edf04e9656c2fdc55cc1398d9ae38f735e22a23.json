{"ast":null,"code":"import { defineComponent, toRefs } from 'vue';\nimport Styled from 'vue3-styled-components';\nconst CardWrapper = Styled.figure`\n  background: #fff;\n  padding: 25px;\n  border-radius: 10px;\n  margin-bottom: 0;\n  figcaption {\n    h2 {\n      margin: 18px 0 10px 0;\n      font-size: 18px;\n      font-weight: 600;\n    }\n    p {\n      line-height: 1.79;\n      color: ${({\n  theme\n}) => theme['gray-color']};\n    }\n    a {\n      color: ${({\n  theme\n}) => theme['primary-color']};\n      font-size: 15px;\n      font-weight: 600;\n    }\n  }\n`;\nimport VueTypes from 'vue-types';\nexport default defineComponent({\n  name: 'SampleCardTwo',\n  components: {\n    CardWrapper\n  },\n  props: {\n    item: VueTypes.object.def({\n      id: 1,\n      title: 'Technology Change the World',\n      content: 'Lorem Ipsum is simply dummy text of the printer took a galley of type and scrambled',\n      img: 'static/img/sampleCards/1.png'\n    })\n  },\n  setup(props) {\n    const {\n      item\n    } = toRefs(props);\n    const {\n      id,\n      title,\n      content,\n      img\n    } = item.value;\n    return {\n      id,\n      title,\n      content,\n      img\n    };\n  }\n});","map":{"version":3,"names":["defineComponent","toRefs","Styled","CardWrapper","figure","theme","VueTypes","name","components","props","item","object","def","id","title","content","img","setup","value"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/components/cards/sampleCard/SampleCardTwo.vue"],"sourcesContent":["<template>\r\n  <CardWrapper>\r\n    <img :src=\"require(`../../../${img}`)\" alt=\"\" />\r\n    <figcaption>\r\n      <h2>{{ title }}</h2>\r\n      <p>{{ content }}</p>\r\n      <router-link to=\"#\">Learn More</router-link>\r\n    </figcaption>\r\n  </CardWrapper>\r\n</template>\r\n\r\n<script>\r\nimport { defineComponent, toRefs } from 'vue';\r\nimport Styled from 'vue3-styled-components';\r\nconst CardWrapper = Styled.figure`\r\n  background: #fff;\r\n  padding: 25px;\r\n  border-radius: 10px;\r\n  margin-bottom: 0;\r\n  figcaption {\r\n    h2 {\r\n      margin: 18px 0 10px 0;\r\n      font-size: 18px;\r\n      font-weight: 600;\r\n    }\r\n    p {\r\n      line-height: 1.79;\r\n      color: ${({ theme }) => theme['gray-color']};\r\n    }\r\n    a {\r\n      color: ${({ theme }) => theme['primary-color']};\r\n      font-size: 15px;\r\n      font-weight: 600;\r\n    }\r\n  }\r\n`;\r\nimport VueTypes from 'vue-types';\r\nexport default defineComponent({\r\n  name: 'SampleCardTwo',\r\n  components: { CardWrapper },\r\n  props: {\r\n    item: VueTypes.object.def({\r\n      id: 1,\r\n      title: 'Technology Change the World',\r\n      content: 'Lorem Ipsum is simply dummy text of the printer took a galley of type and scrambled',\r\n      img: 'static/img/sampleCards/1.png',\r\n    }),\r\n  },\r\n  setup(props) {\r\n    const { item } = toRefs(props);\r\n    const { id, title, content, img } = item.value;\r\n    return { id, title, content, img };\r\n  },\r\n});\r\n</script>\r\n"],"mappings":"AAYA,SAASA,eAAe,EAAEC,MAAK,QAAS,KAAK;AAC7C,OAAOC,MAAK,MAAO,wBAAwB;AAC3C,MAAMC,WAAU,GAAID,MAAM,CAACE,MAAM;;;;;;;;;;;;;eAalB,CAAC;EAAEC;AAAM,CAAC,KAAKA,KAAK,CAAC,YAAY,CAAE;;;eAGnC,CAAC;EAAEA;AAAM,CAAC,KAAKA,KAAK,CAAC,eAAe,CAAE;;;;;AAKrD,CAAC;AACD,OAAOC,QAAO,MAAO,WAAW;AAChC,eAAeN,eAAe,CAAC;EAC7BO,IAAI,EAAE,eAAe;EACrBC,UAAU,EAAE;IAAEL;EAAY,CAAC;EAC3BM,KAAK,EAAE;IACLC,IAAI,EAAEJ,QAAQ,CAACK,MAAM,CAACC,GAAG,CAAC;MACxBC,EAAE,EAAE,CAAC;MACLC,KAAK,EAAE,6BAA6B;MACpCC,OAAO,EAAE,qFAAqF;MAC9FC,GAAG,EAAE;IACP,CAAC;EACH,CAAC;EACDC,KAAKA,CAACR,KAAK,EAAE;IACX,MAAM;MAAEC;IAAK,IAAIT,MAAM,CAACQ,KAAK,CAAC;IAC9B,MAAM;MAAEI,EAAE;MAAEC,KAAK;MAAEC,OAAO;MAAEC;IAAI,IAAIN,IAAI,CAACQ,KAAK;IAC9C,OAAO;MAAEL,EAAE;MAAEC,KAAK;MAAEC,OAAO;MAAEC;IAAI,CAAC;EACpC;AACF,CAAC,CAAC"},"metadata":{},"sourceType":"module","externalDependencies":[]}