  const fetchFacilitators = async () => {\n      const response = await fetch(facilitator_url, {\n        method: \"GET\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          ...authHeader()\n        }\n      });\n      const data = await response.json();\n      this.facilitators = data.data;\n      console.log(data.data);\n      this.loading = false;\n    };\n    fetchFacilitators();\n    const fetchTrainer = async () => {\n      const response = await fetch(trainer_url, {\n        method: \"GET\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          ...authHeader()\n        }\n      });\n      const data = await response.json();\n      this.facilitators = data.data;\n      console.log(data.data);\n      this.loading = false;\n    };\n    fetchTrainer();\n    const handleSubmit = () => {\n      const data = {\n        name: formState.name,\n        user_id: 1,\n        // replace with the logged-in user's ID\n        venue: formState.venue,\n        location_id: 1,\n        // replace with the actual location ID\n        campaign_id: formState.campaign_id,\n        facilitator: formState.facilitator_id,\n        trainers: formState.trainer_id\n      };\n      console.log(data);\n      fetch(API_URL, {\n        method: \"POST\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          ...authHeader()\n        },\n        body: JSON.stringify(data)\n      }).then(response => response.json()).then(({\n        success,\n        data\n      }) => {\n        // console.log(data);\n        if (success) {\n          router.push(\"event-view\");\n          _notification[\"success\"]({\n            message: \"Event Created\",\n            description: `Event Created successfully. Your event code is ${data.event.event_code}`,\n            duration: 5.5\n          });\n        }\n      }).catch(error => {\n        console.error(\"Error:\", error);\n      });\n    };\n    const formState = reactive({\n      name: null,\n      user_id: null,\n      venue: \"\",\n      location_id: null,\n      campaign_id: null,\n      facilitator_id: \"\",\n      trainer_id: []\n    });\n    console.log(formState);\n    return {\n      isLoading,\n      apiUrl,\n      isFileLoading,\n      join,\n      handleSubmit,\n      formState,\n      campaigns,\n      facilitators,\n      loading\n    };\n  },\n  beforeRouteEnter(to, from, next) {\n    if (!sessionStorage.getItem(\"user\")) {\n      next(\"/auth/login\");\n    } else {\n      next();\n    }\n  }\n});\nexport default AddNew;","map":{"version":3,"names":["RecordFormWrapper","Main","BasicFormWrapper","useStore","reactive","ref","defineComponent","computed","authHeader","useRouter","AddNew","name","components","data","state","isLoading","crud","loading","apiUrl","url","isFileLoading","fileLoading","join","router","API_URL","process","env","VUE_APP_BASE_URL","campaign_url","facilitator_url","trainer_url","campaigns","facilitators","fetchCampaigns","response","fetch","method","headers","json","console","log","fetchFacilitators","fetchTrainer","handleSubmit","formState","user_id","venue","location_id","campaign_id","facilitator","facilitator_id","trainers","trainer_id","body","JSON","stringify","then","success","push","_notification","message","description","event","event_code","duration","catch","error","beforeRouteEnter","to","from","next","sessionStorage","getItem"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/pages/events/createEvent.vue"],"sourcesContent":["<template>\n  <sdPageHeader title=\"Create Event\">\n    <sdButton class=\"btn-add_new\" size=\"default\" key=\"1\" type=\"success\">\n      <router-link to=\"/crud/axios-view\">View All</router-link>\n    </sdButton>\n  </sdPageHeader>\n  <Main>\n    <a-row :gutter=\"15\">\n      <a-col :xs=\"24\">\n        <RecordFormWrapper>\n          <sdCards headless>\n            <a-row justify=\"center\">\n              <a-col :xl=\"10\" :md=\"16\" :xs=\"24\">\n                <BasicFormWrapper>\n                  <a-form\n                    class=\"add-record-form\"\n                    :style=\"{ width: '100%' }\"\n                    layout=\"vertical\"\n                    name=\"addnew\"\n                    :model=\"formState\"\n                    @finish=\"handleSubmit\"\n                  >\n                    <a-form-item name=\"campaign_id\" label=\"Campaign Name\">\n                      <a-select\n                        v-model:value=\"formState.campaign_id\"\n                        v-if=\"!loading\"\n                        placeholder=\"Select Campaign Name\"\n                      >\n                        <a-select-option\n                          v-for=\"campaign in campaigns\"\n                          :key=\"campaign.id\"\n                          :value=\"campaign.id\"\n                        >\n                          {{ campaign.name }}\n                        </a-select-option>\n                      </a-select>\n                    </a-form-item>\n                    <a-form-item label=\"Event Type\">\n                      <a-select\n                        size=\"large\"\n                        name=\"name\"\n                        class=\"sDash_fullwidth-select\"\n                        placeholder=\"Select Event Type\"\n                        v-model:value=\"formState.name\"\n                      >\n                        <a-select-option value=\"Stakeholder meeting\"\n                          >Stakeholder meeting</a-select-option\n                        >\n                        <a-select-option\n                          default-value=\"2\"\n                          value=\"Health Care Worker Training\"\n                          >Health Care Worker Training</a-select-option\n                        >\n                        <a-select-option value=\"CHV mobilization\"\n                          >CHV mobilization</a-select-option\n                        >\n                        <a-select-option value=\"Village Elder mobilization\"\n                          >Village Elder mobilization</a-select-option\n                        >\n                        <a-select-option value=\"CHV/VE Training\"\n                          >CHV/VE Training</a-select-option\n                        >\n                        <a-select-option value=\"Social mobilization\"\n                          >Social mobilization</a-select-option\n                        >\n                      </a-select>\n                    </a-form-item>\n                    <a-form-item name=\"facilitator_id\" label=\"Host\">\n                      <a-select\n                        v-model:value=\"formState.facilitator_id\"\n                        v-if=\"!loading\"\n                        placeholder=\"Select Host\"\n                      >\n                        <!-- select facilitator option  -->\n                        <!-- <a-select-option>Select Facilitator</a-select-option> -->\n                        <a-select-option\n                          v-for=\"facilitator in facilitators\"\n                          :key=\"facilitator.id\"\n                          v-model:value=\"facilitator.id\"\n                        >\n                          {{ facilitator.first_name }}\n                          {{ facilitator.last_name }} - {{ facilitator.phone_no }}\n                        </a-select-option>\n                      </a-select>\n                    </a-form-item>\n\n                    <a-form-item label=\"Facilitators\">\n                      <a-select\n                        mode=\"multiple\"\n                        v-model:value=\"formState.trainer_id\"\n                        v-if=\"!loading\"\n                        placeholder=\"Select at-most two facilitators\"\n                      >\n                        <a-select-option\n                          v-for=\"trainer in facilitators\"\n                          :key=\"trainer.id\"\n                          :value=\"trainer.id\"\n                        >\n                          {{ trainer.first_name }}\n                          {{ trainerlast_name }} - {{ trainer.id_no }}\n                        </a-select-option>\n                      </a-select>\n                    </a-form-item>\n\n                    <a-form-item name=\"venue\" label=\"Event Venue\">\n                      <a-input\n                        v-model:value=\"formState.venue\"\n                        placeholder=\"Input Event Venue\"\n                      />\n                    </a-form-item>\n\n                    <div class=\"record-form-actions text-right\">\n                      <sdButton size=\"default\" htmlType=\"Save\" type=\"success\">\n                        {{ isLoading ? \"Loading...\" : \"Submit\" }}\n                      </sdButton>\n                    </div>\n                  </a-form>\n                </BasicFormWrapper>\n              </a-col>\n            </a-row>\n          </sdCards>\n        </RecordFormWrapper>\n      </a-col>\n    </a-row>\n  </Main>\n</template>\n\n<script>\nimport { RecordFormWrapper } from \"./style\";\nimport { Main, BasicFormWrapper } from \"../../styled\";\nimport { useStore } from \"vuex\";\nimport { reactive, ref, defineComponent, computed } from \"vue\";\n// import axios from \"axios\";\nimport authHeader from \"../../../services/auth-header\";\nimport { notification } from \"ant-design-vue\";\nimport { useRouter } from \"vue-router\";\n\n// import Select from 'vue-select';\n\n// const dateFormat = \"YYYY-MM-DD\";\n\n// testing app\n\nconst AddNew = defineComponent({\n  name: \"AddNew\",\n  components: { RecordFormWrapper, Main, BasicFormWrapper },\n\n  data() {\n    const { state } = useStore();\n\n    const isLoading = computed(() => state.crud.loading);\n    const apiUrl = computed(() => state.crud.url);\n    const isFileLoading = computed(() => state.crud.fileLoading);\n    const join = ref(\"\");\n\n    const router = useRouter();\n\n    const API_URL = `${process.env.VUE_APP_BASE_URL}/event/with_facilitator`;\n\n    const campaign_url = `${process.env.VUE_APP_BASE_URL}/campaign_all`;\n\n    const facilitator_url = `${process.env.VUE_APP_BASE_URL}/users`;\n\n    const trainer_url = `${process.env.VUE_APP_BASE_URL}/users`;\n\n    const { campaigns, facilitators, loading } = reactive({\n      campaigns: \"\",\n      loading: true, // setCampaigns: () => {},\n      facilitators: [],\n      // setFacilitator: () => {},\n    });\n\n    const fetchCampaigns = async () => {\n      const response = await fetch(campaign_url, {\n        method: \"GET\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          ...authHeader(),\n        },\n      });\n      const data = await response.json();\n      this.campaigns = data.data;\n      console.log(this.campaigns);\n      this.loading = false;\n    };\n    fetchCampaigns();\n\n    const fetchFacilitators = async () => {\n      const response = await fetch(facilitator_url, {\n        method: \"GET\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          ...authHeader(),\n        },\n      });\n      const data = await response.json();\n      this.facilitators = data.data;\n      console.log(data.data);\n      this.loading = false;\n    };\n    fetchFacilitators();\n\n    const fetchTrainer = async () => {\n      const response = await fetch(trainer_url, {\n        method: \"GET\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          ...authHeader(),\n        },\n      });\n      const data = await response.json();\n      this.facilitators = data.data;\n      console.log(data.data);\n      this.loading = false;\n    };\n    fetchTrainer();\n\n    const handleSubmit = () => {\n      const data = {\n        name: formState.name,\n        user_id: 1, // replace with the logged-in user's ID\n        venue: formState.venue,\n        location_id: 1, // replace with the actual location ID\n        campaign_id: formState.campaign_id,\n        facilitator: formState.facilitator_id,\n        trainers: formState.trainer_id,\n      };\n\n      console.log(data);\n\n      fetch(API_URL, {\n        method: \"POST\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          ...authHeader(),\n        },\n        body: JSON.stringify(data),\n      })\n        .then((response) => response.json())\n        .then(({ success, data }) => {\n          // console.log(data);\n          if (success) {\n            router.push(\"event-view\");\n            notification[\"success\"]({\n              message: \"Event Created\",\n              description: `Event Created successfully. Your event code is ${data.event.event_code}`,\n              duration: 5.5,\n            });\n          }\n        })\n        .catch((error) => {\n          console.error(\"Error:\", error);\n        });\n    };\n\n    const formState = reactive({\n      name: null,\n      user_id: null,\n      venue: \"\",\n      location_id: null,\n      campaign_id: null,\n      facilitator_id: \"\",\n      trainer_id: [],\n    });\n\n    console.log(formState);\n\n    return {\n      isLoading,\n      apiUrl,\n      isFileLoading,\n      join,\n      handleSubmit,\n      formState,\n      campaigns,\n      facilitators,\n      loading,\n    };\n  },\n  beforeRouteEnter(to, from, next) {\n    if (!sessionStorage.getItem(\"user\")) {\n      next(\"/auth/login\");\n    } else {\n      next();\n    }\n  },\n});\n\nexport default AddNew;\n</script>\n"],"mappings":";;;AAgIA,SAASA,iBAAgB,QAAS,SAAS;AAC3C,SAASC,IAAI,EAAEC,gBAAe,QAAS,cAAc;AACrD,SAASC,QAAO,QAAS,MAAM;AAC/B,SAASC,QAAQ,EAAEC,GAAG,EAAEC,eAAe,EAAEC,QAAO,QAAS,KAAK;AAC9D;AACA,OAAOC,UAAS,MAAO,+BAA+B;AAEtD,SAASC,SAAQ,QAAS,YAAY;;AAEtC;;AAEA;;AAEA;;AAEA,MAAMC,MAAK,GAAIJ,eAAe,CAAC;EAC7BK,IAAI,EAAE,QAAQ;EACdC,UAAU,EAAE;IAAEZ,iBAAiB;IAAEC,IAAI;IAAEC;EAAiB,CAAC;EAEzDW,IAAIA,CAAA,EAAG;IACL,MAAM;MAAEC;IAAM,IAAIX,QAAQ