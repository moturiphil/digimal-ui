{"ast":null,"code":"import { ProductCard } from '../../Style';\nimport PropTypes from 'vue-types';\nimport { toRefs, computed, defineComponent } from 'vue';\nimport { useStore } from 'vuex';\nimport { useRoute } from 'vue-router';\nconst ProductCards = defineComponent({\n  name: 'ProductCards',\n  components: {\n    ProductCard\n  },\n  props: {\n    product: PropTypes.object\n  },\n  setup(props) {\n    const {\n      dispatch,\n      state\n    } = useStore();\n    const isLoader = computed(() => state.ecommerce.isProductLoading);\n    const {\n      product\n    } = toRefs(props);\n    const renderData = computed(() => product.value);\n    const {\n      matched\n    } = useRoute();\n    const addWishList = value => {\n      dispatch('updateWishList', value);\n    };\n    return {\n      dispatch,\n      renderData,\n      isLoader,\n      matched,\n      addWishList\n    };\n  }\n});\nexport default ProductCards;","map":{"version":3,"names":["ProductCard","PropTypes","toRefs","computed","defineComponent","useStore","useRoute","ProductCards","name","components","props","product","object","setup","dispatch","state","isLoader","ecommerce","isProductLoading","renderData","value","matched","addWishList"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/pages/net-distribution/product/overview/ProductCards.vue"],"sourcesContent":["<template>\r\n  <div class=\"spin\" v-if=\"isLoader\"><a-spin /></div>\r\n  <ProductCard v-else style=\"margin-bottom: 30px\">\r\n    <figure>\r\n      <img :src=\"require(`../../../../../${renderData.img}`)\" :alt=\"`img${renderData.id}`\" />\r\n    </figure>\r\n    <figcaption>\r\n      <a @click=\"() => addWishList(renderData.id)\" class=\"btn-heart\" to=\"#\">\r\n        <sdFeatherIcons\r\n          type=\"heart\"\r\n          size=\"14\"\r\n          :color=\"renderData.popular ? '#FF4D4F' : '#9299B8'\"\r\n          :fill=\"renderData.popular ? '#FF4D4F' : 'none'\"\r\n        />\r\n      </a>\r\n      <sdHeading class=\"product-single-title\" as=\"h5\">\r\n        <router-link :to=\"`${matched[1].path}/ecommerce/productDetails/${renderData.id}`\">{{\r\n          renderData.name\r\n        }}</router-link>\r\n      </sdHeading>\r\n      <p class=\"product-single-price\">\r\n        <span class=\"product-single-price__new\">${{ renderData.price }} </span>\r\n\r\n        <template v-if=\"renderData.oldPrice\">\r\n          <del class=\"product-single-price__old\"> ${{ renderData.oldPrice }} </del>\r\n          <span class=\"product-single-price__offer\"> 60% Off</span>\r\n        </template>\r\n      </p>\r\n      <div class=\"product-single-rating\">\r\n        <a-rate allow-half :default-value=\"renderData.rate\" disabled /> 4.9\r\n        <span class=\"total-reviews\"> 778 Reviews</span>\r\n      </div>\r\n\r\n      <div class=\"product-single-action\">\r\n        <sdButton size=\"small\" type=\"white\" class=\"btn-cart\" outlined>\r\n          <sdFeatherIcons type=\"shopping-bag\" size=\"14\" />\r\n          <span>Add To Cart</span>\r\n        </sdButton>\r\n        <sdButton size=\"small\" type=\"primary\"> Buy Now </sdButton>\r\n      </div>\r\n    </figcaption>\r\n  </ProductCard>\r\n</template>\r\n<script>\r\nimport { ProductCard } from '../../Style';\r\nimport PropTypes from 'vue-types';\r\nimport { toRefs, computed, defineComponent } from 'vue';\r\nimport { useStore } from 'vuex';\r\nimport { useRoute } from 'vue-router';\r\n\r\nconst ProductCards = defineComponent({\r\n  name: 'ProductCards',\r\n  components: { ProductCard },\r\n  props: {\r\n    product: PropTypes.object,\r\n  },\r\n  setup(props) {\r\n    const { dispatch, state } = useStore();\r\n    const isLoader = computed(() => state.ecommerce.isProductLoading);\r\n    const { product } = toRefs(props);\r\n    const renderData = computed(() => product.value);\r\n    const { matched } = useRoute();\r\n    const addWishList = (value) => {\r\n      dispatch('updateWishList', value);\r\n    };\r\n\r\n    return {\r\n      dispatch,\r\n      renderData,\r\n      isLoader,\r\n      matched,\r\n      addWishList,\r\n    };\r\n  },\r\n});\r\n\r\nexport default ProductCards;\r\n</script>\r\n"],"mappings":"AA4CA,SAASA,WAAU,QAAS,aAAa;AACzC,OAAOC,SAAQ,MAAO,WAAW;AACjC,SAASC,MAAM,EAAEC,QAAQ,EAAEC,eAAc,QAAS,KAAK;AACvD,SAASC,QAAO,QAAS,MAAM;AAC/B,SAASC,QAAO,QAAS,YAAY;AAErC,MAAMC,YAAW,GAAIH,eAAe,CAAC;EACnCI,IAAI,EAAE,cAAc;EACpBC,UAAU,EAAE;IAAET;EAAY,CAAC;EAC3BU,KAAK,EAAE;IACLC,OAAO,EAAEV,SAAS,CAACW;EACrB,CAAC;EACDC,KAAKA,CAACH,KAAK,EAAE;IACX,MAAM;MAAEI,QAAQ;MAAEC;IAAM,IAAIV,QAAQ,EAAE;IACtC,MAAMW,QAAO,GAAIb,QAAQ,CAAC,MAAMY,KAAK,CAACE,SAAS,CAACC,gBAAgB,CAAC;IACjE,MAAM;MAAEP;IAAQ,IAAIT,MAAM,CAACQ,KAAK,CAAC;IACjC,MAAMS,UAAS,GAAIhB,QAAQ,CAAC,MAAMQ,OAAO,CAACS,KAAK,CAAC;IAChD,MAAM;MAAEC;IAAQ,IAAIf,QAAQ,EAAE;IAC9B,MAAMgB,WAAU,GAAKF,KAAK,IAAK;MAC7BN,QAAQ,CAAC,gBAAgB,EAAEM,KAAK,CAAC;IACnC,CAAC;IAED,OAAO;MACLN,QAAQ;MACRK,UAAU;MACVH,QAAQ;MACRK,OAAO;MACPC;IACF,CAAC;EACH;AACF,CAAC,CAAC;AAEF,eAAef,YAAY"},"metadata":{},"sourceType":"module","externalDependencies":[]}