{"ast":null,"code":"import { CardBarChart2, EChartCard } from './style';\nimport Chart from '../../components/utilities/chartjs';\nimport { Main } from '../styled';\nimport { defineAsyncComponent } from 'vue';\nconst TotalRevenue = defineAsyncComponent(() => import('./overview/ecommerce/TotalRevenue'));\nconst ClosedDeals = defineAsyncComponent(() => import('./overview/crm/ClosedDeals'));\nconst EmailSent = defineAsyncComponent(() => import('./overview/crm/EmailSent'));\nconst SalesLeaderBoard = defineAsyncComponent(() => import('./overview/crm/SalesLeaderboard'));\nconst RecentDeals = defineAsyncComponent(() => import('./overview/crm/RecentDeals'));\nconst chartOptions = {\n  legend: {\n    display: false,\n    labels: {\n      display: false\n    }\n  },\n  scales: {\n    yAxes: [{\n      stacked: true,\n      gridLines: {\n        display: false\n      },\n      ticks: {\n        display: false\n      }\n    }],\n    xAxes: [{\n      stacked: true,\n      gridLines: {\n        display: false\n      },\n      ticks: {\n        display: false\n      }\n    }]\n  }\n};\nconst Ecommerce = {\n  name: 'CRM',\n  components: {\n    Main,\n    CardBarChart2,\n    EChartCard,\n    Chart,\n    TotalRevenue,\n    ClosedDeals,\n    EmailSent,\n    SalesLeaderBoard,\n    RecentDeals\n  },\n  setup() {\n    return {\n      chartOptions\n    };\n  }\n};\nexport default Ecommerce;","map":{"version":3,"names":["CardBarChart2","EChartCard","Chart","Main","defineAsyncComponent","TotalRevenue","ClosedDeals","EmailSent","SalesLeaderBoard","RecentDeals","chartOptions","legend","display","labels","scales","yAxes","stacked","gridLines","ticks","xAxes","Ecommerce","name","components","setup"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/dashboard/CRM.vue"],"sourcesContent":["<template>\r\n  <sdPageHeader title=\"CRM Dashboard\">\r\n    <template v-slot:buttons>\r\n      <div class=\"page-header-actions\">\r\n        <sdCalendarButton />\r\n        <sdExportButton />\r\n        <sdShareButton />\r\n        <sdButton size=\"small\" type=\"primary\">\r\n          <sdFeatherIcons type=\"plus\" size=\"14\" />\r\n          Add New\r\n        </sdButton>\r\n      </div>\r\n    </template>\r\n  </sdPageHeader>\r\n  <Main>\r\n    <a-row :gutter=\"25\">\r\n      <a-col :xxl=\"6\" :md=\"12\" :sm=\"12\" :xs=\"24\">\r\n        <sdCards headless>\r\n          <EChartCard>\r\n            <div class=\"card-chunk\">\r\n              <CardBarChart2>\r\n                <sdHeading as=\"h1\">7,461</sdHeading>\r\n                <span>Orders</span>\r\n                <p>\r\n                  <span class=\"growth-upward\"> <sdFeatherIcons type=\"arrow-up\" /> 25% </span>\r\n                  <span>Since last week</span>\r\n                </p>\r\n              </CardBarChart2>\r\n            </div>\r\n            <div class=\"card-chunk\">\r\n              <Chart\r\n                class=\"growth\"\r\n                :height=\"180\"\r\n                :labels=\"['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul']\"\r\n                :style=\"{\r\n                  marginBottom: '-5',\r\n                }\"\r\n                :datasets=\"[\r\n                  {\r\n                    data: [20, 60, 50, 45, 50, 60, 70],\r\n                    backgroundColor: '#EFEFFE',\r\n                    hoverBackgroundColor: '#5F63F2',\r\n                    label: 'Orders',\r\n                    barPercentage: 1,\r\n                  },\r\n                ]\"\r\n                :options=\"chartOptions\"\r\n              />\r\n            </div>\r\n          </EChartCard>\r\n        </sdCards>\r\n      </a-col>\r\n      <a-col :xxl=\"6\" :md=\"12\" :sm=\"12\" :xs=\"24\">\r\n        <sdCards headless>\r\n          <EChartCard>\r\n            <div class=\"card-chunk\">\r\n              <CardBarChart2>\r\n                <sdHeading as=\"h1\">$28,947</sdHeading>\r\n                <span>Revenue</span>\r\n                <p>\r\n                  <span class=\"growth-downward\"> <sdFeatherIcons type=\"arrow-down\" /> 25% </span>\r\n                  <span>Since last week</span>\r\n                </p>\r\n              </CardBarChart2>\r\n            </div>\r\n            <div class=\"card-chunk\">\r\n              <Chart\r\n                class=\"downward\"\r\n                :height=\"180\"\r\n                :labels=\"['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul']\"\r\n                :style=\"{\r\n                  marginBottom: '-5',\r\n                }\"\r\n                :datasets=\"[\r\n                  {\r\n                    data: [20, 60, 50, 45, 50, 60, 70],\r\n                    backgroundColor: '#FFF0F6',\r\n                    hoverBackgroundColor: '#FF69A5',\r\n                    label: 'Revenue',\r\n                    barPercentage: 1,\r\n                  },\r\n                ]\"\r\n                :options=\"chartOptions\"\r\n              />\r\n            </div>\r\n          </EChartCard>\r\n        </sdCards>\r\n      </a-col>\r\n\r\n      <a-col :xxl=\"6\" :md=\"12\" :sm=\"12\" :xs=\"24\">\r\n        <sdCards headless>\r\n          <EChartCard>\r\n            <div class=\"card-chunk\">\r\n              <CardBarChart2>\r\n                <sdHeading as=\"h1\">$3,241</sdHeading>\r\n                <span>Avg. order value</span>\r\n                <p>\r\n                  <span class=\"growth-upward\"> <sdFeatherIcons type=\"arrow-up\" /> 25% </span>\r\n                  <span>Since last week</span>\r\n                </p>\r\n              </CardBarChart2>\r\n            </div>\r\n            <div class=\"card-chunk\">\r\n              <Chart\r\n                class=\"upward\"\r\n                :height=\"180\"\r\n                :labels=\"['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul']\"\r\n                :style=\"{\r\n                  marginBottom: '-5',\r\n                }\"\r\n                :datasets=\"[\r\n                  {\r\n                    data: [20, 60, 50, 45, 50, 60, 70],\r\n                    backgroundColor: '#E8FAF4',\r\n                    hoverBackgroundColor: '#20C997',\r\n                    label: 'Avg Orders',\r\n                    barPercentage: 1,\r\n                  },\r\n                ]\"\r\n                :options=\"chartOptions\"\r\n              />\r\n            </div>\r\n          </EChartCard>\r\n        </sdCards>\r\n      </a-col>\r\n      <a-col :xxl=\"6\" :md=\"12\" :sm=\"12\" :xs=\"24\">\r\n        <sdCards headless>\r\n          <EChartCard>\r\n            <div class=\"card-chunk\">\r\n              <CardBarChart2>\r\n                <sdHeading as=\"h1\">45.2k</sdHeading>\r\n                <span>Unique visitors</span>\r\n                <p>\r\n                  <span class=\"growth-upward\"> <sdFeatherIcons type=\"arrow-up\" /> 25% </span>\r\n                  <span>Since last week</span>\r\n                </p>\r\n              </CardBarChart2>\r\n            </div>\r\n            <div class=\"card-chunk\">\r\n              <Chart\r\n                class=\"visitors\"\r\n                :height=\"180\"\r\n                :labels=\"['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul']\"\r\n                :style=\"{\r\n                  marginBottom: '-5',\r\n                }\"\r\n                :datasets=\"[\r\n                  {\r\n                    data: [20, 60, 50, 45, 50, 60, 70],\r\n                    backgroundColor: '#E9F5FF',\r\n                    hoverBackgroundColor: '#2C99FF',\r\n                    label: 'Visitors',\r\n                    barPercentage: 1,\r\n                  },\r\n                ]\"\r\n                :options=\"chartOptions\"\r\n              />\r\n            </div>\r\n          </EChartCard>\r\n        </sdCards>\r\n      </a-col>\r\n    </a-row>\r\n    <a-row :gutter=\"25\">\r\n      <a-col :xxl=\"16\" :xs=\"24\"\r\n        ><Suspense>\r\n          <template #default>\r\n            <TotalRevenue title=\"Revenue\" :chartHeight=\"88\" />\r\n          </template>\r\n          <template #fallback>\r\n            <sdCards headless>\r\n              <a-skeleton active />\r\n            </sdCards>\r\n          </template>\r\n        </Suspense>\r\n      </a-col>\r\n      <a-col :xxl=\"8\" :xs=\"24\"\r\n        ><Suspense>\r\n          <template #default>\r\n            <ClosedDeals />\r\n          </template>\r\n          <template #fallback>\r\n            <sdCards headless>\r\n              <a-skeleton active />\r\n            </sdCards>\r\n          </template>\r\n        </Suspense>\r\n      </a-col>\r\n      <a-col :xxl=\"8\" :xl=\"12\" :xs=\"24\"\r\n        ><Suspense>\r\n          <template #default>\r\n            <EmailSent />\r\n          </template>\r\n          <template #fallback>\r\n            <sdCards headless>\r\n              <a-skeleton active />\r\n            </sdCards>\r\n          </template>\r\n        </Suspense>\r\n      </a-col>\r\n      <a-col :xxl=\"8\" :xl=\"12\" :xs=\"24\"\r\n        ><Suspense>\r\n          <template #default>\r\n            <SalesLeaderBoard />\r\n          </template>\r\n          <template #fallback>\r\n            <sdCards headless>\r\n              <a-skeleton active />\r\n            </sdCards>\r\n          </template>\r\n        </Suspense>\r\n      </a-col>\r\n      <a-col :xxl=\"8\" :xs=\"24\"\r\n        ><Suspense>\r\n          <template #default>\r\n            <RecentDeals />\r\n          </template>\r\n          <template #fallback>\r\n            <sdCards headless>\r\n              <a-skeleton active />\r\n            </sdCards>\r\n          </template>\r\n        </Suspense>\r\n      </a-col>\r\n    </a-row>\r\n  </Main>\r\n</template>\r\n<script>\r\nimport { CardBarChart2, EChartCard } from './style';\r\nimport Chart from '../../components/utilities/chartjs';\r\nimport { Main } from '../styled';\r\nimport { defineAsyncComponent } from 'vue';\r\n\r\nconst TotalRevenue = defineAsyncComponent(() => import('./overview/ecommerce/TotalRevenue'));\r\nconst ClosedDeals = defineAsy