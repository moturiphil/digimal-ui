{"ast":null,"code":"import dayjs from 'dayjs';\nimport { ref, watch, defineComponent } from 'vue';\nimport { Main } from '../styled';\nexport default defineComponent({\n  name: 'TimePicker',\n  components: {\n    Main\n  },\n  setup() {\n    const value = ref();\n    const strValue = ref('09:00:00');\n    const open = ref(false);\n    const open2 = ref(false);\n    watch(strValue, () => {\n      //console.log(strValue.value);\n    });\n    const handleOpenChange = openStatus => {\n      //console.log('open', openStatus);\n      open.value = openStatus;\n    };\n    const handleClose = () => {\n      open.value = false;\n      open2.value = false;\n    };\n    return {\n      open,\n      open2,\n      strValue,\n      dayjs,\n      value,\n      value4: ref(undefined),\n      value1: ref(dayjs('12:08:23', 'HH:mm')),\n      value2: ref(dayjs('12:08:23', 'HH:mm')),\n      value3: ref(dayjs('12:08:23', 'HH:mm')),\n      handleOpenChange,\n      handleClose\n    };\n  }\n});","map":{"version":3,"names":["dayjs","ref","watch","defineComponent","Main","name","components","setup","value","strValue","open","open2","handleOpenChange","openStatus","handleClose","value4","undefined","value1","value2","value3"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/uiElements/TimePicker.vue"],"sourcesContent":["<template>\r\n  <div>\r\n    <sdPageHeader title=\"Time Picker\">\r\n      <template v-slot:buttons>\r\n        <div class=\"page-header-actions\">\r\n          <sdCalendarButton />\r\n          <sdExportButton />\r\n          <sdShareButton />\r\n          <sdButton size=\"small\" type=\"primary\">\r\n            <sdFeatherIcons type=\"plus\" size=\"14\" />\r\n            Add New\r\n          </sdButton>\r\n        </div>\r\n      </template>\r\n    </sdPageHeader>\r\n    <Main>\r\n      <a-row :gutter=\"25\">\r\n        <a-col :md=\"12\" :sm=\"24\" :xs=\"24\">\r\n          <sdCards title=\"Basic\">\r\n            <a-time-picker v-model:value=\"strValue\" valueFormat=\"HH:mm:ss\" />\r\n          </sdCards>\r\n          <sdCards title=\"Interval option\">\r\n            <a-time-picker v-model:value=\"value\" :minute-step=\"15\" :second-step=\"10\" />\r\n          </sdCards>\r\n          <sdCards title=\"Three Size\">\r\n            <div class=\"timepicker-list\">\r\n              <a-time-picker v-model:value=\"value1\" size=\"large\" :style=\"{ marginBottom: '10px' }\" />\r\n              <br />\r\n              <a-time-picker v-model:value=\"value2\" :style=\"{ marginBottom: '10px' }\" /> <br />\r\n              <a-time-picker v-model:value=\"value3\" size=\"small\" />\r\n            </div>\r\n          </sdCards>\r\n          <sdCards title=\"Addon\">\r\n            <a-time-picker\r\n              v-model:value=\"value\"\r\n              v-model:open=\"open\"\r\n              @openChange=\"handleOpenChange\"\r\n              :style=\"{ marginBottom: '10px' }\"\r\n            >\r\n              <template #renderExtraFooter=\"{ prefixCls }\">\r\n                <a-button size=\"small\" type=\"primary\" @click=\"handleClose\">Ok {{ prefixCls }}</a-button>\r\n              </template>\r\n            </a-time-picker>\r\n            <br />\r\n            <a-time-picker v-model:value=\"value\" v-model:open=\"open2\">\r\n              <template #renderExtraFooter>\r\n                <a-button size=\"small\" type=\"primary\" @click=\"handleClose\">Ok</a-button>\r\n              </template>\r\n            </a-time-picker>\r\n          </sdCards>\r\n        </a-col>\r\n        <a-col :md=\"12\" :sm=\"24\" :xs=\"24\">\r\n          <sdCards title=\"Disebled\">\r\n            <a-time-picker :value=\"dayjs('12:08:23', 'HH:mm:ss')\" disabled />\r\n          </sdCards>\r\n          <sdCards title=\"12 hours\">\r\n            <a-time-picker v-model:value=\"value4\" use12-hours :style=\"{ marginBottom: '10px' }\" /> <br />\r\n            <a-time-picker\r\n              v-model:value=\"value4\"\r\n              use12-hours\r\n              format=\"h:mm:ss A\"\r\n              :style=\"{ marginBottom: '10px' }\"\r\n            /><br />\r\n            <a-time-picker v-model:value=\"value4\" use12-hours format=\"h:mm a\" />\r\n          </sdCards>\r\n          <sdCards title=\"Hours and minute\">\r\n            <a-time-picker :value=\"dayjs('12:08', 'HH:mm')\" format=\"h:mm \"\r\n          /></sdCards>\r\n        </a-col>\r\n      </a-row>\r\n    </Main>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nimport dayjs from 'dayjs';\r\nimport { ref, watch, defineComponent } from 'vue';\r\nimport { Main } from '../styled';\r\nexport default defineComponent({\r\n  name: 'TimePicker',\r\n  components: {\r\n    Main,\r\n  },\r\n  setup() {\r\n    const value = ref();\r\n    const strValue = ref('09:00:00');\r\n    const open = ref(false);\r\n    const open2 = ref(false);\r\n    watch(strValue, () => {\r\n      //console.log(strValue.value);\r\n    });\r\n\r\n    const handleOpenChange = (openStatus) => {\r\n      //console.log('open', openStatus);\r\n      open.value = openStatus;\r\n    };\r\n\r\n    const handleClose = () => {\r\n      open.value = false;\r\n      open2.value = false;\r\n    };\r\n    return {\r\n      open,\r\n      open2,\r\n      strValue,\r\n      dayjs,\r\n      value,\r\n      value4: ref(undefined),\r\n      value1: ref(dayjs('12:08:23', 'HH:mm')),\r\n      value2: ref(dayjs('12:08:23', 'HH:mm')),\r\n      value3: ref(dayjs('12:08:23', 'HH:mm')),\r\n      handleOpenChange,\r\n      handleClose,\r\n    };\r\n  },\r\n});\r\n</script>\r\n"],"mappings":"AA2EA,OAAOA,KAAI,MAAO,OAAO;AACzB,SAASC,GAAG,EAAEC,KAAK,EAAEC,eAAc,QAAS,KAAK;AACjD,SAASC,IAAG,QAAS,WAAW;AAChC,eAAeD,eAAe,CAAC;EAC7BE,IAAI,EAAE,YAAY;EAClBC,UAAU,EAAE;IACVF;EACF,CAAC;EACDG,KAAKA,CAAA,EAAG;IACN,MAAMC,KAAI,GAAIP,GAAG,EAAE;IACnB,MAAMQ,QAAO,GAAIR,GAAG,CAAC,UAAU,CAAC;IAChC,MAAMS,IAAG,GAAIT,GAAG,CAAC,KAAK,CAAC;IACvB,MAAMU,KAAI,GAAIV,GAAG,CAAC,KAAK,CAAC;IACxBC,KAAK,CAACO,QAAQ,EAAE,MAAM;MACpB;IAAA,CACD,CAAC;IAEF,MAAMG,gBAAe,GAAKC,UAAU,IAAK