on',\r\n    dataIndex: 'completion',\r\n    key: 'completion',\r\n  },\r\n\r\n  {\r\n    title: '',\r\n    dataIndex: 'action',\r\n    key: 'action',\r\n  },\r\n];\r\n\r\nconst ProjectLists = {\r\n  name: 'ProjectLists',\r\n  components: { ProjectPagination, ProjectListTitle, ProjectListAssignees, ProjectList },\r\n  setup() {\r\n    const { state } = useStore();\r\n    const projects = computed(() => state.project.data);\r\n    const current = ref(0);\r\n    const pageSize = ref(0);\r\n\r\n    const onShowSizeChange = (c, p) => {\r\n      current.value = c;\r\n      pageSize.value = p;\r\n    };\r\n\r\n    const onHandleChange = (c, p) => {\r\n      current.value = c;\r\n      pageSize.value = p;\r\n    };\r\n\r\n    const dataSource = computed(\r\n      () =>\r\n        projects.value.length &&\r\n        projects.value.map((value) => {\r\n          const { id, title, status, category, percentage } = value;\r\n          return {\r\n            key: id,\r\n            project: (\r\n              <ProjectListTitle>\r\n                <sdHeading as=\"h4\">\r\n                  <router-link to={`/app/project/projectDetails/${id}`}>{title}</router-link>\r\n                </sdHeading>\r\n                <p>{category}</p>\r\n              </ProjectListTitle>\r\n            ),\r\n            startDate: <span class=\"date-started\">26 Dec 2019</span>,\r\n            deadline: <span class=\"date-finished\">18 Mar 2021</span>,\r\n            assigned: (\r\n              <ProjectListAssignees>\r\n                <ul>\r\n                  <li>\r\n                    <img src={require(`@/static/img/users/1.png`)} alt=\"\" />\r\n                  </li>\r\n                  <li>\r\n                    <img src={require(`@/static/img/users/2.png`)} alt=\"\" />\r\n                  </li>\r\n                  <li>\r\n                    <img src={require(`@/static/img/users/3.png`)} alt=\"\" />\r\n                  </li>\r\n                  <li>\r\n                    <img src={re