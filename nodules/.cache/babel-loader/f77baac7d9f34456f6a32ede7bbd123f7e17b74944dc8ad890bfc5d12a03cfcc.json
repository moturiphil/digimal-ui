{"ast":null,"code":"import { computed, toRefs, ref, defineComponent } from 'vue';\nimport propTypes from 'vue-types';\nimport { useStore } from 'vuex';\nconst KanbanBoardItem = defineComponent({\n  name: 'KanbanBoardItem',\n  props: {\n    data: propTypes.object,\n    showModal: propTypes.func,\n    onBackShadow: propTypes.func,\n    taskId: propTypes.string,\n    onTaskTitleUpdate: propTypes.func,\n    onTaskTitleDelete: propTypes.func\n  },\n  setup(props) {\n    const {\n      state\n    } = useStore();\n    const isTaskLoading = computed(() => state.KanbanBoard.tsLoading);\n    const {\n      data\n    } = toRefs(props);\n    const {\n      title,\n      id\n    } = toRefs(data.value);\n    const value = ref(title.value);\n    const onTaskTitleChange = e => {\n      value.value = e.target.value;\n    };\n    return {\n      onTaskTitleChange,\n      isTaskLoading,\n      title,\n      id,\n      value\n    };\n  }\n});\nexport default KanbanBoardItem;","map":{"version":3,"names":["computed","toRefs","ref","defineComponent","propTypes","useStore","KanbanBoardItem","name","props","data","object","showModal","func","onBackShadow","taskId","string","onTaskTitleUpdate","onTaskTitleDelete","setup","state","isTaskLoading","KanbanBoard","tsLoading","title","id","value","onTaskTitleChange","e","target"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/apps/kanban/overview/KanbanBoardItem.vue"],"sourcesContent":["<template>\r\n  <div v-if=\"isTaskLoading\">loading</div>\r\n  <div v-else :class=\"taskId === id ? 'sDash_kanvan-task__editable' : ''\">\r\n    <h4 class=\"sDash_kanvan-task__title\">\r\n      <a @click=\"() => showModal(data)\" href=\"#\">\r\n        {{ title }}\r\n      </a>\r\n      <a href=\"#\" class=\"btn-edit\" @click=\"() => onBackShadow(id)\">\r\n        <sdFeatherIcons type=\"edit-2\" size=\"12\" />\r\n      </a>\r\n    </h4>\r\n    <div class=\"sDash_kanvan-task__edit\" draggable=\"false\">\r\n      <div class=\"sDash_kanvan-task__edit--left\">\r\n        <a-input @pressEnter=\"() => onTaskTitleUpdate(value, id)\" @change=\"onTaskTitleChange\" v-model:value=\"value\" />\r\n        <sdButton\r\n          @click=\"() => onTaskTitleUpdate(value, id)\"\r\n          class=\"edit-kanban-task\"\r\n          htmlType=\"submit\"\r\n          size=\"small\"\r\n          type=\"primary\"\r\n        >\r\n          Save\r\n        </sdButton>\r\n      </div>\r\n      <div class=\"sDash_kanvan-task__edit--right\">\r\n        <a href=\"#\" class=\"btn-delete\" @click=\"(e) => onTaskTitleDelete(e, id)\">\r\n          <sdFeatherIcons type=\"trash-2\" size=\"12\" />\r\n          <span>Delete Task</span>\r\n        </a>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</template>\r\n<script>\r\nimport { computed, toRefs, ref, defineComponent } from 'vue';\r\nimport propTypes from 'vue-types';\r\nimport { useStore } from 'vuex';\r\n\r\nconst KanbanBoardItem = defineComponent({\r\n  name: 'KanbanBoardItem',\r\n  props: {\r\n    data: propTypes.object,\r\n    showModal: propTypes.func,\r\n    onBackShadow: propTypes.func,\r\n    taskId: propTypes.string,\r\n    onTaskTitleUpdate: propTypes.func,\r\n    onTaskTitleDelete: propTypes.func,\r\n  },\r\n  setup(props) {\r\n    const { state } = useStore();\r\n    const isTaskLoading = computed(() => state.KanbanBoard.tsLoading);\r\n    const { data } = toRefs(props);\r\n    const { title, id } = toRefs(data.value);\r\n    const value = ref(title.value);\r\n\r\n    const onTaskTitleChange = (e) => {\r\n      value.value = e.target.value;\r\n    };\r\n\r\n    return {\r\n      onTaskTitleChange,\r\n      isTaskLoading,\r\n      title,\r\n      id,\r\n      value,\r\n    };\r\n  },\r\n});\r\n\r\nexport default KanbanBoardItem;\r\n</script>\r\n"],"mappings":"AAkCA,SAASA,QAAQ,EAAEC,MAAM,EAAEC,GAAG,EAAEC,eAAc,QAAS,KAAK;AAC5D,OAAOC,SAAQ,MAAO,WAAW;AACjC,SAASC,QAAO,QAAS,MAAM;AAE/B,MAAMC,eAAc,GAAIH,eAAe,CAAC;EACtCI,IAAI,EAAE,iBAAiB;EACvBC,KAAK,EAAE;IACLC,IAAI,EAAEL,SAAS,CAACM,MAAM;IACtBC,SA