{"ast":null,"code":"import { WizardWrapper, WizardThree } from \"../Style\";\nimport { BasicFormWrapper } from \"../../styled\";\nimport Steps from \"@/components/steps/steps\";\nimport { useStore } from \"vuex\";\nimport { computed, ref, reactive, defineComponent } from \"vue\";\nconst WizardsThree = defineComponent({\n  name: \"WizardsThree\",\n  components: {\n    Steps,\n    WizardWrapper,\n    WizardThree,\n    BasicFormWrapper\n  },\n  setup() {\n    const {\n      state\n    } = useStore();\n    const isLoading = computed(() => state.cart.loading);\n    const rtl = computed(() => state.themeLayout.rtlData);\n    const status = ref(\"process\");\n    const isFinished = ref(false);\n    const current = ref(1);\n    const password = ref(123456);\n    const confirm_password = ref();\n    const profile = reactive({\n      fname: \"\",\n      lname: \"\",\n      email: \"\",\n      address: \"\"\n    });\n    const next = () => {\n      status.value = \"process\";\n      current.value = current.value + 1;\n    };\n    const prev = () => {\n      status.value = \"process\";\n      current.value = current.value - 1;\n    };\n    const done = () => {\n      const confirm = window.confirm(\"Are sure to submit order?\");\n      if (confirm) {\n        status.value = \"finish\";\n        isFinished.value = true;\n        current.value = 0;\n      }\n    };\n    return {\n      done,\n      prev,\n      next,\n      isLoading,\n      rtl,\n      status,\n      isFinished,\n      current,\n      profile,\n      password,\n      confirm_password,\n      checked: ref(false),\n      steps: [{\n        title: \"Start\",\n        content: \"start\"\n      }, {\n        title: \"Profile\",\n        content: \"profile\"\n      }, {\n        title: \"Hints\",\n        content: \"hints\"\n      }, {\n        title: \"Finish\",\n        content: \"finish\"\n      }]\n    };\n  }\n});\nexport default WizardsThree;","map":{"version":3,"names":["WizardWrapper","WizardThree","BasicFormWrapper","Steps","useStore","computed","ref","reactive","defineComponent","WizardsThree","name","components","setup","state","isLoading","cart","loading","rtl","themeLayout","rtlData","status","isFinished","current","password","confirm_password","profile","fname","lname","email","address","next","value","prev","done","confirm","window","checked","steps","title","content"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/wizards/overview/WizardsThree.vue"],"sourcesContent":["<template>\r\n  <WizardWrapper>\r\n    <WizardThree>\r\n      <Steps\r\n        isSwitch\r\n        :current=\"0\"\r\n        :status=\"status\"\r\n        :steps=\"steps\"\r\n        @onNext=\"next\"\r\n        @onPrev=\"prev\"\r\n        @onDone=\"done\"\r\n        :isFinished=\"isFinished\"\r\n      >\r\n        <template #start>\r\n          <BasicFormWrapper class=\"basic-form-inner\">\r\n            <div class=\"atbd-form-checkout\">\r\n              <a-row justify=\"center\">\r\n                <a-col :sm=\"22\" :xs=\"24\">\r\n                  <div class=\"create-account-form\">\r\n                    <sdHeading as=\"h4\">1. Please Create Your Account</sdHeading>\r\n                    <a-form name=\"account\" layout=\"vertical\">\r\n                      <a-form-item name=\"username\" label=\"Username\">\r\n                        <a-input placeholder=\"Username\" />\r\n                      </a-form-item>\r\n                      <a-form-item name=\"password\" label=\"Password\">\r\n                        <a-input-password\r\n                          type=\"password\"\r\n                          v-model:value=\"password\"\r\n                          placeholder=\"Password\"\r\n                        />\r\n                      </a-form-item>\r\n                      <a-form-item\r\n                        name=\"confirm_password\"\r\n                        label=\"Confirm Password\"\r\n                      >\r\n                        <a-input-password\r\n                          type=\"password\"\r\n                          v-model:value=\"confirm_password\"\r\n                          placeholder=\"Password\"\r\n                        />\r\n                      </a-form-item>\r\n                    </a-form>\r\n                  </div>\r\n                </a-col>\r\n              </a-row>\r\n            </div>\r\n          </BasicFormWrapper>\r\n        </template>\r\n        <template #profile>\r\n          <BasicFormWrapper class=\"basic-form-inner\">\r\n            <div class=\"atbd-form-checkout\">\r\n              <a-row justify=\"center\">\r\n                <a-col :sm=\"22\" :xs=\"24\">\r\n                  <div class=\"shipping-form\">\r\n                    <sdHeading as=\"h4\">2. Please setup your profile</sdHeading>\r\n                    <a-form :model=\"profile\" name=\"address\" layout=\"vertical\">\r\n                      <a-form-item name=\"fname\" label=\"First Name\">\r\n                        <a-input\r\n                          v-model:value=\"profile.fname\"\r\n                          placeholder=\"First Name\"\r\n                        />\r\n                      </a-form-item>\r\n                      <a-form-item name=\"lname\" label=\"Last Name\">\r\n                        <a-input\r\n                          v-model:value=\"profile.lname\"\r\n                          placeholder=\"Last Name\"\r\n                        />\r\n                      </a-form-item>\r\n                      <a-form-item name=\"email\" label=\"Email Address\">\r\n                        <a-input\r\n                          type=\"email\"\r\n                          v-model:value=\"profile.email\"\r\n                          placeholder=\"name@gmail.com\"\r\n                        />\r\n                      </a-form-item>\r\n                      <a-form-item name=\"street\" label=\"Address\">\r\n                        <a-input\r\n                          v-model:value=\"profile.address\"\r\n                          placeholder=\"Address\"\r\n                        />\r\n                      </a-form-item>\r\n                    </a-form>\r\n                  </div>\r\n                </a-col>\r\n              </a-row>\r\n            </div>\r\n          </BasicFormWrapper>\r\n        </template>\r\n\r\n        <template #hints>\r\n          <BasicFormWrapper class=\"basic-form-inner\">\r\n            <div class=\"atbd-form-checkout\">\r\n              <a-row justify=\"center\">\r\n                <a-col :sm=\"22\" :xs=\"24\">\r\n                  <div class=\"payment-method-form profile-hints\">\r\n                    <sdHeading as=\"h4\">3. Please see your hints</sdHeading>\r\n                    <p>\r\n                      First Name : <span>{{ profile.fname }}</span>\r\n                    </p>\r\n                    <p>\r\n                      Last Name : <span>{{ profile.lname }}</span>\r\n                    </p>\r\n                    <p>\r\n                      Email Address : <span>{{ profile.email }}</span>\r\n                    </p>\r\n                    <p>\r\n                      Address : <span>{{ profile.address }}</span>\r\n                    </p>\r\n                  </div>\r\n                </a-col>\r\n              </a-row>\r\n            </div>\r\n          </BasicFormWrapper>\r\n        </template>\r\n\r\n        <template #finish>\r\n          <BasicFormWrapper\r\n            v-if=\"status !== 'finish'\"\r\n            :style=\"{ width: '100%' }\"\r\n          >\r\n            <div class=\"atbd-finish-order\" :style=\"{ width: '100%' }\">\r\n              <sdHeading as=\"h4\">4. Let's Finished</sdHeading>\r\n              <a-checkbox v-model:checked=\"checked\"\r\n                ><span class=\"checkbox-label\"\r\n                  >I Agree with the Terms and Conditions.</span\r\n                ></a-checkbox\r\n              >\r\n            </div>\r\n          </BasicFormWrapper>\r\n\r\n          <a-row v-else justify=\"center\" :style=\"{ width: '100%' }\">\r\n            <a-col :xl=\"21\" :xs=\"24\">\r\n              <div class=\"checkout-successful\">\r\n                <sdCards\r\n                  headless\r\n                  :bodyStyle=\"{\r\n                    backgroundColor: '#F8F9FB',\r\n                    borderRadius: '20px',\r\n                  }\"\r\n                >\r\n                  <sdCards headless>\r\n                    <span class=\"icon-success\">\r\n                      <sdFeatherIcons type=\"check\" />\r\n                    </span>\r\n                    <sdHeading as=\"h3\">Thank You</sdHeading>\r\n                    <p>Your registration completed successfully</p>\r\n                  </sdCards>\r\n                </sdCards>\r\n              </div>\r\n            </a-col>\r\n          </a-row>\r\n        </template>\r\n      </Steps>\r\n    </WizardThree>\r\n  </WizardWrapper>\r\n</template>\r\n<script>\r\nimport { WizardWrapper, WizardThree } from \"../Style\";\r\nimport { BasicFormWrapper } from \"../../styled\";\r\nimport Steps from \"@/components/steps/steps\";\r\nimport { useStore } from \"vuex\";\r\nimport { computed, ref, reactive, defineComponent } from \"vue\";\r\n\r\nconst WizardsThree = defineComponent({\r\n  name: \"WizardsThree\",\r\n  components: {\r\n    Steps,\r\n    WizardWrapper,\r\n    WizardThree,\r\n    BasicFormWrapper,\r\n  },\r\n  setup() {\r\n    const { state } = useStore();\r\n    const isLoading = computed(() => state.cart.loading);\r\n    const rtl = computed(() => state.themeLayout.rtlData);\r\n    const status = ref(\"process\");\r\n    const isFinished = ref(false);\r\n    const current = ref(1);\r\n    const password = ref(123456);\r\n    const confirm_password = ref();\r\n    const profile = reactive({\r\n      fname: \"\",\r\n      lname: \"\",\r\n      email: \"\",\r\n      address: \"\",\r\n    });\r\n\r\n    const next = () => {\r\n      status.value = \"process\";\r\n      current.value = current.value + 1;\r\n    };\r\n\r\n    const prev = () => {\r\n      status.value = \"process\";\r\n      current.value = current.value - 1;\r\n    };\r\n\r\n    const done = () => {\r\n      const confirm = window.confirm(\"Are sure to submit order?\");\r\n      if (confirm) {\r\n        status.value = \"finish\";\r\n        isFinished.value = true;\r\n        current.value = 0;\r\n      }\r\n    };\r\n\r\n    return {\r\n      done,\r\n      prev,\r\n      next,\r\n      isLoading,\r\n      rtl,\r\n      status,\r\n      isFinished,\r\n      current,\r\n      profile,\r\n      password,\r\n      confirm_password,\r\n      checked: ref(false),\r\n      steps: [\r\n        {\r\n          title: \"Start\",\r\n          content: \"start\",\r\n        },\r\n        {\r\n          title: \"Profile\",\r\n          content: \"profile\",\r\n        },\r\n        {\r\n          title: \"Hints\",\r\n          content: \"hints\",\r\n        },\r\n        {\r\n          title: \"Finish\",\r\n          content: \"finish\",\r\n        },\r\n      ],\r\n    };\r\n  },\r\n});\r\n\r\nexport default WizardsThree;\r\n</script>\r\n"],"mappings":"AA6JA,SAASA,aAAa,EAAEC,WAAU,QAAS,UAAU;AACrD,SAASC,gBAAe,QAAS,cAAc;AAC/C,OAAOC,KAAI,MAAO,0BAA0B;AAC5C,SAASC,QAAO,QAAS,MAAM;AAC/B,SAASC,QAAQ,EAAEC,GAAG,EAAEC,QAAQ,EAAEC,eAAc,QAAS,KAAK;AAE9D,MAAMC,YAAW,GAAID,eAAe,CAAC;EACnCE,IAAI,EAAE,cAAc;EACpBC,UAAU,EAAE;IACVR,KAAK;IACLH,aAAa;IACbC,WAAW;IACXC;EACF,CAAC;EACDU,KAAKA,CAAA,EAAG;IACN,MAAM;MAAEC;IAAM,IAAIT,QAAQ,EAAE;IAC5B,MAAMU,SAAQ,GAAIT,QAAQ,CAAC,MAAMQ,KAAK,CAACE,IAAI,CAACC,OAAO,CAAC;IACpD,MAAMC,GAAE,GAAIZ,QAAQ,CAAC,MAAMQ,KAAK,CAACK,WAAW,CAACC,OAAO,CAAC;IACrD,MAAMC,MAAK,GAAId,GAAG,CAAC,SAAS,CAAC;IAC7B,MAAMe,UAAS,GAAIf,GAAG,CAAC,KAAK,CAAC;IAC7B,MAAMgB,OAAM,GAAIhB,GAAG,CAAC,CAAC,CAAC;IACtB,MAAMiB,QAAO,GAAIjB,GAAG,CAAC,MAAM,CAAC;IAC5B,MAAMkB,gBAAe,GAAIlB,GAAG,EAAE;IAC9B,MAAMmB,OAAM,GAAIlB,QAAQ,CAAC;MACvBmB,KAAK,EAAE,EAAE;MACTC,KAAK,EAAE,EAAE;MACTC,KAAK,EAAE,EAAE;MACTC,OAAO,EAAE;IACX,CAAC,CAAC;IAEF,MAAMC,IAAG,GAAIA,CAAA,KAAM;MACj