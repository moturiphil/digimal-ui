{"ast":null,"code":"import { Main } from \"../../styled\";\nimport { CardStyleWrapper } from \"../../uiElements/ui-elements-styled\";\nimport { defineComponent, computed, onMounted, ref, reactive } from \"vue\";\nimport { useStore } from \"vuex\";\nimport authHeader from \"../../../services/auth-header\";\nexport default defineComponent({\n  name: \"Cards\",\n  components: {\n    Main,\n    CardStyleWrapper\n  },\n  data() {\n    return {};\n  },\n  methods: {\n    onPanelChange(value, mode) {\n      console.log(value, mode);\n    },\n    getMonthData(value) {\n      if (value.month() === 8) {\n        return 1394;\n      }\n    }\n  },\n  setup() {\n    const {\n      state,\n      dispatch\n    } = useStore();\n    const crud = computed(() => state.crud.data);\n    const isLoading = computed(() => state.crud.loading);\n    const selectedRowKeys = ref([]);\n    const dataSource = ref([]);\n    onMounted(async () => {\n      try {\n        const response = await fetch(`${process.env.VUE_APP_BASE_URL}/campaign_all`, {\n          method: \"GET\",\n          headers: authHeader()\n        });\n        const data = await response.json();\n        dataSource.value = data.data;\n        console.log(dataSource.value);\n      } catch (error) {\n        console.error(error);\n      }\n    });\n    const handleDelete = id => {\n      const confirm = window.confirm(\"Are you sure delete this?\");\n      if (confirm) {\n        dispatch(\"axiosDataDelete\", {\n          id,\n          getData: () => {\n            dispatch(\"axiosCrudGetData\");\n          }\n        });\n      }\n      return false;\n    };\n    const formState = reactive({\n      searchItem: \"\"\n    });\n    const onSelectChange = selectedRowKey => {\n      selectedRowKeys.value = selectedRowKey;\n    };\n    const rowSelection = {\n      selectedRowKeys,\n      onChange: onSelectChange\n    };\n    return {\n      crud,\n      isLoading,\n      selectedRowKeys,\n      handleDelete,\n      rowSelection,\n      onSelectChange,\n      dataSource,\n      formState\n    };\n  },\n  beforeRouteEnter(to, from, next) {\n    if (!sessionStorage.getItem(\"user\")) {\n      next(\"/auth/login\");\n    } else {\n      next();\n    }\n  }\n});","map":{"version":3,"names":["Main","CardStyleWrapper","defineComponent","computed","onMounted","ref","reactive","useStore","authHeader","name","components","data","methods","onPanelChange","value","mode","console","log","getMonthData","month","setup","state","dispatch","crud","isLoading","loading","selectedRowKeys","dataSource","response","fetch","process","env","VUE_APP_BASE_URL","method","headers","json","error","handleDelete","id","confirm","window","getData","formState","searchItem","onSelectChange","selectedRowKey","rowSelection","onChange","beforeRouteEnter","to","from","next","sessionStorage","getItem"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/pages/campaigns/viewCampaigns.vue"],"sourcesContent":["<template>\n  <div>\n    <sdPageHeader title=\"Campaigns\">\n      <template v-slot:buttons>\n        <div class=\"page-header-actions\">\n          <!-- <sdCalendarButton />\n          <sdExportButton />\n          <sdShareButton /> -->\n          <sdButton class=\"btn-add_new\" size=\"default\" type=\"success\">\n            <router-link to=\"/campaigns/create-campaign\">\n              <sdFeatherIcons type=\"plus\" size=\"14\" /> Start New\n              Campaign</router-link\n            >\n          </sdButton>\n        </div>\n      </template>\n    </sdPageHeader>\n    <Main>\n      <a-row :gutter=\"25\">\n        <a-col :xs=\"24\">\n          <sdCards size=\"default\">\n            <div class=\"columnCardsWrapper\">\n              <a-row :gutter=\"30\">\n                <a-col\n                  :sm=\"8\"\n                  :xs=\"24\"\n                  v-for=\"(item, index) in dataSource\"\n                  :key=\"index\"\n                >\n                  <CardStyleWrapper>\n                    <sdCards :border=\"false\" :title=\"item.name\">\n                      <p>Start Date: {{ item.start_date }}</p>\n                      <p>End Date: {{ item.end_date }}</p>\n                      <template #actions=\"{ item }\">\n                        <td>\n                          <div class=\"table-actions\">\n                            <sdButton>\n                              <router-link\n                                :to=\"`/campaigns/view/${item.id}`\"\n                                class=\"btn-icon\"\n                                type=\"info\"\n                                shape=\"circle\"\n                              >\n                                <sdFeatherIcons type=\"eye\" size=\"16\" />\n                                &nbsp;&nbsp; View\n                              </router-link>\n                            </sdButton>\n                          </div>\n                        </td>\n                      </template>\n                    </sdCards>\n                  </CardStyleWrapper>\n                </a-col>\n              </a-row>\n            </div>\n          </sdCards>\n        </a-col>\n      </a-row>\n    </Main>\n  </div>\n</template>\n\n<script>\nimport { Main } from \"../../styled\";\nimport { CardStyleWrapper } from \"../../uiElements/ui-elements-styled\";\nimport { defineComponent, computed, onMounted, ref, reactive } from \"vue\";\nimport { useStore } from \"vuex\";\nimport authHeader from \"../../../services/auth-header\";\n\nexport default defineComponent({\n  name: \"Cards\",\n  components: {\n    Main,\n    CardStyleWrapper,\n  },\n  data() {\n    return {};\n  },\n  methods: {\n    onPanelChange(value, mode) {\n      console.log(value, mode);\n    },\n\n    getMonthData(value) {\n      if (value.month() === 8) {\n        return 1394;\n      }\n    },\n  },\n  setup() {\n    const { state, dispatch } = useStore();\n    const crud = computed(() => state.crud.data);\n    const isLoading = computed(() => state.crud.loading);\n    const selectedRowKeys = ref([]);\n    const dataSource = ref([]);\n\n    onMounted(async () => {\n      try {\n        const response = await fetch(\n          `${process.env.VUE_APP_BASE_URL}/campaign_all`,\n          {\n            method: \"GET\",\n            headers: authHeader(),\n          }\n        );\n        const data = await response.json();\n        dataSource.value = data.data;\n        console.log(dataSource.value);\n      } catch (error) {\n        console.error(error);\n      }\n    });\n\n    const handleDelete = (id) => {\n      const confirm = window.confirm(\"Are you sure delete this?\");\n      if (confirm) {\n        dispatch(\"axiosDataDelete\", {\n          id,\n          getData: () => {\n            dispatch(\"axiosCrudGetData\");\n          },\n        });\n      }\n      return false;\n    };\n\n    const formState = reactive({\n      searchItem: \"\",\n    });\n\n    const onSelectChange = (selectedRowKey) => {\n      selectedRowKeys.value = selectedRowKey;\n    };\n\n    const rowSelection = {\n      selectedRowKeys,\n      onChange: onSelectChange,\n    };\n\n    return {\n      crud,\n      isLoading,\n      selectedRowKeys,\n      handleDelete,\n      rowSelection,\n      onSelectChange,\n      dataSource,\n      formState,\n    };\n  },\n  beforeRouteEnter(to, from, next) {\n    if (!sessionStorage.getItem(\"user\")) {\n      next(\"/auth/login\");\n    } else {\n      next();\n    }\n  },\n});\n</script>\n"],"mappings":"AA+DA,SAASA,IAAG,QAAS,cAAc;AACnC,SAASC,gBAAe,QAAS,qCAAqC;AACtE,SAASC,eAAe,EAAEC,QAAQ,EAAEC,SAAS,EAAEC,GAAG,EAAEC,QAAO,QAAS,KAAK;AACzE,SAASC,QAAO,QAAS,MAAM;AAC/B,OAAOC,UAAS,MAAO,+BAA+B;AAEtD,eAAeN,eAAe,CAAC;EAC7BO,IAAI,EAAE,OAAO;EACbC,UAAU,EAAE;IACVV,IAAI;IACJC;EACF,CAAC;EACDU,IAAIA,CAAA,EAAG;IACL,OAAO,CAAC,CAAC;EACX,CAAC;EACDC,OAAO,EAAE;IACPC,aAAaA,CAACC,KAAK,EAAEC,IAAI,EAAE;MACzBC,OAAO,CAACC,GAAG,CAACH,KAAK,EAAEC,IAAI,CAAC;IAC1B,CAAC;IAEDG,YAAYA,CAACJ,KAAK,EAAE;MAClB,IAAIA,KAAK,CAACK,KAAK,EAAC,KAAM,CAAC,EA