{"ast":null,"code":"import { computed, onMounted, ref, watchEffect } from 'vue';\nimport { onBeforeRouteUpdate, useRoute } from 'vue-router';\nimport { useStore } from 'vuex';\nimport { Main } from '../../styled';\nimport Ordersummary from './overview/Ordersummary';\nimport CartTable from './overview/CartTable';\n\n// const Checkout = lazy(() => import('./overview/CheckOut'));\n\nconst ShoppingCart = {\n  name: 'ShoppingCart',\n  components: {\n    Main,\n    Ordersummary,\n    CartTable\n  },\n  setup() {\n    const {\n      state,\n      dispatch\n    } = useStore();\n    const {\n      matched\n    } = useRoute();\n    const cartData = computed(() => state.cart.data);\n    const rtl = computed(() => state.themeLayout.rtlData);\n    const coupon = ref(0);\n    const promo = ref(0);\n    const current = ref(0);\n    let subtotal = ref(0);\n    onMounted(() => dispatch('cartGetData'));\n    watchEffect(() => {\n      let totalValue = ref(0);\n      if (cartData.value !== null) {\n        cartData.value.map(data => {\n          const {\n            quantity,\n            price\n          } = data;\n          totalValue.value += parseInt(quantity, 10) * parseInt(price, 10);\n          return subtotal.value = totalValue.value;\n        });\n      }\n    });\n    const onHandleCurrent = current => {\n      current.value = current;\n    };\n    const isExact = ref(true);\n    isExact.value = matched[3].name === 'exact' ? true : false;\n    onBeforeRouteUpdate(async to => {\n      isExact.value = to.name === 'exact' ? true : false;\n    });\n    return {\n      cartData,\n      rtl,\n      coupon,\n      promo,\n      current,\n      subtotal,\n      onHandleCurrent,\n      path: matched[2].path,\n      isExact\n    };\n  }\n};\nexport default ShoppingCart;","map":{"version":3,"names":["computed","onMounted","ref","watchEffect","onBeforeRouteUpdate","useRoute","useStore","Main","Ordersummary","CartTable","ShoppingCart","name","components","setup","state","dispatch","matched","cartData","cart","data","rtl","themeLayout","rtlData","coupon","promo","current","subtotal","totalValue","value","map","quantity","price","parseInt","onHandleCurrent","isExact","to","path"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/apps/ecommerce/Cart.vue"],"sourcesContent":["<template>\r\n  <sdPageHeader title=\"Shopping Cart\"\r\n    ><template v-slot:buttons>\r\n      <div class=\"page-header-actions\">\r\n        <sdCalendarButton />\r\n        <sdExportButton />\r\n        <sdShareButton />\r\n        <sdButton size=\"small\" type=\"primary\">\r\n          <sdFeatherIcons type=\"plus\" size=\"14\" />\r\n          Add New\r\n        </sdButton>\r\n      </div>\r\n    </template>\r\n  </sdPageHeader>\r\n  <Main>\r\n    <div :class=\"isExact ? 'cartWraper' : 'checkoutWraper'\">\r\n      <a-row :gutter=\"15\">\r\n        <a-col :md=\"24\">\r\n          <sdCards headless>\r\n            <a-row :gutter=\"30\">\r\n              <a-col :xxl=\"17\" :xs=\"24\"> <router-view name=\"child\"></router-view> </a-col>\r\n              <a-col :xxl=\"7\" :xs=\"24\">\r\n                <Ordersummary :isExact=\"isExact\" :subtotal=\"subtotal\" :path=\"path\" />\r\n              </a-col>\r\n            </a-row>\r\n          </sdCards>\r\n        </a-col>\r\n      </a-row>\r\n    </div>\r\n  </Main>\r\n</template>\r\n<script>\r\nimport { computed, onMounted, ref, watchEffect } from 'vue';\r\nimport { onBeforeRouteUpdate, useRoute } from 'vue-router';\r\nimport { useStore } from 'vuex';\r\nimport { Main } from '../../styled';\r\nimport Ordersummary from './overview/Ordersummary';\r\nimport CartTable from './overview/CartTable';\r\n\r\n// const Checkout = lazy(() => import('./overview/CheckOut'));\r\n\r\nconst ShoppingCart = {\r\n  name: 'ShoppingCart',\r\n  components: { Main, Ordersummary, CartTable },\r\n  setup() {\r\n    const { state, dispatch } = useStore();\r\n    const { matched } = useRoute();\r\n    const cartData = computed(() => state.cart.data);\r\n    const rtl = computed(() => state.themeLayout.rtlData);\r\n    const coupon = ref(0);\r\n    const promo = ref(0);\r\n    const current = ref(0);\r\n\r\n    let subtotal = ref(0);\r\n\r\n    onMounted(() => dispatch('cartGetData'));\r\n\r\n    watchEffect(() => {\r\n      let totalValue = ref(0);\r\n      if (cartData.value !== null) {\r\n        cartData.value.map((data) => {\r\n          const { quantity, price } = data;\r\n          totalValue.value += parseInt(quantity, 10) * parseInt(price, 10);\r\n\r\n          return (subtotal.value = totalValue.value);\r\n        });\r\n      }\r\n    });\r\n\r\n    const onHandleCurrent = (current) => {\r\n      current.value = current;\r\n    };\r\n    const isExact = ref(true);\r\n    isExact.value = matched[3].name === 'exact' ? true : false;\r\n\r\n    onBeforeRouteUpdate(async (to) => {\r\n      isExact.value = to.name === 'exact' ? true : false;\r\n    });\r\n    return {\r\n      cartData,\r\n      rtl,\r\n      coupon,\r\n      promo,\r\n      current,\r\n      subtotal,\r\n      onHandleCurrent,\r\n      path: matched[2].path,\r\n      isExact,\r\n    };\r\n  },\r\n};\r\n\r\nexport default ShoppingCart;\r\n</script>\r\n"],"mappings":"AAgCA,SAASA,QAAQ,EAAEC,SAAS,EAAEC,GAAG,EAAEC,WAAU,QAAS,KAAK;AAC3D,SAASC,mBAAmB,EAAEC,QAAO,QAAS,YAAY;AAC1D,SAASC,QAAO,QAAS,MAAM;AAC/B,SAASC,IAAG,QAAS,cAAc;AACnC,OAAOC,YAAW,MAAO,yBAAyB;AAClD,OAAOC,SAAQ,MAAO,sBAAsB;;AAE5C;;AAEA,MAAMC,YAAW,GAAI;EACnBC,IAAI,EAAE,cAAc;EACpBC,UAAU,EAAE;IAAEL,IAAI;IAAEC,YAAY;IAAEC;EAAU,CAAC;EAC7CI,KAAKA,CAAA,EAAG;IACN,MAAM;MAAEC,KAAK;MAAEC;IAAS,IAAIT,QAAQ,EAAE;IACtC,MAAM;MAAEU;IAAQ,IAAIX,QAAQ,EAAE;IAC9B,MAAMY,QAAO,GAAIjB,QAAQ,CAAC,MAAMc,KAAK,CAACI,IAAI,CAACC,IAAI,CAAC;IAChD,MAAMC,GAAE,GAAIpB,QAAQ,CAAC,MAAMc,KAAK,CAACO,WAAW,CAACC,OAAO,CAAC;IACrD,MAAMC,MAAK,GAAIrB,GAAG,CAAC,CAAC,CAAC;IACrB,MAAMsB,KAAI,GAAItB,GAAG,CAAC,CAAC,CAAC;IACpB,MAAMuB,OAAM,GAAIvB,GAAG,CAAC,CAAC,CAAC;IAEtB,IAAIwB,QAAO,GAAIxB,GAAG,CAAC,CAAC,CAAC;IAErBD,SAAS,CAAC,MAAMc,QAAQ,CAAC,aAAa,CA