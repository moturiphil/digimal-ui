{"ast":null,"code":"import dayjs from 'dayjs';\nimport { computed, onMounted, ref, defineComponent } from 'vue';\nimport { useStore } from 'vuex';\nimport { MailDetailsWrapper, MessageAction, MessageDetails, ReplyList, MessageReply, MailRightAction } from './style';\n// const MailComposer = lazy(() => import('./MailComposer'));\nimport { useRouter, useRoute } from 'vue-router';\nimport { faStar } from '@fortawesome/free-solid-svg-icons';\nconst Single = defineComponent({\n  name: 'Single',\n  components: {\n    MailDetailsWrapper,\n    MessageAction,\n    MessageDetails,\n    ReplyList,\n    MessageReply,\n    MailRightAction\n  },\n  setup() {\n    const {\n      state,\n      dispatch\n    } = useStore();\n    const {\n      back\n    } = useRouter();\n    const {\n      params,\n      matched\n    } = useRoute();\n    const email = computed(() => state.email.data[0]);\n    const replyMessage = ref(0);\n    onMounted(() => {\n      dispatch('filterSinglePage', parseInt(params.id));\n    });\n    const replyMail = message => {\n      replyMessage.value = message;\n      console.log(message);\n    };\n    const onStaredChange = id => {\n      dispatch('onStarUpdate', id);\n    };\n    return {\n      onStaredChange,\n      replyMail,\n      replyMessage,\n      email,\n      dayjs,\n      back,\n      faStar,\n      matched,\n      params\n    };\n  }\n});\nexport default Single;","map":{"version":3,"names":["dayjs","computed","onMounted","ref","defineComponent","useStore","MailDetailsWrapper","MessageAction","MessageDetails","ReplyList","MessageReply","MailRightAction","useRouter","useRoute","faStar","Single","name","components","setup","state","dispatch","back","params","matched","email","data","replyMessage","parseInt","id","replyMail","message","value","console","log","onStaredChange"],"sources":["/var/www/digimal.uonbi.ac.ke/public_html/src/view/apps/email/overview/MailDetailView.vue"],"sourcesContent":["<template>\r\n  <MailDetailsWrapper v-if=\"email\">\r\n    <sdCards>\r\n      <template #button>\r\n        <MailRightAction>\r\n          <span>1 - 50 of 235</span>\r\n        </MailRightAction>\r\n      </template>\r\n      <template #title>\r\n        <MessageAction>\r\n          <router-link @click=\"() => back()\" to=\"#\">\r\n            <sdFeatherIcons type=\"arrow-left\" size=\"14\" />\r\n          </router-link>\r\n          <a-tooltip placement=\"bottom\" title=\"Refresh\">\r\n            <router-link to=\"#\">\r\n              <sdFeatherIcons type=\"rotate-cw\" size=\"18\" />\r\n            </router-link>\r\n          </a-tooltip>\r\n          <a-tooltip placement=\"bottom\" title=\"Archive\">\r\n            <router-link to=\"#\">\r\n              <sdFeatherIcons type=\"archive\" size=\"18\" />\r\n            </router-link>\r\n          </a-tooltip>\r\n          <a-tooltip placement=\"bottom\" title=\"Info\">\r\n            <router-link to=\"#\">\r\n              <sdFeatherIcons type=\"alert-octagon\" size=\"18\" />\r\n            </router-link>\r\n          </a-tooltip>\r\n          <a-tooltip placement=\"bottom\" title=\"Delete\">\r\n            <router-link to=\"#\">\r\n              <sdFeatherIcons type=\"trash\" size=\"18\" />\r\n            </router-link>\r\n          </a-tooltip>\r\n          <a-tooltip placement=\"bottom\" title=\"Read\">\r\n            <router-link to=\"#\">\r\n              <sdFeatherIcons type=\"book-open\" size=\"18\" />\r\n            </router-link>\r\n          </a-tooltip>\r\n          <a-tooltip placement=\"bottom\" title=\"Folder\">\r\n            <router-link to=\"#\">\r\n              <sdFeatherIcons type=\"folder\" size=\"18\" />\r\n            </router-link>\r\n          </a-tooltip>\r\n        </MessageAction>\r\n      </template>\r\n      <a-row :gutter=\"15\">\r\n        <a-col>\r\n          <MessageDetails>\r\n            <div class=\"d-flex justify-content-between align-items-center\">\r\n              <div class=\"message-subject\">\r\n                <sdHeading as=\"h2\">\r\n                  {{ email.subject }}\r\n                  <span class=\"mail-badge primary\">{{ email.type }}</span>\r\n                </sdHeading>\r\n              </div>\r\n\r\n              <div class=\"message-action\">\r\n                <router-link to=\"#\" class=\"ex-coll\">\r\n                  <sdFeatherIcons type=\"chevron-up\" size=\"16\" />\r\n                  <sdFeatherIcons type=\"chevron-down\" size=\"16\" />\r\n                </router-link>\r\n\r\n                <router-link to=\"#\">\r\n                  <sdFeatherIcons type=\"printer\" size=\"16\" />\r\n                </router-link>\r\n              </div>\r\n            </div>\r\n\r\n            <div class=\"message-box d-flex justify-content-between align-items-center\">\r\n              <div class=\"message-author\">\r\n                <img :style=\"{ width: '60px', borderRadius: '50%' }\" :src=\"`${email.img}`\" alt=\"\" />\r\n                <div>\r\n                  <sdHeading as=\"h4\">{{ email.userName }}</sdHeading>\r\n                  <sdDropdown placement=\"bottom\">\r\n                    <template #overlay>\r\n                      <ul class=\"mail-props\">\r\n                        <li>\r\n                          <span>From:</span> <span>{{ email.from }}</span>\r\n                        </li>\r\n                        <li>\r\n                          <span>To:</span> <span>{{ email.to }}</span>\r\n                        </li>\r\n                        <li><span>CC:</span> <span>example@gamil.com</span></li>\r\n                        <li>\r\n                          <span>Date:</span> <span>{{ dayjs(email.id).format('MMM D, YYYY') }}</span>\r\n                        </li>\r\n                      </ul>\r\n                    </template>\r\n                    <router-link to=\"#\">\r\n                      To {{ email.to }}\r\n                      <sdFeatherIcons type=\"chevron-down\" size=\"14\" />\r\n                    </router-link>\r\n                  </sdDropdown>\r\n                </div>\r\n              </div>\r\n\r\n              <div class=\"message-excerpt\">\r\n                <span>\r\n                  <sdFeatherIcons type=\"paperclip\" />\r\n                </span>\r\n                <span>{{ dayjs(email.id).format('MMM D, YYYY') }} </span>\r\n                <router-link\r\n                  :class=\"email.stared ? 'starActive' : 'starDeactivate'\"\r\n                  @click=\"() => onStaredChange(email.id)\"\r\n                  to=\"#\"\r\n                >\r\n                  <font-awesome-icon :icon=\"faStar\" size=\"1x\" :style=\"{ textShadow: '0 1px 0 rgba(0, 0, 0, 0.1)' }\" />\r\n                </router-link>\r\n                <router-link to=\"#\">\r\n                  <sdFeatherIcons type=\"corner-up-left\" />\r\n                </router-link>\r\n                <router-link to=\"#\">\r\n                  <sdFeatherIcons type=\"more-vertical\" />\r\n                </router-link>\r\n              </div>\r\n            </div>\r\n\r\n            <div class=\"message-body\">\r\n              <span class=\"welcome-text\">Hello Adam,</span>\r\n              <p>{{ email.body }}</p>\r\n\r\n              <sdHeading as=\"h6\">\r\n                Best Regards <br />\r\n                {{ email.userName }}\r\n              </sdHeading>\r\n            </div>\r\n\r\n            <div class=\"message-attachments\">\r\n              <figure>\r\n                <div class=\"attachment-image\">\r\n                  <img :src=\"require('../../../../static/img/email/2.png')\" alt=\"\" />\r\n                </div>\r\n                <div class=\"attachment-hover\">\r\n                  <router-link class=\"btn-link\" to=\"#\">\r\n                    <sdFeatherIcons type=\"download\" />\r\n                  </router-link>\r\n                  <router-link class=\"btn-link\" to=\"#\">\r\n                    <sdFeatherIcons type=\"share-2\" />\r\n                  </router-link>\r\n                </div>\r\n                <figcaption>\r\n                  <sdHeading as=\"h4\">Attached.jpg</sdHeading>\r\n                  <p>256.5 KB</p>\r\n                </figcaption>\r\n              </figure>\r\n\r\n              <figure>\r\n                <div class=\"attachment-image\">\r\n                  <img :src=\"require('../../../../static/img/email/1.png')\" alt=\"\" />\r\n                </div>\r\n                <div class=\"attachment-hover\">\r\n                  <router-link class=\"btn-link\" to=\"#\">\r\n                    <sdFeatherIcons type=\"download\" />\r\n                  </router-link>\r\n                  <router-link class=\"btn-link\" to=\"#\">\r\n                    <sdFeatherIcons type=\"share-2\" />\r\n                  </router-link>\r\n                </div>\r\n                <figcaption>\r\n                  <sdHeading as=\"h4\">Attached.jpg</sdHeading>\r\n                  <p>256.5 KB</p>\r\n                </figcaption>\r\n              </figure>\r\n              <figure>\r\n                <div class=\"attachment-image\">\r\n                  <img :src=\"require('../../../../static/img/email/3.png')\" alt=\"\" />\r\n                </div>\r\n                <div class=\"attachment-hover\">\r\n                  <router-link class=\"btn-link\" to=\"#\">\r\n                    <sdFeatherIcons type=\"download\" />\r\n                  </router-link>\r\n                  <router-link class=\"btn-link\" to=\"#\">\r\n                    <sdFeatherIcons type=\"share-2\" />\r\n                  </router-link>\r\n                </div>\r\n                <figcaption>\r\n                  <sdHeading as=\"h4\">Attached.zip</sdHeading>\r\n                  <p>256.5 KB</p>\r\n                </figcaption>\r\n              </figure>\r\n              <figure>\r\n                <div class=\"attachment-image\">\r\n                  <img :src=\"require('../../../../static/img/email/4.png')\" alt=\"\" />\r\n                </div>\r\n                <div class=\"attachment-hover\">\r\n                  <router-link class=\"btn-link\" to=\"#\">\r\n                    <sdFeatherIcons type=\"download\" />\r\n                  </router-link>\r\n                  <router-link class=\"btn-link\" to=\"#\">\r\n                    <sdFeatherIcons type=\"share-2\" />\r\n                  </router-link>\r\n                </div>\r\n                <figcaption>\r\n                  <sdHeading as=\"h4\">Attached.pdf</sdHeading>\r\n                  <p>256.5 KB</p>\r\n                </figcaption>\r\n              </figure>\r\n            </div>\r\n            <hr />\r\n          </MessageDetails>\r\n        </a-col>\r\n      </a-row>\r\n\r\n      <a-row :gutter=\"15\">\r\n        <a-col :xs=\"24\">\r\n          <ReplyList>\r\n            <div class=\"reply-view__single\">\r\n              <figure class=\"reply-view__content d-flex\">\r\n                <img\r\n                  :style=\"{ width: '50px', height: '50px' }\"\r\n                  :src=\"require('../../../../static/img/email/2.png')\"\r\n                  alt=\"\"\r\n                />\r\n                <figcaption>\r\n                  <sdHeading as=\"h6\">Reynante Labares</sdHeading>\r\n                  <p>\r\n                    Lorem ipsum dolor sit amet, consetetur sadipscing elitr, sed diam nonumy eirmod tempor inviduntLorem\r\n                    ipsum dolor...\r\n                  </p>\r\n                </figcaption>\r\n              </figure>\r\n              <div class=\"reply-view__meta\">\r\n                <span class=\"meta-list\">\r\n                  <span class=\"date-meta\">Jan 2, 2021, 5:22 PM</span>\r\n                  <router-link\r\n                    :class=\"email.stared ? 'starActive' : 'starDeactivate'\"\r\n                    @click=\"() => onStaredChange(email.id)\"\r\n                    to=\"#\"\r\n                  >\r\n                    <font-awesome-icon :icon=\"faStar\" size=\"1x\" :style=\"{ textShadow: '0 1px 0 rgba(0, 0, 0, 0.1)' }\" />\r\n                  </router-link>\r\n                  <router-link to=\"#\">\r\n                    <sdFeatherIcons type=\"more-vertical\" />\r\n                  </router-link>\r\n                  <router-link to=\"#\">\r\n                    <sdFeatherIcons type=\"corner-up-left\" />\r\n                  </router-link>\r\n                </span>\r\n              </div>\r\n            </div>\r\n          </ReplyList>\r\n          <MessageReply>\r\n            <nav>\r\n              <ul>\r\n                <li>\r\n                  <router-link :to=\"`/app/mail-single/${params.id}/replay`\">\r\n                    <sdFeatherIcons type=\"corner-up-left\" size=\"14\" /> Reply\r\n                  </router-link>\r\n                </li>\r\n                <li>\r\n                  <router-link :to=\"`/app/mail-single/${params.id}/forward`\">\r\n                    <sdFeatherIcons type=\"corner-up-right\" size=\"14\" /> Forward\r\n                  </router-link>\r\n                </li>\r\n              </ul>\r\n            </nav>\r\n            <div class=\"reply-form d-flex\">\r\n              <div class=\"reply-box\">\r\n                <router-view name=\"child\" defaultTag=\"Alice Freeman\" replay :onSend=\"replyMail\"></router-view>\r\n              </div>\r\n            </div>\r\n          </MessageReply>\r\n        </a-col>\r\n      </a-row>\r\n    </sdCards>\r\n  </MailDetailsWrapper>\r\n  <div v-else class=\"spin\">\r\n    <a-spin />\r\n  </div>\r\n</template>\r\n<script>\r\nimport dayjs from 'dayjs';\r\nimport { computed, onMounted, ref, defineComponent } from 'vue';\r\nimport { useStore } from 'vuex';\r\nimport { MailDetailsWrapper, MessageAction, MessageDetails, ReplyList, MessageReply, MailRightAction } from './style';\r\n// const MailComposer = lazy(() => import('./MailComposer'));\r\nimport { useRouter, useRoute } from 'vue-router';\r\nimport { faStar } from '@fortawesome/free-solid-svg-icons';\r\n\r\nconst Single = defineComponent({\r\n  name: 'Single',\r\n  components: { MailDetailsWrapper, MessageAction, MessageDetails, ReplyList, MessageReply, MailRightAction },\r\n\r\n  setup() {\r\n    const { state, dispatch } = useStore();\r\n    const { back } = useRouter();\r\n    const { params, matched } = useRoute();\r\n    const email = computed(() => state.email.data[0]);\r\n    const replyMessage = ref(0);\r\n\r\n    onMounted(() => {\r\n      dispatch('filterSinglePage', parseInt(params.id));\r\n    });\r\n\r\n    const replyMail = (message) => {\r\n      replyMessage.value = message;\r\n      console.log(message);\r\n    };\r\n\r\n    const onStaredChange = (id) => {\r\n      dispatch('onStarUpdate', id);\r\n    };\r\n\r\n    return {\r\n      onStaredChange,\r\n      replyMail,\r\n      replyMessage,\r\n      email,\r\n      dayjs,\r\n      back,\r\n      faStar,\r\n      matched,\r\n      params,\r\n    };\r\n  },\r\n});\r\n\r\nexport default Single;\r\n</script>\r\n"],"mappings":"AA+QA,OAAOA,KAAI,MAAO,OAAO;AACzB,SAASC,QAAQ,EAAEC,SAAS,EAAEC,GAAG,EAAEC,eAAc,QAAS,KAAK;AAC/D,SAASC,QAAO,QAAS,MAAM;AAC/B,SAASC,kBAAkB,EAAEC,aAAa,EAAEC,cAAc,EAAEC,SAAS,EAAEC,YAAY,EAAEC,eAAc,QAAS,SAAS;AACrH;AACA,SAASC,SAAS,EAAEC,QAAO,QAAS,YAAY;AAChD,SAASC,MAAK,QAAS,mCAAmC;AAE1D,MAAMC,MAAK,GAAIX,eAAe,CAAC;EAC7BY,IAAI,EAAE,QAAQ;EACdC,UAAU,EAAE;IAAEX,kBAAkB;IAAEC,aAAa;IAAEC,cAAc;IAAEC,SAAS;IAAEC,YAAY;IAAEC;EAAgB,CAAC;EAE3GO,KAAKA,CAAA,EAAG;IACN,MAAM;MAAEC,KAAK;MAAEC;IAAS,IAAIf,QAAQ,EAAE;IACtC,MAAM;MAAEgB;IAAK,IAAIT,SAAS,EAAE;IAC5B,MAAM;MAAEU,MAAM;MAAEC;IAAQ,IAAIV,QAAQ,EAAE;IACtC,MAAMW,KAAI,GAAIvB,QAAQ,CAAC,MAAMkB,KAAK,CAACK,KAAK,CAACC,IAAI,CAAC,CAAC,CAAC,CAAC;IACjD,MAAMC,YAAW,GAAIvB,GAAG,CAAC,CAAC,CAAC;IAE3BD,SAAS,CAAC,MAAM;MACdkB,QAAQ,CAAC,kBAAkB,EAAEO,QAAQ,CAACL,MAAM,CAACM,EAAE,CAAC,CAAC;IACnD,CAAC,CAAC;IAEF,MAAMC,SAAQ,GAAKC,OAAO,IAAK;MAC7BJ,YAAY,CAACK,KAAI,GAAID,OAAO;MAC5BE,OAAO,CAACC,GAAG,CAACH,OAAO,CAAC;IACtB,CAAC;IAED,MAAMI,cAAa,GAAKN,EAAE,IAAK;MAC7BR,QAAQ,CAAC,cAAc,EAAEQ,EAAE,CAAC;IAC9B,CAAC;IAED,OAAO;MACLM,cAAc;MACdL,SAAS;