            href=\"#\"\r\n              >\r\n                <sdFeatherIcons type=\"search\" v-if=\"searchHide\" />\r\n                <sdFeatherIcons type=\"x\" v-else />\r\n              </a>\r\n              <a class=\"btn-auth\" @click=\"onShowHide(hide)\" href=\"#\">\r\n                <sdFeatherIcons type=\"more-vertical\" />\r\n              </a>\r\n            </div>\r\n          </a-col>\r\n        </a-row>\r\n      </Header>\r\n      <div class=\"header-more\">\r\n        <a-row>\r\n          <a-col :md=\"0\" :sm=\"24\" :xs=\"24\">\r\n            <div class=\"small-screen-headerRight\">\r\n              <SmallScreenSearch :hide=\"searchHide\" :darkMode=\"darkMode\">\r\n                <HeaderSearch />\r\n              </SmallScreenSearch>\r\n              <SmallScreenAuthInfo :hide=\"hide\" :darkMode=\"darkMode\">\r\n                <AuthInfo :rtl=\"rtl\" />\r\n              </SmallScreenAuthInfo>\r\n            </div>\r\n          </a-col>\r\n        </a-row>\r\n      </div>\r\n      <Layout :class=\"rtl ? 'ant-layout-rtl' : ''\">\r\n        <template v-if=\"!topMenu || innerWidth <= 991\">\r\n          <Sider\r\n            :width=\"280\"\r\n            :style=\"{\r\n              margin: '63px 0 0 0',\r\n              padding: '15px 15px 155px 15px',\r\n              overflowY: 'auto',\r\n              height: '100vh',\r\n              position: 'fixed',\r\n              [!rtl ? 'left' : 'right']: 0,\r\n              zIndex: 998,\r\n            }\"\r\n            :collapsed=\"collapsed\"\r\n            :theme=\"!darkMode ? 'light' : 'dark'\"\r\n          >\r\n            <perfect-scrollbar\r\n              :options=\"{\r\n                wheelSpeed: 1,\r\n                swipeEasing: true,\r\n                suppressScrollX: true,\r\n              }\"\r\n            >\r\n              <!-- <p class=\"sidebar-nav-title\">MAIN MENU</p> -->\r\n              <AsideItems\r\n                :toggleCollapsed=\"toggleCollapsedMobile\"\r\n                :topMenu=\"topMenu\"\r\n                :rtl=\"rtl\"\r\n                :darkMode=\"darkMode\"\r\n                :events=\"onEventChange\"\r\n                :class=\"rtl ? 'ant-menu-rtl' : ''\"\r\n              />\r\n            </perfect-scrollbar>\r\n          </Sider>\r\n        </template>\r\n        <Layout class=\"atbd-main-layout\" :class=\"rtl ? 'ant-layout-rtl' : ''\">\r\n          <Content>\r\n            <Suspense>\r\n              <template #default>\r\n                <router-view></router-view>\r\n              </template>\r\n              <template #fallback>\r\n                <div class=\"spin\">\r\n                  <a-spin />\r\n                </div>\r\n              </template>\r\n            </Suspense>\r\n\r\n            <Footer\r\n              class=\"admin-footer\"\r\n              :style=\"{\r\n                padding: '20px 30px 18px',\r\n                color: 'rgba(0, 0, 0, 0.65)',\r\n                fontSize: '14px',\r\n                background: 'rgba(255, 255, 255, .90)',\r\n                width: '100%',\r\n                boxShadow: '0 -5px 10px rgba(146,153,184, 0.05)',\r\n              }\"\r\n            >\r\n              <a-row>\r\n                <a-col :md=\"12\" :xs=\"24\">\r\n                  <span class=\"admin-footer__copyright\">2023 © MassNetCampaign</span>\r\n                </a-col>\r\n                <a-col :md=\"12\" :xs=\"24\">\r\n                  <div class=\"admin-footer__links\">\r\n                    <!-- <router-link to=\"/user/profile\"\r\n                      >Profile</router-link\r\n                    > -->\r\n                    <!-- <router-link to=\"/app/users/team\">Team</router-link> -->\r\n                    <!-- <router-link to=\"/app/contact/contact-grid\"\r\n                      >Contacts</router-link\r\n                    > -->\r\n                  </div>\r\n                </a-col>\r\n              </a-row>\r\n            </Footer>\r\n          </Content>\r\n        </Layout>\r\n      </Layou